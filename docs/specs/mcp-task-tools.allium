-- allium: 3
-- mcp-task-tools.allium
--
-- Scope: MCP tools for task management (create, get, update, list,
--        dispatch, subscribe/unsubscribe-to-task, query-usage,
--        set-verify-command) and the CLI plan-attachment surface.
-- Excludes: Task lifecycle (see tasks.allium); dispatch/retry (see dispatch.allium);
--           MCP epic tools (see epics.allium); learnings tools (see learnings.allium);
--           the task-watcher domain rules underlying subscribe_to_task/
--           unsubscribe_from_task (see task-watchers.allium); agent-to-agent
--           messaging, which is no longer a dispatch MCP tool — see
--           HookPeerMessageSent in agent-health.allium.

use "./core.allium" as core

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Tool descriptions ==
--
-- A tool's `description` and its arguments' descriptions are an agent-facing
-- surface, held to the same standard as the specs and docs: they state
-- behaviour, and they name no code. A description may name a tool, an argument
-- or a setting the caller passes — that is public interface — but never the
-- function, type, macro or file behind it. Two reasons the bar is *higher*
-- here than in docs/: check-doc-symbols.sh scans src/ for doc comments only
-- (`///` and `//!`), so a description — a string literal — is invisible to it
-- and nothing re-checks a citation that goes stale; and a description reaches
-- an agent mid-task, where it is acted on rather than read.
--
-- Individual rules below add their own description guarantees where a wrong or
-- missing sentence has a named consequence. Those are asserted in tests, and
-- derived from the generated schema wherever the fact has a machine-readable
-- source, so the description cannot drift from the tool it describes.

-- == MCP Task Tools ==

rule UpdateTaskViaMcp {
    when: McpUpdateTask(task, status?, sub_status?, plan?, title?, description?,
                        repo_path?, sort_order?, url?, url_type?, tag?, epic_id?,
                        base_branch?, wrap_up_mode?, auto_run_plan?, phoenix?)

    requires: status != null or sub_status != null or plan != null or title != null
              or description != null or repo_path != null
              or sort_order != null or epic_id != null
              or url != null or tag != null
              or base_branch != null
              or wrap_up_mode != omitted
              or auto_run_plan != null
              or phoenix != null

    -- Typed-url validation contract. The url string and its type travel
    -- together; the handler rejects inconsistent combinations before any
    -- mutation occurs.
    --   • A non-empty url REQUIRES url_type (an unaccompanied url is rejected).
    --   • An unknown url_type (not one of UrlType's literals) is rejected —
    --     whether or not url is present. url_type is parsed into its enum at
    --     the JSON-RPC boundary, like status, tag and sub_status, so a bad
    --     literal fails argument decoding before this rule is reached and is
    --     never silently ignored on a url-less call.
    requires: url_type = null or url_type_is_valid(url_type)
    requires:
        if url != null and url != "":
            url_type != null

    -- Archived is still never reachable via this rule, on either path:
    -- there is no dedicated archive rule alongside MarkTaskDoneViaMcp
    -- below, only the one for done. Rationale unchanged from the original
    -- restriction: humans manage archival from the TUI.
    --
    -- Done is now reachable via MCP, but never through THIS rule — it is
    -- carved out entirely into MarkTaskDoneViaMcp below, a dedicated
    -- close-only call (task_id and status="done", nothing else) with its
    -- own caller guard. `status != done` here means exactly that: this
    -- generic multi-field rule refuses status="done" unconditionally,
    -- regardless of what else the call sets, so a call combining
    -- status="done" with any other field never partially matches here —
    -- it is rejected by MarkTaskDoneViaMcp's own no-other-fields guard
    -- instead, with one consistent error message.
    --
    -- These two guards constrain the TARGET status only — task.status is
    -- never read to validate the move. This rule is therefore exempt from
    -- core/Task's status transition graph (see core.allium:
    -- Task.transitions status): any status other than done and archived
    -- is accepted from any current status, with no edge check, including
    -- out of the graph's terminal `archived` state. Deliberate: agents
    -- legitimately re-open and re-queue their own work
    -- (`review -> backlog`, `done -> backlog`), which the graph does not
    -- declare.
    requires: status != done
    requires: status != archived

    -- sub_status must be valid for the task's current (or new) status
    requires:
        if sub_status != null:
            let effective_status = if status != null: status else: task.status
            sub_status.is_valid_for(effective_status)

    -- The MCP tool's advertised sub_status enum deliberately omits stale_shell,
    -- pr_closed and pr_unreachable: stale_shell is a system-derived activity
    -- classification (agent-health.allium: ClassifyAgentActivity)
    -- and the other two are derived from GitHub PR polling (pr-workflow.allium:
    -- PollPrStatus, PrPollGaveUp) — none is a value an agent should choose to
    -- set. This is advertisement-only — the rule above still accepts any of the
    -- three if a caller sends it anyway, same as any other SubStatus valid for
    -- the effective status.

    let prior_status = task.status

    ensures:
        if status != null: task.status = status
    ensures:
        if sub_status != null: task.sub_status = sub_status
        else if status != null: task.sub_status = core/SubStatus.default_for(status)
    ensures:
        if plan != null: task.plan_path = plan
    ensures:
        if title != null: task.title = title
    ensures:
        if description != null: task.description = description
    ensures:
        if repo_path != null: task.repo_path = expand_tilde(repo_path)
    ensures:
        if sort_order != null: task.sort_order = sort_order
    ensures:
        -- Leaving running voids any deferred Stop, exactly as the manual
        -- moves in tasks.allium do. Without this an agent that moves its own
        -- task out of running and later back in would carry a Stop from the
        -- earlier turn, which the next drain would apply against the new one.
        -- See core/Task's PendingStopOnlyWhileRunning invariant.
        if status != null and status != running and prior_status = running:
            task.stop_pending = false
    ensures:
        if url != null:
            if url = "":
                task.url = null      -- empty string clears the url (and its type)
            else:
                task.url = core/TaskUrl{url: url, url_type: url_type}
    ensures:
        if tag != null: task.tag = tag
    -- Relinking into an archived epic is refused for the same reason
    -- CreateTaskViaMcp refuses it (epics.allium:
    -- ArchivedEpicHoldsNoLiveWork). This is the one attach path that reaches
    -- an archived TASK as well — the `m` keybinding returns early for one, MCP
    -- does not (see MoveTaskToEpic in tasks.allium) — and the guard is on the
    -- target epic either way, so an archived task cannot be relinked into an
    -- archived epic through it.
    requires:
        if epic_id != null: core/Epic.find(epic_id).status != archived

    ensures:
        if epic_id != null: task.epic = route_target(core/Epic.find(epic_id), task.repo_path)
    ensures:
        if base_branch != null: task.base_branch = base_branch
    ensures:
        -- wrap_up_mode supports three states: omitted (no change), one of
        -- WrapUpMode's literals (set), or explicit null (clear to NULL).
        if wrap_up_mode != omitted: task.wrap_up_mode = wrap_up_mode
    ensures:
        if auto_run_plan != null: task.auto_run_plan = auto_run_plan
        -- phoenix is a plain nullable boolean: omitted leaves it alone, true
        -- and false set it. What it then does is PhoenixRespawn
        -- (tasks.allium) — this rule itself cannot set status to done, so a
        -- call through THIS rule can only arm or disarm the recurrence, never
        -- trigger it. MarkTaskDoneViaMcp below is a different matter: it CAN
        -- reach done (on a task other than the calling agent's own), and
        -- because it does so via the same close_session TaskService method
        -- exit_session uses, a phoenix-armed task closed that way respawns —
        -- see that rule's own guidance.
        if phoenix != null: task.phoenix = phoenix
    ensures: task.updated_at = now

    @guidance
        -- MCP update_task accepts status, sub_status, plan_path, title,
        -- description, repo_path, sort_order, url, url_type, tag, epic_id,
        -- base_branch, wrap_up_mode, auto_run_plan, and phoenix. It does NOT
        -- accept worktree or tmux_window — those are owned by the dispatch flow
        -- and never set via MCP.
        --
        -- == The tool description enumerates every field it accepts ==
        -- update_task's description opens with that list, in full, and it is
        -- the first thing a caller reads. The list drifted once — it named
        -- eight of the fifteen fields and still called the typed url pair "PR
        -- fields" — and an unadvertised field is one a caller reaches for a
        -- second tool to do, or does not do at all. The list is asserted
        -- against the generated schema rather than reviewed by eye, so a field
        -- added to the argument set fails until the description learns it.
        -- wrap_up_mode can be set to "rebase", "pr", or "done" to pre-set
        -- the wrap-up action for the task. Pass null explicitly to clear it
        -- (omitting the field is a no-op).
        -- auto_run_plan (boolean, not nullable at the Task level) can be
        -- set via create_task or update_task. Omitting it is a no-op on
        -- update; create_task defaults it to false when absent.
        -- phoenix behaves the same way, and is the one field here an agent is
        -- expected to set on ITSELF: a dispatched agent that works out the task
        -- it is running is a recurring one calls update_task(phoenix: true) and
        -- the recurrence survives its own session. Arming it costs nothing if
        -- wrong — the flag does nothing until the task reaches done, and the
        -- human can clear it from the editor.
        -- Note: worktree and tmux_window ARE mutable through the internal
        -- Rust TaskService::update_task API (UpdateTaskParams defines
        -- them; see src/service/tasks/params.rs). The runtime uses that
        -- path to clear the pointers once a teardown has released them, and
        -- for the post-provision patch on both dispatch paths (dispatch_task
        -- and the epic chain).
        -- They are intentionally unreachable from MCP because the MCP
        -- handler does not parse those fields: the UpdateTaskArgs struct
        -- that defines the accepted argument set
        -- (src/mcp/handlers/tasks/mod.rs) has no worktree or
        -- tmux_window field, so handle_update_task
        -- (src/mcp/handlers/tasks/crud.rs) can never carry them into
        -- UpdateTaskParams.
        -- The typed url is carried by two params: `url` (the string) and
        -- `url_type` (one of pr | security_alert | issue | other). A non-empty
        -- `url` REQUIRES `url_type`; an unknown `url_type` is rejected
        -- unconditionally, at argument decoding. An
        -- empty-string `url` clears task.url and its type (maps to
        -- FieldUpdate::Clear); any non-empty `url` sets task.url to a
        -- core/TaskUrl{url, url_type} value.
        -- This rule writes nothing on a status change out of done. It used to
        -- clear a completion-recency rank from task.sort_order; that rank is
        -- now task.completed_at, which is deliberately kept across a move out
        -- of done (tasks.allium, ConfirmDone's guidance), and sort_order is
        -- left to mean manual ordering alone. So an explicit sort_order in the
        -- same call is no longer overridden by the status param: the two write
        -- different fields. The entering-done stamp is not reachable from this
        -- rule at all — `requires: status != done` rules it out — and is
        -- applied by the other callers of TaskService::close_session:
        -- tasks/ConfirmDone (the TUI path) and MarkTaskDoneViaMcp below (the
        -- MCP path). It lives in TaskService::update_task
        -- (src/service/tasks/crud.rs), which reads the pre-write status and
        -- applies the stamp on top of the patch built from the caller's
        -- params.
        -- The `status` argument's own description carries one fact this rule
        -- does not own: moving a task back to backlog is the first half of
        -- resuming it, because a following dispatch reuses the worktree
        -- directory it still has. The reason it is stated here rather than
        -- only next to dispatch_task is that backlog is where a caller meets
        -- the recovery move — see DispatchTaskViaMcp's guidance below, which
        -- owns the behaviour.
        -- When status or epic_id changes, the parent epic's status is
        -- recalculated (if a parent epic exists). Re-assigning a task
        -- from one epic to another triggers recalculation on both the
        -- old and new epic.
        -- When epic_id refers to a grouped root (group_by_repo = true),
        -- route_target redirects the task to the per-repo sub-epic for
        -- task.repo_path, creating the sub-epic if needed. When epic_id
        -- refers to a specific sub-epic, the assignment is direct.
        -- origin is never user-supplied: it is a system field set only
        -- by the repo-grouping service (service::grouping). Callers
        -- cannot set or observe origin via MCP.
        -- When repo_path is changed alongside or independently, and the
        -- task belongs to a grouped parent, reroute_on_repo_change is
        -- called to move the task to the correct sub-epic for the new
        -- repo_path.
}

rule MarkTaskDoneViaMcp {
    when: McpUpdateTask(task, caller_identity, status?, sub_status?, plan?, title?,
                        description?, repo_path?, sort_order?, url?, url_type?, tag?,
                        epic_id?, base_branch?, wrap_up_mode?, auto_run_plan?, phoenix?)

    requires: status = done

    -- A dedicated close-only call: no other field may travel with
    -- status="done" in the same update_task call — not even one that would
    -- be a harmless no-op elsewhere. url_type is a case in point: everywhere
    -- else this tool accepts it, url_type has no effect without a non-empty
    -- url — it "folds into url" (see UpdateTaskViaMcp's guidance) rather than
    -- owning a Task field of its own — but sending it alongside status="done"
    -- is still rejected here, same as any other field. A close-only call
    -- silently discarding an argument the caller bothered to send is a worse
    -- failure mode than a slightly stricter guard; a caller wanting both a
    -- field change and completion makes two calls — one update_task call for
    -- the field, a separate status-only call to close.
    requires:
        sub_status = null and plan = null and title = null and description = null
        and repo_path = null and sort_order = null and url = null and url_type = null
        and tag = null and epic_id = null and base_branch = null
        and wrap_up_mode = omitted and auto_run_plan = null and phoenix = null

    -- A dispatched agent may not close its OWN task through this call — that
    -- route stays wrap_up + exit_session, with its token, its ordering
    -- guarantees and its epic chain all in one place (ExitSession,
    -- pr-workflow.allium). A session caller (a human's own Claude Code
    -- session, or a script/orchestrator with no dispatched identity of its
    -- own) may close ANY task this way, including one with a live tmux
    -- window. A dispatched agent may likewise close any task OTHER than the
    -- one it is running as — e.g. a triage/orchestrating agent closing
    -- sibling cards — but never itself.
    requires:
        not (caller_identity.kind = task and caller_identity.task_id = task.id)

    -- No requirement on task.status: reachable from any current status
    -- (backlog, running, review, even done or archived), the same
    -- no-edge-check philosophy UpdateTaskViaMcp already applies to its own
    -- target statuses. A task with no live tmux_window (never dispatched, or
    -- already detached) closes with nothing to tear down.

    -- The terminal write can fail to persist at the storage layer, exactly as
    -- it can for ExitSession (pr-workflow.allium) — see that rule's
    -- `close_persisted` discussion for the full rationale, which applies here
    -- unchanged. Every mutation below is gated on this SAME write landing: a
    -- task whose close does not persist keeps its prior status, sub_status,
    -- completed_at and any live window untouched. (No SessionClosed is emitted
    -- on this path on either outcome — see the note after the ensures.)
    let close_persisted = terminal_close_persisted(task)
    let window = closed_session_window(task)
    let had_window = window != null
    let was_running = task.status = running
    let was_already_done = task.status = done

    ensures:
        if close_persisted:
            task.status = done
            task.sub_status = core/SubStatus.default_for(done)
            task.updated_at = now
            -- Re-closing an already-done task leaves its existing
            -- completion time untouched: a done -> done write is not a
            -- completion, the same for every other caller of
            -- TaskService::close_session. Every OTHER prior status (including
            -- archived) DOES get the fresh stamp.
            if not was_already_done:
                task.completed_at = now
            -- Mirrors ExitSession's own clear: leaving running voids any
            -- deferred Stop, so a task closed while running can't carry a
            -- stale stop_pending into whatever status a later re-open lands
            -- it in. See core/Task's PendingStopOnlyWhileRunning invariant.
            if was_running:
                task.stop_pending = false
            if had_window:
                task.tmux_window = null
                not exists window

    -- No SessionClosed, therefore no epic chain. This is the one place this
    -- path deliberately diverges from ExitSession's tail: the terminal write,
    -- the tmux teardown and the notifications are shared, the chain is not.
    --
    -- Why. SessionClosed is the signal AutoDispatchNextSubtask (epics.allium)
    -- keys on, and the chain's whole value is that the successor starts from a
    -- base_branch already carrying the closed task's work. Only exit_session
    -- can promise that: it is reachable exclusively through wrap_up, which
    -- rebased onto base_branch, opened a PR, or was told explicitly that the
    -- task needed neither. This call has no wrap_up ahead of it — no rebase,
    -- no PR, no exit token, and (by its own requires) no relationship at all
    -- between the caller and the work being closed. A chain fired from here
    -- launches an agent against whatever base_branch happened to hold, on the
    -- say-so of a caller who was never in that task's session.
    --
    -- The epic is not stuck, and this is not a stall: it is the same untouched
    -- epic the chain's other normal stopping conditions produce, with the same
    -- recovery — the human dispatches the next subtask from the TUI. So it
    -- raises no AutoDispatchFailed and shows no chain-stalled marker; nothing
    -- failed.

    @guidance
        -- The MCP `update_task` tool's dedicated done-only path. Handled by
        -- handle_update_task (src/mcp/handlers/tasks/crud.rs), which checks
        -- `status = "done"` FIRST — before the sibling archived check, before
        -- the url/url_type pairing validation, before any field mapping —
        -- and branches to a separate function operating on the raw parsed
        -- arguments, not on the built UpdateTaskParams. That ordering is load
        -- bearing: checking the field-exclusivity guard against
        -- UpdateTaskParams instead (which has no slot for a url_type sent
        -- without a url) would let such a call slip through unrejected, and
        -- checking it after the url/url_type pairing validation would answer
        -- a `status="done", url=<x>` call with "url_type is required" instead
        -- of the close-only error this rule promises.
        --
        -- From there, this path reuses the tail ExitSessionViaMcp uses:
        -- TaskService::close_session (the same terminal-write helper, same
        -- CloseSessionOutcome::Done branch) and TaskService::kill_session_window
        -- for the tmux teardown. The shared tail lives once, in a
        -- `perform_close` helper (src/mcp/handlers/tasks/wrap_up.rs) that both
        -- handlers call — this is deliberate: a second copy of ExitSession's
        -- terminal-write / teardown sequence, however small the divergence, is
        -- exactly the "second path to the terminal write" hazard this whole
        -- feature exists to avoid re-deriving. Only the request validation
        -- (the two requires above), the response text and the epic chain are
        -- specific to the caller; the mechanics, including the close_persisted
        -- gate, are not.
        --
        -- The chain is simply not part of that shared tail. It is not
        -- suppressed here by a flag; it lives at ExitSessionViaMcp's own call
        -- site, one level above the helper, because after this rule stopped
        -- chaining it has exactly one caller that wants it. Nothing shared is
        -- duplicated by that, and "only exit_session chains" becomes true by
        -- structure rather than by a parameter every future caller of the
        -- helper would have to get right. The ordering the chain depends on
        -- survives for free: the helper returns only once the terminal write
        -- and both change notifications have landed. See the no-SessionClosed
        -- note above for why this path must not chain at all.
        --
        -- No exit token is issued, checked, or consumed anywhere on this
        -- path — unlike exit_session, there is no wrap_up call first. That is
        -- the whole point: it is a distinct, deliberately simpler route to
        -- Done for a caller who was never going to call wrap_up on this task
        -- in the first place (a session closing a batch of finished cards, or
        -- an orchestrating agent closing a sibling task).
        --
        -- Validation order (both are ServiceError::Validation, -32602),
        -- entirely ahead of UpdateTaskViaMcp's own archived/url-pairing
        -- checks, which never run for a status="done" call:
        --   1. Any field other than status set alongside status="done"
        --      (url_type included, even though it is inert everywhere else
        --      this tool accepts it without an accompanying url — see the
        --      requires clause above) →
        --      "status=\"done\" must be the only field set in this call
        --      (also set: <names>). Update other fields separately, then
        --      close with a status-only call."
        --   2. caller_identity is Task(t) and t = the target task_id →
        --      "Cannot mark your own task done via update_task — call
        --      wrap_up then exit_session instead."
        --   3. Unknown task_id → the same NotFound(-32001) every other MCP
        --      task lookup uses ("Task <id> not found").
        -- A caller could trip both 1 and 2 at once; 1 is checked first, so
        -- that error names the field-combination problem regardless of who
        -- is calling.
        --
        -- close_session has no precondition on prior status or on
        -- tmux_window being present — it is called unconditionally once
        -- validation passes, so a backlog task with no window closes exactly
        -- as cleanly as a running task with a live one. It also unconditionally
        -- applies respawn_phoenix on a persisted Done transition — the same
        -- PhoenixRespawn (tasks.allium) any other route into Done triggers;
        -- this path earns that for free by reusing close_session rather than
        -- re-deriving it.
        --
        -- When the terminal write does NOT persist: this call reports the
        -- task could not be moved to done and invites a retry (worded
        -- differently from ExitSessionViaMcp's failed-close text, which names
        -- a live tmux session and says the close needs redoing by hand — this
        -- path may have no session at all to speak of); any live window is
        -- left alive (nothing tears it down) — the task is exactly as it was
        -- before the call. When it DOES persist: the window (if any) is killed
        -- in the background and task/epic-changed notifications fire. No epic
        -- auto-dispatch chain runs on either outcome, so the response text
        -- never names a chained subtask — unlike exit_session's, which does.
        --
        -- MCP_UPDATABLE (src/models/tasks.rs) now includes Done: the
        -- schema's advertised status enum is backlog | running | review |
        -- done. archived remains excluded — UpdateTaskViaMcp's own guard is
        -- unchanged for it, and there is no equivalent MarkTaskDoneViaMcp for
        -- archival.
}

rule PrFinalisationReflectionNudge {
    when: McpUpdateTask(task, status?, sub_status?, plan?, title?, description?,
                        repo_path?, sort_order?, url?, url_type?, tag?, epic_id?,
                        base_branch?, wrap_up_mode?, auto_run_plan?)

    -- "PR finalisation": this one call both moves the task to review and
    -- attaches a pr-typed url, on a task that carried no url at all before the
    -- call. Preconditions read pre-call state, so task.url = null is the
    -- first-time-a-PR-is-linked condition, not a post-update assertion.
    requires: status = review
    requires: url != null and url != "" and url_type = pr
    requires: task.url = null

    requires: core/config.learning_reflection_enabled = true

    ensures: ReflectionNudgeAppended(task: task)

    @guidance
        -- The sole consumer of core/config.learning_reflection_enabled. The
        -- nudge is a sentence appended to the update_task success response
        -- text, asking the agent whether it discovered anything non-obvious
        -- about the repo or task and, if so, to call record_learning with a
        -- brief summary. It never gates or alters the update: UpdateTaskViaMcp
        -- applies its mutations regardless, and when the flag is false the
        -- response text is simply shorter.
        --
        -- Layering: the finalisation shape is computed in the service layer as
        -- was_pr_finalisation (src/service/tasks/crud.rs) — status = review AND
        -- a pr-typed url AND the pre-write task had url = None — and returned on
        -- UpdateTaskResult. handle_update_task (src/mcp/handlers/tasks/crud.rs)
        -- consults it and only then calls reflection_nudge
        -- (src/mcp/handlers/tasks/mod.rs), which reads the setting and returns
        -- the empty string when it is false.
        --
        -- IMPORTANT — this nudge does NOT fire on the normal wrap-up path.
        -- ExitSessionViaMcp (below) performs an equivalent mutation for
        -- action = pr (status -> review plus a pr-typed url, set
        -- unconditionally regardless of any prior url), but handle_exit_session
        -- (src/mcp/handlers/tasks/wrap_up.rs) calls
        -- state.task_svc.update_task(...) directly at the service layer and
        -- discards the returned was_pr_finalisation; it never calls
        -- reflection_nudge. So the nudge only appears when a caller invokes the
        -- update_task MCP tool directly to link a PR, bypassing
        -- wrap_up/exit_session entirely. The wrap_up response carries a
        -- different rate_learning nudge, gated to the pr action rather than
        -- unconditional (see learnings.allium: WrapUpRateLearningNudge).
}

rule CreateTaskViaMcp {
    when: McpCreateTask(caller_identity,
                        title, repo_path, epic_id, description?, plan?,
                        sort_order?, tag?, base_branch?,
                        wrap_up_mode?, auto_run_plan?, phoenix?)

    -- epic_id is REQUIRED and nullable. Required means the ARGUMENT must be
    -- present; nullable means the VALUE may be null. The three cases are:
    --   absent       — the call is refused (EveryTaskNamesItsEpicOrNull below)
    --   an integer   — that epic, which must exist and must not be archived
    --   null         — the task is deliberately standalone, with no epic
    -- There is no inheritance from the caller: a Task-kind caller's own epic
    -- is never consulted here, and the effective epic is exactly the argument.

    -- caller_identity is supplied by the dispatch HTTP transport, not by
    -- the tool arguments. It is one of:
    --   Task(task_id)   — a dispatched agent
    --   Session         — any non-dispatched session
    --
    -- The two identities reach the transport by different routes, and the
    -- headersHelper supplies only one of them:
    --   Task(id) — a fixed X-Caller-Task-Id header in the per-task MCP
    --     configuration the launcher writes for that agent (see
    --     AgentCarriesItsOwnCallerIdentity in dispatch.allium).
    --   Session — X-Caller-Kind: session, from the
    --     `dispatch caller-headers` headersHelper installed in Claude Code's
    --     user-global config (~/.claude.json) by `dispatch tui`'s startup
    --     configuration check (see startup.allium).
    --
    -- TheHelperAnswersSessionUnconditionally. The helper takes no reading of
    -- its surroundings and has no second answer to give: `session` is the
    -- whole of it. It once derived a task identity by inspecting its own
    -- working directory for a worktree path, which could not work — Claude
    -- Code runs a user-global helper from its own configuration directory,
    -- so the directory it inspected was never the agent's (see
    -- CallerIdentityDependsOnTheLaunch below). Keeping that derivation as an
    -- unreachable branch would leave two mechanisms answering "which task is
    -- this agent", one of them a dead end that the next investigation of a
    -- wrong caller identity would search first.

    -- A Task-kind caller must reference an existing task.
    requires:
        if caller_identity.kind = task: core/Task.exists(caller_identity.task_id)

    -- epic_id, when non-null, must refer to an existing epic.
    requires:
        if epic_id != null: core/Epic.exists(epic_id)

    -- ...and that epic must not be archived. An archived epic gains no work
    -- (epics.allium: ArchivedEpicHoldsNoLiveWork), so the task is refused
    -- outright with a validation error naming the epic rather than quietly
    -- created as a standalone one: a caller that asked for an epic and got a
    -- loose task would have no sign anything went wrong. Enforced in the
    -- service rather than the handler
    -- (src/service/tasks/crud.rs::create_task_returning), so the TUI's own
    -- create path is held to it too.
    requires:
        if epic_id != null: core/Epic.find(epic_id).status != archived

    -- AnArchivedLineageStillAllowsAStandaloneTask. The guard above is on the
    -- ARGUMENT, and only when it is non-null, so a Task-kind caller whose own
    -- epic is archived may still pass epic_id: null and succeed, producing a
    -- standalone task. That is intended. ArchivedEpicHoldsNoLiveWork
    -- (epics.allium) says an archived epic gains no work, and a task with no
    -- epic adds none to it. Refusing here would leave such an agent no way to
    -- file anything at all: naming its own epic is refused for archived-ness,
    -- and naming null would be refused too, so both of its answers would fail.
    -- This is a deliberate change from the inheritance rule, under which the
    -- same agent was refused a bare create_task because the epic it inherited
    -- was archived. There it had never chosen the archived epic; here it has
    -- chosen null.

    ensures: core/Task.created(
        title: title,
        description: description ?? "",
        repo_path: repo_path,
        status: backlog,
        sub_status: core/SubStatus.default_for(backlog),
        plan_path: plan,
        epic: route_target(epic_id, repo_path),
        tag: tag,
        sort_order: sort_order,
        base_branch: base_branch ?? detect_default_branch(repo_path),
        wrap_up_mode: wrap_up_mode,
        auto_run_plan: auto_run_plan ?? false,
        phoenix: phoenix ?? false,
        created_at: now,
        updated_at: now
    )

    -- BaseBranchIsResolvedNotAssumed. An omitted base_branch is resolved
    -- against the repository named by repo_path, by detect_default_branch --
    -- NOT defaulted to config.default_branch. This tool is the one creation
    -- path that had no human in front of it to notice a wrong answer: the TUI
    -- form shows its base branch in a picker the user can correct, and quick
    -- dispatch already detects (tasks.allium: CreateQuickTask). Assuming
    -- "main" here produced tasks in "master" repos that could not be
    -- dispatched at all -- `git worktree add` rejected the ref, and because
    -- the failing dispatch was usually the epic auto-dispatch chain, the only
    -- trace was a server-side warning. See
    -- dispatch.allium: DefaultBaseBranchIsDetectedNotAssumed.
    --
    -- The epic the task LANDS in is route_target's, not the argument
    -- verbatim: when epic_id names a grouped root (group_by_repo = true) the
    -- task is routed to the matching per-repo sub-epic, using repo_path as the
    -- routing key, and the sub-epic is created if it does not exist. Named
    -- here for the same reason UpdateTaskViaMcp and tasks.allium's CreateTask
    -- name it. It does not weaken the archived guard above, which is on the
    -- epic the caller NAMED: the only thing routing substitutes is a RepoGroup
    -- sub-epic, and create_repo_group_sub_epic unarchives a reused one as it
    -- hands it back, so a routed target is never archived when the task
    -- reaches it. Implemented by resolve_routed_epic in
    -- src/service/tasks/crud.rs.
    --
    -- EveryTaskNamesItsEpicOrNull. A call that omits epic_id entirely is
    -- REFUSED with a validation error, for BOTH caller kinds — Task(t) and
    -- Session alike. Nothing is created and no epic is guessed.
    --
    -- Why the argument is required rather than inherited. Silent inheritance
    -- propagates a blank: an epic-less task creates an epic-less child, which
    -- creates another. Measured on the real board, 93 of 209 omitted-epic_id
    -- calls produced a task with no epic, and every one of them had inherited
    -- correctly from a caller that itself had none — chains such as
    -- 4786 -> 4806 -> 4826 -> 4843, with no error raised on any surface.
    -- Requiring the argument stops the chain: a wrong answer now costs one
    -- task instead of a lineage.
    --
    -- Why that is cheap to ask. The value is already in front of the agent —
    -- the dispatch prompt states "This task is part of epic #N". Of the 236
    -- calls that did pass an explicit epic_id, exactly one named an epic that
    -- does not exist, and that case is already refused by the Epic.exists
    -- requirement above.
    --
    -- Why null is kept rather than forcing every task into an epic. A
    -- genuinely standalone task must stay expressible without inventing a
    -- catch-all epic to park it in. The point of the change is to force a
    -- DECISION, not to force an epic.
    --
    -- TheRefusalNamesTheLikelyAnswer. The validation error for a missing
    -- epic_id is actionable, not a bare "missing field". When the caller is
    -- Task(t) and that task has an epic, the message names that epic id as the
    -- likely answer, and states that null means deliberately standalone. This
    -- is why the requirement is enforced in the handler, where caller identity
    -- is known, rather than by the deserialization boundary's own
    -- missing-field error: that error cannot name the caller's epic.

    @guidance
        -- Dispatched agents never pass caller_task_id explicitly — the
        -- transport carries identity.
        --
        -- CallerIdentityDependsOnTheLaunch. A dispatched agent is identified
        -- because its LAUNCH said so, not because anything at the agent's end
        -- worked out which task it is. The headersHelper cannot: Claude Code
        -- runs a user-global helper from its own config directory, so a helper
        -- that tried to recognise a `.worktrees/<id>-<slug>` working directory
        -- would never see one. It therefore answers `session` and nothing else
        -- (TheHelperAnswersSessionUnconditionally above), which for a
        -- dispatched agent is indistinguishable, here, from a genuine
        -- non-dispatched session.
        --
        -- The degradation is silent on one of the two surfaces only. An agent
        -- launched without its per-task configuration gets no auto-scoping in
        -- ListTasksViaMcp, with no error — that half still stands, and
        -- ListTasksViaMcp cannot detect the difference. Here it no longer
        -- applies: create_task requires epic_id of every caller, so a
        -- misconfigured agent that omits it is REFUSED outright rather than
        -- quietly given no epic. What it loses is the refusal's help, not the
        -- refusal: TheRefusalNamesTheLikelyAnswer can only name the caller's
        -- epic when identity is Task(t), so a Session-identified agent is told
        -- the argument is required and nothing more.
        --
        -- The obligation still lives entirely on the dispatch side — see
        -- AgentCarriesItsOwnCallerIdentity in dispatch.allium.
        --
        -- The Axum middleware (src/mcp/middleware.rs) is an *extractor*,
        -- not a gatekeeper: it parses the two headers and attaches a
        -- Result<CallerIdentity, IdentityError> to request extensions
        -- without ever short-circuiting the request. This is required
        -- because the middleware runs before the JSON-RPC body is
        -- parsed and therefore has no request id to echo back — and a
        -- JSON-RPC response with `id: null` is rejected by strict MCP
        -- clients (Claude Code), which would abort the session during
        -- the handshake.
        --
        -- Identity-free methods (`initialize`, `ping`, `tools/list`,
        -- notifications) succeed regardless of header presence.
        -- Identity-consuming tool calls (everything dispatched through
        -- `tools/call`) reject missing or malformed identity at the
        -- handler boundary with JSON-RPC -32600, echoing back the
        -- request's actual id.
        -- An unknown caller-task is a not-found condition, not a
        -- validation one: the shared caller-task lookup (fetch_caller_task
        -- in src/mcp/handlers/types.rs) rejects it with -32001, the same
        -- code every ServiceError::NotFound maps to.
        -- An unknown epic_id is a not-found condition, like an unknown
        -- caller-task above, and returns -32001 for the same reason: the epic
        -- named is not there, which is not the same answer as the argument
        -- being malformed. require_epic_accepting_work (src/service/epics.rs)
        -- raises it alongside the archived-epic guard, so create_task and the
        -- reassign path in MoveTaskToEpic give one answer to one operator
        -- mistake rather than -32602 and -32001 by entry point. It sits in the
        -- service rather than the handler so the TUI create path is held to it
        -- too. Left to the SQLite foreign key instead, as it once was, it
        -- surfaced as a -32603 Internal whose text named neither the epic nor
        -- the argument.
        -- Unlike the TUI CreateTask rule, this rule does not fire
        -- RecordRepoPath — MCP task creation skips repo path persistence.
        -- repo_path is expanded through expand_tilde before being
        -- stored (so "~/proj" becomes "$HOME/proj"), matching
        -- UpdateTaskViaMcp.
}

rule GetTaskViaMcp {
    when: McpGetTask(task_id)

    requires: core/Task.exists(task_id)

    -- Read-only. Returns the task detail view for task_id; no state changes.
    ensures: TaskRetrieved(task_id)

    @guidance
        -- get_task takes only task_id and is the tool a dispatched agent uses
        -- to read its own task (title, description, plan, tag, wrap_up_mode).
        -- Caller identity is not consulted: any caller may read any task, and
        -- there is no auto-scoping or self-exclusion as in ListTasksViaMcp.
        -- Detail lines, in render order (lines in [brackets] appear only when
        -- the field is set):
        --   Task <id>: <title>, Status, Repo, Description, Sub-status,
        --   [Epic (as "<title> (#<id>)", or "#<id>" when the title cannot be
        --   resolved)], [Tag], [Plan], [<url label>: <url> — the typed label
        --   derived from url.url_type], [Worktree], Base branch,
        --   [Tmux window], [Sort order], [Verify command], [Wrap-up mode],
        --   [Phoenix], Created, Updated.
        -- [Phoenix] renders only when the flag is true, and says the task will
        -- come back — so an agent wrapping up knows it is finishing THIS run of
        -- a recurring task, not the task itself, and can leave notes for its
        -- successor in the description rather than only in the commit.
        -- Not surfaced at all: labels, external_id, auto_run_plan, origin, and
        -- the hook timestamps (last_pre_tool_use_at, last_notification_at,
        -- pr_learnings_gate_shown_at).
        --
        -- [Verify command] is not a Task field: it is task.repo_path resolved
        -- against core/SavedRepoPath.verify_command, the same lookup wrap_up
        -- performs for its own "Verify before exiting" line. Omitted when no
        -- verify_command is set for the repo. This is the earlier of the two
        -- surfaces that carry the command to the agent — see
        -- ThePromptCarriesNoVerifyCommand in dispatch-prompt.allium and
        -- WrapUpRebase/WrapUpPr/WrapUpDone in pr-workflow.allium for the other
        -- one and why both exist.
        -- An unknown task_id is a not-found condition, not a validation one:
        -- ServiceError::NotFound surfaces as the -32001 not-found code, the
        -- same mapping every other NotFound uses (see CreateTaskViaMcp).
        --
        -- == The tool description names the response shape ==
        -- The description states that the response is labelled prose — one
        -- "Label: value" line per field, not JSON — and that a line is
        -- rendered only when its field is set, so an absent line means unset
        -- rather than empty. It names the three lines a wrapping-up agent
        -- reads: Base branch, Verify command and Wrap-up mode.
        --
        -- Saying so is not decoration. The response is the only labelled-prose
        -- payload in the tool set, and agents that assumed JSON went looking
        -- for snake_case keys that never appear — a failure that costs the
        -- reader the verify command specifically, because that line is the one
        -- with no second source in the prompt.
        -- Handled by handle_get_task in src/mcp/handlers/tasks/crud.rs.
}

rule ListTasksViaMcp {
    when: McpListTasks(caller_identity,
                       epic_id?, repo_paths?, status?)

    -- caller_identity comes from the HTTP transport (see CreateTaskViaMcp).

    ensures: TasksQueried(
        caller_identity: caller_identity,
        epic_id: epic_id,
        repo_paths: repo_paths,
        status: status
    )

    @guidance
        -- When the caller is Task(t) and none of epic_id/repo_paths
        -- are set, auto-derive scope from the caller:
        --   caller.epic_id != null → filter by epic_id = caller.epic_id
        -- Explicit scope filters always win over auto-derived scope.
        -- When the caller is Task(t) alongside an explicit scope filter, the
        -- caller's task is still excluded from results but no additional
        -- scope is derived.
        -- When the caller is Session, no auto-scope and no self-exclusion.
        --
        -- This auto-scoping is UNCHANGED by EveryTaskNamesItsEpicOrNull in
        -- CreateTaskViaMcp. Inheriting the caller's epic was removed from
        -- create_task only, where it silently propagated a blank into newly
        -- created work. Here nothing is created: the caller's epic narrows a
        -- read that would otherwise return the whole board, an omitted
        -- epic_id simply means "no narrowing", and a wrong guess costs the
        -- caller one over-broad list rather than a mis-parented task.
        -- Output line per task: title, status/sub_status, tag, epic, then
        --   | <label>: <url.url>  (omitted when url is null), where <label>
        --     is the typed label derived from url.url_type: "PR #N" / "Issue #N"
        --     / "Security Alert" / "Link"
        --   | Goal: <plan goal>  (from **Goal:** line in plan file; falls back to
        --                         description preview ≤200 chars when plan absent/unreadable)
        --
        -- == The tool description names every url label, not just PR ==
        -- The url line is typed, so three of the four labels are not "PR". The
        -- description names all four rather than describing the output as a PR
        -- url, which is what it said while the url field was PR-only: a caller
        -- who scans for the word "PR" on a security-alert or issue task finds
        -- nothing and concludes the task carries no link.
        -- Implemented in handle_list_tasks (src/mcp/handlers/tasks/crud.rs).
}

rule QueryUsageViaMcp {
    when: McpQueryUsage(category?, actor?, since?)

    -- category and actor, when supplied, are validated against their
    -- enums; an unrecognised value is rejected rather than silently
    -- yielding an empty result.
    requires:
        if category != null: usage_category_is_valid(category)
    requires:
        if actor != null: usage_actor_is_valid(actor)

    ensures: FeatureUsageQueried(
        category: category,
        actor: actor,
        since: since
    )

    @guidance
        -- query_usage returns aggregated feature-usage counts grouped by
        -- category + action (with detail, actor, total count and the most
        -- recent use timestamp per group). Filters are optional:
        --   category: "keybinding" | "mcp_tool" (enum-validated)
        --   actor:    enum-validated string
        --   since:    ISO-8601 datetime; rows older than this are excluded
        -- Invalid category/actor strings reject with JSON-RPC -32602; a
        -- malformed `since` likewise rejects with -32602.
        -- These are feature-usage counters (which keybindings and MCP tools
        -- are exercised), NOT token counts. Per-call usage recording fires
        -- on every tools/call request.
        -- Handled by handle_query_usage in src/mcp/handlers/tasks/crud.rs.
}

rule DispatchTaskViaMcp {
    when: McpDispatchTask(task)

    requires: task.status = backlog

    ensures: DispatchTask(task)

    @guidance
        -- Returns an error if task.status != backlog.
        -- A single DispatchTask call covers both has_plan = true
        -- (with-plan prompt) and has_plan = false (spec-first
        -- prompt) variants — the prompt builder branches internally.
        -- dispatch_task is the only remaining MCP dispatch tool: it stays the
        -- explicit "dispatch this specific task" call, while epic chaining is
        -- automatic on a session close that takes effect
        -- (AutoDispatchNextSubtask in epics.allium, keyed on the SessionClosed
        -- that ExitSessionViaMcp withholds when its terminal write fails).
        -- Unlike that chain, this call is synchronous: it waits
        -- for worktree creation and agent launch to complete before returning.
        -- Its backlog guard is a claim, not a read: the backlog -> running
        -- transition is taken conditionally before provisioning starts, so a
        -- concurrent chain or TUI dispatch either loses to this call or beats it
        -- outright, and the task is never provisioned twice
        -- (DispatchClaimExclusive in dispatch.allium). A lost claim is reported
        -- as the same "not in backlog" error a task that was already running
        -- would produce, naming the status the task actually holds now.
        -- On success, the worktree path and tmux window are returned to the caller.
        -- On failure (e.g. worktree creation or tmux launch error), the error is
        -- returned immediately and the claim this call won is released, so the
        -- task is left in backlog status exactly as it was before the call. A call
        -- that never won the claim releases nothing.
        --
        -- == The success text names which provisioning path ran ==
        -- Provisioning has two paths (DispatchTask in dispatch.allium): a
        -- worktree directory that does not exist yet is CREATED by branching
        -- from a resolved start point, and one that already exists is REUSED —
        -- `git worktree add` is skipped, so the directory keeps its branch, its
        -- commits and its uncommitted changes, and the agent starts in them.
        -- Which ref the fresh path branches from is dispatch.allium's
        -- start-point table's business, not this rule's: it is usually the
        -- task's base branch, but a review task carrying a PR url branches from
        -- the PR's head instead, and an origin that has no such ref falls back
        -- to the local branch. What matters here is only that one path branches
        -- and the other does not.
        --
        -- The success text says which of the two happened, naming the worktree
        -- either as created or as reused. This is not decoration. It is the
        -- only place a caller learns, from the call itself, that a re-dispatch
        -- did not throw the previous session's work away — and a caller who is
        -- told cannot mistake a resume for a fresh start. Reporting one wording
        -- for both paths would leave the caller to infer the difference from
        -- the tool description, which is exactly the inference that was
        -- measured going wrong: an orchestrating agent read "creates a
        -- worktree", concluded that nine crashed tasks' unlanded commits and
        -- dirty trees were unreachable, and wrote cherry-pick-and-`git apply`
        -- salvage tasks for work that a plain re-dispatch would have resumed
        -- in place.
        --
        -- The distinction is drawn where provisioning already establishes it,
        -- and is reported rather than re-derived. Only provisioning can tell
        -- the two apart: it measures the directory BEFORE acting, and by the
        -- time the dispatch has returned the directory exists either way, so a
        -- later look at it answers a different question.
        --
        -- == The tool description advertises both paths and the recovery move ==
        -- The description a caller reads before calling states both paths, that
        -- a reused worktree keeps its branch, commits and uncommitted changes,
        -- and the move those two facts add up to: a crashed or stalled task is
        -- resumed in place by setting it back to backlog with update_task and
        -- dispatching it again. It also tells the caller to say in the task
        -- what the worktree already holds, because the resumed agent is a new
        -- agent and carries none of the crashed session's context.
        --
        -- update_task's own `status` argument carries the same fact where a
        -- caller meets it — the backlog value is the first half of the recovery
        -- move, and a description that lists the statuses without saying what
        -- dispatching from backlog does to an existing worktree sends the
        -- reader back to guessing.
}

-- Inter-agent messaging no longer has a dispatch MCP tool. It was
-- `send_message` (from_task_id, to_task_id, body) → a message file under the
-- target's worktree + a `tmux send-keys` nudge — replaced (task #4098) after
-- reproducing that the nudge could land on a permission prompt or
-- plan-mode/elicitation dialog instead of the agent's chat input, silently
-- answering it rather than being read. See
-- docs/superpowers/specs/2026-08-15-send-message-delivery-hardening-design.md
-- for that reproduction.
--
-- Agents now use Claude Code's own native `ListAgents`/`SendMessage` tools
-- directly, addressed by the `task-<id>` session name dispatch assigns at
-- launch (`dispatch.allium`'s `DispatchTask`/`ResumeTask`). Delivery is
-- queued and read between tool calls — it cannot land on a dialog, because
-- it never touches the pane's raw stdin. Dispatch never sits in the call
-- path; it only observes the sender's own tool call via the existing Claude
-- Code hook pipeline to drive the TUI flash and reconstruct an audit entry —
-- see `HookPeerMessageSent` in `agent-health.allium`.
--
-- Task-watcher completion/deletion notices (`task-watchers.allium`) are a
-- different case — dispatch's own background service fires them with no
-- live agent turn to piggyback a native tool call on — so they remain on the
-- file+tmux-send-keys transport, hardened instead of replaced: see
-- `DeliverWatcherNotification` in `task-watchers.allium` and
-- `2026-08-15-send-message-delivery-hardening-design.md`'s pane-content
-- probe.

rule SubscribeToTaskViaMcp {
    when: McpSubscribeToTask(watcher_task, target_task)

    requires: watcher_task != null
    requires: target_task != null

    ensures: SubscribeToTask(watcher: watcher_task, target: target_task)

    @guidance
        -- subscribe_to_task(watcher_task_id, target_task_id) registers a
        -- one-shot watch: watcher_task is notified via a tmux-injected
        -- message once target_task reaches Done or Archived (or is deleted
        -- first). Both ids must resolve to existing tasks — an unresolved
        -- id is rejected the same way any other MCP tool rejects a task id
        -- that does not exist.
        -- Self-watch rejection, the already_finished short-circuit, and
        -- idempotency on an existing unfinished (watcher, target) pair are
        -- all enforced by the underlying SubscribeToTask rule — see
        -- task-watchers.allium, which also owns the TaskWatcher entity this
        -- tool creates rows in.
        -- Handled by handle_subscribe_to_task in
        -- src/mcp/handlers/tasks/watch.rs.
}

rule UnsubscribeFromTaskViaMcp {
    when: McpUnsubscribeFromTask(watcher_task, target_task)

    requires: watcher_task != null
    requires: target_task != null

    ensures: UnsubscribeFromTask(watcher: watcher_task, target: target_task)

    @guidance
        -- unsubscribe_from_task(watcher_task_id, target_task_id) removes a
        -- specific (watcher, target) subscription; idempotent no-op if none
        -- exists — see the UnsubscribeFromTask rule in task-watchers.allium.
        -- Handled by handle_unsubscribe_from_task in
        -- src/mcp/handlers/tasks/watch.rs.
}

-- == CLI surface ==

rule AttachPlanViaCli {
    when: CliAttachPlan(task, path)

    requires: task != null

    ensures: task.plan_path = path

    @guidance
        -- CLI command: `dispatch plan <id> <path>` attaches a plan file to
        -- an existing task by writing task.plan_path directly via
        -- db.patch_task. No status transition occurs; the plan attachment
        -- is decoupled from dispatch.
        -- Implementation: src/main.rs Commands::Plan match arm.
        -- Used by the /queue-plan slash command (and operators) to stage
        -- a plan onto a task before dispatching it.
}

-- @guidance: Other CLI subcommands (operator/diagnostic surfaces; not
-- modeled as separate rules because they do not mutate task domain state
-- beyond what existing rules already cover):
--   • `dispatch tui [--port]` — the only entry point, launching the TUI
--     (src/main.rs Commands::Tui). --port also reads the DISPATCH_PORT env
--     var and defaults to core/config.mcp_port. It obtains its own tmux
--     session and offers to write the Claude Code MCP configuration before
--     the board draws — see startup.allium, and CreateTaskViaMcp guidance for
--     the headersHelper that configuration installs. There is no separate
--     setup command.
--   • `dispatch uninstall [--yes] [--purge]` — destructive: removes the
--     dispatch MCP configuration from Claude Code; with `--purge` also
--     deletes the database and log files (src/main.rs Commands::Uninstall).
--     Operator-only — never invoked by agents or hooks.
--   • `dispatch repo set-verify <path> <command>` /
--     `dispatch repo clear-verify <path>` / `dispatch repo list` — operator
--     equivalents of SetVerifyCommandViaMcp, writing the same
--     core/SavedRepoPath.verify_command. set-verify creates the path entry
--     when it does not exist yet.
--   • `dispatch prune-repo-paths` — drops core/SavedRepoPath rows whose path
--     no longer exists on the filesystem. Operator-only housekeeping.
--   • `dispatch hook <id> <kind> [--kind K]` — see HookNotification in agent-health.allium.
--   • `dispatch pr-gate <id>` — see PrLearningsGate in pr-workflow.allium.
--   • `dispatch caller-headers` — prints the session identity header and
--     exits 0, always. Reads nothing: not its arguments, not its working
--     directory, not the database. See CreateTaskViaMcp guidance.
--   • `dispatch verify-feed <command>` — see VerifyFeed in feeds.allium.
--
-- There is deliberately NO CLI surface for listing tasks or changing a
-- task's status. The `dispatch list` and `dispatch update` subcommands were
-- removed once the installed Claude Code hooks moved to the dedicated
-- `hook-*` subcommands and agents moved to the MCP tools; the board and the
-- MCP tools are the only surfaces for reading and mutating task state.

-- == MCP Wrap-Up and Exit Tools ==

rule WrapUpViaMcp {
    when: McpWrapUp(task, action)

    requires: task.status = running or task.status = review
    requires: task.worktree != null
    -- A review task does not end by being wrapped up (ReviewTasksAreNotWrappedUp).
    -- The code gates on the core/TaskTag::is_review predicate rather than on
    -- these two literals, so the clause below is the narrower statement. What
    -- keeps them in step is a test, not this comment:
    -- task_tag_is_review_only_for_pr_review_and_dependabot derives the review
    -- set from TaskTag::ALL, so a third review tag fails there and sends
    -- whoever added it here.
    requires: task.tag != pr_review and task.tag != dependabot

    -- All three actions leave task.status unchanged (still running/review) and
    -- only issue an exit token that records which action was requested. The
    -- terminal mutation (Done, or Review + pr-typed url) is deferred to the
    -- single ExitSessionViaMcp call. pr_url is no longer a wrap_up param — it
    -- travels with exit_session instead.
    ensures:
        if action = rebase:
            -- repo_path travels on the event because its consumer
            -- (RefreshRepoSyncStateAfterRebase in repo-sync.allium) needs the
            -- repository whose base branch just moved, and a branch name alone
            -- does not identify one.
            BranchRebased(
                branch: task.worktree.branch,
                onto: task.base_branch,
                repo_path: task.repo_path
            )
            issue_exit_token(task, rebase)
        else if action = done:
            issue_exit_token(task, done)
        else if action = pr:
            issue_exit_token(task, pr)

    @guidance
        -- wrap_up is the mandatory step before exit_session for ALL three
        -- actions (rebase, done, pr). It records action on the exit token
        -- (token.action) and returns that token in the response text; the
        -- agent must pass it back to exit_session.
        -- action="rebase" is the only action that does real synchronous work
        -- here: it runs the rebase / fast-forward (BranchRebased) via
        -- finish_task, which performs no session teardown, so the session
        -- stays alive until exit_session. action="done" and action="pr" perform no task-status
        -- or url mutation at wrap_up time — done no longer flips to Done, and
        -- pr no longer sets task.url or moves the task to review. Those
        -- mutations are applied later, atomically, by ExitSessionViaMcp. This
        -- removes the old asymmetry where done/pr mutated status inside
        -- wrap_up while rebase deferred to exit_session.
        -- The /wrap-up skill runs the /retro skill before its commit step,
        -- ahead of wrap_up, so any agent-context fix retro makes is committed
        -- with the session's work rather than stranded after the rebase.
        -- For the pr path the agent has already run git push and
        -- gh pr create by this point, and passes the resulting URL to
        -- exit_session (not to wrap_up).
        -- Handled by handle_wrap_up in src/mcp/handlers/tasks/wrap_up.rs.

    @guarantee ReviewTasksAreNotWrappedUp
        -- A review-tagged task is refused, whatever its status and whatever
        -- action is asked for. Such a task has no wrap-up to perform: it ends
        -- when its PR merges, or when the agent hands it back to the user and
        -- the user takes it over. Nothing is committed, rebased, or PR'd on
        -- its behalf, so every one of the three actions would be a no-op that
        -- still spent an exit token.
        --
        -- What cleans it up is the FEED's stale pass (feeds.allium:
        -- AppendOnlyFeed's counterpart — a card whose PR has merged stops
        -- being emitted and is deleted on the next poll), not
        -- pr-workflow.allium's PollPrStatus. PollPrStatus filters on
        -- status = review with a pr-typed url, and a review task never
        -- reaches that pair: the only rule that sets it is the terminal
        -- ExitSessionViaMcp patch, which this guarantee makes unreachable.
        -- So a review task lives its whole life in running.
        --
        -- That also bounds the claim. A feed-created review task is cleaned
        -- up; a review task dispatched by hand is not, and after this refusal
        -- nothing the agent can call releases its worktree or tmux window —
        -- the user closes it from the TUI. Behaviour is unchanged from the
        -- prompt line this replaced, which forbade wrap-up just as flatly,
        -- but the limit is worth naming rather than implying an auto-clean
        -- that only some of these tasks get.
        --
        -- This was a prompt instruction before it was a guard. Both review
        -- runbooks opened with "do not call /wrap-up", which is a rule
        -- stated where it cannot be enforced: an agent that ignores the
        -- line reaches a tool that accepts the call. Refusing here is what
        -- lets the line go, and it also covers the agents the line never
        -- reached — a review task the user dispatched by hand, or one the
        -- agent resumed in a later session.
        --
        -- The refusal names the tag as the reason, says a review task ends
        -- at its PR rather than at wrap-up, and names the one way out: a
        -- review task that has genuinely become code work is retagged
        -- (update_task with a non-review tag) and wrapped up as that. The
        -- escape hatch is stated because the alternative is an agent that
        -- has done real work and is told only "no" — it would leave the
        -- work uncommitted rather than infer the retag.
        --
        -- Refusing wrap_up leaves exit_session unreachable for these tasks
        -- (ExitSessionViaMcp requires a token wrap_up mints), which is the
        -- intended shape: a review agent stops when it has presented its
        -- findings, exactly as build_prompt's review runbooks describe.
        --
        -- The refusal is also REPORTED by GetTaskViaMcp, on a "Wrap-up:
        -- refused — …" line carrying the same sentence. wrap_up is the last
        -- call of the /wrap-up skill's sequence and get_task is its second,
        -- so a refusal delivered only at the tool lets an agent run a retro
        -- and a commit that nothing wanted. One predicate answers both, so
        -- the two can not drift into disagreeing about whether a given task
        -- may wrap up.
}

rule ExitSessionViaMcp {
    when: McpExitSession(task, token, action, pr_url?)

    requires: exit_token_exists_for(task)
    requires: token = exit_token_value_for(task)
    requires: action = exit_token_action_for(task)
    requires: task.tmux_window != null
    requires:
        if action = pr: pr_url != null and pr_url != ""

    -- The terminal write — status, sub_status, url and the cleared
    -- tmux_window reference, applied as one patch — can fail at the
    -- persistence layer. Whether it took effect gates the terminal mutation,
    -- the tmux teardown and the SessionClosed emission below; only consuming
    -- the exit token happens either way. Same condition as ExitSession in
    -- pr-workflow.allium.
    let close_persisted = terminal_close_persisted(task)

    -- The window the teardown below names comes from the CLOSE OUTCOME — a
    -- fresh read of task.tmux_window taken immediately before the terminal
    -- patch, by the same call that applies it — not from task.tmux_window as
    -- read at the top of this rule, which a concurrent writer has a much wider
    -- window to have changed. The fresh read narrows that race to nothing but
    -- is still a separate read from the patch, not atomic with it. Same
    -- binding as ExitSession in pr-workflow.allium.
    let window = closed_session_window(task)

    ensures:
        consume_exit_token(task)
        -- The teardown is conditional on the same write as the terminal
        -- mutation, so a task whose close did not persist keeps both its live
        -- window and its tmux_window reference — the two can never disagree.
        if close_persisted:
            not exists window
            task.tmux_window = null
            if action = pr:
                task.status = review
                task.sub_status = core/SubStatus.default_for(review)
                task.url = core/TaskUrl{url: pr_url, url_type: pr}
            else:
                task.status = done
                task.sub_status = core/SubStatus.default_for(done)
                task.completed_at = now
            task.updated_at = now

    -- Emitted after the terminal mutation and after the task/epic-changed
    -- notifications have landed, so an epic chain keyed on it
    -- (AutoDispatchNextSubtask in epics.allium) sees the closed task in its
    -- terminal state. The tmux teardown is ISSUED before this point but is
    -- fire-and-forget: nothing waits for it, so its completion is not ordered
    -- against SessionClosed or against anything the chain then does.
    -- Conditional on the same write: a close that did not take effect must not
    -- chain.
    ensures:
        if close_persisted:
            SessionClosed(task: task)

    @guidance
        -- Single-call session close for all three wrap-up actions. The old
        -- two-phase behaviour (first call showed a reflection prompt and set
        -- token.reflected, second call closed) is gone: the mandatory
        -- reflection is now the /retro skill, which the /wrap-up skill runs
        -- BEFORE exit_session is ever called. With /retro as the forcing
        -- function, the in-handler reflected flag and first-call/second-call
        -- branch are removed.
        -- Validation, in the order the handler applies it (all mutate nothing
        -- on failure):
        --   • token must equal the token issued for this task, else "invalid
        --     exit token"; a missing token → "no exit token — call wrap_up
        --     first".
        --   • the supplied action must equal the action recorded on the token
        --     (exit_token_action_for). A missing action → "action is required".
        --     A mismatch (e.g. token issued for wrap_up(rebase) but the agent
        --     calls exit_session(action="pr")) is rejected with an error naming
        --     both actions.
        --   • task.tmux_window must be non-null. If already null, some other
        --     path already tore the session down; the handler reports "task
        --     #<id> has no active session" and the /wrap-up skill treats it as
        --     success. (On a normal double-close the token has also been
        --     consumed, so a retry hits the "call wrap_up first" branch above
        --     first.)
        --   • pr_url is required iff action = pr; it is rejected/ignored for
        --     rebase and done.
        -- Terminal mutation, applied atomically with clearing tmux_window and
        -- consuming the token:
        --   • rebase / done → task.status = done, task.completed_at = now
        --                      (applied by close_session, the same completion
        --                      stamp as tasks/ConfirmDone)
        --   • pr            → task.status = review, task.url = TaskUrl(pr_url,
        --                      url_type = pr) — this branch does not enter done,
        --                      so task.completed_at is untouched
        -- task/epic-changed is notified for all three actions; the underlying
        -- patch flow (src/service/tasks/crud.rs) triggers EpicStatusRecalculation
        -- on the parent epic. Handled by handle_exit_session in
        -- src/mcp/handlers/tasks/wrap_up.rs.
        -- When that terminal patch FAILS (close_persisted = false), the call is
        -- still a successful tools/call response, NOT a JSON-RPC error: the exit
        -- token has already been consumed by this point, so an error would
        -- strand the agent with no retry path. What changes is the response text
        -- — instead of the session-closed message (with or without a
        -- chained-subtask sentence) the response states that the task could not
        -- be moved to its terminal status, that the tmux session is still alive,
        -- names the task, and tells the agent the close needs redoing by hand.
        -- It must NOT claim the session was torn down, because it was not: the
        -- agent must not treat that response as a completed close.
        -- Everything else on that path: the failure is logged at warn, no
        -- kill-window is issued so the window survives and still hosts a live
        -- agent the human can attach to, the task keeps its status, sub_status,
        -- url and tmux_window (so it never satisfies is_detached and cannot
        -- drift into the awaiting-merge rendering), and SessionClosed is not
        -- emitted so no epic chain fires. ExitSession in pr-workflow.allium
        -- carries the full rationale, including the signals that were considered
        -- and rejected.
        -- Why the pr path closes the PR-merge race: a PR task never enters
        -- review with a pr-typed url until the exact same call that also nulls
        -- tmux_window, so PollPrStatus (which filters on status = review and
        -- url.url_type = pr) can never observe it mid-session.
        -- SessionClosed is emitted after the terminal patch and the
        -- task/epic-changed notifications, and only when that patch took
        -- effect. The kill-window teardown is issued just before it but is
        -- never awaited, so the window's death is not ordered against
        -- SessionClosed or the chain — it may land before or after. It is what
        -- drives automatic epic
        -- chaining (AutoDispatchNextSubtask in
        -- epics.allium), and it is fire-and-forget: a chain that stops, or
        -- fails, never turns a successful close into an error. All three
        -- actions emit it — for action = pr the finished work sits on a PR
        -- branch rather than base_branch, so the chained subtask still will not
        -- see it, but that is inherent to choosing the PR path rather than
        -- something this close does wrong. When a chain does fire, the response
        -- text names the subtask it dispatched; otherwise it is the plain
        -- session-closed message. There is no agent-facing tool to dispatch the
        -- next subtask — the tool description says so explicitly, so an agent
        -- reading tools/list does not go looking for one.
}

rule SetVerifyCommandViaMcp {
    when: McpSetVerifyCommand(repo_path, command?)

    -- A command may not span multiple lines; embedded newlines or
    -- carriage returns are rejected at the handler boundary. This
    -- upholds core's VerifyCommandSingleLine invariant before the value
    -- is ever stored.
    requires:
        if command != null:
            not (command.contains("\n") or command.contains("\r"))

    ensures: core/SavedRepoPath.created_or_updated(
        path: repo_path,
        verify_command: if command = null or is_blank(command): null else: command
    )

    @guidance
        -- set_verify_command stores (or clears) the verify command
        -- associated with a repo_path in saved_repo_paths.verify_command.
        -- A blank or whitespace-only command is normalised to null (clear)
        -- by the DB layer, matching the trait contract.
        -- A command containing "\n" or "\r" is rejected at the handler
        -- with JSON-RPC -32602 (invalid params) before reaching the DB,
        -- which would otherwise surface the constraint as -32603.
        -- Nothing nudges an agent to call this tool: exit_session carries no
        -- prompt about it, and wrap_up only echoes an already-recorded command
        -- back as its "Verify before exiting" line (see WrapUpRebase in
        -- pr-workflow.allium). Recording a verify command is an explicit act by
        -- an agent or operator (see the `dispatch repo set-verify` CLI above).
        --
        -- == The tool description does not claim prompt injection ==
        -- The description states that the command never appears in a dispatch
        -- prompt, and names the two surfaces that do carry it: get_task's
        -- "Verify command" line and the wrap_up response's "Verify before
        -- exiting" reminder. It said the opposite for a time — that the command
        -- was injected into future agent prompts — which contradicts the
        -- prompt-assembly rule in dispatch-prompt.allium and sends the one reader who
        -- needs the command looking on the single surface that never carries
        -- it. A description that disagrees with the prompt rule is a defect in
        -- the description, not a second opinion.
        -- Handled by handle_set_verify_command in
        -- src/mcp/handlers/tasks/verify.rs.
}
