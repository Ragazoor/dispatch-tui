-- allium: 3
-- dispatch.allium
--
-- Scope: Dispatching tasks into worktrees and tmux sessions — repo-path
--        persistence, prompt augmentation, retry flows, and the surfaces
--        the user sees while a dispatch is in flight.
-- Excludes: Task creation and lifecycle (see tasks.allium); PR/wrap-up
--           flows (see pr-workflow.allium); split-pane behaviour
--           (see split-pane.allium); MCP dispatch tools (see
--           mcp-task-tools.allium); epic dispatch (see epics.allium);
--           learning prompt augmentation (see learnings.allium).

use "./core.allium" as core

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Per-repo cap on remembered base branches. RecordBaseBranch prunes a
    -- repo's history down to the most-recently-used max_base_branches_per_repo
    -- entries on every write; callers never manage the cap (see the
    -- BranchHistoryCapped invariant).
    max_base_branches_per_repo: Integer = 10

    -- Wall-clock budget for the command the status-line decorator chains to
    -- (see StatusLineDecorator). Covers both the chained command producing its
    -- output and its exit: the decorator abandons it at the deadline rather
    -- than waiting on either. Deliberately short — Claude Code re-runs the
    -- decorator on a sub-second debounce, and the chained command in practice
    -- shells out to git, which can block on a lock, NFS or a network remote.
    statusline_chain_timeout: Duration = 2.seconds
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Repo Path ==

rule RecordRepoPath {
    when: RepoPathUsed(path)

    ensures: core/SavedRepoPath.created_or_updated(
        path: path,
        last_used: now
    )

    @guidance
        -- Fires whenever a repo path is used to create or edit a task
        -- through the TUI:
        --   - TUI task creation (after InputBaseBranch submission)
        --   - TUI quick-dispatch (Shift+D)
        --   - TUI task edit (EditTask) when repo_path changes to a
        --     non-empty value, so sibling feed items (e.g. other
        --     Dependabot PRs in the same repo) can be auto-resolved
        --     by resolve_feed_item_repo_paths on subsequent feed syncs
        -- The path is first expand_tilde'd. If a SavedRepoPath with
        -- the same path already exists, last_used is bumped to now;
        -- otherwise a new record is created.
        -- Not fired for MCP task creation (create_task tool) — that
        -- skips repo path persistence. (There is no CLI for task
        -- creation; tasks are created exclusively via MCP.) Cap
        -- enforcement (maximum stored paths) is an implementation
        -- detail and not specified here.
}

-- == Base Branch History ==

rule RecordBaseBranch {
    when: BaseBranchUsed(repo, branch)

    ensures: core/SavedRepoBranch.created_or_updated(
        repo_path: repo,
        branch: branch,
        last_used: now
    )
    -- Prune the repo's history down to the cap, dropping the least-recently-used
    -- rows so at most config.max_base_branches_per_repo remain for this repo.
    -- Pruning is part of this write; callers never manage the cap.
    ensures:
        let history = core/SavedRepoBranches where repo_path = repo
        for stale in history where rank_by_recency(stale, history) > config.max_base_branches_per_repo:
            not exists stale

    @guidance
        -- Records a base_branch into a repo's most-recently-used history so
        -- it can be offered by the BaseBranchPicker next time a task is
        -- created for the same repo. If a SavedRepoBranch with the same
        -- (repo_path, branch) already exists, last_used is bumped to now
        -- (upsert); otherwise a new row is created. After the upsert the
        -- repo's rows are pruned to the config.max_base_branches_per_repo
        -- most-recently-used, keeping the history bounded. This preserves the
        -- BranchHistoryCapped invariant as a property of the write itself, so
        -- no caller has to enforce the cap.
        --
        -- == Recording scope (deliberately narrow) ==
        -- BaseBranchUsed is emitted from EXACTLY ONE entry point: the manual
        -- TUI "new task" form, when it is finished (finish_task_creation),
        -- alongside the existing RepoPathUsed emission. It is NOT emitted by:
        --   - quick dispatch (CreateQuickTask / Shift+D), which resolves its
        --     base branch from origin/HEAD detection and bypasses the form; or
        --   - the MCP create_task tool, which never goes through the TUI form.
        -- This keeps the history a record of branches the user deliberately
        -- typed/selected, not an incidental log of every branch the system
        -- has ever targeted. The copy-task flow needs no special-casing: it
        -- flows through the same InputRepoPath -> InputBaseBranch ->
        -- finish_task_creation path, so it records for free.
        --
        -- On write failure the error is surfaced through the status bar (the
        -- same path RecordRepoPath uses), not silently swallowed.
        --
        -- rank_by_recency(row, history) is a black-box ranking helper: the
        -- 1-based position of row within history ordered by last_used
        -- descending (1 = most recent). Rows ranked beyond the cap are the
        -- least-recently-used and are removed.
}

-- == Dispatch ==

rule DispatchTask {
    when: DispatchTask(task)

    requires: task.status = backlog
    -- Tasks with a plan always dispatch. Tasks without a plan dispatch
    -- unless they carry the research tag (the only remaining tag that
    -- routes to a dedicated agent).
    requires: task.has_plan = true
              or task.tag != research

    ensures: task.status = running
    ensures: task.sub_status = core/SubStatus.default_for(running)
    ensures: task.last_pre_tool_use_at = now
    ensures:
        for entry in core/SubagentEntries where task = task:
            not exists entry
    ensures: task.live_subagents = 0
    ensures:
        for entry in core/ShellEntries where task = task:
            not exists entry
    ensures: task.live_shells = 0
    ensures: task.oldest_live_shell_started_at = null
    ensures: task.stop_pending = false
    ensures: task.worktree = core/Worktree.created(
        path: task.repo_path + "/.worktrees/" + task.id + "-" + slugify(task.title),
        branch: task.id + "-" + slugify(task.title)
    )
    ensures: task.tmux_window = core/TmuxWindow.created(name: "task-" + task.id)
    ensures: AgentLaunched(task: task, mode: standard)

    @guarantee OneNameForStartingATask
        -- The action-hint label for this key on a BACKLOG task is
        -- "dispatch", unconditionally — it does not vary on whether the task
        -- has a plan attached. "Dispatch" is the name of the act of starting
        -- a task, and that act is identical either way: the same worktree,
        -- the same tmux window, the same agent. What the plan changes is only
        -- what the prompt tells that agent to do first (see the unified
        -- prompt skeleton below), which is not something the user is choosing
        -- between when they press the key.
        -- The no-plan label previously read "brainstorm", after the design
        -- skill the no-plan prompt used to name. That made a prompt-internal
        -- detail into a second user-facing verb for one action, and it
        -- outlived the skill itself: the design step is now an Allium-first
        -- elicit-and-spec sequence, so the label named a workflow that no
        -- longer existed.

    @guarantee DesignStepMatchesTheReposSpecs
        -- The design step a prompt names depends on whether the task's
        -- repository actually keeps Allium specs. A repository HAS Allium
        -- specs when task.repo_path (tilde-expanded) holds at least one
        -- `docs/specs/*.allium` file. The check is one directory read per
        -- dispatch, against the parent repo rather than the freshly
        -- provisioned worktree, and it is not persisted: nothing on
        -- core/SavedRepoPath records it, so a repo that gains or loses its
        -- specs changes prompt shape on its very next dispatch, with no
        -- setting to update and no migration.
        --
        -- Every failure to see such a file counts as "no specs": a missing
        -- docs/specs directory, an empty one, one holding no .allium file,
        -- and an unreadable one all take the same branch. There is
        -- deliberately no error arm — one rule, one answer — so the prompt
        -- an agent receives never depends on which way a read failed.
        --
        -- Where the check cannot be attempted at all the answer is spec-first,
        -- not brainstorming: a prompt assembled without the filesystem read is
        -- built for a repo assumed to keep specs, because the cost of naming a
        -- spec-first step in a repo that has none (an agent that asks where
        -- docs/specs is) is smaller than the cost of the reverse (an agent that
        -- silently skips the spec this repo does keep). Only the read itself is
        -- entitled to answer "no specs". An empty task.repo_path is not such a
        -- case — DispatchTask refuses to launch at all without one.
        --
        -- When the repo HAS specs: the no-plan addendum is
        -- spec_first_instruction (the elicit -> tend -> propagate ->
        -- implement -> weed sequence detailed below) and the trailing block
        -- carries {allium_instruction}.
        --
        -- When the repo has NO specs: the no-plan addendum instead names
        -- the `superpowers:brainstorming` skill as the design step, and
        -- states the reason — this repo has no Allium specs — so the agent
        -- does not read the missing spec-first sequence as an oversight.
        -- {allium_instruction} is omitted from the trailing block, in BOTH
        -- plan states, for the same reason: telling an agent that
        -- `docs/specs/` is the source of truth for domain logic is false in
        -- a repo with no such directory, and it would send the agent
        -- looking for one.
        --
        -- The fallback names the skill and stops. It does not restate
        -- brainstorming's own process, and it does not restate TDD —
        -- brainstorming names no design sequence of its own, so
        -- {tdd_instruction} stays in its trailing block. The
        -- behaviour belongs to the skill the agent loads; a prompt that
        -- paraphrases it can only drift from it.
        --
        -- What the two branches say identically: writing a docs/plans/ doc
        -- and attaching it via update_task is the agent's judgement call,
        -- not a requirement; and the design step is explicitly not the end
        -- of the task — implementation must follow in the same session,
        -- except for an epic-decomposition task, for which creating work
        -- packages for its subtasks is the named alternative. Both branches
        -- are therefore intermediate steps, never stopping points.
        --
        -- The branch reaches only the prompts that ask for a design step or
        -- emit the full trailing block: build_prompt and
        -- build_quick_dispatch_prompt. DispatchResearchTask and the
        -- dependabot / pr_review addenda already emit a trimmed trailing
        -- block with no {allium_instruction} and name no design step, so
        -- they are unaffected and need no branch.
        --
        -- Nothing on the kanban board changes: the action-hint label stays
        -- "dispatch" whichever design step the prompt names, per
        -- OneNameForStartingATask above.

    @guarantee NoLineRestatesTheDesignStep
        -- The trailing block never repeats a rule the addendum above it has
        -- already given. Concretely: when spec_first_instruction is in the
        -- prompt, BOTH {tdd_instruction} and {allium_instruction} are dropped.
        -- That sequence states test-first as its steps 3 and 4 ("confirm they
        -- fail before you write any code" / "implement the minimum code that
        -- makes them pass") and the tend/weed cycle as its steps 2 and 5, all
        -- four unconditionally.
        --
        -- Repeating either a few lines later is not harmless reinforcement. The
        -- trailing wordings are WEAKER than the steps they repeat —
        -- {allium_instruction}'s "if your implementation changes domain
        -- behaviour" is a conditional where step 2 was an unconditional step —
        -- so an agent reconciling the two can read the restatement as
        -- narrowing the step, and conclude the spec update is optional. Two
        -- wordings of one rule cost tokens and buy ambiguity.
        --
        -- The omission is conditional on spec-first actually being present, and
        -- the other two paths keep both lines because neither states them
        -- elsewhere: a task WITH a plan attached never reaches the sequence,
        -- and brainstorm_instruction names a skill without naming TDD or
        -- Allium.
        --
        -- The same rule reaches one line further, on a different axis. BOTH
        -- design steps close by saying the design is not the end of the task
        -- and implementation follows in the same session, with the
        -- epic-decomposition carve-out attached. The trailing block's
        -- stopping-point sentence said that again, two paragraphs later, so it
        -- is emitted only on the plan path — the one path with no design step
        -- above it to have said it. That path is also where the rule matters
        -- most: an agent handed a ready plan is the case that read a
        -- plan-only state as finished.
        --
        -- Two things make this a narrower cut than the TDD and Allium
        -- omissions. The plan-path wording drops "writing a spec or" and names
        -- only the plan, because no spec-writing step runs on that path, so
        -- the surviving sentence is more accurate and not merely shorter. And
        -- {wrap_up_instruction} itself stays universal: "use the /wrap-up
        -- skill to commit any remaining changes and finalise the task" is the
        -- one thing no design step states, and it keeps the end-of-prompt
        -- position a closing instruction earns. Its carve-out phrase does
        -- still appear on both, deliberately — above it qualifies how the
        -- task may FINISH, here it qualifies when to CALL the skill.

    @guarantee ThePromptNamesNoToolMerelyToSayItExists
        -- Dispatch's MCP tools reach the agent as real tool schemas, so prompt
        -- prose that lists them ("the dispatch MCP tools are available —
        -- get_task, update_task") shadows that list: it states no fact the
        -- schema lacks, and it goes stale the moment the tool set changes,
        -- with nothing checking it. A tool is named in a prompt only where the
        -- prompt asks for a SPECIFIC call the schema cannot imply — quick
        -- dispatch naming update_task for the rename off its placeholder
        -- title. What a tool does belongs in that tool's own description; see
        -- the tool-description standard at the head of mcp-task-tools.allium.
        --
        -- {learning_tools_instruction} was the second example this guarantee
        -- gave, on the grounds that only the prompt said WHEN to reach for
        -- query_learnings. That stopped being true in the same commit that
        -- wrote the carve-out: the accuracy pass that lifted six tool
        -- descriptions over the three-sentence floor ended query_learnings
        -- with "Call it when something is unclear, before guessing or asking",
        -- which is the prompt clause word for word. rate_learning ("Call any
        -- time you act on a retrieved learning") and delete_learning ("Use it
        -- for an entry that is wrong or has gone stale, rather than only
        -- downvoting it") absorbed the other two clauses the same way. So the
        -- line now names three tools to restate three schemas, and the
        -- carve-out no longer covers it: it names the /learnings SKILL and
        -- nothing else. Trigger text for a skill is the one thing here with no
        -- schema to shadow — skills under-trigger, and a skill listing carries
        -- a description, not a nudge to invoke it.
        --
        -- Gated by prompt_trailing_lines_name_no_mcp_tool, which fails on any
        -- mcp__dispatch__* tool name appearing in the shared trailing lines.

    @guarantee EveryTaskAgentLaunchesInAutoMode
        -- Every task-agent launch starts Claude in auto mode — i.e.
        -- with no --permission-mode flag at all — with no exceptions.
        -- This holds for DispatchTask, DispatchResearchTask, quick
        -- dispatch and ResumeTask alike: an agent edits files without a
        -- per-edit approval prompt, so an unattended launch is not left
        -- blocked on a dialog nobody is watching.
        -- ResumeTask is named deliberately. It does not share the
        -- dispatch launch path — it composes its own claude command —
        -- so it is the one launcher the guarantee reaches only by
        -- assertion, not by construction.
        -- What differentiates the modes is the prompt content, never the
        -- permission flag. A mode that must not change code says so in
        -- its prompt — see DispatchResearchTask, whose addendum carries
        -- the "Do NOT make code changes" instruction.
        -- Research was formerly the sole exception, launching with
        -- --permission-mode plan to make investigation read-only by
        -- construction. That traded an unattended agent for an enforced
        -- one: plan mode parks the agent on an approval dialog for work
        -- the research prompt already forbids, and a research session
        -- that must ask before every read is slower without being safer.
        -- The instruction now carries the whole constraint.

    @guarantee AgentCarriesItsOwnCallerIdentity
        -- Every agent launch hands Claude Code a per-task MCP configuration
        -- that declares the dispatch server with a FIXED
        -- `X-Caller-Task-Id: <task.id>` header. The agent's identity travels
        -- with the launch, decided by the launcher that already knows which
        -- task it is starting.
        --
        -- It cannot be derived at the agent's end. The
        -- `dispatch caller-headers` headersHelper that `dispatch setup`
        -- installs in Claude Code's user-global config reads its own working
        -- directory to recognise a `.worktrees/<id>-<slug>` path — and Claude
        -- Code runs a helper declared there from ITS OWN config directory, not
        -- from the session's. The helper therefore answers "session" for every
        -- dispatched agent, correctly for the directory it was handed and
        -- uselessly for the question being asked. Nothing in the environment it
        -- receives names the session's workspace, so no amount of repair to the
        -- helper can recover the answer.
        --
        -- Where that entry lives is HANDED to the launch, not looked up by it,
        -- on the same terms and for the same reason as
        -- SettingsLocationIsAnExplicitStartupInput below: startup resolves the
        -- operator's locations once and passes them down, so a run that is not
        -- the operator's own session is handed locations of its own and cannot
        -- reach theirs. A launch told about no such location writes no
        -- configuration, which is the best-effort arm below.
        --
        -- The per-task configuration is DERIVED FROM the user's own `dispatch`
        -- entry rather than composed from scratch: the entry is copied, its
        -- headersHelper dropped, and the fixed header put in its place. So the
        -- transport and the URL — including a non-default port — cannot drift
        -- from what `dispatch setup` wrote, and there is no second place that
        -- has to be taught the port.
        --
        -- The configuration is ADDITIVE, never exclusive. It overrides the
        -- same-named user entry and leaves every other MCP server the operator
        -- has configured available to the agent; an agent launched with only
        -- the dispatch server would silently lose tools the task may need.
        --
        -- It lives in the worktree's own git administrative directory. That
        -- keeps it out of `git status`, so an agent cannot commit it into the
        -- repository it is working on, and it is removed by the
        -- `git worktree remove` that TaskTeardown already performs — see
        -- CallerIdentityConfigGoesWithTheWorktree in tasks.allium. Nothing
        -- else deletes it and nothing needs to.
        --
        -- BEST-EFFORT, and it degrades in one direction only: if the
        -- configuration cannot be written the agent is launched WITHOUT it,
        -- never with a path that does not exist. The failure is warn-logged and
        -- costs the caller-identity surfaces (see
        -- CallerIdentityDependsOnTheLaunch in mcp-task-tools.allium) — exactly
        -- the state the system was already in — which is not worth trading a
        -- launched agent for.
        --
        -- Owed by every launch, not only by provisioning: resuming into an
        -- existing worktree (ResumeTask) launches an agent and therefore owes
        -- it too. Both launches compose their flags through one seam, so a
        -- third launcher that bypassed it would lose the plugin directory and
        -- the session name along with the identity — a loud failure in place of
        -- the silent one this guarantee exists to prevent.

    @guarantee PromptIsSeparatedFromTheLaunchFlags
        -- A launch that passes the prompt as a positional argument puts a bare
        -- `--` between the flags and the prompt. The prompt is then the
        -- program's operand, whatever the flags in front of it are.
        --
        -- Without it the launch is only accidentally correct. Claude Code's
        -- `--mcp-config` is VARIADIC (`<configs...>`): it keeps consuming
        -- following words until the next `-`-prefixed one. Ending the flags
        -- with it — which AgentCarriesItsOwnCallerIdentity above is exactly
        -- what made happen — hands the prompt to `--mcp-config` as a second
        -- configuration. Claude Code then resolves the prompt as a file path
        -- relative to the worktree and refuses to start: "Invalid MCP
        -- configuration: Failed to read file". Every dispatch fails, and the
        -- error names a path made of the worktree and the first line of the
        -- prompt.
        --
        -- So the separator is normative, not a reordering of the flags. Putting
        -- a single-valued flag last would also work today and would break
        -- silently the next time the flag order changed or a variadic flag was
        -- added; nothing about the flag string would say why the order mattered.
        --
        -- Only the prompt-carrying launch needs it. ResumeTask passes
        -- `--continue`, a `-`-prefixed word, which ends the variadic by itself.

    @guarantee AReviewRunbookCarriesOnlyTheBranchThatApplies
        -- Where a review runbook's next step is a function of what the task
        -- already carries, the harness computes it and renders one branch.
        -- The agent is never handed a decision table and asked to walk it.
        --
        -- Dependabot. The bump kind is read from the task's own title and
        -- description before the prompt is built — no network call, no `gh`
        -- invocation, nothing the feed did not already fetch. The rendered
        -- prompt states the bump on one line ("Bump: major — pandas → v3")
        -- and carries exactly one decision body: merge it, check its
        -- changelog first, summarise its breaking changes, say no changelog
        -- exists because only an image digest moved, say a group has no one
        -- changelog to clear it with, or say the kind could not be read. The
        -- other five are absent, and with them the transitions that existed
        -- only to skip past them.
        --
        -- THREE of the six route straight to the user, and they are separate
        -- bodies rather than one shared body because each states a reason and
        -- no reason is true of the others. A digest is unroutable because
        -- there is no changelog for an image move; a group because it covers
        -- several packages; an unclassified bump because nothing said what
        -- kind it is, and it is usually a single package. Sharing one body
        -- meant telling every unclassified PR it was a group.
        --
        -- The merge terminal is omitted too on a route that cannot reach it.
        -- That is not tidiness: the major branch says "never merge one
        -- yourself", and leaving the merge commands two lines under that
        -- prohibition would hand the agent the exact call it forbids. The
        -- ask-the-user terminal is always present, because every route
        -- reaches it — the dep-only and CI guards can fail on any of them.
        --
        -- Classification is best-effort and says so. It reads, in order:
        --
        --   1. the Dependabot title form ("Bump <pkg> from <X.Y.Z> to
        --      <A.B.C>", compared as semver, with 0.x treated as unstable so
        --      a 0.X → 0.(X+1) move is major);
        --   2. Renovate's grouped form;
        --   3. a DIGEST row in the body's update table — an update cell
        --      reading `digest` or `pinDigest`. The before/after image
        --      digests in the same row's Change cell are what it NAMES, not
        --      what it needs to match (see "The digest kind" below);
        --   4. for a Renovate single-package title, the VERSION PAIR in the
        --      body's update table ("`==8.6.2` → `==9.1.0`"), compared the
        --      same way;
        --   5. that same title's target. A VERSION-SHAPED bare major
        --      ("update ... to v<N>", all digits) is a major on its own —
        --      all digits rather than merely dot-free, because an image
        --      digest is dot-free too and "update actions/checkout digest to
        --      11bd719" must not report a major bump of a package whose
        --      version did not move. Any other target
        --      says nothing by itself, so it borrows step 7's Update cell
        --      WITHOUT leaving this step — the title keeps naming the
        --      package and the target, and only the kind comes from the
        --      body. That is why a dotted target can pre-empt step 6: the
        --      title has already said which package this PR is about, and a
        --      Dependabot sentence in the body would be about another one;
        --   6. the Dependabot SENTENCE in the body ("Bumps [foo] from 1.2.3
        --      to 1.2.4."), which is the one other place a version pair can
        --      be stated — Dependabot writes the same wording in title and
        --      body, and the title is read first only because it is the copy
        --      no slice can truncate;
        --   7. a major/minor/patch cell anywhere in the body.
        --
        -- Steps 4 and 5 are gated on a Renovate title; steps 3, 6 and 7 are
        -- NOT.
        --
        -- == The digest kind ==
        --
        -- A digest update moves the image a tag resolves to without moving
        -- the tag: "update postgres:18 docker digest to 4ef4dbc". There is no
        -- version pair to compare and no semver kind to derive, so before
        -- this kind existed every one of them read as unclassified — the
        -- board said the harness could not read the title when in fact the
        -- title was perfectly clear and no rule covered it. Renovate's first
        -- pin of an unpinned tag ("chore(deps): pin dependencies", update
        -- cell `pinDigest`) is the same kind: it states an after digest and
        -- no before one, which is a shape the Bump line already renders.
        --
        -- It routes to ASK THE USER, and the branch says WHY rather than
        -- reusing the unclassified wording: the tag did not move, only the
        -- image behind it, so there is no changelog that would clear it. That
        -- distinction is the whole point of giving it a kind. Auto-merging a
        -- digest re-pin was considered and declined — it is the one route
        -- where nothing about the new content has been named anywhere, so a
        -- green CI run is the only evidence there would be.
        --
        -- It is read from the BODY, not the title, and so is title-agnostic
        -- like step 7. The two are in fact ONE reader: `digest`, `pinDigest`,
        -- `major`, `minor` and `patch` are all words the Update column can
        -- carry, and the same unanimity rule governs all five. A table whose
        -- cells agree declares that kind however many rows say it; a table
        -- whose cells DISAGREE declares nothing.
        --
        -- That is what settles a table mixing a digest row with a semver one.
        -- It describes more than an image move, its rows disagree, and it
        -- goes to the user. Reading it as the semver kind instead would hand
        -- a multi-package PR to the single-package changelog branch, which
        -- asks for "the" changelog and merges when it comes back clean —
        -- exactly the trap the grouped rule already refuses.
        --
        -- A grouped title still short-circuits at step 2 before this is
        -- reached, which is what covers a group whose table the
        -- 500-character slice cut down to a digest row.
        --
        -- SEVERAL digest rows are still a digest update, and the split
        -- between what that reports follows the same line the kind cell and
        -- the version pair already sit either side of. The KIND survives
        -- several rows — every digest row agrees, and a kind every row agrees
        -- on is that PR's kind. The PACKAGE and the two digests do NOT: they
        -- belong to one row, so naming them for a multi-row table would
        -- attribute one image's move to the whole PR. So a table of several
        -- digest rows renders the bare line "Bump: digest re-pin", which
        -- routes exactly as a single-row one does and simply names nothing.
        -- Renovate's pin PRs are routinely multi-row, so this is the common
        -- case for `pinDigest` rather than an edge of it.
        --
        -- The same split settles an unreadable Change cell: the update cell is
        -- what makes a row a digest row, and the two digests are only what it
        -- names. So a row the 500-character slice cut before its Change cell
        -- still classifies, naming the image and no digests. Declining there
        -- would make one unreadable row behave differently from two.
        --
        -- The gate on the version pair is deliberate — a pair says which
        -- versions moved, not that this task is a dependency bump at all — but
        -- the kind cell has no such ambiguity, so it stays the title-agnostic
        -- last resort it always was, and can classify a task whose title
        -- matched nothing. The two readings also disagree about what counts as
        -- the table: the version pair is read only from a line that begins a
        -- table row, because release notes quote versions freely, whereas the
        -- kind cell needs no such guard — the word has to fill a whole cell,
        -- which prose does not do.
        --
        -- Anything else is unclassified, which is a routable answer rather
        -- than a failure: the prompt says the kind could not be read and
        -- sends the agent to ask the user, which is where an unrecognised
        -- bump ended up anyway.
        --
        -- The version pair is read BEFORE the bare major target, even though
        -- both yield the same kind for a title that carries one. The pair is
        -- strictly more information: it names the SOURCE version, so the Bump
        -- line reads "major — deepdiff 8.6.2 → 9.1.0" rather than "major —
        -- deepdiff → v9". The bare target is what settles a PR whose body did
        -- not survive, not the primary reading.
        --
        -- Exactly ONE version pair is required; several decline. Several means
        -- the body describes several packages, and no one pair is "the" bump.
        -- That is stricter than the kind-cell rule, which refuses only rows
        -- that DISAGREE — a kind every row agrees on is still that PR's kind,
        -- whereas a version pair belongs to exactly one row, so reporting it
        -- would attribute one package's versions to the whole PR.
        --
        -- The count is not a sufficient guard on its own, which is why the
        -- grouped-title branch runs before it rather than merely near it. A
        -- group's table has one row per package, but the 500-character slice
        -- can cut it after the first — so a truncated group body presents
        -- exactly one pair and reads as single-package. The title is the only
        -- part of a group that is never truncated, and it is what keeps a
        -- group out of the changelog branch.
        --
        -- The kind cell ranks last, where a reader of Renovate's documentation
        -- would expect it first. The "| Package | Type | Update | Change |"
        -- table that carries a major/minor/patch cell is the ACTION-datasource
        -- shape; a package update emits "| Package | Change | Age |
        -- Confidence |", which has no Update column at all. The cell is absent
        -- by construction there, not by truncation. Of the 15 open bot PRs
        -- sampled from epic 275, one body carried a kind cell and thirteen
        -- carried a version pair.
        --
        -- The 500-character body slice is NOT treated as a defect the
        -- classifier works around, because measurement says it is not costing
        -- one. The same sample was sliced at 500 and checked: the version pair
        -- survives in 13 of 13 Renovate bodies, and the two Dependabot PRs
        -- state their pair in the title, which is never truncated. What the
        -- slice removes is the release notes below the table, and no branch
        -- reads those. The classifier still never guesses past what it can
        -- see, and the version pair is still reported only where the PR
        -- actually stated both versions.
        --
        -- The kind is NOT declared by the feed, and that was decided rather
        -- than defaulted. feeds/FeedItem.url_type is the precedent for a
        -- declared field, and it earns its place because the SCRIPT knows
        -- something inference cannot reach — it fetched from the alerts
        -- endpoint, so it knows the URL is a security alert. Nothing
        -- equivalent holds here. Renovate applies no semver label (every
        -- sampled PR carries "dependencies, autoreview" and nothing else), so
        -- a declaring script would have to parse the very same body in jq, in
        -- BOTH shipped producers — and BOTH are user-owned copies, so neither
        -- copy that actually runs would receive the fix. fetch-reviews.sh is a
        -- template the user copies to scripts/local/ and edits;
        -- fetch-dependabot.sh is installed into <data_dir>/scripts/ by setup
        -- and then never overwritten (SeedExampleFeedEpic), which is the
        -- stronger case of the two. Declaring would move the guessing
        -- somewhere less testable and less reachable, and buy a FeedItem field
        -- and a Task column to do it. It would also not reach a hand-created
        -- dependabot task, which the harness classifier does.
        --
        -- A grouped update is NEVER routed as minor or patch, however it
        -- declares itself. Renovate titles one `(minor)` or `(patch)`, but the
        -- minor branch reads THE changelog and merges when it comes back
        -- clean, and a multi-package PR has no single changelog — so routing a
        -- group there would clear a check that was never performed. Only
        -- `(major)` keeps its own kind; every other group goes to the user.
        --
        -- The PR itself is rendered too, when the task carries a pr-typed url.
        -- The feed sets one at insert time, so the number and the owner/repo
        -- the runbook used to ask the agent to extract were already on the
        -- task — and the description it was told to extract them from is the
        -- truncation above. `gh` accepts a URL wherever it accepts a number,
        -- and a URL names its own repository, so one rendered line replaces
        -- both the extract-and-record step and the five `--repo <owner/repo>`
        -- spellings that followed it. A task with no pr-typed url keeps the
        -- old instruction: that is the hand-created case, where there is
        -- genuinely nothing recorded to state.
        --
        -- The author check is OMITTED rather than absorbed, and the omission
        -- is gated. A PR feed lists PRs by bot author, so where one did,
        -- re-deriving the author costs a `gh` call that can only ever agree —
        -- the runbook says so and tells the agent not to. Where nothing
        -- filtered, that sentence would be false, so it is not rendered.
        --
        -- What is dropped is a PROHIBITION, and nothing replaces it. The
        -- runbook does not then instruct the agent to check the author; it
        -- simply stops telling it not to, which leaves the author an ordinary
        -- unverified fact about a PR the agent was handed.
        --
        -- BOTH HALVES ARE REQUIRED to render it: the task must carry an
        -- external_id, and it must name a pr-typed url. Neither alone is
        -- sufficient, and the failure of each is a real route:
        --
        --   - external_id alone says only that SOME feed created the task.
        --     The CVE feed sets one too, and lists alerts by repo rather than
        --     PRs by author. Its task carries tag fix, but `update_task` will
        --     retag anything dependabot with no is_review guard, so the tag is
        --     not proof of which feed produced the row.
        --   - a pr-typed url alone says only that someone recorded a PR.
        --     `update_task` takes a url and the dependabot tag together, so a
        --     hand-created task can carry one with no feed involved.
        --
        -- The two are decided by ONE branch, not two agreeing ones. The
        -- bullet is rendered from the same arm that picks the `PR:` line, so
        -- it cannot appear beside "not recorded" — that is structural rather
        -- than a property anything has to assert or test. A later change to
        -- what counts as a usable PR moves both together.
        --
        -- RESIDUAL, ACCEPTED. The gate proves a feed created the task and a PR
        -- is named; it cannot prove that feed filtered by author. A
        -- user-authored feed emitting pr-typed items with tag dependabot and
        -- no author filter would still be told one ran. Closing that needs the
        -- feed to DECLARE the filtering — a Signal, say — which is a schema
        -- change for a case no shipped script produces. Both shipped PR
        -- producers do filter by author (fetch-dependabot.sh per bots.conf
        -- login, fetch-reviews.sh's bot-author pass).
        --
        -- AReviewTaggedFeedItemNamesItsPr in feeds.allium is the other half of
        -- the pair, and it constrains the emitted FeedItem, NOT the persisted
        -- row: on-conflict url preservation and `update_task` can both leave a
        -- feed-created review task without a pr url later. That is why the
        -- prompt gate re-reads the task's url rather than trusting the
        -- emission rule to have held.
        --
        -- What deliberately stays with the agent: whether the PR touches only
        -- dependency files, whether CI is green (it moves between the feed's
        -- poll and the dispatch, so a value computed earlier would be stale),
        -- fetching a changelog, scanning it for breaking-change tokens, and
        -- writing the breaking-change summary. The first two are shared steps
        -- every branch reaches; each of the last three belongs to ONE branch,
        -- and not to the same one — the minor branch fetches the changelog
        -- and scans it, the major branch writes the summary and never fetches
        -- a changelog at all.
        --
        -- The token scan is deterministic and stays with the agent anyway.
        -- That is settled, not pending: it cannot run without the changelog,
        -- and fetching one is network work on a poll timer, for a branch only
        -- a minority of the queue reaches. Moving it would put a per-PR
        -- upstream fetch inside every feed cycle to precompute an answer most
        -- cycles never use. The classifier moved because its inputs were
        -- already on the task; this one's are not, and that is the line.
        -- Nor does the harness pre-fill the
        -- approval message: it names the Bump line the prompt already carries
        -- rather than asking the agent to restate a kind it was just told, and
        -- it does not claim a changelog was read on the route where none is.
        --
        -- PR review. There is no diff-size branch. The runbook named one
        -- review command for a small diff and another for a large one, which
        -- made the agent shell out to `gh pr diff | wc -l` to pick between
        -- them. The command it routes to accepts a PR target and an effort
        -- level of its own, so the size was a proxy for a choice that command
        -- already makes. Deleting the branch is the harness absorbing it — the
        -- routing does not move, it stops existing.
        --
        -- Neither runbook forbids /wrap-up any more. That rule is enforced
        -- where it can be enforced, by the wrap_up tool itself — see
        -- ReviewTasksAreNotWrappedUp in mcp-task-tools.allium.

    @guarantee TheDepOnlyAllowlistAdmitsOnlyDeclarativeDependencyFiles
        -- The dep-only guard is a PATH allowlist, and what goes on it follows
        -- a rule rather than accruing one ecosystem at a time: a path is
        -- admitted when the whole file is dependency coordinates — a manifest
        -- or a lock file — so that matching the path is a sound proxy for
        -- "this change is only a dependency bump". The guard never reads the
        -- diff's content, so the proxy is all it has.
        --
        -- The list is NOT exhaustive of what the rule would admit. Maven's
        -- pom.xml qualifies and is absent. An ecosystem joins when a real PR
        -- is escalated for nothing, not speculatively — the rule settles
        -- whether it MAY join, and a PR is what says it should.
        --
        -- Gradle is on it by that rule: gradle/libs.versions.toml, the version
        -- catalog, and gradle.properties, where Renovate writes some versions.
        -- Both are declarative. A Renovate PR touching only the version
        -- catalog used to fail the guard and escalate to the user for nothing.
        --
        -- Gradle's BUILD SCRIPTS are deliberately excluded, and the exclusion
        -- is the rule working rather than a gap in it. build.gradle,
        -- build.gradle.kts, gradlew and gradle/wrapper/* carry executable code
        -- and a shipped binary; a path match there says nothing about what the
        -- diff did, so admitting them would let the agent auto-merge arbitrary
        -- build logic unseen. The same reasoning excludes sbt's project/*.sbt.
        -- A version-only edit to one of those is not rejected — it goes to the
        -- user, which is the guard's own failure route, not an error.
        --
        -- .github/workflows/* is the ONE stated exception. It is executable
        -- too, and it is admitted anyway because for a pinned action there is
        -- nowhere else the bump can be made — excluding it would send every
        -- action update to the user, which is the whole class of PR the
        -- runbook exists to clear. It is an exception because it is named as
        -- one here; a second one needs the same argument, not the same
        -- shape.

    @guidance
        -- == Subagent state reset ==
        -- A fresh dispatch clears every core/SubagentEntry left over from a
        -- prior run of this task (a backlog task should never carry live
        -- subagents from before) and resets live_subagents to 0. stop_pending
        -- is cleared too, but the HookSubagentStop drain path does NOT run
        -- here even if it was set: this rule already moves the task into
        -- Running, and draining to Review in the same write would leave a
        -- task freshly-dispatched-and-in-Review. The dispatch is the more
        -- informative outcome and wins. Clearing stop_pending unconditionally
        -- still matters — otherwise the bit would survive into the new
        -- session and fire a spurious flip the next time a subagent hook
        -- landed on the drain path (see agent-health.allium).
        --
        -- Every core/ShellEntry left over from a prior run is cleared the
        -- same way and for the same reason (a backlog task should never
        -- carry live shells from before), non-draining, in the same write.
        -- This is one of ShellEntry's three real structural clear points
        -- (see agent-health.allium: HookSubagentStop's guidance) — without
        -- it, a task redispatched after a prior run left a phantom
        -- ShellEntry behind would start Running while still showing a
        -- "running · N shells" label for a shell that no longer exists.
        --
        -- == The claim, and precondition timing ==
        -- The backlog precondition is not a read: it is an atomic claim, and it
        -- is the same claim on every entry point (the TUI dispatch key and its
        -- trust-confirmed, retry-fresh and quick-dispatch siblings,
        -- DispatchTaskViaMcp, and AutoDispatchNextSubtask in epics.allium). The
        -- claim applies the status half of the postcondition above — backlog ->
        -- running, default running sub_status, seeded last_pre_tool_use_at —
        -- conditionally on the task still being backlog, and it does so BEFORE
        -- provisioning starts. The worktree and tmux_window halves are written
        -- after provisioning succeeds. (The TUI path also re-asserts the status
        -- half at that point, from the board's own copy of the task; it is
        -- redundant with the claim rather than load-bearing.)
        --
        -- Two consequences, both normative. First, the precondition is evaluated
        -- against the pre-claim state and enforced by the claim itself, so
        -- exactly one caller can provision a given task no matter how many fire
        -- at once (DispatchClaimExclusive below). A caller whose claim is lost
        -- provisions nothing and launches no agent: DispatchTaskViaMcp reports
        -- that the task is no longer in backlog, the TUI clears its
        -- DispatchingFeedback entry with a failure message, and the chain never
        -- had the row as a candidate. Second, a task being dispatched is briefly
        -- running with worktree = null (see RunningTaskHasWorktree below).
        --
        -- If provisioning fails, the claim is released: the task returns to
        -- backlog with the default backlog sub_status and the
        -- last_pre_tool_use_at the claim seeded cleared again, leaving it
        -- dispatchable exactly as before. That release is itself conditional,
        -- mirroring the claim — it applies only while the task is still running
        -- with no worktree, so a task provisioned or moved on meanwhile is left
        -- alone rather than stomped back to backlog. The last_pre_tool_use_at
        -- clear is the one sanctioned exception to the ownership invariant in
        -- agent-health.allium: it unwinds a stamp this same flow wrote moments
        -- earlier, rather than overwriting a hook's.
        --
        -- Only the caller that WON the claim ever releases it, and that is exact
        -- rather than best-effort because the claim is a SINGLE conditional write:
        -- it cannot half-apply, so a caller that did not get `won` holds nothing,
        -- and a claim that errored wrote nothing. Losing the claim and failing
        -- after winning it look the same to the user but are different outcomes —
        -- the conditional release fires on "running with no worktree", which is
        -- precisely the winner's state while it provisions, so a loser that
        -- released would drag the winner's task back to backlog mid-provision
        -- (LostClaimReported on the DispatchingFeedback surface).
        --
        -- == Provisioning-failure rollback ==
        -- "Dispatchable exactly as before" is a claim about disk state (and
        -- tmux state), not just the task row, and it only holds if a failed
        -- dispatch leaves no trace of what it created. So: once `git worktree
        -- add` has created a FRESH worktree for this attempt, any later
        -- failure in the same dispatch — opening the tmux window, setting its
        -- dispatch dir, installing the split hook, writing `.claude-prompt`,
        -- or sending the launch keystroke — rolls back everything this
        -- attempt created before the error propagates, via the same
        -- kill-window-then-remove-worktree teardown used elsewhere (see
        -- TaskTeardown in tasks.allium): the tmux window this attempt opened
        -- (killed if present — a window is opened fresh on every attempt,
        -- reused worktree or not, so it is always a candidate), then
        -- `git worktree remove --force` on the path, then a best-effort
        -- `git branch -D` on the branch it created. All of it is best-effort —
        -- a rollback failure is logged, never surfacing over the original
        -- provisioning error, since the operator needs to know why the
        -- dispatch failed, not that cleanup afterward also failed.
        -- Without this, a re-dispatch of the same task would silently take
        -- the REUSED path (the orphaned directory still exists), which is a
        -- different, weaker code path than the one "exactly as before" implies
        -- — the fetch downgrades from Required to BestEffort, and an edited
        -- title changes the slug and orphans the directory permanently.
        --
        -- The worktree-and-branch half of this rollback applies ONLY to a
        -- worktree created fresh during THIS attempt. A REUSED worktree (its
        -- directory already existed before `git worktree add` was even
        -- considered) is never removed on failure, no matter which later step
        -- fails: it predates this dispatch, may hold another attempt's state,
        -- and this flow did not create it. The reuse path's failure surface
        -- is covered separately — an unreachable origin on reuse downgrades to
        -- a "Note: ..." warning (see the fetch-policy rules above), never a
        -- removal. The tmux-window half of the rollback is unconditional on
        -- reuse — the window itself is never reused, so it is always rolled
        -- back on failure regardless of whether the worktree was.
        --
        -- Each of the three tmux calls this rollback guards against —
        -- opening the window, setting its dispatch dir, installing the split
        -- hook — is bounded by SUBPROCESS_TIMEOUT (120s), so a hung tmux
        -- server now surfaces as an ordinary failure here (triggering this
        -- same rollback) within 120s rather than parking the calling thread
        -- indefinitely.
        --
        -- == Repo-trust pre-gate ==
        -- Every launch of a worktree agent from the TUI is gated on Claude
        -- Code trusting the repo: an untrusted repo makes the freshly created
        -- worktree stall on Claude Code's own interactive trust prompt, so
        -- the agent never starts. The gate runs before this rule fires, not
        -- inside it: the TUI checks trust on task.repo_path and, when
        -- untrusted, shows a confirmation prompt (ConfirmTrustRepo, "trust
        -- it? [y/N]") whose accept branch grants trust and then emits
        -- DispatchTask; declining dispatches nothing. Trust is keyed on the
        -- REPO path, which is what makes the worktree beneath
        -- <repo_path>/.worktrees/... launchable.
        -- Quick dispatch shares this gate — see QuickDispatchTrustGate and
        -- TrustRepoForQuickDispatch in tasks.allium, which apply the same
        -- check to the still-pending creation parameters (no task exists yet
        -- at that point) and write to the same trust record. Trust is the
        -- only gate the two entry points share; the rest of quick dispatch
        -- is its own path (see CreateQuickTask).
        --
        -- Before creating the worktree, `git fetch origin <base_branch>` is
        -- run in the repo root to update the remote-tracking ref. This fetch
        -- runs unconditionally — even when the worktree directory already
        -- exists on disk (pre-created) — so `origin/<base_branch>` stays as
        -- fresh as possible for the selection below. If the worktree directory
        -- already exists, only the `git worktree add` step is skipped; the
        -- fetch still runs.
        --
        -- == Fresh vs reused decides how hard the fetch tries ==
        -- Whether the worktree directory already exists is measured BEFORE the
        -- fetch, because it decides how much the fetch is allowed to cost and
        -- whether its failure is fatal. The two paths differ because the
        -- resolved ref is used for different things:
        --
        -- - FRESH — the ref is about to become the worktree's branch, via
        --   `git worktree add`. Getting it wrong bakes stale history into the
        --   branch, so origin MUST be reachable. The classification and retry
        --   rules below apply in full.
        -- - REUSED — `git worktree add` is skipped entirely, so no ref is
        --   consumed to create anything; the resolved ref feeds only the
        --   rebase preamble. A single best-effort fetch attempt still runs (to
        --   keep `origin/<base_branch>` fresh for later rebases and for the
        --   repo-sync drift indicator), but it is NOT classified and NOT
        --   retried, and any failure is a warning rather than an abort. Both
        --   the classification probe and the retry budget exist solely to
        --   serve the abort decision this path does not make, and each costs a
        --   further bounded-subprocess timeout against an unresponsive
        --   network — so an offline re-dispatch of a task whose worktree is
        --   still on disk waits for one fetch, not for a probe plus three
        --   fetches. See the reuse rows in the start-point table below for
        --   which ref is chosen when that fetch fails.
        --
        -- == Fetch failure is classified, not blanket-tolerated ==
        -- On the FRESH path a failed fetch is never treated as one uniform
        -- case, and it is never classified by matching git's stderr text —
        -- only by exit code. Once `git fetch origin <base_branch>` fails,
        -- `git ls-remote --exit-code origin refs/heads/<base_branch>` is run
        -- to tell apart:
        --
        -- - 404-class — no origin remote is configured at all, or origin has
        --   no branch by that name (ls-remote exits 2). This is NOT an error:
        --   local <base_branch> is the only ref that exists, so it is used,
        --   and a warning is surfaced to the agent as a "Note: ..." line in
        --   its prompt (same threading as before — the agent is told directly
        --   in its prompt, not just via a server-side log entry). This class
        --   is never retried: retrying a fetch of a branch that does not
        --   exist on origin cannot succeed.
        -- - infra-class — origin is reachable-or-unknown but the fetch itself
        --   failed (ls-remote exits 128, or even 0, or the probe itself fails
        --   to spawn). This is retried — `git fetch origin <base_branch>` is
        --   attempted up to a small maximum number of times (currently 3) with
        --   a short delay between attempts — and if every attempt still
        --   fails, the dispatch ABORTS: no worktree is created, no tmux
        --   window opens, no agent launches. Nothing is left on disk either —
        --   the `.worktrees/` directory is created immediately before the
        --   worktree it holds, not before the fetch, so an aborted dispatch
        --   leaves no empty directory behind. The abort message names both the
        --   cause and a next step (check connectivity, then dispatch again),
        --   because the condition is usually the operator's to fix.
        --
        -- == Start-point selection ==
        -- On a successful fetch, the worktree's start point is chosen by
        -- comparing local <base_branch> against `origin/<base_branch>`:
        -- local wins only when it holds commits origin lacks (ahead > 0);
        -- otherwise `origin/<base_branch>` is used, which is today's
        -- behaviour for the ahead = 0 case. Local is *never* chosen when the
        -- comparison is unmeasurable (local <base_branch> does not resolve on
        -- disk) — that case looks identical to "local <base_branch> does not
        -- exist" and must fall back to origin, not local.
        -- When local is both ahead and behind (diverged), local is still
        -- taken, and silently — no additional warning is added to the
        -- agent's prompt beyond what is described above; the repo-sync drift
        -- indicator (see repo-sync.allium) is the human-facing signal for
        -- divergence, not the dispatch prompt.
        -- Specifically, the worktree branch is created with
        -- `git worktree add -B <branch> <path> <selected ref>`, where
        -- `<selected ref>` is whichever of local <base_branch> or
        -- `origin/<base_branch>` was selected above.
        --
        -- When the best-effort fetch on the REUSED path fails, there is no
        -- trustworthy comparison to make — `origin/<base_branch>` is exactly
        -- the ref that could not be refreshed — so the ahead/behind
        -- measurement is skipped and the start point is fixed by the kind of
        -- base instead:
        --
        -- - a base branch resolves to local <base_branch>. It is the ref whose
        --   freshness is not in doubt, and the one wrap-up rebases onto, so
        --   the preamble and wrap-up agree. Pointing the preamble at an
        --   unrefreshed `origin/<base_branch>` would risk replaying local
        --   <base_branch>'s unpushed commits under new SHAs — the same
        --   history-duplication hazard the selection rule above exists to
        --   avoid.
        -- - a PR head branch stays pinned to `origin/<headRefName>`, never
        --   local. The carve-out below is absolute: a review must never be
        --   handed a local branch of the same name. Nothing is poisoned by
        --   staying pinned, because the reused worktree already holds the PR's
        --   code from the previous attempt; if the preamble's rebase then
        --   cannot reach the origin ref, the agent sees that directly and the
        --   "Note: ..." line explains why.
        --
        -- Either way a "Note: ..." line tells the agent that origin could not
        -- be reached and that its worktree was reused, so nothing needed the
        -- network.
        --
        -- Review tasks (tag pr-review or dependabot) that carry a PR URL are
        -- an explicit carve-out from all of the above: their worktree is
        -- always based on the PR's head branch instead of <base_branch>, so
        -- the agent sees the PR's code, and the ahead/behind comparison is
        -- never run for them. The PR's head branch is resolved with
        -- `gh pr view <url> --json headRefName,isCrossRepository`; the
        -- worktree is then created from `origin/<headRefName>` (same
        -- fetch-then-base flow as above, but always the origin ref — never
        -- compared against a local branch of the same name). This soft-falls
        -- back to <base_branch> on any gh failure, empty output, or a
        -- cross-repository (fork) PR whose head branch is not on origin.
        -- This `gh pr view` call is bounded by SUBPROCESS_TIMEOUT (120s), so
        -- a hung `gh` falls into this same soft fallback rather than
        -- blocking the dispatch indefinitely.
        -- That fallback happens before the head branch is resolved to a
        -- fetch target; it does not apply once a PR head branch has been
        -- chosen. If the subsequent `git fetch origin <headRefName>` then
        -- classifies as 404-class — origin no longer has that branch, e.g.
        -- it was merged and deleted after `gh pr view` resolved it — the
        -- 404-class local-branch fallback described above does NOT apply to
        -- a PR head branch. A stale local branch of the same name would let
        -- a review silently examine the wrong code, so this instead ABORTS
        -- the dispatch with an error naming the missing branch: no worktree
        -- is created, no tmux window opens, no agent launches. It does not
        -- fall back to <base_branch> either, because the worktree
        -- provisioning step does not know the task's base branch at that
        -- point. This abort, like the infra-class one, is a FRESH-path rule:
        -- a reused review worktree already holds the PR's code, classifies
        -- nothing, and stays pinned to `origin/<headRefName>` with a warning
        -- (see the reuse rows above). What never varies is the carve-out
        -- itself — no path ever bases a review on a local branch.
        -- For these PR-based worktrees the reused-worktree preamble (see
        -- below) also targets the PR branch (`git fetch origin <headRefName>`
        -- + `git rebase origin/<headRefName>`) rather than the base branch,
        -- framed as an on-demand refresh so the agent can pull later pushes
        -- to the PR.
        -- The launched Claude command includes a plugin-dir flag so
        -- the agent discovers dispatch plugin skills (e.g. /wrap-up).
        --
        -- == Conditional rebase preamble ==
        -- The fetch-then-rebase preamble is not unconditional. It targets
        -- the resolved start point — whichever ref, local <base_branch> or
        -- `origin/<base_branch>`, was actually selected above — and is
        -- emitted only when the worktree is being REUSED (the worktree
        -- directory already existed on disk) or for a PR-based worktree. On a
        -- fresh dispatch the preamble is absent, because the branch already
        -- *is* the resolved start point: a rebase onto it would be a
        -- guaranteed no-op at best, and if it instead targeted
        -- `origin/<base_branch>` unconditionally while the branch was created
        -- from a local <base_branch> that is ahead, it would replay those
        -- already-present commits with new SHAs — duplicating history rather
        -- than refreshing it.
        -- Invariant: the preamble's target is always the resolved base
        -- branch (task.base_branch, or else the detected default), never a
        -- literal "main".
        -- The launch carries no --permission-mode flag, for any mode —
        -- see EveryTaskAgentLaunchesInAutoMode above.

        -- == Unified prompt skeleton ==
        -- Every task-agent prompt produced by build_prompt /
        -- build_quick_dispatch_prompt / build_research_prompt has
        -- the same shape:
        --
        --   {rebase_preamble}              (conditional fetch-then-rebase
        --                                    instruction targeting the
        --                                    resolved start point — absent
        --                                    on a fresh dispatch; present
        --                                    when the worktree is reused
        --                                    or PR-based: git fetch origin
        --                                    <base> + git rebase <ref>,
        --                                    where <ref> is <base> or
        --                                    origin/<base>)
        --   {worktree_preamble}            ("Always work from this
        --                                    worktree folder — do not
        --                                    `cd` to the parent repo
        --                                    or other directories.")
        --   {preamble}                     (one line, mode-specific)
        --   <blank>
        --   Task:                          (shared task_block, always)
        --     ID: ...
        --     Title: ...
        --     Description: ...
        --     EpicId: ...                  (only if task.epic != null)
        --   {epic sibling-communication}   (only if task.epic != null)
        --   <blank>
        --   {validated_knowledge}          (tiered learnings; see
        --                                    AugmentDispatchPromptWithLearnings)
        --   {mode_addendum}                (mode-specific block)
        --   <blank>
        --   {tdd_instruction}              (omitted when the prompt already
        --                                    carries spec_first_instruction —
        --                                    see NoLineRestatesTheDesignStep)
        --   {allium_instruction}           (only when the task's repo keeps
        --                                    Allium specs — see
        --                                    DesignStepMatchesTheReposSpecs —
        --                                    and omitted alongside
        --                                    {tdd_instruction} on the
        --                                    spec-first path)
        --   {learning_tools_instruction}   (shared verbatim — one line
        --                                    pointing at the /learnings skill.
        --                                    Names no MCP tool: the three it
        --                                    used to name each say their own
        --                                    WHEN, see
        --                                    ThePromptNamesNoToolMerelyToSayItExists)
        --   {plan_not_a_stopping_point_instruction}
        --                                  (only on the plan path — both
        --                                   design steps state it themselves,
        --                                   see NoLineRestatesTheDesignStep)
        --   {wrap_up_instruction}          (shared verbatim, universal)
        --
        -- The prompt deliberately carries no verify command. Even when
        -- task.repo_path has a SavedRepoPath row with verify_command = Some(c),
        -- no "## Verification" section is emitted and c appears nowhere in the
        -- prompt. Carrying it there as well as in the surfaces below would be
        -- duplicated context, so the prompt-side copy was removed.
        --
        -- The command reaches the agent through two surfaces instead. First,
        -- get_task's response (see GetTaskViaMcp in mcp-task-tools.allium),
        -- which the /wrap-up skill already calls in its Step 2 — the skill acts
        -- on it in its own verification step, run before the closing sequence
        -- ever calls wrap_up, so an agent following the rebase path now learns
        -- the command and can act on it before the base branch is touched at
        -- all. Second, and still, the wrap_up response's "Verify before
        -- exiting" line (see WrapUpRebase, WrapUpPr and WrapUpDone in
        -- pr-workflow.allium) — kept as a secondary reminder rather than
        -- removed, because on the rebase path wrap_up's own git rebase step
        -- runs between the skill's pre-check and that response, and can pull in
        -- sibling-epic changes the pre-check could not have seen. That residual
        -- race is not closed by this design; the response line is what an
        -- agent has left to catch it.
        --
        -- DispatchTask emits one of two variants of build_prompt:
        --   * has_plan = false: preamble "Your task is:" and the addendum
        --     is the design step for a repo that keeps Allium specs (see
        --     DesignStepMatchesTheReposSpecs for the other branch) —
        --     spec_first_instruction, an ordered
        --     sequence: interview the user with the allium:elicit skill,
        --     capture the agreed behaviour in docs/specs/*.allium, generate
        --     tests from the spec with allium:propagate, implement the
        --     minimum code to pass them, then confirm alignment with
        --     allium:weed. The Allium spec, not a prose design doc, is the
        --     design artefact this variant asks for.
        --     Two clauses in it are explicitly the agent's judgement call,
        --     not requirements: writing a docs/plans/ doc and attaching it
        --     via update_task (worth it only when the implementation is
        --     large enough for the steps to be worth recording), and
        --     handing the propagate/implement/weed steps to the
        --     /allium-loop skill instead of running them inline (worth it
        --     for large or stubborn convergences). Neither is enforced, and
        --     the prompt says so — a plan-shaped artefact is no longer the
        --     expected output of the design step at all.
        --     There is no vague-vs-clear branch: the same sequence is
        --     named however well-specified the description is, because the
        --     elicit step is what establishes whether it was.
        --     The sequence names each skill and stops, as the brainstorming
        --     fallback does (see DesignStepMatchesTheReposSpecs): it does not
        --     restate how the skills work. Step 1 carried "One question at a
        --     time" until allium:elicit was found to head a section with that
        --     exact rule, making the clause a paraphrase of the skill the step
        --     loads — the case that guarantee already rules out, applied to the
        --     branch it was not written for.
        --     The addendum is explicit that the spec is not the end of the
        --     task: implementation (TDD) must follow in the same session,
        --     not a separate dispatch — except for an epic-decomposition
        --     task, for which creating work packages for its subtasks is
        --     named as the alternative (the same carve-out wrap_up_instruction
        --     applies to calling the skill; there is no tag or field that
        --     identifies such a task, so both name the exception in prose
        --     rather than branching on task state — which is also why the
        --     phrase survives on both lines where the stopping-point rule
        --     around it does not). This wording is
        --     otherwise NOT tag-conditional — Bug, Feature, Chore, Fix, and
        --     no-tag all reach this same addendum and all imply working
        --     code. Research is excluded without a branch here:
        --     DispatchResearchTask already diverts a no-plan
        --     research-tagged task to build_research_prompt before
        --     build_prompt's addendum is ever selected (see "only when the
        --     task has no plan" above), and Dependabot/PrReview are
        --     overridden with their own review addenda regardless of plan
        --     state (see the exceptions below).
        --     This closes a gap where a bug/feature/chore-tagged agent read
        --     "write and attach a plan" plus the (then-universal) wrap-up
        --     wording as license to stop at a plan-only state instead of
        --     implementing it.
        --   * has_plan = true and task.auto_run_plan = false (default):
        --     preamble "Your task is:" and the addendum references the
        --     plan path with a "review and ask permission before
        --     implementing" instruction.
        --   * has_plan = true and task.auto_run_plan = true: preamble
        --     "Your task is:" and the addendum references the plan path
        --     with an instruction to implement it immediately, no summary
        --     or confirmation step. Set by decompose-review on its
        --     generated work packages, since those plans already went
        --     through a human confirmation step before being written.
        -- CreateQuickTask (build_quick_dispatch_prompt) is the exception:
        -- its preamble is "You are working interactively with the user."
        -- rather than "Your task is:" — quick dispatch begins as an
        -- interactive conversation where the agent establishes the goal
        -- and renames the task, then follows the same
        -- spec_first_instruction sequence as the no-plan variant above.
        -- The instruction text is shared verbatim between the two, so the
        -- design step cannot drift apart between them.
        -- task_block does NOT include a Tag: line — tag is metadata for
        -- the kanban board, not for prompt context (it would invite the
        -- agent to over-fit on labels rather than the description).
        -- wrap_up_instruction is shared by every dispatched agent so the
        -- whole task lifecycle terminates the same way regardless of mode.
        -- The two stopping points it names are finishing implementation
        -- and, for an epic-decomposition task only, creating work packages
        -- for its subtasks (that task's job is delegation, not
        -- implementation, so stopping there is legitimate).
        -- The rule that a design artefact is not a standalone stopping point
        -- is now its own line, {plan_not_a_stopping_point_instruction},
        -- emitted only on the plan path and placed immediately above
        -- wrap_up_instruction, whose subject it qualifies. Both design steps
        -- already state it, so on their paths it would be the restatement
        -- NoLineRestatesTheDesignStep rules out; the plan path has no design
        -- step, and is the case the rule was written for. It names only the
        -- plan, not "a spec or a plan", because no spec-writing step runs on
        -- the path that emits it.
        -- DispatchResearchTask is an exception to the unified trailing
        -- block: its prompt includes only {learning_tools_instruction} and
        -- omits tdd, allium, and wrap_up. The research agent
        -- presents findings interactively and does not terminate via
        -- the standard wrap-up flow.
        -- Dependabot exception: when task.tag = dependabot, build_prompt
        -- replaces the spec_first addendum with a dependabot review
        -- runbook. The bump is classified from the task's title and
        -- description first, and the runbook is rendered around that
        -- verdict — see AReviewRunbookCarriesOnlyTheBranchThatApplies
        -- above. Its shared steps are: identify the PR and record its url,
        -- verify the PR touches only dependency files (the allowlist it
        -- checks against is governed by
        -- TheDepOnlyAllowlistAdmitsOnlyDeclarativeDependencyFiles above), and
        -- check CI. Its
        -- shared terminals are auto-approve + merge (`gh pr review
        -- --approve` then `gh pr merge --squash --auto`) and ask the user
        -- (one direct question, plus sub_status = needs_input). Between
        -- them sits the one decision body the bump kind selected. The
        -- trailing block is reduced to just {learning_tools_instruction} —
        -- no tdd, no allium, and no wrap_up_instruction, because the
        -- dependabot task is auto-cleaned when its PR merges (or the user
        -- takes over).
        --
        -- PrReview exception: when task.tag = pr_review, build_prompt
        -- replaces the spec_first addendum with a minimal PR review
        -- runbook: find the PR, run the review command on it, present the
        -- findings and wait. One command, no diff-size branch. The trailing
        -- block is reduced the same way, because the PR review agent
        -- presents findings and waits for the user's instructions.
        --
        -- Neither runbook prohibits /wrap-up. Both used to open with the
        -- prohibition, and their terminal branches used to repeat it — three
        -- times in one and twice in the other. The repeats went first,
        -- replaced by positive statements of the end state that makes
        -- wrap-up unnecessary ("the task is auto-cleaned on merge", "stop
        -- and wait for the user's reply"), which the runbooks still carry.
        -- The opening prohibition went when the rule became enforceable:
        -- wrap_up refuses a review-tagged task outright, so the prompt no
        -- longer has to ask. See ReviewTasksAreNotWrappedUp in
        -- mcp-task-tools.allium.
        --
        -- The fix tag falls through to this rule and uses the full trailing
        -- block — it is purely a kanban-board label, not a routing key.
}

rule DispatchResearchTask {
    when: DispatchResearchTask(task)

    requires: task.status = backlog
    requires: task.has_plan = false
    requires: task.tag = research

    ensures: task.status = running
    ensures: task.sub_status = core/SubStatus.default_for(running)
    ensures: task.last_pre_tool_use_at = now
    ensures: task.worktree = core/Worktree.created(
        path: task.repo_path + "/.worktrees/" + task.id + "-" + slugify(task.title),
        branch: task.id + "-" + slugify(task.title)
    )
    ensures: task.tmux_window = core/TmuxWindow.created(name: "task-" + task.id)
    ensures: AgentLaunched(task: task, mode: research)

    @guidance
        -- Research mode: the agent investigates the topic in the task
        -- description by reading code, docs, and external resources.
        -- It presents findings to the user and waits for instructions.
        -- The agent makes no code changes and does not wrap up autonomously.
        -- Launches in auto mode with no --permission-mode flag, exactly
        -- like every other task agent (EveryTaskAgentLaunchesInAutoMode).
        -- "Do NOT make code changes" is a prompt instruction, not an
        -- enforced permission boundary — the agent is trusted to honour
        -- it rather than blocked from disobeying it.
        -- Prompt note: build_research_prompt emits a stripped-down
        -- trailing block — only {learning_tools_instruction}, no tdd,
        -- allium, or wrap_up. A research agent has more use for the
        -- knowledge base than any other mode, so that is the one line it
        -- keeps. The research agent
        -- presents findings interactively and does not terminate via
        -- the standard wrap-up flow.
}

rule ResumeTask {
    when: ResumeTask(task)

    requires: task.status in {running, review, done}
    requires: task.worktree != null
    requires: task.tmux_window = null

    -- task.tmux_window = null is a persisted-field precondition, not proof
    -- that no live tmux window exists: the field can go stale (a race, or a
    -- persist that never landed) while the window it used to name survives.
    -- Liveness is therefore re-checked live against tmux on the deterministic
    -- window name.
    let window_alive = has_window(name: "task-" + task.id)

    ensures: task.tmux_window = core/TmuxWindow.created(name: "task-" + task.id)
    ensures: task.status = running
    ensures: task.sub_status = core/SubStatus.default_for(running)
    ensures: task.last_pre_tool_use_at = now
    ensures:
        if not window_alive:
            AgentLaunched(task: task, mode: resume)

    @guidance
        -- Resuming launches an agent, so it writes the same per-task MCP
        -- configuration a provisioning launch does — see
        -- AgentCarriesItsOwnCallerIdentity in DispatchTask. Resume is the one
        -- launch path that never provisions; without this its agent would be
        -- the only one left unidentifiable. The write is owed only where an
        -- agent is actually launched: the live-window branch below launches
        -- nothing and needs nothing.
        --
        -- Resuming reattaches the agent in the existing worktree. When no live
        -- window is found (the common case), it spawns a fresh tmux window and
        -- moves the task back to running, reusing the same ensures as a
        -- Running/Review resume regardless of which status the task came from.
        --
        -- When a live window IS found under the deterministic name, resume
        -- does not spawn a second one: AgentLaunched does not fire, so no new
        -- window is created, no keys are sent, and no new companion pane is
        -- spawned. task.tmux_window is still (re)pointed at the window so the
        -- task stops looking detached; reattachment itself then happens the
        -- normal way, through the existing "has a window" branch of Space (see
        -- split-pane.allium JumpToAgentWindow, priority 3) on the next
        -- keypress. Before this check existed, the stale-field case above
        -- caused AgentLaunched to unconditionally spawn a second window
        -- sharing the live one's name, and the next targeted tmux operation
        -- on that name (select-window, send-keys, kill-window — all resolved
        -- by exact name, see TmuxWindowTargetedExactly) refused as ambiguous.
        --
        -- A tmux query failure maps window_alive to false, not true: the
        -- safe default is the one that reproduces the unconditional-create
        -- behaviour this rule always had before the check existed, rather
        -- than risking a task left with no live agent behind it.
        --
        -- Resuming from done is safe for the same reason as always. Moving a
        -- task to done runs only ConfirmDone's tmux-window teardown
        -- (tmux_window = null); it never removes the worktree (see rule
        -- ConfirmDone in tasks.allium and the Task.status graph edge
        -- done -> running in core.allium). So a done task still satisfies
        -- worktree != null and tmux_window = null and can be resumed straight
        -- back to running like any Running/Review task.
}

-- == Retry ==

rule RetryResume {
    when: RetryResume(task)

    requires: task.status = running
    requires: task.worktree != null

    ensures:
        if task.tmux_window != null:
            OldTmuxWindow.killed(window: task.tmux_window)
    ensures: task.sub_status = active
    ensures: task.last_pre_tool_use_at = now
    ensures: task.tmux_window = core/TmuxWindow.created(name: "task-" + task.id)
    ensures: AgentLaunched(task: task, mode: resume)

    @guidance
        -- If the task still references a tmux window (e.g. a stale session
        -- whose window is alive but idle), that window is killed before a
        -- fresh one is created. This tears down the old process cleanly.
        -- The kill is conditional because a crashed task has no window
        -- reference left: DetectCrashedAgent (agent-health.allium) clears
        -- tmux_window when it observes the window is gone.
}

rule RetryFresh {
    when: RetryFresh(task)

    requires: task.status = running

    -- Destroys existing worktree, resets to backlog, then re-dispatches
    ensures:
        if task.worktree != null:
            not exists task.worktree
    ensures: task.worktree = null
    ensures: task.tmux_window = null
    ensures: task.status = backlog
    ensures: task.sub_status = core/SubStatus.default_for(backlog)
    -- Leaving running voids any deferred Stop. Reachable here more than
    -- anywhere else: a crashed agent's task is still running, and retry-fresh
    -- is what a human does about it. See core/Task's
    -- PendingStopOnlyWhileRunning invariant.
    ensures: task.stop_pending = false
    ensures: AgentLaunched(task: task, mode: standard)

    @guidance
        -- RetryFresh dispatches directly via the standard dispatch
        -- path. The unified prompt skeleton handles both has_plan = true
        -- (review-and-implement) and has_plan = false (spec-first)
        -- variants without any branch in this rule.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface TextInputField {
    facing user: User

    -- The shared single-line text buffer used by every InputMode that
    -- types free text into the app's shared input field: task title,
    -- epic title, base branch, todo title, todo quick-add, repo-path
    -- query, quick-dispatch query, and filter-preset name. Task/epic
    -- DESCRIPTION is NOT this surface (it opens an external $EDITOR).
    -- SearchTasks uses a separate buffer and is intentionally not on this
    -- surface yet.

    -- buffer is the text; caret is a CHARACTER index into buffer (the
    -- text insertion point). Both start empty/zero.
    let buffer = ""
    let caret = 0

    exposes:
        buffer
        caret

    provides:
        -- Insert char AT THE CARET (not appended); caret advances by one.
        -- ensures: buffer = insert_char(buffer, caret, char); caret = caret + 1
        TypeChar(user, char)

        -- Delete the char immediately before the caret; caret moves back
        -- one. No-op at caret 0 (guarded).
        -- ensures: buffer = delete_before(buffer, caret); caret = caret - 1
        Backspace(user)
            when caret > 0

        -- Delete key: delete the char AT the caret; caret unchanged.
        -- No-op at end of buffer (guarded).
        -- ensures: buffer = delete_at(buffer, caret)
        DeleteForward(user)
            when caret < len(buffer)

        -- Move the caret one char left, clamped to 0.
        -- ensures: caret = max(0, caret - 1)
        CursorLeft(user)

        -- Move the caret one char right, clamped to len(buffer).
        -- ensures: caret = min(len(buffer), caret + 1)
        CursorRight(user)

        -- Move the caret one word left. A word char is alphanumeric or
        -- underscore; every other char (whitespace, punctuation, path
        -- separators like / - .) is a boundary, so this steps through
        -- path segments.
        -- ensures: caret = word_boundary_left(buffer, caret)
        CursorWordLeft(user)

        -- Move the caret one word right (same word/boundary rule).
        -- ensures: caret = word_boundary_right(buffer, caret)
        CursorWordRight(user)

        -- Jump the caret to the start of the buffer.
        -- ensures: caret = 0
        CursorHome(user)

        -- Jump the caret to the end of the buffer.
        -- ensures: caret = len(buffer)
        CursorEnd(user)

    @guarantee CaretInBounds
        -- caret is always within 0..=len(buffer) after any operation.
        -- Every caret motion clamps to this range and every buffer edit
        -- keeps the caret inside the (possibly resized) buffer.

    @guarantee PrefillLandsAtEnd
        -- When a field is opened prefilled with an existing value
        -- (editing a todo title, copy-task repo path, default base
        -- branch), the caret starts at len(buffer) — the end — not at 0.

    @guarantee CaretMoveRepaints
        -- A caret motion that changes caret is an observable state change
        -- and must force a redraw even though buffer is unchanged.
        -- Otherwise the rendered caret would not visibly move.

    @guarantee WordMotionWhitespaceAndPunctuation
        -- Word motion breaks on whitespace AND punctuation/path
        -- separators (word char = alphanumeric or `_`). A word jump in a
        -- path with no spaces moves segment-by-segment; in a space-less
        -- token it moves to the boundary. Deliberate — matches
        -- readline/editor default behaviour.

    @guidance
        -- Key bindings: Left/Right move the caret one char; Ctrl+Left/Right
        -- move one word (with Alt+Left/Right and the readline Alt+B / Alt+F
        -- as tmux-safe fallbacks, since some terminals drop the Ctrl
        -- modifier); Home/End jump to the buffer ends; Delete forward-deletes.
        -- Typing and Backspace act AT THE CARET, not at the end of the buffer.
        -- The field is rendered with a reversed block cell at the caret and
        -- horizontal scrolling that keeps the caret visible when the buffer
        -- is wider than the field.
        -- The caret is a Unicode scalar (char) index, so a move or delete can
        -- split a grapheme cluster (combining marks, ZWJ emoji sequences) but
        -- never a UTF-8 codepoint. Grapheme-aware motion is out of scope here.
        -- The insert/delete/word-boundary mechanics (insert_char,
        -- delete_before, delete_at, word_boundary_left/right) are shared UI
        -- helpers documented in docs/conventions.md, not domain logic.
}

surface RepoPathPicker {
    facing user: User

    let saved = core/SavedRepoPaths
    let query = ""
    let cursor = 0

    -- Fuzzy subsequence match: every character of lowercased query
    -- appears in the lowercased path as a forward subsequence.
    -- Empty query matches all saved paths.
    let filtered = saved where fuzzy_subsequence(lowercase(query), lowercase(path))

    -- When query is non-empty and is not an exact match for any item
    -- in filtered, an additional NewPath(query) entry is appended.
    -- This lets the user dispatch to a brand-new repo path even when
    -- the query fuzzy-matches existing paths.
    let new_entry = query != "" and not (exists p in filtered where p.path = query)
    let effective = if new_entry: filtered + {NewPath(query)} else: filtered

    exposes:
        query
        effective
        cursor

    provides:
        -- Typing inserts the char into query at the query's text caret
        -- (character/caret mechanics follow the TextInputField surface)
        -- and resets the LIST cursor to 0. The list cursor is distinct
        -- from the text caret; any query edit resets it.
        -- ensures: query inserts char at its text caret (see TextInputField); cursor = 0
        TypeChar(user, char)

        -- Backspace deletes the char BEFORE the query's text caret
        -- (mechanics follow TextInputField) and resets the list cursor to 0.
        -- ensures: query deletes char before its text caret (see TextInputField); cursor = 0
        Backspace(user)
            when query != ""

        -- Up/Down arrows move the cursor within effective (wrapping).
        -- effective = filtered + optional NewPath(query) entry at end.
        -- No printable character is a navigation alias — letters such as
        -- j/k are typed into query, not interpreted as nav commands.
        -- ensures: cursor = (cursor + 1) mod effective.count
        CursorDown(user)
            when effective.count > 0

        -- ensures: cursor = (cursor - 1 + effective.count) mod effective.count
        CursorUp(user)
            when effective.count > 0

        -- Enter: select item at cursor position in effective.
        -- When cursor points to the NewPath(query) entry, the typed
        -- query is dispatched as a new (unsaved) repo path.
        -- When effective is empty (query is empty and no repos are
        -- saved), Confirm is a no-op.
        -- ensures: if effective.count > 0: SelectedPath(nth(effective, cursor).path)
        Confirm(user)
            when effective.count > 0

        -- Escape dismisses the picker without selecting
        Dismiss(user)

    @guarantee CursorResetOnEntry
        -- cursor is always 0 when the picker is first displayed.
        -- This ensures the most-recently-used path is pre-selected.

    @guarantee NoPrintableShortcut
        -- No printable character (letter, digit, punctuation) is a
        -- navigation or selection shortcut. Every printable character
        -- is appended to query via TypeChar; navigation goes through
        -- the arrow keys; selection goes through Enter. This contract
        -- is shared by every InputMode that renders this picker —
        -- in particular it forbids the historical j/k nav alias and
        -- the historical 1-9 instant-select shortcut, both of which
        -- broke fuzzy filtering on paths containing those characters.

    @guidance
        -- This surface appears during task creation (InputRepoPath),
        -- quick dispatch (QuickDispatch), and base-branch selection
        -- (InputBaseBranch, whose candidates are a per-repo branch
        -- history rather than the global repo-path set). It replaces a
        -- plain text input with a fuzzy-filtered list of
        -- previously-used repo paths. The filtered list is ordered by
        -- recency (most recent first). When the user has not typed
        -- anything, all saved paths are shown, letting them pick with
        -- a single keystroke.
        --
        -- The `cursor` exposed by this surface is the LIST cursor (an index
        -- into `effective`, moved by Up/Down and reset to 0 on any query
        -- change). It is distinct from the query's single-line TEXT CARET,
        -- which is moved by Left/Right (and Ctrl/Alt+Left/Right for words,
        -- Home/End) and edits the query in place. The query's text editing
        -- follows the TextInputField surface: the query gains forward-delete
        -- (Delete) and caret motions from it, and TypeChar/Backspace act at
        -- the text caret rather than at the end. Text-caret motion does not
        -- change the query, so it does NOT reset the list cursor; only query
        -- edits (TypeChar/Backspace/Delete) do. Caret editing is shared UI
        -- mechanics documented in docs/conventions.md, not domain logic.
}

surface BaseBranchPicker {
    facing user: User

    -- The base-branch field of the manual "new task" form (InputBaseBranch
    -- step). It mirrors RepoPathPicker, but its candidate list is the
    -- most-recently-used base branches for the repo the user already chose
    -- earlier in the same flow, rather than the global set of repo paths.
    --
    -- selected_repo is the repo_path confirmed at the preceding InputRepoPath
    -- step; the picker scopes its history to that repo. history is the
    -- per-repo most-recently-used list, ordered most-recent-first. The whole
    -- board's history is preloaded once at startup (a single
    -- list-all-base-branches read, mirroring the repo-path preload) and kept
    -- in memory keyed by repo_path; this surface reads the slice for
    -- selected_repo.
    let selected_repo = ""
    let history = core/SavedRepoBranches where repo_path = selected_repo

    -- query starts prefilled with the most-recently-used branch for
    -- selected_repo (history.first.branch), falling back to the form's prior
    -- default base branch ("main" / config.default_branch) when the repo has
    -- no history yet. See the PrefillFromHistory guarantee.
    let query = ""
    let cursor = 0

    -- Fuzzy subsequence match: every character of lowercased query appears in
    -- the lowercased branch as a forward subsequence. Empty query matches all
    -- of the repo's remembered branches.
    let filtered = history where fuzzy_subsequence(lowercase(query), lowercase(branch))

    -- When query is non-empty and is not an exact match for any remembered
    -- branch in filtered, an additional NewBranch(query) entry is appended, so
    -- the user can free-type a brand-new branch even when the query
    -- fuzzy-matches existing history entries.
    let new_entry = query != "" and not (exists b in filtered where b.branch = query)
    let effective = if new_entry: filtered + {NewBranch(query)} else: filtered

    exposes:
        query
        effective
        cursor

    provides:
        -- Typing inserts the char into query at the query's text caret
        -- (character/caret mechanics follow the TextInputField surface) and
        -- resets the LIST cursor to 0. The list cursor is distinct from the
        -- text caret; any query edit resets it.
        -- ensures: query inserts char at its text caret (see TextInputField); cursor = 0
        TypeChar(user, char)

        -- Backspace deletes the char BEFORE the query's text caret (mechanics
        -- follow TextInputField) and resets the list cursor to 0.
        -- ensures: query deletes char before its text caret (see TextInputField); cursor = 0
        Backspace(user)
            when query != ""

        -- Up/Down arrows move the cursor within effective (wrapping).
        -- effective = filtered + optional NewBranch(query) entry at end.
        -- No printable character is a navigation alias.
        -- ensures: cursor = (cursor + 1) mod effective.count
        CursorDown(user)
            when effective.count > 0

        -- ensures: cursor = (cursor - 1 + effective.count) mod effective.count
        CursorUp(user)
            when effective.count > 0

        -- Enter: select item at cursor position in effective. When cursor
        -- points to the NewBranch(query) entry, the typed query is used as the
        -- task's base branch. When effective is empty, Confirm is a no-op.
        -- ensures: if effective.count > 0: SelectedBranch(nth(effective, cursor).branch)
        Confirm(user)
            when effective.count > 0

        -- Escape dismisses the picker without selecting
        Dismiss(user)

    @guarantee PrefillFromHistory
        -- When the field is opened, query is prefilled with the
        -- most-recently-used branch for selected_repo (history.first.branch)
        -- and the text caret lands at the end (per TextInputField's
        -- PrefillLandsAtEnd). When selected_repo has no history, query falls
        -- back to the form's prior default base branch — the current draft
        -- value, or "main" (config.default_branch) when the draft is empty.
        -- Because the prefill is a non-empty query, effective initially shows
        -- only the synthetic NewBranch(query) entry unless the prefill exactly
        -- matches a remembered branch (which it does when drawn from history).

    @guarantee CursorResetOnEntry
        -- cursor is always 0 when the picker is first displayed, so the
        -- prefilled / most-recently-used branch is pre-selected.

    @guarantee EmptyHistoryShowsOnlyNewEntry
        -- When selected_repo has no remembered branches, history and filtered
        -- are empty; effective contains only the NewBranch(query) entry for
        -- whatever is typed (same empty-state as RepoPathPicker with no saved
        -- paths). Confirm submits the typed value as the base branch.

    @guarantee NoPrintableShortcut
        -- No printable character (letter, digit, punctuation) is a navigation
        -- or selection shortcut. Every printable character is appended to
        -- query via TypeChar; navigation goes through the arrow keys;
        -- selection goes through Enter. Shared verbatim with RepoPathPicker.

    @guidance
        -- This surface is the base-branch counterpart of RepoPathPicker, shown
        -- during the manual task-creation form's InputBaseBranch step (and the
        -- copy-task flow, which reuses the same step). It replaces the former
        -- plain text field that defaulted to "main". Interaction is identical
        -- to RepoPathPicker: typing fuzzy-filters the repo's remembered
        -- branches live, arrow keys move through the list, Enter selects (or
        -- free-types a new branch when nothing matches).
        --
        -- The `cursor` exposed here is the LIST cursor (an index into
        -- `effective`, moved by Up/Down and reset to 0 on any query change),
        -- distinct from the query's single-line TEXT CARET (moved by
        -- Left/Right, Ctrl/Alt+Left/Right, Home/End) which edits the query in
        -- place via the TextInputField surface. Text-caret motion does not
        -- reset the list cursor; only query edits do.
        --
        -- Confirming this step emits BaseBranchUsed(selected_repo, <branch>)
        -- as part of finish_task_creation, recording the chosen branch into
        -- the repo's history (see RecordBaseBranch). Quick dispatch and MCP
        -- create_task never render this surface and never record history.
}

surface DispatchingFeedback {
    facing user: User

    -- This surface tracks tasks that are mid-dispatch — between the
    -- user pressing Enter / Shift+D and the dispatch worker reporting
    -- success or failure. Set membership and per-task start time are
    -- implementation-internal (`app.dispatching` HashSet plus a
    -- sibling start-time map); the surface contract is the visible
    -- behaviour of the status bar and card line-2 indicator.

    @guarantee StickyUntilEmpty
        -- status_text persists across Tick events while `dispatching` is
        -- non-empty. The 5-second STATUS_MESSAGE_TTL that applies to ad-hoc
        -- status messages is bypassed for dispatching feedback.

    @guarantee ClearedWhenEmpty
        -- status_text becomes null the moment `dispatching` drains,
        -- regardless of how the last entry was removed (dispatch succeeded,
        -- dispatch failed, dispatch abandoned before it held the claim, or
        -- watchdog timeout).

    @guarantee DispatchingTimeout
        -- A task that remains in `dispatching` for longer than the watchdog
        -- deadline is removed by the next Tick and a "dispatch timed out"
        -- failure is raised as an error popup — naming the task when one
        -- expired, and reporting the count when several expire on the same
        -- tick. Defence-in-depth against a stuck dispatch worker (e.g. an
        -- agent panic that escapes catch_unwind).
        --
        -- The deadline is SUBPROCESS_TIMEOUT * PROVISION_MAX_SUBPROCESS_CALLS
        -- (840s / 14 minutes at current values), not a 1:1 mirror of
        -- SUBPROCESS_TIMEOUT (#4201's fix) — see PROVISION_MAX_SUBPROCESS_CALLS
        -- in src/dispatch/worktree.rs for the exact call accounting. A watchdog
        -- sized for a single subprocess call could trip while fetch_origin's
        -- retry budget under FetchPolicy::Required was still legitimately
        -- working, the same class of spurious "timed out" popup this guarantee
        -- exists to avoid. Widening the deadline is a deliberate trade against
        -- detection latency: it does not change worker behaviour (see this
        -- guarantee's own "this surface is a UI backstop" below), only how
        -- long a genuinely stuck worker sits silently before the user sees
        -- anything.
        --
        -- This guarantee does not cover every subprocess call reachable from a
        -- dispatch: some calls upstream of and inside provision_worktree are
        -- not bounded by run_with_timeout at all in production, so they are
        -- outside what PROVISION_MAX_SUBPROCESS_CALLS accounts for (tracked
        -- separately from #4201). That does not defeat this watchdog — its
        -- check is wall-clock elapsed time since the task entered
        -- `dispatching`, independent of which subprocess is stuck — but a hang
        -- in one of those calls is a resource leak (a parked spawn_blocking
        -- thread) this guarantee does not reclaim.
        --
        -- The timeout does NOT release the claim, and that is deliberate.
        -- Exceeding the deadline means "slow", not "dead" — a fetch over a slow
        -- network outlives it with the worker still alive — so releasing would
        -- return the task to backlog while it is still being provisioned and let
        -- a second dispatch land on the same branch, breaking
        -- DispatchClaimExclusive. This surface is a UI backstop and stays one: it
        -- clears the spinner and reports the timeout, nothing more.
        --
        -- A worker that really did die therefore leaves the task running with no
        -- worktree. That state used to be quiet — not detached (detachment
        -- requires a worktree), and skipped by both activity classification and
        -- the window checks, so it rendered as an ordinary running task and never
        -- self-flagged. It no longer is: the row is is_unprovisioned, and
        -- UnprovisionedIndicator renders it distinctly with recovery reachable in
        -- place, instead of leaving a manual backward move to backlog as the only
        -- way out. That indicator is why stranding remains the right trade here:
        -- releasing is wrong routinely, on any fetch slower than the deadline,
        -- whereas stranding needs a worker to vanish without reporting at all —
        -- and is now visible when it happens.
        --
        -- The deadline does double duty. UnprovisionedIndicator reuses it as the
        -- line past which an unprovisioned claim stops being "still
        -- provisioning" and starts being "abandoned", so the two surfaces agree
        -- on when a dispatch has failed.

    @guarantee DeletedTaskPruned
        -- If a task referenced in `dispatching` is deleted from the task
        -- list (e.g. via `x` in the archive view, after first archiving it
        -- with `x` from the board), the next Tick removes the stale ID so
        -- the status text never references a vanished task.

    @guarantee SinglePathMutation
        -- Mutation of `dispatching` flows through a single helper so the
        -- sticky status text is always kept in sync with set membership.
        -- Routing through `app.update(MarkDispatching)` from another
        -- update handler is forbidden (recursive update hazard).

    @guarantee SpansTheClaim
        -- Membership begins BEFORE the dispatch claim is taken and ends only
        -- when the worker reports, so a task shows "dispatching…" across the
        -- claim as well as across provisioning. A member is therefore normally
        -- backlog (not yet claimed) or running with worktree = null (claimed,
        -- being provisioned), and the indicator takes priority over every
        -- status-derived one precisely so the claim's early running write does not
        -- make an in-flight dispatch render as a live agent.
        -- The "no worktree" half holds up to message-queue latency rather than
        -- absolutely: a member drains as soon as its outcome message is
        -- processed, but between a worker landing a worktree and that message
        -- being handled, a board refresh can briefly pair a worktree-bearing row
        -- with a live membership. The window is a queue hop and affects only
        -- which indicator one frame shows, so it is not defended against beyond a
        -- debug assertion.

    @guarantee LostClaimReported
        -- A dispatch whose claim is lost — another entry point took the task
        -- first — drains its entry with a failure message, so the user is told
        -- the task was already dispatched rather than left watching a spinner
        -- that never resolves. Draining is ALL it does: a lost claim must not
        -- release, because the winner is itself running with worktree = null for
        -- as long as its provisioning takes, which is exactly the state a
        -- release fires on. A loser that released would hand the winner's task
        -- back to backlog mid-provision. Losing and failing are therefore
        -- distinct outcomes despite looking identical to the user; only the
        -- caller that HELD the claim releases it.

    @guidance
        -- Dispatch is asynchronous: the worker runs `git fetch origin
        -- <base_branch>`, creates the worktree and tmux window, then
        -- starts the agent. On a slow network this takes several seconds.
        -- The DispatchingFeedback surface gives the user continuous
        -- evidence that the work is in flight rather than a non-responsive
        -- UI. It is rendered in two places: the status bar (full
        -- status_text) and each affected task card's secondary line
        -- (spinner glyph + "dispatching…"). Once `dispatching` is empty
        -- the status bar reverts to its idle state and cards return to
        -- their normal indicator.
}

surface UnprovisionedIndicator {
    facing user: User

    -- The card line-2 indicator for a task that looks live but has nothing
    -- behind it: running or review, with neither a worktree nor a tmux
    -- window (Task.is_unprovisioned in core.allium). Evaluated per rendered
    -- card, not only for the selected one.

    context task: core/Task

    let unprovisioned = task.is_unprovisioned

    -- Whether the task is unprovisioned because a dispatch is still running
    -- rather than because one died. Two sources, OR'd: the in-flight set
    -- behind DispatchingFeedback, plus the row's own claim stamp — every
    -- claim seeds last_pre_tool_use_at, and a stamp younger than the
    -- DispatchingTimeout deadline means provisioning may still be underway.
    -- A row with no stamp counts as not-in-flight, so it surfaces at once.
    let dispatch_in_flight = dispatch_in_flight(task)

    exposes:
        unprovisioned
        dispatch_in_flight

    @guarantee ShownForWindowlessRunning
        -- An unprovisioned task renders a distinct warning indicator — its
        -- own label in the same alarming style as the conflict and crashed
        -- indicators — never the ordinary "running" one it is otherwise
        -- indistinguishable from, and never the "detached" one (which means
        -- the opposite thing: a worktree is present and resumable).
        --
        -- It also outranks the conflict indicator. A conflict means a rebase
        -- ran, which means a worktree existed, so the combination should not
        -- arise; if it does, "there is nothing here" is the more actionable
        -- of the two readings. Every indicator this one outranks describes a
        -- state that presupposes a provisioned worktree.

    @guarantee DispatchingOutranksIt
        -- While dispatch_in_flight, the card shows the dispatching feedback
        -- (see DispatchingFeedback), not this indicator. The claim writes
        -- running before the worktree exists, so every in-flight dispatch
        -- passes through the unprovisioned state; rendering those as broken
        -- would flag every normal dispatch. This indicator is what remains
        -- once dispatch feedback ends — whether it ended in success (the
        -- task now has a worktree and is no longer unprovisioned), failure,
        -- or the DispatchingTimeout watchdog.
        --
        -- This governs the KEY and the HINT as much as the label. An
        -- in-flight task offers neither the retry hint nor the retry dialog;
        -- the go-to-session key reports that a dispatch is in progress.
        -- Retrying mid-flight would return the task to backlog and start a
        -- SECOND dispatch alongside the one still running — the same
        -- duplicate-agent hazard DispatchingTimeout declines to risk.
        --
        -- The in-flight set alone is not enough to decide this. It holds only
        -- the dispatches the board itself started; the epic chain claims its
        -- next subtask inside the MCP close path (AutoDispatchNextSubtask in
        -- epics.allium) and never enters the set, and restarting the board
        -- mid-dispatch empties it. Both leave a genuinely-provisioning task
        -- looking abandoned. Hence the claim-stamp fallback in
        -- dispatch_in_flight: a claim younger than the DispatchingTimeout
        -- deadline is treated as alive, whichever process made it. Once it
        -- ages past that deadline — the same line that separates "slow" from
        -- "dead" for the watchdog — the indicator takes over.

    @guarantee NotShownWhenProvisioned
        -- A task holding a worktree is never rendered as unprovisioned,
        -- whether or not it still has a window. A worktree with no window is
        -- is_detached, and keeps its existing detached rendering.

    @guarantee RetryReachableInPlace
        -- The go-to-session key offers the kill-and-retry dialog for an
        -- unprovisioned RUNNING task whatever its sub_status, rather than
        -- reporting that there is no worktree to resume and leaving a manual
        -- backward move as the only recovery. Running only: the retry path
        -- accepts running tasks and refuses every other status, so offering
        -- the dialog elsewhere would open a prompt that does nothing.
        -- The action hints advertise it: where a provisioned running task
        -- offers session/resume on that key, an unprovisioned one offers
        -- retry, so the recovery is discoverable rather than only reachable.
        --
        -- The dialog it opens offers the fresh-start branch only, and names
        -- the state as never-started rather than stale or crashed. The
        -- resume branch needs a worktree to resume into and would report
        -- that there is none — exactly the dead end this guarantee removes.

    @guidance
        -- Nothing else catches this state. It is not detached (that requires
        -- a worktree), and the activity/window tick classifications both skip
        -- tasks with no window, so it never becomes stale or crashed either.
        -- Without its own indicator it renders as a healthy running agent
        -- indefinitely. Reachable by a manual forward move out of backlog, by
        -- a crash between the claim and provisioning, and by a dispatch
        -- worker that dies without reporting (see DispatchingTimeout).
}

surface TokenBudgetIndicator {
    facing user: User
    -- prose: passive readout of the Claude subscription rate-limit windows in
    -- the top indicator row. Sourced from the statusLine hook payload of every
    -- dispatch-spawned session, recorded to a snapshot file, polled by the TUI.
    -- NOT related to usage_events (see mcp-task-tools.allium: QueryUsageViaMcp) —
    -- those are feature-usage counters, these are subscription budget windows.
    let five_hour   = budget_window(FiveHour)
    let seven_day   = budget_window(SevenDay)
    let stale       = snapshot_age() > core/config.budget_stale_after
    let visible     = five_hour.present or seven_day.present

    exposes:
        five_hour
        seven_day
        stale
        visible
    @guarantee WindowsRenderedWithPercentAndReset
        -- each present window renders as "<label> <pct>% ·<countdown>"
    @guarantee ColourByThreshold
        -- per window, independently: green below 50, yellow 50..80, red above 80
    @guarantee HiddenWhenNoSnapshot
        -- no snapshot, unreadable snapshot, or neither window present => nothing
        -- is rendered. Never imply 0% used: API-key and cloud-provider auth
        -- never emit rate_limits at all.
    @guarantee PerWindowOmission
        -- one window present and the other absent renders only the present one
    @guarantee DimmedWhenStale
        -- snapshot older than core/config.budget_stale_after dims the whole
        -- indicator and appends an age suffix
    @guarantee ResetInPastRendersNow
        -- a resets_at at or before now renders "·now", never a negative countdown
    @guarantee PercentageClamped
        -- used_percentage is clamped to 0..100 for both colour and display
    @guarantee DegradesWhenRowTooNarrow
        -- when the row's spans would exceed the width, drop in order: countdown
        -- suffixes, then the seven_day window, then the indicator entirely.
        -- Pre-existing badges in that row are never dropped to make room.
    @guarantee DerivedLiveNeverPersisted
        -- read from the snapshot file off the event loop; never stored in the
        -- database and never part of Board state
    @guarantee RefreshedAtStartupThenPeriodicallyNoRedrawWhenUnchanged
        -- read once when the board opens, so a snapshot already on disk shows
        -- immediately rather than after the first poll interval, then refreshed
        -- every core/config.budget_poll_interval, a fixed multiple of
        -- core/config.tick_interval; an unchanged refresh does not force a
        -- redraw
    @guarantee PassiveNotNavigable
        -- display-only; not selectable, focusable, or a navigation target
    @guidance -- rendered by render_top_indicators, prepended so it sits left of
              -- the bell; the status bar was rejected as a site because its
              -- hint text already overflows the terminal width and is clipped
}

surface StatusLineDecorator {
    facing operator: User
    -- prose: `dispatch statusline --snapshot <path> [--chain <command>]`, the
    -- process that produces the data TokenBudgetIndicator reads. It is wired as
    -- the statusLine command of every dispatch-spawned Claude session, so it
    -- runs several times a second in every session, for the whole life of every
    -- session. That frequency, and the fact that a failure here breaks the
    -- operator's status line rather than anything of ours, is what every
    -- guarantee below is about.
    --
    -- It has exactly two jobs: record the subscription windows from the payload
    -- Claude Code hands it on stdin, and stand in for the status line the
    -- operator had before dispatch took the slot over.

    -- Whether the payload carried subscription windows to publish.
    let payload_reports_windows = status_payload_has_rate_limits()

    -- The command the decorator stands in for, if any. Absent when the operator
    -- had no status line, or when theirs is itself a dispatch statusline
    -- invocation (see NeverChainsToItself).
    let chained_command = discovered_chain()

    exposes:
        payload_reports_windows
        chained_command

    @guarantee AlwaysSucceeds
        -- Every path exits successfully and prints at most an empty status
        -- line: an unparseable payload, a payload without subscription windows,
        -- an unwritable snapshot location, a chained command that is missing,
        -- fails, or outlives its budget. A blank status line is the worst
        -- outcome the operator can be shown; a broken one is not available.

    @guarantee NeverReadsOrWritesTheDatabase
        -- The decorator never touches the task database — not to read it, and
        -- not by bringing it into existence. At this invocation rate, across
        -- every session, database work here would be pure waste.

    @guarantee StartsNoAsyncRuntime
        -- The decorator does no asynchronous work, and starts none of the
        -- machinery for it: no worker-thread pool, no reactor. At several
        -- invocations a second in every session, concurrently, setup it cannot
        -- use is the same waste as database work (see
        -- NeverReadsOrWritesTheDatabase).

    @guarantee PublishedSnapshotIsAlwaysWholeAndFromOneWriter
        -- Every session publishes to the same snapshot location concurrently. A
        -- reader therefore either sees no snapshot or sees one complete set of
        -- windows written by a single session — never a blend of two writers'
        -- values, never a partially written one. The last write wins, which is
        -- correct because the windows are account-global: every session reports
        -- the same figures. Publishing also leaves nothing behind but the
        -- snapshot itself.

    @guarantee SnapshotIndependentOfChain
        -- The snapshot is published whatever the chained command does, and
        -- before waiting on it. The budget readout never depends on a status
        -- line the operator configured for unrelated reasons.

    @guarantee ChainedOutputReproducedVerbatim
        -- With a chained command, the payload reaches it unchanged and its
        -- output is reproduced unchanged, whatever the payload's size. The
        -- operator's status line looks exactly as it did before dispatch
        -- occupied the slot.

    @guarantee ChainedCommandIsBounded
        -- One budget of config.statusline_chain_timeout covers the chained
        -- command's output AND its exit. A command that never produces output
        -- and one that produces output but never exits are both abandoned at
        -- the deadline and leave nothing running behind them. Neither can hold
        -- the decorator — and so Claude Code's status line — open.
        --
        -- An abandoned command contributes nothing: output it had already
        -- produced is discarded along with it, and the operator sees the same
        -- empty status line as for any other failure. A partial status line is
        -- indistinguishable from a complete one, so showing half of what the
        -- operator's own command meant to say would be a worse outcome than
        -- showing none of it.

    @guarantee SnapshotLocationIsFixedNotDerivedFromTheOpenDatabase
        -- The subscription windows are account-global, so the snapshot has
        -- exactly one location per machine. Both sides agree on it
        -- unconditionally: the location the decorator is told to publish to,
        -- and the location TokenBudgetIndicator reads. Neither varies with
        -- which task database the process that computed it happened to be
        -- running against.
        --
        -- The decorator's settings are written by whichever dispatch process
        -- notices they are missing or wrong, and they then govern every Claude
        -- session started afterwards. Deriving the location from the open
        -- database instead let one run against a throwaway database — a
        -- developer's scratch database, or a test that boots the runtime
        -- against a temporary one — silently repoint every later session at a
        -- directory belonging to that run. Sessions kept publishing, the
        -- indicator kept reading its own unchanged location, and the result
        -- was a permanently stale readout with no failure reported anywhere:
        -- indistinguishable, to the operator, from an account that had simply
        -- stopped reporting.

    @guarantee SettingsLocationIsAnExplicitStartupInput
        -- Startup is told where the operator's Claude Code configuration
        -- lives — the directory the decorator's settings file goes in, and
        -- the trust store beside it. It goes looking for neither. The
        -- operator's own session is handed the operator's locations. A run
        -- that is not the operator's session — a test booting the runtime —
        -- is handed locations of its own, and so cannot reach theirs.
        --
        -- One resolved set of locations rather than a parameter per file, so
        -- the next operator-owned path startup learns about is added where
        -- the others already are, and cannot arrive as a fresh lookup.
        --
        -- Resolving the directory inside startup instead made every run that
        -- boots the runtime a writer of the operator's real configuration,
        -- whatever else that run was for. The written content happened to be
        -- machine-correct, so the rewrite showed up nowhere; the next key
        -- baked into that file need not be. Unlike
        -- SnapshotLocationIsFixedNotDerivedFromTheOpenDatabase, no path is
        -- derived from anything here — the lookup itself is the hazard, so
        -- being handed the directory is the whole of the fix.

    @guarantee AnUnavailableHomeDirectoryIsAFailureNotAPath
        -- Every operator-owned location startup is handed is found under the
        -- home directory, and each is resolved from one reading of it. When
        -- that reading yields nothing usable, resolution reports that and
        -- startup stops. It never yields a location anyway.
        --
        -- Two locations sit beside each other there — the configuration
        -- directory, and the trust store next to it — and they are resolved
        -- the same way, because they are the same kind of thing. A resolution
        -- that failed for one and quietly succeeded for the other would leave
        -- which of the two a run consulted deciding whether the operator was
        -- told anything at all.
        --
        -- The hazard is specific to the answer being a path. An absent home
        -- directory composes into a perfectly well-formed location — one at
        -- the root of the filesystem, or one relative to whatever directory
        -- the process happens to be running in — and everything downstream
        -- then treats it as the operator's own. A trust store read there holds
        -- no record of any repository, so every repository reads as untrusted;
        -- the operator sees dispatch declining to launch, with nothing naming
        -- the home directory anywhere. Granting trust would write the file
        -- into existence, at that location, and the next read would find it.
        -- Nothing in that sequence is an error, which is why the resolution
        -- has to be the thing that refuses.
        --
        -- An empty home directory counts as unavailable, not as the root: a
        -- shell spells "unset" both by omitting the variable and by setting it
        -- to nothing, and only one of those spellings failing is the same
        -- split again, one level down.

    @guarantee SpawnSitesAndStartupNameTheSameConfigurationDirectory
        -- Dispatch owns two things inside the operator's Claude Code
        -- configuration directory: the decorator's settings file, and the
        -- directory holding dispatch's own agent-facing plugin. Each has
        -- exactly one location, and both halves of the system agree on it.
        -- The directory the writing side is handed is the same directory
        -- every spawned session is pointed at when it is launched.
        --
        -- The writing side is two flows, not one: startup keeps the settings
        -- file current, and installation puts the plugin in place. Neither
        -- looks the directory up; each is handed it (see
        -- SettingsLocationIsAnExplicitStartupInput). The reading side is the
        -- text that launches a session, which names both locations outright,
        -- identically for every session, because that text is assembled once
        -- and is not free to vary per run.
        --
        -- Those two mechanisms stay separate, but they are not two
        -- definitions. The names of the directory and of what sits inside it
        -- are written down once, and both halves are built from that one
        -- statement — the launch text by embedding it, the writing side by
        -- appending it to a resolved location. Renaming any of them is
        -- therefore a single edit that necessarily moves both halves at once:
        -- neither half holds a copy the edit could miss. Both are still
        -- pinned, separately, to expectations written out by hand, so a
        -- rename fails visibly on each side rather than quietly carrying
        -- through. Agent-facing copy that merely quotes a location for a human
        -- to read stands outside this — it is prose, not a half of the
        -- agreement, and nothing is launched from it.
        --
        -- What is left over, and it is one thing. The launch text names the
        -- directory relative to the home directory, and a shell resolves it
        -- there. The agreement therefore also needs the configuration
        -- directory to be found under the home directory — which is not a
        -- name, so it is not covered by the shared statement above, and is
        -- asserted instead. That assertion has a limit worth stating plainly:
        -- a lookup which consulted some further input alongside the home
        -- directory would keep matching everywhere that input was absent,
        -- which is everywhere the assertion runs, and part only for the
        -- operators who set it. So making the directory operator-configurable
        -- is a change that must move both halves in the same commit and give
        -- up naming the location outright. Nothing can catch that one after
        -- the fact, and no structure prevents it either: the lookup is one
        -- small function, and a second input is a short edit inside it. What
        -- stands there instead is a written warning at that exact spot. That
        -- is weaker than everything else in this guarantee, and is said
        -- plainly so nobody mistakes it for more.
        --
        -- Leaving the agreement to hold by coincidence meant a change on
        -- either side split the two in silence: a settings file written where
        -- no session ever loaded it, a plugin installed where no session ever
        -- found it, and every session launched against a location nothing had
        -- written. A session refuses to start at all without that settings
        -- file, so every dispatch failed at the moment of spawning, and
        -- nothing anywhere named the cause. The failure is total and says
        -- nothing about its own origin, which is why the agreement is worth
        -- making structural rather than assuming.

    @guarantee NeverChainsToItself
        -- When the status line the decorator would stand in for is itself a
        -- dispatch statusline invocation, nothing is chained. An empty status
        -- line with the windows still being recorded is the honest outcome;
        -- recursion is not.

    @guidance
        -- Implemented by src/cli/statusline.rs. The command string, including
        -- the discovered chain and the quoted snapshot location, is generated by
        -- src/setup/statusline.rs into a dispatch-owned settings file that every
        -- spawn site passes to `claude` — deliberately never the operator's own
        -- settings file. src/runtime/mod.rs rewrites that file at startup
        -- whenever its content differs from what the current build would
        -- write — absence is only the commonest such difference, and `claude`
        -- refuses to start without it. The locations it writes into arrive as
        -- `StartupPaths`, resolved once in src/main.rs; the same shape
        -- src/setup/mod.rs already uses for setup and uninstall. The path
        -- segments are stated once, in src/claude_paths.rs, as macros rather
        -- than consts because the reading side assembles them with concat!,
        -- which takes literals and macro expansions but not a const item. The
        -- reader is src/dispatch/prompts.rs::DISPATCH_PLUGIN_DIR; the writers
        -- are src/setup/mod.rs::claude_dir,
        -- src/setup/statusline.rs::settings_path and
        -- src/setup/plugins.rs::plugin_dir_under. Both halves are pinned to
        -- hand-written expectations — src/dispatch/tests.rs for the constant,
        -- src/setup/mod.rs's own tests for the layout, which also carry the
        -- home-directory link. Each writer's resolution is pinned too:
        -- `StartupPaths::resolve` in src/runtime/tests/misc.rs,
        -- `SetupPaths::resolve` in src/setup/mod.rs's tests.
        -- src/main.rs::cmd_tui needs no test: `StartupPaths`' fields are
        -- private to src/runtime/mod.rs, so `resolve` is the only way to
        -- obtain one.
        --
        -- AnUnavailableHomeDirectoryIsAFailureNotAPath is
        -- src/setup/mod.rs::home_dir, the one reader of `$HOME` behind both
        -- src/setup/mod.rs::claude_dir and
        -- src/setup/mod.rs::user_global_config_path. Startup reads it once,
        -- in `StartupPaths::resolve`, and composes both locations from that
        -- one reading. The joining half of each is a separate function taking
        -- the home directory as an argument (`claude_dir_in`,
        -- `user_global_config_path_in`), so a test can vary it — comparing two
        -- locations both derived from the real `$HOME` cancels it out of both
        -- sides and asserts nothing. The same shape as
        -- src/editor.rs::resolve_editor, and for the same reason:
        -- `std::env::set_var` is unsafe in edition 2024 and races the test
        -- harness's threads regardless.
        --
        -- The empty-is-unavailable rule reaches past the locations startup is
        -- handed, because the same spelling composes just as quietly
        -- elsewhere: src/tmux.rs::tmux_conf_path resolves through the same
        -- reader, and src/models/paths.rs::expand_tilde and
        -- src/lib.rs::default_db_path apply the rule to their own fallbacks —
        -- neither has a Result to report an absence through, so each stays
        -- put instead. expand_tilde is the one that matters most: it is what
        -- src/dispatch/trust.rs::project_key keys the trust store on, so
        -- without it the store's path and its key would disagree about an
        -- empty home directory.
}

surface SandboxedAgentExecution {
    facing operator: User
    -- prose: The same dispatch-owned settings file that carries the
    -- statusLine decorator (see StatusLineDecorator) used to also enable
    -- Claude Code's sandbox mode — a Bash-tool-only, OS-enforced jail — for
    -- every dispatch-spawned session. As of SandboxDisabledForDockerAndUnixSockets
    -- below, the sandbox is disabled entirely: sandbox_enabled is the only
    -- key dispatch's settings file still writes under "sandbox". This
    -- surface previously carried a growing set of per-ecosystem exceptions
    -- (Gradle, gh, git-SSH, GCP Artifact Registry) to keep the sandbox on
    -- while unblocking one command pattern at a time; see
    -- SandboxDisabledForDockerAndUnixSockets for why that approach was
    -- abandoned in favour of disabling the sandbox outright.

    let sandbox_enabled = false

    exposes:
        sandbox_enabled

    @guarantee SandboxDisabledForDockerAndUnixSockets
        -- Docker-based test suites (Testcontainers etc.) don't shell out to
        -- a `docker` CLI command a sandbox exception could pattern-match —
        -- the test process (mvn, ./gradlew test, go test, pytest, npm test,
        -- ...) talks to the Docker daemon directly over its Unix socket.
        -- That's the same class of gap the sandbox always had for gh's
        -- D-Bus keyring access (AF_UNIX sockets aren't domain traffic, and
        -- historically weren't matched by excludedCommands either), except
        -- here the invoking command isn't a single enumerable string across
        -- ecosystems the way gh's was, so an excludedCommands-style fix
        -- can't generalize. Claude Code's sandbox schema has exactly one
        -- Linux-wide knob for this: network.allowAllUnixSockets, an
        -- all-or-nothing switch for local socket access with no narrower
        -- per-socket scoping. Given the choice between that (still a global
        -- IPC loosening, and one more ecosystem-specific carve-out on top of
        -- an already-growing list) and disabling the sandbox outright, the
        -- sandbox was disabled outright. This also resolves, as a side
        -- effect, an unreproduced `git checkout`/
        -- `.git/worktrees/<name>/index.lock` "Read-only file system"
        -- failure from task #4367 and the `apply-seccomp:
        -- unshare(CLONE_NEWUSER)` flaky-startup failures — both were
        -- sandbox-caused, so removing the sandbox removes the failure
        -- class. Per-command permission prompts (Claude Code's own approval
        -- flow, entirely separate from the OS-level sandbox) are unaffected
        -- and are now the sole review layer for a dispatched agent's shell
        -- commands. The exceptions this surface used to carry —
        -- FilesystemLeftAtDefaults, GitHubPreAllowedNetworkOtherwiseUnrestricted,
        -- CredentialsDeniedNotMasked, FailsOpenOnMissingDependencies,
        -- GradleDaemonExcludedFromSandbox, GhCliExcludedFromSandboxKeyring,
        -- GitSshFetchPushExcludedFromSandbox,
        -- GcpArtifactRegistryPreAllowedForGradle, and
        -- GcloudCredentialsUnrestrictedForArtifactRegistry — described
        -- sandbox-on behaviour that is now entirely moot; their reasoning
        -- stays discoverable via git history and
        -- docs/plans/2026-08-17-4250-sandbox-github-network-allowlist.md,
        -- docs/plans/2026-08-17-4256-gradle-sandbox-clone-newuser.md,
        -- docs/plans/2026-08-18-4287-gh-cli-sandbox-keyring.md,
        -- docs/plans/2026-08-19-4289-git-ssh-sandbox-exclusion.md, and
        -- docs/plans/2026-08-24-4355-artifact-registry-sandbox.md. See
        -- docs/plans/2026-08-25-4373-disable-sandbox-for-dispatch-sessions.md
        -- for this decision.

    @guidance
        -- Baked into the same JSON object write_settings_file
        -- (src/setup/statusline.rs) produces for the statusLine key, so
        -- every dispatch-spawned Claude session gets it automatically —
        -- dispatch_agent, quick_dispatch_agent, research_agent, and resume
        -- all pass --settings through the same DISPATCH_PLUGIN_DIR constant
        -- (src/dispatch/prompts.rs). No change needed at any spawn site.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- RunningTaskHasWorktree: Tasks dispatched via DispatchTask or
-- DispatchResearchTask always have a worktree, ONCE THE DISPATCH HAS COMPLETED.
-- Two states break it in the meantime: a dispatch in flight, whose claim writes
-- running ahead of provisioning (see DispatchTask), and manual forward movement
-- (the move-forward key), which moves a task to running without provisioning at
-- all. The dispatch flow is the canonical path; manual moves are overrides. This
-- is why every consumer that must not see a half-provisioned agent — crash
-- detection, activity classification, is_wrappable — keys off tmux_window rather
-- than status.
--
-- Neither exception is silent on the board: both satisfy Task.is_unprovisioned,
-- and UnprovisionedIndicator distinguishes the one still provisioning from the
-- one whose dispatch died.

-- DispatchClaimExclusive: at most one dispatch ever provisions a given task,
-- however many entry points fire on it at once. Not expressible as a state
-- assertion — it constrains the ordering of two writes rather than any single
-- moment's field values — but it is normative, and it is the reason the
-- backlog -> running transition is a conditional claim taken before
-- provisioning rather than a status read followed by a status write. The losing
-- caller provisions nothing; see DispatchTask for what each entry point reports.

-- TmuxWindowTargetedExactly: every tmux operation aimed at a named window acts
-- on that window or fails. It never acts on a different window. This covers all
-- of them — killing the window, selecting it, renaming it, typing into it (the
-- agent command, a resume `--continue`, a notification), reading its pane,
-- joining it into the split pane, splitting a companion pane inside it, and
-- setting its @dispatch_dir option. It holds for every named window — the
-- board's own and the editor windows as much as a task's.
--
-- Not a cosmetic imprecision: window names are "task-" + task.id (see
-- DispatchTask, DispatchResearchTask, ResumeTask, RetryResume), so one task's
-- name is a prefix of another's whenever one id is a prefix of another id —
-- task 378 and task 3782 both exist in a repo with ids in the thousands. A
-- mistargeted keystroke goes into another task's live Claude session as user
-- input; a mistargeted kill destroys another task's agent.
--
-- The failure mode this rules out is specifically the one where the intended
-- window is absent — killed, crashed, or already cleaned up — and a
-- longer-named sibling is alive. An operation on a window that no longer
-- exists must report that it does not exist. Silently doing the thing to
-- whichever window happens to share the name's prefix is the defect.
--
-- Ambiguity is also a failure, not a coin flip: when two windows carry the
-- same name, the operation is refused rather than applied to an arbitrary one.
--
-- Mechanism (implementation note, not the obligation): tmux resolves a
-- `-t <window-name>` target by exact match first and then by *prefix*, so
-- passing a name through is unsafe by default. tmux's `=name` exact-match
-- sigil is not a general answer — it is rejected by the pane-target commands
-- (`send-keys`) and by `set-option -w`, and `display-message` accepts it while
-- returning nothing and exiting zero. A pane ID is accepted by every command
-- dispatch issues and cannot be prefix-matched, so window names are resolved
-- to the pane ID of the window's active pane by exact-name lookup, and every
-- target is a pane ID. The lookup itself asks tmux to compare names for
-- equality, and re-checks the name it gets back, so a name carrying format
-- metacharacters can only produce a miss, never a match on another window.
-- Verified against tmux 3.5a.
--
-- The guarantee rests on a second mechanism as well, upstream of that one: a
-- window name is a constructed type (core.allium: TmuxWindow), so the two
-- strings that are NOT names — the empty string and a pane id — can never
-- become one. Both bypass the exact-name lookup and reach tmux unresolved, and
-- the empty string is tmux's "current window", so while the name was a bare
-- string either could arrive at these same helpers and silently retarget a
-- kill, a send-keys or a set-option at whatever window the user happens to be
-- focused on. They are deliberate non-names, outside this guarantee's scope
-- rather than violations of it — which is why the resolution helper
-- (`tmux::window_target`) still takes a plain string at that boundary: it
-- accepts those two as well.
--
-- Two exceptions to "every target is a pane ID", both standing. First, by
-- necessity: the prefix+Space keybinding that jumps back to the board (see
-- JumpBackToTuiWindow in split-pane.allium) is a command string tmux executes
-- later, so no pane identity resolved at registration time would still be
-- valid. That one target uses tmux's `=` sigil, which does work for
-- `select-window`. Second: renaming a window documents the empty string as
-- meaning the current window, so that target passes through unresolved by
-- design.

-- BranchHistoryCapped: no repo retains more than
-- config.max_base_branches_per_repo remembered base branches. This is a
-- property of the write operation (RecordBaseBranch prunes on every write),
-- not something any caller enforces.
invariant BranchHistoryCapped {
    for b in core/SavedRepoBranches:
        (core/SavedRepoBranches where repo_path = b.repo_path).count
            <= config.max_base_branches_per_repo
}
