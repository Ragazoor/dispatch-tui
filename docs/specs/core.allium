-- allium: 3
-- core.allium
--
-- Scope: Shared domain model for the dispatch system
-- Includes: External entities, enumerations, core entities, config, VisualColumn and FlattenedView concepts
-- Excludes: Rules, invariants (see tasks.allium, dispatch.allium, agent-health.allium,
--           pr-workflow.allium, split-pane.allium, mcp-task-tools.allium, epics.allium,
--           learnings.allium)

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The git worktree and tmux window are provisioned externally.
-- The spec treats them as opaque handles.

external entity Worktree {
    path: String
    branch: String
}

-- A window NAME, and only a name: two strings are excluded because tmux does
-- not treat them as one. The empty string is tmux's "current window", and a
-- pane id ("%42") addresses a pane directly; both reach tmux as
-- already-resolved targets, bypassing name lookup entirely (see
-- dispatch.allium: TmuxWindowTargetedExactly). Every other non-empty string
-- is a name, including the board's own window and legacy names.
external entity TmuxWindow {
    name: String
}

external entity TmuxPane {
    id: String       -- tmux pane identifier (e.g., "%42")
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum TaskTag { bug | feature | chore | pr_review | research | fix | dependabot }

-- UrlType classifies the single URL attached to a Task (see TaskUrl).
-- The type is stored explicitly rather than guessed from the URL string at
-- render time. Only pr-typed urls are polled for PR merge/close (see
-- pr-workflow.allium: PollPrStatus).
enum UrlType { pr | security_alert | issue | other }

-- How one attempt to read a PR's state from GitHub ended. The two failure
-- values differ in exactly one respect that matters to the caller: whether
-- repeating the same call could ever produce a different answer. Retrying a
-- permanent failure is pure waste, and doing it on a timer is how a single
-- unreadable PR generates tens of thousands of identical log lines.
-- See pr-workflow.allium: PollPrStatus.
enum PrCheckOutcome {
    succeeded            -- GitHub answered; the PR's state and review decision are known
    failed_permanently   -- cannot succeed until something outside dispatch changes:
                         -- the repository does not resolve, credentials are bad,
                         -- authentication is required, there is no PR at that url,
                         -- or GitHub reported a state dispatch does not recognise
    failed_transiently   -- may succeed on a later attempt: connection failure,
                         -- TLS/read/dial timeout, 5xx, rate limit, stream reset
}

-- FeedRole is the routing role of an epic within a PR-review feed hierarchy.
-- `none` is the default for ordinary epics; the other roles tag a sub-epic as a
-- destination bucket for PR items routed by feed signals (see feeds.allium: Signal).
enum FeedRole { none | reviews_parent | my_reviews | team_reviews | bots | cve }

-- EpicOrigin records how an epic came into existence.
-- `manual` is the default for epics created by the user or via MCP.
-- `repo_group` is set by the system when a per-repo sub-epic is created
-- automatically by repo grouping (see epics.allium: RegroupEpic /
-- service::grouping). This field is system-assigned and is never exposed
-- to MCP callers.
enum EpicOrigin { manual | repo_group }

-- Legacy alias: "ready" maps to backlog
enum TaskStatus { backlog | running | review | done | archived }

-- SubStatus refines the parent status into a more precise state.
-- Valid combinations are constrained by SubStatus.is_valid_for(status).
-- When status changes, sub_status resets to SubStatus.default_for(new_status).
enum SubStatus {
    -- backlog / done / archived
    none

    -- running (and review where noted)
    active          -- agent is running normally
    needs_input     -- agent is blocked waiting for human interaction (Blocked visual column)
    stale           -- no PreToolUse hook event seen for longer than inactivity_timeout (time since last_pre_tool_use_at)
    stale_shell     -- a live backgrounded shell (Bash tool with run_in_background = true) has been
                    -- running longer than shell_stale_threshold (time since the oldest live
                    -- ShellEntry's started_at); see ClassifyAgentActivity in agent-health.allium
    crashed         -- tmux window disappeared unexpectedly
    conflict        -- rebase/merge encountered a conflict (valid for both running and review)

    -- review
    awaiting_review   -- PR created, no review decision yet
    changes_requested -- reviewer requested changes. Covers both directions:
                      -- changes requested on the user's own PR, and changes the
                      -- user requested on someone else's. The UI separates the
                      -- two — see "Derived review sections" below.
    approved          -- PR approved. Covers both directions: the user's own PR
                      -- approved and ready to merge, and a PR the user approved
                      -- on someone else's behalf. The UI separates the two —
                      -- see "Derived review sections" below.
    pr_closed         -- GitHub closed the PR without merging; task stays in review so a human can act
    pr_unreachable    -- dispatch could not read the PR at all and has stopped polling
                      -- this task: the repository does not resolve, credentials are
                      -- bad, or there is no PR at that url. Task stays in review so a
                      -- human can act. Unlike conflict, it is NOT guarded against
                      -- overwrite — any later successful poll clears it, which is the
                      -- sole recovery path (see pr-workflow.allium: PollPrStatus).
}

-- == Column Sections ==
--
-- The Running and Review columns are split into sections: their cards are
-- grouped under a header naming the section, in a fixed order, rather
-- than listed flat. Backlog and Done have no sections — every card in them
-- holds sub_status = none, so there would be nothing to group by and nothing
-- to name.
--
-- A section has an identity of its own, ColumnSection, rather than being
-- whatever the first card in the group happens to be called. Two things that
-- identity buys: a section's header label never changes as cards come and go
-- inside it, and the user's choice to collapse a section (see "Collapsed
-- Sections") survives its contents changing entirely.
--
-- ColumnSection is deliberately NOT the same set as SubStatus. Three of its
-- values are computed from the task row at render time rather than read off a
-- column of it, and one of them holds two sub_statuses at once.
--
-- "Not stored" here means no task row records which section its card is in.
-- The section *names* are a persisted vocabulary: the folded-section list
-- writes them (see "Collapsed Sections"), so renaming a value is a
-- data-compatibility change.

-- Declaration order is render order: the value declared first sits at the top
-- of its column. Sections from different columns never interleave, so the
-- relative order of a running section and a review section is unobservable.
enum ColumnSection {
    conflict                 -- "conflict"; running and review alike

    pr_closed                -- "pr closed"; review
    pr_unreachable           -- "pr unreachable"; review
    crashed                  -- "crashed"; running
    stale                    -- "stale"; running. Holds BOTH stale and
                             -- stale_shell cards: the two say "this task looks
                             -- idle" for a different structural reason, and the
                             -- user acts on either the same way.
    needs_input              -- "needs input"; running
    changes_requested        -- "changes requested"; review
    approved                 -- "approved"; review
    active                   -- "active"; running
    awaiting_review          -- "awaiting review"; review

    -- The three derived sections, all review-only and all less actionable than
    -- every section above. See "Derived review sections" below.
    parked                   -- "parked"
    changes_requested_by_me  -- "changes requested by me"
    approved_by_me           -- "approved by me"
}

-- == Derived review sections ==
--
-- Three ColumnSection values are NOT reachable from a task's own sub_status.
-- They are computed from the task row at render time, with no column of it
-- recording the result:
--
--   parked                    status = review and worktree != null and
--                             tmux_window = null and not (url != null and
--                             url.url_type = pr)
--
--                             The agent session has ended and there is no PR to
--                             review or merge. sub_status is deliberately not
--                             part of the condition: with no PR there is nothing
--                             for a review decision to be about, so this
--                             dominates any decision recorded without one.
--
--   changes_requested_by_me   sub_status = changes_requested and
--                             tag in {pr_review, dependabot}
--
--                             Those tags mean the task reviews someone else's PR
--                             rather than authoring one, so the changes were
--                             requested BY the user and the ball is with the
--                             other author.
--
--   approved_by_me            sub_status = approved and
--                             tag in {pr_review, dependabot}
--
--                             The same tags, the same direction: the user
--                             approved someone else's PR. Unlike an approval on
--                             the user's own PR there is no merge to perform, so
--                             nothing at all is waiting on the user — this is the
--                             least actionable section in the column.
--
-- All three are derived rather than stored so they self-correct: a parked task
-- leaves the parked section the moment its tmux window reappears, with nothing
-- to write back. Detach state alone does NOT create a section — a detached task
-- that has a PR renders under plain awaiting_review, because once a PR exists
-- only the review decision matters.

-- Valid SubStatus values per parent status (enforced in the DB by a CHECK
-- constraint and in-code via SubStatus.is_valid_for):
--   backlog   : none
--   running   : active | needs_input | stale | stale_shell | crashed | conflict
--   review    : awaiting_review | changes_requested | approved | conflict | pr_closed | pr_unreachable
--   done      : none
--   archived  : none
--
-- Note: HookNotification only fires when task.status = running, setting
-- sub_status = needs_input. The resulting (running, needs_input) state
-- renders as the "Blocked" visual column. Legacy (review, needs_input)
-- rows from older hook behaviour were normalised to (review, awaiting_review)
-- by migration v16.

-- Default sub_status when transitioning to a new status:
--   backlog   -> none
--   running   -> active
--   review    -> awaiting_review
--   done      -> none
--   archived  -> none

-- NotificationKind is the `notification_type` field on Claude Code's Notification
-- hook payload, forwarded by the task-status-hook as the `--kind` argument to
-- `dispatch hook <id> notification`. It is absent on Claude Code versions that
-- predate the field. The agent-view-only values `agent_needs_input` and
-- `agent_completed` are intentionally excluded: dispatch runs a plain `claude`
-- process in tmux, never `claude agents`, so those values never reach the hook.
-- See HookNotification in agent-health.allium for how each value is classified.
enum NotificationKind {
    permission_prompt       -- agent is blocked on a permission decision
    idle_prompt             -- agent has gone idle awaiting human input
    auth_success            -- informational (auth succeeded); not human-actionable
    elicitation_dialog      -- agent is asking a question / showing a form
    elicitation_complete    -- an elicitation just resolved
    elicitation_response    -- an elicitation response was received
}

-- LearningScope identifies what context a learning applies to.
-- Dispatch retrieval unions: user + repo:<this_repo> + epic:<this_epic> (if set).
-- task scope carries task-specific outcomes, retrieved on demand.
enum LearningScope { user | repo | epic | task }

-- LearningKind categorises what was learned. kind does not affect retrieval or
-- rendering: every retrieved entry, procedural included, goes into the single
-- RAG-ranked "Validated knowledge" block (see learnings.allium: Priority
-- Ordering). kind describes how an entry was authored and what it means.
enum LearningKind {
    pitfall              -- a failure mode; agents should avoid or handle carefully
    convention           -- preferred code pattern or style in this context
    preference           -- the user's explicit working preference
    tool_recommendation  -- recommended tool or library for a given problem
    procedural           -- a how-to-work-here procedure; injected like any other kind
    landscape            -- codebase/system overview (service maps, module responsibilities)
}

-- LearningStatus controls whether an entry is active in retrieval.
-- New entries land as approved; there is no human approval gate and no human
-- curation surface. A background job archives stale, unvalued entries (see
-- learnings.allium: ArchiveStaleLearning), which is the only status change any
-- behaviour produces. rejected is legacy: nothing produces it any more, but
-- existing rows still hold it. Entries in rejected or archived are excluded from
-- prompt injection and query_learnings results.
enum LearningStatus { approved | rejected | archived }

-- VerdictKind captures an agent's evaluation of a retrieved learning, submitted
-- via the rate_learning MCP tool at any point during a task. Both verdicts adjust
-- the learning's net score; neither changes its status.
--   helped  — the learning applied and was useful (an upvote: upvote_count + 1)
--   wrong   — the learning misled the agent or is no longer accurate
--             (a downvote: upvote_count - 1, may go negative)
enum VerdictKind { helped | wrong }

-- RetrievalSource records how a learning was surfaced to a task's agent.
--   prompt_injection — included in the single RAG-ranked "Validated knowledge"
--                      block prepended to the dispatch prompt
--   procedural       — legacy; no longer produced. Procedural learnings are now
--                      injected as part of the unified prompt_injection block
--                      (see learnings.allium). Retained for existing DB records.
--   query_learnings  — returned by an explicit query_learnings MCP call
enum RetrievalSource { prompt_injection | procedural | query_learnings }

-- WrapUpMode records the preferred wrap-up path for a task, set at creation
-- time by the user or agent. When set, the /wrap-up skill honours it instead
-- of prompting the user: the mode IS the user's answer, given earlier, so the
-- skill runs the whole wrap-up on it — through wrap_up and exit_session —
-- without asking anything and without returning to an idle prompt part-way.
-- A preset mode that only suppressed the question would be worse than no mode
-- at all: the agent would go idle with the question it was told not to ask
-- unanswered, and nothing would reach base_branch until a human noticed.
--   rebase — rebase the task branch onto base_branch and fast-forward it
--   pr     — agent authors and creates a draft PR (no git ops done by dispatch)
--   done   — close without any git operations; task moves to Done directly
enum WrapUpMode { rebase | pr | done }

------------------------------------------------------------
-- Storage Boundary Validation
------------------------------------------------------------

-- Any entity read from storage whose enum fields contain an unrecognised
-- string value must fail the read operation with an error rather than
-- silently defaulting to a fallback variant.
--
-- Rationale: silent defaults mask data-integrity bugs (corrupt migrations,
-- manual DB edits, schema drift) and produce subtly wrong in-memory state
-- that is hard to trace back to the real cause. A hard read error surfaces
-- the problem immediately. The TUI and MCP error-display paths already
-- handle DB errors gracefully, so a hard error is safe.
--
-- This applies to all enum columns: TaskStatus, SubStatus, TaskTag,
-- WrapUpMode, LearningKind, LearningScope and LearningStatus.
-- It also applies to JSON-encoded columns (e.g. labels, tags): malformed
-- JSON must return an error rather than an empty list.
--
-- Exception: FeedRole and EpicOrigin soft-fail instead. An unrecognised
-- value in either column logs a warning and defaults to FeedRole.none /
-- EpicOrigin.manual rather than failing the read.
--
-- Rationale: these two are additive, system-assigned routing/provenance
-- tags. New roles/origins are appended over time, and a newer binary may
-- write a value an older binary has never heard of. Hard-failing would
-- make an older binary reject rows it could otherwise display perfectly
-- well, so it degrades gracefully to the default tag instead. The default
-- is the safe, neutral choice in both cases: `none` (ordinary epic, no feed
-- routing) and `manual` (no special provenance). Because the value is
-- system-assigned and never user-supplied, an unknown value signals a
-- forward-compatibility gap, not the data-integrity bug the hard-fail rule
-- guards against.
--
-- Exception: tmux_window soft-fails too, for a different reason — corruption
-- tolerance, not forward compatibility. A stored value that is not a window
-- name (see TmuxWindow) logs a warning and reads back as no window at all,
-- which is exactly what a task whose agent is gone looks like, so the board
-- still renders it; failing the row would drop the card from every bulk read.
--
-- Not covered at all: the stored list of folded sub-status sections (see
-- "Collapsed Sections"). It is a settings row rather than an enum column on an
-- entity, and an unrecognised entry in it is skipped rather than failing the
-- read — a fold naming a section this binary does not know about is a display
-- preference that cannot be honoured, not a corrupt task. Read that section
-- before adding ColumnSection to the hard-fail list above.

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- TaskUrl is the single typed URL attached to a Task. The url_type is stored
-- explicitly (not inferred from the string at render time), so the system
-- knows whether the URL is a PR, security alert, issue, or something else.
value TaskUrl {
    url: String
    url_type: UrlType
}

entity Task {
    title: String
    description: String
    repo_path: String
    status: TaskStatus
    sub_status: SubStatus
    worktree: Worktree?
    tmux_window: TmuxWindow?
    plan_path: String?    -- filesystem path to the implementation plan file
    epic: Epic?
    url: TaskUrl?    -- subsumes the former pr_url: the single typed URL attached to this task
    tag: TaskTag?
    sort_order: Integer?  -- shared namespace for feed-driven and user-set ordering; lower sorts first via COALESCE(sort_order, id) ASC
    labels: List<String> = []  -- free-form badges rendered on the card's second line; set by feed scripts via FeedItem.labels or by future TUI editors.
                               -- Ordered, and the order is load-bearing: badges render in
                               -- declaration order so a feed script controls which label
                               -- appears first on the card. Duplicates are retained.
                               -- Presentation, including the three CI-status texts that
                               -- take a state colour, is "Card label badges" below.
    base_branch: String = "main" -- the branch this task rebases onto / targets for PRs
    external_id: String?  -- stable identifier for tasks sourced from a feed epic (see feeds.allium); null for hand-created tasks. Unique per (epic, external_id) when set.
    last_pre_tool_use_at: Timestamp?  -- wallclock of the most recent PreToolUse hook; null when the agent has never tooled (or after Stop)
    last_notification_at: Timestamp?  -- wallclock of the most recent Notification hook; null when no notification is pending (or after Stop)
    live_subagents: Integer = 0  -- count of subagents currently executing for this task; a denormalised count of SubagentEntry rows, rewritten alongside every mutation and clear point (see agent-health.allium)
    live_shells: Integer = 0  -- count of currently-live backgrounded shells (Bash tool with run_in_background = true) for this task; a denormalised count of ShellEntry rows, rewritten alongside every mutation and clear point (see agent-health.allium). Unlike live_subagents, cleared at only three structural points, not four -- see ShellEntry below for why SessionStart is deliberately excluded
    oldest_live_shell_started_at: Timestamp?  -- started_at of the oldest live ShellEntry row for this task; null when live_shells = 0. Used by ClassifyAgentActivity's shell_stale_threshold check so a genuinely abandoned shell surfaces distinctly from a healthy long-running one
    stop_pending: Boolean = false  -- a Stop hook arrived while subagents were live; flip to review once they drain (see agent-health.allium: HookStop / HookSubagentStop). Cleared by any status write that leaves running — see PendingStopOnlyWhileRunning below
    stop_pending_at: Timestamp?  -- when the Stop that stop_pending defers actually fired (the hook's event time, not its write time). Meaningful only while stop_pending holds; the clear points leave it alone because every reader gates on the bit. HookUserPromptSubmit compares against it to tell a Stop deferred by an earlier turn from one deferred by the turn now starting — see its guidance. Null while the bit is set means the Stop predates the field, and reads as "fired before any prompt"
    pr_learnings_gate_shown_at: Timestamp?  -- set once when the PrLearningsGate fires; null means the gate has never fired for this task
    wrap_up_mode: WrapUpMode?  -- preferred wrap-up path; null means decide at wrap-up time
    auto_run_plan: Boolean = false  -- when true and plan_path is set, build_prompt's
                                    -- has-plan addendum skips asking the dispatched
                                    -- agent to confirm before implementing (see
                                    -- dispatch.allium's build_prompt guidance)
    phoenix: Boolean = false  -- a recurring task: entering done creates a fresh backlog
                              -- copy of it, and the flag MOVES to that copy (see
                              -- tasks.allium: PhoenixRespawn). Independent of `tag` on
                              -- purpose — a phoenix task still carries whatever kanban
                              -- label it wants, and `tag` keeps its two behavioural
                              -- readers untouched (see "Tag system" in
                              -- docs/conventions.md). Not a schedule: nothing dispatches
                              -- a phoenix task, the human does.
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        backlog -> running
        running -> review
        running -> backlog
        -- The archive key ('x') completes a task from wherever it sits, so
        -- Done is reachable directly from backlog and running, not only
        -- from review (see tasks.allium: ConfirmDone / ArchiveKeyRouting)
        backlog -> done
        running -> done
        review -> done
        review -> running
        done -> review
        done -> running
        done -> archived
        -- Archive is accepted from any non-archived status
        backlog -> archived
        running -> archived
        review -> archived
        terminal: archived
    }
    -- This graph governs the move-based status changes only (MoveTask,
    -- ConfirmDone, Archive, dispatch/PR-driven transitions). Two
    -- operator paths are intentionally exempt from it:
    --   - EditTask, the tmux task editor (see tasks.allium: EditTask) —
    --     reachable from the archive view as well as the main board. May
    --     set any TaskStatus from any other, including moving a task
    --     back out of the terminal `archived` state.
    --   - MCP `update_task` (see mcp-task-tools.allium:
    --     UpdateTaskViaMcp), the agent path. Partially restricted: it
    --     refuses `done` and `archived` as TARGET statuses, but applies
    --     no edge check at all beyond that, and does not constrain the
    --     SOURCE status. So an agent can drive `review -> backlog`,
    --     `backlog -> review` and `done -> backlog` — none declared
    --     above — and can also leave the terminal `archived` state for
    --     backlog/running/review, since only the target is checked.
    -- Both are deliberate escape hatches — manual correction for the
    -- first, re-opening or re-queueing work for the second — not
    -- edges of the lifecycle, so they are not declared above. Every
    -- other status change, whether automatic or a keyboard move, does
    -- obey the graph.

    -- Derived
    has_plan: plan_path != null
    is_stale: sub_status = stale
    is_crashed: sub_status = crashed
    is_detached: worktree != null and tmux_window = null
                 and status in {running, review}
    -- sub_status is deliberately not part of this condition, the same way it
    -- is not part of Parked's (see "Derived review sections" above): a caller
    -- that needs to treat conflict specially checks sub_status first (e.g.
    -- the card indicator, which tests conflict before is_detached).
    -- A task that looks live but was never provisioned (or lost its
    -- provisioning), so there is nothing to resume. Mutually exclusive with
    -- is_detached, which requires a worktree.
    -- Surfaced on the card by UnprovisionedIndicator in dispatch.allium.
    is_unprovisioned: worktree = null and tmux_window = null
                      and status in {running, review}
    -- pr_number is parsed from the trailing numeric segment of url.url, but
    -- only when the url is pr-typed; otherwise null. Not persisted; computed
    -- on demand.
    pr_number: if url != null and url.url_type = pr: pr_number_from_url(url.url) else: null

    -- A phoenix task sitting in done is one whose respawn did not land.
    -- PhoenixRespawn (tasks.allium) clears the flag exactly when the successor
    -- was created, so a surviving flag in done IS the failure state — there is
    -- no separate error column to keep in step with it. Surfaced on the card by
    -- "Phoenix marker" below.
    respawn_failed: phoenix and status = done

    -- live_subagents is a denormalised count of this task's SubagentEntry
    -- rows (see SubagentEntry below); every mutation and clear point
    -- rewrites both in the same write, so they cannot disagree (see
    -- agent-health.allium: HookSubagentStart / HookSubagentStop and the
    -- four clear points documented there).
    invariant LiveSubagentCountMatchesEntries {
        live_subagents = (SubagentEntries where task = this).count
    }

    -- live_shells mirrors live_subagents's invariant exactly, over ShellEntry
    -- instead of SubagentEntry. See ShellEntry below for how its clear points
    -- differ from SubagentEntry's.
    invariant LiveShellCountMatchesEntries {
        live_shells = (ShellEntries where task = this).count
    }

    -- A deferred Stop belongs to the turn the task was running when it
    -- arrived. Only HookStop sets the bit, and it requires status =
    -- running; every status write that leaves running clears it in the
    -- same write (MoveTaskForward / MoveTaskBackward / ConfirmDone /
    -- ArchiveTask in tasks.allium, UpdateTaskViaMcp in
    -- mcp-task-tools.allium, ExitSession in pr-workflow.allium, and the
    -- drain points in agent-health.allium). So the bit cannot outlive the
    -- status it was recorded under, and cannot be waiting for a task that
    -- a later move puts back into running — where the next drain would
    -- otherwise flip it straight back out of a status a human just chose.
    invariant PendingStopOnlyWhileRunning {
        stop_pending implies status = running
    }
}

-- A live subagent, as reported by the SubagentStart/SubagentStop Claude
-- Code hooks. The table is the authority for Task.live_subagents, which
-- is a denormalised count rewritten from it by every mutation and clear
-- point (see agent-health.allium). started_at is retained for diagnostics
-- only; no rule branches on it.
entity SubagentEntry {
    task: Task
    agent_id: String
    session_id: String
    started_at: Timestamp
}

-- A live backgrounded shell (Bash tool with run_in_background = true), as
-- reported by PostToolUse events for Bash/KillBash|TaskStop/BashOutput|
-- TaskOutput. The table is
-- the authority for Task.live_shells/oldest_live_shell_started_at, which are
-- denormalised and rewritten from it by every mutation and clear point (see
-- agent-health.allium: HookShellStart / HookShellStop).
--
-- Deliberately mirrors SubagentEntry's shape but NOT its full clear-point
-- set. A subagent cannot survive a session boundary (resume/clear/startup
-- all mean the prior subagent is provably dead), so SubagentEntry is cleared
-- unconditionally on every SessionStart in addition to session-fencing. A
-- backgrounded shell is an independent OS process that CAN survive a
-- `/clear` or `resume` -- clearing on every SessionStart would silently drop
-- tracking of a shell that outlived the boundary, reproducing the very bug
-- this entity exists to fix. So ShellEntry relies on session-fencing alone
-- (evicting rows whose session_id differs from an incoming shell event) plus
-- the three real structural clear points also shared with SubagentEntry:
-- DetectCrashedAgent, DetachTmux, and DispatchTask's claim paths. A task
-- whose shell never produces another hook event in a new session, and is
-- never crashed/detached/redispatched, keeps its ShellEntry rows -- see the
-- "Known limitation" accepted tradeoff in
-- docs/superpowers/specs/2026-08-15-shell-visibility-design.md.
entity ShellEntry {
    task: Task
    shell_id: String
    session_id: String
    started_at: Timestamp
}

entity Epic {
    title: String
    description: String
    status: TaskStatus
    plan_path: String?    -- filesystem path to the implementation plan file
    sort_order: Integer?
    auto_dispatch: Boolean = false
    parent: Epic?         -- null for root epics; set for nested sub-epics
    feed_command: String?           -- shell command that emits FeedItem JSON (see feeds.allium); null for non-feed epics
    feed_interval_secs: Integer?    -- per-epic poll cadence in seconds; null falls back to config.default_feed_interval
    group_by_repo: Boolean = false      -- when true, feed tasks are grouped into sub-epics by repo name (see feeds.allium)
    feed_append_only: Boolean = false   -- when true, the feed only ever adds: no stale removal, ever (see feeds.allium: AppendOnlyFeed)
    feed_role: FeedRole = none      -- routing role within a feed hierarchy; `none` for ordinary epics (see feeds.allium: Signal)
    origin: EpicOrigin = manual    -- system-assigned; never settable via MCP
    created_at: Timestamp
    updated_at: Timestamp

    has_plan: plan_path != null
    is_root: parent = null
    is_feed: feed_command != null

    -- DB-level invariant: at most one epic per (parent, feed_role) when
    -- feed_role != none. Ordinary epics (feed_role = none) are exempt — any
    -- number may share a parent. Enforced in the DB by a partial unique index
    -- on (parent_id, feed_role) WHERE feed_role != 'none', indexed as
    -- COALESCE(parent_id, -1) rather than raw parent_id (migration v93).
    --
    -- v65 built the index on raw parent_id and it never actually protected
    -- root-level epics (reviews_parent, cve): SQLite treats every NULL in a
    -- unique index as distinct from every other NULL, so two root epics with
    -- the same feed_role and parent_id = null did not collide. v93 rebuilds
    -- the index over COALESCE(parent_id, -1) so root epics collide too; -1 is
    -- never a real epic id. A database that already held duplicate root-level
    -- managed epics before v93 ran keeps them and runs without this index
    -- (see ProvisionManagedEpics' race-safety note in epics.allium) — v93
    -- warns rather than deleting or merging data it did not create.
    invariant UniqueFeedRolePerParent {
        for a in Epics:
            for b in Epics:
                a != b and a.feed_role != none and a.parent = b.parent
                    implies (a.feed_role != b.feed_role or b.feed_role = none)
    }

    -- DB-level invariant: at most one sub-epic per (parent, title) when
    -- origin = repo_group. Enforced by a partial unique index on
    -- (parent_id, title) WHERE origin = 'repo-group'. Ordinary epics
    -- (origin = manual) are exempt — any number may share a title.
    invariant UniqueRepoGroupPerParent {
        for a in Epics:
            for b in Epics:
                a != b and a.origin = repo_group and a.parent = b.parent and a.title = b.title
                    implies b.origin != repo_group
    }

    subtasks: Task with epic = this
    active_subtasks: subtasks where status != archived
    subtask_statuses: active_subtasks -> status

    sub_epics: Epic with parent = this
    active_sub_epics: sub_epics where status != archived

    -- Heterogeneous set used for status recalculation and dispatch ordering.
    -- Combines active tasks and active sub-epics; each element contributes
    -- its .status value to the parent's recalculated status.
    active_children: active_subtasks + active_sub_epics
}

entity SavedRepoPath {
    path: String             -- filesystem path, unique across all saved paths
    last_used: Timestamp     -- updated on each use; drives recency ordering
    verify_command: String?  -- single-line shell command run by agents before declaring work complete, e.g. "cargo test"

    invariant VerifyCommandSingleLine {
        verify_command = null or not (verify_command.contains("\n") or verify_command.contains("\r"))  -- short-circuits: rhs only evaluated when verify_command != null
    }
}

-- SavedRepoBranch records a base_branch that was used for a given repo_path,
-- forming a per-repo most-recently-used history that feeds the base-branch
-- fuzzy picker during manual task creation (see dispatch.allium:
-- RecordBaseBranch, BaseBranchPicker). This is a dedicated settings-style
-- table (repo_base_branches), a sibling of SavedRepoPath's repo_paths table —
-- and, like the per-repo verify_command setting, a per-repo setting keyed by
-- repo_path.
--
-- It is deliberately NOT derived from Task.base_branch, so that:
--   (a) only branches entered through the manual new-task form are
--       remembered — quick-dispatch and MCP-created branches are excluded
--       (see the recording-scope decision in dispatch.allium: RecordBaseBranch);
--   (b) a remembered branch does not vanish when the task that used it is
--       later deleted.
--
-- Identity is the (repo_path, branch) pair: at most one row per branch per
-- repo. Recency ordering (most-recent-first) and the per-repo cap are
-- governed by the write operation (see dispatch.allium: RecordBaseBranch and
-- the BranchHistoryCapped invariant).
entity SavedRepoBranch {
    repo_path: String        -- the repo this branch history belongs to
    branch: String           -- a base_branch value used for repo_path
    last_used: Timestamp     -- updated on each use; drives recency ordering

    invariant UniqueBranchPerRepo {
        for a in SavedRepoBranches:
            for b in SavedRepoBranches:
                a != b implies (a.repo_path != b.repo_path or a.branch != b.branch)
    }
}

-- Learning captures knowledge a dispatched agent discovered. Entries land as
-- approved immediately (no human approval gate) and are injected into future
-- dispatch prompts for the matching scope. The active pool is curated entirely
-- without a human in the loop, and there is no human-facing surface for it at
-- all: agents up/downvote via rate_learning, delete entries outright via
-- delete_learning, and a background job archives stale entries with a
-- non-positive score (see learnings.allium: ArchiveStaleLearning).
entity Learning {
    kind: LearningKind
    summary: String          -- one-sentence digest; injected into dispatch prompts
    detail: String?          -- extended context; returned by query_learnings
    scope: LearningScope
    scope_ref: String?       -- qualifies the scope:
                             --   scope=repo    → repo_path of the target repository
                             --   scope=epic    → string form of epic_id
                             --   scope=task    → string form of task_id
                             --   scope=user    → null (no qualifier needed)
    tags: Set<String>        -- free-form labels for filtering (e.g. "rust", "testing")
    status: LearningStatus
    source_task: Task?       -- the task whose agent proposed this entry; null for human-authored entries
    upvote_count: Integer -- net score: +1 per `helped` verdict, -1 per `wrong`
                          -- verdict. May be negative. Feeds retrieval ranking and
                          -- the stale-cleanup eligibility check (upvote_count <= 0).
    last_upvoted_at: Timestamp?
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        approved -> archived     -- system-driven, and the only transition any
                                 -- behaviour produces: the stale-cleanup job
                                 -- archives an approved entry with
                                 -- upvote_count <= 0 untouched for the configured
                                 -- threshold (ArchiveStaleLearning)
        terminal: rejected, archived
    }
    -- rejected is terminal but has no inbound edge: it was only ever produced by
    -- the human reject action on the (now removed) TUI knowledge-base overlay.
    -- The value is retained because existing rows still hold it and must stay
    -- parseable; like archived, those rows are excluded from retrieval.

    -- Derived
    is_active: status = approved

    -- True when this learning is relevant to the given task's dispatch.
    -- task-scoped learnings are excluded from auto-injection; they surface
    -- via query_learnings on demand (see learnings.allium).
    applies_to_dispatch(task):
        status = approved
        and (
            scope = user
            or (scope = repo and scope_ref = task.repo_path)
            or (scope = epic and task.epic != null and scope_ref = str(task.epic.id))
        )

    invariant ScopeRefConsistency {
        (scope = user implies scope_ref = null)
        and (scope != user implies scope_ref != null)
    }
}

-- Retrieval records a single occasion on which a Learning was surfaced for a
-- task. One row is inserted per surfacing event, so repeated exposure
-- accumulates as separate rows. Used to drive rate_learning verdict validation
-- (a verdict's learning_id must have a matching retrieval row for the same
-- task) and to support telemetry on which entries actually fire.
entity Retrieval {
    task: Task
    learning: Learning
    source: RetrievalSource
    retrieved_at: Timestamp
}

-- See docs/specs/todo.allium for the Todo entity specification.

-- A rate_learning call evaluates a retrieved learning. The verdict is no
-- longer persisted (migration v74 dropped the learning_verdicts table); the
-- VerdictKind enum still describes the in-flight effects applied on receipt:
--   helped → increments learning.upvote_count and updates last_upvoted_at
--   wrong  → decrements learning.upvote_count (a downvote; may go negative);
--            no status change
-- See learnings.allium for the rule that applies these effects.

-- BoardSelection is a runtime-only UI concept (not persisted): the set of
-- tasks and epics the user has multi-selected. It is modelled here, on the
-- same terms as SplitPane below, because the batch rules in tasks.allium
-- and epics.allium all consume it.
--
-- There is exactly one BoardSelection. It is board-wide, not per-column:
-- selecting items in one column and then another leaves both sets
-- selected, and the selection outlives moving the cursor between columns.
--
-- The action that fills it, and the two independent things called
-- "select all", are specified in tasks.allium ("Multi-Selection").

entity BoardSelection {
    selected_tasks: Set<Task>
    selected_epics: Set<Epic>

    is_empty: selected_tasks.count = 0 and selected_epics.count = 0

    @guidance
        -- Session-scoped and never persisted: it does not survive an app
        -- restart, and nothing in the database records it.
        -- A card in either set renders with a leading `*` and a bold title
        -- (core.allium: "Selection").
}

-- SplitPane is a runtime-only UI concept (not persisted) that tracks
-- whether the TUI is displaying a task's tmux window as a side pane.
-- It is modelled here because task lifecycle events (finish, PR creation)
-- must coordinate with split pane state.

entity SplitPane {
    active: Boolean = false
    focused: Boolean = true
    pane: TmuxPane?
    pinned_task: Task?

    @guidance
        -- At most one task can be pinned at a time.
        -- When active is true, pane must be non-null.
        -- pinned_task may be null (empty shell in the pane).
        -- focused tracks whether the TUI pane has tmux focus.
        -- Driven by crossterm FocusGained/FocusLost events
        -- (requires tmux `focus-events on`). Defaults to true.
        -- Reset to true on split entry and exit.
}

-- Per-task PR-poll bookkeeping: how many times in a row reading this task's PR
-- failed permanently, when the next attempt is allowed, and whether polling has
-- given up altogether.
--
-- Runtime-only and never persisted, like BoardSelection and SplitPane above. It
-- is modelled rather than left as an implementation detail because giving up is
-- a state change the user sees, so it must be expressible.
entity PrPollState {
    task: Task
    consecutive_permanent_failures: Integer = 0
    -- Counted separately from the permanent failures above, which is the whole
    -- mechanism keeping a GitHub outage from stranding the board: this one
    -- widens the backoff, and only the other one can reach the give-up
    -- threshold.
    consecutive_transient_failures: Integer = 0
    next_poll_at: Timestamp?

    -- Derived, not stored: a field that merely mirrors the counter it is
    -- computed from can only drift from it or duplicate it. Also means
    -- "reset the counter to 0" and "clear gave_up" cannot fall out of step —
    -- there is only one write to make.
    gave_up: consecutive_permanent_failures >= core/config.pr_poll_permanent_failure_threshold

    @guidance
        -- Conceptually one exists per polled task; the fields' defaults are the
        -- state of a task that has never failed, so a task with no row yet reads
        -- as zero failures, no backoff and not given up.
        --
        -- gave_up is the in-memory gate that stops polling. Task.sub_status =
        -- pr_unreachable is its persisted, user-visible shadow: the two change
        -- together, but only sub_status survives a restart.
        --
        -- Because this state is session-scoped, an app restart polls a
        -- pr_unreachable task once more. That is deliberate, not an oversight.
        -- The failure it exists for — a repository the gh account cannot read —
        -- is fixed on GitHub, not on the task, so there is nothing the user
        -- could edit to earn a retry. A restart is the retry.
        --
        -- next_poll_at carries the transient backoff. Null means "eligible on
        -- the next tick that clears pr_poll_interval", the unthrottled default.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    tick_interval: Duration = 2.seconds
    gg_chord_timeout: Duration = 150.milliseconds   -- window for completing the vim-style `gg` chord (see VisualColumn row navigation)
    inactivity_timeout: Duration = 10.minutes
    status_message_expiry: Duration = 5.seconds
    -- How long a delivered message's flash stays on the target task's card.
    -- Long enough that a human whose attention is elsewhere still catches it;
    -- a few seconds does not clear that bar. This is the single source of the
    -- duration: both the expiry sweep that clears the tracking state and the
    -- render check that decides whether to draw the flash read it, so they
    -- cannot disagree. See "Message flash" in the Column Identity and Focus
    -- section for the appearance, and mcp-task-tools.allium (SendMessageToTask)
    -- for what triggers it.
    message_flash_ttl: Duration = 30.seconds
    notifications_enabled: Boolean = false
    pr_poll_interval: Duration = 30.seconds
    -- Ceiling on the transient-failure backoff. A PR whose reads keep failing
    -- for a retryable reason is polled at a widening interval up to this cap,
    -- rather than every pr_poll_interval forever.
    pr_poll_backoff_max: Duration = 30.minutes
    -- Consecutive permanent failures before polling gives up on a task and
    -- marks it pr_unreachable. Above one so that a GitHub incident briefly
    -- reporting a real repository as unresolvable does not strand a task.
    pr_poll_permanent_failure_threshold: Integer = 3
    budget_poll_interval: Duration = 10.seconds
    budget_stale_after: Duration = 10.minutes
    -- The floor under every feed cadence, however it is spelled and whoever
    -- writes it. A feed command is a shell command dispatch spawns on a timer;
    -- a cadence below this turns that into a busy loop against the user's own
    -- machine, which is never what anyone asked for. Enforced in the epic
    -- service so every write path inherits it -- see "Interval literals" below
    -- for why it lives there and not in the string grammar.
    min_feed_interval: Duration = 60.seconds
    -- Cadence for a feed epic with no explicit feed_interval_secs (see
    -- feeds.allium). Equal to min_feed_interval today, and MUST NOT fall below
    -- it: an unset field that polled faster than the fastest value a user is
    -- permitted to enter would make the floor a lie.
    default_feed_interval: Duration = 60.seconds
    -- Upper bound on ONE feed command's execution. The per-epic feed-cycle
    -- claim (feeds.allium: SerialisedFeedCycle) spans the whole exec, so
    -- without this bound a command that never exits would hold its epic's
    -- claim for the life of the process. A command still running at this
    -- deadline is killed and reaped instead, and the cycle fails
    -- (feeds.allium: FeedCommandFailure bucket 7).
    feed_command_timeout: Duration = 120.seconds
    mcp_port: Integer = 3142                         -- MCP server port (override via DISPATCH_PORT env var)
    -- Fallback when the repo has no origin/HEAD symbolic-ref.
    -- Runtime code inspects `git symbolic-ref refs/remotes/origin/HEAD`
    -- first and only falls back to this literal when detection fails.
    default_branch: String = "main"

    -- Editor of last resort, when the environment names none. Not a
    -- user-facing setting: the editor is chosen by the environment, and this
    -- constant only gives the fallback a name.
    --
    -- == Which editor (one rule, every surface) ==
    -- Whatever the environment names: VISUAL, else EDITOR, else this fallback.
    -- A value naming no editor at all — absent, empty, or only whitespace — is
    -- treated as unset, because `export EDITOR=` is how a shell spells "none".
    -- The value is split on whitespace into argv and executed directly with no
    -- shell, so a value carrying flags (`EDITOR="vim -p"`) works and nothing
    -- in it is expanded, globbed or word-split by a shell.
    --
    -- This governs EVERY surface that launches the user's editor: the pop-out
    -- task and epic editors (tasks.allium: EditTask, epics.allium: EditEpic).
    -- One user setting must not mean two things in one application.
    --
    -- The agent-tree companion pane used to be a third such surface, opening
    -- the selected file in an editor pane beside itself. It no longer launches
    -- an editor at all: the same keys now open the file's DIFF, which the pane
    -- renders itself from git (agent-tree.allium: OpenAgentTreeFileDiff). So
    -- nothing under agent-tree.allium reads this setting any more.
    editor_fallback: String = "vi"

    -- Staleness thresholds used by card age rendering and Staleness::from_age.
    fresh_threshold: Duration = 3.days
    aging_threshold: Duration = 7.days
    weeks_threshold: Duration = 14.days

    -- When true, the MCP update_task response carries a nudge asking the agent
    -- to call record_learning if it discovered anything non-obvious — but only
    -- when that single update_task call performs "PR finalisation": it sets
    -- status = review AND a pr-typed url, on a task that had no url before the
    -- call. Prompt encouragement only: the nudge is appended to the response
    -- text and never gates the update itself. No other tool reads this flag —
    -- in particular the wrap_up response does not (its rate_learning nudge is
    -- unconditional; see learnings.allium: WrapUpRateLearningNudge).
    -- (see mcp-task-tools.allium: PrFinalisationReflectionNudge)
    learning_reflection_enabled: Boolean = true

    -- Stale-learning cleanup: when enabled, a background job archives approved
    -- learnings whose net score is non-positive (upvote_count <= 0) and that have
    -- not been touched (updated_at) within stale_learning_threshold. Keeps the
    -- active retrieval pool free of unvalidated clutter with no human in the loop.
    -- (see learnings.allium: ArchiveStaleLearning)
    stale_learning_cleanup_enabled: Boolean = true
    stale_learning_threshold: Duration = 90.days
}

------------------------------------------------------------
-- Interval literals
------------------------------------------------------------

-- == How a human types an interval ==
--
-- Every user-facing surface that accepts a poll cadence takes the SAME literal
-- grammar, so "10m" means the same thing wherever it is typed. One grammar,
-- stated once here, because two spellings of ten minutes in one application is
-- a bug waiting to be filed. Only one surface is bound by it today; the
-- grammar is stated centrally so a second one cannot invent its own.
--
-- Grammar (case-insensitive, surrounding whitespace ignored):
--
--   <digits>          -- bare seconds:  "600"  -> 600
--   <digits>s         -- seconds:       "600s" -> 600
--   <digits>m         -- minutes:       "10m"  -> 600
--   <digits>h         -- hours:         "2h"   -> 7200
--   <digits>d         -- days:          "1d"   -> 86400
--
-- Accepted only if the digits parse AND the resulting seconds count is
-- STRICTLY POSITIVE. Everything else is a parse failure: a bare suffix ("m"),
-- a negative ("-5"), zero in any unit ("0", "0m"), a fractional value
-- ("1.5h"), a compound ("1h30m"), or any other text. Zero is rejected rather
-- than treated as "off" because every surface already spells "off" as the
-- empty value, and a zero-second cadence would busy-loop the feed runner.
--
-- A bare integer is seconds, and NOT because seconds are the friendly unit —
-- because that is what the stored column holds (Epic.feed_interval_secs) and
-- what the pre-suffix surface already accepted.
-- Keeping the bare form meaning seconds is what makes suffix support purely
-- additive: no value a user typed before changes meaning.
--
-- Surfaces bound by this grammar:
--   - epics.allium: EditEpic's FEED_INTERVAL_SECS section
--
-- NOT bound by it: the MCP/CLI surfaces, which take a JSON integer of seconds
-- and never a string. The grammar is for humans typing into a field. Those
-- surfaces ARE bound by the floor below -- being exempt from the spelling rule
-- is not being exempt from the domain invariant.
--
-- == Two separate claims: spelling and floor ==
--
-- The grammar above and the floor below are DIFFERENT rules with different
-- scopes, and conflating them is what left a gap here for as long as it did.
--
-- CLAIM 1 -- the grammar is human-surface-only, and it only parses. Its job is
-- to turn a typed string into a seconds count, and its strict positivity is a
-- spelling rule: "0" and "-5" are not cadences a person means to type. It binds
-- exactly the surfaces listed above, and nothing else. It does NOT know about
-- config.min_feed_interval, so "10s" parses successfully and is then refused
-- downstream. That is deliberate: a grammar that also enforced the domain floor
-- would be a second place the floor could drift out of step.
--
-- CLAIM 2 -- the floor is universal. No stored feed cadence may be below
-- config.min_feed_interval, whatever surface wrote it and however it was
-- spelled. This is a domain invariant of the field, not a property of any one
-- entry point, so it is enforced ONCE in the epic service (epics.allium:
-- CreateEpic, UpdateEpic, SetManagedFeedConfig) where every write path
-- inherits it. A value that reaches the poll loop below the floor anyway -- a
-- hand-edited row, a writer that bypassed the service -- is refused at read
-- rather than clamped: feeds.allium's FeedTick skips that epic and warns, on
-- the grounds that a misconfigured feed should not run at all.
--
-- Rows that predate the floor were brought into line once, by migration v91:
-- every stored cadence below min_feed_interval was CLAMPED UP to it, both on
-- epics.feed_interval_secs and on the two managed-feed settings rows
-- (reviews_feed_interval_secs, cve_feed_interval_secs). Clamped rather than
-- nulled so the value stays explicit -- a later change to
-- default_feed_interval must not silently retarget an epic whose cadence
-- somebody once chose. This is a one-time data fix, not a second enforcement
-- point: it does not relieve any write path of validating.
--
-- The floor exists because a feed command is a shell command on a timer.
-- Below the floor the poll loop spawns it faster than a person could plausibly
-- want, which is a busy loop against the user's own machine; and a negative
-- value, before this rule existed, read as an effectively infinite interval
-- and silenced the feed with no trace. Neither failure announced itself.
--
-- == How an interval is displayed back ==
--
-- Stored values are seconds, and the editor section WRITES seconds back
-- (unsuffixed), so an editor round-trip is lossless and unambiguous even
-- though "10m" was accepted on the way in. No surface renders a humanised
-- cadence today; if one is added, it should show the largest whole unit that
-- divides the value exactly, else seconds ("600" -> "10m", "650" -> "650s").

------------------------------------------------------------
-- VisualColumn
------------------------------------------------------------

-- The kanban board has two separate index spaces:
--
-- 1. VisualColumn indices (0–7): 8 sub-columns for task-status rendering,
--    each corresponding to a (parent_status, sub_status) pair or set.
--
-- 2. Navigation column indices (1–5): the h/l cursor positions. Running and
--    Review sub-columns are grouped under a single navigation position each.
--    The two spaces are offset by one: nav index 0 is not a column at all,
--    and handlers handed it return without acting.
--
-- VisualColumn layout (task-status rendering, left to right):
--
--   vcol# | Label            | parent_status | sub_statuses
--   ------+------------------+---------------+------------------------------
--       0 | Backlog          | backlog       | none
--       1 | Active           | running       | active
--       2 | Blocked          | running       | needs_input
--       3 | Stale            | running       | stale, crashed, conflict
--       4 | PR Created       | review        | awaiting_review, conflict, pr_closed, pr_unreachable
--       5 | Revise           | review        | changes_requested
--       6 | Approved         | review        | approved
--       7 | Done             | done          | none
--
-- Review-column section order (within nav column 3, top to bottom). Sections are
-- ordered by how much they need the user, most first. Three are derived rather
-- than stored — see "Derived review sections" under SubStatus above:
--
--   # | Section                            | Means
--   --+------------------------------------+------------------------------------
--   1 | conflict                           | rebase/merge conflict — blocked
--   2 | pr closed                          | closed without merging — decide
--   3 | pr unreachable                     | PR cannot be read — fix access or url
--   4 | changes requested                  | on the user's own PR — must fix
--   5 | approved                           | own PR, ready to merge
--   6 | awaiting review                    | nothing to do yet
--   7 | parked                   (derived) | no PR, agent session ended
--   8 | changes requested by me  (derived) | waiting on the other author
--   9 | approved by me           (derived) | nothing left for the user to do
--
-- "pr unreachable" sorts above "changes requested" because it is worse than a
-- known task: until it is fixed the card's review state is not merely
-- unfinished, it is unknown, and the board is quietly reporting a decision that
-- may already have changed.
--
-- "approved" deliberately sorts ABOVE "awaiting review": an approved PR is
-- actionable, an undecided one is not. "approved by me" sorts BELOW every other
-- section for the mirror-image reason: the user already gave the only decision
-- that was theirs to give, so the task needs them less than anything else in the
-- column.
--
-- Navigation column layout (h/l cursor, left to right):
--
--   nav# | Label            | kind         | vcol range
--   -----+------------------+--------------+----------
--      1 | Backlog          | task-status  | vcol 0
--      2 | Running          | task-status  | vcols 1–3
--      3 | Review           | task-status  | vcols 4–6
--      4 | Done             | task-status  | vcol 7
--      5 | Archive          | edge         | —
--
-- Edge column (Archive):
--   - Archive (nav index 5) is the rightmost navigation column. It is only
--     rendered when it has keyboard focus (dynamic visibility). When focused
--     it shows archived tasks; when unfocused it is invisible.
--   - The edge column has no parent_status or sub_statuses; it is
--     outside the task-status model.
--
-- Navigation:
--   - h/l (or Left/Right) moves the cursor between nav indices 1–5.
--   - At nav index 1 (Backlog), h/Left is a no-op (already at leftmost edge).
--   - At nav index 5 (Archive), l/Right is a no-op (already at rightmost edge).
--   - h/Left closes the Archive column (navigates left to Done).
--   - In ViewMode::Epic the nav index is clamped to [1, 4]: Archive is not
--     reachable from the epic view.
--   - The edge column persists across data refreshes: a RefreshTasks event
--     does not move the cursor out of the edge column.
--   - Parent group boundaries are annotated in the column header.
--   - A task's visual column is determined by (task.status, task.sub_status).
--   - Switching into a different, non-empty navigation column (via h/l or
--     Left/Right) always places the cursor on the first card (row 0) —
--     never a row remembered from a previous visit to that column — and
--     releases the select-all cursor position (on_select_all), which is a
--     cursor move and not a change to the multi-selection: the selected
--     tasks and epics are untouched (see tasks.allium: "Multi-Selection").
--     The column also scrolls back to the
--     top so the first card is visible. A clamped no-op (already at the
--     leftmost/rightmost edge) leaves the cursor and scroll position
--     untouched. Switching into an empty column is also a no-op for the
--     cursor/toggle state, matching the [ / ] jump-to-first/last no-op on
--     an empty column. The Archive edge column keeps its own reset-to-0
--     behaviour on entry, independent of this rule.
--
-- Row navigation (cursor movement within the current column):
--   - j/k (or Down/Up) move the cursor one card at a time within the
--     currently-focused navigation column.
--   - Jump-to-top: moves the cursor to the first card (row 0) of the
--     current column. Bound to `[` and to the vim-style `gg` chord.
--   - Jump-to-bottom: moves the cursor to the last card of the current
--     column. Bound to `]` and to `G` (Shift+G).
--   - `gg`/`G` are pure aliases of `[`/`]`: they carry no new semantics.
--     They share the same behaviour on an empty column (a no-op that
--     leaves cursor/scroll/toggle untouched), the same release of the
--     select-all cursor position on a real move, and the same behaviour in
--     ViewMode::Epic. Jump-to-top/bottom are available on the main board
--     and in epic view.
--   - The Archive edge column is OUTSIDE that parity. It has its own key
--     handler with its own small binding set (j/k and Down/Up; h/Left/Esc
--     to leave; `[`/`]`; x to delete; e to edit; q to quit) and every
--     other key is ignored. `g` and `G` are among the ignored ones, so
--     jump-to-top/bottom in the archive is reachable by `[`/`]` only —
--     the `gg` chord never starts there, and `G` does nothing. When
--     reached that way the jump moves the archive row cursor and no-ops on
--     an empty archive, matching the task columns; it has no select-all
--     toggle to release.
--   - G/gg are deliberately scoped to the main board and epic view only.
--     Overlays that bind g/Enter to their own actions (e.g. the Todos
--     overlay's "jump to linked item") keep those bindings; this
--     navigation does not touch overlay key handling.
--
-- The `gg` chord:
--   On the main board (Normal mode) and in epic view, `gg` is a pure
--   chord with no other meaning attached to a lone `g`:
--   - Pressing `g` with no chord pending starts a pending-chord window
--     (records the press time). Nothing else happens yet.
--   - If the next keypress is another `g` within config.gg_chord_timeout,
--     the chord completes as jump-to-top.
--   - If the next keypress is anything else — a different key, or a `g`
--     after the window has elapsed — the pending chord is simply
--     abandoned (no action fires for the lone `g`), then the new keypress
--     is processed normally.
--   - If the user goes idle after a lone `g` (no further keypress), the
--     periodic tick handler clears the stale pending chord once it is
--     older than config.gg_chord_timeout. Nothing fires; this is cleanup
--     only, not a deferred action.
--   - A pending chord is discarded (dropped, not fired) if the next input
--     transitions away from main-board Normal mode entirely (into the
--     TaskDetail or Todos overlays, or the Archive edge column) before it
--     resolves. This is a defensive simplification to stop a stale chord
--     leaking across an unrelated view transition; it is not expected to
--     be user-visible.
--   - `G` (jump-to-bottom) has no such conflict and no chord: wherever it
--     is bound it is a direct alias for `]`. It is bound on the main board
--     and in epic view, and not in the Archive edge column.
--
-- `space` (jump to the selected task's tmux window, or enter the
-- selected epic):
--   On the main board (Normal mode) and in epic view, a single `space`
--   press fires this action immediately — no chord, no deferred
--   resolution, no latency. (Previously this action was bound to `g`,
--   sharing its keystroke with the `gg` chord above; that coupling forced
--   every lone `g` press through the chord-timeout window. Moving it to
--   `space` removes that latency for the action's own sake, since `gg`'s
--   jump-to-top is already available, latency-free, via `[`.)
--   Multi-select (previously on `space`) moved to `v` to make room.

value VisualColumn {
    label: String
    parent_status: TaskStatus
    sub_statuses: List<SubStatus>

    -- A task belongs to this column when:
    --   task.status = parent_status and task.sub_status in sub_statuses
    contains(task): task.status = parent_status and task.sub_status in sub_statuses
}

------------------------------------------------------------
-- Column Identity and Focus
------------------------------------------------------------

-- How a navigation column tells the user (a) which column this is and
-- (b) whether it currently has the keyboard cursor. These are two
-- separate questions, and the board answers them with two separate
-- visual channels: hue answers "which column", intensity answers
-- "is it focused". Two surfaces are a named exception to that split and
-- use hue to answer the second question — see the exception in "Focus is
-- intensity, not colour-vs-absence".
--
-- == Column identity colour ==
--
-- Every task-status navigation column has an identity colour, drawn from
-- the palette and constant regardless of focus:
--
--   Column   | identity colour
--   ---------+----------------
--   Backlog  | BLUE
--   Running  | YELLOW
--   Review   | PURPLE
--   Done     | GREEN
--   Archive  | ARCHIVE_STRIPE (a muted blue-grey)
--
-- Keyed by task status, not by nav index — see "Navigation column indices"
-- above for the (1-indexed) index space this table does not use.
--
-- Archive's identity is its own token, not the palette's generic grey.
-- MUTED is that generic grey — used for de-emphasised text throughout
-- the board — and it is not Archive's identity in any sense: Archive
-- resolves to ARCHIVE_STRIPE through the same per-column identity lookup
-- as every other column, and its stripe, selected frame, top rule, title
-- and scroll arrows all take that value from it. There is no separate
-- archive path and no special case; Archive is an ordinary column as far
-- as identity is concerned.
--
-- Archive's hue does sit in the same family as Backlog's — ARCHIVE_STRIPE
-- is close to a desaturated BLUE — so the two are not reliably separable
-- by hue alone. Nothing depends on their being separable: Archive is an
-- edge column rendered only while focused, so its label is the bright
-- variant at exactly the times Backlog's is the dim one, and the two never
-- appear at the same emphasis. Recorded so that a later change which made
-- hue alone load-bearing (or which brought Archive on screen unfocused)
-- knows this pair is the one that will collide first.
--
-- The identity colour is used for that column's own chrome and for its
-- *task* cards: the header label, the focused column's top rule and
-- scroll indicators, the stripe on its task cards, and the border of its
-- selected task card. A column never borrows another column's colour.
-- Nor does it lose its own — with one named exception, the top rule and
-- scroll indicators, which drop to grey while unfocused; see "Focus is
-- intensity, not colour-vs-absence". (Archive is an edge column and is only
-- rendered while focused — see the VisualColumn section — but it carries
-- an identity colour on the same terms as the rest while it is on
-- screen.)
--
-- Epic cards are the exception: an epic is its own identity object and
-- takes PURPLE wherever it sits, ignoring its column's identity. See
-- "Epic cards".
--
-- Hue on the board is reserved to these surfaces:
--   - the column header *label*, at both focus states — dimmed toward the
--     fill while unfocused, brightened toward white while focused. The
--     label, not the bar it sits on, is where a column's identity lives;
--     the bar's fill is neutral ("Column header bar").
--   - the top rule above the card list and the scroll indicators (▲/▼),
--     but only while the column is focused: unfocused, both go grey.
--     They sit immediately below the header bar but do not behave like
--     it — see the exception in "Focus is intensity, not
--     colour-vs-absence".
--   - the per-card stripe accent.
--   - the per-card state indicators, which carry their own semantic hues
--     (crashed, needs-input, and so on) rather than the column's.
--   - an epic card's stripe and an epic breadcrumb header row, both in
--     PURPLE regardless of column ("Epic cards").
--   - the panel enclosing the columns in Epic view, faintly purple as a
--     mode signal ("Column ground and card surface").
--
-- Those are the *identity* uses of colour. A card's border is no longer
-- among them: it carries state rather than identity, in a separate
-- vocabulary of its own — RED and YELLOW for unhealthy cards, and a
-- near-white for the cursor. See "Card border: cursor and state". The two
-- vocabularies are deliberately disjoint, which is why the cursor is white
-- rather than a hue.
--
-- Everything else is neutral: the column ground, the header bar's fill,
-- the card surface, a resting card's border, the column separator, and
-- the fill behind the select-all checkbox. The first three are the
-- board's three large flat areas and all three are uniform — the same
-- value in every column at a given focus state, with focus moving them
-- along a neutral ramp rather than tinting them. See "Column ground and
-- card surface".
--
-- == Focus is intensity, not colour-vs-absence ==
--
-- Previously an unfocused column header rendered in a flat neutral grey,
-- discarding its identity colour entirely; only the focused column
-- showed colour at all. That is replaced.
--
-- The rule: on the header label, the column's identity colour is always
-- visible and focus modulates emphasis only.
--   - An unfocused column's header label keeps its identity colour at
--     reduced emphasis — the hue dimmed toward the bar's fill, still
--     unmistakably that column's colour.
--   - The focused column's header label is distinguished by increased
--     emphasis: the same hue brightened toward white, plus bold.
--   - The focused column's ground, and its header fill, are each one step
--     lighter than an unfocused column's, and both steps are *neutral*:
--     focus raises their lightness, it does not tint them.
--
-- The label is where this principle lives, and it is the only surface on
-- which it lives. That is a narrowing: the header *bar* used to carry a
-- wash of the hue at both focus states and was the principle's main
-- exhibit. Its fill is now neutral and uniform across every column, so it
-- has no colour to modulate — the whole hue channel on a column header is
-- the label, and the whole intensity channel is that label's brightness
-- plus two neutral steps behind it.
--
-- The change makes the principle read more cleanly rather than less. Hue
-- is now genuinely constant per column and brightness is the only thing
-- focus moves, where before "a stronger wash of the hue" mixed the two
-- channels together in one surface. Focus used to be signalled by a
-- tinted ground, then by a stronger hued bar; it is now a brighter
-- neutral ground, a brighter neutral fill and a brighter label. What
-- keeps moving is which surface carries the intensity; that intensity,
-- not presence-of-colour, is the signal has not moved.
--
-- Rationale: a board where only one column's label carries colour reads
-- as flat and inert — four of the five columns look switched off. Focus
-- remains unambiguous when it is signalled by intensity, because the
-- focused column is the only one at full strength, so nothing is lost by
-- giving every column its hue back.
--
-- Named exception: the top rule and the scroll indicators.
--
-- Two surfaces do not follow the principle above, and they are named here
-- rather than left to be discovered. The thin rule above a column's card
-- list, and that column's scroll indicators (▲/▼), take the identity hue
-- while the column is focused and drop to a flat neutral grey while it is
-- not. That is colour-vs-absence — precisely the mechanism this
-- subsection replaced on the header label — and it is deliberate: those two
-- surfaces signal focus by *gaining* hue rather than by intensifying it.
--
-- The reason is size, not oversight. A top rule is a one-cell-tall
-- hairline, and a dimmed hue at that size is not distinguishable from
-- grey in practice, so the reduced-emphasis treatment that works on a
-- text label buys nothing here — it would spend a hue to produce
-- something the eye reads as grey anyway. Nothing is lost from that
-- region of the screen either, because the header label sits immediately
-- above the rule and carries the column's identity at rest. The identity
-- is still there to be read; it is only the hairline that stops
-- restating it.
--
-- So the two surfaces are adjacent but not one channel. The header label
-- keeps hue at reduced emphasis when unfocused; the top rule abandons hue
-- entirely. Surfaces that behave oppositely under focus are not the same
-- channel, and an earlier reading of this spec that grouped them as one
-- was wrong.
--
-- Scope: this exception covers the top rule and the scroll indicators and
-- nothing else. It is not a general licence to drop hue when unfocused.
-- Every other identity-bearing surface — the header label and the card
-- stripe — keeps its hue at both focus states, and dropping hue anywhere
-- else would be a regression against the principle rather than an
-- extension of this exception.
--
-- == Column header bar ==
--
-- The header *label* is the column's identity surface. It is what makes
-- the column identifiable, and it is the only surface asked to carry that
-- job. The bar it sits on is neutral.
--
-- Each column header renders as a filled bar showing a focus prefix
-- (`▸` when focused, `◦` when not), the column label uppercased, and the
-- count of selectable items in that column, the count at reduced emphasis
-- relative to the label.
--
-- A bar spans exactly the horizontal extent of the column it labels — no
-- more and no less — and the separators between columns are part of no
-- bar. The header row and the board below it are divided by *one* split,
-- not by two divisions of the same width that agree: the row of bars and
-- the row of columns are the same division of the screen, seen at two
-- heights.
--
-- Stating it as one split rather than as two things that must be kept
-- equal is the normative part. Two independent divisions of one width can
-- disagree in ways that depend on how the division rounds, so they drift
-- rather than break — the discrepancy grows across the row and shows up as
-- slop rather than as a clean offset, which is exactly what a
-- keep-them-in-step rule fails to prevent.
--
-- What is at stake is identity attribution, not neatness. The label is the
-- column's identity surface, so a bar that overhangs into its neighbour
-- puts one column's header over another column's cards, which is the single
-- thing the identity rules exist to prevent.
--
-- The bar's fill is near-neutral and uniform: the same value in every
-- column at a given focus state, with the focused fill one step lighter
-- than the unfocused one. It carries no hue and no per-column variation —
-- it is a third large flat neutral area alongside the column ground and
-- the card surface, and it belongs with them rather than with the hued
-- surfaces.
--
-- All of the column's identity is therefore in the label's text colour,
-- and neither of its two values is the palette token itself:
--   - unfocused: the identity hue mixed part-way toward the bar's fill.
--     Reduced emphasis, still unmistakably that column's colour.
--   - focused: the identity hue mixed part-way toward white. Brighter,
--     plus bold.
--
-- "Mixed from" is a derivation, not a description of two colours that
-- happen to look related. Both label values are computed from the column's
-- identity hue, so changing a hue moves that column's labels with it and
-- the three cannot fall out of step. This matters more than it would for
-- an ordinary rendering detail: the label is the only surface carrying
-- column identity, so a label that had drifted from its hue would leave
-- the identity colour with nowhere legible to appear at all.
--
-- This replaces a header bar whose fill was a darkened wash of the
-- identity hue at both focus states. Two hued treatments were stacked in
-- one surface — a hued fill under hued text — and the fill was the
-- weaker of the two while occupying almost all of the area. Neutralising
-- it concentrates the column's hue in the text, which is where it is
-- legible, and puts the header on the same neutral ramp as the rest of
-- the board's large areas.
--
-- One consequence is worth stating plainly, because it is easy to assume
-- otherwise: on a card, the literal palette token is now rendered on
-- exactly one surface — the stripe. The header label is a derivation of
-- the token rather than the token (dimmed or brightened), the top rule and
-- scroll indicators show it only while focused, and the card border no
-- longer carries identity at all ("Card border: cursor and state"). So the
-- identity colour as written survives on a single one-quarter block a
-- couple of pixels wide, per card. That is a thin thread, and it is worth
-- knowing it is thin: the stripe is the last place a column's exact
-- identity colour appears on a card.
--
-- The focused column's header additionally carries the select-all
-- checkbox indicator, and behind that checkbox sits a single neutral fill
-- marking it as a selectable cursor target within the header. That fill is
-- one value shared by every column — the same neutral as a resting card's
-- border, so the checkbox reads at the same level as a card's edge rather
-- than as a thing of its own kind.
--
-- It was previously a per-column hued ramp — a third one, after the header
-- fill and the superseded card tint — and dropping it removes a whole
-- per-column ramp rather than retuning one. With no hued fill anywhere
-- else on the board, a hued checkbox would have been the only one and
-- would have read as an oversight. Nothing about the checkbox varies by
-- column any more: neither its fill nor its presence depends on which
-- column it is in, only on whether that column is focused and is not the
-- Archive edge column.
--
-- The checkbox is recorded here because the header bar is where it is
-- rendered. Its *behaviour* — what toggling it selects — is specified in
-- tasks.allium ("Multi-Selection", rule SelectAllColumn), together with the
-- distinction between the select-all action and the select-all cursor
-- position that this section's on_select_all refers to.
--
-- The Archive edge column never shows the checkbox, even though it is
-- always focused while on screen: there is no batch operation over
-- archived items for it to select for.
--
-- == Column ground and card surface ==
--
-- The board's ground is uniform and neutral. Every task-status column
-- renders the *same* ground colour at the same focus state: there is no
-- per-column tint and no column ground carries hue. Columns are
-- divided by a neutral separator, not by a change of colour.
--
-- "No hue" is a claim about *column* grounds. Epic view tints the panel
-- that encloses the columns with a faint purple ground, as a mode signal
-- — it says "you are inside an epic", not "this column is purple" — and
-- the column grounds inside that panel stay neutral and uniform. The two
-- do not conflict: one is the board's frame, the other is the board.
--
-- This replaces the earlier per-column tinted ground. Tinting five
-- adjacent full-height panels put hue everywhere and so left hue with
-- nothing to mean; the board now spends its colour budget on the header
-- labels and on the one selected card.
--
-- The header bar's fill joined this treatment later and on the same
-- terms: ground, header fill and card surface are the board's three large
-- flat areas, all three uniform across columns, all three neutral, and
-- all three moved by focus along a neutral ramp rather than tinted. No
-- flat area on the board carries hue. Only text, hairlines and card
-- frames do.
--
-- Cards are raised off that ground. Every card — not only the cursor
-- card — renders on a card surface one step lighter than any column
-- ground, so a column reads as a stack of lit objects on a dark
-- ground. The neutral ramp therefore has three steps in strictly
-- ascending lightness:
--
--   column ground, unfocused  <  column ground, focused  <  card surface
--
-- Note what that ordering is *not*. It is not "everything in an
-- unfocused column is darker than everything in a focused column". The
-- card surface is a single value shared by every column, so a card in an
-- unfocused column is legitimately lighter than the ground of the
-- focused column next to it. The ramp orders surfaces, not columns, and
-- there is no single global chain from "least focused thing" to "most
-- focused thing".
--
-- The *unfocused* ground sits one step below the bare terminal
-- background, so an unfocused column reads as a recessed panel that its
-- cards stand proud of. Only that one step is recessed: the focused
-- ground crosses back over and sits just above the terminal background,
-- which is part of how focus reads — the focused column comes forward
-- while its neighbours stay sunk. Each step must stay distinguishable
-- from the step below it: a difference nobody can see is the same defect
-- as no difference at all.
--
-- The recession is measured against a terminal background the app never
-- paints. The board draws its own grounds but leaves the terminal's own
-- background wherever it draws nothing, so "below the terminal
-- background" is a claim about the dark theme this palette is designed
-- for (a near-black around #1a1b26), not a property the app controls or
-- can check. On a light terminal the relation inverts and the board
-- reads as raised rather than recessed. This is an accepted assumption,
-- not an oversight: it is unenforceable against an arbitrary theme, and
-- a test can only pin the palette's own numbers, never what the user's
-- terminal is actually showing behind them.
--
-- == Selection ==
--
-- The cursor (selected) task card is marked by two things:
--   - its frame is drawn in the cursor white, and
--   - its title is bold.
--
-- Its fill does not change. A selected card's surface is exactly a
-- resting card's surface. Selection is the top of the emphasis ladder
-- but it is *not* a fourth step of the lightness ramp — its emphasis is
-- carried by border colour and title weight, neither of which is a tint.
-- A test that asserts "selected is lighter than resting" is asserting
-- something this design deliberately does not do.
--
-- Of those two markers only the frame is unambiguous. Bold weight is
-- shared with three other states, so bold on a card does not mean "this
-- is the cursor":
--   - a multi-selected card (batch selection) takes a bold title as well
--     as a leading `*` in its fixed prefix, so bold reads as "cursor or
--     multi-selected";
--   - a flashing card applies bold to the whole card, not just its title
--     (see "Message flash");
--   - an epic card's title is bold unconditionally, at rest (see "Epic
--     cards").
--
-- The frame is therefore the cursor signal, and the bold title is a
-- reinforcement of it that carries no meaning on its own. The `*` prefix,
-- not weight, is what distinguishes a multi-selected card.
--
-- == Card border: cursor and state ==
--
-- A card's border answers one question, and which question it answers has
-- changed. It used to mean "this is the selected card" — the cursor took
-- the column's identity hue and every other border was neutral. It now
-- means **state**, and the cursor has been moved off the identity hue
-- onto a colour of its own.
--
-- Every card's border is decided by the first of these that applies:
--
--   1. the cursor card       a near-white (#e8edfb) used for nothing
--                            else anywhere on the board
--   2. an unhealthy card     its state colour, below
--   3. anything else         the resting neutral
--
-- The state colours are a closed set, chosen so that the border never
-- says anything the card is not already saying elsewhere:
--
--   RED     the five hard failures — unprovisioned, auto-dispatch
--           failed, rebase conflict, crashed, and respawn-failed (a
--           phoenix task left sitting in done with its flag intact; see
--           "Phoenix marker"). These are exactly the states whose
--           indicator line already renders a ⚠, so border and glyph agree
--           by construction rather than by two lists being maintained in
--           parallel.
--   YELLOW  the three attention states — needs-input (blocked), stale,
--           and stale-shell (a live backgrounded shell running long
--           enough to look abandoned; see "ShellEntry" and
--           ClassifyAgentActivity in agent-health.allium). Grouped with
--           plain stale rather than given its own colour: both mean
--           "this task looks idle", just for different structural
--           reasons.
--
-- Nothing else takes a border colour. *Dispatching* is deliberately
-- excluded even though its indicator renders amber: it is a transient
-- expected state, not a condition wanting a human, and bordering it would
-- make every ordinary dispatch alarm for as long as it took.
--
-- Why the cursor is white rather than the column hue: with the border
-- carrying state, a hued cursor border would be competing with the state
-- vocabulary in the same channel on the same surface — in the Running
-- column the identity hue *is* amber, which is precisely what needs-input
-- claims. A colour used for nothing else cannot be misread as a state.
--
-- The accepted cost: because the cursor wins outright, a card that is both
-- unhealthy and the cursor shows white, not its state colour. That is a
-- real loss of information and was accepted knowingly. Its mitigation is
-- that the state remains readable on the same card without moving the eye
-- — the indicator line directly beneath says `⚠ crashed` in red. The
-- alternative, letting state win, hides the cursor instead; losing the
-- cursor cue on the card you have just navigated to was judged worse than
-- losing a border cue on a card you are already looking straight at.
--
-- What is now exclusive is the white, not hue in general: at most one card
-- on the board carries the cursor white, while any number may carry state
-- colours at once. The old claim — that the selected card's was the only
-- hued card border — is false in both directions now and should not be
-- reintroduced in any form.
--
-- The rule is uniform across card kinds. An epic card takes the cursor
-- white on the same terms as a task card, with no exemption for its own
-- identity colour — see "Epic cards" for why the purple frame it used to
-- take had to go.
--
-- Hued column chrome (the focused column's top rule, its scroll
-- indicators) is not a card border and is unaffected by any of this.
--
-- == Card stripe ==
--
-- Every card carries a one-quarter left block (▎ U+258E) immediately
-- left of the id, in the column's identity colour on a task card and in
-- PURPLE on an epic card ("Epic cards"). The cursor card
-- uses the same glyph as every other card. The earlier behaviour — the
-- cursor card swapping in a half block (▌ U+258C) while resting cards
-- used the quarter block — is replaced; selection is carried by the
-- cursor-white border and the bold title alone, and stripe weight no
-- longer moves with the cursor.
--
-- The stripe is an accent, not the identity carrier. At normal terminal
-- font sizes a quarter block is roughly two pixels wide, which is too
-- little area for a hue to be legible. It echoes the header label for a
-- reader who is already oriented; it does not make a card identifiable
-- in isolation, and this spec makes no such claim. The header label is
-- the identity surface.
--
-- Note that the stripe nevertheless renders the *literal* palette token,
-- which the header label does not — see "Column header bar". The smallest
-- hued surface on the board is the one showing the identity colour
-- exactly. That is not a contradiction of the paragraph above: showing a
-- colour exactly and showing enough of it to be read are different
-- things, and it is the second that makes a surface an identity carrier.
--
-- == Epic cards ==
--
-- An epic card is not a member of its column's identity. It is its own
-- identity object, and it carries PURPLE in every column: its stripe is
-- purple wherever the card sits — in Done it is purple, not green; dragged
-- to Backlog it is purple, not blue. The epic breadcrumb header row that
-- precedes a group of epic-owned tasks in flattened view is purple on the
-- same terms.
--
-- An epic's purple stops at its frame. A *selected* epic frames in the
-- cursor white like any other card ("Card border: cursor and state") —
-- the cursor rule is uniform across card kinds and has no exemption for
-- epics. Purple identity lives on the stripe and on the title, which an
-- epic keeps at rest.
--
-- A selected epic used to frame purple, and the reason that had to go is
-- worth keeping: PURPLE is also the Review column's identity hue. A purple
-- epic frame would put a column's own hue on a card frame — exactly the
-- identity-vs-state collision the cursor white was chosen to remove,
-- reintroduced on the one card type that had escaped it. A selected epic
-- sitting in Review would have framed in that column's colour, and a
-- reader would have had no way to tell that frame from a column-identity
-- one.
--
-- Intent: an epic is a container, not a task, and it reads as a different
-- *kind* of thing rather than as a task that happens to be in a
-- particular column. Column identity answers "what status is this"; for
-- an epic, "this is an epic" is the more useful thing for colour to say,
-- and the column it sits in is already legible from its position.
--
-- One consequence must be stated because it breaks a rule that holds
-- everywhere else: an epic card's title is bold **at rest**,
-- unconditionally. Bold is therefore not a cursor signal on an epic card
-- at all, and the frame is the *only* thing that distinguishes a selected
-- epic from a resting one. Where a task card has two markers of which one
-- is ambiguous, an epic card has exactly one, and it is not ambiguous.
-- Anything that later weakens the frame signal on epics — for instance
-- giving resting epic frames a colour too — removes the only cursor cue
-- they have. That is the reason the white has to stay legible here
-- specifically: on a task card a weakened frame still leaves the bold
-- title as a partial cue, and on an epic card it leaves nothing.
--
-- Everything else about an epic card is unchanged from a task card: the
-- neutral card surface, the neutral resting frame, the lit frame, the
-- one-cell inset and the four-cell horizontal chrome all apply
-- identically.
--
-- == Task card frame ==
--
-- A task card is a discrete framed box, not a run of text separated
-- from its neighbours by a rule. Every card draws its own complete
-- frame — rounded top and bottom borders plus left and right rails —
-- so that a card is bounded on all four sides and no two cards share a
-- border.
--
-- The whole card is lit, frame included. The border rows and the side
-- rails carry the *card surface* background, not the column ground, so
-- a card's boundary is the change of colour at its outer edge and the
-- frame reads as belonging to the card. The rejected alternative was to
-- paint the border on the column ground and confine the lift to the
-- frame's interior; that makes the frame read as a hairline drawn on the
-- board rather than as the edge of an object.
--
-- The card is inset from the column by one cell on each side. A card
-- does not span the full column width: a one-cell margin of the
-- column's neutral ground shows to its left and to its right, so cards
-- float inside the column rather than tiling flush against its edges and
-- against the column separator. Those margin cells are ground, not card
-- surface — the card surface fills the card and stops at the margin.
--
-- The inset and the lit frame are one mechanism seen from two sides. The
-- lift is what makes the card read as raised; the margin is what makes
-- its outer edge a visible boundary rather than a butt-joint with the
-- column edge, the separator, or a neighbouring column's card.
--
-- The inset is horizontal only. There is no blank row above or below a
-- card: vertically adjacent cards put their bottom and top borders on
-- consecutive rows, with no ground showing between them. So "cards float
-- inside the column" is true left-to-right and not top-to-bottom, and a
-- run of cards reads as a stack in contact rather than as four
-- independently floating boxes. What still holds is that each card owns
-- its own complete border — two touching borders are two borders, not one
-- shared rule — which is what "no two cards share a border" above means.
-- Vertical breathing room was not traded away for width; it was never
-- there, and adding it would cost a further row per card on top of the
-- frame's existing one.
--
-- The frame's colour is not a property of the frame but of the card's
-- condition: cursor white, else a state colour, else the resting neutral.
-- The rule and its precedence live in "Card border: cursor and state";
-- this subsection is about the frame's shape and extent, and deliberately
-- does not restate them.
--
-- The frame is what makes the column read as a stack of objects rather
-- than as a paragraph. It costs one line per card over the previous
-- shared-rule presentation (four lines: top border, title, metadata,
-- bottom border), which is the intended trade: fewer cards visible, but
-- each unambiguously a card.
--
-- Horizontally it costs four cells per row: two ground margins plus two
-- frame rails. The pre-frame presentation spent none of the column width
-- on chrome; a framed-but-flush card would spend two; the inset framed
-- card spends four. Every one of those cells comes out of the title
-- budget, on top of the fixed prefix each card already carries
-- (selection marker, stripe, id).
--
-- That trade is accepted, but it is tight rather than comfortable, and it
-- is tightest in the narrowest column. With the Archive edge column on
-- screen the board divides five ways, so on a 120-cell terminal a card
-- has roughly a dozen cells left for its title. A title that fitted
-- before the inset can be truncated after it, with no slack in between —
-- this is a real effect and not a hypothetical one.
--
-- Nothing adapts. The margin is one cell at every terminal size and
-- every column count; there is deliberately no width-conditional or
-- column-count-conditional branch, and none is wanted. If the title
-- budget later needs to grow, the levers are to narrow or drop the
-- margin, or to show fewer columns at once — the first paid for by
-- losing the card's outer boundary, the second by losing board breadth.
-- The trade is recorded here so that it is read rather than
-- rediscovered.
--
-- == Card label badges ==
--
-- A task's labels render on the card's metadata line, after the status
-- indicator, each as a bracketed badge `[text]` in declaration order (see
-- Task.labels). They are muted grey: a label is context, not state, and must
-- not compete with the indicator to its left for the eye.
--
-- CI status is the ONE exception. Three label texts are a shared vocabulary
-- between the feed and this renderer (see "CI status label" in feeds.allium)
-- and take a state colour instead of the muted grey:
--
--   [ci:pass]     green
--   [ci:fail]     red
--   [ci:pending]  yellow
--
-- These are the same three colours the card indicator uses for the same three
-- meanings, deliberately: a red badge means the same thing on a card
-- regardless of which element carries it.
--
-- Colour is what makes the badge worth having. The information a reviewer
-- acts on is "is this one broken", and scanning a column of identically-grey
-- badges to read their text is not scanning — it is reading every card. A red
-- badge in a grey row is found without reading anything.
--
-- The exception is by exact text match on those three strings and is
-- deliberately NOT a general prefix rule ("colour anything starting `ci:`").
-- Any other label, including an unrecognised `ci:` value from a newer feed
-- script, renders as an ordinary muted badge. This mirrors the lenient decode
-- feeds.allium applies to unknown signals: a vocabulary the renderer does not
-- know degrades to the plain presentation rather than to a wrong colour or a
-- panic.
--
-- Badge colour is text colour only. A badge does not get a fill, a border or
-- a bold weight — the card surface stays uniform ("Column ground and card
-- surface") and the frame keeps its own meaning ("Card border: cursor and
-- state"). Nothing about the badge changes with the cursor.
--
-- == Message flash ==
--
-- When a task sends or receives a native cross-session message (task #4098
-- — Claude Code's own SendMessage, observed via the hook pipeline; see
-- HookPeerMessageSent in agent-health.allium), that task's card flashes for
-- config.message_flash_ttl: a direction-specific glyph and a distinct warm
-- fill. A card that received a message shows an envelope (✉); one that sent
-- one shows an outgoing arrow (➤); a card that did both within the same
-- window shows both glyphs, since sender and receiver are just two rows this
-- rule can independently mark true. Its border is the resting neutral,
-- exactly like any other card's — the flash does not colour the border at
-- all, and takes no exception to the border rules in "Card border: cursor
-- and state".
--
-- The duration is a notice, not a blink. It is set long enough that a
-- human whose attention is elsewhere — reading a diff, watching another
-- agent — still catches the card on their next glance at the board. A
-- few seconds does not clear that bar; the flash would routinely begin
-- and end while nobody was looking at it, which is the same as not
-- flashing.
--
-- Fill and glyph are enough on their own: a flashing card is the only card
-- on the board whose fill differs from the shared card surface, and it
-- carries a glyph no other card has — the sent/received split is expressed
-- entirely as which glyph(s) appear, not as a second fill; both directions
-- share the one warm fill, per the same "no third vocabulary on this
-- surface" reasoning below. (It also applies bold to the whole card rather
-- than to the title alone — see "Selection", where that is one of the
-- reasons bold carries no cursor meaning by itself.)
--
-- The flash used to take the column's identity hue on its border, as a
-- named exception to a rule that no longer exists. What forced the change
-- was a collision rather than a preference: once the border began carrying
-- state, a flash in the Running column would have drawn its border in that
-- column's identity hue — amber — which is exactly what needs-input
-- claims. The flash would have been indistinguishable from a blocked
-- agent. Recorded because the obvious repair is to give the flash a hue of
-- its own, and that is the thing not to do: it would put a third
-- vocabulary on a surface that now has two, to solve a problem the
-- envelope already solves.
--
-- Retiring the hue also retired a standing obligation. While the flash's
-- border was hued, the design depended on the envelope and the hue being
-- co-terminous — the glyph had to last exactly as long as the border
-- colour, or a card would show a hue with nothing to say what it was.
-- That constraint is gone rather than relaxed: with a neutral border there
-- is nothing to disambiguate, and the glyph's lifetime is now free to be
-- reasoned about on its own. This change removes a rule from the spec
-- instead of adding one, which is the main reason it is worth making.
--
-- == Phoenix marker ==
--
-- A task with phoenix = true carries a recycling glyph (♻ U+267B) on its
-- title line, in the same position and by the same mechanism as the message
-- flash glyphs. It says one thing in every column: **this task still owes a
-- respawn**. In backlog, running and review that is simply what a phoenix
-- task is. In done it is a failure — PhoenixRespawn clears the flag exactly
-- when the successor was created (tasks.allium), so a done card still
-- showing ♻ is a task whose copy did not land. One glyph, one meaning; which
-- column it sits in is what makes that meaning good or bad news.
--
-- The marker is not a state colour. Outside done it takes the resting
-- neutral border like any healthy card, on the same terms as the message
-- flash: it is an attribute of the task, not a condition wanting a human.
-- Inside done it is Task.respawn_failed, which IS such a condition, and that
-- is what takes the border — see "Card border: cursor and state", where it
-- is one of the RED set, and it renders a ⚠ indicator line like the rest of
-- that set.
--
-- ♻ is the one card glyph that is not one column wide. Every other glyph on
-- a card — ▎ (U+258E), ✉ (U+2709), ➤ (U+27A4), ▸ (U+25B8), ✓, ⚠ — is a
-- single-column BMP character, and the title-width budget is built by
-- counting characters. ♻ has emoji presentation in most terminals and is
-- drawn two columns wide, so the budget must reserve its RENDERED width, not
-- its character count. Get this wrong and the title overflows the card frame
-- by one column on every phoenix card. This is the only place in the board
-- where the two measures differ, which is exactly why it is written down
-- rather than left to be rediscovered.
--
-- == Where these rules are enforced ==
--
-- Coverage lives in two files, and which one is not arbitrary. Most of it
-- is in src/tui/tests/rendering.rs, which renders a board to a buffer and
-- reads colours back off it — that is the right instrument for a claim
-- about what reaches the screen. Two of the border tests instead sit
-- inline in src/tui/ui/kanban/cards.rs, because they exercise
-- state_border_color, a helper too narrow to re-export and so unreachable
-- from the tests directory; the repo's convention is that such a helper is
-- tested in the module that owns it. Each entry below names its home when
-- it is not rendering.rs, so a reader who searches rendering.rs for border
-- coverage and comes up short does not conclude it is missing.
--
-- Any remaining gaps are listed after the tests rather than left to be
-- assumed.
--
-- In src/tui/tests/rendering.rs:
--
--   board_ground_is_uniform_across_columns       uniform neutral ground
--   focused_column_ground_is_distinct_from_unfocused
--   neutral_ramp_is_strictly_ascending           the three-step ramp
--   board_ground_is_recessed_below_terminal_background
--   selection_does_not_lift_the_fill             selected fill = resting
--   resting_card_border_is_neutral               iterates all five columns
--                                                through the identity
--                                                lookup, Archive included
--                                                and not special-cased, so
--                                                Archive's rendered
--                                                identity is covered by the
--                                                same loop as the rest
--   every_card_frame_is_lit_by_the_card_surface  all four corner glyphs
--   cards_are_inset_by_one_cell_of_column_ground margin width, its ground
--                                                colour, and the lit rail
--                                                inside it
--   card_frame_carries_state_and_the_cursor_outranks_it
--                                                the whole border rule on
--                                                one board — see the note
--   only_the_selected_card_has_the_cursor_white_frame
--                                                at most one white, healthy
--                                                frames neutral, and no
--                                                column identity hue on any
--                                                frame
--   no_column_leaks_an_identity_hue_onto_a_card_frame
--                                                the cross-column
--                                                companion: all tasks
--                                                healthy, so the whole
--                                                board is one white and
--                                                neutrals
--   epic_cards_carry_purple_identity_and_a_bold_title_at_rest
--                                                a resting epic's stripe is
--                                                PURPLE and not its
--                                                column's hue, and its
--                                                title is bold
--   selected_epic_frames_in_the_cursor_white_not_purple
--                                                the selected epic frames
--                                                white, no frame anywhere
--                                                is purple, and every frame
--                                                is white or the neutral
--   flat_view_epic_breadcrumb_is_purple          the breadcrumb row heading
--                                                a group of epic-owned
--                                                tasks renders its title in
--                                                epic purple
--   a_card_spends_four_cells_of_its_column_on_chrome
--                                                rendered content width
--                                                against column width: the
--                                                difference is exactly four
--   ci_status_badge_is_coloured_by_state         the three CI-status badge
--                                                texts read back green / red
--                                                / yellow, an ordinary label
--                                                on the same card reads back
--                                                muted, and an unrecognised
--                                                `ci:` value reads back muted
--                                                too ("Card label badges")
--   render_v2_task_card_shows_stripe             the quarter block ▎ is
--                                                present and the superseded
--                                                cursor half block ▌ is
--                                                absent, so stripe weight
--                                                no longer moves with the
--                                                cursor
--   unfocused_column_header_keeps_its_identity_colour
--                                                the principle above, on
--                                                the header label: guards
--                                                against the superseded
--                                                flatten-to-grey
--   header_bar_stops_at_the_column_separators    no header fill covers a
--                                                separator cell, at five
--                                                terminal widths
--   select_all_checkbox_fill_is_neutral_in_every_column
--                                                the cursor is parked on
--                                                each task-status column's
--                                                header in turn and the
--                                                rendered checkbox's fill
--                                                read back — asserted
--                                                against a resting card's
--                                                border, which is what the
--                                                spec claims the value is
--   header_fill_is_uniform_across_columns        the fill is the same in
--                                                every column at a given
--                                                focus state and carries
--                                                no hue; all five columns,
--                                                both focus states
--   header_label_is_hued_in_every_column_at_both_focus_states
--                                                two guards: no label
--                                                collapses into its own
--                                                fill, and no two columns
--                                                share a label colour —
--                                                the label being the only
--                                                per-column signal left
--   focused_header_label_is_brighter_than_unfocused
--                                                focus moves the label's
--                                                brightness, which is what
--                                                "focus is intensity"
--                                                reduces to on the header
--   each_header_label_keeps_its_column_hue_signature
--                                                the labels really are
--                                                derived from their hue:
--                                                each keeps the channel
--                                                *ranking* of its source
--                                                at both focus states
--   column_top_rule_is_hued_only_while_focused   the named exception:
--                                                focused rule carries the
--                                                identity hue, unfocused
--                                                rules the neutral grey,
--                                                and no third colour
--   scroll_indicators_follow_the_column_top_rule the other half of that
--                                                exception: the focused
--                                                column's overflow arrow
--                                                carries its identity hue,
--                                                an unfocused one's is grey
--   render_card_message_flash_shows_envelope     the flash's glyph
--   message_flash_envelope_outlives_the_old_three_second_window
--                                                the glyph is still drawn
--                                                well past the superseded
--                                                short window
--   message_flash_expires_once_past_its_ttl      the other side of the
--                                                threshold: swept, and no
--                                                longer drawn
--   message_flash_render_and_sweep_share_one_threshold
--                                                the sweep and the renderer
--                                                read one duration, so they
--                                                cannot disagree about
--                                                whether a flash is live
--   message_flash_never_colours_the_card_frame   a live flash leaves the
--                                                frame alone: no column
--                                                hue, and the only
--                                                non-neutral frame is the
--                                                cursor's
--
-- Inline in src/tui/ui/kanban/cards.rs, against state_border_color:
--
--   every_indicator_claims_the_border_its_severity_earns
--                                                every CardIndicator
--                                                variant paired with the
--                                                border it should claim
--   exactly_five_indicators_are_hard_failures    the counts: five red, three
--                                                amber, and every variant
--                                                in {red, amber, none}
--
-- Those two are a pair, and neither is redundant. The first walks a list of
-- variants written out by hand rather than generated — deliberately, for
-- the same reason state_border_color matches exhaustively: adding a variant
-- forces a deliberate entry, and if list and match ever disagree, one of
-- them is a mistake and the test says which. But a per-variant list alone
-- would still pass if someone moved a variant into the red set and updated
-- its expected value in the same edit, which is precisely how a state gets
-- promoted to a hard failure without anyone deciding to. The counts make
-- that edit visible: it has to change a number that says four.
--
-- Dispatching's entry in that list is an explicit "no border", recorded
-- with its reason — it renders an amber *indicator* while claiming no
-- border. It is the rule's one judgement-rather-than-category exclusion,
-- and so the one most likely to be "fixed" by someone who sees the glyph
-- and takes the missing border for an oversight. An asserted absence is
-- the only kind that survives that.
--
-- card_frame_carries_state_and_the_cursor_outranks_it is the one that
-- carries the rule, and its shape is the reason. It puts a crashed card, a
-- blocked card and a healthy card on one board and places the cursor *on
-- the crashed one*, so the precedence collision is the subject rather than
-- a case the fixture avoids. It asserts amber on the blocked card, white on
-- the cursor, neutral on the healthy one, and no red anywhere — then moves
-- the cursor off and asserts the red it was suppressing appears. That last
-- step is what makes it a test of precedence rather than of three colours
-- sitting side by side; without it, a renderer that had simply forgotten
-- red would pass.
--
-- These four replaced three tests written for the superseded rule that a
-- hued card border meant selection. Those were invalidated rather than
-- retuned: two asserted at most one card frame is non-neutral, which the
-- state colours falsify outright, and the third pinned the flash's hue to
-- its glyph, an obligation retired with the flash's hue.
--
-- Three tests in this section have been written wrong first, in the same
-- way each time, so the pattern is worth naming once: **a test whose
-- measurement is not confined to the thing it claims to check.** Each
-- version passed on broken code while reading as coverage, which is the
-- worst failure a test can have — it does not merely miss the defect, it
-- certifies its absence. The three ways the confinement slipped:
--
--   by metric  each_header_label_keeps_its_column_hue_signature cannot use
--              colour *distance*, because a dimmed colour is far from the
--              hue it was dimmed from. The natural measure is the wrong
--              one, and it fails on correct code.
--   by source  the epic tests must take PURPLE as a literal, not from the
--              Review column's identity lookup, even though the two share
--              the token. Sourcing it from the column encodes the very
--              conflation the test disproves, and would keep passing if
--              epics ever began following their column.
--   by region  flat_view_epic_breadcrumb_is_purple counted purple cells
--              across the whole buffer at first — and the epic *card* is
--              purple too, so it measured the card and reported the
--              breadcrumb. It passed with the breadcrumb drawn in grey.
--              The fix was to find the row by its `── ` rule prefix and
--              read only the title cells after it.
--   by source  select_all_checkbox_fill_is_neutral_in_every_column first
--     of truth  asserted the rendered fill equalled the accessor the
--              renderer itself calls. That caught a *hued* mutation but
--              silently passed a wrong-*neutral* one, because changing the
--              function moved both sides of the assertion together. It was
--              restating the implementation, not checking it. The fix was
--              to assert what the spec claims the value is — the same
--              neutral as a resting card's border — which is an
--              independent claim and catches both mutations.
--
-- The fourth is the one a careful person is likeliest to write, which is
-- why it is worth naming separately from the third. Reaching for the
-- accessor feels like avoiding a magic literal, and that instinct is
-- normally right. It is wrong here because the accessor is downstream of
-- the thing under test: an assertion built from it cannot fail for any
-- change that keeps the renderer and its constant in agreement, which is
-- most changes. The distinguishing question is whether the right-hand side
-- is derived from the subject or from the specification — and a spec claim
-- of the form "X is the same value as Y" should be asserted as exactly
-- that, against Y, not against whatever X currently reads.
--
-- That the accessor had to be re-exported to write the first version, and
-- the re-export became unnecessary once it was fixed, is itself the signal:
-- a test that needs new access to production internals is often reaching
-- for the wrong side of the claim.
--
-- The generalisation: before trusting one of these, check that its
-- measurement can distinguish its subject from everything else that looks
-- similar — the right metric, sourced independently of the claim, read
-- from the right region, and compared against the specified value rather
-- than the implemented one. All four survive mutation testing of the
-- *code*, because the fault is in the test; the fourth passed a mutation
-- and was nearly kept.
--
-- A fixture hazard the border rule creates, worth knowing before writing
-- the next one: a card is *healthy* only if the fixture makes it so. Any
-- test that drives a tick will have an inactive Running task reclassified
-- as stale, and stale now claims an amber border — so a card meant to be a
-- neutral control silently becomes an amber one, and the failed assertion
-- points at whatever the test was actually about rather than at its
-- fixture. This is the cost of the border reading states a fixture
-- acquires by default rather than by asking: "healthy" is no longer the
-- absence of setup, it is setup. Seed recent activity on any card that is
-- meant to rest.
--
-- The separator test checks five widths on purpose. Whether a misaligned
-- header row is visible at all depends on how the division rounds at that
-- particular width, so one width can coincidentally line up and hide the
-- defect entirely — at 120 columns it very nearly does, while the code this
-- replaced fails at 100. A single-width assertion here would have been
-- worse than none, because it would have read as coverage.
--
-- The "by metric" case above, in detail, because the numbers are what make
-- it convincing: measured by distance, Backlog's dimmed label lands nearer
-- ARCHIVE_STRIPE than BLUE, and Review's nearer BLUE than PURPLE, while
-- both are correctly derived. Channel ranking is the right fingerprint
-- because it survives linear mixing toward any neutral — BLUE is
-- b > g > r and stays so dimmed or brightened, PURPLE is b > r > g
-- throughout.
--
-- The superseded three-level tint ladder (unfocused < focused < cursor
-- card) was replaced rather than retuned, because a selected card no
-- longer differs from a resting one by fill at all.
--
-- Not enforced by any test — normative claims above that a reader should
-- not assume are covered:
--   - Epic view's enclosing panel tint: that the panel around the columns
--     is faintly purple as a mode signal, while the column grounds inside
--     it stay neutral ("Column ground and card surface"). One production
--     site, no test. It is the last flat area on the board whose colour is
--     unasserted, and it is the only place purple means *mode* rather than
--     *epic*, so a regression would not read as obviously wrong to someone
--     who found it.
--   - That a cursor or multi-selected *task* card's title is bold
--     ("Selection"). The epic case is asserted — deliberately, since bold
--     is unconditional there — but the task case is not. Low consequence
--     while the frame carries the cursor unambiguously, which is why it is
--     listed rather than urgent: the spec claims two markers and only one
--     of them is checked.
--
-- Both are style claims, which is the pattern in every gap this list has
-- held: text is caught by the snapshots, style is caught only by a test
-- that reads it back. When adding a claim about colour or weight, assume
-- the snapshots will not cover it.
--
-- Every other normative claim in this section is asserted somewhere. That
-- is a statement about now, not a finished state: a new claim here arrives
-- with its test, or with a line in this list saying it has none. Neither
-- is optional, and a short list is only worth having if it is maintained
-- as carefully as a long one.
--
-- Naming tests here couples this spec to them: renaming or deleting one
-- must update this list. That coupling is deliberate, and
-- ./scripts/check-doc-symbols.sh enforces it — a citation that stops
-- resolving fails the pre-push hook rather than rotting quietly.
--
-- The lit frame and the one-cell inset are both produced by
-- src/tui/ui/kanban/cards.rs::frame_card, which paints the margin cells
-- in the column ground so they do not inherit the card surface. Its
-- chrome total (`CARD_CHROME_WIDTH`) is what the title budget is reduced
-- by, so a change to the margin moves truncation on every card.

-- archive_stripe is Archive's own identity token. muted is the palette's
-- generic grey for de-emphasised text, and is not any column's identity.
enum PaletteToken { blue | yellow | purple | green | archive_stripe | muted }

value ColumnChrome {
    -- The column's identity colour. Not a function of focus.
    identity_colour: PaletteToken
    focused: Boolean
    is_archive_edge_column: Boolean

    -- The only surface that renders the identity colour itself, and so the
    -- only place the literal palette token reaches a card at all (see
    -- "Column header bar"). Epic cards are not among them: they carry their
    -- own identity — see EpicCardChrome.
    --
    -- A selected card's border used to be the second such surface. It is
    -- not any longer: the border carries state and the cursor takes a white
    -- of its own, so no border is a function of identity_colour. See "Card
    -- border: cursor and state".
    task_card_stripe_colour: identity_colour

    -- The top rule and scroll indicators, but only while focused.
    -- Unfocused, both drop to a flat neutral grey rather than to a dimmed
    -- hue: they are the named exception to "Focus is intensity, not
    -- colour-vs-absence", signalling focus by gaining hue instead of by
    -- intensifying it.
    focused_top_rule_colour: identity_colour
    focused_scroll_indicator_colour: identity_colour

    -- The header label is *derived from* identity_colour at both focus
    -- states and equals it at neither, so it is recorded as prose rather
    -- than as a derivation — writing `= identity_colour` would be false
    -- (see "Column header bar"):
    --   unfocused label   the hue mixed part-way toward the bar's fill.
    --   focused label     the hue mixed part-way toward white, plus bold.
    --
    -- Neither the header fill nor the select-all highlight appears in this
    -- value at all any more. Both are neutral and uniform across columns,
    -- so neither is a function of identity_colour: the fill belongs with
    -- the column ground and the card surface on the neutral ramp
    -- (BoardNeutralRamp), and the select-all highlight is a single shared
    -- value. The select-all highlight used to be a per-column hued ramp;
    -- it was removed rather than retuned.

    -- Focus modulates emphasis only, never presence of colour.
    header_label_bold: focused

    -- Task-status columns only. The Archive edge column never shows the
    -- checkbox even though it is always focused while on screen: there is
    -- no batch operation over archived items for it to select for.
    shows_select_all_checkbox: focused and not is_archive_edge_column
}

value EpicCardChrome {
    -- An epic is its own identity object: its chrome does not depend on
    -- the column it sits in, and identity_colour here is purple in every
    -- column.
    identity_colour: PaletteToken
    selected: Boolean

    stripe_colour: identity_colour

    -- The stripe is the whole of it. There is deliberately no
    -- selected_frame_colour here: a selected epic frames in the shared
    -- cursor white, which is not an epic-specific value and is not a
    -- function of identity_colour, so it belongs to the board-wide border
    -- rule rather than to this value ("Card border: cursor and state").
    -- Adding one back would be reintroducing the purple frame.

    -- Bold at rest, unconditionally — so weight carries no cursor
    -- information on an epic card and the frame is the only cursor signal
    -- it has.
    title_bold: true
    frame_marks_cursor: selected
}

value BoardNeutralRamp {
    -- Relative lightness on a shared scale whose zero point is the bare
    -- terminal background; values below it are negative. Only the
    -- ordering is normative — the absolute values are a rendering
    -- concern. Every quantity here is neutral: this ramp has no hue
    -- axis, and hue never enters it (see "Column identity colour").
    --
    -- These are surfaces, not focus levels. There is no global chain
    -- from least- to most-emphasised: card_surface is shared by focused
    -- and unfocused columns alike, so it outranks both grounds.
    column_ground_unfocused: Integer
    column_ground_focused: Integer
    header_fill_unfocused: Integer
    header_fill_focused: Integer
    card_surface: Integer
    selected_card_surface: Integer

    -- Focus raises the ground; cards sit above every ground.
    invariant NeutralRampIsStrictlyAscending {
        column_ground_unfocused < column_ground_focused
            and column_ground_focused < card_surface
    }

    -- The header bar's fill is on this ramp too, and behaves like the
    -- ground: focus raises it, and it stays below the card surface so that
    -- cards remain the lightest thing on the board.
    --
    -- How the two header values interleave with the two ground values is
    -- deliberately not asserted. Each surface is ordered against itself
    -- under focus and against the card surface; a relation between, say,
    -- header_fill_unfocused and column_ground_focused would be pinning an
    -- arithmetic coincidence rather than a design decision.
    invariant HeaderFillRisesWithFocusAndStaysBelowCards {
        header_fill_unfocused < header_fill_focused
            and header_fill_focused < card_surface
    }

    -- An unfocused column's ground is recessed relative to the terminal
    -- it is drawn in, so its cards read as raised rather than inset. Only
    -- the unfocused ground: column_ground_focused crosses back above zero,
    -- which is part of how focus reads.
    --
    -- The zero point is an assumption, not something the app controls.
    -- Nothing here ever paints a terminal background — the terminal's own
    -- background shows wherever the board draws nothing — so this holds
    -- against the dark theme the palette is designed for and is false at
    -- runtime on a light terminal. It is unenforceable against an
    -- arbitrary theme: a test can pin the palette's numbers and will pass
    -- regardless of what the user's terminal is actually showing behind
    -- them.
    invariant GroundIsRecessedBelowTerminalBackground {
        column_ground_unfocused < 0
    }

    -- Selection is not a fill lift. The selected card's surface is
    -- identical to a resting card's; its emphasis lives in border hue
    -- and title weight, which are off this ramp entirely. Stating it as
    -- an equality rather than omitting it keeps the old `<` from being
    -- reintroduced by anyone reading the ramp as an emphasis ladder.
    invariant SelectionDoesNotLiftTheFill {
        selected_card_surface = card_surface
    }
}

------------------------------------------------------------
-- FlattenedView
------------------------------------------------------------

-- The task board has two rendering modes: the default hierarchical mode
-- and a flattened mode that surfaces every descendant task of the
-- current scope directly into its visual column, bypassing the
-- epic/sub-epic grouping. Flattening does not reach every column: the
-- Backlog and Done columns are exempt and always render hierarchically
-- (see Rendering).
--
-- Intent: when work is spread across nested epics, users often need to
-- see at a glance which tasks are running, blocked, or awaiting review
-- without drilling into each epic individually. The flattened mode
-- answers that need without changing any task data. The exemption is the
-- other half of the same intent: Backlog and Done are read at the epic
-- level rather than task by task, so flattening them would cost more
-- than it gives.
--
-- Scope: determined by the current view.
--   - Main board view: scope is every non-archived task that passes the
--     active repo filter, regardless of epic membership or depth.
--   - Epic view: scope is every non-archived task whose epic chain
--     (epic_id, then epic.parent, recursively) roots at the current
--     epic, plus any task directly under it. The repo filter still
--     applies.
--   - Either way the scope is narrowed again per column: only a column
--     that is being flattened shows the whole subtree. An unflattened
--     column shows what hierarchical mode would show there — on the main
--     board, tasks with no epic; in an epic view, the current epic's own
--     direct tasks. See Rendering.
--
-- Rendering:
--   - Flattening is per column, not board-wide. It applies to the Running
--     and Review columns only. The Backlog and Done columns are never
--     flattened: each renders exactly as it does in hierarchical mode,
--     with epic cards visible and no descendant surfaced out of its epic.
--     On the main board that leaves only standalone tasks (no epic) as
--     task cards there; in an epic view it leaves the current epic's own
--     direct tasks, with deeper descendants still inside their sub-epic's
--     card. Those two are the columns that are read at the epic level —
--     the backlog stays navigable at the epic level, and completed work
--     stays readable at the epic level — which is why they keep their
--     epic cards while Running and Review give theirs up.
--   - In a flattened column, task cards appear in their normal visual
--     column, determined by (task.status, task.sub_status), exactly as in
--     hierarchical mode, and no epic card is rendered there — neither
--     root epics on the board nor sub-epics inside an epic view.
--   - Epic membership is carried by the epic-header rule below, not by
--     the task card itself: a flattened task card renders exactly as it
--     does in hierarchical mode, with no epic badge of its own.
--   - The decorative epic-header rule that precedes each epic's task group
--     shows that epic's full ancestor breadcrumb: the root ancestor first and
--     the epic's own title last, segments joined with " › ". The breadcrumb is
--     bounded by the column width; when it does not fit, every segment is
--     truncated to keep a visible prefix, sharing the available width fairly
--     across segments. A root epic (no ancestors) shows just its own title,
--     unchanged from prior behaviour.
--   - Within each substatus group, epic-owned tasks come first and tasks
--     with no epic come last. A second decorative rule — visually distinct
--     from the epic-header one — separates the two, marking where the
--     epic groups end. It is drawn only at that transition, so a group of
--     all-epic or all-orphan tasks shows none. Like the epic header it is
--     decoration: neither rule is selectable and neither counts towards
--     the column's navigable items.
--
-- State model:
--   - Flattened is a single board-level boolean, toggled by the user.
--   - The value is preserved as the user navigates into sub-epics and
--     back out: drilling down or exiting an epic does not change it.
--   - It is session-scoped and does not persist across app restarts.
--
-- Interaction:
--   - Task-card actions (dispatch, go-into-task, expand-description)
--     behave identically in both modes. A flattened task card always
--     acts on the task itself, never on its ancestor epic.
--   - Epic cards stay visible and selectable in the two unflattened
--     columns, so an epic sitting in Backlog or Done can be entered
--     without leaving flattened mode. To navigate into an epic whose own
--     card falls in a flattened column, the user first turns flattened
--     mode off; every epic card then becomes visible and selectable.

value FlattenedView {
    active: Boolean

    -- The columns flattening never reaches, named by their parent status.
    -- Both are read at the epic level — the backlog stays navigable at
    -- the epic level, completed work stays readable at the epic level —
    -- so both keep their epic cards and leave every descendant inside the
    -- epic it belongs to (see directly_under below for the one level a
    -- column shows without flattening).
    unflattened_statuses: Set<TaskStatus> = { backlog, done }

    -- Flattening is decided per column, not once for the board.
    flattens(column): active and column.parent_status not in unflattened_statuses

    -- A column renders epic cards unless it is being flattened. In
    -- hierarchical mode (active = false) that is every column, and
    -- rendering follows the default rules (root epics on the board,
    -- sub-epics and direct tasks inside each epic view).
    renders_epics(column): not flattens(column)

    -- What hierarchical mode shows in a column: on the main board, tasks
    -- with no epic; in an epic view, the current epic's own direct tasks.
    -- Deeper descendants stay inside their sub-epic's card.
    directly_under(task, view):
        (view.is_board and task.epic = null)
        or (not view.is_board and task.epic = view.current_epic)

    -- A task is in scope for the given column when flattened is active.
    -- A flattened column admits the whole in-scope subtree; an unflattened
    -- column admits only what hierarchical mode would show there.
    --
    -- This is the flatten decision alone, not the whole visibility test.
    -- The board-wide filters compose on top of it and are specified in
    -- their own sections: only_active_filter and board_search_filter.
    -- Both apply identically in either mode.
    in_scope(task, view, column):
        not task.archived
        and task.repo_path in view.active_repo_filter
        and (view.is_board or task.is_descendant_of(view.current_epic))
        and (flattens(column) or directly_under(task, view))
}

-- == Column Section Layout ==

-- Which columns have sections, and which section a card lands in. The
-- ColumnSection values themselves, including the three derived ones, are in
-- "Column Sections" above.

value ColumnSectionLayout {
    -- The columns that have sections at all. Every other column lists its
    -- cards flat: they hold sub_status = none throughout, so a header would
    -- name nothing.
    --
    -- Kept separate from FlattenedView.unflattened_statuses even though the
    -- two name complementary pairs today: one asks about epic grouping, the
    -- other about section grouping, and they answer differently the moment
    -- either set changes.
    sectioned_statuses: Set<TaskStatus> = { running, review }

    has_sections(column): column.parent_status in sectioned_statuses

    -- The section a task card sits in, or null in a column with no sections.
    -- A derived section wins over the task's own sub_status, and parked is
    -- tested first: "no PR at all" dominates any review decision recorded
    -- without one.
    section_of(task):
        if task.status = review and task.worktree != null
            and task.tmux_window = null
            and not (task.url != null and task.url.url_type = pr): parked
        else if task.tag in {pr_review, dependabot}
            and task.sub_status = changes_requested: changes_requested_by_me
        else if task.tag in {pr_review, dependabot}
            and task.sub_status = approved: approved_by_me
        else if task.sub_status = stale_shell: stale
        else if task.sub_status = none: null
        else: task.sub_status

    @guidance
        -- An epic card lands in a section too, so an epic and a task in the
        -- same state group together rather than the epic floating above every
        -- header. The mapping runs off the epic's display substatus (see
        -- epics.allium, "Epic substatus"): "N blocked" -> needs_input,
        -- active -> active, in review -> awaiting_review. An epic in a column
        -- with no sections has no section, exactly as a task there has none.
        --
        -- Sections are rendered, never stored: no task or epic row records
        -- which section its card is in, and nothing has to be written back
        -- when a card moves between sections.
}

-- == Collapsed Sections ==

-- A section can be collapsed: its header stays, its cards are hidden, and the
-- header says how many are hidden.
--
-- Intent: a section can grow without bound while the user has no intention of
-- acting on it right now — reviews awaiting a decision from someone else,
-- approvals the user already gave. An unbounded section pushes every other
-- section in the column off the bottom of the screen, so the sections the user
-- IS working on become the hardest ones to see. Collapsing is the user saying
-- "not this pile, not now", without touching a single task.
--
-- Identity: a collapse is recorded per (column, section), so the conflict
-- section in Running and the conflict section in Review collapse
-- independently. Recording it against the section's identity rather than its
-- header text means a section whose contents turn over completely stays
-- collapsed.
--
-- Rendering:
--   - A collapsed section renders its header and nothing else. The header
--     carries the number of cards it is hiding and a marker showing it is
--     folded. An expanded section's header carries neither: its cards are
--     right there to be counted, and the absence of a marker is what makes a
--     collapsed one stand out.
--   - The marker is an ellipsis, not the small triangle the board uses
--     elsewhere. That triangle already carries three unrelated meanings — the
--     focused column, the archive column, and "this epic has a plan" — and a
--     fourth would make all four ambiguous.
--   - A section header occupies two rows, not one: a blank spacer above the
--     label, which separates it from the section before it. The column's first
--     header drops the spacer, so the top of a column has no leading gap. Both
--     hold whether the section is folded or open, so folding a section changes
--     the rows its cards took and nothing else.
--   - A header holding the cursor is drawn in the cursor's near-white with a
--     neutral fill behind it — the same two neutrals the board's other cursors
--     and its select-all checkbox use, and no hue, so the cursor never
--     competes with the state colours around it. A card shows the cursor on its
--     frame; a header has no frame, and a brightness step alone on one
--     already-bold line is too small to find, so it takes both.
--   - The count is of cards the column would otherwise have rendered there —
--     what the repo filter, the only-active filter and the search query all
--     admit. A section is never described as hiding a card the user could not
--     have seen anyway.
--   - A section with no cards renders no header, collapsed or not, exactly as
--     today. Its collapse is remembered regardless, so the header comes back
--     folded when a card next lands in it.
--   - Collapsing applies wherever sections render: the main board, an epic
--     view, and a flattened column alike, all off the same recorded state.
--     In a flattened column the section's epic headers and orphan separator
--     are hidden along with its cards — they are decoration on cards that are
--     not there.
--   - The column's own header count (core.allium: "Column header bar") is
--     unchanged by folding. It answers how much work is in the column, and
--     folding is a choice about screen space rather than about the work. So a
--     folded card is still counted there, and section headers — which are not
--     cards — are not. The per-section count on a folded header is what says
--     where the uncounted-on-screen cards went.
--   - Split view changes nothing here. It draws the same four columns inside a
--     focus border, so their sections render and fold exactly as they do with
--     the pane closed.
--
-- Interaction:
--   - A collapsed section's header holds the cursor: it is the only way back
--     to a section whose cards are all hidden. An expanded section's header
--     does not, so navigation with nothing collapsed is exactly as it was.
--     A folded section and an open header are therefore two different kinds of
--     item, not one item with a flag: whether a thing can hold the cursor is a
--     property of what it is, so that every reader of a column's contents gets
--     the same answer without re-deriving it.
--   - Folding puts the cursor on the folded section's own header, and
--     unfolding puts it on that section's first card. Either way the cursor
--     stays in the section the user acted on: it never lands on a card that
--     is no longer rendered, and never slides into a neighbouring section
--     because a row index happened to stay in bounds.
--   - Under a live query there is no folded header to move to, since nothing
--     draws folded. Folding then records the fold and leaves the cursor to
--     clamp, and the header appears — with the cursor free to reach it — once
--     the query is cleared.
--   - A folded section whose last card disappears loses its header, and with
--     it the cursor's resting place. The cursor then clamps within the same
--     column, as it does for any card that leaves the board.
--   - Toggling is specified in tasks.allium: ToggleSectionCollapse.
--   - No action other than that toggle does anything with the cursor on a
--     header. There is no task and no epic under it, so move, archive,
--     select, dispatch, edit and open-url all decline rather than reaching
--     for a neighbouring card.
--   - A collapsed section's hidden cards are outside every board action that
--     works on "the column": select-all reaches the cards the column renders,
--     which does not include them. The cards are still selected if they were
--     selected before the collapse — collapsing hides cards, it does not
--     deselect them.
--   - So the focused column's header bar carries two numbers answering
--     different questions, and this is deliberate: the count includes a folded
--     section's cards, because it reports the work in the column, while the
--     select-all checkbox reads "all selected" off the rendered cards only,
--     because that is exactly the set select-all acts on. A checkbox that
--     waited on cards the user cannot see could not be satisfied without
--     unfolding first.
--
-- Search override:
--   - While a search query is active and some card the query admits falls in a
--     collapsed section, that section renders expanded. A search that hid its
--     own results would be worse than no search.
--   - The override is display-only: the recorded collapse is untouched, so
--     clearing the query folds the section again.
--
-- State model:
--   - The set of collapsed (column, section) pairs is user state and persists
--     across app restarts. "Not this pile, not now" outlives a session in a
--     way the flattened toggle does not.
--   - A recorded pair for a section that no longer exists is inert: it names
--     nothing the board renders, and it neither errors nor collapses anything
--     else.

-- One folded section, named by the column it is in and the section within it.
-- The same section name in two columns is two independent pairs.
value SectionRef {
    column: TaskStatus
    section: ColumnSection
}

-- An entity rather than a value, on the same terms as BoardSelection above:
-- the rule that folds and unfolds a section mutates it, so it has to be
-- something a rule elsewhere can be given. There is exactly one.
entity CollapsedSections {
    collapsed: Set<SectionRef>

    is_collapsed(ref): ref in collapsed

    -- What the user sees, as opposed to what is recorded: while a query is
    -- live, no section draws folded.
    --
    -- Stated that way rather than as "a folded section holding a match is
    -- forced open", which is the intent, because the two are the same rule and
    -- this one needs no per-section card count to evaluate. A section the query
    -- leaves empty renders no header at all, folded or not (see Rendering
    -- above), so overriding it is unobservable.
    renders_collapsed(ref, search_query):
        is_collapsed(ref) and search_query = ""

    -- A header holds the cursor only while it draws folded. An expanded one
    -- does not, and neither does a section that renders no header.
    header_is_selectable(ref, search_query):
        renders_collapsed(ref, search_query)

    @guidance
        -- Persisted, unlike FlattenedView.active and BoardSelection: it
        -- survives an app restart.
}

-- == Board Vertical Layout ==

-- board_vertical_layout:
--   The board frame is split top to bottom into five bands: the top
--   indicator bar, the summary row, the kanban board (columns), the input
--   panel, and the status bar.
--
--   The indicator bar, summary row and status bar are each exactly one row.
--   The kanban board and the input panel share whatever vertical space is
--   left between them, and that split is governed by the input panel's mode:
--
--   Idle: the input panel's height is zero whenever the current input mode
--   has no form to show in that panel. It draws nothing — no border, no
--   background — and the kanban board claims the full remaining height, so
--   columns run uninterrupted down to the status bar. This is the default
--   (no input mode active) but is not limited to it: a mode whose prompt
--   is shown elsewhere — a y/n confirmation in the status bar, the live
--   search bar, the help overlay, the repo-filter popup, an epic/task
--   picker overlay — is idle from the panel's perspective too, since it has
--   nothing of its own to draw there.
--
--   Active: a mode whose form the panel itself draws (new task, new epic,
--   quick dispatch, retry confirmation, and so on) reserves enough rows to
--   show that form, bordered and titled for the mode. Most such modes need
--   a fixed number of rows; a mode that lists repositories (quick dispatch,
--   or the repo-path prompt with an empty query) grows the panel to fit
--   every matching repo instead, up to the space the board can spare — the
--   kanban board never drops below a minimum height to make room for it.
--
--   Entering or leaving an input mode changes the panel's height
--   immediately; the kanban board resizes on the same frame, never leaving
--   a gap or an overlap between the two bands.

-- == Only Active Filter ==

-- only_active_filter:
--   When view.only_active is true, only tasks where tmux_window is set
--   are included in tasks_for_current_view. This filter is applied in
--   addition to the repo filter.
--   The filter is toggled via the [f] overlay's "Active sessions only"
--   row (cursor position 0, Space to toggle).
--   The filter is session-scoped and does not persist across app restarts.

-- == Repo Filter Overlay Layout ==

-- repo_filter_overlay_layout:
--   The [f] overlay is a centred popup whose content rows are, top to bottom:
--   a header block (the preset section, if any presets exist, and the "Active
--   sessions only" toggle row), the repo list, and a footer block (the
--   preset-name input row in that mode, plus the help rows — two of them in
--   browse mode, one in each of the three confirm/input modes).
--
--   Invariant: the footer is never clipped. Every row the overlay draws is
--   reserved by the height budget that sized the popup, including the
--   "↑ N more" / "↓ N more" markers that bracket a scrolling repo list. The
--   markers are content rows, not free decoration: they are paid for out of
--   the same budget as the repo rows, so a scrolling list shows fewer repos
--   rather than pushing the help rows off the bottom of the box.
--
--   Sizing the marker rows is circular — whether a marker appears depends on
--   the scroll offset, which depends on how many repos are visible, which
--   depends on how many marker rows were reserved. It is settled as a fixed
--   point over the reservation, smallest first: the overlay reserves the
--   fewest marker rows (0, then 1, then 2) whose resulting window draws no
--   more markers than were reserved. Reserving both always satisfies that, so
--   the settle terminates; preferring smaller reservations means that at
--   either end of a long list, where only one marker is drawn, the spare row
--   goes to a repo instead of staying blank.
--
--   On a board so short that the popup's chrome alone fills the content area,
--   the repo list keeps a one-row floor and the markers are dropped: the row
--   under the cursor is worth more than a count of the rows that did not fit.

-- == Board Search Filter ==

-- board_search_filter:
--   When view.search_query is non-empty, the query narrows BOTH task cards and
--   epic cards. An empty query matches everything. This filter is applied in
--   addition to the repo filter and the only-active filter (logical AND).
--
--   own_match(entity) — the shared per-entity predicate. It holds when EITHER
--   sub-predicate holds (logical OR):
--     title match: a case-insensitive forward subsequence of entity.title (every
--       query char appears in the title, in order) — the same predicate used by
--       the repo-path picker (fuzzy_matches).
--     id-prefix match: the query, after stripping one optional leading '#', is
--       non-empty and consists entirely of ASCII digits, and the decimal
--       spelling of entity.id starts with those digits. So "38" matches #38,
--       #380 and #3837 (progressive narrowing as the user types) but not
--       #1385; "#3837" matches #3837; "3a" and a bare "#" have no digit
--       payload and so fall back to title matching alone.
--
--   Tasks: a task is included in tasks_for_current_view when own_match(task)
--   holds. This applies in the board view and inside an epic view alike: an
--   epic that was surfaced by its own title still shows only those subtasks
--   that match the query, which may be none. Clearing the query is how the
--   user sees an epic's full contents.
--
--   Epics: an epic card is visible when own_match(epic) holds, OR when some
--   descendant sub-epic satisfies own_match AND is itself visible under the
--   repo and only-active filters, OR when some non-archived task in the
--   epic's subtree satisfies own_match AND is itself visible under the repo
--   and only-active filters (the same two predicates tasks_for_current_view
--   applies to a task: filter.matches on repo_path, and the only-active
--   filter). Archived tasks never keep an epic visible.
--
--   The "itself visible" clause on both the sub-epic and the task branch is
--   load-bearing: a descendant the board would hide cannot keep its ancestor's
--   card alive, because drilling into that card would be a dead end — the
--   descendant that justified the card is not there to be found. The
--   descendant clause exists at all because a hierarchical board does not
--   render epic-owned tasks on the board itself — the epic card is the only
--   path to them, so hiding the card would make a reachable match
--   unreachable; gating the descendant by the repo and only-active filters
--   keeps that reachability promise honest.
--
--   Epic ids and task ids are separate sequences, so one digit payload can match
--   both an epic card and a task card. Both are shown.
--
--   Epic-target pickers (reparent, move-task-to-epic) are NOT narrowed by the
--   search query — they carry their own input buffers. See the guidance on
--   ReparentEpic in epics.allium and MoveTaskToEpic in tasks.allium.
--
--   Lifecycle: the [/] key opens a live search bar and the board narrows as
--   the user types. [Enter] keeps the query active and closes the bar (the
--   filter persists, with a [/query] indicator shown on the board). [Esc]
--   in the bar restores the query that was active before the bar opened.
--   [Esc] on the board (bar closed) with an active query clears it.
--   The query is session-scoped and does not persist across app restarts.
--   Cursor re-clamping on query change is covered by selection_preservation.

-- == Cursor Selection Preservation ==

-- selection_preservation:
--   When the cursor has an anchor (a task or epic ID) and column items are recomputed
--   (on any status change, task movement, filter change, or data refresh), the cursor
--   position is resolved by locating the anchor item in the new item list.
--
--   If the anchor item is found: the cursor moves to the item's new column and row,
--   following the item if it changed columns.
--
--   If the anchor item is not present (deleted or moved outside board scope): the cursor
--   clamps to the nearest valid position in the current column.
--
--   When the cursor is on the select-all column header (on_select_all = true), the anchor
--   is None and the header state is preserved across refreshes.
