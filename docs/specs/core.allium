-- allium: 3
-- core.allium
--
-- Scope: Shared domain model for the dispatch system
-- Includes: External entities, enumerations, storage-boundary validation,
--           core entities, and config
-- Excludes: Rules (see tasks.allium, dispatch.allium, agent-health.allium,
--           pr-workflow.allium, split-pane.allium, mcp-task-tools.allium,
--           epics.allium, learnings.allium); the board's structural layout —
--           navigation columns, sections, flattening, the board's vertical
--           bands and the board-wide filters (see board-layout.allium); the
--           board's visual language — column identity hue, the focus channel,
--           header-bar and card chrome, the neutral ground ramp (see
--           board-visuals.allium)
--
-- Invariants: this file carries the ones that belong to an entity's own
--           fields, nested in the entity that owns them. Board-wide and
--           rendering invariants live with the specs that state them.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The git worktree and tmux window are provisioned externally.
-- The spec treats them as opaque handles.

external entity Worktree {
    path: String
    branch: String
}

-- A window NAME, and only a name: two strings are excluded because tmux does
-- not treat them as one. The empty string is tmux's "current window", and a
-- pane id ("%42") addresses a pane directly; both reach tmux as
-- already-resolved targets, bypassing name lookup entirely (see
-- dispatch.allium: TmuxWindowTargetedExactly). Every other non-empty string
-- is a name, including the board's own window and legacy names.
external entity TmuxWindow {
    name: String
}

external entity TmuxPane {
    id: String       -- tmux pane identifier (e.g., "%42")
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum TaskTag { bug | feature | chore | pr_review | research | fix | dependabot }

-- UrlType classifies the single URL attached to a Task (see TaskUrl).
-- The type is stored explicitly rather than guessed from the URL string at
-- render time. Only pr-typed urls are polled for PR merge/close (see
-- pr-workflow.allium: PollPrStatus).
enum UrlType { pr | security_alert | issue | other }

-- How one attempt to read a PR's state from GitHub ended. The two failure
-- values differ in exactly one respect that matters to the caller: whether
-- repeating the same call could ever produce a different answer. Retrying a
-- permanent failure is pure waste, and doing it on a timer is how a single
-- unreadable PR generates tens of thousands of identical log lines.
-- See pr-workflow.allium: PollPrStatus.
enum PrCheckOutcome {
    succeeded            -- GitHub answered; the PR's state and review decision are known
    failed_permanently   -- cannot succeed until something outside dispatch changes:
                         -- the repository does not resolve, credentials are bad,
                         -- authentication is required, there is no PR at that url,
                         -- or GitHub reported a state dispatch does not recognise
    failed_transiently   -- may succeed on a later attempt: connection failure,
                         -- TLS/read/dial timeout, 5xx, rate limit, stream reset
}

-- FeedRole is the routing role of an epic within a PR-review feed hierarchy.
-- `none` is the default for ordinary epics; the other roles tag a sub-epic as a
-- destination bucket for PR items routed by feed signals (see feeds.allium: Signal).
enum FeedRole { none | reviews_parent | my_reviews | team_reviews | bots | cve }

-- EpicOrigin records how an epic came into existence.
-- `manual` is the default for epics created by the user or via MCP.
-- `repo_group` is set by the system when a per-repo sub-epic is created
-- automatically by repo grouping (see epics.allium: RegroupEpic /
-- service::grouping). This field is system-assigned and is never exposed
-- to MCP callers.
enum EpicOrigin { manual | repo_group }

-- Legacy alias: "ready" maps to backlog
enum TaskStatus { backlog | running | review | done | archived }

-- SubStatus refines the parent status into a more precise state.
-- Valid combinations are constrained by SubStatus.is_valid_for(status).
-- When status changes, sub_status resets to SubStatus.default_for(new_status).
enum SubStatus {
    -- backlog / done / archived
    none

    -- running (and review where noted)
    active          -- agent is running normally
    needs_input     -- agent is blocked waiting for human interaction ("needs input" section of Running)
    stale           -- no PreToolUse hook event seen for longer than inactivity_timeout (time since last_pre_tool_use_at)
    stale_shell     -- a live backgrounded shell (Bash tool with run_in_background = true) has been
                    -- running longer than shell_stale_threshold (time since the oldest live
                    -- ShellEntry's started_at); see ClassifyAgentActivity in agent-health.allium
    crashed         -- tmux window disappeared unexpectedly
    conflict        -- rebase/merge encountered a conflict (valid for both running and review)

    -- review
    awaiting_review   -- PR created, no review decision yet
    changes_requested -- reviewer requested changes. Covers both directions:
                      -- changes requested on the user's own PR, and changes the
                      -- user requested on someone else's. The UI separates the
                      -- two — see "Derived review sections" below.
    approved          -- PR approved. Covers both directions: the user's own PR
                      -- approved and ready to merge, and a PR the user approved
                      -- on someone else's behalf. The UI separates the two —
                      -- see "Derived review sections" below.
    pr_closed         -- GitHub closed the PR without merging; task stays in review so a human can act
    pr_unreachable    -- dispatch could not read the PR at all and has stopped polling
                      -- this task: the repository does not resolve, credentials are
                      -- bad, or there is no PR at that url. Task stays in review so a
                      -- human can act. Unlike conflict, it is NOT guarded against
                      -- overwrite — any later successful poll clears it, which is the
                      -- sole recovery path (see pr-workflow.allium: PollPrStatus).
}

-- == Column Sections ==
--
-- The Running and Review columns are split into sections: their cards are
-- grouped under a header naming the section, in a fixed order, rather
-- than listed flat. Backlog and Done have no sections — every card in them
-- holds sub_status = none, so there would be nothing to group by and nothing
-- to name.
--
-- A section has an identity of its own, ColumnSection, rather than being
-- whatever the first card in the group happens to be called. Two things that
-- identity buys: a section's header label never changes as cards come and go
-- inside it, and the user's choice to collapse a section (see "Collapsed
-- Sections") survives its contents changing entirely.
--
-- ColumnSection is deliberately NOT the same set as SubStatus. Three of its
-- values are computed from the task row at render time rather than read off a
-- column of it, and one of them holds two sub_statuses at once.
--
-- "Not stored" here means no task row records which section its card is in.
-- The section *names* are a persisted vocabulary: the folded-section list
-- writes them (see "Collapsed Sections"), so renaming a value is a
-- data-compatibility change.

-- Declaration order is render order: the value declared first sits at the top
-- of its column. Sections from different columns never interleave, so the
-- relative order of a running section and a review section is unobservable.
enum ColumnSection {
    conflict                 -- "conflict"; running and review alike

    pr_closed                -- "pr closed"; review
    pr_unreachable           -- "pr unreachable"; review
    crashed                  -- "crashed"; running
    stale                    -- "stale"; running. Holds BOTH stale and
                             -- stale_shell cards: the two say "this task looks
                             -- idle" for a different structural reason, and the
                             -- user acts on either the same way.
    needs_input              -- "needs input"; running
    changes_requested        -- "changes requested"; review
    approved                 -- "approved"; review
    active                   -- "active"; running
    awaiting_review          -- "awaiting review"; review

    -- The three derived sections, all review-only and all less actionable than
    -- every section above. See "Derived review sections" below.
    parked                   -- "parked"
    changes_requested_by_me  -- "changes requested by me"
    approved_by_me           -- "approved by me"
}

-- == Derived review sections ==
--
-- Three ColumnSection values are NOT reachable from a task's own sub_status.
-- They are computed from the task row at render time, with no column of it
-- recording the result:
--
--   parked                    status = review and worktree != null and
--                             tmux_window = null and not (url != null and
--                             url.url_type = pr)
--
--                             The agent session has ended and there is no PR to
--                             review or merge. sub_status is deliberately not
--                             part of the condition: with no PR there is nothing
--                             for a review decision to be about, so this
--                             dominates any decision recorded without one.
--
--   changes_requested_by_me   sub_status = changes_requested and
--                             tag in {pr_review, dependabot}
--
--                             Those tags mean the task reviews someone else's PR
--                             rather than authoring one, so the changes were
--                             requested BY the user and the ball is with the
--                             other author.
--
--   approved_by_me            sub_status = approved and
--                             tag in {pr_review, dependabot}
--
--                             The same tags, the same direction: the user
--                             approved someone else's PR. Unlike an approval on
--                             the user's own PR there is no merge to perform, so
--                             nothing at all is waiting on the user — this is the
--                             least actionable section in the column.
--
-- All three are derived rather than stored so they self-correct: a parked task
-- leaves the parked section the moment its tmux window reappears, with nothing
-- to write back. Detach state alone does NOT create a section — a detached task
-- that has a PR renders under plain awaiting_review, because once a PR exists
-- only the review decision matters.

-- Valid SubStatus values per parent status (enforced in the DB by a CHECK
-- constraint and in-code via SubStatus.is_valid_for):
--   backlog   : none
--   running   : active | needs_input | stale | stale_shell | crashed | conflict
--   review    : awaiting_review | changes_requested | approved | conflict | pr_closed | pr_unreachable
--   done      : none
--   archived  : none
--
-- Note: HookNotification only fires when task.status = running, setting
-- sub_status = needs_input. The resulting (running, needs_input) state
-- renders under the "needs input" section header in the Running column.
-- Legacy (review, needs_input)
-- rows from older hook behaviour were normalised to (review, awaiting_review)
-- by migration v16.

-- Default sub_status when transitioning to a new status:
--   backlog   -> none
--   running   -> active
--   review    -> awaiting_review
--   done      -> none
--   archived  -> none

-- NotificationKind is the `notification_type` field on Claude Code's Notification
-- hook payload, forwarded by the task-status-hook as the `--kind` argument to
-- `dispatch hook <id> notification`. It is absent on Claude Code versions that
-- predate the field. The agent-view-only values `agent_needs_input` and
-- `agent_completed` are intentionally excluded: dispatch runs a plain `claude`
-- process in tmux, never `claude agents`, so those values never reach the hook.
-- See HookNotification in agent-health.allium for how each value is classified.
enum NotificationKind {
    permission_prompt       -- agent is blocked on a permission decision
    idle_prompt             -- agent has gone idle awaiting human input
    auth_success            -- informational (auth succeeded); not human-actionable
    elicitation_dialog      -- agent is asking a question / showing a form
    elicitation_complete    -- an elicitation just resolved
    elicitation_response    -- an elicitation response was received
}

-- LearningScope identifies what context a learning applies to.
-- Dispatch retrieval unions: user + repo:<this_repo> + epic:<this_epic> (if set).
-- task scope carries task-specific outcomes, retrieved on demand.
enum LearningScope { user | repo | epic | task }

-- LearningKind categorises what was learned. kind does not affect retrieval or
-- rendering: every retrieved entry, procedural included, goes into the single
-- RAG-ranked "Validated knowledge" block (see learnings.allium: Priority
-- Ordering). kind describes how an entry was authored and what it means.
enum LearningKind {
    pitfall              -- a failure mode; agents should avoid or handle carefully
    convention           -- preferred code pattern or style in this context
    preference           -- the user's explicit working preference
    tool_recommendation  -- recommended tool or library for a given problem
    procedural           -- a how-to-work-here procedure; injected like any other kind
    landscape            -- codebase/system overview (service maps, module responsibilities)
}

-- LearningStatus controls whether an entry is active in retrieval.
-- New entries land as approved; there is no human approval gate and no human
-- curation surface. A background job archives stale, unvalued entries (see
-- learnings.allium: ArchiveStaleLearning), which is the only status change any
-- behaviour produces. rejected is legacy: nothing produces it any more, but
-- existing rows still hold it. Entries in rejected or archived are excluded from
-- prompt injection and query_learnings results.
enum LearningStatus { approved | rejected | archived }

-- VerdictKind captures an agent's evaluation of a retrieved learning, submitted
-- via the rate_learning MCP tool at any point during a task. Both verdicts adjust
-- the learning's net score; neither changes its status.
--   helped  — the learning applied and was useful (an upvote: upvote_count + 1)
--   wrong   — the learning misled the agent or is no longer accurate
--             (a downvote: upvote_count - 1, may go negative)
enum VerdictKind { helped | wrong }

-- RetrievalSource records how a learning was surfaced to a task's agent.
--   prompt_injection — included in the single RAG-ranked "Validated knowledge"
--                      block prepended to the dispatch prompt
--   procedural       — legacy; no longer produced. Procedural learnings are now
--                      injected as part of the unified prompt_injection block
--                      (see learnings.allium). Retained for existing DB records.
--   query_learnings  — returned by an explicit query_learnings MCP call
enum RetrievalSource { prompt_injection | procedural | query_learnings }

-- WrapUpMode records the preferred wrap-up path for a task, set at creation
-- time by the user or agent. When set, the /wrap-up skill honours it instead
-- of prompting the user: the mode IS the user's answer, given earlier, so the
-- skill runs the whole wrap-up on it — through wrap_up and exit_session —
-- without asking anything and without returning to an idle prompt part-way.
-- A preset mode that only suppressed the question would be worse than no mode
-- at all: the agent would go idle with the question it was told not to ask
-- unanswered, and nothing would reach base_branch until a human noticed.
--   rebase — rebase the task branch onto base_branch and fast-forward it
--   pr     — agent authors and creates a draft PR (no git ops done by dispatch)
--   done   — close without any git operations; task moves to Done directly
enum WrapUpMode { rebase | pr | done }

------------------------------------------------------------
-- Storage Boundary Validation
------------------------------------------------------------

-- Any entity read from storage whose enum fields contain an unrecognised
-- string value must fail the read operation with an error rather than
-- silently defaulting to a fallback variant.
--
-- Rationale: silent defaults mask data-integrity bugs (corrupt migrations,
-- manual DB edits, schema drift) and produce subtly wrong in-memory state
-- that is hard to trace back to the real cause. A hard read error surfaces
-- the problem immediately. The TUI and MCP error-display paths already
-- handle DB errors gracefully, so a hard error is safe.
--
-- This applies to all enum columns: TaskStatus, SubStatus, TaskTag,
-- WrapUpMode, LearningKind, LearningScope and LearningStatus.
-- It also applies to JSON-encoded columns (e.g. labels, tags): malformed
-- JSON must return an error rather than an empty list.
--
-- Exception: FeedRole and EpicOrigin soft-fail instead. An unrecognised
-- value in either column logs a warning and defaults to FeedRole.none /
-- EpicOrigin.manual rather than failing the read.
--
-- Rationale: these two are additive, system-assigned routing/provenance
-- tags. New roles/origins are appended over time, and a newer binary may
-- write a value an older binary has never heard of. Hard-failing would
-- make an older binary reject rows it could otherwise display perfectly
-- well, so it degrades gracefully to the default tag instead. The default
-- is the safe, neutral choice in both cases: `none` (ordinary epic, no feed
-- routing) and `manual` (no special provenance). Because the value is
-- system-assigned and never user-supplied, an unknown value signals a
-- forward-compatibility gap, not the data-integrity bug the hard-fail rule
-- guards against.
--
-- Exception: tmux_window soft-fails too, for a different reason — corruption
-- tolerance, not forward compatibility. A stored value that is not a window
-- name (see TmuxWindow) logs a warning and reads back as no window at all,
-- which is exactly what a task whose agent is gone looks like, so the board
-- still renders it; failing the row would drop the card from every bulk read.
--
-- Not covered at all: the stored list of folded sub-status sections (see
-- "Collapsed Sections"). It is a settings row rather than an enum column on an
-- entity, and an unrecognised entry in it is skipped rather than failing the
-- read — a fold naming a section this binary does not know about is a display
-- preference that cannot be honoured, not a corrupt task. Read that section
-- before adding ColumnSection to the hard-fail list above.

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- TaskUrl is the single typed URL attached to a Task. The url_type is stored
-- explicitly (not inferred from the string at render time), so the system
-- knows whether the URL is a PR, security alert, issue, or something else.
value TaskUrl {
    url: String
    url_type: UrlType
}

entity Task {
    title: String
    description: String
    repo_path: String
    status: TaskStatus
    sub_status: SubStatus
    worktree: Worktree?
    tmux_window: TmuxWindow?
    plan_path: String?    -- filesystem path to the implementation plan file
    epic: Epic?
    url: TaskUrl?    -- subsumes the former pr_url: the single typed URL attached to this task
    tag: TaskTag?
    sort_order: Integer?  -- shared namespace for feed-driven and user-set ordering; lower sorts first via COALESCE(sort_order, id) ASC
    labels: List<String> = []  -- free-form badges rendered on the card's second line; set by feed scripts via FeedItem.labels or by future TUI editors.
                               -- Ordered, and the order is load-bearing: badges render in
                               -- declaration order so a feed script controls which label
                               -- appears first on the card. Duplicates are retained.
                               -- Presentation, including the three CI-status texts that
                               -- take a state colour, is "Card label badges" in
                               -- board-visuals.allium.
    base_branch: String = "main" -- the branch this task rebases onto / targets for PRs
    external_id: String?  -- stable identifier for tasks sourced from a feed epic (see feeds.allium); null for hand-created tasks. Unique per (epic, external_id) when set.
    last_pre_tool_use_at: Timestamp?  -- wallclock of the most recent PreToolUse hook; null when the agent has never tooled (or after Stop)
    last_notification_at: Timestamp?  -- wallclock of the most recent Notification hook; null when no notification is pending (or after Stop)
    live_subagents: Integer = 0  -- count of subagents currently executing for this task; a denormalised count of SubagentEntry rows, rewritten alongside every mutation and clear point (see agent-health.allium)
    live_shells: Integer = 0  -- count of currently-live backgrounded shells (Bash tool with run_in_background = true) for this task; a denormalised count of ShellEntry rows, rewritten alongside every mutation and clear point (see agent-health.allium). Unlike live_subagents, cleared at only three structural points, not four -- see ShellEntry below for why SessionStart is deliberately excluded
    oldest_live_shell_started_at: Timestamp?  -- started_at of the oldest live ShellEntry row for this task; null when live_shells = 0. Used by ClassifyAgentActivity's shell_stale_threshold check so a genuinely abandoned shell surfaces distinctly from a healthy long-running one
    stop_pending: Boolean = false  -- a Stop hook arrived while subagents were live; flip to review once they drain (see agent-health.allium: HookStop / HookSubagentStop). Cleared by any status write that leaves running — see PendingStopOnlyWhileRunning below
    stop_pending_at: Timestamp?  -- when the Stop that stop_pending defers actually fired (the hook's event time, not its write time). Meaningful only while stop_pending holds; the clear points leave it alone because every reader gates on the bit. HookUserPromptSubmit compares against it to tell a Stop deferred by an earlier turn from one deferred by the turn now starting — see its guidance. Null while the bit is set means the Stop predates the field, and reads as "fired before any prompt"
    pr_learnings_gate_shown_at: Timestamp?  -- set once when the PrLearningsGate fires; null means the gate has never fired for this task
    wrap_up_mode: WrapUpMode?  -- preferred wrap-up path; null means decide at wrap-up time
    auto_run_plan: Boolean = false  -- when true and plan_path is set, build_prompt's
                                    -- has-plan addendum skips asking the dispatched
                                    -- agent to confirm before implementing (see
                                    -- dispatch.allium's build_prompt guidance)
    phoenix: Boolean = false  -- a recurring task: entering done creates a fresh backlog
                              -- copy of it, and the flag MOVES to that copy (see
                              -- tasks.allium: PhoenixRespawn). Independent of `tag` on
                              -- purpose — a phoenix task still carries whatever kanban
                              -- label it wants, and `tag` keeps its two behavioural
                              -- readers untouched (see "Tag system" in
                              -- docs/conventions.md). Not a schedule: nothing dispatches
                              -- a phoenix task, the human does.
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        backlog -> running
        running -> review
        running -> backlog
        -- The archive key ('x') completes a task from wherever it sits, so
        -- Done is reachable directly from backlog and running, not only
        -- from review (see tasks.allium: ConfirmDone / ArchiveKeyRouting)
        backlog -> done
        running -> done
        review -> done
        review -> running
        done -> review
        done -> running
        done -> archived
        -- Archive is accepted from any non-archived status
        backlog -> archived
        running -> archived
        review -> archived
        terminal: archived
    }
    -- This graph governs the move-based status changes only (MoveTask,
    -- ConfirmDone, Archive, dispatch/PR-driven transitions). Two
    -- operator paths are intentionally exempt from it:
    --   - EditTask, the tmux task editor (see tasks.allium: EditTask) —
    --     reachable from the archive view as well as the main board. May
    --     set any TaskStatus from any other, including moving a task
    --     back out of the terminal `archived` state.
    --   - MCP `update_task` (see mcp-task-tools.allium:
    --     UpdateTaskViaMcp), the agent path. Partially restricted: it
    --     refuses `done` and `archived` as TARGET statuses, but applies
    --     no edge check at all beyond that, and does not constrain the
    --     SOURCE status. So an agent can drive `review -> backlog`,
    --     `backlog -> review` and `done -> backlog` — none declared
    --     above — and can also leave the terminal `archived` state for
    --     backlog/running/review, since only the target is checked.
    -- Both are deliberate escape hatches — manual correction for the
    -- first, re-opening or re-queueing work for the second — not
    -- edges of the lifecycle, so they are not declared above. Every
    -- other status change, whether automatic or a keyboard move, does
    -- obey the graph.

    -- Derived
    has_plan: plan_path != null
    is_stale: sub_status = stale
    is_crashed: sub_status = crashed
    is_detached: worktree != null and tmux_window = null
                 and status in {running, review}
    -- sub_status is deliberately not part of this condition, the same way it
    -- is not part of Parked's (see "Derived review sections" above): a caller
    -- that needs to treat conflict specially checks sub_status first (e.g.
    -- the card indicator, which tests conflict before is_detached).
    -- A task that looks live but was never provisioned (or lost its
    -- provisioning), so there is nothing to resume. Mutually exclusive with
    -- is_detached, which requires a worktree.
    -- Surfaced on the card by UnprovisionedIndicator in dispatch.allium.
    is_unprovisioned: worktree = null and tmux_window = null
                      and status in {running, review}
    -- pr_number is parsed from the trailing numeric segment of url.url, but
    -- only when the url is pr-typed; otherwise null. Not persisted; computed
    -- on demand.
    pr_number: if url != null and url.url_type = pr: pr_number_from_url(url.url) else: null

    -- A phoenix task sitting in done is one whose respawn did not land.
    -- PhoenixRespawn (tasks.allium) clears the flag exactly when the successor
    -- was created, so a surviving flag in done IS the failure state — there is
    -- no separate error column to keep in step with it. Surfaced on the card by
    -- "Phoenix marker" in board-visuals.allium.
    respawn_failed: phoenix and status = done

    -- live_subagents is a denormalised count of this task's SubagentEntry
    -- rows (see SubagentEntry below); every mutation and clear point
    -- rewrites both in the same write, so they cannot disagree (see
    -- agent-health.allium: HookSubagentStart / HookSubagentStop and the
    -- four clear points documented there).
    invariant LiveSubagentCountMatchesEntries {
        live_subagents = (SubagentEntries where task = this).count
    }

    -- live_shells mirrors live_subagents's invariant exactly, over ShellEntry
    -- instead of SubagentEntry. See ShellEntry below for how its clear points
    -- differ from SubagentEntry's.
    invariant LiveShellCountMatchesEntries {
        live_shells = (ShellEntries where task = this).count
    }

    -- A deferred Stop belongs to the turn the task was running when it
    -- arrived. Only HookStop sets the bit, and it requires status =
    -- running; every status write that leaves running clears it in the
    -- same write (MoveTaskForward / MoveTaskBackward / ConfirmDone /
    -- ArchiveTask in tasks.allium, UpdateTaskViaMcp in
    -- mcp-task-tools.allium, ExitSession in pr-workflow.allium, and the
    -- drain points in agent-health.allium). So the bit cannot outlive the
    -- status it was recorded under, and cannot be waiting for a task that
    -- a later move puts back into running — where the next drain would
    -- otherwise flip it straight back out of a status a human just chose.
    invariant PendingStopOnlyWhileRunning {
        stop_pending implies status = running
    }
}

-- A live subagent, as reported by the SubagentStart/SubagentStop Claude
-- Code hooks. The table is the authority for Task.live_subagents, which
-- is a denormalised count rewritten from it by every mutation and clear
-- point (see agent-health.allium). started_at is retained for diagnostics
-- only; no rule branches on it.
entity SubagentEntry {
    task: Task
    agent_id: String
    session_id: String
    started_at: Timestamp
}

-- A live backgrounded shell (Bash tool with run_in_background = true), as
-- reported by PostToolUse events for Bash/KillBash|TaskStop/BashOutput|
-- TaskOutput. The table is
-- the authority for Task.live_shells/oldest_live_shell_started_at, which are
-- denormalised and rewritten from it by every mutation and clear point (see
-- agent-health.allium: HookShellStart / HookShellStop).
--
-- Deliberately mirrors SubagentEntry's shape but NOT its full clear-point
-- set. A subagent cannot survive a session boundary (resume/clear/startup
-- all mean the prior subagent is provably dead), so SubagentEntry is cleared
-- unconditionally on every SessionStart in addition to session-fencing. A
-- backgrounded shell is an independent OS process that CAN survive a
-- `/clear` or `resume` -- clearing on every SessionStart would silently drop
-- tracking of a shell that outlived the boundary, reproducing the very bug
-- this entity exists to fix. So ShellEntry relies on session-fencing alone
-- (evicting rows whose session_id differs from an incoming shell event) plus
-- the three real structural clear points also shared with SubagentEntry:
-- DetectCrashedAgent, DetachTmux, and DispatchTask's claim paths. A task
-- whose shell never produces another hook event in a new session, and is
-- never crashed/detached/redispatched, keeps its ShellEntry rows -- see the
-- "Known limitation" accepted tradeoff in
-- docs/superpowers/specs/2026-08-15-shell-visibility-design.md.
entity ShellEntry {
    task: Task
    shell_id: String
    session_id: String
    started_at: Timestamp
}

entity Epic {
    title: String
    description: String
    status: TaskStatus
    plan_path: String?    -- filesystem path to the implementation plan file
    sort_order: Integer?
    auto_dispatch: Boolean = false
    parent: Epic?         -- null for root epics; set for nested sub-epics
    feed_command: String?           -- shell command that emits FeedItem JSON (see feeds.allium); null for non-feed epics
    feed_interval_secs: Integer?    -- per-epic poll cadence in seconds; null falls back to config.default_feed_interval
    group_by_repo: Boolean = false      -- when true, feed tasks are grouped into sub-epics by repo name (see feeds.allium)
    feed_append_only: Boolean = false   -- when true, the feed only ever adds: no stale removal, ever (see feeds.allium: AppendOnlyFeed)
    feed_role: FeedRole = none      -- routing role within a feed hierarchy; `none` for ordinary epics (see feeds.allium: Signal)
    origin: EpicOrigin = manual    -- system-assigned; never settable via MCP
    created_at: Timestamp
    updated_at: Timestamp

    has_plan: plan_path != null
    is_root: parent = null
    is_feed: feed_command != null

    -- DB-level invariant: at most one epic per (parent, feed_role) when
    -- feed_role != none. Ordinary epics (feed_role = none) are exempt — any
    -- number may share a parent. Enforced in the DB by a partial unique index
    -- on (parent_id, feed_role) WHERE feed_role != 'none', indexed as
    -- COALESCE(parent_id, -1) rather than raw parent_id (migration v93).
    --
    -- v65 built the index on raw parent_id and it never actually protected
    -- root-level epics (reviews_parent, cve): SQLite treats every NULL in a
    -- unique index as distinct from every other NULL, so two root epics with
    -- the same feed_role and parent_id = null did not collide. v93 rebuilds
    -- the index over COALESCE(parent_id, -1) so root epics collide too; -1 is
    -- never a real epic id. A database that already held duplicate root-level
    -- managed epics before v93 ran keeps them and runs without this index
    -- (see ProvisionManagedEpics' race-safety note in epics.allium) — v93
    -- warns rather than deleting or merging data it did not create.
    invariant UniqueFeedRolePerParent {
        for a in Epics:
            for b in Epics:
                a != b and a.feed_role != none and a.parent = b.parent
                    implies (a.feed_role != b.feed_role or b.feed_role = none)
    }

    -- DB-level invariant: at most one sub-epic per (parent, title) when
    -- origin = repo_group. Enforced by a partial unique index on
    -- (parent_id, title) WHERE origin = 'repo-group'. Ordinary epics
    -- (origin = manual) are exempt — any number may share a title.
    invariant UniqueRepoGroupPerParent {
        for a in Epics:
            for b in Epics:
                a != b and a.origin = repo_group and a.parent = b.parent and a.title = b.title
                    implies b.origin != repo_group
    }

    subtasks: Task with epic = this
    active_subtasks: subtasks where status != archived
    subtask_statuses: active_subtasks -> status

    sub_epics: Epic with parent = this
    active_sub_epics: sub_epics where status != archived

    -- Heterogeneous set used for status recalculation and dispatch ordering.
    -- Combines active tasks and active sub-epics; each element contributes
    -- its .status value to the parent's recalculated status.
    active_children: active_subtasks + active_sub_epics
}

entity SavedRepoPath {
    path: String             -- filesystem path, unique across all saved paths
    last_used: Timestamp     -- updated on each use; drives recency ordering
    verify_command: String?  -- single-line shell command run by agents before declaring work complete, e.g. "cargo test"

    invariant VerifyCommandSingleLine {
        verify_command = null or not (verify_command.contains("\n") or verify_command.contains("\r"))  -- short-circuits: rhs only evaluated when verify_command != null
    }
}

-- SavedRepoBranch records a base_branch that was used for a given repo_path,
-- forming a per-repo most-recently-used history that feeds the base-branch
-- fuzzy picker during manual task creation (see dispatch.allium:
-- RecordBaseBranch, BaseBranchPicker). This is a dedicated settings-style
-- table (repo_base_branches), a sibling of SavedRepoPath's repo_paths table —
-- and, like the per-repo verify_command setting, a per-repo setting keyed by
-- repo_path.
--
-- It is deliberately NOT derived from Task.base_branch, so that:
--   (a) only branches entered through the manual new-task form are
--       remembered — quick-dispatch and MCP-created branches are excluded
--       (see the recording-scope decision in dispatch.allium: RecordBaseBranch);
--   (b) a remembered branch does not vanish when the task that used it is
--       later deleted.
--
-- Identity is the (repo_path, branch) pair: at most one row per branch per
-- repo. Recency ordering (most-recent-first) and the per-repo cap are
-- governed by the write operation (see dispatch.allium: RecordBaseBranch and
-- the BranchHistoryCapped invariant).
entity SavedRepoBranch {
    repo_path: String        -- the repo this branch history belongs to
    branch: String           -- a base_branch value used for repo_path
    last_used: Timestamp     -- updated on each use; drives recency ordering

    invariant UniqueBranchPerRepo {
        for a in SavedRepoBranches:
            for b in SavedRepoBranches:
                a != b implies (a.repo_path != b.repo_path or a.branch != b.branch)
    }
}

-- Learning captures knowledge a dispatched agent discovered. Entries land as
-- approved immediately (no human approval gate) and are injected into future
-- dispatch prompts for the matching scope. The active pool is curated entirely
-- without a human in the loop, and there is no human-facing surface for it at
-- all: agents up/downvote via rate_learning, delete entries outright via
-- delete_learning, and a background job archives stale entries with a
-- non-positive score (see learnings.allium: ArchiveStaleLearning).
entity Learning {
    kind: LearningKind
    summary: String          -- one-sentence digest; injected into dispatch prompts
    detail: String?          -- extended context; returned by query_learnings
    scope: LearningScope
    scope_ref: String?       -- qualifies the scope:
                             --   scope=repo    → repo_path of the target repository
                             --   scope=epic    → string form of epic_id
                             --   scope=task    → string form of task_id
                             --   scope=user    → null (no qualifier needed)
    tags: Set<String>        -- free-form labels for filtering (e.g. "rust", "testing")
    status: LearningStatus
    source_task: Task?       -- the task whose agent proposed this entry; null for human-authored entries
    upvote_count: Integer -- net score: +1 per `helped` verdict, -1 per `wrong`
                          -- verdict. May be negative. Feeds retrieval ranking and
                          -- the stale-cleanup eligibility check (upvote_count <= 0).
    last_upvoted_at: Timestamp?
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        approved -> archived     -- system-driven, and the only transition any
                                 -- behaviour produces: the stale-cleanup job
                                 -- archives an approved entry with
                                 -- upvote_count <= 0 untouched for the configured
                                 -- threshold (ArchiveStaleLearning)
        terminal: rejected, archived
    }
    -- rejected is terminal but has no inbound edge: it was only ever produced by
    -- the human reject action on the (now removed) TUI knowledge-base overlay.
    -- The value is retained because existing rows still hold it and must stay
    -- parseable; like archived, those rows are excluded from retrieval.

    -- Derived
    is_active: status = approved

    -- True when this learning is relevant to the given task's dispatch.
    -- task-scoped learnings are excluded from auto-injection; they surface
    -- via query_learnings on demand (see learnings.allium).
    applies_to_dispatch(task):
        status = approved
        and (
            scope = user
            or (scope = repo and scope_ref = task.repo_path)
            or (scope = epic and task.epic != null and scope_ref = str(task.epic.id))
        )

    invariant ScopeRefConsistency {
        (scope = user implies scope_ref = null)
        and (scope != user implies scope_ref != null)
    }
}

-- Retrieval records a single occasion on which a Learning was surfaced for a
-- task. One row is inserted per surfacing event, so repeated exposure
-- accumulates as separate rows. Used to drive rate_learning verdict validation
-- (a verdict's learning_id must have a matching retrieval row for the same
-- task) and to support telemetry on which entries actually fire.
entity Retrieval {
    task: Task
    learning: Learning
    source: RetrievalSource
    retrieved_at: Timestamp
}

-- See docs/specs/todo.allium for the Todo entity specification.

-- A rate_learning call evaluates a retrieved learning. The verdict is no
-- longer persisted (migration v74 dropped the learning_verdicts table); the
-- VerdictKind enum still describes the in-flight effects applied on receipt:
--   helped → increments learning.upvote_count and updates last_upvoted_at
--   wrong  → decrements learning.upvote_count (a downvote; may go negative);
--            no status change
-- See learnings.allium for the rule that applies these effects.

-- BoardSelection is a runtime-only UI concept (not persisted): the set of
-- tasks and epics the user has multi-selected. It is modelled here, on the
-- same terms as SplitPane below, because the batch rules in tasks.allium
-- and epics.allium all consume it.
--
-- There is exactly one BoardSelection. It is board-wide, not per-column:
-- selecting items in one column and then another leaves both sets
-- selected, and the selection outlives moving the cursor between columns.
--
-- The action that fills it, and the two independent things called
-- "select all", are specified in tasks.allium ("Multi-Selection").

entity BoardSelection {
    selected_tasks: Set<Task>
    selected_epics: Set<Epic>

    is_empty: selected_tasks.count = 0 and selected_epics.count = 0

    @guidance
        -- Session-scoped and never persisted: it does not survive an app
        -- restart, and nothing in the database records it.
        -- A card in either set renders with a leading `*` and a bold title
        -- (board-visuals.allium: "Selection").
}

-- SplitPane is a runtime-only UI concept (not persisted) that tracks
-- whether the TUI is displaying a task's tmux window as a side pane.
-- It is modelled here because task lifecycle events (finish, PR creation)
-- must coordinate with split pane state.

entity SplitPane {
    active: Boolean = false
    focused: Boolean = true
    pane: TmuxPane?
    pinned_task: Task?

    -- Whether a swap has been started and has not yet settled. A swap is not
    -- instantaneous: it rearranges live tmux panes and windows, and both
    -- pinned_task and pane only take their new values once that has finished
    -- (see SwapSplitPane and SplitPaneSwapSettles in split-pane.allium).
    -- Until then this entity still describes the PREVIOUS occupant, so a
    -- second swap started against it would act on the wrong pane and the
    -- wrong task.
    swap_in_flight: Boolean = false

    -- The swap requested while another was still in flight, held until it
    -- settles. At most one is held: a further request replaces it rather than
    -- queueing behind it, because each is the same instruction — "show me this
    -- task" — and only the newest one still reflects what the user wants.
    pending_swap: Task?

    -- Whether split-mode entry has been started and has not yet settled.
    -- Entry is not instantaneous either: it rearranges live tmux panes, and
    -- active, pane and pinned_task only take their new values once that has
    -- finished (see ToggleSplitMode and SplitPaneEntrySettles in
    -- split-pane.allium). Until then this entity still describes the state
    -- BEFORE the entry, so a second entry started against it would open a
    -- second pane the board cannot track.
    entry_in_flight: Boolean = false

    -- Whether a toggle press arrived while entry was in flight, held until
    -- the entry settles. A flag rather than a count: a further press replaces
    -- the held one instead of accumulating, so any burst of presses during one
    -- entry settles as a single held toggle.
    pending_toggle: Boolean = false

    -- Whether a confirmed quit arrived while entry was in flight, held until
    -- the entry settles. Quitting with a task pinned restores that agent to a
    -- standalone window, and there is nothing to restore from until the entry
    -- that joined it has finished.
    pending_quit: Boolean = false

    @guidance
        -- At most one task can be pinned at a time.
        -- When active is true, pane must be non-null.
        -- pinned_task may be null (empty shell in the pane).
        -- focused tracks whether the TUI pane has tmux focus.
        -- Driven by crossterm FocusGained/FocusLost events
        -- (requires tmux `focus-events on`). Defaults to true.
        -- Reset to true on split entry and exit.
        --
        -- swap_in_flight and pending_swap reset with the rest of this entity
        -- when split mode ends.
        --
        -- entry_in_flight is the one field that is set while active is false:
        -- it marks the gap between asking for a pane and having one. It must
        -- be cleared whether the entry succeeded or failed, or [s] would stop
        -- working for the rest of the session.
}

-- Per-task PR-poll bookkeeping: how many times in a row reading this task's PR
-- failed permanently, when the next attempt is allowed, and whether polling has
-- given up altogether.
--
-- Runtime-only and never persisted, like BoardSelection and SplitPane above. It
-- is modelled rather than left as an implementation detail because giving up is
-- a state change the user sees, so it must be expressible.
entity PrPollState {
    task: Task
    consecutive_permanent_failures: Integer = 0
    -- Counted separately from the permanent failures above, which is the whole
    -- mechanism keeping a GitHub outage from stranding the board: this one
    -- widens the backoff, and only the other one can reach the give-up
    -- threshold.
    consecutive_transient_failures: Integer = 0
    next_poll_at: Timestamp?

    -- Derived, not stored: a field that merely mirrors the counter it is
    -- computed from can only drift from it or duplicate it. Also means
    -- "reset the counter to 0" and "clear gave_up" cannot fall out of step —
    -- there is only one write to make.
    gave_up: consecutive_permanent_failures >= core/config.pr_poll_permanent_failure_threshold

    @guidance
        -- Conceptually one exists per polled task; the fields' defaults are the
        -- state of a task that has never failed, so a task with no row yet reads
        -- as zero failures, no backoff and not given up.
        --
        -- gave_up is the in-memory gate that stops polling. Task.sub_status =
        -- pr_unreachable is its persisted, user-visible shadow: the two change
        -- together, but only sub_status survives a restart.
        --
        -- Because this state is session-scoped, an app restart polls a
        -- pr_unreachable task once more. That is deliberate, not an oversight.
        -- The failure it exists for — a repository the gh account cannot read —
        -- is fixed on GitHub, not on the task, so there is nothing the user
        -- could edit to earn a retry. A restart is the retry.
        --
        -- next_poll_at carries the transient backoff. Null means "eligible on
        -- the next tick that clears pr_poll_interval", the unthrottled default.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    tick_interval: Duration = 2.seconds
    gg_chord_timeout: Duration = 150.milliseconds   -- window for completing the vim-style `gg` chord (see board-layout.allium, "Board Columns", row navigation)
    inactivity_timeout: Duration = 10.minutes
    status_message_expiry: Duration = 5.seconds
    -- How long a delivered message's flash stays on the target task's card.
    -- Long enough that a human whose attention is elsewhere still catches it;
    -- a few seconds does not clear that bar. This is the single source of the
    -- duration: both the expiry sweep that clears the tracking state and the
    -- render check that decides whether to draw the flash read it, so they
    -- cannot disagree. See "Message flash" in the Column Identity and Focus
    -- section for the appearance, and mcp-task-tools.allium (SendMessageToTask)
    -- for what triggers it.
    message_flash_ttl: Duration = 30.seconds
    notifications_enabled: Boolean = false
    pr_poll_interval: Duration = 30.seconds
    -- Ceiling on the transient-failure backoff. A PR whose reads keep failing
    -- for a retryable reason is polled at a widening interval up to this cap,
    -- rather than every pr_poll_interval forever.
    pr_poll_backoff_max: Duration = 30.minutes
    -- Consecutive permanent failures before polling gives up on a task and
    -- marks it pr_unreachable. Above one so that a GitHub incident briefly
    -- reporting a real repository as unresolvable does not strand a task.
    pr_poll_permanent_failure_threshold: Integer = 3
    budget_poll_interval: Duration = 10.seconds
    budget_stale_after: Duration = 10.minutes
    -- The floor under every feed cadence, however it is spelled and whoever
    -- writes it. A feed command is a shell command dispatch spawns on a timer;
    -- a cadence below this turns that into a busy loop against the user's own
    -- machine, which is never what anyone asked for. Enforced in the epic
    -- service so every write path inherits it -- see "Interval literals" below
    -- for why it lives there and not in the string grammar.
    min_feed_interval: Duration = 60.seconds
    -- Cadence for a feed epic with no explicit feed_interval_secs (see
    -- feeds.allium). Equal to min_feed_interval today, and MUST NOT fall below
    -- it: an unset field that polled faster than the fastest value a user is
    -- permitted to enter would make the floor a lie.
    default_feed_interval: Duration = 60.seconds
    -- Upper bound on ONE feed command's execution. The per-epic feed-cycle
    -- claim (feeds.allium: SerialisedFeedCycle) spans the whole exec, so
    -- without this bound a command that never exits would hold its epic's
    -- claim for the life of the process. A command still running at this
    -- deadline is killed and reaped instead, and the cycle fails
    -- (feeds.allium: FeedCommandFailure bucket 7).
    feed_command_timeout: Duration = 120.seconds
    mcp_port: Integer = 3142                         -- MCP server port (override via DISPATCH_PORT env var)
    -- Fallback when the repo has no origin/HEAD symbolic-ref.
    -- Runtime code inspects `git symbolic-ref refs/remotes/origin/HEAD`
    -- first and only falls back to this literal when detection fails.
    default_branch: String = "main"

    -- Editor of last resort, when the environment names none. Not a
    -- user-facing setting: the editor is chosen by the environment, and this
    -- constant only gives the fallback a name.
    --
    -- == Which editor (one rule, every surface) ==
    -- Whatever the environment names: VISUAL, else EDITOR, else this fallback.
    -- A value naming no editor at all — absent, empty, or only whitespace — is
    -- treated as unset, because `export EDITOR=` is how a shell spells "none".
    -- The value is split on whitespace into argv and executed directly with no
    -- shell, so a value carrying flags (`EDITOR="vim -p"`) works and nothing
    -- in it is expanded, globbed or word-split by a shell.
    --
    -- This governs EVERY surface that launches the user's editor: the pop-out
    -- task and epic editors (tasks.allium: EditTask, epics.allium: EditEpic).
    -- One user setting must not mean two things in one application.
    --
    -- The agent-tree companion pane used to be a third such surface, opening
    -- the selected file in an editor pane beside itself. It no longer launches
    -- an editor at all: the same keys now open the file's DIFF, which the pane
    -- renders itself from git (agent-tree.allium: OpenAgentTreeFileDiff). So
    -- nothing under agent-tree.allium reads this setting any more.
    editor_fallback: String = "vi"

    -- Staleness thresholds used by card age rendering and Staleness::from_age.
    fresh_threshold: Duration = 3.days
    aging_threshold: Duration = 7.days
    weeks_threshold: Duration = 14.days

    -- When true, the MCP update_task response carries a nudge asking the agent
    -- to call record_learning if it discovered anything non-obvious — but only
    -- when that single update_task call performs "PR finalisation": it sets
    -- status = review AND a pr-typed url, on a task that had no url before the
    -- call. Prompt encouragement only: the nudge is appended to the response
    -- text and never gates the update itself. No other tool reads this flag —
    -- in particular the wrap_up response does not (its rate_learning nudge is
    -- unconditional; see learnings.allium: WrapUpRateLearningNudge).
    -- (see mcp-task-tools.allium: PrFinalisationReflectionNudge)
    learning_reflection_enabled: Boolean = true

    -- Stale-learning cleanup: when enabled, a background job archives approved
    -- learnings whose net score is non-positive (upvote_count <= 0) and that have
    -- not been touched (updated_at) within stale_learning_threshold. Keeps the
    -- active retrieval pool free of unvalidated clutter with no human in the loop.
    -- (see learnings.allium: ArchiveStaleLearning)
    stale_learning_cleanup_enabled: Boolean = true
    stale_learning_threshold: Duration = 90.days
}

------------------------------------------------------------
-- Interval literals
------------------------------------------------------------

-- == How a human types an interval ==
--
-- Every user-facing surface that accepts a poll cadence takes the SAME literal
-- grammar, so "10m" means the same thing wherever it is typed. One grammar,
-- stated once here, because two spellings of ten minutes in one application is
-- a bug waiting to be filed. Only one surface is bound by it today; the
-- grammar is stated centrally so a second one cannot invent its own.
--
-- Grammar (case-insensitive, surrounding whitespace ignored):
--
--   <digits>          -- bare seconds:  "600"  -> 600
--   <digits>s         -- seconds:       "600s" -> 600
--   <digits>m         -- minutes:       "10m"  -> 600
--   <digits>h         -- hours:         "2h"   -> 7200
--   <digits>d         -- days:          "1d"   -> 86400
--
-- Accepted only if the digits parse AND the resulting seconds count is
-- STRICTLY POSITIVE. Everything else is a parse failure: a bare suffix ("m"),
-- a negative ("-5"), zero in any unit ("0", "0m"), a fractional value
-- ("1.5h"), a compound ("1h30m"), or any other text. Zero is rejected rather
-- than treated as "off" because every surface already spells "off" as the
-- empty value, and a zero-second cadence would busy-loop the feed runner.
--
-- A bare integer is seconds, and NOT because seconds are the friendly unit —
-- because that is what the stored column holds (Epic.feed_interval_secs) and
-- what the pre-suffix surface already accepted.
-- Keeping the bare form meaning seconds is what makes suffix support purely
-- additive: no value a user typed before changes meaning.
--
-- Surfaces bound by this grammar:
--   - epics.allium: EditEpic's FEED_INTERVAL_SECS section
--
-- NOT bound by it: the MCP/CLI surfaces, which take a JSON integer of seconds
-- and never a string. The grammar is for humans typing into a field. Those
-- surfaces ARE bound by the floor below -- being exempt from the spelling rule
-- is not being exempt from the domain invariant.
--
-- == Two separate claims: spelling and floor ==
--
-- The grammar above and the floor below are DIFFERENT rules with different
-- scopes, and conflating them is what left a gap here for as long as it did.
--
-- CLAIM 1 -- the grammar is human-surface-only, and it only parses. Its job is
-- to turn a typed string into a seconds count, and its strict positivity is a
-- spelling rule: "0" and "-5" are not cadences a person means to type. It binds
-- exactly the surfaces listed above, and nothing else. It does NOT know about
-- config.min_feed_interval, so "10s" parses successfully and is then refused
-- downstream. That is deliberate: a grammar that also enforced the domain floor
-- would be a second place the floor could drift out of step.
--
-- CLAIM 2 -- the floor is universal. No stored feed cadence may be below
-- config.min_feed_interval, whatever surface wrote it and however it was
-- spelled. This is a domain invariant of the field, not a property of any one
-- entry point, so it is enforced ONCE in the epic service (epics.allium:
-- CreateEpic, UpdateEpic, SetManagedFeedConfig) where every write path
-- inherits it. A value that reaches the poll loop below the floor anyway -- a
-- hand-edited row, a writer that bypassed the service -- is refused at read
-- rather than clamped: feeds.allium's FeedTick skips that epic and warns, on
-- the grounds that a misconfigured feed should not run at all.
--
-- Rows that predate the floor were brought into line once, by migration v91:
-- every stored cadence below min_feed_interval was CLAMPED UP to it, both on
-- epics.feed_interval_secs and on the two managed-feed settings rows
-- (reviews_feed_interval_secs, cve_feed_interval_secs). Clamped rather than
-- nulled so the value stays explicit -- a later change to
-- default_feed_interval must not silently retarget an epic whose cadence
-- somebody once chose. This is a one-time data fix, not a second enforcement
-- point: it does not relieve any write path of validating.
--
-- The floor exists because a feed command is a shell command on a timer.
-- Below the floor the poll loop spawns it faster than a person could plausibly
-- want, which is a busy loop against the user's own machine; and a negative
-- value, before this rule existed, read as an effectively infinite interval
-- and silenced the feed with no trace. Neither failure announced itself.
--
-- == How an interval is displayed back ==
--
-- Stored values are seconds, and the editor section WRITES seconds back
-- (unsuffixed), so an editor round-trip is lossless and unambiguous even
-- though "10m" was accepted on the way in. No surface renders a humanised
-- cadence today; if one is added, it should show the largest whole unit that
-- divides the value exactly, else seconds ("600" -> "10m", "650" -> "650s").
