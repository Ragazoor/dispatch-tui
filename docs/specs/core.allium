-- allium: 3
-- core.allium
--
-- Scope: Shared domain model for the dispatch system
-- Includes: External entities, enumerations, the shared entities, config,
--           interval literals, storage-boundary validation, the invariants
--           over the shared collections, the actors every spec faces, and
--           the board clock
-- Excludes: Rules: each domain spec owns its own (`ls docs/specs/`).
--           Runtime UI state, which lives with the one spec that reads and
--           writes it: BoardSelection (tasks.allium), SplitPane and
--           Rearrangement (split-pane.allium), PrPollState
--           (pr-workflow.allium). The board's structural layout —
--           navigation columns, sections, flattening, the board's vertical
--           bands and the board-wide filters (board-layout.allium). The
--           board's visual language — column identity hue, the focus
--           channel, header-bar and card chrome, the neutral ground ramp
--           (board-visuals.allium).
--
-- Invariants: one about a row's own fields sits in its entity; one over a
--           whole collection (uniqueness, agreement between rows) sits in the
--           Invariants section. Board-wide and rendering invariants live with
--           the specs that state them.
--
-- Derived values: a derived value is declared here when some spec reads it or
--           when it carries a rule of its own (Task.pr_number). A one-line
--           test of a single field (`sub_status = stale`) is written inline
--           by its reader, not named here.
--
-- Expected checker warnings: most fields here are read only by other specs,
--           and `allium check` does not credit a field read from another
--           file, so those fields report `field.unused`. Each external entity
--           reports `externalEntity.missingSourceHint`: it is governed by a
--           system outside the specs, named in its comment, which no `use`
--           can point at.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The git worktree and tmux window are provisioned externally.
-- The spec treats them as opaque handles.

-- Governed by git. The host that dispatches a task creates it
-- (dispatch.allium: DispatchTask).
external entity Worktree {
    path: String
    branch: String
}

-- A window NAME, and only a name: two strings are excluded because tmux does
-- not treat them as one. The empty string is tmux's "current window", and a
-- pane id ("%42") addresses a pane directly; both reach tmux as
-- already-resolved targets, bypassing name lookup entirely (see
-- dispatch.allium: TmuxWindowTargetedExactly). Every other non-empty string
-- is a name, including the board's own window and legacy names.
-- Governed by tmux.
external entity TmuxWindow {
    name: String
}

-- Governed by tmux.
external entity TmuxPane {
    id: String       -- tmux pane identifier (e.g., "%42")
}

-- UserIdentity is the PERSON, as distinct from the machine. Governed by the
-- shared store, which mints it on first connection (sync.allium); opaque to
-- dispatch, which is why it is external: nothing here generates it,
-- validates its shape, or can recover it if it is lost.
--
-- It is NOT Host by another name: a laptop and a desktop are two Hosts under
-- one UserIdentity (Host.owner). The two answer different questions:
--
--   Host         -- "which disk holds this worktree?"  (Task.host)
--   UserIdentity -- "whose board does this task sit on?"  (Task.owner)
--
-- Why the two lifetimes differ is host.allium's header.
external entity UserIdentity {
    id: String       -- opaque and generated by the store; stable across machines, restarts and renames
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- TaskUrl is the single typed URL attached to a Task. The url_type is stored
-- explicitly (not inferred from the string at render time), so the system
-- knows whether the URL is a PR, security alert, issue, or something else.
value TaskUrl {
    url: String
    url_type: UrlType
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- TaskTag selects the dispatch prompt and marks review work. Each literal is
-- stored and sent on the wire in kebab case (pr_review -> "pr-review",
-- release_please -> "release-please") and rendered on the card by a short
-- label: bug "bug", feature "feat", chore "chore", pr_review "pr-rev",
-- research "research", fix "fix", dependabot "dep", release_please "rel".
--
-- THE REVIEW SET is {pr_review, dependabot, release_please}, read through
-- Task.is_review_tagged (the code's TaskTag::is_review).
-- A review tag means the task reviews a PR someone else authored: it routes
-- to a review runbook (dispatch-prompt.allium), bases its worktree on the
-- PR's head branch (dispatch.allium), is never wrapped up
-- (mcp-task-tools.allium: ReviewTasksAreNotWrappedUp), sorts a review
-- decision into the by-me sections (board-layout.allium: section_of), and,
-- on a feed item, must name a PR (feeds.allium:
-- AReviewTaggedFeedItemNamesItsPr). Every reader of the set reads all of
-- those meanings at once, so a tag joins it only when all of them are true.
--
-- release_please is a release PR opened by a configured release bot
-- (feed-scripts.allium: FetchReviews.TagFromAuthorConfig). Its agent reads
-- the changelog, checks CI, merges only on a green CI and never authors the
-- PR (dispatch-prompt.allium: RenderReleasePrRunbook).
enum TaskTag { bug | feature | chore | pr_review | research | fix | dependabot | release_please }

-- UrlType classifies the single URL attached to a Task (see TaskUrl).
-- The type is stored explicitly rather than guessed from the URL string at
-- render time. Only pr-typed urls are polled for PR merge/close (see
-- pr-workflow.allium: PollPrStatus).
enum UrlType { pr | security_alert | issue | other }

-- How one attempt to read a PR's state from GitHub ended. The two failure
-- values differ in exactly one respect that matters to the caller: whether
-- repeating the same call could ever produce a different answer. Retrying a
-- permanent failure is pure waste, and doing it on a timer is how a single
-- unreadable PR generates tens of thousands of identical log lines.
-- See pr-workflow.allium: PollPrStatus.
enum PrCheckOutcome {
    succeeded            -- GitHub answered; the PR's state and review decision are known
    failed_permanently   -- cannot succeed until something outside dispatch changes:
                         -- the repository does not resolve, credentials are bad,
                         -- authentication is required, there is no PR at that url,
                         -- or GitHub reported a state dispatch does not recognise
    failed_transiently   -- may succeed on a later attempt: connection failure,
                         -- TLS/read/dial timeout, 5xx, rate limit, stream reset
}

-- FeedRole is the routing role of an epic within a PR-review feed hierarchy.
-- `none` is the default for ordinary epics; the other roles tag a sub-epic as a
-- destination bucket for PR items routed by feed signals (see feeds.allium: Signal).
enum FeedRole { none | reviews_parent | my_reviews | team_reviews | bots | cve }

-- EpicOrigin records how an epic came into existence.
-- `manual` is the default for epics created by the user or via MCP.
-- `repo_group` is set by the system when a per-repo sub-epic is created
-- automatically by repo grouping (see epics.allium: RegroupEpic /
-- the store's grouping reducers). This field is system-assigned and is never exposed
-- to MCP callers. A repo_group epic is always public, and no patch changes
-- an origin to or from repo_group (workspaces.allium: RepoGroupsStayPublic).
enum EpicOrigin { manual | repo_group }

-- A stored or typed "ready" reads as backlog.
enum TaskStatus { backlog | running | review | done }

-- SubStatus refines the parent status into a more precise state. The valid
-- pairs are Task's SubStatusFitsStatus invariant. A status write that names no
-- sub_status resets it to default_sub_status(new_status), whose table is the
-- DefaultSubStatusPerStatus invariant.
enum SubStatus {
    -- backlog / done
    none

    -- running (and review where noted)
    active          -- agent is running normally
    needs_input     -- agent is blocked waiting for human interaction ("needs input" section of Running)
    stale           -- no PreToolUse hook event seen for longer than inactivity_timeout (time since last_pre_tool_use_at)
    crashed         -- tmux window disappeared unexpectedly
    conflict        -- rebase/merge encountered a conflict (valid for both running and review)

    -- review
    awaiting_review   -- PR created, no review decision yet
    changes_requested -- reviewer requested changes. Covers both directions:
                      -- changes requested on the user's own PR, and changes the
                      -- user requested on someone else's. The UI separates the
                      -- two — see "Derived review sections" below.
    approved          -- PR approved. Covers both directions: the user's own PR
                      -- approved and ready to merge, and a PR the user approved
                      -- on someone else's behalf. The UI separates the two —
                      -- see "Derived review sections" below.
    pr_closed         -- GitHub closed the PR without merging; task stays in review so a human can act
    pr_unreachable    -- dispatch could not read the PR at all and has stopped polling
                      -- this task: the repository does not resolve, credentials are
                      -- bad, or there is no PR at that url. Task stays in review so a
                      -- human can act. Unlike conflict, it is NOT guarded against
                      -- overwrite — any later successful poll clears it, which is the
                      -- sole recovery path (see pr-workflow.allium: PollPrStatus).
}

-- == Column Sections ==
--
-- The Running and Review columns are split into sections: their cards are
-- grouped under a header naming the section, in a fixed order, rather
-- than listed flat. Backlog and Done have no sections — every card in them
-- holds sub_status = none, so there would be nothing to group by and nothing
-- to name.
--
-- A section has an identity of its own, ColumnSection, rather than being
-- whatever the first card in the group happens to be called. Two things that
-- identity buys: a section's header label never changes as cards come and go
-- inside it, and the user's choice to collapse a section (board-layout.allium:
-- "Collapsed Sections") survives its contents changing entirely.
--
-- ColumnSection is deliberately NOT the same set as SubStatus. Three of its
-- values are computed from the task row at render time rather than read off a
-- column of it, and one of them holds two sub_statuses at once.
--
-- "Not stored" here means no task row records which section its card is in.
-- The section *names* are a persisted vocabulary: the folded-section list
-- writes them (board-layout.allium: "Collapsed Sections"), so renaming a value is a
-- data-compatibility change.

-- Declaration order is render order: the value declared first sits at the top
-- of its column. Sections from different columns never interleave, so the
-- relative order of a running section and a review section is unobservable.
enum ColumnSection {
    conflict                 -- "conflict"; running and review alike

    pr_closed                -- "pr closed"; review
    pr_unreachable           -- "pr unreachable"; review
    crashed                  -- "crashed"; running
    stale                    -- "stale"; running
    needs_input              -- "needs input"; running
    changes_requested        -- "changes requested"; review
    approved                 -- "approved"; review
    active                   -- "active"; running
    awaiting_review          -- "awaiting review"; review

    -- The three derived sections, all review-only and all less actionable than
    -- every section above. See "Derived review sections" below.
    parked                   -- "parked"
    changes_requested_by_me  -- "changes requested by me"
    approved_by_me           -- "approved by me"
}

-- == Derived review sections ==
--
-- Three ColumnSection values are NOT reachable from a task's own sub_status.
-- They are computed from the task row at render time, with no column of it
-- recording the result:
--
--   parked                    status = review and worktree != null and
--                             tmux_window = null and not (url != null and
--                             url.url_type = pr)
--
--                             The agent session has ended and there is no PR to
--                             review or merge. sub_status is deliberately not
--                             part of the condition: with no PR there is nothing
--                             for a review decision to be about, so this
--                             dominates any decision recorded without one.
--
--   changes_requested_by_me   sub_status = changes_requested and
--                             is_review_tagged
--
--                             Those tags mean the task reviews someone else's PR
--                             rather than authoring one, so the changes were
--                             requested BY the user and the ball is with the
--                             other author.
--
--   approved_by_me            sub_status = approved and is_review_tagged
--
--                             The same tags, the same direction: the user
--                             approved someone else's PR. Unlike an approval on
--                             the user's own PR there is no merge to perform, so
--                             nothing at all is waiting on the user — this is the
--                             least actionable section in the column.
--
-- All three are derived rather than stored so they self-correct: a parked task
-- leaves the parked section the moment its tmux window reappears, with nothing
-- to write back. Detach state alone does NOT create a section — a detached task
-- that has a PR renders under plain awaiting_review, because once a PR exists
-- only the review decision matters.

-- NotificationKind is the `notification_type` field on Claude Code's Notification
-- hook payload, forwarded by the task-status-hook as the `--kind` argument to
-- `dispatch hook <id> notification`. It is absent on Claude Code versions that
-- predate the field. The agent-view-only values `agent_needs_input` and
-- `agent_completed` are intentionally excluded: dispatch runs a plain `claude`
-- process in tmux, never `claude agents`, so those values never reach the hook.
-- See HookNotification in agent-health.allium for how each value is classified.
enum NotificationKind {
    permission_prompt       -- agent is blocked on a permission decision
    idle_prompt             -- agent has gone idle awaiting human input
    auth_success            -- informational (auth succeeded); not human-actionable
    elicitation_dialog      -- agent is asking a question / showing a form
    elicitation_complete    -- an elicitation just resolved
    elicitation_response    -- an elicitation response was received
}

-- LearningScope identifies what context a learning applies to.
-- Dispatch retrieval unions: user + repo:<this_repo> + epic:<this_epic> (if set).
-- task scope carries task-specific outcomes, retrieved on demand.
enum LearningScope { user | repo | epic | task }

-- LearningKind categorises what was learned. kind does not affect retrieval or
-- rendering: every retrieved entry, procedural included, goes into the single
-- RAG-ranked "Validated knowledge" block (see learnings.allium: Priority
-- Ordering). kind describes how an entry was authored and what it means.
enum LearningKind {
    pitfall              -- a failure mode; agents should avoid or handle carefully
    convention           -- preferred code pattern or style in this context
    preference           -- the user's explicit working preference
    tool_recommendation  -- recommended tool or library for a given problem
    procedural           -- a how-to-work-here procedure; injected like any other kind
    landscape            -- codebase/system overview (service maps, module responsibilities)
}

-- LearningStatus controls whether an entry is active in retrieval.
-- New entries land as approved; there is no human approval gate and no human
-- curation surface. A background job archives stale, unvalued entries (see
-- learnings.allium: ArchiveStaleLearning), which is the only status change any
-- behaviour produces. Nothing produces rejected, but stored rows may still
-- hold it. Entries in rejected or archived are excluded from
-- prompt injection and query_learnings results.
enum LearningStatus { approved | rejected | archived }

-- VerdictKind is an agent's evaluation of a retrieved learning, submitted via
-- the rate_learning MCP tool at any point during a task and kept as a
-- LearningVerdict. helped and wrong adjust the learning's net score;
-- not_applicable does not. None changes its status.
--   helped         — the learning applied and was useful (counts +1)
--   wrong          — the learning misled the agent or is no longer accurate
--                    (counts -1; the score may go negative)
--   not_applicable — the agent read the learning and it did not fit this task.
--                    Counts 0 and leaves the learning row untouched. It tells
--                    "read, did not fit" apart from "never rated".
enum VerdictKind { helped | wrong | not_applicable }

-- RetrievalSource records how a learning was surfaced to a task's agent.
--   prompt_injection — included in the single RAG-ranked "Validated knowledge"
--                      block prepended to the dispatch prompt
--   procedural       — never produced: procedural learnings are recorded as
--                      prompt_injection like every other kind (learnings.allium).
--                      Stored rows may still hold it.
--   query_learnings  — returned by an explicit query_learnings MCP call
enum RetrievalSource { prompt_injection | procedural | query_learnings }

-- WrapUpMode records the preferred wrap-up path for a task, set at creation
-- time by the user or agent. When set, the /wrap-up skill honours it instead
-- of prompting the user: the mode IS the user's answer, given earlier, so the
-- skill runs the whole wrap-up on it — through wrap_up and exit_session —
-- without asking anything and without returning to an idle prompt part-way.
-- A preset mode that only suppressed the question would be worse than no mode
-- at all: the agent would go idle with the question it was told not to ask
-- unanswered, and nothing would reach base_branch until a human noticed.
--   rebase — rebase the task branch onto base_branch and fast-forward it
--   pr     — agent authors and creates a draft PR (no git ops done by dispatch)
--   done   — close without any git operations; task moves to Done directly
enum WrapUpMode { rebase | pr | done }

-- TaskModel is the Claude model a task's agent runs on. Each literal is a
-- Claude Code model alias, passed verbatim as `claude --model <alias>`, so it
-- always names the latest model of that family rather than a pinned version.
-- A task with no model set runs on sonnet (dispatch.allium:
-- EveryTaskAgentLaunchesOnItsModel): sonnet is the default everywhere, for a
-- task made in the wizard, over MCP or by a feed alike, and for a task made
-- before the field existed.
enum TaskModel { haiku | sonnet | opus | fable }

-- Visibility of an epic or a work package inside its workspace
-- (workspaces.allium). public: every member of the workspace sees it.
-- private: only its creator does — no admin role, workspace or super, reads
-- it (workspaces.allium: "Decisions", D3). A task has no visibility of its
-- own: an epic task follows its epic, an epic-less task is private to its
-- owner (Task.visible_to).
enum Visibility { public | private }

-- == Agents (agents.allium) ==

-- Where an agent is in its life.
--   assigned -- picked for its task when the task was created, and never
--               launched (A17). It has a name and nothing else: no host, no
--               start mode, no window. The task's first dispatch claim
--               launches it and it becomes current.
--   current  -- its session can still be resumed: the worktree is there and
--               no fresh launch has replaced it. Whether it is running right
--               now is a separate, derived fact (is_live, below): a current
--               agent without a window is paused, and a resume brings it back.
--   ended    -- it never can again. Terminal.
enum AgentState { assigned | current | ended }

-- Why an agent ended. Recorded once, when it ends.
--   replaced       -- a fresh launch started a new agent for the same task.
--   worktree_gone  -- RetryFresh released the worktree its session lived in.
--   launch_failed  -- its dispatch request failed before the host recorded a
--                     worktree, and the claim was released (A12).
enum AgentEndReason { replaced | worktree_gone | launch_failed }

-- What kind of launch started an agent. A resume never starts one.
enum AgentStartMode { dispatch | research | quick }

-- == Workspaces (workspaces.allium) ==

-- A workspace role. A super-admin is not a workspace role: it is a flag on
-- the person (workspaces.allium: UserProfile.is_super_admin) and holds across
-- every workspace without being a member of any.
enum WorkspaceRole { admin | member }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- Host identifies a machine a copy of dispatch runs on. Exactly one row is
-- THIS machine, minted on first run and stable thereafter (see
-- ExactlyOneLocalHost in the Invariants section); once a shared store is in
-- play the rest of the rows are other people's machines, and the local one is
-- not distinguished by anything in the row itself.
--
-- `id` answers "is this the machine that holds that worktree?"; `label`
-- answers "whose machine is this?" for a human reading a card. The id is never
-- shown and the label is never compared, which is why the hostname is only the
-- label's suggested starting value and never the identity: hostnames collide,
-- change, and carry personal names. host.allium's header gives the full
-- reasoning.
--
-- The label is null from the moment the row is minted until a human names this
-- machine; the startup gate that asks them (startup.allium:
-- PromptForHostLabelWhenUnnamed) offers the hostname pre-filled. No board is
-- drawn while it is null, so no reader of a card ever renders one.
--
-- The local row (id, label, owner, with the credential beside them) is kept in
-- the host file (host.allium: IdentityLivesInHostFile), not in the shared
-- store, which holds a mirror of it for other machines to read.
--
-- Task.is_locally_owned is the only reader that resolves the local row, and no
-- rule navigates from a Task to another machine's label, count or owner. Which
-- rows arrive, and from where, is sync.allium's question.
entity Host {
    id: String       -- opaque and generated; not derived from anything about the machine. Minted once on first run and stable across restarts, upgrades and renames
    label: String?   -- human-readable name for the machine. Null until a human names it: minting does not seed it, and the startup gate asks for it before the board draws (startup.allium: PromptForHostLabelWhenUnnamed) with the machine's hostname pre-filled. Editable afterwards through host.allium: RenameHost. This is the string a card would display
    owner: UserIdentity?  -- the person this machine belongs to. Null until this install has connected once and learned who it is: the id above is minted offline on first run, and no identity exists at that moment. Written once, by host.allium: AdoptUserIdentity, and never rewritten — see LocalHostOwnerIsWrittenOnce below

    -- `owner` is what makes one person on several machines real: a laptop and
    -- a desktop are two Host rows carrying the same UserIdentity. It changes no
    -- locality gate: Task.is_locally_owned still compares Task.host against
    -- local_host(), machine against machine, because a worktree is on one
    -- disk whoever owns the machine.
    --
    -- Null is a lasting, supported state: an install that never reaches a
    -- shared store never learns an identity, so no startup gate fills it and
    -- every reader handles its absence. On the local row this field is the
    -- install's only stored answer to "who am I?" (host.allium).

    @invariant LocalHostOwnerIsWrittenOnce
        -- The local row's owner goes null -> some identity, once, and never
        -- moves again. host.allium: AdoptUserIdentity is the only writer, and
        -- it is guarded on the field being null.
        --
        -- The store's copy of the row holds to it too: the registry write
        -- (sync.allium: RegisterHostOnConnect, RegisterHostOnRename) is
        -- refused when it names an owner other than the calling identity, or
        -- would change an owner already written. A re-register by the owner
        -- itself — a rename, a reconnect — passes. store-split.allium's D11
        -- rests on this: a host's owner is who may act for it.
        --
        -- The store's copy is never CREATED ownerless: a registration that
        -- would add a new row with no owner is refused. Host ids are public,
        -- so an ownerless row would go to whichever caller next registered
        -- that id as its own, and a teammate could take a new machine's host
        -- before its own board did. That is also why the board registers only
        -- after AdoptUserIdentity has settled the owner (sync.allium:
        -- RegisterHostOnConnect), never before. A row already stored without
        -- an owner may still be adopted, once, by the first caller naming
        -- itself.
        --
        -- Not stated as an expression because the claim is about the field's
        -- HISTORY, and an invariant is evaluated against a single state. What
        -- is checkable is that no rule writes it twice, which is a property of
        -- the rule set rather than of the store.
        --
        -- It binds the LOCAL row only. A remote row's owner is somebody else's
        -- identity, arrives already written, and is never written from here.
}

-- A Subscription is one person's standing interest in one epic: the epic's
-- tasks reach their board, and changes to them arrive without being asked for.
--
-- It exists because a shared board is not one board. Everyone sees their own
-- user-board tasks (Task.owner above) unconditionally, and beyond that sees
-- exactly the epics they have subscribed to. Without this row there are only
-- two reachable designs, and both are wrong: everyone sees everything, which
-- makes the board useless at more than a handful of people, or everyone sees
-- only their own work, which is the local board we already have.
--
-- Subscribing to your OWN user board is not represented here, and its absence
-- is deliberate rather than an omission. You can only ever subscribe to your
-- own, so the row would be present for every user, always, and carry no
-- information. It is implied by the identity, and Task.owner is what resolves
-- it. There is correspondingly no way to express an interest in someone
-- else's user board, which is the point: that board is theirs.
--
-- Two subscriptions by the same person to the same epic are the same
-- subscription, not two of them — see SubscriptionIsUniquePerSubscriberAndEpic.
-- Re-subscribing is therefore harmless and changes nothing, which is what lets
-- a client re-assert its interests on every reconnect without checking first.
entity Subscription {
    subscriber: UserIdentity
    epic: Epic
}

-- UnseenTask records that one person has not yet looked at one task that was
-- created with the signal on (mcp-task-tools.allium: CreateTaskViaMcp's
-- `signal`, or feeds.allium: NewReviewRequestIsSignalled). It is the whole of
-- the "new task" signal's stored state. It is written for everyone who can
-- see the task's epic when it is created (Epic.visible_to); a Subscription
-- plays no part.
--
-- An EPIC's mark is never stored. An epic is marked for a person exactly when
-- some UnseenTask row for that person names a task in the epic's subtree (the
-- epic itself or any descendant). The epics on the path to a new task therefore
-- light up and go dark by derivation, with no second write to keep in step.
-- See "New-task signal" in board-visuals.allium for how it is drawn and
-- tasks.allium: SeeTaskByLandingOnIt for how it clears.
--
-- Rows exist for people, not for machines: the key is a UserIdentity, so one
-- person's two laptops share one mark and clearing it on either clears both.
--
-- A row lives only as long as the task it names stays unseen, in its epic and
-- not Done. See tasks.allium: UnseenMarkEndsWithTheTaskLeavingItsEpic and
-- UnseenMarkEndsWithTheTaskFinishing.
entity UnseenTask {
    subscriber: UserIdentity
    task: Task
}

-- Bookmark records that one person has asked to come back to one task.
-- It is the whole of the bookmark's stored state. Only the
-- person themselves sets or clears it, from the board (tasks.allium:
-- ToggleBookmarkFromBoard) or over MCP (mcp-task-tools.allium:
-- UpdateTasksViaMcp's `bookmarked`).
--
-- It is UnseenTask's twin in shape and in how it is drawn, and differs in
-- how it ends. An UnseenTask means "you have not looked yet" and ends when the
-- cursor lands on the card. A Bookmark means "come back to this" and ends only
-- when the person removes it or the task is Done or deleted.
--
-- An EPIC's bookmark mark is never stored, on the same terms as UnseenTask:
-- an epic is marked for a person exactly when some Bookmark row for that
-- person names a task in the epic's subtree. See "Bookmark" in
-- board-visuals.allium for how it is drawn.
--
-- Rows exist for people, not for machines: keyed by UserIdentity, so a
-- bookmark set on one laptop shows on the person's other one.
--
-- Only a task can be bookmarked, never an epic, and never a task that is
-- Done. A row lives until it is toggled off, its task enters Done or is
-- deleted, or its person loses sight of the task (tasks.allium:
-- BookmarkEndsWithTheTaskFinishing; workspaces.allium: ClaimsFollowSight,
-- on every path that can take sight away: RemoveMember, MoveEpicToWorkspace,
-- SetEpicVisibility, a re-parent, a task move into a private epic or onto a
-- user board). Losing sight ENDS the row (task #98992, B1): it does not hide
-- and come back when sight returns. It survives the task moving to another
-- epic the person still sees.
entity Bookmark {
    subscriber: UserIdentity
    task: Task

    invariant BookmarkedTaskIsNotDone {
        task.status != done
    }
}

entity Task {
    title: String
    description: String
    repo_path: String
    status: TaskStatus
    sub_status: SubStatus
    worktree: Worktree?
    host: Host?           -- the machine holding this task's worktree; null means no machine holds one. Coupled to worktree, not to status — see HostTracksWorktree below
    owner: UserIdentity?  -- the person whose user board this task sits on; set exactly when the task has no epic. Orthogonal to `host` — see OwnerTracksUserBoardTask below
    created_by: UserIdentity?  -- who created this task; stamped once and never rewritten, regardless of epic membership. NOT the same question as `owner`: `owner` tracks which board the task sits on and is blanked the moment the task joins an epic, so it cannot answer "who made this?" for an epic task. `created_by` exists so sync.allium can subscribe a creator to their own creations, epic or not — see sync.allium's own-creations subscription. Null for a task created before this field existed, and never backfilled: unlike `owner`, there is no derivation that recovers a forgotten creator.
    plan_path: String?    -- filesystem path to the implementation plan file
    epic: Epic?
    url: TaskUrl?    -- the single typed URL attached to this task
    tag: TaskTag?
    sort_order: Integer?  -- manual and feed-driven ordering, and nothing else; lower sorts first, and a null sorts as if it were the row's id (Task::sort_key). No status transition reads or writes it — see completed_at
    completed_at: Timestamp?  -- when this task last entered done; null until it first does. The Done column's ordering key (board-layout.allium, "Done Column Ordering"), stamped by every transition into done and by creation directly into done. Survives a move back out of done: it records the last completion, not the current status. Also writable without a status transition, by a manual reorder of this task's card in the Done column (tasks.allium: ReorderItem) -- the same override the Epic twin below carries
    labels: List<String> = []  -- free-form badges rendered on the card's second line; set by feed scripts via FeedItem.labels.
                               -- Ordered, and the order is load-bearing: badges render in
                               -- declaration order so a feed script controls which label
                               -- appears first on the card. Duplicates are retained.
                               -- Presentation, including the three CI-status texts that
                               -- take a state colour, is "Card label badges" in
                               -- board-visuals.allium.
    base_branch: String = config.default_branch -- the branch this task rebases onto / targets for PRs
    external_id: String?  -- stable identifier for tasks sourced from a feed epic (see feeds.allium); null for hand-created tasks. Unique per (epic, external_id) when set.
    -- The live-session facts (the window, the two hook timestamps, the live
    -- subagent count, the deferred Stop and its time) sit on the task's
    -- current Agent, not here.
    pr_learnings_gate_shown_at: Timestamp?  -- set once when the PrLearningsGate fires; null means the gate has never fired for this task
    wrap_up_mode: WrapUpMode?  -- preferred wrap-up path; null means decide at wrap-up time
    model: TaskModel?          -- the model the task's agent launches on; null means sonnet
    auto_run_plan: Boolean = false  -- when true and plan_path is set, build_prompt's
                                    -- has-plan addendum skips asking the dispatched
                                    -- agent to confirm before implementing (see
                                    -- dispatch.allium's build_prompt guidance)
    phoenix: Boolean = false  -- a recurring task: entering done creates a fresh backlog
                              -- copy of it, and the flag MOVES to that copy (see
                              -- tasks.allium: PhoenixRespawn). Independent of `tag` on
                              -- purpose — a phoenix task still carries whatever kanban
                              -- label it wants, and `tag` keeps its two behavioural
                              -- readers untouched (see "Tag system" in
                              -- docs/conventions.md). Not a schedule by itself: an
                              -- unscheduled phoenix task waits for a human to
                              -- dispatch it. With `schedule` set it repeats on that
                              -- schedule (schedules.allium, S3).
    schedule: String?         -- a five-field UTC cron string; null when the task is not
                              -- scheduled. On a phoenix task it repeats, on any other
                              -- it fires once (schedules.allium: SetSchedule)
    next_due: Timestamp?      -- when a running board next dispatches this task; null
                              -- when nothing is pending. Computed by the store from
                              -- `schedule`, never by a board (schedules.allium:
                              -- FireDueTask, DispatchConsumesTheDueTime)
    schedule_error: String?   -- why the last scheduled launch failed; null when it has
                              -- not, or since a launch succeeded or the schedule was set
                              -- again (schedules.allium: ScheduledLaunchFails)
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        backlog -> running
        running -> review
        running -> backlog
        -- The 'x' key completes a task from wherever it sits, so Done is
        -- reachable directly from backlog and running, not only from
        -- review (see tasks.allium: ConfirmDone / DeleteKeyRouting)
        backlog -> done
        running -> done
        review -> done
        review -> running
        done -> review
        done -> running
    }
    -- There is no terminal status. A task leaves the board by being
    -- deleted outright (tasks.allium: DeleteTask, BatchDelete), which
    -- removes the row rather than moving it into a status: a finished task
    -- either stays in done or is gone.
    --
    -- This graph governs the move-based status changes only (MoveTask,
    -- ConfirmDone, dispatch/PR-driven transitions). Two operator paths
    -- are intentionally exempt from it:
    --   - EditTask, the tmux task editor (see tasks.allium: EditTask). May
    --     set any TaskStatus from any other.
    --   - MCP `update_tasks` (see mcp-task-tools.allium:
    --     UpdateTaskViaMcp), the agent path. Partially restricted: it
    --     refuses `done` as a TARGET status, but applies no edge check at
    --     all beyond that, and does not constrain the SOURCE status. So an
    --     agent can drive `review -> backlog`, `backlog -> review` and
    --     `done -> backlog` — none declared above — since only the target
    --     is checked.
    -- Both are deliberate escape hatches — manual correction for the
    -- first, re-opening or re-queueing work for the second — not
    -- edges of the lifecycle, so they are not declared above. Every
    -- other status change, whether automatic or a keyboard move, does
    -- obey the graph.

    -- Derived
    -- Whether `user` can see this task: an epic task exactly when its epic
    -- is visible to them, an epic-less task only by its owner — the user
    -- board is always private (workspaces.allium: "Decisions", D2).
    visible_to(user): if epic != null: epic.visible_to(user) else: owner = user

    has_plan: plan_path != null

    -- The review set (see TaskTag): the task reviews a PR someone else
    -- authored. Every reader of the set reads it through this.
    is_review_tagged: tag in {pr_review, dependabot, release_please}

    -- The window of the task's current agent, null when it has none or the
    -- agent holds no window (the task's session is not running).
    current_window: current_agent(this).tmux_window

    -- The name people know the task by (A18): its assigned or current
    -- agent's name, else the name of the agent that ended last. Every task
    -- gets an agent when it is created (A17), so after the backfill every
    -- task has one. The id stays the key; this is what a person reads.
    display_name: display_agent(this).name
    is_detached: worktree != null and current_window = null
                 and status in {running, review}
    -- sub_status is deliberately not part of this condition, the same way it
    -- is not part of Parked's (see "Derived review sections" above): a caller
    -- that needs to treat conflict specially checks sub_status first (e.g.
    -- the card indicator, which tests conflict before is_detached).
    -- A task that looks live but was never provisioned (or lost its
    -- provisioning), so there is nothing to resume. Mutually exclusive with
    -- is_detached, which requires a worktree.
    -- Surfaced on the card by UnprovisionedIndicator in dispatch.allium.
    is_unprovisioned: worktree = null and current_window = null
                      and status in {running, review}
    -- May THIS install act on the task's worktree and tmux window? True when
    -- no machine holds a worktree for it — there is nothing to conflict over —
    -- and true when the machine holding it is this one.
    --
    -- `local_host()` is the single Host row of this install (see entity Host
    -- above); the derivation is written against it rather than against a
    -- stored "is mine" flag so the answer cannot drift from the host field it
    -- is about.
    --
    -- On a single-machine install every task satisfies this: the host is
    -- either null or this machine, so every precondition built on it is a
    -- no-op. That is the point. The gates it feeds (dispatch.allium:
    -- ResumeTask, RetryResume, RetryFresh) cost nothing today and are the
    -- difference between a correct and an actively destructive board the
    -- moment a second machine shares one.
    is_locally_owned: host = null or host = local_host()

    -- pr_number is parsed from the trailing numeric segment of url.url, but
    -- only when the url is pr-typed; otherwise null. Not persisted; computed
    -- on demand.
    pr_number: if url != null and url.url_type = pr: pr_number_from_url(url.url) else: null

    -- A phoenix task sitting in done is one whose respawn did not land.
    -- PhoenixRespawn (tasks.allium) clears the flag exactly when the successor
    -- was created, so a surviving flag in done IS the failure state — there is
    -- no separate error column to keep in step with it. Surfaced on the card by
    -- "Phoenix marker" in board-visuals.allium.
    respawn_failed: phoenix and status = done

    -- A scheduled launch failed and the task is still waiting in backlog for
    -- a human (schedules.allium: ScheduledLaunchFails). Surfaced on the card
    -- by "Schedule marker" in board-visuals.allium.
    schedule_failed: schedule_error != null and status = backlog

    -- Which sub_status values each status admits. The store holds it: its
    -- patch_task reducer refuses an explicit sub_status outside it for the
    -- status the row will hold, before applying anything (mcp-task-tools.allium:
    -- UpdateTaskViaMcp), and its one task write refuses any other writer's move
    -- of sub_status outside it (tasks.allium: SubStatusMovesMustBeLegal).
    invariant SubStatusFitsStatus {
        (status in {backlog, done} implies sub_status = none)
        and (status = running implies
                sub_status in {active, needs_input, stale, crashed, conflict})
        and (status = review implies
                sub_status in {awaiting_review, changes_requested, approved,
                               conflict, pr_closed, pr_unreachable})
    }

    -- A task has a host if and only if it has a worktree.
    --
    -- Ownership tracks the WORKTREE, and nothing else. A worktree is a
    -- directory on exactly one disk, alongside the tmux window, the running
    -- agent, the live_subagents rows and the hook timestamps that
    -- all describe the same one machine. Whichever machine provisioned it is
    -- the only one that can act on it, so the host is stamped when the
    -- worktree is recorded (dispatch.allium: DispatchTask,
    -- DispatchResearchTask) and cleared when the worktree is released
    -- (dispatch.allium: RetryFresh; tasks.allium: DeleteTask, whose released
    -- arm removes the row, host and all).
    --
    -- THE OBVIOUS READING OF THIS IS WRONG, so it is stated here rather than
    -- left to be inferred: "backlog tasks are unowned" does NOT follow. This
    -- invariant holds in EVERY status, done and backlog included. A
    -- backlog task can legitimately hold a worktree, and therefore a host,
    -- because MoveTaskBackward (tasks.allium) nulls tmux_window but
    -- deliberately PRESERVES the worktree so the task can be resumed later.
    -- A task moved running -> backlog keeps a live directory on one specific
    -- disk, and clearing its host there would leave a worktree nobody owns --
    -- precisely the state ResumeTask's gate exists to refuse.
    --
    -- So the test is `worktree = null`, never the status column. Most backlog
    -- tasks are unowned only because most of them have never been dispatched,
    -- which is a fact about the population and not a rule about the status.
    --
    -- The is_detached derivation above excludes `status = backlog`, so it
    -- declares a backlog task with a worktree and no window uninteresting.
    -- It is not uninteresting to ownership, and this invariant is where that
    -- state is named.
    invariant HostTracksWorktree {
        (worktree != null implies host != null)
        and (host != null implies worktree != null)
    }

    -- A task has an owner if and only if it has no epic.
    --
    -- Every task belongs to exactly one board, and there are two kinds of
    -- board. A task WITH an epic sits on that epic's board, and the epic
    -- already says who can see it. A task WITHOUT an epic sits on a person's
    -- own board, and nothing else in the row says whose. `owner` is that
    -- answer, and it is required precisely where the epic cannot give one.
    --
    -- The other arm is the one worth stating out loud: an owner on a task that
    -- HAS an epic is rejected, not ignored. Two answers to "whose board is
    -- this?" is worse than none. A reader that trusted `owner` and a reader
    -- that trusted `epic` would place the same card on two different boards,
    -- and neither would look wrong locally. So the field is null there, and a
    -- write that sets both is refused.
    --
    -- This is orthogonal to HostTracksWorktree above. `host` says which disk
    -- holds a directory; `owner` says whose board shows a card. A task can be
    -- owned by one person and held by a machine belonging to another, and an
    -- epic task with no owner still has a host the moment it is dispatched.
    -- Neither invariant constrains the other, and collapsing them would make a
    -- shared epic's tasks invisible to everyone but the machine that ran them.
    --
    -- Moving a task between the two kinds of board therefore writes both
    -- fields together: attaching an epic clears the owner, and detaching one
    -- sets it. Neither write is valid alone.
    invariant OwnerTracksUserBoardTask {
        (epic = null implies owner != null)
        and (epic != null implies owner = null)
    }
}

-- == Agents (agents.allium) ==
--
-- Agent and SubagentEntry live here because Task's derivations (is_detached,
-- is_unprovisioned) read them. Their rules are in agents.allium.

entity Agent {
    task: Task
    name: String              -- picked by the store when the agent is assigned or starts; never changes (A5)
    host: Host when state in {current, ended}  -- the machine its session runs on; the task's host when it started. An assigned agent has none
    start_mode: AgentStartMode when state in {current, ended}  -- set when it launches; an assigned agent has none
    state: AgentState
    started_at: Timestamp when state in {current, ended}  -- when it launched; an assigned agent has not
    ended_at: Timestamp when state = ended
    end_reason: AgentEndReason when state = ended

    -- The live-session facts of the task's current agent.
    tmux_window: TmuxWindow?
    last_pre_tool_use_at: Timestamp?  -- wallclock of the most recent PreToolUse hook; null when the agent has never tooled (or after Stop)
    last_notification_at: Timestamp?  -- wallclock of the most recent Notification hook; null when no notification is pending (or after Stop)
    live_subagents: Integer = 0  -- count of subagents currently executing for this agent; a denormalised count of its SubagentEntry rows, rewritten alongside every mutation and clear point (see agent-health.allium)
    stop_pending: Boolean = false  -- a Stop hook arrived while subagents were live; flip the task to review once they drain (see agent-health.allium: HookStop / HookSubagentStop). Cleared by any status write that leaves running — see PendingStopOnlyWhileRunning below
    stop_pending_at: Timestamp?  -- when the Stop that stop_pending defers actually fired (the hook's event time, not its write time). Meaningful only while stop_pending holds; the clear points leave it alone because every reader gates on the bit. HookUserPromptSubmit compares against it to tell a Stop deferred by an earlier turn from one deferred by the turn now starting — see its guidance. Null while the bit is set means the Stop predates the field, and reads as "fired before any prompt"

    transitions state {
        assigned -> current
        current -> ended
        terminal: ended
    }

    is_current: state = current
    is_assigned: state = assigned
    -- Live: it holds a window, so its session may be running. A current agent
    -- that is not live is paused — wrap-up, exit_session, a move back to
    -- backlog, a crash or a window killed off-board took its window, and
    -- nothing ended it (A7). Derived from the window rather than stored, so a
    -- resume that re-records a window still open in tmux (dispatch.allium:
    -- ResumeTask with window_alive) needs no second write to say so.
    is_live: is_current and tmux_window != null

    -- live_subagents is a denormalised count of this agent's SubagentEntry
    -- rows; every mutation and clear point rewrites both in the same write,
    -- so they cannot disagree (agent-health.allium: HookSubagentStart /
    -- HookSubagentStop and the four clear points documented there).
    invariant LiveSubagentCountMatchesEntries {
        live_subagents = (SubagentEntries where agent = this).count
    }

    -- A deferred Stop belongs to the turn the task was running when it
    -- arrived. Only HookStop sets the bit, and it requires the task's status
    -- = running; every status write that leaves running clears it in the same
    -- write (MoveTaskForward / MoveTaskBackward / ConfirmDone in
    -- tasks.allium, UpdateTaskViaMcp in mcp-task-tools.allium, ExitSession in
    -- pr-workflow.allium, update_tasks' done-path close in
    -- store-split.allium's RequestCloseTask, and the drain points in
    -- agent-health.allium). The clear is the store module's, applied by
    -- patch_task to every patch that leaves running and by both closes, never
    -- added by the board (store-split.allium, X2). patch_task skips the clear
    -- only for a patch that names stop_pending itself, which then wins; no
    -- board patch sets it true (only HookStop's own write does), so that
    -- exception cannot keep a Stop alive past running.
    invariant PendingStopOnlyWhileRunning {
        stop_pending implies task.status = running
    }

    -- An ended agent holds nothing of the session: no window, no subagents,
    -- no pending Stop.
    invariant EndedAgentHoldsNothing {
        state = ended implies
            (tmux_window = null and live_subagents = 0 and stop_pending = false)
    }
}

-- A live subagent, as reported by the SubagentStart/SubagentStop Claude
-- Code hooks. The table is the authority for Agent.live_subagents, which
-- is a denormalised count rewritten from it by every mutation and clear
-- point (see agent-health.allium). started_at is retained for diagnostics
-- only; no rule branches on it. Belongs to the agent that was the task's
-- current one when the hook fired; an agent that ends takes its entries with
-- it (EndedAgentHoldsNothing).
entity SubagentEntry {
    agent: Agent
    agent_id: String  -- the Claude Code subagent's own id, not an Agent
    session_id: String
    started_at: Timestamp
}

-- == Workspaces (workspaces.allium) ==

-- A Workspace is a space where people collaborate: every epic and work
-- package lives in exactly one, and a person sees only the workspaces they
-- are a member of. One person may belong to many. Created, renamed and
-- deleted by a super-admin; its members are managed by a super-admin or by
-- one of its own admins. Rules: workspaces.allium.
entity Workspace {
    name: String               -- non-empty after trimming; unique across the store
    created_by: UserIdentity
    created_at: Timestamp
    -- The store also carries an always-true indexed `listed` column on each
    -- row, so a super-admin's view can read them all (workspaces.allium,
    -- "READ ENFORCEMENT, BY DECISION"). It is not a property of the workspace.

    memberships: Membership with workspace = this
    epics: Epic with workspace = this

    has_member(user): memberships.any(m => m.user = user)
    is_admin(user): memberships.any(m => m.user = user and m.role = admin)
}

-- One person's membership of one workspace, with their role there.
entity Membership {
    workspace: Workspace
    user: UserIdentity
    role: WorkspaceRole
    created_at: Timestamp
}

entity Epic {
    title: String
    description: String
    status: TaskStatus
    plan_path: String?    -- filesystem path to the implementation plan file
    sort_order: Integer?
    completed_at: Timestamp?  -- when this epic last entered done, on the same terms as Task.completed_at, manual reorder of the card in the Done column included (board-layout.allium, "Done Column Ordering"). Unlike the task field, an override written here is not permanent: EpicStatusRecalculation rewrites it when the epic itself transitions into done
    auto_dispatch: Boolean = false
    parent: Epic?         -- null for root epics; set for nested sub-epics
    feed_command: String?           -- shell command that emits FeedItem JSON (see feeds.allium); null for non-feed epics
    feed_interval_secs: Integer?    -- per-epic poll cadence in seconds; null falls back to config.default_feed_interval
    group_by_repo: Boolean = false      -- when true, feed tasks are grouped into sub-epics by repo name (see feeds.allium)
    feed_append_only: Boolean = false   -- when true, the feed only ever adds: no stale removal, ever (see feeds.allium: AppendOnlyFeed)
    feed_role: FeedRole = none      -- routing role within a feed hierarchy; `none` for ordinary epics (see feeds.allium: Signal)
    origin: EpicOrigin = manual    -- system-assigned; never settable via MCP
    created_by: UserIdentity?  -- who created this epic; stamped once and never rewritten. The epic twin of Task.created_by — an epic has no `owner` field to begin with (nobody's user board holds an epic), so this is the only way sync.allium can subscribe a creator to an epic they just made, before anyone (including them) follows it. Null for an epic created before this field existed, or created by an unidentified process (e.g. a feed), and never backfilled.
    feed_command_set_by: UserIdentity?  -- who last set feed_command. A host runs the command only when its own owner is the one who set it (feeds.allium: FeedCommandRunsOnSettersHost). Stamped by the store with the caller whenever feed_command is created or changed; null for an epic whose command predates the column, which then counts as set by created_by. Never client-named.
    workspace: Workspace     -- the workspace this epic lives in; chosen at creation for a root epic, inherited from the parent for a sub-epic, and never moved (workspaces.allium: EpicStaysInItsWorkspace). Every epic has one (workspaces.allium: MigrateStoreToWorkspaces)
    visibility: Visibility = public  -- chosen at creation, changeable afterwards (workspaces.allium: SetEpicVisibility)
    created_at: Timestamp
    updated_at: Timestamp

    has_plan: plan_path != null
    is_feed: feed_command != null

    -- The one person who may see this epic when it is private, or null when
    -- it is public all the way up. The NEAREST private epic at or above this
    -- one decides (workspaces.allium: "Decisions", D5): a public
    -- sub-epic of a private epic is hidden by that ancestor and private to
    -- the ancestor's creator, and a private sub-epic is its own creator's whatever sits
    -- above it, a public epic included. A move that changes this value needs
    -- the authority a visibility change does (workspaces.allium:
    -- ReParentingKeepsTheHolder). A private epic with no creator
    -- (created_by null) has nobody to be private to and is seen by no
    -- member; workspaces.allium: EpicIsPrivateOnlyWithACreator refuses to
    -- make one.
    private_holder: if visibility = private: created_by
                    else if parent != null: parent.private_holder
                    else: null
    is_effectively_private: visibility = private or (parent != null and parent.is_effectively_private)

    -- Whether `user` can see this epic. The single read predicate every
    -- surface and every write check uses (workspaces.allium:
    -- AClientReceivesOnlyWhatItCanSee, WritesRequireSight).
    visible_to(user): workspace.has_member(user)
                      and (not is_effectively_private or private_holder = user)

    subtasks: Task with epic = this

    sub_epics: Epic with parent = this

    -- Heterogeneous set used for status recalculation and dispatch ordering.
    -- Combines the epic's tasks and sub-epics; each element contributes its
    -- .status value to the parent's recalculated status. Every child counts:
    -- no status takes a row out of the recalculation short of deleting it.
    children: subtasks + sub_epics

    -- Every task anywhere in the subtree, at any depth: this epic's own
    -- subtasks plus those of every descendant epic. The epic delete guard
    -- (epics.allium: DeleteEpic) reads it.
    subtree_tasks: subtasks + sub_epics.flat_map(e => e.subtree_tasks)

    -- Every epic below this one, at any depth (this epic excluded).
    subtree_epics: sub_epics + sub_epics.flat_map(e => e.subtree_epics)

    -- Where Enter on this epic's card lands (epics.allium: JumpToDeepestEpic).
    -- Starting here: stay when the epic has a direct task with `status`;
    -- otherwise step into the sub-epic whose subtree holds such a task,
    -- provided exactly one does; stop at this epic when none or several do.
    deepest_epic_with(status):
        if subtasks.any(t => t.status = status): this
        else if sub_epics.count(e => e.subtree_tasks.any(t => t.status = status)) = 1:
            sub_epics.first(e => e.subtree_tasks.any(t => t.status = status)).deepest_epic_with(status)
        else: this

    -- The epic whose feed cycle emits items filed under this one: this epic
    -- if it carries a feed_command, else the nearest ancestor that does, else
    -- null. A grouped feed's per-repo sub-epics and a role-routed feed's role
    -- sub-epics carry no command of their own, so their answer is the root.
    -- This is the epic a RetiredFeedItem is keyed on.
    nearest_feed_epic: if feed_command != null: this
                       else if parent != null: parent.nearest_feed_epic
                       else: null
}

entity SavedRepoPath {
    path: String             -- filesystem path; one row per (path, host), so two machines that both have
                             -- the same path each own a row and each one's feeds resolve it
    last_used: Timestamp     -- updated on each use; drives recency ordering
    verify_command: String?  -- single-line shell command run by agents before declaring work complete, e.g. "cargo test"
                             -- Belongs to the REPOSITORY, not to the row (VerifyCommandIsPerRepository).
                             -- Rows linked before that held can differ: the first connection after the module that
                             -- added the rule (rules version 43) gives every row of a repository the command of its
                             -- most recently used row that has one, once. Stamping github_path on old rows and giving a
                             -- second host its own row need the board's git and local paths, so they are not migrated:
                             -- a save stamps and creates them on use, and `repo set-verify` saves a missing own row.
    github_path: String?     -- the repository's GitHub path ("org/repo"), read by the saving host from its clone's
                             -- origin remote; null when unknown (no origin, not GitHub). Rows with the same
                             -- non-null github_path are one repository on several machines, so they share
                             -- verify_command and base-branch history (SavedRepoBranch) even though their paths
                             -- differ. A row without one shares a repository with every row at its path,
                             -- and so bridges their groups (a verify command shared through it reaches each).
    host: Host?              -- the install that owns this row; null on a row saved before the stamp existed.
                             -- A path is a place on ONE machine's disk, so only that host can say it is gone:
                             -- prune-repo-paths (cli.allium: PruneRepoPathsViaCli) touches only its own host's rows.
                             -- A save by a host takes the row it owns, else adopts a null-host row of the path,
                             -- else inserts its own. Only the adopt-repo-path rule stamps a null host deliberately.
                             -- A delete names the calling host and removes that host's row or a null-host row;
                             -- a path only ANOTHER host has is refused with the owning host named (the TUI shows
                             -- it), and a path nobody has is not an error (a stale view).
                             -- Authority: save, adopt, delete and set-verify-command each name a host and are
                             -- refused unless the caller owns that host (the same check as a setting write), so
                             -- no one can forge, delete or re-command another person's row. Setting a verify
                             -- command acts through the CALLING host's row of the path (its own, else an
                             -- unowned one), never another host's row of the same path; it then reaches that
                             -- row's repository (same github_path). Whoever owns a row of a repository may
                             -- set the command every row of it shares.

    invariant VerifyCommandSingleLine {
        verify_command = null or not (verify_command.contains("\n") or verify_command.contains("\r"))  -- short-circuits: rhs only evaluated when verify_command != null
    }
}

-- SavedRepoBranch records a base_branch that was used for a given repo_path,
-- forming a per-repo most-recently-used history that feeds the base-branch
-- fuzzy picker during manual task creation (see dispatch.allium:
-- RecordBaseBranch, BaseBranchPicker). Like verify_command, it is a
-- per-repository setting: the history recorded through one clone is offered
-- for every clone of the same repository (rows of SavedRepoPath sharing a
-- github_path).
--
-- It is deliberately NOT derived from Task.base_branch, so that:
--   (a) only branches entered through the manual new-task form are
--       remembered — quick-dispatch and MCP-created branches are excluded
--       (see the recording-scope decision in dispatch.allium: RecordBaseBranch);
--   (b) a remembered branch does not vanish when the task that used it is
--       later deleted.
--
-- Identity is the (repo_path, branch) pair (UniqueBranchPerRepo). Recency
-- ordering (most-recent-first) and the per-path cap are
-- governed by the write operation (see dispatch.allium: RecordBaseBranch and
-- the BranchHistoryCapped invariant).
entity SavedRepoBranch {
    repo_path: String        -- the repo this branch history belongs to
    branch: String           -- a base_branch value used for repo_path
    last_used: Timestamp     -- updated on each use; drives recency ordering
}

-- Setting is a general-purpose named value: a feed's command, its poll
-- interval, which board sections are collapsed, and so on. Every row is in the
-- shared store, keyed by host. Why host and not UserIdentity, and which values
-- stay out of this table, is settings.allium's header (SettingsAreStoredPerHost).
entity Setting {
    host: Host
    key: String
    value: String
}

-- Learning captures knowledge a dispatched agent discovered. Entries land as
-- approved immediately (no human approval gate) and are injected into future
-- dispatch prompts for the matching scope. The active pool is curated entirely
-- without a human in the loop, and there is no human-facing surface for it at
-- all: agents up/downvote via rate_learning, delete entries outright via
-- delete_learning, and a background job archives stale entries with a
-- non-positive score (see learnings.allium: ArchiveStaleLearning).
entity Learning {
    kind: LearningKind
    summary: String          -- one-sentence digest; injected into dispatch prompts
    detail: String?          -- extended context; returned by query_learnings
    scope: LearningScope
    scope_ref: String?       -- qualifies the scope:
                             --   scope=repo    → repo_path of the target repository
                             --   scope=epic    → string form of epic_id
                             --   scope=task    → string form of task_id
                             --   scope=user    → null (no qualifier needed)
    tags: Set<String>        -- free-form labels for filtering (e.g. "rust", "testing")
    status: LearningStatus
    source_task: Task?       -- the task whose agent proposed this entry; null for human-authored entries
    upvote_count: Integer -- net score: +1 per `helped` verdict, -1 per `wrong`, 0 per `not_applicable`
                          -- verdict. May be negative. Feeds retrieval ranking and
                          -- the stale-cleanup eligibility check (upvote_count <= 0).
    last_upvoted_at: Timestamp?
    workspace: Workspace?    -- the workspace a learning belongs to; null means private to its author (every user-scoped learning, and any other whose item or recorder has no workspace; workspaces.allium: LearningVisibility)
    author: UserIdentity?    -- who recorded it, stamped by the store; null only on a learning that predates workspaces
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        approved -> archived     -- system-driven, and the only transition any
                                 -- behaviour produces: the stale-cleanup job
                                 -- archives an approved entry with
                                 -- upvote_count <= 0 untouched for the configured
                                 -- threshold (ArchiveStaleLearning)
        terminal: rejected, archived
    }
    -- rejected is terminal and has no inbound edge: no behaviour produces it.
    -- Stored rows may hold it and must stay parseable; like archived, those
    -- rows are excluded from retrieval.

    -- True when this learning is relevant to the given task's dispatch.
    -- task-scoped learnings are excluded from auto-injection; they surface
    -- via query_learnings on demand (see learnings.allium). A repo scope_ref
    -- covers task.repo_path when the two are equal or the repo lies under it
    -- at a path separator, a trailing "/" ignored (repo_ref_covers;
    -- learnings.allium: Scope Model).
    applies_to_dispatch(task):
        status = approved
        and (
            scope = user
            or (scope = repo and repo_ref_covers(scope_ref, task.repo_path))
            or (scope = epic and task.epic != null and scope_ref = str(task.epic.id))
        )

    -- True when tasks in the given repo have found this learning off-topic:
    -- their standing verdicts on it hold at least
    -- config.off_topic_verdicts_to_mute not_applicable and no helped. wrong
    -- verdicts count neither way, and a deleted task's verdicts are gone with
    -- it (LearningVerdict). Derived from the verdict rows when asked, never
    -- stored. Dispatch injection leaves such a learning out for that repo
    -- only; query_learnings ignores it (learnings.allium:
    -- AugmentDispatchPromptWithLearnings).
    -- The verdicts counted are those the dispatching board can see: the ones
    -- on tasks its user holds (sync.allium: visible_learning_verdicts). On a
    -- one-operator store that is every task in the repo; in a shared
    -- workspace two operators can mute different sets. Accepted: verdicts
    -- arrive through the same per-user view as retrievals.
    off_topic_in_repo(repo_path):
        (LearningVerdicts where learning = this and task.repo_path = repo_path and verdict = not_applicable).count >= config.off_topic_verdicts_to_mute
        and (LearningVerdicts where learning = this and task.repo_path = repo_path and verdict = helped).count = 0

    invariant ScopeRefConsistency {
        (scope = user implies scope_ref = null)
        and (scope != user implies scope_ref != null)
    }
}

-- Retrieval records a single occasion on which a Learning was surfaced for a
-- task. One row is inserted per surfacing event, so repeated exposure
-- accumulates as separate rows (learnings.allium:
-- AugmentDispatchPromptWithLearnings, QueryLearningsViaMcp). A verdict's
-- learning must have a matching retrieval row for the same task
-- (learnings.allium: RateLearningViaMcp).
entity Retrieval {
    task: Task
    learning: Learning
    source: RetrievalSource
    retrieved_at: Timestamp
}

-- LearningVerdict is the standing verdict one task's agent gave one learning.
-- There is at most one per (task, learning) (OneVerdictPerTaskAndLearning): a
-- repeat rate_learning call from the same task replaces it, and the learning's
-- upvote_count moves by the difference, so one task moves a learning's score by
-- at most one in either direction (learnings.allium: RateLearningViaMcp; the
-- store's apply_learning_verdicts reducer). A task's verdicts go with it when
-- it is deleted.
entity LearningVerdict {
    task: Task
    learning: Learning
    verdict: VerdictKind
}

-- PollOwner names the single host allowed to run recurring background
-- polling for a scope that has no natural owner of its own: a feed epic
-- (Epic carries no `host` field at all — see pr-workflow.allium:
-- PollPrStatus and feeds.allium: FeedTick for why each needs one) or a
-- review task whose PR arrived with no worktree (see Task.host and
-- HostTracksWorktree above — a feed-created review task never has a
-- worktree, so it never has a host either).
--
-- Unlike PrPollState (pr-workflow.allium), this IS persisted and shared: it
-- must be comparable across hosts for "am I the owner?" to have one answer
-- everywhere, not one answer per process.
--
-- A row is claimed once and, deliberately, never expires and never
-- renews. This is not an oversight — a TTL/lease design was proposed and
-- rejected: the people sharing a board are collaborators, not unreliable
-- infrastructure a watchdog needs to route around, so a claim stays valid
-- for as long as it is useful. Only an epic-scope row can be moved, and only
-- by an explicit human action — see feeds.allium: OverrideFeedOwner. A
-- task-scope row has no override. A task WITH a worktree never gets a row
-- here: `task.host` already answers "who owns this?" unambiguously and for
-- free, and duplicating that answer in a second table is a second place for
-- it to disagree.
entity PollOwner {
    scope: task | epic     -- which kind of scope_id this row names
    scope_id: Integer      -- the Task or Epic id, per `scope`. No foreign
                            -- key: the id is stored rather than referencing
                            -- Task or Epic directly.
    host: Host
    claimed_at: Timestamp  -- audit only; no rule reads this to decide anything

    @guidance
        -- Claiming (first host to see an eligible scope with no row) and
        -- overriding (a human reassigning an existing epic-scope row) are
        -- specified where they are consumed, not here: PollPrStatus in
        -- pr-workflow.allium for the task scope, FeedTick and
        -- OverrideFeedOwner in feeds.allium for the epic scope.
        -- This file owns the shape of the row, not the write rules, matching
        -- this file's own excluded scope ("Excludes: Rules").
}

-- A feed item the human deleted from the board, remembered so the feed does
-- not put it straight back. Deleting a task is permanent (tasks.allium:
-- DeleteTask), but a feed task is a mirror of something upstream that is
-- usually still there: without a record the very next cycle would see the
-- same external_id, find no row, and insert a fresh task. This row is what
-- turns "delete" into "I am done with this item" for a feed.
--
-- `feed_epic` is the epic whose cycle emits the item: the nearest epic in the
-- deleted task's chain — the task's own epic or an ancestor — that carries a
-- feed_command. Keying on that epic rather than on the task's direct epic is
-- what makes a grouped or role-routed feed's record survive the sub-epic it
-- was filed under being emptied and removed. A task under no feed epic
-- records nothing: there is no cycle to suppress.
--
-- A SHARED row, because the feed tasks it suppresses are shared rows: every
-- host on the board must refuse the same ids, or a second host's cycle would
-- re-insert what the first one's human deleted.
--
-- Lifetime (the write rules live where they are consumed — see the guidance
-- below):
--   - created by DeleteTask / BatchDelete / DeleteEpic in the same write that
--     removes the task row;
--   - dropped by a trusted mirror cycle whose parsed emission no longer
--     carries the id (feeds.allium: DropClosedRetiredFeedItems) — the
--     upstream item closed, so a later reopen shows up as new;
--   - dropped with its feed epic when that epic is deleted. Deleting a feed
--     epic is a reset: its records go with it.
-- There is no un-retire action. A human who wants a retired item back
-- deletes and recreates the feed epic, or waits for upstream to close and
-- reopen it.
entity RetiredFeedItem {
    feed_epic: Epic         -- the epic carrying the feed_command that emits the item
    external_id: String     -- FeedItem.id, the same key feed ingest upserts on
    retired_at: Timestamp   -- audit only; no rule reads this to decide anything

    @guidance
        -- Written by tasks.allium: DeleteTask and BatchDelete, and
        -- epics.allium: DeleteEpic; read and dropped by feeds.allium:
        -- UpsertFeedTasks ("Retired feed items") and DropClosedRetiredFeedItems.
        -- feed_epic carries a feed_command at the moment of writing, but that
        -- is not an invariant: clearing the command later does not drop the
        -- epic's records. They simply stop being read, since no cycle runs.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    tick_interval: Duration = 2.seconds
    gg_chord_timeout: Duration = 150.milliseconds   -- window for completing the vim-style `gg` chord (see board-layout.allium, "Board Columns", row navigation)
    inactivity_timeout: Duration = 10.minutes
    status_message_expiry: Duration = 5.seconds
    -- How long a delivered message's flash stays on the target task's card.
    -- Long enough that a human whose attention is elsewhere still catches it;
    -- a few seconds does not clear that bar. This is the single source of the
    -- duration: both the expiry sweep that clears the tracking state and the
    -- render check that decides whether to draw the flash read it, so they
    -- cannot disagree. See "Message flash" in board-visuals.allium for the
    -- appearance, and mcp-task-tools.allium (SendMessageToTask)
    -- for what triggers it.
    message_flash_ttl: Duration = 30.seconds
    notifications_enabled: Boolean = false
    pr_poll_interval: Duration = 30.seconds
    -- Ceiling on the transient-failure backoff. A PR whose reads keep failing
    -- for a retryable reason is polled at a widening interval up to this cap,
    -- rather than every pr_poll_interval forever.
    pr_poll_backoff_max: Duration = 30.minutes
    -- Consecutive permanent failures before polling gives up on a task and
    -- marks it pr_unreachable. Above one so that a GitHub incident briefly
    -- reporting a real repository as unresolvable does not strand a task.
    pr_poll_permanent_failure_threshold: Integer = 3
    budget_poll_interval: Duration = 10.seconds
    budget_stale_after: Duration = 10.minutes
    -- The floor under every feed cadence, however it is spelled and whoever
    -- writes it. A feed command is a shell command dispatch spawns on a timer;
    -- a cadence below this turns that into a busy loop against the user's own
    -- machine, which is never what anyone asked for. Enforced in the epic
    -- service so every write path inherits it -- see "Interval literals" below
    -- for why it lives there and not in the string grammar.
    min_feed_interval: Duration = 60.seconds
    -- Cadence for a feed epic with no explicit feed_interval_secs (see
    -- feeds.allium). It is the floor itself: an unset field that polled faster
    -- than the fastest value a user may enter would make the floor a lie.
    default_feed_interval: Duration = min_feed_interval
    -- Upper bound on ONE feed command's execution. The per-epic feed-cycle
    -- claim (feeds.allium: SerialisedFeedCycle) spans the whole exec, so
    -- without this bound a command that never exits would hold its epic's
    -- claim for the life of the process. A command still running at this
    -- deadline is killed and reaped instead, and the cycle fails
    -- (feeds.allium: FeedCommandFailure bucket 7).
    feed_command_timeout: Duration = 120.seconds
    mcp_port: Integer = 3142                         -- MCP server port (override via DISPATCH_PORT env var)
    -- Fallback when the repo has no origin/HEAD symbolic-ref.
    -- Runtime code inspects `git symbolic-ref refs/remotes/origin/HEAD`
    -- first and only falls back to this literal when detection fails.
    --
    -- This is a LAST resort, never a first answer. Code that RESOLVES a base
    -- branch for a known repository may not reach for it directly: it gets
    -- there through detect_default_branch, which asks the repository first.
    -- See dispatch.allium: DefaultBaseBranchIsDetectedNotAssumed for the paths
    -- this binds and what reaching for the literal cost.
    --
    -- A field INITIALISER is not a resolution and is not bound by that. A new
    -- Task and an empty form draft both start on this literal, because at that
    -- moment there is no repository to ask -- the repo path is chosen later in
    -- the same flow, or never. What the rule forbids is letting such a value
    -- survive to creation unexamined.
    default_branch: String = "main"

    -- Editor of last resort, when the environment names none. Not a
    -- user-facing setting: the editor is chosen by the environment, and this
    -- constant only gives the fallback a name.
    --
    -- == Which editor (one rule, every surface) ==
    -- Whatever the environment names: VISUAL, else EDITOR, else this fallback.
    -- A value naming no editor at all — absent, empty, or only whitespace — is
    -- treated as unset, because `export EDITOR=` is how a shell spells "none".
    -- The value is split on whitespace into argv and executed directly with no
    -- shell, so a value carrying flags (`EDITOR="vim -p"`) works and nothing
    -- in it is expanded, globbed or word-split by a shell.
    --
    -- This governs EVERY surface that launches the user's editor: the pop-out
    -- task and epic editors (tasks.allium: EditTask, epics.allium: EditEpic).
    -- One user setting must not mean two things in one application. The
    -- agent-tree panes launch no editor: they render a file's diff themselves
    -- (agent-tree.allium: OpenAgentTreeFileDiff).
    editor_fallback: String = "vi"

    -- Staleness thresholds used by card age rendering and Staleness::from_age.
    fresh_threshold: Duration = 3.days
    aging_threshold: Duration = 7.days
    weeks_threshold: Duration = 14.days

    -- When true, the MCP update_tasks response carries a nudge asking the agent
    -- to call record_learning if it discovered anything non-obvious — but only
    -- when that single update_tasks call performs "PR finalisation": it sets
    -- status = review AND a pr-typed url, on a task that had no url before the
    -- call. Prompt encouragement only: the nudge is appended to the response
    -- text and never gates the update itself. No other tool reads this flag —
    -- in particular the wrap_up response does not (its rate_learning nudge is
    -- unconditional; see learnings.allium: WrapUpRateLearningNudge).
    -- (see mcp-task-tools.allium: PrFinalisationReflectionNudge)
    learning_reflection_enabled: Boolean = true

    -- Stale-learning cleanup: when enabled, a background job archives approved
    -- learnings whose net score is non-positive (upvote_count <= 0) and that have
    -- not been touched (updated_at) within stale_learning_threshold. Keeps the
    -- active retrieval pool free of unvalidated clutter with no human in the loop.
    -- (see learnings.allium: ArchiveStaleLearning)
    stale_learning_cleanup_enabled: Boolean = true
    stale_learning_threshold: Duration = 90.days

    -- How many standing not_applicable verdicts from one repo's tasks, with no
    -- helped verdict from that repo, mute a learning from dispatch injection
    -- in that repo (Learning.off_topic_in_repo; learnings.allium:
    -- AugmentDispatchPromptWithLearnings).
    off_topic_verdicts_to_mute: Integer = 3

    -- How many levels below an epic the store's recursive delete reaches. An
    -- epic delete (single or batch) refuses a subtree nested deeper rather
    -- than stopping there and stranding the rows below (epics.allium:
    -- DeleteEpic). The module's MAX_EPIC_DEPTH.
    max_epic_depth: Integer = 64

    -- How many hops up an ancestor chain the store's reparent cycle check
    -- walks. A chain longer than this is already a loop or corrupt, and the
    -- move is refused as a cycle (epics.allium: UpdateEpicViaMcp's
    -- parent_epic_id check). The module's MAX_ANCESTOR_WALK.
    max_ancestor_walk: Integer = 1024
}

------------------------------------------------------------
-- Interval literals
------------------------------------------------------------

-- == How a human types an interval ==
--
-- Every user-facing surface that accepts a poll cadence takes the SAME literal
-- grammar, so "10m" means the same thing wherever it is typed. One grammar,
-- stated once here, because two spellings of ten minutes in one application is
-- a bug waiting to be filed. Only one surface is bound by it today; the
-- grammar is stated centrally so a second one cannot invent its own.
--
-- Grammar (case-insensitive, surrounding whitespace ignored):
--
--   <digits>          -- bare seconds:  "600"  -> 600
--   <digits>s         -- seconds:       "600s" -> 600
--   <digits>m         -- minutes:       "10m"  -> 600
--   <digits>h         -- hours:         "2h"   -> 7200
--   <digits>d         -- days:          "1d"   -> 86400
--
-- Accepted only if the digits parse AND the resulting seconds count is
-- STRICTLY POSITIVE. Everything else is a parse failure: a bare suffix ("m"),
-- a negative ("-5"), zero in any unit ("0", "0m"), a fractional value
-- ("1.5h"), a compound ("1h30m"), or any other text. Zero is rejected rather
-- than treated as "off" because every surface already spells "off" as the
-- empty value, and a zero-second cadence would busy-loop the feed runner.
--
-- A bare integer is seconds because that is what the stored column holds
-- (Epic.feed_interval_secs).
--
-- Surfaces bound by this grammar:
--   - epics.allium: EditEpic's FEED_INTERVAL_SECS section
--
-- NOT bound by it: the MCP/CLI surfaces, which take a JSON integer of seconds
-- and never a string. The grammar is for humans typing into a field. Those
-- surfaces ARE bound by the floor below -- being exempt from the spelling rule
-- is not being exempt from the domain invariant.
--
-- == Two separate claims: spelling and floor ==
--
-- The grammar above and the floor below are DIFFERENT rules with different
-- scopes.
--
-- CLAIM 1 -- the grammar is human-surface-only, and it only parses. Its job is
-- to turn a typed string into a seconds count, and its strict positivity is a
-- spelling rule: "0" and "-5" are not cadences a person means to type. It binds
-- exactly the surfaces listed above, and nothing else. It does NOT know about
-- config.min_feed_interval, so "10s" parses successfully and is then refused
-- downstream. That is deliberate: a grammar that also enforced the domain floor
-- would be a second place the floor could drift out of step.
--
-- CLAIM 2 -- the floor is universal. No stored feed cadence may be below
-- config.min_feed_interval, whatever surface wrote it and however it was
-- spelled. This is a domain invariant of the field, not a property of any one
-- entry point, so it is enforced ONCE in the epic service (epics.allium:
-- CreateEpic, UpdateEpic, ManagedFeedConfigViaMcp) where every write path
-- inherits it. A value that reaches the poll loop below the floor anyway -- a
-- hand-edited row, a writer that bypassed the service -- is refused at read
-- rather than clamped: feeds.allium's FeedTick skips that epic and warns, on
-- the grounds that a misconfigured feed should not run at all.
--
-- The floor exists because a feed command is a shell command on a timer.
-- Below the floor the poll loop spawns it faster than a person could plausibly
-- want, which is a busy loop against the user's own machine; and a negative
-- value would read as an effectively infinite interval and silence the feed
-- with no trace. Neither failure would announce itself.
--
-- == How an interval is displayed back ==
--
-- Stored values are seconds, and the editor section WRITES seconds back
-- (unsuffixed), so an editor round-trip is lossless and unambiguous even
-- though "10m" was accepted on the way in. No surface renders a humanised
-- cadence today; if one is added, it should show the largest whole unit that
-- divides the value exactly, else seconds ("600" -> "10m", "650" -> "650s").

------------------------------------------------------------
-- Storage Boundary Validation
------------------------------------------------------------

-- Any entity read from storage whose enum fields contain an unrecognised
-- string value must fail the read operation with an error rather than
-- silently defaulting to a fallback variant.
--
-- Rationale: silent defaults mask data-integrity bugs (corrupt migrations,
-- manual DB edits, schema drift) and produce subtly wrong in-memory state
-- that is hard to trace back to the real cause. A hard read error surfaces
-- the problem immediately. The TUI and MCP error-display paths already
-- handle DB errors gracefully, so a hard error is safe.
--
-- This applies to all enum columns: TaskStatus, SubStatus, TaskTag,
-- WrapUpMode, TaskModel, LearningKind, LearningScope and LearningStatus.
-- It also applies to JSON-encoded columns (e.g. labels, tags): malformed
-- JSON must return an error rather than an empty list.
--
-- Exception: FeedRole and EpicOrigin soft-fail instead. An unrecognised
-- value in either column logs a warning and defaults to FeedRole.none /
-- EpicOrigin.manual rather than failing the read.
--
-- Rationale: these two are additive, system-assigned routing/provenance
-- tags. New roles/origins are appended over time, and a newer binary may
-- write a value an older binary has never heard of. Hard-failing would
-- make an older binary reject rows it could otherwise display perfectly
-- well, so it degrades gracefully to the default tag instead. The default
-- is the safe, neutral choice in both cases: `none` (ordinary epic, no feed
-- routing) and `manual` (no special provenance). Because the value is
-- system-assigned and never user-supplied, an unknown value signals a
-- forward-compatibility gap, not the data-integrity bug the hard-fail rule
-- guards against.
--
-- Exception: tmux_window soft-fails too, for a different reason — corruption
-- tolerance, not forward compatibility. A stored value that is not a window
-- name (see TmuxWindow) logs a warning and reads back as no window at all,
-- which is exactly what a task whose agent is gone looks like, so the board
-- still renders it; failing the row would drop the card from every bulk read.
--
-- Not covered at all: the stored list of folded sub-status sections
-- (board-layout.allium: "Collapsed Sections"). It is a settings row rather than an enum column on an
-- entity, and an unrecognised entry in it is skipped rather than failing the
-- read — a fold naming a section this binary does not know about is a display
-- preference that cannot be honoured, not a corrupt task. Read that section
-- before adding ColumnSection to the hard-fail list above.

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- The sub_status a task takes on entering each status. default_sub_status is
-- the function every status write that names no sub_status applies; this is
-- its whole table.
invariant DefaultSubStatusPerStatus {
    default_sub_status(backlog) = none
        and default_sub_status(running) = active
        and default_sub_status(review) = awaiting_review
        and default_sub_status(done) = none
}

-- One install, one LOCAL Host row, and it is this machine. The row is
-- created on first run, before anything can read it (host.allium:
-- MintHostIdentity), so no reader has to handle its absence; host.allium:
-- RenameHost is the only operation that changes its label.
--
-- Hosts is a registry once a second machine shares a store, so the claim is
-- not that there is one row but that exactly one row is THIS machine, which
-- keeps local_host() a total function and Task.is_locally_owned an answer
-- rather than a guess. A rule that counted hosts to decide anything would be
-- wrong; no rule does.
--
-- The row's existence and the label's presence are separate guarantees. This
-- invariant gives the first unconditionally; the second is a startup gate,
-- because between minting and the operator answering the prompt a labelless
-- Host legitimately exists. No board is drawn in that window (startup.allium:
-- AbortWhenTheHostIsUnnamedAndNoOneCanAnswer, DrawBoardAfterTheHostIsNamed).
--
-- A host file that cannot be read or written at all is a substrate failure,
-- not a second arm of this invariant: the launch stops on it before any rule
-- here can be evaluated (startup.allium:
-- AbortWhenTheHostIdentityStoreIsUnusable). Either the row is there, or
-- nothing is running.
invariant ExactlyOneLocalHost {
    (Hosts where id = local_host().id).count = 1
}

-- One person, one epic, one subscription. Stated as an invariant rather than
-- left to the writer because the operation that creates these is re-run on
-- every reconnect: a second row would not be visibly wrong, it would just
-- quietly double whatever a reader counts.
invariant SubscriptionIsUniquePerSubscriberAndEpic {
    for a in Subscriptions:
        for b in Subscriptions:
            a != b implies (a.subscriber != b.subscriber or a.epic != b.epic)
}

invariant UnseenTaskIsUniquePerSubscriberAndTask {
    for a in UnseenTasks:
        for b in UnseenTasks:
            a != b implies (a.subscriber != b.subscriber or a.task != b.task)
}

invariant BookmarkIsUniquePerSubscriberAndTask {
    for a in Bookmarks:
        for b in Bookmarks:
            a != b implies (a.subscriber != b.subscriber or a.task != b.task)
}

invariant OneMembershipPerUserAndWorkspace {
    for a in Memberships:
        for b in Memberships:
            a != b implies (a.workspace != b.workspace or a.user != b.user)
}

-- At most one epic per (parent, feed_role) when feed_role != none; ordinary
-- epics (feed_role = none) are exempt. A managed ROOT (parent = null) is one
-- per creator and workspace: each person's board provisions its own private
-- "PR Reviews" and "CVE" roots (epics.allium: ProvisionManagedEpics), so two
-- roots may share a feed_role when their creators or workspaces differ. A
-- sub-epic shares its parent's workspace, so its siblings always do.
--
-- The store's module holds it. The reducers that provision role epics find
-- one by (feed_role, parent), and a root also by creator, before inserting
-- (spacetime/module/src/feed.rs::ensure_role_epic,
-- spacetime/module/src/feed_ingest.rs::ensure_role_sub_epic), and create_epic,
-- patch_epic and a root's move to another workspace refuse a row that would
-- duplicate one
-- (spacetime/module/src/rules.rs::check_epic_unique_among). A patch that
-- leaves the parent, role, origin and title alone is not judged, so a row
-- already holding a duplicate stays writable for its other fields.
invariant UniqueFeedRolePerParent {
    for a in Epics:
        for b in Epics:
            a != b and a.feed_role != none and a.parent = b.parent
                and a.workspace = b.workspace
                and (a.parent != null or a.created_by = b.created_by)
                implies (a.feed_role != b.feed_role or b.feed_role = none)
}

-- At most one repo-group sub-epic per (parent, title); ordinary epics
-- (origin = manual) may share a title. Held the same way: the creators of
-- repo groups look the title up under the parent first
-- (spacetime/module/src/grouping.rs::find_or_create_repo_group,
-- spacetime/module/src/feed_ingest.rs::ingest_grouped), and a create
-- or a patch of the parent, origin or title that would duplicate one is
-- refused (check_epic_unique_among).
invariant UniqueRepoGroupPerParent {
    for a in Epics:
        for b in Epics:
            a != b and a.origin = repo_group and a.parent = b.parent
                and a.workspace = b.workspace and a.title = b.title
                implies b.origin != repo_group
}

-- Rows of one repository share its verify command: rows with the same
-- non-null github_path are one repository on several machines. The store
-- holds it: setting a command through a path sets it on every row of that
-- path and every sibling of them
-- (spacetime/module/src/config.rs::rows_of_the_repository_at), and a row
-- that learns its github_path takes its repository's command, or gives its
-- own to a repository whose rows have none
-- (spacetime/module/src/config.rs::resaved_verify_command).
invariant VerifyCommandIsPerRepository {
    for a in SavedRepoPaths:
        for b in SavedRepoPaths:
            (a.github_path != null and a.github_path = b.github_path)
                implies a.verify_command = b.verify_command
}

invariant UniqueBranchPerRepo {
    for a in SavedRepoBranches:
        for b in SavedRepoBranches:
            a != b implies (a.repo_path != b.repo_path or a.branch != b.branch)
}

invariant SettingIsUniquePerHostAndKey {
    for a in Settings:
        for b in Settings:
            a != b implies (a.host != b.host or a.key != b.key)
}

invariant OneVerdictPerTaskAndLearning {
    for a in LearningVerdicts:
        for b in LearningVerdicts:
            a != b implies (a.task != b.task or a.learning != b.learning)
}

-- At most one owner per (scope, scope_id) pair.
invariant UniquePollOwnerPerScope {
    for a in PollOwners:
        for b in PollOwners:
            a != b and a.scope = b.scope
                implies a.scope_id != b.scope_id
}

-- At most one record per (feed_epic, external_id). A second delete of the
-- same id under the same feed is a no-op on this table.
invariant UniqueRetiredFeedItemPerFeed {
    for a in RetiredFeedItems:
        for b in RetiredFeedItems:
            a != b and a.feed_epic = b.feed_epic
                implies a.external_id != b.external_id
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- Every party a surface faces is declared here, once, and each spec faces it
-- qualified (`facing operator: core/Operator`). A spec keeps its own surfaces:
-- a surface's `provides` reaches only the rules of the spec it sits in.

-- The person at the keyboard: driving the board, answering a startup prompt or
-- typing a `dispatch` command. Identified by the machine they work on.
actor Operator {
    identified_by: Host where id != ""
}

-- Any client of the dispatch MCP server: a dispatched agent (caller_identity
-- Task(t)) or a session (caller_identity Session). Code, not a person.
actor McpClient {
    identified_by: McpCaller where connected = true
}

-- The system parties. Each is code or the machine, not a person, so each is
-- identified minimally, by the entity it acts for.

-- The board's own process: it reports its own exit, whatever caused it
-- (startup.allium: BoardLifecycle).
actor BoardProcess {
    identified_by: Host where this = local_host()
}

-- The board's timers (BoardClockTicks below).
actor BoardClock {
    identified_by: Host where this = local_host()
}

-- The machine's operating system: power management and process signals.
actor OperatingSystem {
    identified_by: Host where this = local_host()
}

-- The tmux server the board and its agent windows run in.
actor Tmux {
    identified_by: TmuxWindow where name != ""
}

-- Claude Code's hook runner inside an agent's session, which reports the
-- agent's activity to the board.
actor HookRunner {
    identified_by: Agent where state = current
}

-- A Claude Code agent dispatch launched into a task's worktree: what its
-- launch command carries and what its prompt says face it
-- (dispatch.allium: AgentLaunchCommand, dispatch-prompt.allium: AgentPrompt).
actor DispatchedAgent {
    identified_by: Agent where state = current
}

-- The far side of the board's connection to the shared store, as seen from
-- this machine (sync.allium: StoreBoundary).
actor SharedStore {
    identified_by: Host where this = local_host()
}

-- Any client that calls the shared store's reducers: a board, the CLI, a
-- restore. The module knows it only by the identity its connection carries
-- (caller()), and each spec that owns a reducer rule faces it with a surface
-- of its own (store-split.allium: ModuleRequestReducers).
actor StoreClient {
    identified_by: UserIdentity where this = caller()
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The board's timers. Each fires on its own fixed interval while the board
-- runs and never while it does not; none waits for a rule it starts to finish.
-- Consumers listen qualified: `when: core/Tick()`.
surface BoardClockTicks {
    facing _: BoardClock

    provides:
        -- Every config.tick_interval: the board's own refresh (agent-health.allium:
        -- ClassifyAgentActivity, pr-workflow.allium: PollPrStatus).
        Tick()
        -- The feed runner's own interval, kept apart from Tick so the two can
        -- change independently (feeds.allium: FeedTick).
        FeedPollTick()
        -- Every startup.allium config.managed_store_health_interval
        -- (startup.allium: RestartTheManagedStoreWhenItStopsSaving).
        ManagedStoreHealthDue()
}
