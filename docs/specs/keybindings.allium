-- allium: 3
-- keybindings.allium
--
-- Scope: The keybinding table — the one place every key the product answers to
--        is declared — and the three things it drives: which action a pressed
--        key runs, the `?` help overlay, and the read-only `keybinding_search`
--        MCP tool through which an agent can see every key at once. Also the
--        user's key overrides: a file that replaces the keys of chosen rows,
--        read once when a process starts.
-- Includes: KeyNamespace (one per input mode a key is looked up in);
--           KeyBinding (one row: namespace, keys, optional context guard,
--           action id, description, optional note); the rule that a keypress
--           runs exactly the action of the row whose context holds, and that a
--           key with no such row cannot act; the help overlay and the MCP
--           catalogue as two projections of the same table; the uniqueness
--           invariants and the drift-gate obligations that keep the table and
--           the key handlers from diverging.
--           The override file and its entries (KeyOverride); the merge of
--           the default keys and the accepted overrides into the one table
--           every reader uses; the canonical key names; what a bad entry
--           does; and keybinding_set, the MCP tool that writes the file.
-- Excludes: What each action DOES once run — that belongs to the spec owning
--           the behaviour (core, tasks, epics, split-pane, agent-tree,
--           …). This spec says `G` runs navigate_row_last; it does
--           not say what navigating to the last row means.
--           Recording a keypress as feature usage (observability.allium:
--           KeypressRecordsFeatureUsage, FeatureUsageEvent). This spec only
--           fixes what that rule hears: KeyActionRun names the row's action
--           id and carries the row's records_usage.
--           Characters typed into a text field as data (observability.allium:
--           is_text_entry) — those are not bindings and have no rows. The
--           editing keys of a text field (Backspace, Delete, caret and word
--           motion) DO have rows, marked records_usage false, and so do the
--           commit/cancel keys of a text-bearing mode (recorded as usual).
--           Installing and removing the tmux-global bindings (split-pane.allium,
--           agent-tree.allium, startup.allium). Their rows here give the key
--           the board binds (TmuxKeysComeFromTheTable); tmux answers the
--           press, not a dispatch handler.
--
-- Why this exists: an agent with no overview of the keys guesses them, and
-- reads `G` as "enter the epic" (it jumps to the last row of the column;
-- Space enters an epic). Key knowledge kept in per-mode handlers, a
-- hand-written help overlay and a prose key table can disagree. One table,
-- read by all of them, makes disagreement impossible rather than merely
-- discouraged.

use "./core.allium" as core
use "./observability.allium" as observability
use "./storage.allium" as storage

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The repo's Rust test suite, the party the drift gate is demanded of.
external entity TestSuite {}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- The drift gate: obligations on the test suite, stated as a contract so that
-- removing a check is a visible spec change rather than a quiet test deletion.
-- There is no sweep for keys that act without a row: KeyWithoutARowCannotAct
-- holds by construction, since a handler can only run what a row names.
contract KeybindingDriftGate {
    -- For one row of a dispatch-received namespace: with the row's context
    -- set up, pressing each of its keys records the row's action id (or,
    -- for a records_usage false row, takes its effect and records nothing).
    -- For a catch-all row, the press is a key no other applicable row in
    -- the namespace lists.
    press_every_row_key: (binding: KeyBinding) -> Boolean

    @invariant RecordedActionMatchesRow
        -- Run for every row whose records_usage is true, per context. The
        -- action id
        -- KeypressRecordsFeatureUsage records for a press equals the action of
        -- the row listing that key in that context. A handler that runs one
        -- action and records another fails here, and so does a row whose id or
        -- context has drifted from what its key actually does.

    @invariant TableIsWellFormed
        -- KeyUniquePerContext, ContextsDoNotOverlapForAKey,
        -- ActionOncePerContext, ChordPrefixIsFree,
        -- TextNamespacesBindNoTypedKey, TmuxGlobalRowsHaveOneKey and
        -- KeysAreCanonical are asserted over the real default table, not over
        -- a fixture. The relation ContextsDoNotOverlapForAKey reads
        -- (contexts_overlap) is the one the loader uses, not a test-only copy.

    @invariant EveryNamespaceHasRows
        -- Non-vacuity: every KeyNamespace other than tmux_global has at
        -- least one row, and the per-row checks above run over each of them.
        -- A namespace with no rows would make every check over it pass
        -- trivially while every key in it is inert.

    @invariant ModifiedPressDoesNotBorrowTheBareRow
        -- For every unmodified key of every board row (a letter of either
        -- case, a digit, punctuation, Space or a named key): pressing its
        -- Ctrl form, when no row lists that form, runs nothing and records
        -- nothing — no command at all and no change of mode
        -- (ModifiedPressMatchesOnlyItsOwnRow), catch-all or not.

    @invariant UnrecordedRowsRecordNothing
        -- For every row with records_usage false, in every namespace that
        -- has one, each key is asserted by its effect (the field's text or
        -- caret changed as the action says) and by NOTHING being recorded —
        -- not the row's id, not any id.

    @invariant HintsNameOnlyTableKeys
        -- Every key hint a board mode draws (status bar, popup, form
        -- prompt, overlay footer; not the cards of the board drawn under it)
        -- is built from the row it stands for and names a key of that mode's
        -- namespace, so a hint never advertises a key the mode does not
        -- answer. It is read on every board.filter tab and every board.admin
        -- pane, and in board.normal and board.detail too: there the hints
        -- read are those of the status bar and the footer. Two namespaces
        -- are not read: board.help (its body and title are the table;
        -- ReadersFollowTheRemap) and board.error (its catch-all answers any
        -- key). Three modes write their keys without brackets —
        -- board.picker.move_to_epic, board.picker.reparent_epic and
        -- board.confirm.delete_repo_path — and their hints are read all the
        -- same, as the keys of the rows they are built from. A mode that
        -- reads no hint and is not one of the two fails, so the check cannot
        -- go blind.
        -- The companion pane's section titles are built from the table
        -- (PaneTitlesNameTheirOwnKeys) and asserted to name their rows' keys.
        -- Every hint is read twice: under the default table and under the
        -- remapped table of RemappedTableDrivesDispatch, where it names the
        -- user's key and no longer the default one.

    @invariant TmuxGlobalRowsTrackTheirBindings
        -- The key the board binds for the agent-tree toggle is the key of the
        -- tmux.global toggle_agent_tree row of the table it loaded, and the
        -- key it binds for the jump back is the key of the jump_to_dispatch
        -- row (TmuxKeysComeFromTheTable). Both are asserted under the default
        -- table and under a table with both rows overridden. Each row's
        -- default key is `Prefix+` followed by the runtime's default for that
        -- binding (agent-tree.allium: config.agent_tree_toggle_key;
        -- split-pane.allium: JumpBackToTuiWindow), written as the table
        -- writes keys (`Prefix+Space`), so changing a default in one place
        -- and not the other fails here. On quit the board unbinds the keys it
        -- bound, whatever the file says by then.

    @invariant NoFileIsTheDefaultTable
        -- With no override file in the data directory, every row's keys are
        -- its default_keys and the load reports no error.

    @invariant AnyOverrideFileGivesAWellFormedTable
        -- For generated override files, good and bad (unknown names, clashes,
        -- typed keys in text namespaces, chords, empty lists, entries that
        -- are not objects), the table the load produces satisfies
        -- HasAtLeastOneKey, KeyUniquePerContext, ContextsDoNotOverlapForAKey,
        -- ChordPrefixIsFree, TextNamespacesBindNoTypedKey,
        -- CatchAllIsNeverOverridden, TmuxGlobalRowsHaveOneKey and
        -- KeysAreCanonical. The load never fails: it always produces a table.

    @invariant EveryRefusalIsExercised
        -- Every KeyOverrideProblem literal has a test: an entry with that
        -- problem is refused with a message that says what to write instead,
        -- its row keeps its default keys, and a good entry in the same file
        -- still applies (for file_unreadable: no entry applies and the load
        -- reports the one error).

    @invariant RemappedTableDrivesDispatch
        -- press_every_row_key and RecordedActionMatchesRow also run over a
        -- remapped table, not only the default one. The remapped table swaps
        -- the keys of every pair of opposite rows (navigate_row_down and
        -- navigate_row_up, navigate_column_left and navigate_column_right,
        -- every _down / _up, _expand / _collapse and next / previous pair in
        -- every namespace, the companion and diff panes included), rotates
        -- the keys of every value family (the tag, wrap-up-mode and model
        -- letters, the repo digits) and rebinds at least one row in every
        -- namespace an override may name. Under it each key runs the row
        -- that lists it now, and a key the row no longer lists does not run
        -- it. A handler that reads the pressed key to pick a direction or a
        -- value fails here.

    @invariant ReadersFollowTheRemap
        -- Under the remapped table the help overlay and its title,
        -- keybinding_search, the companion pane's section titles and the
        -- pane startup screen's close hint name the user's keys
        -- (CatalogueIsTheDispatchTable, OverlayIsGeneratedNotWritten,
        -- OverlayTitleNamesItsOwnKeys, PaneTitlesNameTheirOwnKeys,
        -- PaneStartupScreenIsOutsideUsage), and no description or note shows
        -- a default key of a row that was rebound
        -- (DescriptionsNameNoKeyOfTheirOwn).
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The input mode a key is looked up in: one namespace per mode. A key means
-- something only within a namespace: `G` in board_normal and `G` in
-- agent_diff are two rows, and may run two different actions.
--
-- Published names (the MCP tool's `namespace` argument, the grouping headers in
-- its output and in the help overlay) are the dotted forms. One namespace per
-- input mode and overlay of the TUI:
--
--   board_normal                 board.normal                 the kanban board, no dialog or overlay open
--   board_detail                 board.detail                 the task-detail overlay
--   board_search                 board.search                 the live `/` search bar
--   board_help                   board.help                   the `?` help overlay
--   board_error                  board.error                  the error popup
--   board_text                   board.text                   a free-text field: task title,
--                                                             epic title, a new work
--                                                             package's title, a work
--                                                             package rename, display
--                                                             name, the admin name input
--   board_description_editor     board.description_editor     a new task's or epic's
--                                                             description is open in
--                                                             $EDITOR; one row,
--                                                             cancel_input [Esc]
--   board_filter                 board.filter                 the board-filter overlay (`f`)
--   board_filter_search          board.filter_search          typing the overlay's Epics-tab
--                                                             title search (`/` there)
--   board_picker_repo_path       board.picker.repo_path       repo-path field with candidate list
--   board_picker_base_branch     board.picker.base_branch     base-branch field with candidate list
--   board_picker_tag             board.picker.tag             tag step of task creation (also arms phoenix)
--   board_picker_wrap_up_mode    board.picker.wrap_up_mode    wrap-up-mode step of task creation
--   board_picker_model           board.picker.model           model step of task creation
--   board_picker_quick_dispatch  board.picker.quick_dispatch  quick-dispatch repo picker (`D`)
--   board_picker_move_to_epic    board.picker.move_to_epic    epic tree picker for moving a task (`m`)
--   board_picker_reparent_epic   board.picker.reparent_epic   epic tree picker for reparenting an epic (`m`)
--   board_picker_work_package    board.picker.work_package    work-package link picker (`w`; work-packages.allium)
--   board_picker_placement       board.picker.placement       workspace and visibility step of epic and package creation (workspaces.allium)
--   board_admin                  board.admin                  the admin screen: workspaces, members, super-admins, unseen items (`A`; admin-surfaces.allium)
--   board_confirm_quit                    board.confirm.quit
--   board_confirm_delete_task             board.confirm.delete_task
--   board_confirm_batch_delete            board.confirm.batch_delete
--   board_confirm_delete_epic             board.confirm.delete_epic
--   board_confirm_done                    board.confirm.done
--   board_confirm_retry                   board.confirm.retry
--   board_confirm_detach_tmux             board.confirm.detach_tmux
--   board_confirm_override_feed_owner     board.confirm.override_feed_owner
--   board_confirm_move_to_epic            board.confirm.move_to_epic
--   board_confirm_reparent_epic           board.confirm.reparent_epic
--   board_confirm_delete_repo_path        board.confirm.delete_repo_path
--   board_confirm_trust_repo              board.confirm.trust_repo
--   board_confirm_trust_repo_quick_dispatch  board.confirm.trust_repo_quick_dispatch
--   board_confirm_delete_work_package     board.confirm.delete_work_package
--   board_confirm_admin                   board.confirm.admin
--   agent_tree_tree              agent_tree.tree              companion pane, file-tree section
--   agent_tree_commits           agent_tree.commits           companion pane, Commits section
--   agent_tree_agents            agent_tree.agents            companion pane, Agents section
--   agent_diff                   agent_diff                   the agent-tree diff pane
--   tmux_global                  tmux.global                  prefixed tmux bindings
--
-- Text-field editing rows. board.text, board.picker.repo_path,
-- board.picker.base_branch and board.picker.quick_dispatch each take a
-- single-line text field, and each carries the same eight editing rows, all
-- records_usage false:
--   text_backspace               Backspace
--   text_delete_forward          Delete
--   text_cursor_left             Left
--   text_cursor_right            Right
--   text_cursor_home             Home
--   text_cursor_end              End
--   text_cursor_word_left        Ctrl+Left, Alt+Left, Alt+B
--   text_cursor_word_right       Ctrl+Right, Alt+Right, Alt+F
-- In the three pickers Up/Down already move the candidate list (recorded as
-- usual); Left/Right are caret motion in the field, not list motion.
-- board.search carries only text_backspace [Backspace], records_usage false:
-- the search bar has no caret, so it has no caret motion to bind.
-- board.filter's Backspace/Delete is not text editing: it runs
-- repo_filter_delete_repo_path and stays recorded. board.filter_search carries
-- only text_backspace [Backspace], records_usage false, like board.search.
--
-- Text namespaces. Six namespaces take typed text, and a plain character or
-- Space pressed there is data, not a binding: board.text, board.search,
-- board.filter_search, board.picker.repo_path, board.picker.base_branch and
-- board.picker.quick_dispatch. namespace_takes_text holds for exactly these.
-- No row of a text namespace lists a key that can be typed
-- (TextNamespacesBindNoTypedKey).
--
-- The keys shown in the inventories of this file are the DEFAULT keys. A
-- user's override may replace them (LoadKeyTable).
--
-- The panes' rows (agent_tree.tree, agent_tree.commits, agent_tree.agents,
-- agent_diff). The companion pane's three sections share the pane-wide keys
-- — all act in whichever section has focus — and differ in what Space/Enter
-- and h/l do. toggle_focus (s) flips between the browse view (tree and commits)
-- and the agents view (agent-tree.allium: SwitchAgentTreeView); switch_section
-- (Tab, BackTab) moves between tree and commits (SwitchAgentTreeBrowseFocus)
-- and has no row in agent_tree.agents. There the same keys are a separate
-- row, cycle_agent_filter, which flips the agents filter between all and
-- running (agent-tree.allium: CycleAgentListFilter). The commits section adds no
-- new key: Space/Enter take a section-specific meaning there exactly as they
-- already do in the agents section, so no key collides with another row:
--   agent_tree.tree
--     exit_pane                  q, Ctrl+C
--     toggle_focus               s
--     switch_section             Tab, BackTab
--     navigate_row_down          j, Down
--     navigate_row_up            k, Up
--     navigate_row_first         gg
--     navigate_row_last          G
--     navigate_half_page_down    Ctrl+D
--     navigate_half_page_up      Ctrl+U
--     collapse_directory         h, Left        collapses the directory under
--                                               the cursor, or steps out to
--                                               its parent
--     expand_directory           l, Right       context on_directory
--     toggle_diff                Space, Enter   context on_file
--     open_in_editor             v              context on_file
--     toggle_directory           Space, Enter   context on_directory
--   agent_tree.commits
--     exit_pane, toggle_focus, switch_section, navigate_row_down,
--     navigate_row_up, navigate_row_first, navigate_row_last,
--     navigate_half_page_down, navigate_half_page_up — the same
--     keys as in agent_tree.tree
--     select_source              Space, Enter   selects the row under the
--                                               cursor ("unstaged work" or a
--                                               commit) as what the tree and
--                                               diff pane show
--                                               (agent-tree.allium:
--                                               SelectAgentTreeSource); on the
--                                               row already selected, or with
--                                               no row, it does nothing and
--                                               records nothing
--     h, l, Left and Right have no row here and do nothing.
--   agent_tree.agents
--     exit_pane, toggle_focus, navigate_row_down, navigate_row_up,
--     navigate_row_first, navigate_row_last, navigate_half_page_down,
--     navigate_half_page_up — the same
--     keys as in agent_tree.tree
--     cycle_agent_filter         Tab, BackTab   flips the section between
--                                               every listed agent and the
--                                               running ones alone
--     jump_to_agent              Space, Enter   takes effect (and records)
--                                               only with another task's
--                                               agent row under the cursor:
--                                               it jumps to an attached
--                                               agent and resumes a detached
--                                               one;
--                                               on the pane's own task's row,
--                                               or with no row, it does
--                                               nothing and records nothing
--     h, l, Left and Right have no row here and do nothing.
--   agent_diff
--     exit_pane                  q, Ctrl+C
--     navigate_row_down          j, Down
--     navigate_row_up            k, Up
--     navigate_row_first         gg
--     navigate_row_last          G
--     navigate_half_page_down    Ctrl+D
--     navigate_half_page_up      Ctrl+U
--     Space, Enter and a have no row here and do nothing.
-- The panes' `gg` chord never times out (agent-tree.allium), unlike the
-- board's; that is the handler's property, not the row's (see
-- KeypressRunsItsRowsAction).
--
-- board.confirm is the FAMILY name of the per-dialog namespaces: no row has
-- it as its namespace, and each dialog's rows carry confirm_* action ids
-- (confirm_quit_yes, confirm_<dialog>_no, …). The
-- picker family (board.picker.*) is the same arrangement. Family names are
-- accepted by keybinding_search as a filter (ListKeybindingsViaMcp).
--
-- The task-detail zoom is not a namespace: it is a state of board.detail
-- (the detail view's zoomed flag, toggled by `z`), not an input mode, and
-- the same handler answers keys zoomed or not. It is the detail_zoomed
-- context.
--
-- A mode added to the board is a new literal here. A mode with no namespace
-- has no rows, so by KeyWithoutARowCannotAct every key in it would be inert —
-- the omission shows up the first time anyone presses a key, not later.
enum KeyNamespace {
    board_normal | board_detail | board_search | board_help | board_error |
    board_text | board_description_editor | board_filter | board_filter_search |
    board_picker_repo_path | board_picker_base_branch | board_picker_tag |
    board_picker_wrap_up_mode | board_picker_model | board_picker_quick_dispatch |
    board_picker_move_to_epic | board_picker_reparent_epic |
    board_picker_work_package | board_picker_placement | board_admin |
    board_confirm_quit | board_confirm_delete_task | board_confirm_batch_delete |
    board_confirm_delete_epic | board_confirm_done | board_confirm_retry |
    board_confirm_detach_tmux | board_confirm_override_feed_owner |
    board_confirm_move_to_epic | board_confirm_reparent_epic |
    board_confirm_delete_repo_path | board_confirm_trust_repo |
    board_confirm_trust_repo_quick_dispatch |
    board_confirm_delete_work_package | board_confirm_admin |
    agent_tree_tree | agent_tree_commits | agent_tree_agents | agent_diff |
    tmux_global
}

-- Who receives a key in a namespace. Every namespace but tmux_global is
-- handled by a dispatch process that reads the table — the board for board_*,
-- the agent-tree companion pane for agent_tree_*, the diff pane for
-- agent_diff, each its own process. tmux_global keys are handled by tmux
-- itself, so their rows describe rather than drive.
enum KeyReceiver { dispatch | tmux }

-- The condition a context-guarded row applies under. A fixed set, so a test
-- can set each one up and the overlap check is a table lookup rather than a
-- reading of prose. Each literal carries plain words as its display text
-- (the help overlay shows the words, never the literal; keybinding_search
-- returns both, because an override names a context by its literal).
--
-- Inventoried from the board's and the companion pane's handlers. The
-- conditions for one key are defined to be mutually exclusive: where a handler
-- tests them in priority order, each literal's definition below already
-- excludes every condition that outranks it, and that definition is the
-- same whichever key uses the literal. So ContextsDoNotOverlapForAKey holds
-- by definition rather than by luck, and a literal never means one thing
-- for one key and another thing for a second key. Where two keys rank the
-- same condition differently, they use two literals.
--
-- board.normal, view-level (q, Q, Esc, U, R). Esc's handler tests, in order:
-- a search active, a nested view open, cards selected. q and Q test only
-- whether a nested view is open and ignore search. A nested view is an epic
-- view or a work package view (work-packages.allium: ExitPackage): both sit
-- below the main board and q / Esc / Q leave them the same way. U and R act
-- on the epic the user is inside, so they test for an epic view alone — a
-- package view is not an epic, and they claim nothing there:
--   search_active             "with a search active"            Esc: clear_search
--                              (any view)
--   inside_nested_view        "inside an epic or work package   q: exit_epic; Q: exit_all_epics
--                              view" (search active or not)
--   inside_epic_view          "inside an epic view"             U, R
--                              (search active or not; a subset
--                              of inside_nested_view)
--   nested_view_no_search     "inside an epic or work package   Esc: exit_epic
--                              view, no search active"
--   top_level                 "on the top-level board"          q: quit
--                              (not in a nested view, search
--                              active or not)
--   with_selection            "on the top-level board, no       Esc: clear_selection
--                              search active, with cards
--                              selected or the cursor on a
--                              select-all row"
--   Per key: q's rows (inside_nested_view, top_level) and Esc's rows
--   (search_active, nested_view_no_search, with_selection) are each mutually
--   exclusive by these definitions. Esc on the top-level board with no
--   search, no selection and the cursor off a select-all row has no row and
--   does nothing; so do U and R outside an epic view.
-- board.normal, cursor-level (Enter, Space, i, m, w, b, V, H, L). The cursor is on at
-- most one of the first five (a select-all row is not a card or header);
-- off_epic_card is the complement of on_epic_card:
--   on_column_select_all      "on a column's select-all row"    Enter: select_all
--   on_folded_section         "on a folded section header"      Enter / Space:
--                                                                toggle_section_collapse
--   on_folded_epic_group      "on a folded epic group"          Enter / Space:
--                                                                toggle_epic_fold
--   on_epic_card              "on an epic card"                 Space: enter_epic;
--                                                                Enter: jump_to_deepest_epic;
--                                                                m: reparent_epic; H/L;
--                                                                w: link_work_package
--   on_work_package_card      "on a work package card"          Space: enter_work_package;
--                                                                V: toggle_work_package_visibility
--   on_task_card              "on a task card"                  i: open_task_detail;
--                                                                m: move_task_to_epic (the whole
--                                                                selection when tasks are selected);
--                                                                w: link_work_package;
--                                                                b: toggle_bookmark
--   on_flattened_task_card    "on a task card in a flattened    Enter: jump_to_task_epic
--                              column" (BoardView.flattens;      (does nothing when the task
--                              a subset of on_task_card)         has no epic)
--   on_unflattened_task_card  "on a task card in a column       Enter: open_task_detail
--                              that is not flattened"
--                              (the other part of on_task_card)
--   off_epic_card             "anywhere but an epic card"       H/L: move_task_forward /
--                              (a task card, a work package       move_task_backward
--                              card, or no card at all: an
--                              empty column, a folded header,
--                              a select-all row)
--   H/L on an epic card move that epic's status even with cards selected.
--   Anywhere else (off_epic_card) they move the selection if there is one,
--   else the card under the cursor, and record move_task_forward /
--   move_task_backward; with neither a selection nor a card under the cursor
--   the press changes nothing and records nothing. off_epic_card and
--   on_epic_card are mutually exclusive by definition. off_epic_card overlaps
--   the other cursor-level literals, but no key uses it together with them.
--   H/L on a work package card move nothing: a package has no status, and
--   the press records nothing.
-- board.normal, Space on a task card (the activation ladder, highest first;
-- each literal holds only when none above it does). "Window" means the task
-- has an agent tmux window; "stuck" is the third rung of the windowless
-- ladder, not a status:
--   task_on_other_machine     "on a task held by another        activate_unavailable
--                              machine"
--   task_pinned_in_split      "on the task shown in the split   jump_to_tmux (focuses
--                              pane"  (split view open, this    the pane)
--                              task pinned, the pane present)
--   task_window_split_open    "on a task with a window, split   swap_split_pane
--                              view open"
--   task_with_window          "on a task with an agent window"  jump_to_tmux
--                              (split view closed)
--   backlog_task              "on a Backlog task with no        dispatch_task
--                              window"
--   stuck_task                "on a stale, crashed or           open_retry_dialog
--                              unprovisioned task with no
--                              window": a Running, Review or
--                              Done task with no window that
--                              is Stale or Crashed, or is
--                              Running with neither window
--                              nor worktree and no dispatch
--                              possibly in flight
--   task_dispatching          "on a task whose dispatch is      activate_unavailable
--                              still starting": no window, no
--                              worktree, a dispatch possibly
--                              in flight, not stuck
--   task_with_worktree        "on a task with a worktree but    resume_task
--                              no window", not stuck
--   task_without_worktree     "on a task with neither window    activate_unavailable
--                              nor worktree", not stuck and no
--                              dispatch in flight — a Review
--                              or Done task, never a Running
--                              one (that is stuck_task)
-- board.detail:
--   detail_zoomed             "with the detail zoomed"          (no row guarded by it:
--                                                                `z` toggles zoom
--                                                                both ways and no other
--                                                                key changes meaning)
-- agent_tree.tree, the kind of the selected tree node:
--   on_directory              "on a directory"                  l / Right: expand_directory;
--                                                                Space / Enter: toggle_directory
--   on_file                   "on a file"                       Space / Enter: toggle_diff;
--                                                                v: open_in_editor
--   Mutually exclusive. With an empty or stale selection (no node, or one
--   the latest refresh removed) neither holds, so Space, Enter, l, Right and
--   v have no applicable row and do nothing.
--
-- A new condition is a new literal here; a row cannot invent one inline.
-- An overlay's tab or pane is not a KeyContext: board.filter's per-tab rows
-- (repo_filter_*, filter_toggle_done_epics, filter_search_epics,
-- filter_fold_*) and board.admin's per-pane rows have no context, apply in
-- every tab or pane, and name their tab or pane in the description. Pressed
-- elsewhere, their action does nothing and records nothing.
enum KeyContext {
    search_active | inside_nested_view | inside_epic_view | nested_view_no_search | top_level |
    with_selection |
    on_column_select_all | on_folded_section | on_folded_epic_group |
    on_epic_card | on_work_package_card | on_task_card | on_flattened_task_card |
    on_unflattened_task_card | off_epic_card |
    on_directory | on_file |
    task_on_other_machine | task_pinned_in_split | task_window_split_open |
    task_with_window | backlog_task | stuck_task | task_dispatching |
    task_with_worktree | task_without_worktree |
    detail_zoomed
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One row of the keybinding table. The table is the set of all KeyBindings;
-- every key handler, the help overlay and keybinding_search read it, and no
-- handler keeps a key list of its own. The short key hints in the status
-- bar, popups and form prompts, the help overlay's title and the companion
-- pane's section titles are each built from the row they stand for, so a
-- rebound row changes its hint with no second edit
-- (KeybindingDriftGate.HintsNameOnlyTableKeys checks them).
--
-- The table is the MERGED table: the rows the product ships with, each with
-- its default keys, and on top of them the user's accepted overrides
-- (KeyOverride, LoadKeyTable). An override replaces the keys of one row and
-- nothing else: it never adds or removes a row, and never changes an action,
-- context, description or note. Every reader reads the merged table; none
-- reads the defaults apart from it, except to show them beside an overridden
-- row.
entity KeyBinding {
    namespace:   KeyNamespace

    -- Every key that runs this row's action, written as typed: a single key
    -- ("j", "Enter", "Space"), a modified key ("Ctrl+D"), or a chord ("gg").
    -- A shifted letter is written as the bare uppercase letter ("L", "H",
    -- "G", "U", "R"), never "Shift+L": that is the form recorded usage
    -- history already holds. A modifier form like "Ctrl+D" is only for a
    -- modifier other than the letter-case Shift.
    -- A modified key is written modifier, then key: "Ctrl+D", "Alt+B",
    -- "Ctrl+Left". A letter after a modifier is written uppercase whatever
    -- the Shift state; Shift alone is never part of the name. A press with
    -- Ctrl or Alt held is looked up under that modified name and matches
    -- ONLY a row listing it (ModifiedPressMatchesOnlyItsOwnRow) — "Ctrl+D"
    -- is a key of its own, not a variant of "d". A row with two keys ("]"
    -- and "G" for navigate_row_last) is one action reachable two ways, not
    -- two rows.
    -- FeatureUsageEvent.detail records the key as key_label writes it, which
    -- is not always the table's form: Space is recorded as " " (a single
    -- literal space) while the table displays "Space", and key_label drops
    -- modifiers ("Ctrl+D" is recorded as "d"). Do not treat the two
    -- forms as identical when matching usage counts to rows.
    --
    -- Canonical key names. A key is written in exactly one way, and the
    -- table, the override file, the help overlay and keybinding_search all
    -- use it (is_key_name):
    --   a character      one printable character other than space, as typed;
    --                    case matters ("g" and "G" are two keys)
    --   a named key      Space, Enter, Esc, Tab, BackTab, Backspace, Delete,
    --                    Insert, Up, Down, Left, Right, Home, End, PageUp,
    --                    PageDown, F1 to F12
    --   a modified key   "Ctrl+", "Alt+" or "Ctrl+Alt+" before a character or
    --                    a named key, a letter uppercase ("Ctrl+D")
    --   a chord          exactly two characters pressed one after the other
    --                    ("gg"); no named or modified key, no longer form.
    --                    A two-letter name that is a named key ("Up", "F1"
    --                    to "F9") is that named key, never a chord, so those
    --                    chords cannot be written
    --   a tmux key       "Prefix+" before a character, a named key or a
    --                    modified key; only in tmux_global, and every
    --                    tmux_global key has this form
    -- Nothing else is a key name: not "ctrl+d", "enter", "Escape" or
    -- "Shift+G". Lookup is an exact match on the name, so a near-miss
    -- accepted silently would be a dead key. Three modified names are not key
    -- names either, because a terminal delivers another key for them:
    -- "Ctrl+I" (Tab), "Ctrl+M" (Enter) and "Ctrl+[" (Esc).
    -- A chord may be listed by any row outside the text namespaces and
    -- tmux_global. Its first character is pending input until the second
    -- arrives, so that character may not be a key of its own in the
    -- namespace (ChordPrefixIsFree).
    --
    -- One reserved entry, "any other key", is the catch-all: it matches a
    -- press no other applicable row in the namespace lists, and only then
    -- (lowest priority). It exists for the modes that answer
    -- "anything else": every y/Y confirmation dialog, where any key but y/Y
    -- is confirm_<dialog>_no, and the error popup, where any key is
    -- dismiss_error. The three dialogs with their own key sets have no
    -- catch-all and ignore an unlisted key: board.confirm.retry (r, f, Esc)
    -- and the two tree-picker confirmations, board.confirm.move_to_epic and
    -- board.confirm.reparent_epic (y, n, Esc/q). It is listed, so it is visible — the help overlay and
    -- keybinding_search show it like any other row.
    -- A catch-all row is fixed: it means "whatever no other row lists", so
    -- it has no key to replace, and no override names it
    -- (CatchAllIsNeverOverridden). The rows beside it can be rebound, and
    -- the catch-all then covers whatever they no longer list: when
    -- confirm_quit_yes lists only "o", y answers confirm_quit_no.
    keys:        Set<String>

    -- The keys the row ships with. keys equals default_keys unless an
    -- accepted override replaced them. Shown beside an overridden row by
    -- keybinding_search, and what the onboarding guide is checked against
    -- (onboarding-guide.allium), since a static page cannot follow a user's
    -- file.
    default_keys: Set<String>

    -- When the row applies: one KeyContext condition, shown to readers as
    -- its plain words ("on an epic card", "inside an epic view"). Absent
    -- means the row applies throughout its namespace.
    -- Context is how one key does different things within one mode without
    -- the table lying about it: `q` is two rows in board.normal — exit_epic
    -- "inside an epic or work package view" and quit "on the top-level board" — each
    -- described separately, each recorded under its own id.
    context:     KeyContext?

    -- Stable action id. Reuses the feature-usage action names
    -- (observability.allium: FeatureUsageEvent.action — navigate_row_last,
    -- toggle_help, exit_epic, confirm_quit_yes, …) so one id means one
    -- action across the whole usage history. Named after the effect, never
    -- the key: rebinding edits `keys`, not `action`. The agent-tree and diff
    -- panes name their actions the same way, reusing a board id where the effect is the same
    -- (`G` in agent_diff is navigate_row_last).
    -- An action id names ONE effect, in one direction and with one value.
    -- Moving down and moving up are two rows with two ids, and so is each
    -- value a key can pick. No row lists keys that do different things, and
    -- no handler reads the pressed key to decide what to do: the row alone
    -- decides, so rebinding is an edit to that row's keys and nothing else.
    -- The families, by namespace:
    --   board.normal                navigate_column_left, navigate_column_right;
    --                               navigate_row_down, navigate_row_up
    --   agent_tree.*, agent_diff    navigate_row_down, navigate_row_up;
    --                               navigate_half_page_down, navigate_half_page_up
    --   board.detail                scroll_detail_down, scroll_detail_up
    --   board.help                  scroll_help_down, scroll_help_up
    --   board.filter                filter_cursor_down, filter_cursor_up;
    --                               repo_filter_toggle_repo_1 … repo_filter_toggle_repo_9
    --   board.picker.repo_path,     picker_cursor_down, picker_cursor_up
    --   board.picker.base_branch
    --   board.picker.quick_dispatch quick_dispatch_cursor_down, quick_dispatch_cursor_up
    --   board.picker.tag            tag_picker_select_bug, _feature, _chore,
    --                               _pr_review, _research, _fix
    --   board.picker.wrap_up_mode   wrap_up_mode_picker_select_rebase, _pr, _done
    --   board.picker.model          model_picker_select_haiku, _sonnet, _opus, _fable
    --   board.picker.move_to_epic   move_to_epic_picker_down, _up, _expand, _collapse
    --   board.picker.reparent_epic  reparent_picker_down, _up, _expand, _collapse
    --   board.picker.work_package   work_package_picker_down, work_package_picker_up
    --   board.picker.placement      placement_picker_workspace_down,
    --                               placement_picker_workspace_up
    --   board.admin                 admin_navigate_down, admin_navigate_up;
    --                               admin_next_pane, admin_previous_pane
    -- A row whose keys all do the same thing stays one row:
    -- placement_picker_visibility, switch_section and cycle_agent_filter flip
    -- between two states whichever key is pressed, and y / Y both confirm.
    action:      String

    -- One line saying what pressing the key does, in the user's terms.
    -- It names none of the row's own keys: the keys are shown beside it and
    -- may be the user's. Where a description or note must point at ANOTHER
    -- row's key (the last-row note: "does not enter an epic, use" the
    -- enter_epic key), it refers to that row, and every reader shows the
    -- row's first current key in its place (DescriptionsNameNoKeyOfTheirOwn).
    description: String

    -- A warning or clarification that a reader — human or agent — needs to
    -- avoid a likely misreading. Absent on most rows.
    note:        String?

    -- Whether a press that runs this row records feature usage. Defaults to
    -- true. A row with records_usage false runs its action like any other
    -- row but records nothing: these are the editing keys of a text field
    -- (text_backspace, text_cursor_left, …), and the attribute is how the
    -- table carries observability.allium's text-entry exemption in
    -- KeypressRecordsFeatureUsage for the keys that have rows. That
    -- exemption has two halves: a typed character (no Ctrl or Alt held) has
    -- no row at all and is inserted as data, and a field's editing keys
    -- (Backspace, Delete, caret and word motion) are rows marked
    -- records_usage false. The two specs must agree: a key that HAS a row is
    -- exempt from recording there exactly when its row says records_usage
    -- false here. A press with Ctrl or Alt held is never text entry.
    -- The drift gate checks such a row by its effect and by asserting that
    -- nothing was recorded (UnrecordedRowsRecordNothing).
    records_usage: Boolean = true

    receiver: KeyReceiver = if namespace = tmux_global: tmux else: dispatch

    invariant HasAtLeastOneKey {
        keys.count >= 1
    }

    invariant DescribedInOneLine {
        description != ""
    }

    -- The catch-all is a key of its own row, never mixed with listed keys:
    -- a row either names keys or catches the rest.
    invariant CatchAllStandsAlone {
        "any other key" in keys implies keys.count = 1
    }

    -- A catch-all row keeps its one reserved key whatever the override file
    -- says. With the error popup's dismiss_error among them, a load error
    -- can always be dismissed.
    invariant CatchAllIsNeverOverridden {
        "any other key" in default_keys implies keys = default_keys
    }
}

-- Which process is loading the table. The board, the agent-tree companion
-- pane and the diff pane are three processes, and each loads its own.
enum KeyTableReader { board | companion_pane | diff_pane }

-- Why an entry of the override file is refused. A closed set, so a test can
-- produce each one (KeybindingDriftGate.EveryRefusalIsExercised).
--   file_unreadable               the file is not valid JSON, or is not a
--                                 list; no entry applies
--   malformed_entry               the entry is not an object, lacks namespace,
--                                 action or keys, has a field of another
--                                 name, or keys is not a list of strings
--   duplicate_entry               two entries name the same row; both are
--                                 refused
--   unknown_namespace             namespace is not a published namespace name
--                                 (a family name is not one)
--   unknown_action                the namespace has no row with that action
--   unknown_context               the action has no row with that context
--   ambiguous_row                 no context is given, the action has several
--                                 rows in the namespace and none is
--                                 context-free
--   empty_keys                    keys is an empty list: a row always keeps
--                                 at least one key
--   unknown_key_name              a key is not a canonical key name
--   key_not_allowed_in_namespace  a character, Space or a chord in a text
--                                 namespace; a chord, or a key that is not
--                                 "Prefix+" and one key, in tmux_global; a
--                                 "Prefix+" key anywhere else; more than one
--                                 key for a tmux_global row
--   catch_all_row                 the entry names a catch-all row, or lists
--                                 "any other key"
--   key_clash                     with the override applied, two rows of the
--                                 namespace would answer one key at once
--                                 (KeyUniquePerContext,
--                                 ContextsDoNotOverlapForAKey)
--   chord_prefix_clash            with the override applied, the first
--                                 character of a chord would also be a key
--                                 of a row in the namespace
--                                 (ChordPrefixIsFree)
enum KeyOverrideProblem {
    file_unreadable | malformed_entry | duplicate_entry | unknown_namespace |
    unknown_action | unknown_context | ambiguous_row | empty_keys |
    unknown_key_name | key_not_allowed_in_namespace | catch_all_row |
    key_clash | chord_prefix_clash
}

-- The user's override file: config.key_override_file_name in the data
-- directory (storage.allium: DataDirectory), the one --data-dir names. It is
-- a JSON list, one object per override:
--   [{"namespace": "board.normal", "action": "navigate_row_last", "keys": ["E"]},
--    {"namespace": "board.normal", "action": "select_all",
--     "context": "on_column_select_all", "keys": ["Enter"]}]
-- It is not a store setting (settings.allium): keys belong to this machine's
-- keyboard, and the panes, which open no store connection, read it too.
-- Dispatch never creates it unasked; keybinding_set writes it. A missing
-- file is not an error and means every row keeps its default keys.
entity KeyOverrideFile {
    directory: storage/DataDirectory
    path: String              -- <data directory>/config.key_override_file_name
    present: Boolean
    -- Parses as a JSON list. A file that does not is refused whole
    -- (file_unreadable): no entry applies.
    well_formed: Boolean
    -- The file's entries, in file order. Empty when the file is missing or
    -- unreadable.
    entries: List<KeyOverride>
}

-- One entry of the override file: the keys the user wants for one row. The
-- row is named by its namespace's published name and its action id, plus
-- the context literal where the action has more than one row in the
-- namespace. With no context the entry names the action's context-free row
-- when there is one, else its only row. select_all has both kinds of row in
-- board.normal: "a" anywhere, and Enter "on a column's select-all row".
entity KeyOverride {
    namespace: String
    action:    String
    context:   String?
    -- Replaces the row's whole key list. A key listed twice counts once.
    keys:      Set<String>

    -- Why the entry is refused; absent when it is accepted. Decided by
    -- LoadKeyTable.
    problem:   KeyOverrideProblem?
    accepted:  Boolean = problem = null
}

-- One line of what a load reports: the problem, the entry it is about (by
-- the names the entry gave, absent for file_unreadable) and a message that
-- says what to write instead.
value KeyLoadError {
    problem:   KeyOverrideProblem
    namespace: String?
    action:    String?
    context:   String?
    message:   String
}

-- One process's load of the table: who loaded, from which file, and what
-- the load refused. A process has one, made as it starts
-- (KeyTableLoading.OneLoadPerProcess).
entity KeyTableLoad {
    reader: KeyTableReader
    file:   KeyOverrideFile
    errors: List<KeyLoadError>
}

config {
    -- The override file's name in the data directory.
    key_override_file_name: String = "keybindings.json"
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Dispatch through the table ==

rule KeypressRunsItsRowsAction {
    -- The table drives dispatch, it does not merely describe it. Each key
    -- handler dispatch owns (every board mode, the companion pane's tree,
    -- Commits and Agents sections, the diff pane) answers a key by finding
    -- the row in its namespace that lists the key and whose context holds
    -- right now, and running that row's action. The handler never reads the
    -- pressed key to choose what the action does: a direction or a value is
    -- the row's own (KeyBinding.action), so rebinding any key is a change to
    -- that row's keys and nothing else, and an override file can make it.
    when: KeyPressed(user, namespace, key)

    requires: namespace != tmux_global

    let applicable = KeyBindings where this.namespace = namespace
                                   and (context = null or context_holds(context))
    let exact = (applicable where key in keys).first
    -- A modified press (Ctrl/Alt held) is never answered by the catch-all.
    let catch_all = if key_has_ctrl_or_alt(key): null
                    else: (applicable where "any other key" in keys).first
    let binding = exact ?? catch_all

    requires: binding != null

    ensures: KeyActionRun(namespace: namespace, action: binding.action, key: key,
                          records_usage: binding.records_usage)

    @guidance
        -- `binding` is at most one row: ContextsDoNotOverlapForAKey forbids
        -- two rows of a namespace that share a key from both applying at once.
        -- A listed key always beats the catch-all; the catch-all row runs only
        -- for a press no applicable row lists. When the catch-all runs, the
        -- recorded detail is the key actually pressed.
        -- context_holds evaluates one KeyContext against the board at press
        -- time — what the cursor is on, whether an epic view or split view is
        -- open. It is the same evaluation the drift gate uses to set a row's
        -- context up, so the row and the handler cannot read the condition
        -- differently.
        -- KeyActionRun is what KeypressRecordsFeatureUsage listens to
        -- (observability.allium), so the action id it records when the
        -- action takes effect is the id run here: the two cannot name
        -- different ids for the same press. The event carries the row's
        -- records_usage; a row with records_usage false runs its action here
        -- and is recorded by nothing: it is the text-entry exemption of that
        -- rule.
        -- `key` is the press's full name, modifiers included ("Ctrl+D"), so
        -- a modified press only finds a row that lists the modified form
        -- (ModifiedPressMatchesOnlyItsOwnRow).
        -- A chord ("gg") is one key for this rule: its first half is pending
        -- input, not a lookup, and only the completed chord is looked up.
        -- A character is the first half of a chord exactly when some row of
        -- the active namespace lists a chord that starts with it, in the
        -- table as loaded, so a chord the user gave a row works like the
        -- shipped one and a namespace whose chord was rebound away has none.
        -- How long a chord waits differs by namespace (the board's times out,
        -- the companion pane's does not — see agent-tree.allium); that is a
        -- property of the handler, not of the row.
}

rule KeyWithoutARowCannotAct {
    -- The converse, and the half that makes the table exhaustive by
    -- construction: a key no applicable row lists in the active namespace —
    -- and that no applicable catch-all row covers (a catch-all never covers a
    -- Ctrl/Alt press) — runs nothing, changes
    -- nothing and records nothing. There is no fallback arm
    -- and no default action. A binding that is not in the table does not
    -- exist.
    when: KeyPressed(user, namespace, key)

    requires: namespace != tmux_global
    requires: not KeyBindings.any(b =>
        b.namespace = namespace
        and (key in b.keys
             or ("any other key" in b.keys and not key_has_ctrl_or_alt(key)))
        and (b.context = null or context_holds(b.context)))
    requires: not observability/is_text_entry(key)

    -- observable output; no rule listens.
    ensures: KeyIgnored(namespace: namespace, key: key)

    @guidance
        -- Characters typed into a text-bearing mode (board.text, board.search,
        -- board.filter_search, the board.picker.* fields that take a query) are data, not bindings
        -- (observability.allium: is_text_entry); they are inserted, not
        -- looked up, and are deliberately outside this rule. Only typed
        -- characters are: a text field's editing keys (Backspace, Delete,
        -- caret and word motion) are rows (records_usage false), and a
        -- press with Ctrl or Alt held is never a typed character, even in a
        -- text mode, so an unbound one lands here.
        -- "Changes nothing" is about the key's own effect. What any press
        -- does, row or not, still happens on an unbound one: it ends a
        -- pending `gg` chord (the next key decides a chord — see
        -- agent-tree.allium: AgentTreeGgChordNeverExpires, and the board's
        -- chord window); in the companion and diff panes it acknowledges a
        -- shown notice (agent-tree.allium: ClearAgentTreeErrorNotice); and on
        -- the board, after every press, a board.normal cursor on an unseen
        -- task marks it seen (tasks.allium: SeeTaskByLandingOnIt) and a split
        -- pane whose pinned window is gone is respawned (split-pane.allium:
        -- SplitPaneRespawnOnWindowCleared). None of these records usage.
}

-- == Loading the table ==

rule LoadKeyTable {
    -- Each process builds its table once, as it starts: the board when it
    -- starts, a pane when it opens. The table is the default rows with the
    -- accepted entries of the override file applied.
    when: KeyTableReaderStarted(reader)

    let file = key_override_file(data_directory())

    -- BoardShowsKeyLoadErrors and KeyLoadErrorsAreLogged listen.
    ensures: KeyTableLoad.created(reader: reader, file: file,
                                  errors: key_load_errors(file))

    @guidance
        -- The load never fails and never stops a process starting. Whatever
        -- the file holds, the result is a table that satisfies every
        -- invariant of this spec, so a bad file cannot lock the user out.
        --
        -- Each entry is judged on its own, in this order, and the first
        -- problem found is the entry's problem (KeyOverrideProblem):
        -- malformed_entry, unknown_namespace, unknown_action,
        -- unknown_context or ambiguous_row, catch_all_row, empty_keys,
        -- unknown_key_name, key_not_allowed_in_namespace. Then, across
        -- entries, duplicate_entry: every entry that names a row another
        -- entry names. A refused entry leaves its row on its default keys
        -- and adds one KeyLoadError; the other entries still apply. A file
        -- that is not a JSON list is one file_unreadable error and no entry
        -- applies.
        --
        -- Clashes are judged over the whole table, never entry by entry:
        -- swapping two rows' keys is two entries, and either alone would
        -- clash with the other row's default. With every surviving entry
        -- applied, each one that takes part in a key_clash or a
        -- chord_prefix_clash — its row is one of the two rows — is refused,
        -- all of them together, and the check runs again on what is left,
        -- because a refused entry puts a default key back and that key can
        -- clash with another entry. It ends when no clash is left. The
        -- default table has none, so it always ends, and the result does not
        -- depend on the order of the file. The error names both rows and the
        -- key. A row added to the default table on a key a user's entry
        -- already took makes that entry clash: it is refused and reported
        -- like any other, and the new row keeps its key.
        --
        -- A message says what was wrong and what to write instead: an
        -- unknown key name gives the canonical spelling ("ctrl+d" is not a
        -- key name; write "Ctrl+D"), an unknown namespace, action or context
        -- lists the valid ones.
        --
        -- Nothing watches the file. A change applies to a process the next
        -- time that process starts. So a pane opened after a change uses the
        -- new keys while the running board still uses the ones it loaded;
        -- the two agree again once the board restarts. A pane sends the
        -- board the action id and key of each press
        -- (PanesRecordUsageLikeTheBoard), so recording does not depend on
        -- the two tables agreeing.
        --
        -- KeyTableReaderStarted is raised by the board as it starts, before
        -- it reads a key or binds a tmux key, and by each pane's renderer as
        -- it starts.
}

rule BoardShowsKeyLoadErrors {
    -- A load that refused anything tells the user, on the board.
    when: load: KeyTableLoad.created

    requires: load.reader = board
    requires: load.errors.count > 0

    -- observable output; no rule listens.
    ensures: KeyLoadErrorsShown(errors: load.errors)

    @guidance
        -- Shown in the error popup once the board has drawn. It names the
        -- file, says the rows listed keep their default keys, and lists each
        -- error's message. The popup's one row is a catch-all, which no
        -- override can change (CatchAllIsNeverOverridden), so any key
        -- dismisses it. A pane shows nothing: the board is where a load
        -- error is reported, and the same file gives a pane the same errors.
}

rule KeyLoadErrorsAreLogged {
    -- Every reader, board or pane, writes its load errors to the log.
    when: load: KeyTableLoad.created

    requires: load.errors.count > 0

    -- observable output; no rule listens.
    ensures: KeyLoadErrorsLogged(reader: load.reader, errors: load.errors)
}

-- == Writing the override file ==

rule SetKeyOverridesViaMcp {
    -- keybinding_set: an agent changes the user's keys the way the file
    -- does, one or more rows in one call.
    when: McpSetKeybindings(agent, changes)

    requires: changes.count >= 1
    -- A file that is not a JSON list is never written over.
    requires: not key_override_file_is_unreadable()
    -- The change must not add a problem the file did not already have.
    requires: not change_adds_a_problem(changes)

    -- observable output; no rule listens.
    ensures: KeyOverrideFileWritten(changes: changes)

    @guidance
        -- Each change names a row as an entry does — namespace, action,
        -- optional context — and gives its keys. A non-empty list sets the
        -- row's entry, replacing one the file already has. An EMPTY list
        -- removes the row's entry, which restores its default keys; that is
        -- how a default is restored, and the only place an empty list is
        -- accepted (in the file itself it is empty_keys).
        --
        -- The changes of one call are applied together and checked together,
        -- by the checks LoadKeyTable runs, over the default table plus the
        -- file's entries plus the changes. So a swap of two rows' keys is
        -- one call. If any change would be refused at load — an unknown
        -- name, a key the namespace does not allow, a clash with a row the
        -- call does not change — nothing is written, and the rejection gives
        -- each problem's message. An entry already in the file that the load
        -- refuses is not this call's problem: it is left as it is and named
        -- in the answer.
        --
        -- The write keeps every entry the call did not name and replaces the
        -- file in one step, so no reader sees half of it. With no file, the
        -- first accepted change creates it; removing the last entry leaves
        -- an empty list.
        --
        -- Nothing changes in the running board: the answer lists each row's
        -- new keys and says they apply when the board next starts, and that
        -- a pane opened before then already uses them (LoadKeyTable).
        -- Idempotent: repeating a call leaves the same file
        -- (mcp-task-tools.allium: ToolsAdvertiseAnnotations).
        -- A rejection is JSON-RPC -32602, as for an invalid namespace in
        -- keybinding_search.
}

-- == Reading the table ==

rule ListKeybindingsViaMcp {
    -- Agents are first-class users of the board, and an agent that cannot see
    -- the keys guesses them. keybinding_search returns the table itself, so
    -- what the agent reads is what the handlers run.
    when: McpListKeybindings(agent, namespace?, query?)

    -- The filter accepts a namespace name or a family name (board.confirm,
    -- board.picker). Only a name that is neither is rejected, and the
    -- rejection lists the valid namespace and family names, rather than
    -- returning an empty list that reads as "this mode has no keys".
    requires:
        if namespace != null:
            key_namespace_is_valid(namespace) or key_family_is_valid(namespace)

    -- observable output; no rule listens.
    ensures: KeybindingsListed(namespace: namespace, query: query)

    @guidance
        -- Read-only: no argument changes the table, and the call has no side
        -- effect beyond the usual mcp_tool usage record. Changing keys is
        -- keybinding_set (SetKeyOverridesViaMcp).
        -- The rows are the table the running board loaded (LoadKeyTable), so
        -- the keys are the user's where an override was accepted. A row
        -- whose keys are not its defaults also carries its default keys. A
        -- row whose entry in the override file no longer matches what the
        -- board loaded — set, changed or removed since — also carries its
        -- pending keys, and the reply says they apply when the board next
        -- starts. A context is returned as its words and as its literal,
        -- since keybinding_set and the file name it by the literal.
        -- The index also lists the errors of the board's load, each with its
        -- message, and says so in one line when there are none to list.
        -- The whole table is about 44 KB, so a call with neither namespace
        -- nor query returns an index and not the table: one entry per
        -- namespace, in the KeyNamespace order above, with its published
        -- dotted name, receiver, number of rows and number of overridden
        -- rows, and a last line saying to
        -- pass namespace for a group's keys or query to search every group.
        -- With a namespace or a query the output is grouped by namespace, in
        -- KeyNamespace order; within a group, every row with its keys,
        -- context, action id, description and note (context and note omitted
        -- when absent; context shown as its plain words). With a namespace
        -- name supplied, exactly that one group is returned; with a family
        -- name, every group in that family (board.confirm returns every
        -- board.confirm.* group), in KeyNamespace order.
        -- query keeps the rows whose keys, action id or description contain it,
        -- ignoring case, and drops a group left with none. It narrows the
        -- groups namespace chose, so the two combine. A query that matches
        -- nothing says which namespace and query it applied, and is not an
        -- error. The reply is compact JSON, not pretty-printed.
        -- tmux_global rows are included and marked as handled by tmux, so an
        -- agent learns the prefix bindings exist without mistaking them for
        -- keys the board answers.
        -- An invalid namespace rejects with JSON-RPC -32602, the same code
        -- usage_read uses for an invalid category (mcp-task-tools.allium:
        -- QueryUsageViaMcp).
        -- The tool description says what the call returns and that the filter
        -- takes a namespace or family name. It carries no worked example: the
        -- rejection lists the valid names, and a real response shows the
        -- output better than a sample does (mcp-task-tools.allium:
        -- ToolDescriptionsStateBehaviourAndNameNoCode).
}

rule HelpOverlayIsTheTable {
    -- `?` opens the help overlay, and the overlay is rendered from the table:
    -- every row, grouped by namespace, keys beside description, context and
    -- note shown where present. There is no hand-written key list behind it,
    -- so a key that is in the table is in the overlay and a key that is not,
    -- is in neither.
    when: HelpOverlayOpened(user)

    -- observable output; no rule listens.
    ensures: KeybindingsShown(namespace: null)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- At most one row per key per context within a namespace. Two rows with the
-- same key and the same context would leave KeypressRunsItsRowsAction with
-- two actions to choose from, and whichever it picked, the other row would be
-- documentation for a binding that never runs.
invariant KeyUniquePerContext {
    for a in KeyBindings:
        for b in KeyBindings:
            (a != b and a.namespace = b.namespace and a.context = b.context)
                implies not a.keys.any(k => k in b.keys)
}

-- The stronger property: for the same key, no two contexts in a namespace can
-- hold at once. contexts_overlap is a fixed relation over KeyContext — the
-- literals for one key are defined mutually exclusive (see KeyContext), and
-- the relation records which pairs can co-occur — so the check is a lookup
-- the drift gate can run, not a judgement about prose. A row with no context
-- applies everywhere in its namespace, so it overlaps every other row that
-- shares one of its keys.
invariant ContextsDoNotOverlapForAKey {
    for a in KeyBindings:
        for b in KeyBindings:
            (a != b and a.namespace = b.namespace
             and a.keys.any(k => k in b.keys))
                implies (a.context != null and b.context != null
                         and not contexts_overlap(a.context, b.context))
}

-- An action has one row per context in a namespace. Two keys for one effect
-- in one context are one row with two keys, not two rows with the same id:
-- otherwise their descriptions could disagree about what the one action does.
-- The same action in two contexts is two rows (toggle_epic_fold is `Z`
-- anywhere and Enter / Space "on a folded epic group").
invariant ActionOncePerContext {
    for a in KeyBindings:
        for b in KeyBindings:
            (a != b and a.namespace = b.namespace and a.context = b.context)
                implies a.action != b.action
}

-- A chord's first character is pending input, so it cannot also be a key:
-- the press would have to both wait for a second character and act at once.
-- Checked across the whole namespace whatever the rows' contexts, so the
-- answer never depends on where the cursor is. Two chords may share a first
-- character. is_chord holds for a two-character key name that is not a named
-- key ("Up" and "F1" to "F9" are named keys).
invariant ChordPrefixIsFree {
    for a in KeyBindings:
        for b in KeyBindings:
            a.namespace = b.namespace
                implies not a.keys.any(c => is_chord(c) and chord_first_key(c) in b.keys)
}

-- In a text namespace a character or Space is typed data, so no row there
-- lists one, nor a chord, which is made of characters. A row of a text
-- namespace lists only named keys other than Space, and modified keys: Esc,
-- F2, Ctrl+G, Alt+Backspace. It holds for every row of the namespace, the
-- editing rows included.
invariant TextNamespacesBindNoTypedKey {
    for b in KeyBindings:
        namespace_takes_text(b.namespace)
            implies not b.keys.any(c => is_typed_key(c) or is_chord(c))
}

-- A tmux_global row is one tmux binding, so it has exactly one key, and no
-- two of them share it (KeyUniquePerContext already forbids the second).
invariant TmuxGlobalRowsHaveOneKey {
    for b in KeyBindings:
        b.namespace = tmux_global implies b.keys.count = 1
}

-- Every key of every row is a canonical key name or the reserved catch-all
-- (see KeyBinding.keys). An override with any other spelling is refused at
-- load (unknown_key_name), so the merged table holds none either.
invariant KeysAreCanonical {
    for b in KeyBindings:
        b.keys.all(c => is_key_name(c) or c = "any other key")
}

-- An accepted override sets its row's keys, exactly.
invariant AcceptedOverrideSetsItsRowsKeys {
    for o in KeyOverrides:
        for b in KeyBindings:
            (o.accepted and override_names_row(o, b)) implies b.keys = o.keys
}

-- Nothing else moves a row off its default keys: not a refused entry, not a
-- missing or unreadable file. With no file the table is the default table.
invariant OnlyAnAcceptedOverrideChangesKeys {
    for b in KeyBindings:
        b.keys != b.default_keys
            implies KeyOverrides.any(o => o.accepted and override_names_row(o, b))
}

-- The `G` row carries the warning this spec exists for (see "Why this
-- exists" above). Expressed on the
-- one row that must carry it rather than as a general rule, because a note is
-- table content, and this is the one note the table may not lose.
invariant LastRowKeyWarnsItDoesNotEnterAnEpic {
    for b in KeyBindings:
        (b.namespace = board_normal and b.action = "navigate_row_last")
            implies b.note != null
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- The parties are core.allium's: the operator at the keyboard and the MCP
-- client reading the catalogue.

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- Where keypresses enter. One surface for every dispatch-received namespace:
-- the namespace is the mode the key arrived in, decided by which pane has
-- focus and which mode it is in, not chosen by the user.
surface KeyInput {
    facing user: core/Operator

    provides:
        KeyPressed(user, namespace, key)

    @guarantee OneLookupPerPress
        -- Every press in a dispatch-received namespace is answered by exactly
        -- one of KeypressRunsItsRowsAction or KeyWithoutARowCannotAct (or is
        -- text entry). There is no third path.

    @guarantee ModifiedPressMatchesOnlyItsOwnRow
        -- A press with Ctrl or Alt held is looked up under its modified name
        -- (see KeyBinding.keys: "Ctrl+D", "Alt+B", "Ctrl+Left") and matches
        -- only a row that lists that modified form. It never falls back to
        -- the bare key's row: Ctrl+c in board.normal does nothing (it is not
        -- copy_task), and Ctrl+b at the tag step does not pick Bug. It is
        -- never text entry, so a modified press with no row is answered by
        -- KeyWithoutARowCannotAct like any other unbound key.
        -- The catch-all ("any other key") does NOT cover a modified press: it
        -- answers only plain presses (KeypressRunsItsRowsAction's catch_all).
        -- In a y/Y confirmation dialog Ctrl+y leaves the dialog open, and in
        -- the error popup a Ctrl/Alt press does not dismiss.
        -- Every modified key that acts therefore has a row: Ctrl+D / Ctrl+U
        -- (navigate_half_page_down / _up) and Ctrl+C (exit_pane) in the panes, and
        -- Ctrl+Left / Ctrl+Right / Alt+Left / Alt+Right / Alt+B / Alt+F
        -- (text_cursor_word_left / _right) in the text fields.
        -- Recorded usage detail drops modifiers (key_label; see
        -- KeyBinding.keys), so Ctrl+D is recorded as "d". The action id
        -- (navigate_half_page_down) tells what ran; the detail alone does not.
        -- The keys named in this guarantee are the default keys; the rule is
        -- the same for whatever modified key a row lists.

    @guarantee PanesRecordUsageLikeTheBoard
        -- The agent-tree companion pane and the diff pane record each press
        -- that takes effect exactly as the board does
        -- (observability.allium: KeypressRecordsFeatureUsage), under the
        -- row's action id, with the key_label as detail. They are separate
        -- processes from the board and open no store connection
        -- (agent-tree.allium: PanesReadThroughTheBoard), so the board does
        -- the recording: each press that takes effect is sent to the running
        -- board over the board's port — the hook endpoint, as
        -- ObservedEvent::PaneKey { task_id, action, key } — and the board
        -- records the keybinding usage event through
        -- record_usage_event_logged, so a failed write warns on the usage
        -- target (observability.allium: UsageWriteFailureIsSilent). The board
        -- does not treat a PaneKey as a task change: it pushes no refresh
        -- (agent-health.allium: HookEventsPushALiveRefresh does not apply).
        --
        -- A pane sends only presses that take effect: a press with no row,
        -- a jump_to_agent with no other agent under the cursor, a
        -- select_source on the row already selected, an expand_directory on a
        -- directory that is already open, or a collapse_directory with nothing
        -- selected, sends nothing. The sends run beside the pane's render loop, so a slow
        -- board never delays a key, and the pane waits for outstanding sends
        -- before it exits, so the closing press is not lost. A board that
        -- cannot be reached drops the press, with a warning from the pane,
        -- as an unreachable board drops an observed hook event
        -- (agent-health.allium: EventIsDroppedWhenTheBoardIsDown); the press
        -- itself still takes effect in the pane. Their namespaces
        -- (agent_tree.tree, agent_tree.commits, agent_tree.agents, agent_diff)
        -- have rows like the
        -- board's — see the pane inventory under KeyNamespace.

    @guarantee PanesLoadTheirOwnTable
        -- The companion pane and the diff pane are handed the data directory
        -- and load the table themselves, from the same override file and by
        -- the same rule as the board (LoadKeyTable). They do not ask the
        -- board for it. A pane's keys, section titles and startup-screen
        -- hint all come from the table it loaded.

    @guarantee DescriptionEditorTakesOnlyEsc
        -- The new-task and new-epic forms open the description in $EDITOR, in
        -- a tmux window of its own, and the board stays live meanwhile
        -- (board.description_editor). While it is open the board takes only
        -- Esc, which cancels the whole form. A typed character, Enter or a
        -- caret key does nothing: the description comes from the editor
        -- alone, and a board press never submits one. An editor result that
        -- arrives after the cancel finds no form and creates nothing. The
        -- step has no text field, so a typed character there is not text
        -- entry: it has no row and changes nothing (KeyWithoutARowCannotAct).
        -- When the editor never opens (one is already open, or its window
        -- or file cannot be made), the board shows the error and the form
        -- stays at this step until Esc; the status line names Esc.

    @guarantee PaneTitlesNameTheirOwnKeys
        -- The companion pane's Agents and Commits section titles name the
        -- keys that switch the agents filter, the section and the view
        -- ("Agents (Tab: running, s: browse)", "Commits (Tab, s: agents)"),
        -- read from the first key of the agent_tree.agents and
        -- agent_tree.commits rows cycle_agent_filter, switch_section and
        -- toggle_focus. Rebinding a row changes its title with no second
        -- edit, as with the help overlay's title (OverlayTitleNamesItsOwnKeys).

    @guarantee PaneStartupScreenIsOutsideUsage
        -- While a companion or diff pane waits for its task, or shows its
        -- startup failure (agent-tree.allium:
        -- AgentTreePaneSaysWhatItIsWaitingFor), it answers exactly the keys
        -- of its namespace's exit_pane row (agent_tree.tree or agent_diff),
        -- found by a lookup of that row rather than a hard-coded check. The
        -- row is the pane's OWN: the companion pane answers agent_tree.tree's
        -- exit_pane row and the diff pane answers agent_diff's, so rebinding
        -- one pane's row never changes what the other pane's startup screen
        -- answers. So the row's own modifier rule holds there too
        -- (ModifiedPressMatchesOnlyItsOwnRow): `q` and Ctrl+C close the pane,
        -- Alt+q does nothing. Every other key does nothing. The failure
        -- screen's close hint is built from the same row's keys ("press q or
        -- Ctrl+C to close this pane"), as the help overlay's title is
        -- (OverlayTitleNamesItsOwnKeys), so it never names a key the screen
        -- does not answer. The press records
        -- no usage: the screen has not resolved a task to record against,
        -- and it answers one key only, so there is no choice of binding for
        -- the count to inform.

    @guidance
        -- Accepted limitation, kept deliberately: a navigation press
        -- (navigate_row_down, navigate_row_up, navigate_row_first,
        -- navigate_row_last, navigate_half_page_down, navigate_half_page_up
        -- and the board's column and scroll motions) is
        -- recorded even when the cursor or scroll is already at the edge and
        -- nothing moves. The board and both panes behave this way, so a
        -- navigation count means the same in every pane and across the whole
        -- usage history. This is the one exception to "a press that
        -- changes nothing records nothing"; it does not extend further. H/L
        -- with neither a selection nor a card under the cursor move nothing
        -- and record nothing (see the off_epic_card context).
}

surface KeybindingCatalogue {
    facing agent: core/McpClient

    exposes:
        for binding in KeyBindings:
            binding.namespace
            binding.keys
            binding.default_keys
            binding.context
            binding.action
            binding.description
            binding.note
            binding.receiver

    provides:
        McpListKeybindings(agent, namespace?, query?)

    @guarantee CatalogueIsTheDispatchTable
        -- The rows returned are the rows the key handlers look keys up in, not
        -- a copy maintained beside them. Adding, removing or rebinding a key
        -- changes this output with no second edit. That holds for a key the
        -- user rebound as for one the product ships: the rows are the merged
        -- table the board loaded.

    @guarantee OverridesAreVisible
        -- An agent can tell a user's key from a shipped one and can undo it:
        -- an overridden row carries its default keys, a row with a change
        -- waiting for a restart carries its pending keys, every context
        -- carries its literal, and the index lists the load errors
        -- (ListKeybindingsViaMcp).

    @guarantee NotesTravelWithTheirRows
        -- A row's note and context are returned with it whenever the row is
        -- returned. A warning like `G`'s ("last row of the column; does not
        -- enter an epic, use Space") is useless if it is only in a document
        -- the agent never opens.
}

surface HelpOverlay {
    facing user: core/Operator

    exposes:
        for binding in KeyBindings:
            binding.namespace
            binding.keys
            binding.context
            binding.description
            binding.note
            binding.receiver

    provides:
        HelpOverlayOpened(user)

    @guarantee OverlayIsGeneratedNotWritten
        -- Same table, same rows, same contexts and notes as
        -- KeybindingCatalogue. The two may differ in layout, never in content.

    @guarantee DescriptionsNameNoKeyOfTheirOwn
        -- No description or note spells out a key of its own row; the keys
        -- shown beside it are the row's current keys. Where one points at
        -- another row's key, the overlay and keybinding_search show that
        -- row's first current key (KeyBinding.description). So after a
        -- remap no line of the overlay names a key that no longer does what
        -- the line says.

    @guarantee OverlayTitleNamesItsOwnKeys
        -- The overlay's border title is built from the table too: it names
        -- the keys of board.help's scroll_help_down and scroll_help_up rows
        -- and of its close_help row (with the default keys, "j/Down/k/Up
        -- scroll, ? or Esc close"). Rebinding any of these rows
        -- changes the title with no second edit; the title never names a key
        -- the overlay does not answer to.

    @guidance
        -- docs/reference.md's Key Bindings section is a pointer at this
        -- overlay and at keybinding_search, with no key list of its own.
        -- What a key does in a particular case (what Space does on a card with
        -- no worktree, how `/` matches ids, …) lives in the owning row's
        -- description or note, so it is reachable from both readers rather
        -- than from neither.
}

-- Where a change to the user's keys enters: keybinding_set.
surface KeyOverrideWrites {
    facing agent: core/McpClient

    provides:
        McpSetKeybindings(agent, changes)

    @guarantee ARefusedChangeWritesNothing
        -- A call is all or nothing. If any of its changes would be refused
        -- at load, the file is left exactly as it was
        -- (SetKeyOverridesViaMcp).

    @guarantee WritersShareTheLoadersChecks
        -- Whatever writes the override file checks a change with the checks
        -- LoadKeyTable runs, not with a copy of them, so nothing dispatch
        -- writes is refused at the next start.

    @guarantee TheAnswerSaysWhenItApplies
        -- The answer lists each changed row with its new keys and says the
        -- change applies when the board next starts.
}

-- Where a process announces that it needs its table. The board and the two
-- panes each raise it once, as they start.
surface KeyTableLoading {
    facing _: core/BoardProcess

    provides:
        KeyTableReaderStarted(reader)

    @guarantee OneLoadPerProcess
        -- A process loads its table once and keeps it until it exits. No
        -- later change to the file reaches it.
}

-- The tmux_global rows and the keys tmux is told to bind.
surface TmuxPrefixKeys {
    facing _: core/Tmux

    exposes:
        for binding in KeyBindings where namespace = tmux_global:
            binding.keys
            binding.action

    @guarantee TmuxKeysComeFromTheTable
        -- The board binds, for jump_to_dispatch and for toggle_agent_tree,
        -- the key of that row in the table it loaded (split-pane.allium:
        -- JumpBackToTuiWindow; agent-tree.allium: BindAgentTreeToggle). The
        -- row's key is "Prefix+" and one key, and the part after "Prefix+"
        -- is translated to tmux's own spelling in one place: a character as
        -- itself, a named key by tmux's name for it, "Ctrl+X" as "C-x" and
        -- "Alt+X" as "M-x".

    @guarantee TheBoardUnbindsWhatItBound
        -- On quit the board unbinds the keys it bound when it started, not
        -- the keys the file names by then.

    @guarantee NoStalePrefixKeySurvivesAStart
        -- A board that was killed leaves its keys bound. Before it binds,
        -- a starting board removes every prefix binding whose command is one
        -- of its own two commands, whatever key holds it, so a key the user
        -- has since moved away from does not go on jumping to the board or
        -- toggling the pane.
}

surface KeybindingTestSuite {
    facing caller: TestSuite

    contracts:
        demands KeybindingDriftGate
}
