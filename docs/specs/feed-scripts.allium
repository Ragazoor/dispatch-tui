-- allium: 3
-- feed-scripts.allium
--
-- Scope: The reference feed-script templates dispatch ships under `scripts/`.
--        What each one queries, which config files it reads, which Signals and
--        labels it emits, and why each decision is the script's rather than the
--        runtime's.
-- Excludes: The feed runtime itself — the FeedItem wire format, the Signal
--           vocabulary and what each Signal means, routing, the review
--           exclusion, upsert semantics, polling cadence, the verify-feed
--           validator and the install of scripts and configs (all in
--           feeds.allium); the domain model (core.allium).
--
-- These templates are USER-OWNED EXECUTABLES, not part of the feed runtime:
-- the generic runtime never embeds upstream-specific knowledge. This file is
-- normative for anyone editing `scripts/`.
--
-- Each script is a contract below. A script takes no arguments: it reads its
-- `.conf` files from its own directory and writes a FeedItem array to stdout.
-- Every script ships with EMPTY config placeholders (REPOS=(), ORGS=(),
-- TEAMS=(), BOT_AUTHORS=(), RELEASE_BOT_AUTHORS=(), LOG_FILE="", REPO_URL=""),
-- which the `.conf` files beside it override. The `.conf` files are the edit surface
-- (feeds.allium: InstallShippedFeedConfigs installs them create-new-only), so
-- a script is inert until the user fills in its `.conf` file, and its own
-- text stays what dispatch ships.
--
-- The `.conf` files:
--   - repos.conf     REPOS, the "<org>/<repo>" list. Read by fetch-cve.sh,
--                    fetch-security.sh, fetch-dependabot.sh and the
--                    repo-scoped passes of fetch-reviews.sh.
--   - org.conf       ORGS. Read only by fetch-reviews.sh's org-scoped pass.
--   - teams.conf     TEAMS, "<org>/<team-slug>" entries. Read only by
--                    fetch-reviews.sh's team pass.
--   - bots.conf      BOT_AUTHORS and RELEASE_BOT_AUTHORS (BotsConf).
--   - log-warnings.conf  LOG_FILE and REPO_URL. Read only by
--                    fetch-log-warnings.sh.
-- Each scope is its own file so that widening one query (my reviews to whole
-- orgs, say) cannot widen another (the team or bot passes).

use "./core.allium" as core
use "./feeds.allium" as feeds

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- == bots.conf ==
--
-- Three scripts read bots.conf: fetch-reviews.sh, fetch-dependabot.sh and
-- fetch-cve.sh. A bot's login is deployment-specific (a self-hosted Renovate
-- app is named after its installing org, e.g. `app/kognic-renovate`, not
-- `app/renovate`), so no script names one bot itself.
--
-- WHY A BAD CONF IS FATAL RATHER THAN A WARNING. The readers consume an entry
-- in incompatible ways. fetch-reviews.sh derives a PR author login by
-- stripping "app/" and appending "[bot]"; the gh queries take the entry
-- verbatim. An entry written the other natural way, "dependabot[bot]", became
-- "dependabot[bot][bot]" in the first and matched nothing in the second. Both
-- symptoms look exactly like "this bot has no open PRs", the one reading a
-- user cannot disprove from the board. A malformed entry is a typo in a
-- hand-edited file: it does not fix itself, and every cycle it survives
-- produces a board that looks complete and is not. Warning and keeping the
-- entry leaves the wrong board in place. Warning and DROPPING it is worse: an
-- all-invalid list shrinks to empty, and an empty list arms the fallbacks
-- (FetchDependabot.EmptyListFallsBack, FetchReviews.TagFromAuthorConfig), the
-- same silent misreading in a different form.
--
-- The cost is accepted and named: the cycle emits NOTHING, so unrelated cards
-- of that feed stay as they were until the conf is fixed, and the feed reports
-- a failed run (feeds.allium: FeedCommandFailure, a non-zero exit). An empty
-- board is a question the user asks; a subtly wrong one is not. The
-- diagnostic surface is `dispatch verify-feed`, which prints the script's
-- stderr and exits 1.
--
-- WHY A BOT ON BOTH LISTS IS FATAL. The two lists claim opposite things about
-- one bot ("it opens dependency bumps", "it opens releases") and the readers
-- would resolve the contradiction differently, silently: fetch-reviews.sh
-- checks the release list first and tags the PR release-please,
-- fetch-dependabot.sh lists it as a dependency bump. Only the deployment
-- knows which list it meant.
--
-- WHY THE CHECK LIVES IN THE SCRIPTS. The conf is installed create-new-only,
-- so an existing deployment's copy is never rewritten, while the scripts are
-- kept up to date (feeds.allium: InstallShippedFeedScripts). A check shipped
-- inside the conf would reach only deployments that never had one. There is
-- no shared library: the scripts are standalone executables installed
-- independently, so each reader carries its own copy of the check.
--
-- A BOT RUNNING UNDER A PLAIN USER ACCOUNT IS NOT EXPRESSIBLE, deliberately.
-- A bare "<login>" entry would be passed to gh and matched as a PR author
-- verbatim, a second entry form every reader must agree on: one entry, two
-- meanings, depending on which reader sees it. A deployment that needs one
-- wants a spec decision of its own, not a widened pattern.
--
-- Two other shapes are deferred, not rejected. A DEP_BOT_AUTHORS list
-- defaulting to BOT_AUTHORS would let a release bot's PRs reach the board
-- without arming the dependency runbook; RELEASE_BOT_AUTHORS gives that from
-- the other side. Telling an UNSET file from a deliberately empty one (every
-- reader pre-declares the arrays empty before sourcing, so the two read the
-- same) would turn "an empty list means three things" into one rule plus a
-- table of per-reader defaults. Both touch all three readers.

contract BotsConf {
    -- Whether one bots.conf entry is in the one accepted form.
    is_app_form: (entry: String) -> Boolean

    @invariant OneEntryForm
        -- BOT_AUTHORS and RELEASE_BOT_AUTHORS hold gh's app form, "app/<slug>",
        -- and nothing else: is_app_form(entry) is a full match of
        -- config.bot_author_form. A PR author login is "<slug>[bot]"; every
        -- comparison between an entry and a login normalises between the two
        -- forms and ignores case.

    @invariant AMalformedEntryIsFatal
        -- Each reader checks the entries it USES, right after sourcing the
        -- file and before any query: fetch-reviews.sh both lists,
        -- fetch-dependabot.sh and fetch-cve.sh BOT_AUTHORS. On any entry that
        -- fails is_app_form the script exits non-zero and writes nothing to
        -- stdout.

    @invariant ABotOnBothListsIsFatal
        -- All three readers compare the two lists right after the form check.
        -- An entry on both, compared case-insensitively ("app/Foo" and
        -- "app/foo" overlap), makes the script exit non-zero and write
        -- nothing to stdout.

    @invariant ListsAreComparedAsConfigured
        -- The overlap check runs before any fallback. A fallback
        -- (config.fallback_dependency_bot, fetch-reviews.sh's "[bot]" suffix
        -- tagging) is a default, not a listing, so it never overlaps.

    @invariant EveryOffenderIsNamed
        -- The checks walk every entry of both lists before exiting and write
        -- one stderr line per offender, naming the entry and the list it sits
        -- in. A conf with three typos costs one fix round-trip, not three.

    @invariant TheShippedStateNeverFails
        -- An absent bots.conf, an empty list, and an old conf without
        -- RELEASE_BOT_AUTHORS all read as empty lists (each reader pre-declares
        -- both arrays empty before sourcing), and an empty list has nothing to
        -- check and overlaps nothing. config.fallback_dependency_bot is itself
        -- in the app form. The shipped bots.conf sets both lists empty and
        -- documents `app/kognic-gha-release-bot` as the release-bot example.

    @guidance
        -- Implementation: the validation block after `source bots.conf` in
        -- scripts/fetch-reviews.sh, scripts/fetch-dependabot.sh and
        -- scripts/fetch-cve.sh. Coverage: scripts/test-bots-conf.sh.
}

-- == scripts/fetch-dependabot.sh ==
--
-- Kept for reference and for a user wiring a hand-rolled generic epic.
-- fetch-reviews.sh's bot-author pass now surfaces the same bot PRs under the
-- reviews parent, so reaching the bots sub-epic does not depend on it.

contract FetchDependabot {
    fetch_dependabot: (repos: List<String>, bot_authors: List<String>) -> List<feeds/FeedItem>

    @invariant OnePassPerBot
        -- Lists open PRs with `gh pr list --author <bot>`, one pass per entry
        -- of BOT_AUTHORS and per repo in REPOS. It reads RELEASE_BOT_AUTHORS
        -- only for BotsConf.ABotOnBothListsIsFatal, never checks that list's
        -- form, and never lists PRs by it: a release PR is not a dependency
        -- bump.

    @invariant EmptyListFallsBack
        -- An absent or empty BOT_AUTHORS falls back to
        -- config.fallback_dependency_bot, so an existing copy keeps emitting
        -- what it emitted before bots.conf existed.

    @invariant EveryItemIsTaggedDependabot
        -- Every emitted item carries tag dependabot, whoever its author is.
}

-- == scripts/fetch-cve.sh and scripts/fetch-security.sh ==
--
-- Most alerts already have a fix waiting: Dependabot opens a security update
-- PR for its own alert, and Renovate opens a bump for the same package. A CVE
-- task that ignores that PR has its agent write a second, competing fix. So
-- fetch-cve.sh looks for an open PR in the alert's own repo and, when it finds
-- one, the task's job becomes reviewing and merging that PR (dispatch-prompt
-- .allium: RenderCveRunbook) instead of authoring a fix.
--
-- A KNOWN DEPENDENCY BOT is an allowlist, not gh's `author.is_bot`, because
-- the link ends in an approve-and-merge: any GitHub App installed on the repo
-- is a bot, and its PR's title and body reach the agent's prompt. A person's
-- PR that mentions a package is not a fix to merge without reading it either.
-- The package-name match is a heuristic: it does not prove the PR lands on a
-- fixed version, and the runbook does not assume it does. The agent checks
-- the PR's resulting version against the advisory's fixed set before
-- approving anything.
--
-- A linked item keeps the ALERT as its url because the runbook reads the
-- advisory from it, and the feed's reconcile already removes the task once
-- the merged PR closes the alert, so nothing tracks the PR's own state.

contract FetchCve {
    fetch_cve: (repos: List<String>, bot_authors: List<String>) -> List<feeds/FeedItem>

    @invariant OneItemPerOpenAlert
        -- One item per open Dependabot vulnerability alert in each repo of
        -- REPOS, read through the `gh api` Dependabot endpoint with every page
        -- fetched, tried with each authenticated token in turn. A repo no token
        -- can read is skipped with a stderr warning. Feeds the managed CVE
        -- epic ("Managed review & CVE feeds" in docs/reference.md).

    @invariant FixPrPrecedence
        -- An alert is linked to at most one open PR. The first source that
        -- yields one wins:
        --   1. the alert's own `dependabotUpdate.pullRequest` (GraphQL), used
        --      whenever that PR is OPEN; a merged or closed one links nothing.
        --   2. an open, non-draft PR by a known dependency bot whose title or
        --      body contains the advisory's GHSA id or CVE id.
        --   3. an open, non-draft PR by a known dependency bot whose title
        --      holds the vulnerable package's name as a whole token
        --      (case-insensitive; the title split on whitespace, commas,
        --      brackets, parentheses and backticks), so "rand" never matches
        --      "random".
        -- Within sources 2 and 3 the newest PR (highest number) wins.

    @invariant KnownDependencyBots
        -- Sources 2 and 3 accept only app/dependabot plus BOT_AUTHORS, which
        -- falls back to config.fallback_dependency_bot when empty, compared
        -- case-insensitively. Source 1 needs no allowlist: GitHub itself names
        -- the PR. fetch-cve.sh reads bots.conf as a full reader
        -- (BotsConf.AMalformedEntryIsFatal, BotsConf.ABotOnBothListsIsFatal).

    @invariant ALinkedItemSaysHowStrongTheLinkIs
        -- A linked item's description ends with the paragraph
        -- "Fix PR: <url> (<title>), matched by <reason>", the title with
        -- control characters collapsed to spaces and cut at
        -- config.fix_pr_title_chars characters. <reason> is "the alert's
        -- Dependabot link" (1), "advisory id" (2) or "package name" (3). Its
        -- labels gain "fix-pr" and its wrap_up_mode is done, since merging
        -- another author's PR leaves no commits of the agent's own to open a
        -- PR for. An unlinked item has wrap_up_mode pr. The url stays the
        -- alert, url_type security_alert.

    @invariant LinksFollowEveryPoll
        -- Description and labels are re-applied on every poll, so a PR that
        -- appears later links on the next poll and one closed unmerged
        -- unlinks. wrap_up_mode is applied on insert only (feeds.allium:
        -- FeedItem.wrap_up_mode), so a card linked later keeps pr; the runbook
        -- names the right wrap-up path either way.

    @invariant FailureDegradesToUnlinked
        -- Each repo costs one paginated GraphQL query (source 1) and one
        -- `gh pr list --state open --limit config.fix_pr_list_limit` (sources
        -- 2 and 3). If either fails, the script warns on stderr and emits that
        -- repo's alerts without the links that call would have supplied. It
        -- never drops an alert for it: an unlinked alert is still correct
        -- work, while a missing one deletes its task under reconcile. A PR
        -- list that reaches its limit warns too, since a fix PR past the cut
        -- goes unlinked.

    @guidance
        -- Coverage: scripts/test-fetch-cve.sh.
}

contract FetchSecurity {
    fetch_security: (repos: List<String>) -> List<feeds/FeedItem>

    @invariant SameAlertsWithoutLinks
        -- The same open Dependabot alerts as FetchCve, for a user wiring a
        -- hand-rolled generic epic instead of cve_feed_command. It links no
        -- PR: its tasks sit on an ordinary epic, which never renders the CVE
        -- runbook (dispatch-prompt.allium: CveRemediationSkipsTheDesignStep),
        -- so a "Fix PR" line there would come with no instruction to act on.
}

-- == scripts/fetch-reviews.sh ==
--
-- One emission covers every open PR the user is involved with. The script
-- states facts about each PR as Signals; the runtime decides what they mean
-- (feeds.allium: ExcludeFromReviews, RouteSignals), splitting the one
-- emission into the My / Team / Bots sub-epics of the reviews parent. The
-- script takes no scope argument.
--
-- review-requested:@me is run in NO scope. It matches PRs requested from any
-- team the user belongs to, and membership is not the same as wanting the
-- team's review work.
--
-- TEAM REVIEWS IS THE PRs REQUESTED FROM THE LISTED TEAMS. The team pass is
-- org-wide because a team's PRs live in whatever repos the team owns, and
-- repos.conf lists the repos the user watches for CVEs, not the repos a team
-- works in. It replaces a repo-scoped review-requested:@me rather than adding
-- to it, by the user's decision: Team Reviews means "a PR for one of my
-- teams", not "a PR in one of my repos that asks any team I am in". A request
-- to an unlisted team does not appear; a request naming the user personally
-- still yields direct_request.
--
-- THE ORG-SCOPED PERSONAL REQUEST KEEPS ITS OWN SIGNAL. The org pass collapses
-- reviewed-by and commenter into org_review, but user-review-requested emits
-- direct_request. It states a fact the other two do not: a review is pending
-- from the user personally, right now. That fact is what rescues an approved
-- PR (feeds.allium: ExcludeFromReviews). Collapsed into org_review, an
-- org-wide re-request after the user's approval would be indistinguishable
-- from "I once commented on this", and the card would never come back.
-- Routing is identical either way: both signals yield my_reviews.
--
-- THE BOT-AUTHOR PASS. The review qualifiers are all about the user, so a
-- Renovate or Dependabot PR would otherwise reach the bots sub-epic only when
-- the user happened to be a requested reviewer on it. It emits author_bot
-- rather than a new Signal, because route already sends author_bot to bots;
-- engagement still wins over the bot rule. It is repo-only, never org-scoped:
-- org-wide bot authorship would sweep in every dependency-update PR in the
-- org. It is capped per repo, not per query: a single multi-repo call with one
-- limit would let one busy repo starve every other repo's bot PRs. It uses
-- `gh pr list`, not `gh search prs`, to stay off GitHub's REST search pool (30
-- requests a minute plus secondary burst limits): `gh pr list --author` runs
-- through GraphQL, a separate budget, so the per-(repo x author) split costs
-- the search pool nothing. `gh pr list --author` answers `[]` with exit 0 for
-- a repo that does not exist or that the token cannot see, so each repo is
-- probed first; an unreachable repo must stay a LOUD failure, because the
-- stderr line is what makes the cycle sync additively and keep that repo's
-- bot cards through an SSO lapse.
--
-- WHICH BOT EARNS WHICH RUNBOOK. The tag drives the runbook, so it has to
-- mean what the runbook assumes. "Written by a bot" and "is a dependency
-- update" are different sets: a release bot ("chore(master): release
-- 8.21.10") ends in "[bot]" like any other, and the dependency runbook can
-- only route its PRs back to the user as unclassified. BOT_AUTHORS already
-- means "dependency bot" (fetch-dependabot.sh lists PRs by it), so no second
-- knob says the same thing. Only the TAG narrows: the author_bot SIGNAL still
-- comes from the "[bot]" suffix, because it answers who wrote the PR, which is
-- what routes it to Bots, and a release bot is a bot. Be plain about the cost:
-- an empty BOT_AUTHORS is the SHIPPED state, so an unconfigured deployment
-- still hands its release bot's PRs the dependency runbook. The narrowing is
-- sound only once the deployment has said which of its bots are dependency
-- bots; the boundary is deliberate, not complete.
--
-- There are therefore TWO shipped producers of a dependabot-tagged task,
-- fetch-dependabot.sh and this script, and both reach the same runbook. A
-- bots.conf listing app/dependabot puts genuine "Bump <pkg> from <X> to <Y>"
-- titles on the board through either; anything reading the dependabot queue
-- expects both bots' title conventions (dispatch-prompt.allium:
-- AReviewRunbookCarriesOnlyTheBranchThatApplies).
--
-- CI STATUS AND APPROVAL ARE A SEPARATE, BATCHED FETCH. `gh search prs --json`
-- exposes no check field and no review state, so after dedup the script
-- resolves both for the whole deduped set, many PRs per request. Per-PR cost
-- would scale with the bot backlog the bot-author pass deliberately allows.
-- The batch size is a cost property, not a behavioural one. Every uncertain CI
-- outcome collapses to NO label: the alternative, a fourth badge meaning
-- "unknown", costs a card row of attention to say nothing, and the one outcome
-- that must never be guessed is a green badge on a red PR.
--
-- The resolution deliberately does not fetch the PR's pending-reviewer list:
-- "a review is requested from me" is already direct_request and team_request
-- (feeds.allium: "WHY THE RESCUE IS THE REQUEST SIGNALS AND NOT A FETCHED
-- REVIEWER LIST").

contract FetchReviews {
    fetch_reviews: (repos: List<String>, orgs: List<String>, teams: List<String>, bot_authors: List<String>, release_bot_authors: List<String>) -> List<feeds/FeedItem>
    -- The wire string a CiLabel is written as in an item's labels.
    ci_label_text: (label: CiLabel) -> String

    @invariant RepoScopedReviewQueries
        -- Per repo in REPOS, `gh search prs --state=open`:
        --   user-review-requested:@me    -> direct_request
        --   reviewed-by:@me              -> reviewed
        --   commenter:@me -author:@me    -> commented

    @invariant OrgScopedReviewQueries
        -- The same three qualifiers per org in ORGS:
        --   reviewed-by:@me | commenter:@me -author:@me -> org_review
        --   user-review-requested:@me                    -> direct_request
        -- Every org-scoped match routes to my_reviews, never Team or Bots.

    @invariant TeamPassIsTheOnlyTeamRequestProducer
        -- Per entry "<org>/<team>" in TEAMS, `team-review-requested:<org>/<team>`
        -- with `--owner <org>`, org-wide -> team_request. An absent teams.conf
        -- or an empty TEAMS skips the pass and says so on stderr with a
        -- "notice:" line (which does not taint the cycle; feeds.allium:
        -- FeedCommandStderrOnSuccess).

    @invariant BotAuthorPass
        -- Per repo in REPOS and per author in BOT_AUTHORS and
        -- RELEASE_BOT_AUTHORS together: `gh pr list --repo <repo> --author
        -- <bot> --state open --limit config.bot_prs_per_repo --search
        -- sort:created-desc` -> author_bot. Each repo is first probed with
        -- `gh api repos/<repo>`; a failed probe is reported on stderr and the
        -- repo skipped. Only when BOTH lists are empty is the pass skipped. Its
        -- `app/<slug>` authors are rewritten to `<slug>[bot]`, and the
        -- missing `repository` field is filled from the repo queried, so an
        -- item is identical whichever pass found the PR.

    @invariant AuthorSignals
        -- Per PR, from the author login: author_bot when it ends in "[bot]";
        -- author_me when it equals the gh user's login, compared
        -- case-insensitively.

    @invariant ApprovedFromReviewState
        -- approved is attached from the PR's own review state, resolved after
        -- dedup in the same batched request as the CI status. What it means is
        -- feeds.allium's (the Signal enum, ExcludeFromReviews); the review
        -- query is scoped to the gh user's login, compared case-insensitively.

    @invariant OnePrOneItemAllSignals
        -- A PR matched by several queries appears EXACTLY ONCE, carrying the
        -- union of every signal it matched (`group_by(.url)` and a union, not
        -- jq's unique_by, which would keep one query's signals).

    @invariant AQueryFailureFailsTheEmission
        -- A `gh search prs` that fails (rate limit, outage, an unknown team
        -- name) fails the whole emission with a non-zero exit rather than
        -- contributing an empty list, so the degraded-emission guards stop the
        -- reconcile instead of deleting cards the cycle merely could not see.

    @invariant SoftFailuresDegradeTowardVisible
        -- A failed CI or review-state resolution leaves the affected PRs with
        -- no ci label and no approved signal, never a wrong one and never a
        -- failed emission. A failed login lookup skips the review-state
        -- resolution entirely (no approved signal on any item that cycle) and
        -- loses author_me. Each writes a stderr line, which
        -- FeedCommandStderrOnSuccess surfaces without failing the cycle. A
        -- missing signal shows a PR; no soft failure hides review work.

    @invariant TagFromAuthorConfig
        -- Checked in order: an author on RELEASE_BOT_AUTHORS -> tag
        -- release_please; else, where BOT_AUTHORS is non-empty, an author on
        -- it -> tag dependabot; else, where BOT_AUTHORS is empty, a login
        -- ending in "[bot]" -> tag dependabot; else tag pr_review. An
        -- unlisted bot's PR is kept and tagged pr_review. release_please is
        -- earned only by being named, never by the suffix fallback. The tag
        -- adds no Signal and changes no routing.

    @invariant CiLabelOnEveryPr
        -- Every emitted PR, in every sub-epic, carries
        -- ci_label_text(label) in its labels when its head commit's check
        -- rollup has one of the CiLabel states, and no ci label at all when
        -- it has no checks, an upstream status outside CiLabel, or the
        -- status fetch failed. ci_label_text is "ci:pass", "ci:fail" or
        -- "ci:pending"; a card colours exactly these (board-visuals.allium:
        -- "Card label badges").

    @invariant DraftsAreLabelled
        -- Draft PRs are included and carry a "draft" entry in labels, which
        -- the card renders as a badge like any other label.

    @guidance
        -- Implementation: scripts/fetch-reviews.sh, to_feed_items for the
        -- item mapping. Coverage: scripts/test-fetch-reviews.sh and
        -- scripts/test-bots-conf.sh.
}

-- == scripts/fetch-log-warnings.sh: events, not state ==
--
-- The other templates mirror an upstream that has an open and closed state. A
-- log record is an event, so this script's epic is append-only and the script
-- never has to represent "still a problem".
--
-- The whole design question is what makes two log lines THE SAME PROBLEM,
-- because that is what external_id captures. A raw line is useless: every
-- line differs by timestamp, and a real log holds six-figure counts of a
-- handful of distinct problems. The module target plus the static head of the
-- message is a proxy for the call site that survives refactoring, unlike a
-- file:line.
--
-- Every item is rebase because a triage card has three resolutions (a real
-- bug fixed, a wrong log line demoted, a transient record deleted) and the
-- first two are a small change to the repo the log came from, with no
-- upstream to open a PR against and no third party to review a level change.
--
-- WHY THIS IS A TEMPLATE AND NOT A RUNTIME FEATURE. Both halves are policy:
-- which log file, and what counts as one problem. The runtime learned only
-- that a feed may be append-only, which is upstream-agnostic.

contract FetchLogWarnings {
    fetch_log_warnings: (log_file: String) -> List<feeds/FeedItem>

    @invariant AppendOnlyEpic
        -- The only shipped template for an append-only epic
        -- (core/Epic.feed_append_only; feeds.allium: AppendOnlyFeed).

    @invariant OneItemPerDistinctRecord
        -- One item per distinct WARN or ERROR record in the tracing-formatted
        -- LOG_FILE. A record's fingerprint, and so its external_id, is its
        -- module target plus the static head of its message (up to the first
        -- ":" or " key="). Everything after the head is per-occurrence detail.

    @invariant UrlIsTheRepoRoot
        -- url is the repo root "https://github.com/<org>/<repo>", a form
        -- extract_github_repo accepts, so the task resolves a repo_path and is
        -- dispatchable. A log record has no upstream url of its own.

    @invariant DescriptionStaysCurrent
        -- The description carries the occurrence count, first and last seen
        -- timestamps and a sample of raw lines, re-applied on every poll, so
        -- an open card keeps a current count.

    @invariant RebaseOnInsert
        -- Every item sets wrap_up_mode rebase, applied on insert only
        -- (feeds.allium: FeedItem.wrap_up_mode), so a card whose path the user
        -- changed keeps that change across polls.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The CI status of a PR's head commit, as fetch-reviews.sh labels it: pass
-- (the check rollup succeeded), fail (failed or errored), pending (running,
-- or expected but not started). The vocabulary is shared with the card
-- renderer; a fourth value would render as a plain badge, not fail.
enum CiLabel { ci_pass | ci_fail | ci_pending }

------------------------------------------------------------
-- Configuration
------------------------------------------------------------

config {
    -- The one entry form bots.conf's lists accept: gh's app form.
    bot_author_form: String = "^app/[A-Za-z0-9._-]+$"
    -- The dependency bot fetch-dependabot.sh and fetch-cve.sh use when
    -- BOT_AUTHORS is empty.
    fallback_dependency_bot: String = "app/kognic-renovate"
    -- fetch-reviews.sh's bot-author pass: the newest open PRs kept per
    -- (repo x bot author).
    bot_prs_per_repo: Integer = 20
    -- fetch-cve.sh: the open PRs listed per repo when looking for a fix PR.
    fix_pr_list_limit: Integer = 200
    -- fetch-cve.sh: a linked PR's title is cut to this many characters.
    fix_pr_title_chars: Integer = 200
}
