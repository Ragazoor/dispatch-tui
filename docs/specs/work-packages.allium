-- allium: 3
-- work-packages.allium
--
-- Scope: Work packages — a second way to group work, beside epics. An epic
--        namespaces work: every task and sub-epic lives in exactly one place
--        in the epic tree. A work package cuts across that tree: it holds
--        links to tasks and epics that already exist wherever they live, so
--        the user can see "what I am working on in this maintenance window"
--        as one board while the epic tree keeps saying what the work is.
-- Includes: WorkPackage and WorkPackageLink, the package card on the main
--           board and where it is placed, the package view, the link picker,
--           package create/rename/delete from the board, the MCP tools,
--           and what a deleted task or epic does to its links.
-- Excludes: Epic card placement itself (board-layout.allium, "Epic Card
--           Placement" — this spec reuses it); the epic view and its trail
--           (epics.allium, "Epic Navigation"); the board filters
--           (board-layout.allium); the store's subscription mechanics
--           (sync.allium); who may see and write a package (workspaces.allium).
-- Dependencies: Task, Epic, TaskStatus, UserIdentity from core.allium.
--
-- Decisions taken with the user:
--   - A package is a VIEW on the board, not a to-do list. It has no status of
--     its own and nothing to tick off: an item is done when the item itself
--     is done, and the board's columns already say so.
--   - A package only links; it never owns. A task created while a package
--     view is showing (n, c copy, D quick dispatch) is a plain main-board
--     task with no epic, linked to that package (CreateTaskInPackageView).
--     Only the package view itself links: a task created in an epic view
--     entered from a package goes into that epic and is not linked, since
--     the epic's card already carries it.
--   - Membership is many-to-many: one task or epic can be linked to any
--     number of packages.
--   - The cards in a package view are the linked items themselves: a linked
--     task is a task card, a linked epic is an epic card that Space enters.
--     Linked epics are not opened up into their subtasks, except by the flat
--     lens: every board lens applies in a package view as it does on the
--     main board (PackageViewCards).
--   - Package cards sit on the main board only. A package cannot hold a
--     package, and no package card appears inside an epic view or another
--     package view.
--   - The card stays in Backlog until the work is finished, then it is in
--     Done (PackageCardPlacement); the user deletes the package when they no
--     longer want it. There is no archive.

use "./core.allium" as core
use "./workspaces.allium" as workspaces
use "./board-layout.allium" as board_layout

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity WorkPackage {
    title: String               -- non-empty after trimming
    description: String         -- free text, may be empty; holds the plan for the window
    sort_order: Integer?        -- manual ordering of the package's card, and nothing else; lower sorts first via sort_order ?? id (null falls back to the package id). Written by ReorderPackage and by the update_work_package tool
    created_by: core/UserIdentity    -- stamped once, never rewritten; required (a create with no settled identity is refused). The board receives every package visible_to it (workspaces.allium: SetWorkPackageVisibility)
    workspace: core/Workspace         -- the workspace this package lives in; chosen at creation and never moved (CreateWorkPackage)
    visibility: core/Visibility = public  -- chosen at creation, changeable afterwards (workspaces.allium: SetWorkPackageVisibility)
    created_at: Timestamp
    updated_at: Timestamp

    -- Whether `user` can see this package (workspaces.allium:
    -- WorkPackageVisibility). Seeing a package never reveals a linked item
    -- the viewer cannot see on its own: the package view shows only linked
    -- items that are themselves visible_to the viewer.
    visible_to(user): workspace.has_member(user)
                      and (visibility = public or created_by = user)

    links: WorkPackageLink with work_package = this
    linked_tasks: links where kind = task -> task
    linked_epics: links where kind = epic -> epic

    -- The tasks that place the package's card: the linked tasks and every
    -- task in the subtree of every linked epic, each once. A black box over
    -- core/Epic.subtree_tasks: linked_tasks plus each linked epic's
    -- subtree_tasks, deduplicated.
    placement_tasks: tasks_reached_by(this)

    -- The one column the package's card is in (PackageCardPlacement): Done
    -- when there is at least one placement task and every one is done,
    -- Backlog in every other case. Never Running or Review.
    placement_column: if placement_tasks.count > 0
                         and placement_tasks.all(t => t.status = done): done
                      else: backlog
}

enum WorkPackageItemKind { task | epic }

-- One link from a package to one task or one epic. Exactly one of task/epic
-- is set, matching kind.
entity WorkPackageLink {
    work_package: WorkPackage
    kind: WorkPackageItemKind
    task: core/Task?            -- set when kind = task
    epic: core/Epic?            -- set when kind = epic
    created_at: Timestamp

    -- The linked task or epic, whichever is set.
    item: task ?? epic

    -- At most one link per (package, item). Enforced by a derived key
    -- "<package id>/<kind>/<item id>", the same device core.allium's
    -- Subscription uses, because the store indexes single columns only.
    invariant OneLinkPerPackageAndItem {
        for a in WorkPackageLinks:
            for b in WorkPackageLinks:
                a != b and a.work_package = b.work_package and a.kind = b.kind
                    implies (a.task != b.task or a.epic != b.epic)
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Lifecycle ==

-- Creates the package and links the given items, in one store transaction:
-- every item is checked before the first write, so a link to an unknown,
-- unseen or out-of-workspace item refuses the whole create and no package is
-- left behind (workspaces.allium: LinkOnlyInsideTheWorkspace).
rule CreateWorkPackage {
    when: CreateWorkPackage(title, description, creator, workspace, visibility, items)

    requires: title.trim() != ""
    -- A package is created only in a workspace its creator belongs to.
    requires: workspace.has_member(creator)

    ensures:
        let package = WorkPackage.created(
            title: title.trim(),
            description: description,
            created_by: creator,
            workspace: workspace,
            visibility: visibility,
            created_at: now,
            updated_at: now
        )
        for item in items: LinkItem(package, item)

    @guidance
        -- Reachable from the link picker (CreatePackageFromPicker) and from
        -- the create_work_package MCP tool (CreateWorkPackageViaMcp). A blank
        -- title is refused with a validation error and nothing is created.
        -- A repeated item is one link.
}

rule UpdateWorkPackage {
    when: UpdateWorkPackage(package, title?, description?, sort_order?)

    requires: title = null or title.trim() != ""

    ensures:
        if title != null: package.title = title.trim()
        if description != null: package.description = description
        if sort_order != null: package.sort_order = sort_order
        package.updated_at = now

    @guidance
        -- Renaming from the board is `e` on a package card
        -- (RenamePackageFromBoard). The description is edited through the
        -- update_work_package MCP tool only. sort_order is written by
        -- ReorderPackage (J/K) and by that tool; there is no way to clear it.
}

rule UpdateWorkPackageIsOneTransaction {
    when: WorkPackageUpdateRequested(package, patch, visibility?, unlink, link)

    -- update_work_package_with_links takes the visibility change too: the
    -- patch, the visibility, every unlink and every link are one transaction.
    -- The visibility's refusals (an unknown value, a caller who is neither the
    -- creator nor an admin) are raised before the first write, so a refused
    -- visibility leaves the title, the links and the package as they were.
    requires: exists package

    ensures:
        if patch.title != null or patch.description != null or patch.sort_order != null:
            UpdateWorkPackage(package, patch.title, patch.description, patch.sort_order)
    ensures:
        if visibility != null:
            workspaces/SetWorkPackageVisibility(package, visibility)
            package.updated_at = now
    ensures:
        for item in unlink: UnlinkItem(package, item)
    ensures:
        for item in link: LinkItem(package, item)

    @guidance
        -- Unlinks run before links. Every link is checked
        -- (workspaces.allium: LinkOnlyInsideTheWorkspace) against the package
        -- as it was before the call, so an admin who makes a package private
        -- in the same call still links. A link-only or unlink-only call leaves
        -- updated_at alone: only the patch and the visibility touch it.
}

-- J/K on a package card moves it among the package cards of its column.
-- Packages sort as one block above every epic and task card, and they have
-- their own key, so the swap runs over the package block only: the epic and
-- task cards below it keep a key space of their own (tasks.allium:
-- ReorderItem) and a package never trades keys with one of them.
rule ReorderPackage {
    when: ReorderPackage(package, direction)
    -- direction: +1 (down) or -1 (up)

    let cards = package_cards(package.placement_column)
    let target_index = index_of(cards, package) + direction

    requires: target_index >= 0
    requires: target_index < cards.count

    let target = element_at(cards, target_index)
    let package_eff = package.sort_order ?? package.id
    let target_eff = target.sort_order ?? target.id

    ensures:
        if package_eff = target_eff:
            -- Equal effective keys: offset the moved package by direction.
            package.sort_order = package_eff + direction
            target.sort_order = target_eff
        else:
            package.sort_order = target_eff
            target.sort_order = package_eff
        package.updated_at = now
        target.updated_at = now

    @guidance
        -- A package has no completed_at, so Done has no completion key to
        -- swap: a package card orders by sort_order ?? id ascending in
        -- every column, Backlog and Done alike.
        -- No-op at the edge of the package block: J on the last package
        -- card and K on the first do nothing, and the cursor does not move
        -- onto an epic or task card. Both written keys are persisted.
        -- The card order (PackageCardPlacement), this rule and the
        -- update_work_package tool all read the same key.
}

rule LinkItem {
    when: LinkItem(package, item)

    let existing = WorkPackageLink{work_package: package, item: item}

    ensures:
        if not exists existing:
            WorkPackageLink.created(
                work_package: package,
                kind: item_kind(item),
                task: item_task(item),
                epic: item_epic(item),
                created_at: now
            )

    @guidance
        -- Idempotent: linking an item that is already linked is a silent
        -- success, not an error. The item must exist; a link to an unknown
        -- task or epic id is refused with not-found.
        -- Linking an epic and also a task inside that epic is allowed and
        -- both are kept: the user linked the task on purpose (see
        -- PackageViewCards).
        -- Black boxes: item_kind(item) is task for a task and epic for an
        -- epic; item_task(item) is the item when it is a task, else null;
        -- item_epic(item) is the item when it is an epic, else null.
}

-- A task created while a package view is showing is linked to that package.
-- The task itself is created exactly as on the main board: no epic, the same
-- form or quick dispatch. Only the link is added.
rule CreateTaskInPackageView {
    when: TaskCreatedInPackageView(task, package)

    ensures: LinkItem(package, task)

    @guidance
        -- Covers every board path that creates a task: n (the new-task
        -- form), c (copy) and D (quick dispatch, whose repo picker is part
        -- of the same keypress). The package is the one showing when the
        -- task is submitted (the form's last step, or the repo picked), so a
        -- package deleted while the form is open is not linked: the view has
        -- already fallen back to the main board.
        -- An epic view, even one entered from a package, creates into that
        -- epic and links nothing (tasks.allium: CreateTask).
        -- Two writes: the create, then the link. A refused link leaves the
        -- plain main-board task and shows the error; the user links it with
        -- `w`. The board re-reads its packages after the link.
        -- MCP has no twin parameter on create_task: an agent has no view,
        -- and create_task followed by update_work_package(link_task_ids)
        -- already does the same.
}

rule UnlinkItem {
    when: UnlinkItem(package, item)

    let existing = WorkPackageLink{work_package: package, item: item}

    ensures:
        if exists existing and item.visible_to(caller()): not exists existing

    @guidance
        -- Idempotent: unlinking an item that is not linked is a silent
        -- success. The task or epic itself is never touched.
        -- An item the caller cannot see is treated as not linked, so the
        -- unlink does nothing (workspaces.allium: WritesRequireSight,
        -- UnseenIsAsMissing): a caller can neither remove a link they are
        -- not shown nor learn from the answer that one exists. This holds
        -- for unlink_work_package_item and for the unlink lists of
        -- update_work_package_with_links alike.
}

rule DeleteWorkPackage {
    when: DeleteWorkPackage(package)

    ensures:
        for link in package.links: not exists link
        not exists package

    @guidance
        -- Removes the package and its links only. No linked task or epic is
        -- changed, moved or deleted, so there is no Done guard like the one
        -- epics.allium: DeleteEpic has.
}

-- == Package view ==

rule EnterPackage {
    when: UserEntersPackage(package)

    ensures:
        ViewShowing(PackageView(package, parent: MainBoard))

    @guidance
        -- Space on a package card. The view keeps its own cursor, as an epic
        -- view does, and the main board's cursor is restored on exit.
        -- The view is framed like an epic view, its border titled with a
        -- square glyph and the package title.
        -- The frame and its faint panel tint are CYAN/teal, the package
        -- card's colour, not an epic view's PURPLE. An epic view entered
        -- from a package is still an epic view and keeps PURPLE.
        -- A refresh in which the open package no longer exists (deleted on
        -- another machine, or by an agent) returns to the main board, from
        -- the package view and from any epic view entered from it.
}

rule ExitPackage {
    when: UserExitsPackageView(view)

    ensures:
        ViewShowing(view.parent)

    @guidance
        -- q, and Esc when no search is active, exactly like leaving an epic
        -- view. Q from anywhere below a package returns to the main board.
}

rule EnterEpicFromPackage {
    when: UserEntersEpicFromPackage(epic, package)

    ensures:
        ViewShowing(EpicView(epic, parent: PackageView(package)))

    @guidance
        -- Space on a linked epic card enters it as usual, and Enter jumps to
        -- the deepest epic (epics.allium: JumpToDeepestEpic) with the trail
        -- starting at the package view. q from that epic view returns to the
        -- package view, not the main board. Q returns to the main board.
        -- The trail starts at the linked epic that was pressed, not at the
        -- root of the epic tree: a linked sub-epic's ancestors are not on
        -- the trail, because the user never stepped through them.
        -- The epic view's border names the package first, then the trail.
}

-- == Linking and managing packages from the board ==

rule CreatePackageFromPicker {
    when: UserCreatesPackageInPicker(title, item, workspace, visibility)

    requires: title.trim() != ""

    ensures:
        CreateWorkPackage(title, "", caller(), workspace, visibility, {item})

    @guidance
        -- An empty title creates nothing and returns to the picker. The
        -- workspace and visibility are the form's (workspaces.allium:
        -- NameWorkspaceAndVisibilityFromBoard).
}

rule RenamePackageFromBoard {
    when: UserRenamesPackage(package, title)

    requires: title.trim() != ""

    ensures: UpdateWorkPackage(package, title: title)

    @guidance
        -- `e` on a package card opens a one-line input prefilled with the
        -- current title. Enter saves; Esc, or an empty title, cancels.
}

rule DeletePackageFromBoard {
    when: UserConfirmsDeletePackage(package)

    ensures: DeleteWorkPackage(package)

    @guidance
        -- `x` on a package card asks
        -- `Delete work package "<title>"? Its tasks and epics are kept [y/n]`.
        -- y (or Y) deletes; any other key cancels.
}

-- == MCP tools ==

-- Agents are first-class users of packages: everything the board can do has
-- a tool. Three tools, in the merged style of update_tasks: create_work_package,
-- list_work_packages and update_work_package (WorkPackageMcpTools).
--
-- Replies name what they touch (mcp-task-tools.allium:
-- RepliesNameWhatTheyTouch). Every reply that names a package says
-- `Work package <id> ("<title>")`: `<package> created in workspace ...`,
-- `<package> updated (fields)`, `<package> deleted; ...`. An unlink that
-- touched nothing is listed as `not linked: <task ref>` or
-- `not linked: <epic ref>`; an item the store does not hold stays `task 4` or
-- `epic 7`.
--
-- A missing package id is not-found on list and delete, and a refusal
-- ("no work package N", invalid params) on a create or update, which the
-- store decides; so is the id of a package the caller cannot see. A link to
-- a task or epic id that does not exist is refused the same way, and nothing
-- in that call is written: the store validates every id before the first
-- write. A repeated id in one list is one write.
--
-- items(task_ids, epic_ids) is a black box: the tasks and epics those ids
-- name.

rule CreateWorkPackageViaMcp {
    when: McpCreateWorkPackage(title, description?, link_task_ids?, link_epic_ids?,
                               workspace_id, visibility?)

    ensures:
        CreateWorkPackage(title, description ?? "", caller(),
                          core/Workspace{id: workspace_id}, visibility ?? public,
                          items(link_task_ids, link_epic_ids))

    @guidance
        -- Returns the new package id. workspace_id is required: there is no
        -- default workspace (workspaces.allium, "Naming a workspace and a
        -- visibility from the board").
}

rule ListWorkPackagesViaMcp {
    when: McpListWorkPackages(work_package_id?)

    requires:
        if work_package_id != null: exists WorkPackage{id: work_package_id}

    ensures: WorkPackagesListed(work_package_id: work_package_id)

    @guidance
        -- Every package the board holds (the ones visible to the caller), or
        -- the one named: id, title, description (omitted when empty),
        -- sort_order (omitted when unset), created_at, updated_at, its
        -- creator (CreatorIsShownByName), workspace and visibility, and its
        -- linked items, each with kind, id, title and status. A link whose
        -- item this board does not hold is left out. A task item reads
        -- `- task <id> [<status>] <name>: <title>`, the display name left
        -- out when the task has none; an epic item has no name.
        -- Read-only. One package is read with work_package_id: there is no
        -- separate get tool (docs/mcp-tool-design.md, rule 1).
}

rule UpdateWorkPackageViaMcp {
    when: McpUpdateWorkPackage(package, title?, description?, sort_order?,
                               link_task_ids?, unlink_task_ids?,
                               link_epic_ids?, unlink_epic_ids?, delete?,
                               visibility?)

    -- delete: false is the same as leaving it out; delete: true is
    -- DeleteWorkPackageViaMcp.
    requires: delete != true
    -- A call that names no field is refused before anything is written.
    requires: title != null or description != null or sort_order != null
              or link_task_ids != null or unlink_task_ids != null
              or link_epic_ids != null or unlink_epic_ids != null
              or visibility != null
    -- So is an id that appears in both a link and an unlink list.
    requires: not (exists t in link_task_ids where t in unlink_task_ids)
    requires: not (exists e in link_epic_ids where e in unlink_epic_ids)

    ensures:
        WorkPackageUpdateRequested(
            package,
            patch: { title: title, description: description, sort_order: sort_order },
            visibility: visibility,
            unlink: items(unlink_task_ids, unlink_epic_ids),
            link: items(link_task_ids, link_epic_ids)
        )

    @guidance
        -- One store transaction (UpdateWorkPackageIsOneTransaction): the
        -- patch, then every unlink, then every link. UnlinkItem stays
        -- idempotent, but the reply names each requested unlink that was not
        -- linked, so the caller can tell that nothing changed for it. The
        -- store leaves a link to an item the caller cannot see in place, as
        -- if it were not linked (UnlinkItem).
        -- An empty list is the same as leaving the list out: a call whose
        -- only field is `link_task_ids: []` names no field, and
        -- `delete: true` with an empty list is still a delete.
        -- The tool is declared destructive, because one of its forms deletes
        -- (DeleteWorkPackageViaMcp): annotations describe a whole tool.
}

rule DeleteWorkPackageViaMcp {
    when: McpUpdateWorkPackage(package, title?, description?, sort_order?,
                               link_task_ids?, unlink_task_ids?,
                               link_epic_ids?, unlink_epic_ids?, delete?,
                               visibility?)

    requires: delete = true
    -- A delete is a call of its own: the same call must not also rename or
    -- relink, since those writes would be thrown away with the package. A
    -- call that sets delete with any other field is invalid params (-32602)
    -- and nothing is written. The same rule as update_tasks with
    -- status="done" (mcp-task-tools.allium).
    requires: title = null and description = null and sort_order = null
              and link_task_ids = null and unlink_task_ids = null
              and link_epic_ids = null and unlink_epic_ids = null
              and visibility = null

    ensures: DeleteWorkPackage(package)

    @guidance
        -- The reply names the deleted package and says its tasks and epics
        -- are kept.
        -- There is no delete_work_package tool. A delete is the last update
        -- of a package, so it is a field of update_work_package
        -- (docs/mcp-tool-design.md, rule 1: extend the update tool; do not
        -- add a delete twin).
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- A deleted task or epic takes its links with it, in every package; the
-- package itself stays, possibly empty. The store's task and epic deletes
-- (board or MCP, single or batch) remove the links in the same transaction,
-- and an epic deleted with its subtree removes the links of every task and
-- sub-epic deleted with it, as well as its own.
invariant LinksNeverDangle {
    for link in WorkPackageLinks:
        exists link.item
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- What the operator does to packages at the board. Each key's binding is in
-- keybindings.allium; the rule each action reaches says what it does.
surface WorkPackageBoard {
    facing _: core/Operator

    provides:
        -- Space on a package card (EnterPackage); q, or Esc with no search,
        -- in a package view (ExitPackage).
        UserEntersPackage(package)
        UserExitsPackageView(view)
        -- Space on a linked epic card in a package view
        -- (EnterEpicFromPackage); Enter there is epics.allium's
        -- JumpToDeepestEpic, with the trail starting at the package view.
        UserEntersEpicFromPackage(epic, package)
        -- J/K on a package card (ReorderPackage).
        ReorderPackage(package, direction)
        -- [e] on a package card, saved (RenamePackageFromBoard).
        UserRenamesPackage(package, title)
        -- [x] on a package card, answered y (DeletePackageFromBoard).
        UserConfirmsDeletePackage(package)
        -- A task created by n, c or D while a package view is showing
        -- (CreateTaskInPackageView).
        TaskCreatedInPackageView(task, package)
}

-- A package's card on the main board, and the column it is in.
surface PackageCardPlacement {
    facing _: core/Operator
    context package: WorkPackage

    exposes:
        package.title
        package.placement_column

    @guarantee OneColumnOnly
        -- A package's card is in ONE column, never several. It stays in
        -- Backlog while its work is under way, and is in Done only when the
        -- work is finished. It is never in Running or Review: a package is a
        -- view, not work an agent runs. A package whose links reach no task
        -- at all sits in Backlog. That is the whole of "finished": there is
        -- no package status.

    @guarantee NoFilterMovesTheCard
        -- No board filter has a say in the column: not the repo filter, the
        -- only-active filter, the search query or the epic hide-list
        -- (board-layout.allium, "Hidden Epics and Work Packages"). The column
        -- reads every placement task, so changing a filter never moves a
        -- package card between columns.

    @guarantee PackageCardsOnlyOnMainBoard
        -- No package card is drawn inside an epic view or inside a package
        -- view.

    @guidance
        -- Unlike an epic card, a package card is never hidden by the repo or
        -- only-active filter, or by hiding the epics it links: a package is
        -- the user's own grouping, not work in a repo. Two things take a
        -- package's card off the board: the user hiding the package itself
        -- in the board-filter overlay's Work packages tab
        -- (board-layout.allium: BoardHides.package_is_hidden), and a search
        -- query. Hiding a package hides its card only; its linked tasks and
        -- epics stay.
        -- Within a column, package cards sort above every epic and task card,
        -- by sort_order ?? id ascending (so in package id order, oldest
        -- first, until one is reordered with J/K: ReorderPackage). They do
        -- not sit in a column section.
        -- A search query also narrows packages by their own title: a package
        -- whose title matches the query keeps its card even when no linked
        -- work matches, mirroring board_search_filter's own-match clause for
        -- epics. A package whose title does not match keeps its card only
        -- through visible linked work. The query only decides whether the
        -- card is drawn; the column still comes from every placement task.
        -- The title match is a case-insensitive substring match on the title
        -- alone; a package id is not searched, because package ids are a
        -- sequence of their own and "#7" would match a package and a task at
        -- once.
        -- The card shows a square glyph and the title in CYAN (an epic card's
        -- identity is PURPLE — board-visuals.allium: WorkPackageCard), and a
        -- second line "N items · M done" ("1 item · M done" for one)
        -- counting the linked items the board holds and how many of them are
        -- done; "no items" when it holds none.
        -- When the package has a creator, the line ends " · by <creator>",
        -- the creator shown by display name or identity prefix
        -- (workspaces.allium: CreatorIsShownByName).
        -- A package card is a view onto work counted elsewhere, so the
        -- column header's card count does not include it, select-all and
        -- multi-select skip it, and H/L do nothing on it. J/K moves it among
        -- the package cards only (ReorderPackage).
        -- The status bar on a package card offers Space open, e rename,
        -- x delete, n new, E epic, / search and ? help.
        -- Computed on every render rather than cached: the placement reads
        -- links, the epic tree and the filters, and a board holds few
        -- packages.
}

-- What the package view's columns hold.
surface PackageViewCards {
    facing _: core/Operator
    context package: WorkPackage

    -- The board's view: its filters, its search query and its lens, which
    -- apply here as on the main board (board-layout.allium: BoardView).
    let view = board_layout/board_view

    exposes:
        -- A linked task is a task card in its status column.
        for task in package.linked_tasks where view.task_is_visible(task):
            task.status
        for epic in package.linked_epics where view.epic_is_visible(epic):
            -- Placed exactly as on the main board: one card per column its
            -- subtree has visible work in, Backlog when it has none, and
            -- only in columns the lens does not flatten.
            for column in { backlog, running, review, done }
                where view.appears_in(epic, column) and view.renders_epics(column):
                column
            -- In a flattened column the epic's contents stand in for it:
            -- every visible task in its subtree, once each.
            for task in epic.subtree_tasks
                where view.task_is_visible(task) and view.flattens(task.status):
                task.status

    @guidance
        -- The cards are the linked items, not their contents. A linked
        -- task is a task card wherever it lives in the epic tree; a linked
        -- epic is an epic card whether it is a root epic or a sub-epic.
        -- A task that is linked AND sits inside a linked epic shows as its
        -- own card and also counts toward the epic card's placement.
        -- Visible is the same predicate the main board applies.
        -- Flattened columns (board-layout.allium: BoardView.flattens) apply in a
        -- package view exactly as on the main board, per column. A flattened
        -- column draws no epic card: it holds the linked tasks plus every
        -- task in the subtree of a linked epic, each once, grouped under
        -- the header of the task's own epic as on the main board. Backlog is
        -- never flattened, so the linked epic cards stay there. The
        -- only-active half of the lens applies through `visible`.
        -- Enter on a flattened card jumps to its epic (epics.allium:
        -- JumpToTaskEpic) with the trail starting at the outermost linked
        -- epic on the task's epic path, or at the task's own epic when no
        -- linked epic is on it: the user never stepped through the
        -- ancestors above.
        -- A link whose task or epic this board does not hold (not in the
        -- shared rows it subscribes to) draws nothing.
}

-- `w` on a task card or an epic card, in any view, opens the link picker for
-- that item. The picker lists every package the board holds (the ones
-- visible to it, workspaces.allium), oldest first, each marked linked or not
-- linked for this item, plus a final "new package" row.
surface WorkPackageLinkPicker {
    facing _: core/Operator
    context item: core/Task or core/Epic

    exposes:
        for package in WorkPackages:
            package.title
            package.links.any(l => l.item = item)   -- shown as a check mark

    provides:
        -- Space or Enter on a package row: link when unlinked, unlink when
        -- linked.
        LinkItem(package, item) when not package.links.any(l => l.item = item)
        UnlinkItem(package, item) when package.links.any(l => l.item = item)
        -- Enter on the "new package" row, then type a title (and the form's
        -- workspace and visibility).
        UserCreatesPackageInPicker(title, item, workspace, visibility)

    @guidance
        -- Toggling a row links or unlinks at once and keeps the picker open,
        -- so several packages can be toggled in one visit. Esc or q closes
        -- it.
        -- Creating a package from here also links the item to it, then
        -- returns to the picker with the cursor on the row the new package
        -- fills (packages are oldest first, so it lands last); the row shows
        -- checked once the write's refresh arrives.
        -- A toggle flips the check mark at once, before the store answers;
        -- the board re-reads its packages after every write, so a refused
        -- write puts the mark back and shows the error.
        -- j/k (and Down/Up) move the cursor, stopping at the first and last
        -- rows. Esc in the new-package title returns to the picker. A linked
        -- row shows "[x]", an unlinked one "[ ]". `w` does nothing on any row
        -- that is not a task or epic card (headers, folded rows, package
        -- cards).
}

-- The module's work-package update reducer (update_work_package), which any
-- store client may call.
surface WorkPackageWriteReducers {
    facing _: core/StoreClient

    provides:
        WorkPackageUpdateRequested(package, patch, visibility?, unlink, link)
}

-- The work-package tools of the dispatch MCP server.
surface WorkPackageMcpTools {
    facing _: core/McpClient

    provides:
        -- create_work_package (CreateWorkPackageViaMcp). Write.
        McpCreateWorkPackage(title, description?, link_task_ids?, link_epic_ids?,
                             workspace_id, visibility?)
        -- list_work_packages (ListWorkPackagesViaMcp). Read-only.
        McpListWorkPackages(work_package_id?)
        -- update_work_package (UpdateWorkPackageViaMcp,
        -- DeleteWorkPackageViaMcp). Destructive.
        McpUpdateWorkPackage(package, title?, description?, sort_order?,
                             link_task_ids?, unlink_task_ids?,
                             link_epic_ids?, unlink_epic_ids?, delete?,
                             visibility?)

    @guidance
        -- The package argument is `work_package_id`, not a bare `id`: every
        -- other tool names its selector after the entity (task_id, epic_id),
        -- and docs/mcp-tool-design.md asks for unambiguous argument names.
}
