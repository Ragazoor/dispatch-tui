-- allium: 3
-- admin-surfaces.allium
--
-- Scope: How a person administers workspaces, members and super-admins, from
--        the board and over MCP: the admin screen, the directory the screen
--        and the tools find people in, the listing of private items nobody
--        can see, and the MCP tools that are the agent's twin of every key.
-- Includes: AdminScreen and its panes, the rules each key runs, how a person
--           is named by display name (PersonResolution), UnseenItemListing,
--           and the MCP tools list_workspaces, create_workspace,
--           update_workspace, set_workspace_member, set_super_admin,
--           claim_super_admin, list_unseen_items, delete_unseen_item.
-- Excludes: What each store write does and who may do it (workspaces.allium:
--           CreateWorkspace, RenameWorkspace, DeleteWorkspace, AddMember,
--           SetMemberRole, RemoveMember, ClaimSuperAdmin, GrantSuperAdmin,
--           RevokeSuperAdmin, SuperAdminDeletesUnseenItem). This spec only says
--           how a key or a tool reaches them. The store's refusal is the
--           answer; neither surface re-checks a role.
--           The key rows themselves (keybindings.allium owns the table).
-- Dependencies: UserProfile, Person, SuperAdmin and the surfaces
--               WorkspaceAdministration and SuperAdministration from
--               workspaces.allium; Workspace, Membership, Epic and WorkPackage
--               from core.allium.
--
-- Decisions, cited by id:
--   A1. Agents are first-class users. Every key of the admin screen has an MCP
--       twin, and the tools follow docs/mcp-tool-design.md: capability, not
--       endpoint. A grant and a revoke are one tool (set_super_admin); a role
--       change and a removal are one tool (set_workspace_member); a rename and
--       a delete are one tool (update_workspace), as update_work_package does.
--       Claiming is its own tool: it takes no person and has its own
--       precondition.
--   A2. People are found by display name. Names need not be unique
--       (workspaces.allium: SetDisplayName), so a name that matches more than
--       one person is refused, listing every match with the identity prefix,
--       and never resolved to one of them silently. An identity (the full
--       string or a unique prefix of at least
--       workspaces.allium config.identity_prefix_length) is also accepted,
--       which is how a duplicated name is told apart.
--   A3. The admin screen opens for every person, not only admins. The first
--       claim of super-admin has to be reachable by someone who is not one yet,
--       and a person who administers nothing is told so rather than shown a
--       key that does nothing.
--   A4. UnseenItemListing is a server projection (a per-caller view), not a
--       filter in the board: a client never receives a private item's title,
--       even to hide it (workspaces.allium: AClientReceivesOnlyWhatItCanSee).
--       A person who is not a super-admin gets an empty listing from it.
--   A5. The listing shows every private epic whose own creator has left its
--       workspace, a private sub-epic included, whether or not an epic above
--       it is listed too: under the nearest-holder reading (workspaces.allium
--       D5) a private sub-epic is its own creator's, so the delete accepts it
--       on its own. A public epic under a listed epic is not listed: it goes
--       with that epic's subtree.
--   A6. A deletion from the listing keeps DeleteEpic's every-task-done guard:
--       the hatch widens who may delete, not what may be torn down.

use "./core.allium" as core
use "./workspaces.allium" as workspaces

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- How the screen's add-member and grant prompts and the tools' person
-- argument find one person. One function, so a key and a tool cannot
-- disagree. The board implements it (`models::resolve_person`).
contract PersonResolution {
    resolve_person: (text: String) -> workspaces/UserProfile

    @invariant AnIdentityMatchWinsOverAName
        -- The text is trimmed; a blank text is refused before any lookup.
        -- Matching is exact and case-sensitive: a fuzzy match picking the
        -- wrong person for an access grant costs more than a retry.
        -- The identity matches are the profiles whose identity equals the
        -- text, or starts with it when the text is at least
        -- workspaces.allium config.identity_prefix_length long. The name
        -- matches are the profiles whose shown_name equals the text.
        -- One identity match is the answer. Several identity matches are
        -- ambiguous even when one name matches exactly: the text was meant
        -- as an identity, so no name is consulted. With no identity match,
        -- one name match is the answer and several are ambiguous. So a
        -- person whose display name looks like somebody else's identity
        -- cannot hijack it.

    @invariant AnAmbiguousOrUnknownNameIsRefused
        -- An ambiguous text is refused, listing each match as
        -- "<shown name> (<identity prefix>)" and saying to name one by
        -- identity. A text that matches nobody is refused saying no one has
        -- that name and pointing at list_workspaces for the directory.
}

------------------------------------------------------------
-- Rules: the admin screen
------------------------------------------------------------

rule OpenAdminScreen {
    when: OpenAdminScreenKeyPressed()

    ensures: AdminScreenOpened(pane: workspaces_pane)

    @guidance
        -- `A` ("admin") in the board's normal mode (listed in the keybinding table).
        -- The screen reads the directory, the workspaces and the memberships
        -- when it opens and again after every write it makes; it holds a
        -- snapshot, so what it shows is what the last read saw. It lists the
        -- workspaces the person administers: all of them for a super-admin,
        -- the ones they are admin of otherwise. A person who administers none
        -- sees "You administer no workspace." and, while the store has no
        -- super-admin, "No super-admin yet: press c to claim it." (A3).
        -- Esc closes it and returns to the board; nothing is held open.
}

rule MoveAmongAdminPanes {
    when: AdminPaneKeyPressed()

    ensures: AdminPaneChanged()

    @guidance
        -- Tab and Shift-Tab cycle Workspaces -> Members -> Super-admins ->
        -- Unseen items and back. Members lists the people of the highlighted
        -- workspace, with their role. Super-admins and Unseen items show only
        -- for a super-admin; the others skip past them. j/k (or Down/Up) move
        -- the highlight inside a pane and stop at either end.
}

rule CreateWorkspaceFromScreen {
    when: CreateWorkspaceKeyPressed(admin)

    requires: admin.is_super_admin

    ensures: TextInputOpened(purpose: new_workspace_name)

    @guidance
        -- `n`, on the Workspaces pane, super-admin only. Enter sends
        -- CreateWorkspace(typed); a blank entry sends nothing; Esc sends
        -- nothing. The store's refusal (name taken, too long) shows in the
        -- error popup; success shows "Workspace <name> created" on the status
        -- line and the new workspace is highlighted.
}

rule RenameWorkspaceFromScreen {
    when: RenameWorkspaceKeyPressed(workspace)

    ensures: TextInputOpened(purpose: rename_workspace, prefilled: workspace.name)

    @guidance
        -- `r`, on the Workspaces pane, for a workspace the person administers.
        -- The input opens with the current name. Enter sends
        -- RenameWorkspace(workspace, typed).
}

rule DeleteWorkspaceFromScreen {
    when: DeleteWorkspaceKeyPressed(admin)

    requires: admin.is_super_admin

    ensures: ConfirmationOpened(purpose: delete_workspace)

    @guidance
        -- `d`, on the Workspaces pane, super-admin only. A y/n confirmation
        -- names the workspace and how many members go with it. `y` sends
        -- DeleteWorkspace; the store refuses while it holds any epic or
        -- package, and the error popup says so.
}

rule AddMemberFromScreen {
    when: AddMemberKeyPressed(workspace)

    ensures: TextInputOpened(purpose: member_to_add)

    @guidance
        -- `a`, on the Workspaces or Members pane, for the highlighted
        -- workspace. The input takes a display name or an identity
        -- (PersonResolution). Enter resolves it and sends
        -- AddMember(workspace, person, member); an ambiguous or unknown name
        -- shows PersonResolution's refusal in the error popup and adds
        -- nobody. The new member has the role member; `m` promotes them.
        -- The status line reads "Added <shown name> to <workspace>".
}

rule SetMemberRoleFromScreen {
    when: ToggleRoleKeyPressed(membership)

    ensures:
        workspaces/SetMemberRole(membership,
                                 if membership.role = admin: member else: admin)

    @guidance
        -- `m`, on the Members pane. Flips the highlighted person between
        -- admin and member in one key: the roles are fixed and there are two
        -- (workspaces.allium D1). No confirmation: it is undone by pressing it
        -- again. An admin may demote themselves.
}

rule RemoveMemberFromScreen {
    when: RemoveMemberKeyPressed(membership)

    ensures: ConfirmationOpened(purpose: remove_member)

    @guidance
        -- `x`, on the Members pane. A y/n confirmation names the person and
        -- the workspace, and says their private items there stay unseen. `y`
        -- sends RemoveMember.
}

rule GrantSuperAdminFromScreen {
    when: GrantSuperAdminKeyPressed(admin)

    requires: admin.is_super_admin

    ensures: TextInputOpened(purpose: super_admin_to_grant)

    @guidance
        -- `g`, on the Super-admins pane. Takes a name like add-member does and
        -- sends GrantSuperAdmin(person).
}

rule RevokeSuperAdminFromScreen {
    when: RevokeSuperAdminKeyPressed(admin)

    requires: admin.is_super_admin

    ensures: ConfirmationOpened(purpose: revoke_super_admin)

    @guidance
        -- `v`, on the Super-admins pane. A y/n confirmation. `y` sends
        -- RevokeSuperAdmin; the store refuses the last super-admin.
}

rule ClaimSuperAdminFromScreen {
    when: ClaimSuperAdminKeyPressed()

    requires: not UserProfiles.any(p => p.is_super_admin)

    ensures: workspaces/ClaimSuperAdmin()

    @guidance
        -- `c`, from any pane, only while the screen shows the claim hint. No
        -- confirmation: it works once and is recoverable (workspaces.allium
        -- D11). While a super-admin exists the key is not in the screen's
        -- help and does nothing.
}

rule DeleteUnseenItemFromScreen {
    when: DeleteUnseenItemKeyPressed(admin, item)

    requires: admin.is_super_admin

    ensures: ConfirmationOpened(purpose: delete_unseen_item, item: item)

    @guidance
        -- `D`, on the Unseen items pane. Each row reads "<kind> #<id>  <workspace>
        -- by <creator shown name>  <created date>". No title: the person
        -- cannot read it (workspaces.allium D3). The confirmation says the
        -- item is deleted for good and that an epic goes with its subtree.
        -- `y` sends SuperAdminDeletesUnseenItem(item); an epic with an
        -- unfinished task in its subtree is refused (A6) and the popup says so.
}

rule AdminScreenRefreshesAfterAWrite {
    when: AnAdminWriteFinished(result)

    requires: result = success

    ensures: AdminScreenReloaded()

    @guidance
        -- After a success the snapshot is read again and the highlight keeps
        -- its place by id, falling back to the nearest row when its row is
        -- gone. After a refusal nothing is reloaded: the error popup is the
        -- answer and the screen is as it was.
}

------------------------------------------------------------
-- Rules: the MCP twins
------------------------------------------------------------

rule ListWorkspacesTool {
    when: ListWorkspacesToolCalled(workspace_id?)

    let reader = workspaces/UserProfile{identity: caller()}
    let super_admins = UserProfiles where is_super_admin

    ensures:
        ToolResult(workspaces: visible_workspaces(reader, workspace_id),
                   super_admins: super_admins,
                   claimable: super_admins.count = 0)

    @guidance
        -- visible_workspaces is every workspace for a super-admin and the
        -- reader's own otherwise, narrowed to workspace_id when given; each
        -- carries its id, name and members (membership id, shown name,
        -- identity prefix, role). The result also lists the whole directory
        -- unless workspace_id narrows it.
        -- read_only. The one tool for "who is in what, and who can I add". It
        -- doubles as the directory agents add people from: every person by
        -- shown name and identity prefix, so a duplicated name can be told
        -- apart (A2). `workspace_id` narrows to one workspace and its members;
        -- the directory is then left out, to keep the answer short. A person
        -- sees the workspaces they belong to; a super-admin sees all.
        -- The result says when claim_super_admin is available.
}

rule CreateWorkspaceTool {
    when: CreateWorkspaceToolCalled(name)

    ensures: workspaces/CreateWorkspace(name)

    @guidance
        -- write. Super-admin only, by the store. The result names the new
        -- workspace and its id.
}

rule UpdateWorkspaceTool {
    when: UpdateWorkspaceToolCalled(workspace_id, name?, delete?)

    let workspace = core/Workspace{id: workspace_id}

    requires: (name != null) != (delete = true)

    ensures:
        if name != null: workspaces/RenameWorkspace(workspace, name)
        if delete = true: workspaces/DeleteWorkspace(workspace)

    @guidance
        -- destructive, as update_work_package is, because delete is an
        -- argument of it. Exactly one of name and delete is given; both or
        -- neither is refused with the shape of a valid call. Rename needs a
        -- super-admin or the workspace's admin; delete needs a super-admin and
        -- an empty workspace, both by the store.
}

rule SetWorkspaceMemberTool {
    when: SetWorkspaceMemberToolCalled(workspace_id, person, role?, remove?)

    let workspace = core/Workspace{id: workspace_id}
    let resolved = resolve_person(person)    -- PersonResolution
    let existing = core/Membership{workspace: workspace, user: resolved.identity}

    requires: (role != null) != (remove = true)

    ensures:
        if remove = true: workspaces/RemoveMember(existing)
        else if exists existing: workspaces/SetMemberRole(existing, role)
        else: workspaces/AddMember(workspace, resolved.identity, role)

    @guidance
        -- destructive, because remove is an argument of it. One tool for the
        -- three membership changes: giving a role to a person who is not in the
        -- workspace adds them, giving one to a member changes it, remove
        -- takes them out. person is a display name or an identity (A2); an
        -- ambiguous one is refused with the matches. Removing someone who is
        -- not a member is refused, not ignored. Setting the role a member
        -- already has changes nothing and succeeds.
}

rule SetSuperAdminTool {
    when: SetSuperAdminToolCalled(person, super_admin)

    let resolved = resolve_person(person)    -- PersonResolution

    ensures:
        if super_admin: workspaces/GrantSuperAdmin(resolved.identity)
        else: workspaces/RevokeSuperAdmin(resolved.identity)

    @guidance
        -- idempotent. Granting a person who already is one, or revoking one
        -- who is not, changes nothing and succeeds; the store still refuses
        -- revoking the last super-admin.
}

rule ClaimSuperAdminTool {
    when: ClaimSuperAdminToolCalled()

    ensures: workspaces/ClaimSuperAdmin()

    @guidance
        -- write. Works only while the store has no super-admin, for the person
        -- whose board the agent runs under (workspaces.allium D10, D11). The
        -- refusal says a super-admin already exists.
}

rule ListUnseenItemsTool {
    when: ListUnseenItemsToolCalled()

    ensures: ToolResult(items: unseen_items_for(caller()))

    @guidance
        -- read_only. unseen_items_for is the rows UnseenItemListing serves the
        -- caller: every unseen item for a super-admin, nothing for anyone
        -- else, who also gets a line saying so. Each item is kind, id,
        -- workspace, creator by shown name and created date, and never a
        -- title or content. The result points at delete_unseen_item as the
        -- only thing to do with one.
}

rule DeleteUnseenItemTool {
    when: DeleteUnseenItemToolCalled(kind, item_id)

    let item = item_named(kind, item_id)    -- the epic or the work package with that id

    ensures: workspaces/SuperAdminDeletesUnseenItem(item)

    @guidance
        -- destructive. kind is epic or work_package, as list_unseen_items
        -- names it. A public item, an unknown id and an item the caller may
        -- not delete are all refused in the store's words (workspaces.allium:
        -- UnseenIsAsMissing).
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The admin screen, at the board. Each key's binding is in keybindings.allium.
surface AdminScreen {
    facing person: workspaces/Person

    exposes:
        for w in Workspaces where w.is_admin(person.identity) or person.is_super_admin:
            w.name
            w.memberships
        -- The directory: every person, by shown name and identity.
        for profile in UserProfiles:
            profile.identity
            profile.shown_name
            profile.is_super_admin

    provides:
        -- [A] in the board's normal mode (OpenAdminScreen).
        OpenAdminScreenKeyPressed()
        -- Tab, Shift-Tab, j/k (MoveAmongAdminPanes).
        AdminPaneKeyPressed()
        -- [n], [r], [d] on the Workspaces pane.
        CreateWorkspaceKeyPressed(person) when person.is_super_admin
        RenameWorkspaceKeyPressed(workspace)
        DeleteWorkspaceKeyPressed(person) when person.is_super_admin
        -- [a], [m], [x] on the Workspaces or Members pane.
        AddMemberKeyPressed(workspace)
        ToggleRoleKeyPressed(membership)
        RemoveMemberKeyPressed(membership)
        -- [g], [v] on the Super-admins pane.
        GrantSuperAdminKeyPressed(person) when person.is_super_admin
        RevokeSuperAdminKeyPressed(person) when person.is_super_admin
        -- [c] from any pane while the store has no super-admin.
        ClaimSuperAdminKeyPressed() when not UserProfiles.any(p => p.is_super_admin)
        -- [D] on the Unseen items pane, which shows UnseenItemListing.
        DeleteUnseenItemKeyPressed(person, item) when person.is_super_admin

    contracts:
        fulfils PersonResolution

    @guarantee TheScreenRefusesNothingTheStoreAllows
        -- The screen hides a key the person's role cannot use only to keep
        -- the help short. It never decides: a key shown always sends, and the
        -- store's refusal is what the person reads.

    @guarantee UnseenItemRowsShowNoContent
        -- An Unseen items row shows what UnseenItemListing exposes and nothing
        -- else (workspaces.allium: UnseenItemListingShowsNoContent). The board
        -- never holds a private item's title to draw it.
}

-- The private items nobody can see, as the store serves them: the module's
-- `unseen_items` view, empty for anyone but a super-admin (A4).
surface UnseenItemListing {
    facing _: workspaces/SuperAdmin

    -- "Unseen" is workspaces.allium's definition: private, and its creator is
    -- no longer a member of its workspace, or it has none, so nobody sees it
    -- (D3). A private epic is its own holder (D5), so its creator is the
    -- person it is private to. A private item whose creator is still a member
    -- is seen by that creator and is not listed.
    let unseen_epics = Epics
        where visibility = private and not workspace.has_member(created_by)
    let unseen_packages = WorkPackages
        where visibility = private and not workspace.has_member(created_by)

    exposes:
        -- kind epic
        for epic in unseen_epics:
            epic.id
            epic.workspace
            epic.created_by
            epic.created_at
        -- kind work_package
        for package in unseen_packages:
            package.id
            package.workspace
            package.created_by
            package.created_at

    @guarantee ARowIsKindIdWorkspaceCreatorAndDate
        -- Each row is kind, id, workspace, creator (an identity, "" for an
        -- item with none; shown by shown_name) and created date. Never a
        -- title, description or child row. Rows are ordered by workspace id,
        -- then kind, then id. Every private epic is judged on its own (A5).
}

-- The admin tools of the dispatch MCP server.
surface AdminTools {
    facing _: core/McpClient

    provides:
        -- list_workspaces (ListWorkspacesTool). Read-only.
        ListWorkspacesToolCalled(workspace_id?)
        -- create_workspace (CreateWorkspaceTool). Write.
        CreateWorkspaceToolCalled(name)
        -- update_workspace (UpdateWorkspaceTool). Destructive.
        UpdateWorkspaceToolCalled(workspace_id, name?, delete?)
        -- set_workspace_member (SetWorkspaceMemberTool). Destructive.
        SetWorkspaceMemberToolCalled(workspace_id, person, role?, remove?)
        -- set_super_admin (SetSuperAdminTool). Idempotent.
        SetSuperAdminToolCalled(person, super_admin)
        -- claim_super_admin (ClaimSuperAdminTool). Write.
        ClaimSuperAdminToolCalled()
        -- list_unseen_items (ListUnseenItemsTool). Read-only.
        ListUnseenItemsToolCalled()
        -- delete_unseen_item (DeleteUnseenItemTool). Destructive.
        DeleteUnseenItemToolCalled(kind, item_id)

    contracts:
        fulfils PersonResolution

    @guidance
        -- The caller is an agent or a session (core/McpClient), acting as the
        -- person whose board it runs under (workspaces.allium D10). What it
        -- may do is the store's to decide.
}

-- The store's answer to a write the admin screen sent.
surface AdminWriteResults {
    facing _: core/SharedStore

    provides:
        AnAdminWriteFinished(result)
}
