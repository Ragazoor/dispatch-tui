-- allium: 3
-- pr-workflow.allium
--
-- Scope: PR creation, polling, merge detection, and the agent-driven
--        wrap-up / session-close flows for tasks: the host's rebase and
--        window teardown, and what a session close writes to the task.
-- Excludes: Task creation and kanban lifecycle (see tasks.allium);
--           dispatch (see dispatch.allium); split pane (see split-pane.allium);
--           the wrap-up and exit-session request rows, their states, the
--           exit token, the conflict sub_status writes and their timeouts,
--           which the store's module owns since store-split M5 (see
--           store-split.allium: SessionRequest, RequestWrapUp,
--           RequestExitSession and the rules after them); update_tasks'
--           done-path close, which the module owns since store-split M7
--           (store-split.allium: RequestCloseTask). The host's teardown of
--           that close's row is here (ExitSessionTeardown).

use "./core.allium" as core
use "./store-split.allium" as split

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == PR Workflow ==

rule CreatePr {
    when: CreatePr(task)

    requires: task.status = running or task.status = review
    requires: task.worktree != null

    ensures: task.url != null and task.url.url_type = pr
    ensures: task.status = review
    ensures: task.sub_status = core/SubStatus.default_for(review)
    ensures: task.updated_at = now
    ensures: PrCreated(base: task.base_branch, head: task.worktree.branch)

    @guidance
        -- The PR-creation transition. The url (with url_type = pr) is
        -- supplied by the agent (via update_tasks) after the agent runs
        -- `gh pr create --draft`. Dispatch no longer drives the push
        -- or the gh invocation — see WrapUpPr for the rationale and
        -- the agent-side command sequence. The task always transitions
        -- to review with sub_status = awaiting_review regardless of
        -- the starting status (Running or Review).
}

rule PrLearningsGate {
    when: PrLearningsGateCheck(task)

    ensures:
        if task.pr_learnings_gate_shown_at = null:
            task.pr_learnings_gate_shown_at = now
            PrCreateBlocked(task: task)
        else:
            PrCreateAllowed(task: task)

    @guidance
        -- Fires from a Claude Code PreToolUse hook (pr-learnings-hook)
        -- that matches `gh pr create` Bash commands and calls
        -- `dispatch pr-gate <id>`. The first attempt per task is blocked
        -- with a reminder to consult the knowledge base via
        -- query_learnings; the flag persists so subsequent attempts and
        -- resumed sessions pass. One-time reminder, not enforcement —
        -- dispatch does not verify query_learnings actually ran.
        --
        -- The gate reaches the board rather than the database, like every
        -- other hook (agent-health.allium: HookDelivery). It differs from the
        -- rest in what an unreachable board costs: the other hooks drop the
        -- event they were carrying, but this one has no event to drop — the
        -- tool call is waiting on its answer. It **fails open**. The attempt
        -- is allowed, the unreachable board is reported, and the task keeps
        -- its unshown flag, so the reminder is deferred to the next attempt
        -- rather than lost. The same holds for a board that answers but
        -- cannot decide the gate, and for an answer this version cannot
        -- read: anything short of a verdict allows the attempt. Only a
        -- verdict of "first attempt" blocks one. Blocking instead would put a board's health
        -- between an agent and its submission, which is a far higher price
        -- than a reminder is worth — it is a reminder, not enforcement, and
        -- this is the same judgement made twice.
        --
        -- Scope is the whole submission, not the PR description: worded
        -- as "PR conventions" the reminder is read literally, the agent
        -- retrieves nothing governing the code itself (comment style,
        -- naming), and those violations ship. The gate is the last
        -- forced stop before a diff reaches a human reviewer.
        --
        -- No tag_filter is suggested: a suggested tag gets copied
        -- verbatim, and because tag_filter is a soft score boost
        -- (QueryLearningsViaMcp in learnings.allium) it demotes
        -- everything else until `limit` drops it. The reminder points at
        -- `query` instead, which is what the ranking keys on.
}

rule PollPrStatus {
    when: Tick()

    -- `pr_poll_due` reads this task's core/PrPollState and answers false in
    -- exactly two cases: polling gave up on the task (gave_up), or its
    -- transient backoff deadline has not passed yet (next_poll_at > now). A
    -- task with no poll state has never failed, so it is always due.
    --
    -- The host clause admits two shapes of task, deliberately not one: a task
    -- WITH a worktree (task.host = local_host()) and every host-less task
    -- (task.host = null), whoever runs this tick. The second shape is
    -- ADMITTED, not yet DECIDED — every host's tick sees every host-less due
    -- task, and `owns` below (not this filter) is what narrows that to the
    -- one host actually allowed to act. Narrowing here instead, with a
    -- `PollOwner` lookup in the filter itself, is not available: `where`
    -- predicates cannot bind the `let` this rule needs to also read
    -- `poll_owner` inside `ensures`.
    for task in core/Tasks
        where status = review
          and url != null
          and url.url_type = pr
          and pr_poll_due(task)
          and (task.host = null or task.host = local_host()):

        -- A task WITH a worktree is already unambiguously owned by the
        -- machine holding it (core/Task.host, core/HostTracksWorktree) — no
        -- PollOwner row is ever created or consulted for it, since a second
        -- answer to "who owns this?" is a second place for it to disagree
        -- with the first. Only a host-less task (an "open PRs"-style feed
        -- upserted it straight into review with no dispatch, so it never got
        -- a worktree — see feeds.allium: UpsertFeedTasks) needs one.
        let poll_owner = if task.host = null: core/PollOwner{scope: task, scope_id: task.id} else: null
        let owns = task.host != null or not exists poll_owner or poll_owner.host = local_host()

        -- Branch first on whether GitHub answered at all, then on the state it
        -- reported:
        --   succeeded, merged -> fire PrMerged; task moves to done
        --   succeeded, closed -> fire PrClosed; task stays in review,
        --                        sub_status becomes pr_closed
        --   succeeded, open   -> refresh sub_status from review_decision
        --   failed permanently -> count it; at the threshold, give up and mark
        --                         the task pr_unreachable
        --   failed transiently -> widen the backoff and try again later
        -- Only pr-typed urls are polled; tasks carrying a security_alert,
        -- issue, or other url are never polled for PR merge/close.
        --
        -- A host-less task with no PollOwner row is claimed here, by
        -- whichever host's tick reaches this point first for it — the
        -- claim is permanent (core/PollOwner): there is no expiry, no
        -- automatic failover and, since the override_poll_owner MCP tool was
        -- removed, no way to reassign a task-scope claim to another host. A host that is NOT the owner
        -- (`owns = false`) does nothing at all this tick: no GitHub call, no
        -- PrPollState write, no claim attempt — it is simply not this
        -- host's task to act on.
        ensures:
            if owns:
                if task.host = null and not exists poll_owner:
                    core/PollOwner.created(
                        scope: task,
                        scope_id: task.id,
                        host: local_host(),
                        claimed_at: now
                    )

                let outcome = check_pr_status(task.url.url)
                let poll = core/PrPollState{task}

                if outcome.kind = core/PrCheckOutcome.succeeded:
                    -- Reaching GitHub retires every earlier failure, including a
                    -- give-up. This is the only path out of pr_unreachable, which
                    -- is why the open branch below does not guard against it the
                    -- way it guards conflict.
                    if exists poll:
                        poll.consecutive_permanent_failures = 0
                        poll.consecutive_transient_failures = 0
                        poll.next_poll_at = null
                    if outcome.state = merged:
                        PrMerged(task: task)
                    else if outcome.state = closed:
                        PrClosed(task: task)
                    else if outcome.state = open and task.sub_status != conflict:
                        let new_sub =
                            if outcome.review_decision = approved:
                                core/SubStatus.approved
                            else if outcome.review_decision = changes_requested:
                                core/SubStatus.changes_requested
                            else:
                                core/SubStatus.awaiting_review
                        if task.sub_status != new_sub:
                            task.sub_status = new_sub

                else if outcome.kind = core/PrCheckOutcome.failed_permanently:
                    let failures =
                        if exists poll: poll.consecutive_permanent_failures + 1
                        else: 1
                    if exists poll:
                        poll.consecutive_permanent_failures = failures
                    else:
                        core/PrPollState.created(
                            task: task,
                            consecutive_permanent_failures: failures,
                            consecutive_transient_failures: 0,
                            next_poll_at: null
                        )
                    if failures >= core/config.pr_poll_permanent_failure_threshold:
                        task.sub_status = core/SubStatus.pr_unreachable
                        task.updated_at = now
                        PrPollGaveUp(task: task, reason: outcome.reason)

                else:
                    -- Transient: the permanent counter is deliberately left
                    -- untouched — a network blip must never accumulate towards a
                    -- give-up — and only the deadline moves, widening from
                    -- pr_poll_interval up to pr_poll_backoff_max.
                    let transients =
                        if exists poll: poll.consecutive_transient_failures + 1
                        else: 1
                    let deadline = now + next_pr_poll_backoff(transients)
                    if exists poll:
                        poll.consecutive_transient_failures = transients
                        poll.next_poll_at = deadline
                    else:
                        core/PrPollState.created(
                            task: task,
                            consecutive_permanent_failures: 0,
                            consecutive_transient_failures: 1,
                            next_poll_at: deadline
                        )

    @guidance
        -- Runs during each tick for review tasks whose url is pr-typed
        -- (url.url_type = pr). Tasks with a non-pr url (security_alert,
        -- issue, other) or no url are skipped entirely. Polls
        -- GitHub every pr_poll_interval (30s) via `gh pr view` to check
        -- merge status and review decision.
        -- Merged PRs: fire PrMerged which transitions the task to done.
        -- Open PRs: update sub_status to reflect the current review
        -- decision (approved | changes_requested | awaiting_review).
        -- Tasks currently in sub_status = conflict are NOT overwritten
        -- by the review-decision update, so conflict state persists
        -- across polls until the user resolves it.
        -- Closed-without-merge PRs: fire PrClosed every tick the PR stays
        -- closed. Unlike PrMerged, this is NOT a terminal transition — the
        -- task stays in review; see the PrClosed rule for what changes.
        --
        -- == Why failure is branched, not merely logged ==
        --
        -- A PR read can fail for a reason no amount of retrying will fix: the
        -- repository does not resolve, the credentials are bad, or the url has
        -- no PR behind it. Polling one of those every pr_poll_interval is not
        -- resilience, it is a loop, and the user learns nothing from it — the
        -- card sits in awaiting_review indefinitely, reporting a review state
        -- dispatch has not actually been able to read since the PR was opened.
        --
        -- So permanent failures are counted, and at
        -- pr_poll_permanent_failure_threshold consecutive ones the task is
        -- marked pr_unreachable and polling stops. The threshold is above one
        -- deliberately: a GitHub incident can briefly report a real repository
        -- as unresolvable, and a single blip must not strand a task.
        --
        -- Transient failures never advance that counter. They widen the
        -- backoff instead, so a GitHub outage or a spent rate limit costs a
        -- slowing trickle of calls rather than one per task per tick.
        --
        -- Recovery needs no user action on the task, because usually there is
        -- none available: the fix for "no account has access" happens on
        -- GitHub. Give-up state is session-scoped (core/PrPollState), so a
        -- restart retries; and any poll that reaches GitHub clears
        -- pr_unreachable through the succeeded branch.
        --
        -- == Host scoping ==
        --
        -- On a shared board every teammate's tick used to run this rule for
        -- the same task, independently: the merge/close outcome converges
        -- (harmless), but consecutive_permanent_failures,
        -- consecutive_transient_failures and next_poll_at are per-attempt
        -- counters two hosts polling at their own cadence would race, and a
        -- give-up's UserInformed could fire on several machines for the one
        -- task. `owns` above closes this: for a worktree-backed task the
        -- worktree's own host already answers it for free; for a host-less
        -- one (see feeds.allium: UpsertFeedTasks for where those come from)
        -- core/PollOwner gives it a single, explicit, permanent owner
        -- instead. A single doubled poll at the exact instant two hosts
        -- both see a fresh, unclaimed host-less task for the first time is
        -- possible (whichever PollOwner insert the store serialises first
        -- wins) and is not a correctness problem — it costs one extra `gh`
        -- call, the same order of cost this rule's own transient-failure
        -- tolerance already accepts.
        --
        -- M6 (store-split.allium: ReportPrStatus, ReportPrUnreadable): the
        -- host runs `gh pr view` and posts the raw state and reviewDecision
        -- strings through the report_pr_status reducer; the MODULE parses
        -- them and writes the task. The host keeps only the local work: the
        -- gh call, the failure counters and backoff (session-scoped, P3),
        -- and the effects named in PrMerged below. "Reaching GitHub" in the
        -- succeeded branch means the module ACCEPTED the report: only then
        -- are the failure counters cleared. A refused report counts as a
        -- permanent failure, a failed reducer call as a transient one.
}

rule PrPollGaveUp {
    when: PrPollGaveUp(task, reason)

    requires: task.status = review

    -- Nothing to write to PrPollState here: by the time this fires,
    -- PollPrStatus has already raised consecutive_permanent_failures past the
    -- threshold, and gave_up is derived from that counter — so it is already
    -- true. This rule's only remaining obligation is telling the user.
    ensures: UserInformed(about: pr_unreachable, task: task)

    @guidance
        -- Fires once, on the transition into giving up — not on every tick, and
        -- not on each of the failures leading up to the threshold. The
        -- corresponding log line is emitted here too, which is the whole point
        -- of the card this rule answers: the old code logged one WARN per failed
        -- attempt, so five unreadable PRs produced 63,000 identical lines.
        --
        -- Splitting this out of PollPrStatus mirrors PrMerged and PrClosed: the
        -- poll rule detects, a named rule reacts.
        --
        -- Unlike PrMerged and PrClosed there is no distinct message carrying
        -- this event in the implementation — the counting rule and this one are
        -- satisfied together, in the handler that receives the failed read. The
        -- decomposition is behavioural, so do not go looking for a
        -- `PrPollGaveUp` variant.
        --
        -- `reason` carries the underlying gh failure so the log line and the
        -- user-facing message can name it — "Could not resolve to a Repository"
        -- is far more useful to the user than "PR unreachable".
        --
        -- Not terminal: the task stays in review. See core/PrPollState for why
        -- an app restart retries, and PollPrStatus's succeeded branch for the
        -- clearing path.
        --
        -- M6: the host counts the failures and, at the threshold, posts
        -- report_pr_unreadable; the module writes sub_status = pr_unreachable
        -- (store-split.allium: ReportPrUnreadable). The UserInformed and the
        -- log line stay with the host.
}

rule PrMerged {
    when: PrMerged(task)

    requires: task.status = review

    ensures: task.status = done
    ensures: task.sub_status = core/SubStatus.default_for(done)
    ensures: task.tmux_window = null
    ensures: task.updated_at = now
    ensures: task.completed_at = now
    ensures:
        if notifications_enabled:
            DesktopNotification(task: task, urgency: normal, about: pr_merged)

    @guidance
        -- This is an automatic transition triggered by PR status polling.
        -- It bypasses the ConfirmDone human confirmation because the PR
        -- merge itself is the human confirmation (via GitHub review process).
        -- The Review Board UI has been removed; no board cleanup side effect fires.
        -- The write that moves the task to done also runs
        -- EpicStatusRecalculation on the parent epic when the task belongs
        -- to one.
        -- task.completed_at = now is the same completion stamp applied by
        -- ConfirmDone (tasks.allium): the Done column reads it descending, so
        -- more-recently-completed tasks sort first.
        -- A merged PR on a phoenix task respawns it (tasks.allium:
        -- PhoenixRespawn), on the same terms as any other route into done: the
        -- trigger is the status transition, and the same reducer write that
        -- makes it spawns the successor.
        --
        -- M6: the module writes the Done transition, window clear and
        -- completed_at (store-split.allium: ReportPrStatus), including the
        -- epic rollup and the phoenix successor. The host, after its report
        -- is accepted, kills the tmux window it read BEFORE posting (the
        -- module cleared it), sends the DesktopNotification and respawns the
        -- split pane. The task keeps its worktree.
}

rule PrClosed {
    when: PrClosed(task)

    requires: task.status = review

    ensures:
        if task.sub_status != core/SubStatus.pr_closed:
            task.sub_status = core/SubStatus.pr_closed
            task.updated_at = now
            if notifications_enabled:
                DesktopNotification(task: task, urgency: normal, about: pr_closed)

    @guidance
        -- Fires when PR status polling detects a closed (not merged) PR.
        -- Unlike PrMerged, this is NOT a terminal transition: task.status
        -- stays review, and task.tmux_window / task.worktree / task.completed_at
        -- are all left untouched — a closed PR doesn't end the task, it just
        -- flags that a human should decide what to do next (reopen the PR,
        -- push a new one, complete and delete the task).
        -- Idempotent: PollPrStatus re-fires PrClosed on every tick the PR
        -- stays closed, but the guard on sub_status != pr_closed means the
        -- notification and the persisted write only happen once, on the
        -- transition into pr_closed — not on every subsequent tick.
        -- Overrides sub_status = conflict unconditionally — unlike the
        -- open-PR poll branch, there is no conflict guard here. A closed PR
        -- is a stronger, more definitive GitHub signal than a local rebase
        -- conflict, and the user needs to see it regardless.
        -- Notification: title "PR closed", body "<PR label> closed: <task
        -- title>". Status bar shows '<PR label> closed — task #<id> marked
        -- "PR closed"'.
        --
        -- M6: the module writes the sub_status (store-split.allium:
        -- ReportPrStatus); the host sends the notification and sets the
        -- status line when the report changed the task.
}

rule ClosePrOnDone {
    when: task: core/Task.status transitions_to done

    requires: task.url != null and task.url.url_type = pr

    ensures: PrCloseRequested(task: task, url: task.url.url)

    @guidance
        -- Every route into Done carries this, for the same reason
        -- PhoenixRespawn (tasks.allium) fires on every route in: the trigger
        -- is the status transition itself, not any one operator action.
        -- transitions_to reaches all five routes — see PhoenixRespawn's
        -- guidance for the full list (ConfirmDone, EditTask's STATUS
        -- section, update_tasks' status="done" path, ExitSession's rebase
        -- and done branches, and PrMerged).
        -- The gh call needs a host. ConfirmDone and EditTask write through
        -- the board's TaskService::update_task (src/service/tasks/crud.rs),
        -- which spawns it once the module's patch has landed. ExitSession's
        -- branches (since store-split M5) and update_tasks' done path
        -- (store-split.allium: RequestCloseTask, since M7) write in the
        -- module instead, and the host serving the close's exit_session or
        -- close row runs it (ExitSessionTeardown). That owner was confirmed
        -- as a decision in M7 (store-split.allium, "ClosePrOnDone's owner"):
        -- a row that fails before its host serves it leaves the PR open,
        -- accepted as built and flagged for user review.
        --
        -- Fired for PrMerged deliberately, not by oversight. Closing a PR
        -- that just merged is a no-op `gh` itself refuses, and there is no
        -- cheap signal at either writer distinguishing "entered done
        -- because my own PR was just merged" from any other route in —
        -- threading a new skip flag through every caller to avoid one
        -- harmless, quietly-logged `gh` error is not worth the seam it
        -- would add. See below for how that outcome is logged.
        --
        -- NOT fired for PrClosed (above): that rule leaves task.status at
        -- review, so it never crosses this trigger — a closed-without-merge
        -- PR stays open on GitHub until a human decides what to do with the
        -- task, exactly as PrClosed's own guidance describes. NOT fired for
        -- a task already Done being re-saved (done -> done), matching
        -- transitions_to's own creation/no-op exemptions — which also
        -- means a task inserted directly with status = done (a feed item
        -- that already arrived done, feeds.allium: UpsertFeedTasks) never
        -- reaches this rule, since transitions_to never fires on creation.
        --
        -- Runs `gh pr close <url>` best-effort, after the Done write has
        -- already persisted. Never blocks, delays or fails the Done
        -- transition on the outcome — the task is already done by the time
        -- this fires. Unlike PollPrStatus there is no retry, backoff or
        -- give-up state: this is a one-shot attempt, because there is
        -- nothing to poll for — either the close took or it didn't, and the
        -- operator already has what they asked for (the task is Done). The
        -- outcome is logged, never surfaced to the user: an expected
        -- failure (the PR was already merged or already closed) logs at a
        -- quieter level than an unexpected one (bad credentials, an
        -- unresolvable repository).
        --
        -- Scope is deliberately narrow: only a literal transition into Done.
        -- There is no route off the board that skips it: a task is deleted
        -- only from Done (tasks.allium: DeleteTask), so it has already
        -- crossed this trigger by the time it can be removed.
}

-- == Wrap Up ==

rule WrapUpRebase {
    when: SessionRequestClaimed(request)

    -- Since store-split M5 (store-split.allium: SessionRequest, W2) the
    -- rebase is a request row's host work. The module accepted the request
    -- only for a running or review task with a worktree on this host
    -- (store-split.allium: RequestWrapUp), and this board's claim of it was
    -- accepted (HostClaimsSessionRequest), which already cleared a conflict
    -- sub_status.
    requires: request.kind = wrap_up
    requires: request.action = rebase
    requires: request.host = core/local_host()
    -- D11's second line (store-split.allium, W11): the board serves only a
    -- request its own owner made; another is ignored and logged.
    requires: request.requested_by = core/local_host().owner

    let task = request.task
    let branch = task.worktree.branch
    -- The outcome of the git steps below, run against the row's deadline.
    let outcome = finish_task_outcome(task, request.deadline)

    ensures:
        if outcome.rebased:
            -- repo_path travels on the event because the consumer
            -- (RefreshRepoSyncStateAfterRebase in repo-sync.allium) needs the
            -- repository whose base branch just moved, and a branch name alone
            -- does not identify one. Emitted by this host whenever its rebase
            -- succeeded, whether or not the module then accepts the report:
            -- the base branch moved on this disk either way.
            BranchRebased(
                branch: branch,
                onto: task.base_branch,
                repo_path: task.repo_path
            )
            SessionRequestDone(request: request, reporter: core/local_host())
        else:
            -- conflict is true only for a genuine textual rebase conflict;
            -- the module then sets the conflict sub_status (FinishTaskConflict).
            SessionRequestFailed(
                request: request,
                reporter: core/local_host(),
                reason: outcome.message,
                conflict: outcome.conflict
            )

    @guidance
        -- wrap_up(action="rebase") writes no task field from this host. The
        -- conflict clear is the module's claim (store-split.allium:
        -- HostClaimsSessionRequest), the conflict write is the module's
        -- answer to a conflict report (FinishTaskConflict below, applied in
        -- store-split.allium's HostReportsSessionRequestFailed), and the
        -- terminal write belongs to ExitSession. The token the agent receives
        -- is the request row's id once the module records it done
        -- (store-split.allium, W3); the MCP tool waits for that
        -- (mcp-task-tools.allium: WrapUpViaMcp). Do not re-add an
        -- unconditional updated_at assertion: when the task was not in
        -- conflict, nothing about the task changes.
        --
        -- WrapUpRebase is the rebase mechanic only — it does NOT change
        -- task.status or kill the tmux window. The Done transition is
        -- owned by ExitSession (the agent must call exit_session to close
        -- its session, which marks the task done, and the window is torn
        -- down by ExitSessionTeardown).
        --
        -- The conflict sub_status is cleared optimistically when this host
        -- claims the row, before the rebase starts, so the task is no longer
        -- visually flagged while the rebase runs. A row that times out or
        -- fails for any other reason does not restore it.
        --
        -- THE ROW'S DEADLINE BOUNDS THE REBASE (store-split.allium, W7;
        -- config.wrap_up_rebase_timeout from requested_at). This host
        -- enforces it: no git step starts after the deadline, a step still
        -- running at it is killed like any timed-out subprocess, and the host
        -- reports failed with reason "deadline passed". The rebase abort that
        -- follows a killed or failed rebase still runs, under its own
        -- subprocess bound, so the worktree is not left mid-rebase by the
        -- deadline itself. The module's backstop (store-split.allium:
        -- SessionRequestTimesOut) fails a row this host never reports.
        --
        -- A REFUSED DONE REPORT (the row failed under this host, or the
        -- deadline passed before the report landed) leaves the rebase in
        -- git and issues no token; nothing is rolled back. A done report that
        -- gets no answer is sent once more (store-split.allium:
        -- HostRepeatsSessionRequestDone).
        --
        -- Steps (all via finish_task in src/dispatch/finish.rs, run by this
        -- host's board when it serves the row; the MCP handler only waits on
        -- the row and shapes the response):
        --   1. Verify the repo root is on task.base_branch; abort if not.
        --   2. Check the repo root's working tree is clean (`git status
        --      --porcelain`). If it has uncommitted changes, abort with
        --      DirtyPrimaryWorktree — this is checked upfront, before any
        --      pull/rebase/merge is attempted, so a dirty primary worktree
        --      never masquerades as a rebase conflict.
        --   3. If origin remote exists, `git pull origin <base_branch>`
        --      in the repo root (skipped when no remote is configured).
        --      "No remote" here means the probe ran and found none. A probe
        --      that could not be run at all is a different fact and aborts
        --      the whole operation, because rebasing past a base that was
        --      never refreshed on the strength of a failure to look is how
        --      an unrelated git problem turns into a silent stale rebase.
        --      (repo-sync.allium's SyncRepo deliberately collapses the two
        --      into no_remote instead — for that operation both mean
        --      "nothing to sync against".)
        --   4. `git rebase <base_branch>` from the task's worktree.
        --      On conflict: abort the rebase and report failed with
        --      conflict = true and a reason naming the actual conflicted
        --      file(s) parsed from git's output when present; the module
        --      then emits RebaseConflict (FinishTaskConflict).
        --   5. `git merge --ff-only <branch>` in the repo root to
        --      fast-forward the base branch to the rebased branch.
        --
        -- Every subprocess in the finish path is bounded by a timeout — the
        -- pull because it touches the network, and the rebase, the
        -- conflict-path status read, the rebase abort and the fast-forward
        -- because each can block on a repository lock. None of them may wedge
        -- the host: an unbounded call here would hold the row running until
        -- the backstop failed it, and the agent's wrap_up call would get no
        -- token. Each is bounded by its own subprocess timeout and, since M5,
        -- also by the row's deadline (above). A subprocess that times out is simply one that
        -- failed, reported through the existing `other` error — no new failure
        -- variant. The one asymmetric case is the rebase abort: if it times
        -- out the worktree is left mid-conflict, exactly as when the abort
        -- fails for any other reason, and the rule already reports the
        -- underlying conflict rather than the abort's fate.
        --
        -- The worktree is preserved after a successful rebase (cleaned
        -- up only on delete). finish_task performs no session teardown at
        -- all — it is the git half only — so the agent's session stays alive
        -- until it explicitly calls exit_session. The MCP wrap_up handler returns
        -- an exit token in its success response: the id of the done request
        -- row. The agent MUST pass this token to exit_session to close its
        -- session. The row records action = rebase, and the agent must call
        -- exit_session with action="rebase"; this action-recording is
        -- symmetric across all three wrap-up actions (rebase, done, pr) — see
        -- ExitSession, which owns the Done transition for every action.
        -- Reachable only from MCP (the wrap_up tool with action "rebase");
        -- there is no board entry point.
        --
        -- Verification and the commit check run BEFORE this rule's rebase, in
        -- the wrap_up tool itself: see WrapUpRefusesUnfinishedWork in
        -- mcp-task-tools.allium. A dirty worktree or a failing verify command
        -- refuses the call, so the branch is verified before the rebase starts. (The
        -- rebased result is not re-verified: see WrapUpRefusesUnfinishedWork.) The
        -- success response carries no "Verify before exiting" line.
        --
        -- The BranchRebased emission belongs to this rule, on the host that
        -- ran the rebase, which is the only rebase path. Its consumer is
        -- RefreshRepoSyncStateAfterRebase in repo-sync.allium, which
        -- refreshes this host's own view of the repository.
}

rule WrapUpPr {
    when: WrapUp(task, pr)

    -- Available from any running or review task with a worktree.
    requires: task.status = review or task.status = running
    requires: task.worktree != null

    ensures: PrCreated(base: task.base_branch, head: task.worktree.branch)

    @guidance
        -- wrap_up(action="pr") performs no task write whatsoever: the module
        -- writes a wrap_up request row already done, in the same call, whose
        -- id is the exit token (store-split.allium: RequestWrapUp, W2, W3),
        -- and the tool returns prose. There is no host work and no wait.
        -- Nothing here touches updated_at, and no updated_at assertion
        -- belongs on this rule — the terminal write (status, url, cleared
        -- tmux_window, updated_at) is ExitSession's.
        --
        -- Agent-driven PR creation. wrap_up(action="pr") no longer takes a
        -- pr_url and no longer mutates task.status or task.url. It leaves the
        -- task in status = running (its session is still alive) and issues an
        -- exit token whose row records action = pr. The pr-typed url and the review
        -- transition are applied later, atomically, by ExitSession — see the
        -- race-closure rationale on that rule.
        --
        -- The pr path's steps live in the /wrap-up skill's pr reference file,
        -- not in its SKILL.md: the skill names that file when the pr action is
        -- chosen, so an agent on the rebase or done path never loads it (see
        -- "Skill copy" at the head of mcp-task-tools.allium). That file
        -- instructs the agent to inspect its own diff,
        -- draft a title and body that reflect the actual work, run
        --   git push -u origin <branch>
        --   gh pr create --draft --base <task.base_branch>
        --     --head <owner>:<branch> --repo <owner>/<repo>
        --     --title <agent-authored> --body <agent-authored>
        -- then call wrap_up(action="pr") (no pr_url),
        -- and finally call exit_session(token, action="pr", pr_url=<url>) using
        -- the URL that `gh pr create` printed. It is exit_session that records
        -- task.url (with url_type = pr) and moves the task to review. The
        -- --head uses the owner:branch format so `gh` resolves the branch in
        -- the same repo as --repo (rather than the authenticated user's
        -- namespace). The PR base is task.base_branch (not hardcoded "main").
        -- PR status polling (PollPrStatus) only takes over once ExitSession
        -- has recorded the pr-typed url.
        --
        -- Rationale: previously dispatch's Rust code ran `gh pr create`
        -- using task.title and task.description for the title and body.
        -- That body was set at task-creation time and rarely matched
        -- the work actually shipped. Letting the agent author the PR
        -- after implementation produces materially better PRs.
        --
        -- There is no board entry point for any wrap-up action: the board's
        -- wrap-up key and the epic merge queue have both been removed.
        -- Wrap-up is agent-driven through the MCP wrap_up tool only.
        --
        -- wrap_up(action="pr") runs the verify command itself, before minting
        -- the token, and refuses on a dirty worktree or a failing command (see
        -- WrapUpRefusesUnfinishedWork in mcp-task-tools.allium). The response no
        -- longer asks the agent to verify.
        --
        -- The same response also carries an unconditional rate_learning nudge,
        -- specified in learnings.allium: WrapUpRateLearningNudge (not repeated
        -- here).
}

rule WrapUpDone {
    when: WrapUp(task, done)

    -- Available from any running or review task with a worktree.
    requires: task.status = review or task.status = running
    requires: task.worktree != null

    @guidance
        -- This rule deliberately has no ensures clause: wrap_up(action="done")
        -- performs no task write at all. The module writes a wrap_up request
        -- row already done, whose id is the exit token (store-split.allium:
        -- RequestWrapUp, W2, W3), and the tool returns prose, so there is
        -- nothing observable to assert about the task here — in particular no
        -- updated_at. The whole terminal write (status,
        -- sub_status, cleared tmux_window, updated_at) is ExitSession's. Do not
        -- re-add an updated_at assertion.
        --
        -- Closes a task without any git operations (no rebase, no push, no
        -- PR creation). Useful for tasks whose work requires no branch
        -- integration: research tasks, planning tasks, tasks that edit
        -- only the repo root (e.g., config files already on the base branch).
        --
        -- wrap_up(action="done") does not flip task.status to
        -- done. It leaves the task running (its session is still alive) and
        -- issues an exit token whose row records action = done, exactly like
        -- wrap_up(action="rebase"). The Done transition and the tmux_window
        -- teardown happen later, in the single ExitSession call. The agent
        -- runs the /retro skill before its commit step, ahead of wrap_up. This removes
        -- the old asymmetry where done flipped to Done immediately while
        -- rebase deferred to exit_session.
        --
        -- /wrap-up skill path: if task.wrap_up_mode = done (from get_task),
        -- or if the user selects "done" in Step 4, the skill calls
        -- wrap_up(action="done"), then exit_session(token,
        -- action="done") — no git commands.
        --
        -- wrap_up(action="done") is verified and commit-checked exactly like
        -- the other two actions (WrapUpRefusesUnfinishedWork in
        -- mcp-task-tools.allium).
}

rule ExitSession {
    when: SessionCloseAccepted(task, action, pr_url?, close)

    -- Since store-split M5 this rule runs IN THE MODULE, inside the
    -- request_exit_session reducer's transaction (store-split.allium:
    -- RequestExitSession, W4). That rule has already checked the exit token
    -- (a done wrap_up row of this task, its most recent, not yet consumed),
    -- the action, the live tmux_window and the pr_url, and written the
    -- exit_session row (close) that consumes the token and names the window
    -- for the host's teardown (ExitSessionTeardown below). Everything here
    -- lands in that same transaction, or nothing does.

    let was_running = task.status = running

    ensures:
        task.tmux_window = null
        if action = pr:
            task.status = review
            task.sub_status = core/SubStatus.default_for(review)
            task.url = core/TaskUrl{url: pr_url, url_type: pr}
        else:
            task.status = done
            task.sub_status = core/SubStatus.default_for(done)
            task.completed_at = now
        if was_running:
            task.stop_pending = false
        task.updated_at = now

    -- The epic status rollup for the closed task's epic chain, in the same
    -- transaction (it was close_session's follow-up step before M5).
    ensures:
        if task.epic != null:
            RecalculateEpicStatus(task.epic)

    -- A close whose action is rebase or done takes task.status to done, so a
    -- phoenix task closing through this rule respawns (tasks.allium:
    -- PhoenixRespawn), in the same transaction. The action = pr branch does
    -- NOT: it lands in review, and the respawn waits for the PR to merge
    -- (PrMerged above) or for a human to complete the task by hand.
    --
    -- Where the respawn sits relative to the chain below is deliberately NOT
    -- specified, because it cannot matter: AutoDispatchNextSubtask skips
    -- phoenix subtasks (PhoenixIsNeverChained), so whether the successor row
    -- exists yet when the chain runs its selection changes nothing it would
    -- pick. Any implementation ordering is correct, and none of them should be
    -- relied on.
    --
    -- SessionClosed drives the epic chain (AutoDispatchNextSubtask in
    -- epics.allium), which since M5 also runs in this transaction and records
    -- the subtask it requested on close.chained_task. It follows the terminal
    -- write, so the chain sees the closed task in its terminal state. The
    -- window teardown is NOT ordered against it: the host tears the window
    -- down only after this transaction commits, when its subscription
    -- delivers the exit_session row.
    ensures: SessionClosed(task: task, close: close)

    @guidance
        -- == What moved in M5 ==
        -- Before store-split M5 this close ran in the board: the MCP handler
        -- checked an in-memory exit token (McpState.exit_tokens), CONSUMED it,
        -- then applied the terminal patch through close_session, gated the
        -- tmux kill and SessionClosed on that patch persisting
        -- ("close_persisted"), and ran the epic chain at its own call site.
        -- Now the token is a request row, and the token check, the
        -- consumption, the terminal write, the epic rollup, the phoenix
        -- respawn and the chain are one module transaction
        -- (store-split.allium: RequestExitSession). The tmux teardown is the
        -- host's, from the exit_session row (ExitSessionTeardown).
        --
        -- == A close that does not take effect ==
        -- Because it is one transaction, a close either took effect whole or
        -- not at all. When the call is refused, or the store fails it:
        --   • the task keeps the status, sub_status, url AND tmux_window it
        --     had, and no exit_session row exists, so no host kills the
        --     window: it still hosts a live agent the human can attach to.
        --     Because tmux_window is still set, the task never satisfies
        --     is_detached, so it can never drift into the awaiting-merge
        --     rendering — neither from running nor from review;
        --   • nothing looks finished. A running task stays in Running and,
        --     receiving no further PreToolUse hooks, is classified stale by the
        --     normal tick path (ClassifyAgentActivity in agent-health.allium).
        --     A review task stays in Review with a live window. Either way the
        --     board still shows work outstanding;
        --   • SessionClosed is NOT emitted, so no epic chain fires — see
        --     AutoDispatchNextSubtask in epics.allium for why compounding a
        --     broken close into a fresh dispatch is worse than the broken close
        --     alone;
        --   • the exit token is NOT consumed (CHANGED in M5: before, the token
        --     was spent ahead of the write, so a failed write left the agent
        --     with no retry and the response told it to stop and hand back).
        --     The token stays valid, so the agent may call exit_session again;
        --   • because the window is left alive, WindowGone never fires, so
        --     DetectCrashedAgent (agent-health.allium) is never reached: a
        --     close that did not take effect is never reported as a crashed
        --     agent.
        -- A call that got NO ANSWER from the store may or may not have landed.
        -- The MCP tool settles it by looking for an exit_session row that
        -- consumed the token (mcp-task-tools.allium: ExitSessionViaMcp).
        -- The agent-facing reaction lives in the response and in the
        -- /wrap-up skill's exit_session-errors reference file; both must
        -- change with M5 from "stop, do not retry" to "the token is still
        -- valid, call exit_session again", and the skill's "has no active
        -- session counts as success" case is unchanged. The exit_session tool
        -- DESCRIPTION carries none of this: it says what the tool does and
        -- nothing about how to react to its responses
        -- (mcp-task-tools.allium: TheNextCallIsNamedJustInTime). A rewrite of
        -- either remaining surface must keep the reaction in it.
        -- Considered and REJECTED as a failed-close signal, before M5, and
        -- still not wanted: a dedicated close_failed sub_status (a new
        -- board-visible state carried through core.allium, persistence,
        -- rendering and every sub_status branch, disproportionate to a path
        -- that already leaves visible outstanding work); a separate
        -- failure-time notification (the retained status plus the live window
        -- already show the work is not done); widening DetectCrashedAgent to
        -- review (it would break the deliberate quiet detach of review tasks
        -- that legitimately lose their window); rejecting exit_session from
        -- review outright (the Stop hook can move a task to review through no
        -- fault of the agent, which would then be unable to close at all).
        --
        -- == The other close: update_tasks' done path ==
        -- There is no board-side close left. MarkTaskDoneViaMcp
        -- (mcp-task-tools.allium) — update_tasks' dedicated status="done"
        -- path — closed in the board until store-split M7, through
        -- close_session and kill_session_window via a `perform_close` helper
        -- that exit_session shared before M5. Since M7 it closes in the
        -- module too (store-split.allium: RequestCloseTask, X1): the same
        -- terminal fields as this rule's done branch, in one transaction,
        -- with no token and no chain, and a close row for the host's
        -- teardown when there is a window to kill or a PR to close
        -- (ExitSessionTeardown). close_session, perform_close and the
        -- close_persisted gate are gone. The gate's reason — a teardown must
        -- not be withheld from a task that IS closed because some unrelated
        -- follow-up step of a general update failed — still holds, and the
        -- module's single transaction satisfies it: the close row is written
        -- by the same write that closes the task, or neither lands. Keep the
        -- close a dedicated reducer; do not fold it into patch_task.
        --
        -- The chain does NOT apply there. This rule is the sole emitter of
        -- SessionClosed, so AutoDispatchNextSubtask (epics.allium) fires only
        -- for a close that came through exit_session — which means only for a
        -- close that had a wrap_up ahead of it, whatever action that wrap_up
        -- took (store-split.allium: EveryExitSessionHadAWrapUp).
        --
        -- Single-call session close. The old two-phase behaviour (first call
        -- returned a reflection prompt and set token.reflected, second call
        -- closed) is gone: the mandatory reflection is now the /retro skill,
        -- which the /wrap-up skill runs BEFORE exit_session is ever called.
        --
        -- The exit token is issued by all three wrap-up actions (rebase, done,
        -- pr): it is the id of a done wrap_up request row, and the row records
        -- which action issued it (store-split.allium: SessionRequest.action,
        -- W3). Validation and its error texts are RequestExitSession's (in
        -- the module) and ExitSessionViaMcp's (a missing token or action,
        -- refused in the tool before any call), in this order:
        --   • a missing token, no unconsumed done wrap_up row for the task
        --     (whatever the token names), or an already-consumed token →
        --     "no exit token — call wrap_up first";
        --     a token that names another row, one superseded by a newer
        --     wrap_up, or one voided by a later dispatch of the task (its row
        --     finished before the task's latest dispatched request did;
        --     store-split.allium, W3) → "invalid exit token".
        --   • the supplied action must equal the action recorded on the row.
        --     A missing action → "action is required". A mismatch (e.g. token
        --     issued for wrap_up(rebase) but the agent calls
        --     exit_session(action="pr")) is rejected with an error naming both
        --     actions — this stops an agent from doing one thing and closing as
        --     another.
        --   • task.tmux_window must be non-null. If it is already null, some
        --     other path (TUI, crash detection, a prior close) already tore the
        --     session down; the call reports "task #<id> has no active
        --     session" and the /wrap-up skill treats it as success, not a
        --     retryable failure. (On a normal double-close the token has also
        --     been consumed, so a retry hits the "call wrap_up first" branch
        --     above before ever reaching this check.)
        --   • pr_url is required iff action = pr; it is ignored for rebase and
        --     done.
        --
        -- Terminal mutation, applied atomically with clearing tmux_window and
        -- consuming the token:
        --   • rebase / done → task.status = done, task.completed_at = now from
        --                      the store clock (same completion stamp as
        --                      ConfirmDone, tasks.allium)
        --   • pr            → task.status = review, task.url = TaskUrl(pr_url,
        --                      url_type = pr) — this branch does not enter
        --                      done, so task.completed_at is untouched
        -- Both branches leave running, so both clear task.stop_pending in the
        -- same write (core/Task's PendingStopOnlyWhileRunning). What they do
        -- NOT clear is the task's core/SubagentEntry rows or its
        -- live_subagents count — so this, the most common way a dispatched
        -- task actually ends, is not one of the structural clear points
        -- enumerated in agent-health.allium's HookSubagentStop guidance.
        -- Harmless as it stands: only a running task's count is ever read
        -- (the drain path requires status = running), a stale count is card
        -- text nobody renders
        -- outside running, and the rows go on the next DispatchTask claim or
        -- with the task's delete cascade. Left as documentation rather than
        -- fixed: making the close a fifth clear point needs a decision about
        -- whether it drains (it assigns its own terminal status, so by the
        -- "the rule that owns the resulting status wins" split it should
        -- not), and nothing observable depends on it today.
        --
        -- Boards learn of the close through their subscriptions; there is no
        -- separate task/epic-changed notification to send.
        --
        -- Why this closes the PR-merge race (not merely narrows it): previously
        -- wrap_up("pr") set status = review with a pr-typed url immediately,
        -- which armed PollPrStatus (it filters on status = review and
        -- url.url_type = pr). From the very next tick a merge/close could fire
        -- PrMerged/PrClosed and null tmux_window while the agent was still
        -- working. Now a PR task never enters review with a pr-typed url until
        -- the exact same transaction that also nulls tmux_window, so
        -- PollPrStatus can never observe it mid-session — the review-visible
        -- state and the session-ended state become true in the same instant.
        -- (The window itself dies a moment later, at the host's teardown;
        -- tmux_window is already null by then.)
        --
        -- SessionClosed's only consumer is automatic epic chaining
        -- (AutoDispatchNextSubtask in epics.allium): if the closed task belongs
        -- to an epic with auto_dispatch = true, the epic's next backlog subtask
        -- is requested — so a subtask's successor always starts from a
        -- base_branch that already contains this task's work. A chain that
        -- stops, or fails, must never turn a successful close into an error;
        -- the module swallows every chain problem inside the transaction.
        -- There is deliberately no agent-facing tool for triggering it, and the
        -- /wrap-up skill carries no section telling the agent not to dispatch
        -- the next subtask itself — exit_session owns the chain, and its own
        -- description says so (mcp-task-tools.allium:
        -- TheNextCallIsNamedJustInTime).
}

rule ExitSessionTeardown {
    when: SessionRequestClaimed(request)

    -- The host work of a close (store-split.allium, W5): this host's claim of
    -- the exit_session row, or since M7 of update_tasks' done-path close row
    -- (store-split.allium: RequestCloseTask, X1), was accepted
    -- (HostClaimsSessionRequest). Both kinds are served alike.
    requires: request.kind in {exit_session, close}
    requires: request.host = core/local_host()
    -- D11's second line (store-split.allium, W11).
    requires: request.requested_by = core/local_host().owner

    -- The outcome of killing the window the row names, bounded by the row's
    -- deadline. A window that is already gone counts as torn down: that is
    -- the state the kill asks for. So does a close row that names no window
    -- (written only for its PR url): there is nothing to kill.
    let outcome = kill_window_outcome(request.tmux_window, request.deadline)

    ensures:
        if outcome.gone:
            SessionRequestDone(request: request, reporter: core/local_host())
        else:
            SessionRequestFailed(
                request: request,
                reporter: core/local_host(),
                reason: outcome.message,
                conflict: false
            )

    @guidance
        -- A FAILED TEARDOWN DOES NOT REVERT THE CLOSE (W5). The task is
        -- already Done or Review, its tmux_window already null; the failure
        -- is recorded on the row and logged at warn, as kill_session_window
        -- swallowed it before M5. An already-gone window logs at debug and is
        -- reported done.
        --
        -- The host enforces the row's deadline
        -- (store-split.allium: config.exit_session_teardown_timeout): a kill
        -- still running at it is abandoned and reported failed with reason
        -- "deadline passed". The module's backstop
        -- (store-split.allium: SessionRequestTimesOut) fails a row this host
        -- never reports; the close stands either way.
        --
        -- ClosePrOnDone's gh call (above) is also this host's, on this route:
        -- when the close took the task into Done (action rebase or done; a
        -- close row is always done) and the task carries a pr-typed url, the
        -- host serving this row runs `gh pr close <url>` best-effort,
        -- alongside the kill, reading the url from the task, exactly as
        -- close_session spawned it before M5. Its outcome is logged and does
        -- not affect the row's report. This owner was confirmed as a decision
        -- in M7 (store-split.allium, "ClosePrOnDone's owner"); a row that
        -- fails before it is served leaves the PR open, accepted as built
        -- and flagged for user review.
        --
        -- On an exit_session row the kill targets this agent's own window,
        -- so it ends the session that called exit_session. The MCP response
        -- does not wait for it (mcp-task-tools.allium: ExitSessionViaMcp). A
        -- close row's window belongs to some other task's agent, or to none:
        -- update_tasks never closes the caller's own task
        -- (mcp-task-tools.allium: MarkTaskDoneViaMcp), and does not wait
        -- for the teardown either.
}

rule KillWindowOfFailedExitSession {
    when: request: split/SessionRequest.state transitions_to failed

    requires: request.kind in {exit_session, close}
    requires: request.host = core/local_host()
    requires: request.requested_by = core/local_host().owner
    requires: request.tmux_window != null

    ensures: not exists request.tmux_window

    @guidance
        -- Best effort, nothing reported: the row is already finished. Covers
        -- an exit_session row, or since M7 a close row (store-split.allium:
        -- RequestCloseTask), this host sees fail before its teardown landed:
        -- the task's deletion (store-split.allium:
        -- DeletingATaskFailsItsOpenSessionRequest), this board's own restart
        -- sweep (HostRestartFailsInterruptedSessionRequests), the backstop
        -- while this board was hung, a later close of the same task that
        -- failed the row ("task closed"), or a teardown that itself failed
        -- (one more attempt). The close already cleared the window from the
        -- task, so nothing else would ever kill it. It kills the window only:
        -- ClosePrOnDone's gh call is not retried here, so such a row leaves
        -- the PR open (store-split.allium, "ClosePrOnDone's owner").
        --
        -- Only transitions this board SEES. A row the backstop failed while
        -- no board ran on this host is already failed in the starting board's
        -- first look at the rows, which is history, as in store-split.allium's
        -- D12; whether such a window should be killed too is an open question
        -- in store-split.allium, deferred past M7.
}

-- == Rebase Conflict ==

rule FinishTaskConflict {
    when: RebaseConflict(task)

    -- Fires when WrapUpRebase's rebase encounters a conflict.
    -- The rebase is aborted and the task is marked with conflict sub_status.
    -- The task may be in either running or review status at this point,
    -- so conflict is a valid sub_status for both parent statuses.
    -- Since store-split M5 this runs IN THE MODULE: the host reports the
    -- wrap_up row failed with conflict = true, and the module emits
    -- RebaseConflict in that report's transaction, only while the task is
    -- still running or review (store-split.allium:
    -- HostReportsSessionRequestFailed). The board writes no sub_status.

    ensures: task.sub_status = conflict
    ensures: UserInformed(about: rebase_conflict, task: task)

    @guidance
        -- Conflict has the highest column-section priority (0, above
        -- pr_closed and crashed). It renders as its own "conflict" section at
        -- the top of whichever column the task is in -- see core.allium,
        -- "Column Section Layout".
        -- Conflict is valid for both running and review tasks: both hit
        -- it during WrapUpRebase, which accepts either status.
        -- Staleness detection skips conflict tasks (they are not
        -- re-evaluated for inactivity).
        -- PR review polling's open-PR branch skips overwriting conflict
        -- sub_status — but its closed-PR branch (PrClosed, above) overrides
        -- it unconditionally: a closed PR is a stronger signal.
        -- Wrap-up rebase clears conflict optimistically before rebasing: the
        -- module does it when the host claims the request
        -- (store-split.allium: HostClaimsSessionRequest).
        --
        -- This rule fires only for a genuine textual rebase conflict
        -- (finish_task's RebaseConflict error, reported as conflict = true).
        -- A dirty primary worktree
        -- is a distinct failure mode (DirtyPrimaryWorktree) detected as a
        -- preflight check before any rebase is attempted — it is reported
        -- failed with conflict = false and reaches the caller as an error
        -- without touching sub_status, since
        -- there is nothing to mark "conflicted": the task's own work
        -- never entered a rebase, so it is safe to simply retry once the
        -- primary worktree is clean.
}
