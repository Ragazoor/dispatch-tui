-- allium: 3
-- grill-skill.allium
--
-- Scope: The /grill skill (plugin/skills/grill/SKILL.md): what an agent
--        running it guarantees to the user who asked to be grilled. It
--        interviews the user about a plan or design, then records what was
--        decided where the next agent will find it.
-- Includes: GrillSession (one per invocation) and its two phases — interview,
--           then capture; Decision and where it is recorded (an Allium spec,
--           an ADR, both or neither); the ADR admission test and its shape;
--           when the session ends.
-- Excludes: how the skill's copy reaches an agent (mcp-task-tools.allium:
--           SkillCopyIsJustInTime); what the allium:tend skill does to a spec
--           (the skill calls it, it does not own it); the content of any plan
--           or spec; the tools behind each step (reading files, asking the
--           user) — those are the skill's mechanics, not what it promises.
--
-- The Boolean judgements on Decision (touches_spec, is_obvious, hard_to_reverse
-- and the rest) come from the running agent's judgement, not from a mechanism.
--
-- Design decisions:
--   - The specs in docs/specs/ are the shared vocabulary. The interview
--     speaks in their terms and says when a decision contradicts or extends
--     one, so a conflict is settled in the conversation, before code.
--   - One question at a time, each with a recommended answer: the user
--     answers a concrete proposal, and a wrong recommendation is cheap to
--     reject.
--   - A question the codebase can answer is never asked.
--   - Domain decisions go into specs, and only what was decided: the spec is
--     the record of agreement, not of the discussion.
--   - An ADR is for the rare decision that is hard to reverse, surprising
--     without context and had real alternatives. Everything else is already
--     in a spec or in the code.

use "./core.allium" as core

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- Where a decision is recorded. A decision with no lasting domain content
-- (an implementation detail, an obvious choice) is `none`.
enum DecisionRecord { spec | adr | spec_and_adr | none }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- One run of the skill against one plan or design.
entity GrillSession {
    -- What the user asked to be grilled on: whatever they described.
    plan: String
    -- The decisions the plan needs, found by walking its design tree.
    decisions: Decision with session = this

    stage: interviewing | capturing | done

    transitions stage {
        interviewing -> capturing
        capturing -> done
        terminal: done
    }

    -- Not yet resolved: still to be asked, or asked and waiting for the answer.
    open_decisions: decisions where status in {open, asked}
    -- A question is out and the skill waits for its answer.
    awaiting_answer: (decisions where status = asked).count > 0
    -- Resolved, but not yet looked at for the decisions its answer opens.
    unexplored_decisions: decisions where status = resolved and not follow_ups_found
    -- Every decision the plan needs is resolved, and no answer opens a new
    -- one: a shared understanding.
    shared_understanding: stage = interviewing and open_decisions.count = 0
        and unexplored_decisions.count = 0
    unrecorded_decisions: decisions where status = resolved
    capture_complete: stage = capturing and unrecorded_decisions.count = 0
}

-- One question the plan has to answer.
entity Decision {
    session: GrillSession
    question: String
    -- What the interviewer proposes; given with every question.
    recommended_answer: String
    answer: String?
    -- A decision that must be resolved first. Decisions that depend on this
    -- one are not asked until it is resolved.
    depends_on: Decision?
    -- The codebase answered it; the user was not asked.
    answered_by_code: Boolean
    -- The answer contradicts or extends a spec; the user was told which.
    touches_spec: Boolean
    -- Hard to reverse, surprising without context, and had real
    -- alternatives. All three, or no ADR.
    hard_to_reverse: Boolean
    surprising_without_context: Boolean
    had_real_alternatives: Boolean
    -- The answer is a domain concept: an entity, enum, rule or canonical term.
    is_domain_concept: Boolean
    -- The answer only says how something is built.
    is_implementation_detail: Boolean
    -- An obvious choice: no ADR.
    is_obvious: Boolean
    -- The answer uses a term that is fuzzy or used two ways.
    fuzzy_term: Boolean
    -- The spec already captures it: no spec change and no ADR.
    already_in_a_spec: Boolean
    -- The skill has looked for the decisions this one's answer opens.
    follow_ups_found: Boolean
    record: DecisionRecord?

    status: open | asked | resolved | recorded

    transitions status {
        open -> asked
        open -> resolved
        asked -> resolved
        resolved -> recorded
        terminal: recorded
    }

    -- The interview may take it up: every decision it depends on is
    -- resolved, and no other question waits for its answer.
    ready: status = open and (depends_on = null or depends_on.status in {resolved, recorded})
        and not session.awaiting_answer
    needs_adr: hard_to_reverse and surprising_without_context and had_real_alternatives
        and not is_implementation_detail and not is_obvious and not already_in_a_spec
    -- A new or changed domain concept: one the spec already captures is not.
    needs_spec: is_domain_concept and not is_implementation_detail and not already_in_a_spec
    -- The session is capturing and this decision still has to be recorded.
    ready_to_record: session.stage = capturing and status = resolved
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    adr_directory: String = "docs/adr"
    -- NNNN-slug.md, the next free number.
    adr_file_pattern: String = "NNNN-slug.md"
    -- The sections an ADR has, in order.
    adr_sections: List<String> = ["Status", "Context", "Decision", "Consequences"]
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Interview ==

rule FindDecisions {
    when: session: GrillSession.created

    for need in plan_decisions(session):
        ensures: Decision.created(
            session: session,
            question: need.question,
            recommended_answer: need.recommended_answer,
            depends_on: need.depends_on,
            answered_by_code: need.answered_by_code,
            follow_ups_found: false,
            status: open
        )

    @guidance
        -- The skill walks the plan's design tree; each decision it finds is
        -- one Decision. Answers can open more (FindFollowUpDecisions).
}

rule FindFollowUpDecisions {
    when: decision: Decision.status transitions_to resolved

    requires: decision.session.stage = interviewing

    for need in follow_up_decisions(decision):
        ensures: Decision.created(
            session: decision.session,
            question: need.question,
            recommended_answer: need.recommended_answer,
            depends_on: decision,
            answered_by_code: need.answered_by_code,
            follow_ups_found: false,
            status: open
        )
    ensures: decision.follow_ups_found = true

    @guidance
        -- An answer can open a branch of the design tree the plan did not
        -- show. Each decision on it depends on the one whose answer opened
        -- it (DependenciesBeforeDependents), and the interview does not end
        -- while a resolved decision is still unexplored
        -- (TheInterviewEndsAtSharedUnderstanding).
}

rule StartGrill {
    when: GrillRequested(plan)

    ensures: GrillSession.created(plan: plan, stage: interviewing)
    ensures: GrillAnnounced()

    @guidance
        -- The skill opens with the sentence "I'm using the grill skill to
        -- interview you about this." (AnnouncesItself).
}

rule TakeUpTheNextDecision {
    when: decision: Decision.ready

    requires: decision.status = open
    requires: decision.session.stage = interviewing

    ensures:
        if decision.answered_by_code:
            decision.status = resolved
        else:
            QuestionAsked(
                decision: decision,
                recommended_answer: decision.recommended_answer
            )
            decision.status = asked

    @guidance
        -- When the codebase can answer, the skill reads it and does not ask
        -- (CodebaseAnswersBeforeTheUserIsAsked). Otherwise it asks one
        -- question, with the recommended answer, then waits for the user
        -- (OneQuestionAtATime, EveryQuestionCarriesARecommendation). A
        -- decision is taken up only after the one it depends on is resolved
        -- (DependenciesBeforeDependents).
}

rule ResolveDecision {
    when: UserAnswered(decision, answer)

    requires: decision.status = asked

    ensures: decision.answer = answer
    ensures: decision.status = resolved
}

rule NameTermsAndSpecConflicts {
    when: decision: Decision.status transitions_to resolved

    ensures:
        if decision.fuzzy_term:
            FuzzyTermNamed(decision: decision)
    ensures:
        if decision.touches_spec:
            SpecConflictNamed(decision: decision)

    @guidance
        -- Whether the user or the codebase resolved it. A fuzzy or doubly-used
        -- term is named, and a decision that contradicts or extends a spec is
        -- said to (SpecsAreTheVocabulary).
}

rule ProbeEdges {
    when: decision: Decision.status transitions_to resolved

    ensures: EdgesProbed(decision: decision, edges: {nulls, concurrent_agents, failure_path})
}

rule InterviewComplete {
    when: session: GrillSession.shared_understanding

    ensures: session.stage = capturing

    @guidance
        -- The interview ends when every decision the plan needs is resolved,
        -- not after a number of questions (TheInterviewEndsAtSharedUnderstanding).
}

-- == Capture ==

rule RecordInSpec {
    when: decision: Decision.ready_to_record

    requires: decision.status = resolved

    requires: decision.needs_spec
    requires: not decision.needs_adr

    ensures: SpecUpdated(decision: decision, through: "allium:tend")
    ensures: decision.record = spec
    ensures: decision.status = recorded

    @guidance
        -- New or changed domain concepts go into the relevant spec through
        -- the allium:tend skill, and only what was decided
        -- (DomainDecisionsGoThroughTend).
}

rule RecordAdr {
    when: decision: Decision.ready_to_record

    requires: decision.status = resolved

    requires: decision.needs_adr
    requires: not decision.needs_spec

    ensures: AdrWritten(
        decision: decision,
        directory: config.adr_directory,
        file_pattern: config.adr_file_pattern,
        sections: config.adr_sections
    )
    ensures: decision.record = adr
    ensures: decision.status = recorded

    @guidance
        -- NNNN-slug.md under the adr_directory, the next free number, the directory created
        -- if needed (AdrLocation). A few short paragraphs under Status,
        -- Context, Decision and Consequences (AdrShape). Written only when the
        -- decision passes the admission test (AdrOnlyWhenAllThree).
}

rule RecordInSpecAndAdr {
    when: decision: Decision.ready_to_record

    requires: decision.status = resolved

    requires: decision.needs_spec
    requires: decision.needs_adr

    ensures: SpecUpdated(decision: decision, through: "allium:tend")
    ensures: AdrWritten(
        decision: decision,
        directory: config.adr_directory,
        file_pattern: config.adr_file_pattern,
        sections: config.adr_sections
    )
    ensures: decision.record = spec_and_adr
    ensures: decision.status = recorded
}

rule RecordNothing {
    when: decision: Decision.ready_to_record

    requires: decision.status = resolved

    requires: not decision.needs_spec
    requires: not decision.needs_adr

    ensures: decision.record = none
    ensures: decision.status = recorded

    @guidance
        -- Nothing to write: no domain concept, and no ADR because the choice is
        -- obvious, an implementation detail or already in a spec
        -- (SkipWhatIsAlreadyRecorded).
}

rule FinishGrill {
    when: session: GrillSession.capture_complete

    ensures: session.stage = done
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- An ADR is written only for a decision that passed all three tests.
invariant AdrNeedsAllThree {
    for decision in Decisions:
        decision.record in {adr, spec_and_adr} implies decision.needs_adr
}

-- One question at a time: the skill waits for an answer before the next.
invariant AtMostOneQuestionAwaitsAnAnswer {
    for session in GrillSessions:
        (session.decisions where status = asked).count <= 1
}

-- A question is never asked when the codebase answers it.
invariant CodebaseDecisionsAreNotAsked {
    for decision in Decisions:
        decision.answered_by_code implies decision.status != asked
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface GrillInvocation {
    facing _: core/Operator

    provides:
        GrillRequested(plan)

    @guidance
        -- The user invokes the skill as /grill, or asks to be grilled:
        -- "grill me on this", "poke holes in this", "interrogate this
        -- design", "challenge my assumptions", "what am I missing". `plan` is
        -- whatever the user has described.
}

surface GrillSessionSurface {
    facing _: core/Operator

    context session: GrillSession

    exposes:
        session.open_decisions
        session.stage

    provides:
        UserAnswered(decision, answer) when decision.status = asked

    @guarantee AnnouncesItself
        -- The skill opens with "I'm using the grill skill to interview you
        -- about this."

    @guarantee OneQuestionAtATime
        -- One question at a time, and the skill waits for the answer before
        -- the next.

    @guarantee EveryQuestionCarriesARecommendation
        -- Each question comes with the skill's recommended answer.

    @guarantee CodebaseAnswersBeforeTheUserIsAsked
        -- If the codebase can answer a question, the skill reads it instead
        -- of asking.

    @guarantee DependenciesBeforeDependents
        -- The skill walks the design tree, resolving each decision before the
        -- ones that depend on it.

    @guarantee SpecsAreTheVocabulary
        -- docs/specs/*.allium is the shared vocabulary. The skill names a
        -- term that is fuzzy or used two ways, and says when a decision
        -- contradicts or extends a spec.

    @guarantee EdgesAreProbedAfterEachDecision
        -- After a decision the skill probes its edges: nulls, concurrent
        -- agents, the failure path.

    @guarantee TheInterviewEndsAtSharedUnderstanding
        -- The goal is a shared understanding of the plan with the decisions
        -- written down where the next agent will find them. The interview
        -- runs until the design tree is resolved, not for a fixed number of
        -- questions, and the capture follows it.

    @guarantee DomainDecisionsGoThroughTend
        -- A new or changed domain concept (entity, enum, rule, canonical
        -- term) goes into the relevant spec through the allium:tend skill.
        -- Only what was decided is recorded.

    @guarantee AdrOnlyWhenAllThree
        -- An ADR is written when a decision is hard to reverse, surprising
        -- without context, and had real alternatives. Not otherwise.

    @guarantee SkipWhatIsAlreadyRecorded
        -- No ADR for an obvious choice, for anything the spec already
        -- captures, or for an implementation detail.

    @guarantee AdrLocation
        -- An ADR is NNNN-slug.md in the adr_directory (docs/adr), with the next free number; the
        -- directory is created if it does not exist.

    @guarantee AdrShape
        -- An ADR is a few short paragraphs under Status, Context, Decision
        -- and Consequences.
}
