-- allium: 3
-- split-pane.allium
--
-- Scope: Split-pane lifecycle, focus border, jump-to-agent, pin task,
--        swap, and tmux detach interactions.
-- Excludes: Task lifecycle (see tasks.allium); dispatch (see dispatch.allium);
--           PR/wrap-up (see pr-workflow.allium).

use "./core.allium" as core

given {
    split_pane: core/SplitPane
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Detach Tmux ==

rule DetachTmux {
    when: ConfirmDetachTmux(task)

    requires: task.tmux_window != null

    ensures: task.tmux_window = null
    ensures:
        if task.sub_status in {stale, crashed}:
            task.sub_status = core/SubStatus.default_for(task.status)
    ensures:
        for entry in core/SubagentEntries where task = task:
            not exists entry
        task.live_subagents = 0
        for entry in core/ShellEntries where task = task:
            not exists entry
        task.live_shells = 0
        task.oldest_live_shell_started_at = null
        if task.live_subagents = 0 and task.live_shells = 0 and task.stop_pending and task.status = running:
            task.status = review
            task.sub_status = core/SubStatus.default_for(review)
            task.last_pre_tool_use_at = null
            task.last_notification_at = null
            task.stop_pending = false

    @guidance
        -- Kills the tmux window for a task while preserving the
        -- worktree. The agent is gone but the branch remains for
        -- PR review or later resume. Clears agent health tracking
        -- (captured tmux output, crash detection). Only Stale/Crashed
        -- sub_statuses are reset to the default for the task's
        -- current status; all other sub_statuses are preserved.
        -- Allowed for any task with a tmux window: Running tasks
        -- have their live agent terminated; Review tasks lose their
        -- post-completion session. Triggered via the TUI (T key,
        -- uppercase). Always shows a confirmation prompt
        -- ("Detach tmux panel? [y/n]") before detaching, whether the
        -- target is a single task or a batch of multi-selected tasks.
        -- Also clears every core/SubagentEntry for the task and resets
        -- live_subagents to 0, then runs the drain path (see
        -- agent-health.allium: HookSubagentStop) — detaching drops the
        -- agent along with any subagents it spawned, so a stop_pending
        -- task that had been waiting on them to finish resolves to
        -- Review right here rather than staying stuck in Running with no
        -- agent left to drain it.
        -- Clears every core/ShellEntry the same way, for the same reason:
        -- detaching drops the tmux window any backgrounded shell was
        -- running in, so there is nothing left to eventually report it
        -- stopped. This is one of ShellEntry's three real structural clear
        -- points (see agent-health.allium: HookSubagentStop's guidance) —
        -- without it, a task with a live shell and no subagents would flip
        -- to Review here checking only live_subagents = 0, reproducing the
        -- exact bug this design fixes via detach instead of via a bare Stop.
}

rule BatchDetachTmux {
    when: BatchDetachTmux(tasks)

    -- Filters to tasks that have a tmux window, then detaches all.
    let detachable = tasks where tmux_window != null

    requires: detachable.count > 0

    ensures:
        for task in detachable:
            DetachTmux(task)

    @guidance
        -- Triggered via the TUI (T key, uppercase) when tasks are
        -- multi-selected. Shows a confirmation prompt with the count
        -- of detachable tasks ("Detach N tmux panels? [y/n]"). Tasks
        -- that lack a tmux window are silently
        -- filtered out before the prompt.
}

-- == Toggle Split Mode ([s] key) ==
--
-- [s] is the only way in or out of split mode; every other rule in this file
-- presupposes that split mode already exists. Entry auto-pins the selected
-- task when it has a live agent window, so a single [s] on a running or
-- reviewable task both opens the pane and pins that agent — no separate
-- swap step is needed. Exit returns a pinned agent to a standalone tmux window:
-- the agent's session survives, only the split-pane UI goes away.

rule ToggleSplitMode {
    when: UserAction("s", task)

    ensures:
        if split_pane.active = true:
            ExitSplitMode()
        else if task.tmux_window != null:
            -- Auto-pin: the selected task's existing window is joined into
            -- the dispatch window as the right pane.
            split_pane.active = true
            split_pane.pane = task.tmux_window
            split_pane.pinned_task = task
            split_pane.focused = true
        else:
            -- No agent window to show: open a bare, unpinned shell pane.
            split_pane.active = true
            split_pane.pane = FreshShellPane()
            split_pane.pinned_task = null
            split_pane.focused = true

    @guidance
        -- Three-way branch on current state and the selection:
        --   1. Split active            -> exit (see ExitSplitMode).
        --   2. Inactive, selected task has a tmux window -> enter and pin it
        --      in one step via tmux join-pane.
        --   3. Inactive, no window (or no selection at all) -> enter with a
        --      fresh shell pane via tmux split-window.
        --
        -- Entry is best-effort: outside tmux it fails with a status hint
        -- ("Split mode requires tmux") and split mode stays inactive.
        -- focused resets to true on both entry and exit.
}

rule ExitSplitMode {
    when: ExitSplitMode()

    requires: split_pane.active = true
    requires: split_pane.pane != null

    let pinned = split_pane.pinned_task

    ensures: split_pane.active = false
    ensures: split_pane.pane = null
    ensures: split_pane.pinned_task = null
    ensures: split_pane.focused = true
    ensures:
        if pinned != null:
            -- The pinned agent is broken back out to a standalone tmux
            -- window under its original name. Its session is preserved.
            TaskWindowRestored(task: pinned, window: pinned.tmux_window)

    @guidance
        -- Exit destroys the split-pane UI, not the agent. With a task pinned,
        -- tmux break-pane returns the pane to a standalone window keyed by the
        -- task's tmux_window name, so the agent remains reachable via [Space].
        -- Only an unpinned (bare shell) pane is killed outright.
        --
        -- Emitted from two places: pressing [s] while split mode is active
        -- (ToggleSplitMode), and confirming quit — quitting dispatch with a
        -- task pinned restores that agent rather than ending its session.
}

-- == Split Pane Lifecycle ==
--
-- When a task lifecycle event clears or replaces a task's tmux window,
-- the split pane must be updated if that task is currently pinned.
-- The pane is never destroyed — its content is respawned as a fresh
-- shell so that split mode remains active without visual disruption.

rule SplitPaneRespawnOnWindowCleared {
    -- Fires whenever a lifecycle event clears a pinned task's tmux_window.
    -- The trigger is the clearing of task.tmux_window, not the specific
    -- event type. This covers all paths:
    --   - ExitSession (agent closes its session → Done)
    --   - PrMerged (PR merged on GitHub → Done)
    --   - ConfirmDone (manual move into Done from any non-Done status)
    --   - ArchiveTask (any status → Archived)
    --   - RetryResume (old window killed, new dispatch starts)
    --
    -- NOT triggered by WrapUpPr — the tmux window stays alive after PR
    -- creation so the agent can continue working (e.g., self-review).
    -- NOT triggered by failure paths (FinishTaskConflict, PrFailed) —
    -- the pane should keep showing the agent session for inspection.

    when: task: core/Task.tmux_window transitions_to null
    requires: split_pane.active = true
    requires: split_pane.pinned_task = task

    ensures: split_pane.pinned_task = null
    ensures: split_pane.active = true
    ensures: split_pane.pane = RespawnedPane(split_pane.pane)

    @guidance
        -- The pane content is replaced in-place using tmux respawn-pane,
        -- which kills the current process and starts a fresh shell without
        -- destroying the pane itself. This avoids the flicker that would
        -- occur from a kill-then-recreate sequence.
        --
        -- Handlers that also emit KillTmuxWindow for the old window name
        -- are harmless — the window no longer exists as a standalone window
        -- (it was absorbed into the pane via join-pane), so the kill is a
        -- no-op. The respawn handles the actual cleanup.
        --
        -- If the pane was already closed externally, the respawn
        -- degrades gracefully to SplitPaneClosed (full reset).
}

-- == Split Pane Focus Border ==
--
-- When split mode is active, the TUI renders a thin border around its
-- entire area. The border color indicates whether the TUI pane has focus:
-- cyan when focused, dim when the agent pane has focus.
-- Requires tmux `focus-events on` for crossterm to receive focus events.

rule SplitPaneFocusBorder {
    when: SplitPaneRendered()

    requires: split_pane.active = true

    ensures: SplitPaneBorderRendered(focused: split_pane.focused)

    @guidance
        -- The border is only rendered during split mode. Normal single-pane
        -- usage has no border. FocusChanged events update split_pane.focused
        -- only when split is active — otherwise they are ignored.
        -- border_color = CYAN when split_pane.focused = true
        -- border_color = BORDER when split_pane.focused = false
}

-- == Jump to Agent Window / Activate Task (Space key) ==
--
-- Pressing Space on a task is the single "work on this task" action: it
-- jumps tmux focus to that task's agent window when one exists, and
-- otherwise starts or resumes the agent. This unifies the former Space
-- jump key with the now-removed [d] dispatch/resume key, and — while split
-- mode is active — the swap action of the now-removed [S] key.
--
-- Priority order (first match wins):
--   1. Task pinned in the split pane   -> focus that pane.
--   2. Split active, task.tmux_window != null
--                                      -> swap the window into the pane
--                                         (SwapSplitPane), no focus transfer.
--   3. task.tmux_window != null        -> jump to the window.
--   4. No window, routed by status     -> dispatch / resume / retry / hint.
--
-- Split mode never suppresses the windowless branches: a Backlog card is
-- still dispatched by Space with the pane open, because there is no window
-- to swap in. Only the jump (3) is overridden, and only while split is
-- active.
--
-- The window checks (2, 3) precede the status check (4), so a Stale or
-- Crashed task that still has a window is jumped to or swapped in (a stale
-- agent is usually just idle) rather than opening the retry dialog. The
-- retry dialog is reached only for a windowless Stale/Crashed task (4).

rule JumpToAgentWindow {
    when: UserAction(" ", task)

    ensures:
        if split_pane.active = true and split_pane.pinned_task = task:
            -- Priority 1: the task is pinned; its window was joined into the
            -- dispatch window via join-pane, so focus the pane directly.
            tmux_focus = split_pane.pane
        else if split_pane.active = true and task.tmux_window != null:
            -- Priority 2: split mode replaces the jump with an in-place swap.
            -- Specified by SwapSplitPane below; tmux focus stays on the TUI.
            SplitPaneSwapRequested(task: task)
        else if task.tmux_window != null:
            -- Priority 3: jump to the standalone agent window.
            tmux_focus = task.tmux_window
        else if task.status = backlog:
            -- Priority 4, Backlog: start the agent. Repo-trust confirmation
            -- (ConfirmTrustRepo) is preserved as a pre-dispatch gate.
            DispatchTask(task)
        else if task.status in {running, review, done}:
            if task.sub_status in {stale, crashed}:
                -- Windowless Stale/Crashed: open the kill-and-retry dialog.
                ConfirmRetry(task)
            else if task.worktree != null:
                -- Worktree survives, no live window: reattach the agent.
                ResumeTask(task)
            else:
                UserInformed(about: no_worktree_to_resume, task: task)
        else:
            -- Archived.
            UserInformed(about: task_archived, task: task)

    @guidance
        -- Space is the unified activate action. The branches, in priority
        -- order:
        --
        --   1. Pinned in the split pane: the task's pane has been joined into
        --      the dispatch window via join-pane and the original standalone
        --      window no longer exists, so this calls tmux select-pane on
        --      split_pane.right_pane_id rather than select-window.
        --
        --   2. Split active and the task has a tmux window (and is not the
        --      pinned one): the window is swapped into the split pane in
        --      place, per SwapSplitPane. tmux focus is NOT transferred — the
        --      board keeps focus and the pane simply changes what it shows.
        --      This is the surface the retired [S] key used to provide.
        --
        --   3. Has a tmux window, split inactive: the normal jump calls tmux
        --      select-window on task.tmux_window. Branches 2 and 3 both cover
        --      Stale/Crashed tasks that still have a window — the window check
        --      wins over the problematic-status check, because a stale agent
        --      is usually just idle and looking at it is what the user wants.
        --
        --   4. No window, routed by status (reached with split active or
        --      inactive alike — there is nothing to swap in):
        --      * Backlog        -> DispatchTask (dispatch.allium). The
        --        repo-trust confirmation (ConfirmTrustRepo) is preserved: an
        --        untrusted repo first shows the trust prompt, which on accept
        --        proceeds to dispatch. The gate itself is specified in
        --        dispatch.allium (DispatchTask, "Repo-trust pre-gate"), and
        --        quick dispatch goes through the same gate via
        --        QuickDispatchTrustGate in tasks.allium.
        --        Tag-based routing (research ->
        --        DispatchResearchTask) lives in dispatch.allium, not here.
        --      * Running/Review/Done, Stale or Crashed -> open the
        --        kill-and-retry dialog (ConfirmRetry: [r] resume / [f] fresh
        --        start). This is the only path that still opens that dialog
        --        (RetryResume / RetryFresh in dispatch.allium).
        --      * Running/Review/Done with a worktree -> ResumeTask
        --        (dispatch.allium): reattach the agent in the existing
        --        worktree.
        --      * Running/Review/Done without a worktree -> a status hint
        --        ("No worktree to resume, move to Backlog and re-dispatch").
        --      * Archived -> a status hint ("Task is archived").
        --
        -- Space on an epic row (board view) is unchanged: it enters the epic
        -- view. Inside the epic, Space on each subtask follows the task rules
        -- above.
}

-- == Jump Back to TUI Window (Prefix+Space) ==
--
-- The complement of [Space]: while focus is on an agent's tmux window,
-- pressing the tmux prefix followed by Space jumps tmux focus back to the
-- dispatch TUI window.

rule JumpBackToTuiWindow {
    when: UserAction("prefix+space")

    ensures: tmux_focus = "TUI"

    @guidance
        -- Registered at TUI startup as a prefixed tmux keybinding (the tmux
        -- prefix must be pressed first, same as any other tmux binding):
        --   tmux bind-key space "select-window -t =TUI"
        -- The TUI window is renamed to the fixed "TUI" constant at startup so
        -- the binding can target it by name. Both the binding and the rename
        -- are torn down on exit (unbind-key space; rename restored).
        --
        -- The leading "=" anchors the target to an exact name match: tmux
        -- otherwise resolves a name target by prefix, so a window merely
        -- *starting* with "TUI" could absorb the jump (see the
        -- TmuxWindowTargetedExactly invariant in dispatch.allium). This is the
        -- one window target that cannot be resolved to a pane identity up
        -- front, because the binding is a command tmux runs later and any pane
        -- identity captured at registration time would be stale by then.
        --
        -- Implemented in src/runtime/mod.rs (setup_tmux_for_tui /
        -- teardown_tmux_for_tui) via tmux::bind_key / unbind_key.
        -- Best-effort: a failing tmux call does not prevent the TUI starting.
        --
        -- Surfaced in the in-TUI help popup ([?], General section) alongside
        -- the agent-tree toggle (see agent-tree.allium's
        -- BindAgentTreeToggle) so both tmux-global bindings are discoverable
        -- without leaving the board.
}

-- == Pin Task in Split Pane (Space, split mode) ==
--
-- Pressing Space on a task in split mode pins that task's tmux window into the
-- right pane without transferring tmux focus. The user stays on the TUI board.
-- There is no dedicated swap key: outside split mode the same Space press
-- jumps to the window instead (JumpToAgentWindow, priority 3), so the action
-- has no "split view not active" state of its own to report.

rule PinTaskInSplitPane {
    when: SplitPaneSwapRequested(task)
    requires: split_pane.active = true
    requires: task.tmux_window != null
    requires: split_pane.swap_in_flight = false
    -- The empty-pane case, and only that: with a task already pinned the
    -- request is SwapSplitPane's. The two rules share a trigger, so they must
    -- not also share a state — a request that matched both would have two
    -- rules starting one swap.
    requires: split_pane.pinned_task = null

    ensures: split_pane.swap_in_flight = true
    ensures: SplitPaneSwapStarted(new_task: task, old_task: null)
    ensures: split_pane.focused = unchanged  -- focus does NOT transfer

    @guidance
        -- When the selected task is already pinned, the action is a no-op: no
        -- rule fires. This one is excluded by pinned_task = null and
        -- SwapSplitPane by pinned_task != task.
        -- When a different task is pinned, the pane content is swapped in-place
        -- via tmux swap-pane. The old content is returned to a standalone window.
        --
        -- No tmux select-pane is called — the TUI pane retains focus throughout.
        --
        -- A task with no tmux window never reaches this rule: JumpToAgentWindow
        -- only raises SplitPaneSwapRequested for a task that has one, and routes
        -- the rest by status (dispatch / resume / retry) exactly as it does
        -- outside split mode.
        --
        -- == IMPLEMENTED: companion-pane draining ==
        -- The empty-pane case (no task currently pinned) reaches this via
        -- `exec_enter_split_mode_with_task` (src/runtime/split.rs), which
        -- calls `dispatch::join_task_window_into_pane`
        -- (src/dispatch/split_panes.rs), which moves only the agent's own
        -- (active) pane out of its window. Whatever dispatch itself put in
        -- that window (docs/specs/agent-tree.allium: the agent-tree companion
        -- pane, and any editor pane opened from it) is left behind in a window
        -- nothing owns — and a lone companion pane is indistinguishable, from
        -- live tmux state alone, from the companion being toggled hidden.
        -- `join_task_window_into_pane` therefore captures EVERY such pane
        -- *before* the join and kills each once the join succeeds, so the
        -- source window is fully drained either way, restoring the "the
        -- window no longer exists" assumption
        -- `SplitPaneRespawnOnWindowCleared`'s guidance relies on. The panes are
        -- found by the role marker dispatch wrote on each at creation (see
        -- agent-tree.allium's HideAgentTreePane), asked as one question — "which
        -- panes carry a role at all" — rather than one lookup per kind, so a
        -- future dispatch-created pane is drained without this path being
        -- taught about it. Both the check and the kill are best-effort: a
        -- failure is logged, never propagated, since these panes are
        -- decorative. `tmux::join_pane` itself stays a plain tmux wrapper with
        -- no companion-pane awareness — that orchestration lives above it, alongside
        -- the equivalent resync in SwapSplitPane's guidance below. Resolves
        -- agent-tree.allium's ToggleVsSplitPaneInteraction open question for
        -- the join half of the gap.
}

rule SwapSplitPane {
    when: SplitPaneSwapRequested(task)
    requires: split_pane.active = true
    requires: task.tmux_window != null
    requires: split_pane.pinned_task != task  -- no-op when already pinned
    requires: split_pane.swap_in_flight = false
    -- The occupied case, and only that: see PinTaskInSplitPane above for the
    -- empty one. Together with that rule's mirror guard, exactly one rule
    -- starts any given swap.
    requires: split_pane.pinned_task != null

    ensures: split_pane.swap_in_flight = true
    -- The currently pinned task's pane is returned to a standalone window,
    -- and the new task's window is joined into the split pane.
    ensures: SplitPaneSwapStarted(
        new_task: task,
        old_task: split_pane.pinned_task
    )

    @guidance
        -- This rule specifies the swap case for Space in split mode; the
        -- pin-empty case
        -- is covered by PinTaskInSplitPane. When the pane already holds
        -- a different task's window, the old window is swapped out via
        -- tmux swap-pane and returned to the standalone window list.
        -- tmux focus is NOT transferred — the TUI pane retains focus
        -- throughout the swap.
        --
        -- This rule STARTS the swap; it does not finish it. pinned_task and
        -- pane are assigned by SplitPaneSwapSettles, once the tmux
        -- rearrangement below has actually happened — so everything this rule
        -- reads still describes the outgoing occupant, which is the point.
        -- A further request arriving in between is held by
        -- DeferSwapWhileSwapInFlight rather than started against that state.
        --
        -- The rename below must not assign a name a live window already
        -- holds; see dispatch.allium's TmuxWindowNamesAreUnique for what a
        -- duplicate costs. A refused rename fails the swap, which settles as
        -- unsuccessful and leaves the pane showing what it showed before.
        --
        -- == IMPLEMENTED: companion-pane resync ==
        -- `exec_swap_split_pane` (src/runtime/split.rs) uses `swap-pane` to
        -- atomically exchange the previously-pinned task's pane and the new
        -- task's pane 0. `swap-pane` moves *pane objects* between windows —
        -- each pane keeps its own pane ID and running process, but which
        -- window it belongs to (and so which layout slot it occupies) is
        -- exactly what gets exchanged; it is the *window* that keeps its
        -- identity (its name, its position in the session), not the pane
        -- that started there. A pane ID resolved before the swap therefore
        -- names a pane in the *other* window afterwards — measured directly
        -- fixing this rule's own `@dispatch_dir` rewrite below, where
        -- targeting by the pre-swap pane ID silently wrote the option onto
        -- the wrong window and was only caught by the real-tmux test in
        -- tests/tmux_lifecycle.rs, never by the MockProcessRunner argv-shape
        -- tests (which do not model this semantic at all). `exec_swap_split_pane`
        -- then renames the window (formerly the new task's, now holding the
        -- old task's pane) to the old task's window name. Neither step
        -- touches the window's other panes: a
        -- renamed window's agent-tree companion pane (docs/specs/agent-tree.allium),
        -- if any, keeps running `dispatch agent-tree <new_task_id>` under a
        -- window now named (and considered to belong to) the old task —
        -- silently rendering the wrong agent's tree.
        --
        -- After a successful rename, `dispatch::resync_agent_tree_pane`
        -- (src/dispatch/agents.rs) parses the task id back out of the
        -- window's own new name (the same `task-<id>` inverse
        -- `toggle_agent_tree_pane` already uses) and, if the window carries
        -- a companion pane, kills it and relaunches
        -- `dispatch agent-tree <task_id>` for that correct task — and marks the
        -- relaunched pane with its role, since it is a new pane and an unmarked
        -- one would read as "no companion" to the next toggle. A no-op for
        -- a non-task window name or a window with no companion pane at all.
        -- Best-effort throughout: failures are logged, never propagated.
        --
        -- The `old_task = null` branch (no previously-pinned task) needs no
        -- equivalent fix: `tmux::kill_window` there destroys the whole
        -- window, companion pane included, so nothing is left to desync.
        -- Resolves agent-tree.allium's ToggleVsSplitPaneInteraction open
        -- question for the swap half of the gap.
        --
        -- == IMPLEMENTED: @dispatch_dir rewrite ==
        -- The rename above fixes which task the resync targets, but not where
        -- its companion starts: renaming a window never touches its window
        -- options, so `@dispatch_dir` (see AgentWindowSplitStartsInTaskWorktree
        -- below) still names the *incoming* task's worktree immediately after
        -- the rename. Left alone, `resync_agent_tree_pane`'s read of
        -- `@dispatch_dir` would race that staleness — sometimes observing it,
        -- sometimes not, depending on unrelated timing — rather than being
        -- reliably wrong or reliably right. `swap_task_window_into_pane`
        -- (src/dispatch/split_panes.rs) closes this by rewriting
        -- `@dispatch_dir` to the outgoing task's own worktree — via
        -- `tmux::set_window_dispatch_dir` — immediately after the rename and
        -- before calling `resync_agent_tree_pane`, so the read is never racing
        -- anything: the correct value is written, synchronously, on the same
        -- thread, before it is ever read back. Targeted by the window's *new
        -- name*, not by any pane ID resolved earlier in the swap — see the
        -- companion-pane-resync guidance above for why a pre-swap pane ID
        -- would name the wrong window here. The outgoing task's worktree
        -- path is threaded in from the TUI's own in-memory task list
        -- (`App::handle_swap_split_pane`, src/tui/update/split_pane.rs) rather
        -- than queried fresh — the same `find_task` lookup that already
        -- resolves the outgoing window's name resolves its worktree too, so no
        -- new database access is added to the dispatch/tmux layer. Best-effort
        -- like the resync itself: a failed rewrite is logged, never
        -- propagated, since the swap's pane exchange and rename have already
        -- succeeded by this point.
}

rule DeferSwapWhileSwapInFlight {
    when: SplitPaneSwapRequested(task)
    requires: split_pane.active = true
    requires: task.tmux_window != null
    requires: split_pane.swap_in_flight = true

    -- Held, not queued: the newest request replaces whatever was waiting.
    ensures: split_pane.pending_swap = task

    @guidance
        -- Why a swap cannot simply start. A swap is specified against
        -- split_pane.pinned_task and split_pane.pane — which task is leaving,
        -- and which pane it is leaving from — and neither takes its new value
        -- until the swap in flight has finished rearranging tmux (see
        -- SplitPaneSwapSettles below). A second swap started before then reads
        -- both as the PREVIOUS occupant and acts on them:
        --
        --   * It exchanges the wrong pane. The pane recorded as the split
        --     pane is, by then, the pane the earlier swap moved out to a
        --     standalone window, so the board's own pane is left untouched
        --     and two agents end up in each other's windows.
        --   * It renames a window to a name already in use. The outgoing
        --     task's window name is read from the stale pinned_task, so the
        --     rename repeats the name the earlier swap just assigned —
        --     leaving two windows sharing it, which is exactly what
        --     dispatch.allium's TmuxWindowNamesAreUnique forbids and what
        --     TmuxWindowTargetedExactly then refuses to resolve. Every later
        --     name-targeted operation on that task — its @dispatch_dir
        --     rewrite, its companion resync, its notifications, its kill —
        --     fails until a human closes one of the two windows. Observed in
        --     the field: two windows named task-4749, reported as a failed
        --     @dispatch_dir rewrite after a swap.
        --
        -- Why held rather than dropped. Pressing Space on one task and then
        -- another is ordinary browsing, and the second press is not a
        -- refinement of the first — it is the whole instruction, "show me
        -- this task". Dropping it would make a fast press do nothing, with
        -- nothing on screen to say why. Holding it costs one slot and makes
        -- the outcome the one the user asked for last.
        --
        -- Why only one is held. A third press supersedes the second for the
        -- same reason: replaying a chain of intermediate swaps would move
        -- panes the user never wanted to look at, and each would cost its own
        -- tmux round trip. Only the newest pending request survives.
        --
        -- The held request is not validated here beyond having a window. By
        -- the time it runs, the task may have become the pinned one (the swap
        -- in flight was for the same task) or lost its window — both are
        -- re-checked when it is replayed, not now.
}

rule SplitPaneSwapSettles {
    when: SplitPaneSwapSettled(new_task, pane, succeeded)

    requires: split_pane.swap_in_flight = true

    let pending = split_pane.pending_swap

    ensures: split_pane.swap_in_flight = false
    ensures:
        if succeeded = true:
            split_pane.pinned_task = new_task
            split_pane.pane = pane
    ensures: split_pane.pending_swap = null
    ensures:
        if pending != null:
            SplitPaneSwapRequested(task: pending)

    @guidance
        -- The settle point: the single moment at which the split pane starts
        -- describing the new occupant. Both halves of the swap's identity —
        -- pinned_task and pane — move together here, because a swap exchanges
        -- pane objects between windows and so changes which pane the board
        -- holds as well as which task it shows.
        --
        -- A failed swap settles too. succeeded = false leaves pinned_task and
        -- pane naming the previous occupant, which is the truth: a swap that
        -- could not rearrange tmux changed nothing about what the pane shows.
        -- The failure is reported to the user as a status error by whichever
        -- step failed. Settling on failure is load-bearing, not tidiness — a
        -- swap that failed and did not clear swap_in_flight would leave the
        -- board unable to swap again for the rest of the session.
        --
        -- A pending swap is replayed as an ordinary request, so it is gated by
        -- PinTaskInSplitPane / SwapSplitPane / DeferSwapWhileSwapInFlight
        -- exactly as a fresh press would be. That is what makes the "already
        -- pinned" and "window went away" cases fall out rather than needing
        -- handling here: the replayed request is refused by the same requires
        -- clauses that would refuse the press.
        --
        -- pending_swap is cleared whether or not it is replayed, so a request
        -- held during a swap is acted on exactly once.
}

-- Entering split mode is gated on split_pane.active, which is only set once the
-- pane has actually opened — so two fast [s] presses can each open a pane: the
-- same shape of race DeferSwapWhileSwapInFlight fixes for the swap path.
open question "Should split-mode entry share the swap's in-flight serialisation, or should a second [s] while entry is in flight mean exit again?"

-- == Splits Inside an Agent Window Start in the Task's Worktree ==
--
-- Distinct from the board's own split pane above: this is about any new pane
-- created *inside* an agent's tmux window — by the user pressing a tmux split
-- binding, or by dispatch itself opening the agent-tree companion pane (see
-- agent-tree.allium: SplitAgentTreePaneOnAgentLaunch).
--
-- Whoever caused the split, the new pane must start in that task's worktree.
-- Dispatch's own splits achieve this at creation; a split dispatch did not make
-- is corrected afterwards, and that correction reaches the newly created pane
-- and no other pane. Any other target is a correctness bug, not a cosmetic
-- imprecision: the board TUI and the agent's own Claude session both act on
-- what arrives at them.

rule AgentWindowSplitStartsInTaskWorktree {
    when: TmuxWindowSplit(window, new_pane)

    -- The window being split is a dispatched task's agent window.
    let task = core/Task{tmux_window: window}

    requires: exists task
    requires: task.worktree != null

    ensures: PaneWorkingDirectorySet(
        pane: new_pane,
        directory: task.worktree.path
    )

    @guidance
        -- Why any mechanism is needed. tmux does not give worktree-relative
        -- splits for free, and does not inherit the split pane's directory:
        -- measured on tmux 3.7b with the session, window and client directories
        -- all set to different values, a split-window invoked by an external CLI
        -- client — which is how dispatch, or any script, shells out to tmux —
        -- starts the new pane in the *invoking process's* cwd, while a split the
        -- user triggers from an attached client starts it in the *session's*
        -- cwd. Neither is the worktree. This was issue #231, fixed by commit
        -- 8bf36803.
        --
        -- Mechanism, in two tiers. Each agent window carries its worktree path
        -- in a per-window tmux user option, @dispatch_dir, set when the window
        -- is created. A rename alone never changes it — that is what SwapSplitPane's
        -- "== IMPLEMENTED: @dispatch_dir rewrite ==" guidance above rewrites it
        -- for, so this invariant keeps holding across a swap's rename too.
        --
        --   1. Splits dispatch makes itself (the agent-tree companion pane) pass
        --      `split-window -c <worktree>`, so those panes are correct by
        --      construction. No hook runs and nothing is delivered to them.
        --   2. Splits dispatch did not make — the user pressing a tmux split
        --      binding inside an agent window — are corrected by a single
        --      session-level after-split-window hook. It fires only when the
        --      window has @dispatch_dir *and* the new pane did not already start
        --      there (#{pane_start_path}, which tmux populates before the hook
        --      runs), and it corrects with `respawn-pane -k -c <worktree>`.
        --
        -- The correction is never delivered as keystrokes. An earlier mechanism
        -- typed `cd <worktree>` + Enter at the new pane, which is only correct if
        -- a shell happens to be reading it: the agent-tree companion pane exits
        -- on `q`, so any worktree path containing that letter closed the pane the
        -- moment it opened, and the other letters moved its cursor. Whatever
        -- occupies a pane is the pane's business, so the directory is set through
        -- tmux rather than through the pane's input.
        --
        -- The hook must still name its target explicitly (respawn-pane -t
        -- #{pane_id}): inside run-shell -bC the enclosing command's target
        -- context is lost and tmux falls back to the session's *active* pane,
        -- which during a background split is whatever the user is looking at —
        -- typically the board. That defect (#3781) once typed `cd <worktree>`
        -- into the kanban board, where `c` fired the Copy-Task binding and the
        -- remainder landed in the resulting text field. The lesson outlives the
        -- keystrokes: an untargeted respawn-pane would restart the wrong pane.
        --
        -- @dispatch_dir must be quoted where it is interpolated into the hook's
        -- innermost command. Unquoted, a worktree path containing a space
        -- silently resolves to $HOME instead. Measured, both ways.
        --
        -- Tier 1 does not make tier 2 removable, and vice versa: `-c` cannot
        -- reach a split the user makes, and the hook must stay inert for panes
        -- that are already correct so it never restarts a running companion
        -- pane. Any future refactor that drops either must replace its half of
        -- the guarantee by other means.
        --
        -- Accepted side effect. A user split that launched a command has that
        -- command restarted once, in the right directory, by respawn-pane -k.
        -- Bounded to the pane just created and to panes milliseconds old; this
        -- is knowingly accepted, not overlooked.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- SplitDirectoryTargetsNewPaneOnly: The worktree correction that follows a
-- split inside an agent window applies to the newly created pane and to no
-- other pane — never to the board TUI pane, and never to the agent's own
-- Claude pane. A mistargeted correction would restart a pane that is doing
-- work, not merely tidy a directory.

-- SplitDirectoryIsNeverKeystrokes: The worktree directory is never delivered to
-- a pane as synthesised input. Whatever occupies a pane may interpret arriving
-- characters as commands — the agent-tree companion pane exits on `q`, the
-- board TUI treats `c` as Copy-Task, and the agent's pane feeds them to Claude —
-- so no pane, including the newly created one, may be typed into to place it in
-- its worktree.

-- SplitPaneStability: When split mode is active, the pane must never be
-- destroyed and recreated in response to task lifecycle events. Pane content
-- is replaced in-place (respawn) to avoid visual flicker. The only operations
-- that tear down the pane are explicit user actions: toggling split mode off
-- (s key) or manually closing the pane. Even then it is the split-pane UI that
-- is torn down, not the agent: ExitSplitMode breaks a pinned task's pane back
-- out to a standalone tmux window and only kills the pane when nothing was
-- pinned. Lifecycle events (finish, PR creation) respawn the pane content and
-- clear pinned_task, but keep active=true and pane intact.
