-- allium: 3
-- split-pane.allium
--
-- Scope: Split-pane lifecycle, focus border, jump-to-agent, pin task,
--        swap, and tmux detach interactions.
-- Excludes: Task lifecycle (see tasks.allium); dispatch (see dispatch.allium);
--           PR/wrap-up (see pr-workflow.allium).

use "./core.allium" as core

given {
    split_pane: core/SplitPane
}

config {
    -- How long a quit waits for the split-pane restore it issued before
    -- giving up on it and letting the process go (see
    -- QuitAwaitsSplitPaneRestore below). Long enough for one tmux break-pane
    -- to complete on a machine under load, short enough that a tmux server
    -- that has stopped answering costs the user a pause rather than a hang.
    -- The wait is for a rearrangement already under way, never for a human
    -- decision -- RefuseExitSplitModeOntoLiveWindow below rules that out.
    quit_restore_timeout: Duration = 2.seconds
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Detach Tmux ==

rule DetachTmux {
    when: ConfirmDetachTmux(task)

    requires: task.tmux_window != null

    ensures: task.tmux_window = null
    ensures:
        if task.sub_status in {stale, crashed}:
            task.sub_status = core/SubStatus.default_for(task.status)
    ensures:
        for entry in core/SubagentEntries where task = task:
            not exists entry
        task.live_subagents = 0
        for entry in core/ShellEntries where task = task:
            not exists entry
        task.live_shells = 0
        task.oldest_live_shell_started_at = null
        if task.live_subagents = 0 and task.live_shells = 0 and task.stop_pending and task.status = running:
            task.status = review
            task.sub_status = core/SubStatus.default_for(review)
            task.last_pre_tool_use_at = null
            task.last_notification_at = null
            task.stop_pending = false

    @guidance
        -- Kills the tmux window for a task while preserving the
        -- worktree. The agent is gone but the branch remains for
        -- PR review or later resume. Clears agent health tracking
        -- (captured tmux output, crash detection). Only Stale/Crashed
        -- sub_statuses are reset to the default for the task's
        -- current status; all other sub_statuses are preserved.
        -- Allowed for any task with a tmux window: Running tasks
        -- have their live agent terminated; Review tasks lose their
        -- post-completion session. Triggered via the TUI (T key,
        -- uppercase). Always shows a confirmation prompt
        -- ("Detach tmux panel? [y/n]") before detaching, whether the
        -- target is a single task or a batch of multi-selected tasks.
        -- Also clears every core/SubagentEntry for the task and resets
        -- live_subagents to 0, then runs the drain path (see
        -- agent-health.allium: HookSubagentStop) — detaching drops the
        -- agent along with any subagents it spawned, so a stop_pending
        -- task that had been waiting on them to finish resolves to
        -- Review right here rather than staying stuck in Running with no
        -- agent left to drain it.
        -- Clears every core/ShellEntry the same way, for the same reason:
        -- detaching drops the tmux window any backgrounded shell was
        -- running in, so there is nothing left to eventually report it
        -- stopped. This is one of ShellEntry's three real structural clear
        -- points (see agent-health.allium: HookSubagentStop's guidance) —
        -- without it, a task with a live shell and no subagents would flip
        -- to Review here checking only live_subagents = 0, reproducing the
        -- exact bug this design fixes via detach instead of via a bare Stop.
}

rule BatchDetachTmux {
    when: BatchDetachTmux(tasks)

    -- Filters to tasks that have a tmux window, then detaches all.
    let detachable = tasks where tmux_window != null

    requires: detachable.count > 0

    ensures:
        for task in detachable:
            DetachTmux(task)

    @guidance
        -- Triggered via the TUI (T key, uppercase) when tasks are
        -- multi-selected. Shows a confirmation prompt with the count
        -- of detachable tasks ("Detach N tmux panels? [y/n]"). Tasks
        -- that lack a tmux window are silently
        -- filtered out before the prompt.
}

-- == Toggle Split Mode ([s] key) ==
--
-- [s] is the only way in or out of split mode; every other rule in this file
-- presupposes that split mode already exists. Entry auto-pins the selected
-- task when it has a live agent window, so a single [s] on a running or
-- reviewable task both opens the pane and pins that agent — no separate
-- swap step is needed. Exit returns a pinned agent to a standalone tmux window:
-- the agent's session survives, only the split-pane UI goes away.

rule ToggleSplitMode {
    when: UserAction("s", task)

    -- The settled case, and only that: a press arriving while a rearrangement
    -- of either kind is in flight is held by
    -- HoldToggleWhileRearrangementInFlight below. Together with that rule's
    -- mirror guard -- which fires when in_flight is set, where this one needs
    -- it null -- exactly one rule acts on any given press.
    requires: split_pane.in_flight = null

    ensures:
        if split_pane.active = true:
            ExitSplitMode()
        else if task.tmux_window != null:
            -- Auto-pin: the selected task's existing window is joined into
            -- the dispatch window as the right pane.
            split_pane.in_flight = EntryInFlight.created()
            SplitPaneEntryStarted(task: task)
        else:
            -- No agent window to show: open a bare, unpinned shell pane.
            split_pane.in_flight = EntryInFlight.created()
            SplitPaneEntryStarted(task: null)

    @guidance
        -- Three-way branch on current state and the selection:
        --   1. Split active            -> exit (see ExitSplitMode).
        --   2. Inactive, selected task has a tmux window -> enter and pin it
        --      in one step via tmux join-pane.
        --   3. Inactive, no window (or no selection at all) -> enter with a
        --      fresh shell pane via tmux split-window.
        --
        -- Branches 2 and 3 START entry; they do not finish it. active, pane
        -- and pinned_task are assigned by SplitPaneEntrySettles, once tmux has
        -- actually produced a pane — so everything this rule reads still
        -- describes the state before the entry, which is the point. A further
        -- press arriving in between is held by
        -- HoldToggleWhileRearrangementInFlight rather than acted on against
        -- that state.
        --
        -- Entry is best-effort: outside tmux it fails with a status hint
        -- ("Split mode requires tmux") and split mode stays inactive.
        -- focused resets to true on both entry and exit.
}

rule HoldToggleWhileRearrangementInFlight {
    when: UserAction("s", task)

    requires: split_pane.in_flight != null

    ensures: split_pane.in_flight.pending_toggle = true

    @guidance
        -- Why a second press cannot simply be acted on during an ENTRY. Entry
        -- is gated on split_pane.active, which does not become true until tmux
        -- has opened the pane and reported it back (see SplitPaneEntrySettles
        -- below). A press before then reads active as false and opens a SECOND
        -- pane: two panes exist, the board records only the one that settles
        -- last, and the other is left on screen with nothing tracking it —
        -- not reachable by [s], not returned to a standalone window on exit.
        -- With a task selected it is worse than a stray pane: the same agent
        -- window is joined twice.
        --
        -- Why it cannot be acted on during a SWAP either, which is less
        -- obvious: a swap runs while split mode is active, so a press arriving
        -- then looks like it would simply exit. It is not guaranteed to.
        -- SplitPaneClosedResets below clears active while deliberately leaving
        -- in_flight alone, so a pane close landing mid-swap leaves active
        -- false with the swap's tmux work still running. An ungated press there
        -- takes ToggleSplitMode's ENTRY branch and starts an entry beside a
        -- live swap. in_flight holds one rearrangement, so the entry would
        -- overwrite the swap: the swap's own report then settles the entry
        -- instead, the swap never settles, and anything held for it is
        -- performed against the wrong rearrangement. [s] does not wedge —
        -- in_flight is cleared by that settle — but the board records the
        -- wrong occupant, and a quit held for the swap exits before the rename
        -- it was waiting for. That is the concrete symptom, and it is
        -- reachable, not theoretical.
        --
        -- This rule is what MAKES the premise that an entry and a swap never
        -- overlap true; it is not merely consistent with it. Several things
        -- rest on that premise — HoldQuitWhileRearrangementInFlight below holds
        -- ONE quit for either rearrangement, SplitPaneSwapSettles and
        -- SplitPaneEntrySettles each replay whatever was held for them, and
        -- core.allium's Rearrangement keeps a single pending_toggle and a
        -- single pending_quit for whichever is in flight — indeed a single
        -- in_flight slot at all. None of that is sound if a
        -- press can start a second rearrangement beside a live one.
        -- ToggleSplitMode's branch on active cannot supply the premise by
        -- itself, for exactly the reason above: a close can clear active under
        -- a running swap. The guard here is what supplies it.
        --
        -- Why held rather than dropped. [s] is a toggle, and a toggle that
        -- drops a press is a toggle whose result depends on how fast the user
        -- typed, with nothing on screen to say a press was lost. Holding one
        -- makes a fast double-tap end where a slow one does: pane open, then
        -- pane closed.
        --
        -- Why a flag and not a count. A held press is replayed as the toggle
        -- it is, so an accumulated count would have to be replayed in order to
        -- mean anything, and the parity of a burst of presses is not an
        -- instruction anyone gives deliberately. One held toggle is the whole
        -- of what a burst during a single rearrangement means.
        --
        -- Rearrangements are gated this way; exit is not, and deliberately so.
        -- Exit keeps its pane until SplitPaneClosed confirms tmux really moved
        -- it (see RefuseExitSplitModeOntoLiveWindow), precisely so that a press
        -- arriving before then re-attempts an exit that may have been refused.
        -- The press this rule must hold during a rearrangement is, during an
        -- exit, the remedy — so holding it there would remove the only way out
        -- of a refusal. Re-issuing an exit that has already succeeded fails
        -- harmlessly and leaves the pane where it is.
}

rule ExitSplitMode {
    when: ExitSplitMode()

    requires: split_pane.active = true
    requires: split_pane.pane != null
    requires: split_pane.pinned_task = null
              or not has_window(name: split_pane.pinned_task.tmux_window.name)

    let pinned = split_pane.pinned_task

    ensures: split_pane.active = false
    ensures: split_pane.pane = null
    ensures: split_pane.pinned_task = null
    ensures: split_pane.focused = true
    ensures:
        if pinned != null:
            -- The pinned agent is broken back out to a standalone tmux
            -- window under its original name. Its session is preserved.
            TaskWindowRestored(task: pinned, window: pinned.tmux_window)

    @guidance
        -- Exit destroys the split-pane UI, not the agent. With a task pinned,
        -- tmux break-pane returns the pane to a standalone window keyed by the
        -- task's tmux_window name, so the agent remains reachable via [Space].
        -- Only an unpinned (bare shell) pane is killed outright.
        --
        -- Emitted from two places: pressing [s] while split mode is active
        -- (ToggleSplitMode), and confirming quit — quitting dispatch with a
        -- task pinned restores that agent rather than ending its session.
        --
        -- The break-out must not assign a name a live window already holds;
        -- RefuseExitSplitModeOntoLiveWindow below is that case.
}

rule SplitPaneExitStarted {
    when: ExitSplitMode()

    ensures: split_pane.restores_in_flight = split_pane.restores_in_flight + 1

    @guidance
        -- Deliberately unguarded, and therefore the one rule on this trigger
        -- that fires for BOTH outcomes below. The tmux work is issued before
        -- anyone knows which outcome it has: whether the pinned task's window
        -- name is free is a question only tmux can answer, and it answers it
        -- while the rearrangement is already under way. Attaching the count to
        -- ExitSplitMode alone would leave a refused exit uncounted, so a quit
        -- would see nothing outstanding and go while the attempt was still
        -- running -- the exact failure the count exists to prevent, on the one
        -- path least able to recover from it.
        --
        -- It counts unpinned exits too, where the pane is killed rather than
        -- broken out and nothing has to survive the board. Not a fork worth
        -- having: killing a pane is the same shape of tmux call, it settles
        -- just as fast, and a branch here would be a second place for the
        -- pinned/unpinned distinction to drift from ExitSplitMode's.
}

rule RefuseExitSplitModeOntoLiveWindow {
    when: ExitSplitMode()

    requires: split_pane.active = true
    requires: split_pane.pane != null
    requires: split_pane.pinned_task != null
    requires: has_window(name: split_pane.pinned_task.tmux_window.name)

    let pinned = split_pane.pinned_task
    let pane = split_pane.pane

    -- Nothing about the pane changes. Split mode stays active, the task stays
    -- pinned, and the pane keeps its contents. The tmux attempt still happened
    -- and is still counted by SplitPaneExitStarted above -- what is refused is
    -- the break, not the asking.
    ensures: split_pane.active = true
    ensures: split_pane.pinned_task = pinned
    ensures: split_pane.pane = pane

    @guidance
        -- Breaking the pane out would give tmux a second window under the
        -- pinned task's name, which is the duplicate dispatch.allium's
        -- TmuxWindowNamesAreUnique forbids and nothing in the system recovers
        -- from. So the break is refused.
        --
        -- Refused, not worked around. There is no reattach here — unlike
        -- ResumeTask, which finds a live window and simply adopts it, this
        -- path is holding a live pane that has to go SOMEWHERE, and the
        -- window it would go to is occupied. The two other options are both
        -- worse than staying put: killing the pane destroys a running agent's
        -- scrollback to resolve a bookkeeping conflict, and breaking it out
        -- under a different name leaves an agent in a window no task points
        -- at. Keeping the task pinned loses nothing and leaves the duplicate
        -- visible to the user, who is the only one who can decide which of
        -- the two windows should survive.
        --
        -- The refusal is reported on the board through the same error channel
        -- every other failing split-pane tmux operation uses — no signal of
        -- its own, exactly as a refused rename reports through the swap's own
        -- failure (see SwapSplitPane above).
        --
        -- Split mode staying active is not a wedged state: pressing [s] again
        -- re-attempts the exit, and it succeeds as soon as the conflicting
        -- window is gone.
        --
        -- That remedy reaches only one of ExitSplitMode's two emitters. On the
        -- [s] toggle the user is still at the board and can re-press it. On
        -- the quit path (ToggleSplitMode's other emitter — confirming quit
        -- exits split mode so the pinned agent is restored rather than ended)
        -- there is no next keypress: dispatch is going away, and a refusal
        -- there leaves the pinned agent's pane inside the board's own tmux
        -- window. That is the accepted outcome, not an oversight. The agent
        -- survives — the pane is neither killed nor renamed, and the window
        -- holding it outlives dispatch, so the user can break it out by hand
        -- once they have closed whichever of the two duplicates they don't
        -- want. Quitting is not allowed to block on resolving the conflict,
        -- and the alternatives available at that moment are the same two this
        -- rule already rejects for the toggle. That re-attempt is what `split_pane.pane = pane`
        -- above is load-bearing for — the board keeps the pane id until
        -- SplitPaneClosed confirms tmux really moved the pane, never on the
        -- optimistic assumption that issuing the exit was the same as
        -- completing it. Clearing it early leaves split mode active with no
        -- pane to act on, which no later keypress can recover from.
        --
        -- A tmux query that cannot answer counts as "no live window" and the
        -- exit proceeds — dispatch.allium's TmuxWindowNamesAreUnique states
        -- that default once for all four name-assigning operations.
}

rule SplitPaneExitSettles {
    when: SplitPaneExitSettled()

    requires: split_pane.restores_in_flight > 0

    ensures: split_pane.restores_in_flight = split_pane.restores_in_flight - 1

    @guidance
        -- The exit counterpart of SplitPaneEntrySettles below: the moment one
        -- of the tmux exits SplitPaneExitStarted counted stops being
        -- outstanding. Exactly one
        -- of these always arrives per exit, whatever the outcome — a completed
        -- break-out, a killed unpinned pane, or a refusal — for the same reason
        -- entry always settles: a path that reported an outcome without
        -- settling would leave a quit waiting on it until the deadline, every
        -- time.
        --
        -- It carries no outcome of its own because nothing here reads one. The
        -- successful break-out already reports SplitPaneClosed, and a failure
        -- already reports through the error channel every failing split-pane
        -- tmux operation uses. This says only "no longer in flight".
}

rule HoldQuitWhileRearrangementInFlight {
    when: ConfirmQuit()

    requires: split_pane.in_flight != null

    ensures: split_pane.in_flight.pending_quit = true

    @guidance
        -- Quitting with a task pinned restores that agent to a standalone
        -- window rather than ending its session (see ExitSplitMode above).
        -- During an entry there is nothing yet to restore from: the agent's
        -- window is being joined into the board's own window as this runs, and
        -- exit is gated on split_pane.active, which is still false. A quit
        -- acted on here therefore issues no exit at all, and dispatch goes away
        -- leaving the agent's pane inside the window the board was using — the
        -- agent survives, but it is no longer the standalone window its task
        -- records, and only a human can put it back.
        --
        -- During a swap the hazard is different but no smaller. pinned_task and
        -- pane still name the PREVIOUS occupant (see SwapSplitPane below), and
        -- the rearrangement is mid-flight in tmux: the panes are exchanged,
        -- then the outgoing task's window is renamed back to its own name, then
        -- @dispatch_dir is rewritten and the companion pane resynced. A quit
        -- acted on here tears the process down between the exchange and the
        -- rename, leaving the outgoing task's window carrying the INCOMING
        -- task's name — two windows sharing a name, which dispatch.allium's
        -- TmuxWindowNamesAreUnique forbids and which nothing recovers from.
        --
        -- One held quit covers both because the two cannot overlap — and they
        -- cannot overlap because HoldToggleWhileRearrangementInFlight above
        -- holds any [s] press arriving while in_flight is set, so no press
        -- can start a second rearrangement beside a live one. The branch on
        -- active does not establish that by itself: SplitPaneClosedResets below
        -- clears active while leaving a swap in flight, so without that hold an
        -- entry could begin beside a running swap. Whichever rearrangement is
        -- in flight is the one whose settle performs the quit.
        --
        -- The board-layer hold is the mechanism here, not the shutdown-wait
        -- QuitAwaitsSplitPaneRestore uses. Neither rearrangement is issued BY
        -- the quit, so its own settle is still coming and the event loop is
        -- still there to act on it. The exit path needs the second mechanism
        -- only because the quit issues the exit itself and has no loop left to
        -- hold it.
        --
        -- So the quit is held exactly as a toggle is, and the rearrangement's
        -- settle performs it. This is not the same as blocking a quit on a human
        -- decision, which RefuseExitSplitModeOntoLiveWindow's guidance above
        -- rules out: the wait here is for a tmux rearrangement already under way and
        -- already guaranteed to report back, and it ends whether that
        -- rearrangement succeeded or failed. That is true of both halves —
        -- an entry always settles (SplitPaneEntrySettles) and a swap always
        -- settles (SplitPaneSwapSettles), whatever the outcome.
}

rule QuitExitsSplitMode {
    when: ConfirmQuit()

    -- The settled case, and only that: a quit arriving while a rearrangement
    -- of either kind is in flight is held by
    -- HoldQuitWhileRearrangementInFlight above. Together with that rule's
    -- mirror guard — which fires when in_flight is set, where this one needs
    -- it null — exactly one rule acts on any given confirmed quit.
    requires: split_pane.in_flight = null

    ensures:
        if split_pane.active = true:
            ExitSplitMode()
    ensures: ApplicationQuits()

    @guidance
        -- The exit is what keeps a pinned agent alive past the board: without
        -- it the agent's pane goes away with the window dispatch was using.
        -- So it is issued first and the quit follows it, which is the same
        -- order SplitPaneEntrySettles replays a held quit in.
        --
        -- ApplicationQuits is emitted whether or not there was anything to
        -- exit. Quitting is not conditional on split mode; it is the split-pane
        -- tidying that is conditional on quitting.
}

-- == What ApplicationQuits Obliges ==
--
-- Issuing the restore and completing it are two different moments (see
-- ExitSplitMode above). The user asked for one thing — leave the board, keep
-- the agent — and that is only true once tmux has actually moved the pane. So
-- the quit does not take the process away while its own restore is still
-- running. The wait is bounded, because a tmux that has stopped answering must
-- cost the user a pause and not their session.

rule QuitCompletesWithNothingToRestore {
    when: ApplicationQuits()

    requires: split_pane.restores_in_flight = 0

    ensures: ApplicationExits()

    @guidance
        -- The ordinary case, and much the commonest: no exit was issued at all,
        -- because split mode was not open. Nothing is outstanding, so nothing
        -- is waited for.
}

rule QuitAwaitsSplitPaneRestore {
    when: ApplicationQuits()

    requires: split_pane.restores_in_flight > 0

    ensures: split_pane.quit_restore_deadline = now + config.quit_restore_timeout

    @guidance
        -- The process does not go away here. This rule starts a wait; the two
        -- rules below are the only ways out of it.
        --
        -- Why a wait at all, when the exit has already been issued. Issuing is
        -- not completing. The restore is a live tmux rearrangement running
        -- alongside the board, and tearing the application down beside it
        -- leaves the outcome to whatever the host runtime happens to do with
        -- work it has been handed but has not started — which is not a
        -- property of this system, is not written down anywhere, and is not
        -- the same on every machine. The failure it permits is the exact one
        -- the restore exists to prevent: dispatch gone, and the agent's pane
        -- still inside the window the board was using, reachable only by hand.
        --
        -- Why this is not the blocking RefuseExitSplitModeOntoLiveWindow rules
        -- out. That rule forbids making a quit wait on a HUMAN resolving a
        -- name conflict, which has no deadline and may never come. This waits
        -- on a tmux call already under way, which reports back either way, and
        -- it gives up on its own after config.quit_restore_timeout. It is the
        -- same distinction HoldQuitWhileRearrangementInFlight above already
        -- draws for the entry and swap sides.
        --
        -- It is deliberately the LAST thing the quit waits on. Everything else
        -- shutdown does to tmux — putting the board's window name back, tearing
        -- the keybinding down — is the board tidying up after itself, and none
        -- of it may interleave with a rearrangement that is moving a live
        -- agent's pane between windows.
}

rule QuitCompletesWhenRestoreSettles {
    when: SplitPaneExitSettled()

    requires: split_pane.quit_restore_deadline != null
    -- The last one, not merely one of them. The settle that triggered this rule
    -- has already been counted off by SplitPaneExitSettles above.
    requires: split_pane.restores_in_flight = 0

    ensures: split_pane.quit_restore_deadline = null
    ensures: ApplicationExits()

    @guidance
        -- The restore reported back, and the process may go. Settled covers
        -- both outcomes, not just the successful one: a break-out refused
        -- because the name is taken (RefuseExitSplitModeOntoLiveWindow) has
        -- finished being attempted, and there is nothing further to wait for.
        -- Waiting out the full deadline on a refusal would spend the whole
        -- budget on a question already answered.
        --
        -- A refusal is written to the log even so. On this path the board's
        -- error channel has no reader left -- the user is leaving, and the
        -- message would be drawn to a surface already on its way out -- so the
        -- outcome would otherwise vanish. It is the same end state
        -- QuitCompletesOnRestoreTimeout below is required to record: the agent
        -- alive, its pane still inside the window the board was using. Both get
        -- recorded the same way, or the quieter one is the one nobody can
        -- diagnose.
        --
        -- One deadline covers every outstanding restore, not one deadline each.
        -- It is a bound on the quit, and a per-restore budget would multiply by
        -- however many exits happened to overlap.
}

rule QuitCompletesOnRestoreTimeout {
    when: split_pane.quit_restore_deadline <= now

    -- Explicit, though the trigger cannot match a null deadline anyway: this is
    -- what stops the rule re-firing once it has fired.
    requires: split_pane.quit_restore_deadline != null

    ensures: split_pane.quit_restore_deadline = null
    ensures: ApplicationExits()

    @guidance
        -- The bound. A restore that has not reported back by its deadline is
        -- abandoned and the process goes anyway: the user asked to leave, and
        -- a quit that can hang is worse than a pane left in the wrong window.
        --
        -- Recorded, not shown. By this point the board's rendering surface is
        -- on its way out and has nowhere to put a message the user would have
        -- time to read, so the abandonment goes to the log instead. This
        -- matches the accepted outcome RefuseExitSplitModeOntoLiveWindow
        -- already describes for the quit path: the agent survives either way —
        -- the pane is neither killed nor renamed — and a human can break it
        -- out afterwards.
}

rule SplitPaneClosedResets {
    when: SplitPaneClosed()

    ensures: split_pane.active = false
    ensures: split_pane.pane = null
    ensures: split_pane.pinned_task = null
    ensures: split_pane.focused = true

    -- A rearrangement in flight is not about the pane that just closed, and
    -- neither is anything held for its settle. The one exception is a held
    -- SWAP, which names an occupant rather than work in flight.
    ensures: split_pane.in_flight = unchanged
    ensures: split_pane.in_flight.pending_toggle = unchanged
    ensures: split_pane.in_flight.pending_quit = unchanged
    ensures:
        if split_pane.in_flight.kind = SwapInFlight:
            split_pane.in_flight.pending_swap = null

    -- Nor is an exit's tmux work, which is cleared by its own settle and by
    -- nothing else. A close is the successful half of that work reporting, not
    -- the whole of it: the refused half reports no close at all, and a quit
    -- waiting here must be released by both.
    ensures: split_pane.restores_in_flight = unchanged

    @guidance
        -- The confirmation that a pane really is gone: the completion of an
        -- exit, and the answer a liveness poll gives for a pane that has
        -- disappeared. Everything describing an occupant resets, because there
        -- is no longer an occupant to describe.
        --
        -- Everything describing an entry does not, because a close can arrive
        -- about a pane that is already history. A liveness poll issued while
        -- the previous pane was open can land after the user has closed it and
        -- pressed [s] again, by which time an entry is in flight. Resetting
        -- that entry would leave it settling with nothing watching: its pane
        -- would be recorded but the press or the quit held for its settle would
        -- be gone, and a dropped quit is one the user has no way to notice,
        -- having already asked the application to close.
        --
        -- Nothing in flight is cancelled here either, and a SwapInFlight is no
        -- exception — it used to be cleared here, which contradicted this very
        -- sentence. A close says a pane went away; it does not say the tmux
        -- work already under way will not report back, and that report is what
        -- ends the rearrangement. A swap has exactly two terminators, and a
        -- close is neither of them: the successful pane report and the failed
        -- one, both arriving as SplitPaneSwapSettled. Clearing it early costs
        -- more than an inaccurate flag: SplitPaneSwapSettles is gated on a
        -- SwapInFlight being in flight, so the settle would no longer fire and
        -- a quit held for that swap would be dropped silently — the same
        -- argument already made above for leaving an EntryInFlight alone.
        --
        -- Clearing active while a swap runs on is a state no press may be
        -- acted on against: an [s] press there would read active as false and
        -- start an entry beside the live swap. That is what
        -- HoldToggleWhileRearrangementInFlight's guard on in_flight exists
        -- for, and why the premise that the two never overlap is enforced there
        -- rather than assumed from active.
        --
        -- pending_swap still resets, because it is not work in flight: it names
        -- an occupant the user asked to see, and there is no occupant. It is
        -- the only part of the rearrangement a close touches, which is why it
        -- sits on the SwapInFlight variant rather than beside the two holds.
}

-- == Split Pane Lifecycle ==
--
-- When a task lifecycle event clears or replaces a task's tmux window,
-- the split pane must be updated if that task is currently pinned.
-- The pane is never destroyed — its content is respawned as a fresh
-- shell so that split mode remains active without visual disruption.

rule SplitPaneRespawnOnWindowCleared {
    -- Fires whenever a lifecycle event clears a pinned task's tmux_window.
    -- The trigger is the clearing of task.tmux_window, not the specific
    -- event type. This covers all paths:
    --   - ExitSession (agent closes its session → Done)
    --   - PrMerged (PR merged on GitHub → Done)
    --   - ConfirmDone (manual move into Done from any non-Done status)
    --   - ArchiveTask (any status → Archived)
    --   - RetryResume (old window killed, new dispatch starts)
    --
    -- NOT triggered by WrapUpPr — the tmux window stays alive after PR
    -- creation so the agent can continue working (e.g., self-review).
    -- NOT triggered by failure paths (FinishTaskConflict, PrFailed) —
    -- the pane should keep showing the agent session for inspection.

    when: task: core/Task.tmux_window transitions_to null
    requires: split_pane.active = true
    requires: split_pane.pinned_task = task

    ensures: split_pane.pinned_task = null
    ensures: split_pane.active = true
    ensures: split_pane.pane = RespawnedPane(split_pane.pane)

    @guidance
        -- The pane content is replaced in-place using tmux respawn-pane,
        -- which kills the current process and starts a fresh shell without
        -- destroying the pane itself. This avoids the flicker that would
        -- occur from a kill-then-recreate sequence.
        --
        -- Handlers that also emit KillTmuxWindow for the old window name
        -- are harmless — the window no longer exists as a standalone window
        -- (it was absorbed into the pane via join-pane), so the kill is a
        -- no-op. The respawn handles the actual cleanup.
        --
        -- If the pane was already closed externally, the respawn
        -- degrades gracefully to SplitPaneClosed (full reset).
}

-- == Split Pane Focus Border ==
--
-- When split mode is active, the TUI renders a thin border around its
-- entire area. The border color indicates whether the TUI pane has focus:
-- cyan when focused, dim when the agent pane has focus.
-- Requires tmux `focus-events on` for crossterm to receive focus events.

rule SplitPaneFocusBorder {
    when: SplitPaneRendered()

    requires: split_pane.active = true

    ensures: SplitPaneBorderRendered(focused: split_pane.focused)

    @guidance
        -- The border is only rendered during split mode. Normal single-pane
        -- usage has no border. FocusChanged events update split_pane.focused
        -- only when split is active — otherwise they are ignored.
        -- border_color = CYAN when split_pane.focused = true
        -- border_color = BORDER when split_pane.focused = false
}

-- == Jump to Agent Window / Activate Task (Space key) ==
--
-- Pressing Space on a task is the single "work on this task" action: it
-- jumps tmux focus to that task's agent window when one exists, and
-- otherwise starts or resumes the agent. This unifies the former Space
-- jump key with the now-removed [d] dispatch/resume key, and — while split
-- mode is active — the swap action of the now-removed [S] key.
--
-- Priority order (first match wins):
--   1. Task pinned in the split pane   -> focus that pane.
--   2. Split active, task.tmux_window != null
--                                      -> swap the window into the pane
--                                         (SwapSplitPane), no focus transfer.
--   3. task.tmux_window != null        -> jump to the window.
--   4. No window, routed by status     -> dispatch / resume / retry / hint.
--
-- Split mode never suppresses the windowless branches: a Backlog card is
-- still dispatched by Space with the pane open, because there is no window
-- to swap in. Only the jump (3) is overridden, and only while split is
-- active.
--
-- The window checks (2, 3) precede the status check (4), so a Stale or
-- Crashed task that still has a window is jumped to or swapped in (a stale
-- agent is usually just idle) rather than opening the retry dialog. The
-- retry dialog is reached only for a windowless Stale/Crashed task (4).

rule JumpToAgentWindow {
    when: UserAction(" ", task)

    ensures:
        if not task.is_locally_owned:
            -- Priority 0: another machine holds this task's worktree, so
            -- nothing below is valid here. See the guidance.
            UserInformed(about: owned_by_other_host, task: task)
        else if split_pane.active = true and split_pane.pinned_task = task:
            -- Priority 1: the task is pinned; its window was joined into the
            -- dispatch window via join-pane, so focus the pane directly.
            tmux_focus = split_pane.pane
        else if split_pane.active = true and task.tmux_window != null:
            -- Priority 2: split mode replaces the jump with an in-place swap.
            -- Specified by SwapSplitPane below; tmux focus stays on the TUI.
            SplitPaneSwapRequested(task: task)
        else if task.tmux_window != null:
            -- Priority 3: jump to the standalone agent window.
            tmux_focus = task.tmux_window
        else if task.status = backlog:
            -- Priority 4, Backlog: start the agent. Repo-trust confirmation
            -- (ConfirmTrustRepo) is preserved as a pre-dispatch gate.
            DispatchTask(task)
        else if task.status in {running, review, done}:
            if task.sub_status in {stale, crashed}:
                -- Windowless Stale/Crashed: open the kill-and-retry dialog.
                ConfirmRetry(task)
            else if task.worktree != null:
                -- Worktree survives, no live window: reattach the agent.
                ResumeTask(task)
            else:
                UserInformed(about: no_worktree_to_resume, task: task)
        else:
            -- Archived.
            UserInformed(about: task_archived, task: task)

    @guidance
        -- PRIORITY 0 IS FIRST ON PURPOSE, and it is the one branch whose
        -- position carries an argument.
        --
        -- The tempting placement is next to the resume branch, beside
        -- no_worktree_to_resume, since Task.is_locally_owned is about who
        -- holds the worktree. That would be wrong, because priority 3 does not
        -- read the worktree at all -- it reads task.tmux_window and focuses
        -- it. tmux_window is a persisted field on a shared row, so a task
        -- another machine dispatched arrives here with it SET, naming a window
        -- that is alive on the owner's machine and absent from this one.
        -- Placed later, priority 3 would fire first and try to focus a window
        -- this tmux server has never heard of.
        --
        -- So the check is not "can this task be resumed here"; it is "is any
        -- branch of this rule meaningful here", and the answer for a task
        -- another machine owns is no. Every branch below either focuses a
        -- local tmux target or acts on a local directory, and none of those
        -- exist on this machine.
        --
        -- What the operator sees: a message naming the owning host's LABEL,
        -- not its id (core/Host keeps the two apart precisely so the readable
        -- one can be shown). Nothing else happens -- no write, no teardown, no
        -- launch -- which is the same shape as no_worktree_to_resume and
        -- task_archived below. The key does not silently do nothing, because
        -- silence here is indistinguishable from a dropped keypress, and the
        -- one fact the operator needs is which machine to go to.
        --
        -- FOUNDATIONS-ONLY CAVEAT: naming the label requires resolving a
        -- FOREIGN host id to that host's label, which needs a registry of
        -- every host's (id, label) pair -- not just this install's own row,
        -- which is all core/Host models today (see core.allium's Host entity
        -- and host.allium's scope note). That registry is explicitly
        -- out-of-scope work for the host-identity/tasks.host/locality-gating
        -- foundations this branch is, so the implementation shows a generic
        -- "another machine" message instead of a label until it lands. This
        -- branch is unreachable on a single-machine install either way, so
        -- the gap has no observable effect yet -- revisit the message the
        -- moment a shared host registry exists.
        --
        -- No card indicator is specified. Marking owned-elsewhere cards on the
        -- board is a board-visuals concern and there are no remote hosts to
        -- mark yet; on a single-machine install this branch is unreachable.
        --
        -- Space is the unified activate action. The branches, in priority
        -- order:
        --
        --   1. Pinned in the split pane: the task's pane has been joined into
        --      the dispatch window via join-pane and the original standalone
        --      window no longer exists, so this calls tmux select-pane on
        --      split_pane.right_pane_id rather than select-window.
        --
        --   2. Split active and the task has a tmux window (and is not the
        --      pinned one): the window is swapped into the split pane in
        --      place, per SwapSplitPane. tmux focus is NOT transferred — the
        --      board keeps focus and the pane simply changes what it shows.
        --      This is the surface the retired [S] key used to provide.
        --
        --   3. Has a tmux window, split inactive: the normal jump calls tmux
        --      select-window on task.tmux_window. Branches 2 and 3 both cover
        --      Stale/Crashed tasks that still have a window — the window check
        --      wins over the problematic-status check, because a stale agent
        --      is usually just idle and looking at it is what the user wants.
        --
        --   4. No window, routed by status (reached with split active or
        --      inactive alike — there is nothing to swap in):
        --      * Backlog        -> DispatchTask (dispatch.allium). The
        --        repo-trust confirmation (ConfirmTrustRepo) is preserved: an
        --        untrusted repo first shows the trust prompt, which on accept
        --        proceeds to dispatch. The gate itself is specified in
        --        dispatch.allium (DispatchTask, "Repo-trust pre-gate"), and
        --        quick dispatch goes through the same gate via
        --        QuickDispatchTrustGate in tasks.allium.
        --        Tag-based routing (research ->
        --        DispatchResearchTask) lives in dispatch.allium, not here.
        --      * Running/Review/Done, Stale or Crashed -> open the
        --        kill-and-retry dialog (ConfirmRetry: [r] resume / [f] fresh
        --        start). This is the only path that still opens that dialog
        --        (RetryResume / RetryFresh in dispatch.allium).
        --      * Running/Review/Done with a worktree -> ResumeTask
        --        (dispatch.allium): reattach the agent in the existing
        --        worktree.
        --      * Running/Review/Done without a worktree -> a status hint
        --        ("No worktree to resume, move to Backlog and re-dispatch").
        --      * Archived -> a status hint ("Task is archived").
        --
        -- Space on an epic row (board view) is unchanged: it enters the epic
        -- view. Inside the epic, Space on each subtask follows the task rules
        -- above.
}

-- == Jump Back to TUI Window (Prefix+Space) ==
--
-- The complement of [Space]: while focus is on an agent's tmux window,
-- pressing the tmux prefix followed by Space jumps tmux focus back to the
-- dispatch TUI window.

rule JumpBackToTuiWindow {
    when: UserAction("prefix+space")

    ensures: tmux_focus = "TUI"

    @guidance
        -- Registered at TUI startup as a prefixed tmux keybinding (the tmux
        -- prefix must be pressed first, same as any other tmux binding):
        --   tmux bind-key space "select-window -t =TUI"
        -- The TUI window is renamed to the fixed "TUI" constant at startup so
        -- the binding can target it by name. Both the binding and the rename
        -- are torn down on exit (unbind-key space; rename restored).
        --
        -- The leading "=" anchors the target to an exact name match: tmux
        -- otherwise resolves a name target by prefix, so a window merely
        -- *starting* with "TUI" could absorb the jump (see the
        -- TmuxWindowTargetedExactly invariant in dispatch.allium). This is the
        -- one window target that cannot be resolved to a pane identity up
        -- front, because the binding is a command tmux runs later and any pane
        -- identity captured at registration time would be stale by then.
        --
        -- Implemented in src/runtime/mod.rs (setup_tmux_for_tui /
        -- teardown_tmux_for_tui) via tmux::bind_key / unbind_key.
        -- Best-effort: a failing tmux call does not prevent the TUI starting.
        --
        -- Surfaced in the in-TUI help popup ([?], General section) alongside
        -- the agent-tree toggle (see agent-tree.allium's
        -- BindAgentTreeToggle) so both tmux-global bindings are discoverable
        -- without leaving the board.
}

-- == Pin Task in Split Pane (Space, split mode) ==
--
-- Pressing Space on a task in split mode pins that task's tmux window into the
-- right pane without transferring tmux focus. The user stays on the TUI board.
-- There is no dedicated swap key: outside split mode the same Space press
-- jumps to the window instead (JumpToAgentWindow, priority 3), so the action
-- has no "split view not active" state of its own to report.

rule PinTaskInSplitPane {
    when: SplitPaneSwapRequested(task)
    requires: split_pane.active = true
    requires: task.tmux_window != null
    requires: split_pane.in_flight = null
    -- The empty-pane case, and only that: with a task already pinned the
    -- request is SwapSplitPane's. The two rules share a trigger, so they must
    -- not also share a state — a request that matched both would have two
    -- rules starting one swap.
    requires: split_pane.pinned_task = null

    ensures: split_pane.in_flight = SwapInFlight.created()
    ensures: SplitPaneSwapStarted(new_task: task, old_task: null)
    ensures: split_pane.focused = unchanged  -- focus does NOT transfer

    @guidance
        -- When the selected task is already pinned, the action is a no-op: no
        -- rule fires. This one is excluded by pinned_task = null and
        -- SwapSplitPane by pinned_task != task.
        -- When a different task is pinned, the pane content is swapped in-place
        -- via tmux swap-pane. The old content is returned to a standalone window.
        --
        -- No tmux select-pane is called — the TUI pane retains focus throughout.
        --
        -- A task with no tmux window never reaches this rule: JumpToAgentWindow
        -- only raises SplitPaneSwapRequested for a task that has one, and routes
        -- the rest by status (dispatch / resume / retry) exactly as it does
        -- outside split mode.
        --
        -- == IMPLEMENTED: companion-pane draining ==
        -- The empty-pane case (no task currently pinned) reaches this via
        -- `exec_enter_split_mode_with_task` (src/runtime/split.rs), which
        -- calls `dispatch::join_task_window_into_pane`
        -- (src/dispatch/split_panes.rs), which moves only the agent's own
        -- (active) pane out of its window. Whatever dispatch itself put in
        -- that window (docs/specs/agent-tree.allium: the agent-tree companion
        -- pane, and any editor pane opened from it) is left behind in a window
        -- nothing owns — and a lone companion pane is indistinguishable, from
        -- live tmux state alone, from the companion being toggled hidden.
        -- `join_task_window_into_pane` therefore captures EVERY such pane
        -- *before* the join and kills each once the join succeeds, so the
        -- source window is fully drained either way, restoring the "the
        -- window no longer exists" assumption
        -- `SplitPaneRespawnOnWindowCleared`'s guidance relies on. The panes are
        -- found by the role marker dispatch wrote on each at creation (see
        -- agent-tree.allium's HideAgentTreePane), asked as one question — "which
        -- panes carry a role at all" — rather than one lookup per kind, so a
        -- future dispatch-created pane is drained without this path being
        -- taught about it. Both the check and the kill are best-effort: a
        -- failure is logged, never propagated, since these panes are
        -- decorative. `tmux::join_pane` itself stays a plain tmux wrapper with
        -- no companion-pane awareness — that orchestration lives above it, alongside
        -- the equivalent resync in SwapSplitPane's guidance below. Resolves
        -- agent-tree.allium's ToggleVsSplitPaneInteraction open question for
        -- the join half of the gap.
}

rule SwapSplitPane {
    when: SplitPaneSwapRequested(task)
    requires: split_pane.active = true
    requires: task.tmux_window != null
    requires: split_pane.pinned_task != task  -- no-op when already pinned
    requires: split_pane.in_flight = null
    -- The occupied case, and only that: see PinTaskInSplitPane above for the
    -- empty one. Together with that rule's mirror guard, exactly one rule
    -- starts any given swap.
    requires: split_pane.pinned_task != null

    ensures: split_pane.in_flight = SwapInFlight.created()
    -- The currently pinned task's pane is returned to a standalone window,
    -- and the new task's window is joined into the split pane.
    ensures: SplitPaneSwapStarted(
        new_task: task,
        old_task: split_pane.pinned_task
    )

    @guidance
        -- This rule specifies the swap case for Space in split mode; the
        -- pin-empty case
        -- is covered by PinTaskInSplitPane. When the pane already holds
        -- a different task's window, the old window is swapped out via
        -- tmux swap-pane and returned to the standalone window list.
        -- tmux focus is NOT transferred — the TUI pane retains focus
        -- throughout the swap.
        --
        -- This rule STARTS the swap; it does not finish it. pinned_task and
        -- pane are assigned by SplitPaneSwapSettles, once the tmux
        -- rearrangement below has actually happened — so everything this rule
        -- reads still describes the outgoing occupant, which is the point.
        -- A further request arriving in between is held by
        -- DeferSwapWhileSwapInFlight rather than started against that state.
        --
        -- The rename below must not assign a name a live window already
        -- holds; see dispatch.allium's TmuxWindowNamesAreUnique for what a
        -- duplicate costs. A refused rename fails the swap, which settles as
        -- unsuccessful and leaves the pane showing what it showed before.
        --
        -- == IMPLEMENTED: companion-pane resync ==
        -- `exec_swap_split_pane` (src/runtime/split.rs) uses `swap-pane` to
        -- atomically exchange the previously-pinned task's pane and the new
        -- task's pane 0. `swap-pane` moves *pane objects* between windows —
        -- each pane keeps its own pane ID and running process, but which
        -- window it belongs to (and so which layout slot it occupies) is
        -- exactly what gets exchanged; it is the *window* that keeps its
        -- identity (its name, its position in the session), not the pane
        -- that started there. A pane ID resolved before the swap therefore
        -- names a pane in the *other* window afterwards — measured directly
        -- fixing this rule's own `@dispatch_dir` rewrite below, where
        -- targeting by the pre-swap pane ID silently wrote the option onto
        -- the wrong window and was only caught by the real-tmux test in
        -- tests/tmux_lifecycle.rs, never by the MockProcessRunner argv-shape
        -- tests (which do not model this semantic at all). `exec_swap_split_pane`
        -- then renames the window (formerly the new task's, now holding the
        -- old task's pane) to the old task's window name. Neither step
        -- touches the window's other panes: a
        -- renamed window's agent-tree companion pane (docs/specs/agent-tree.allium),
        -- if any, keeps running `dispatch agent-tree <new_task_id>` under a
        -- window now named (and considered to belong to) the old task —
        -- silently rendering the wrong agent's tree.
        --
        -- After a successful rename, `dispatch::resync_agent_tree_pane`
        -- (src/dispatch/agents.rs) parses the task id back out of the
        -- window's own new name (the same `task-<id>` inverse
        -- `toggle_agent_tree_pane` already uses) and, if the window carries
        -- a companion pane, kills it and relaunches
        -- `dispatch agent-tree <task_id>` for that correct task — and marks the
        -- relaunched pane with its role, since it is a new pane and an unmarked
        -- one would read as "no companion" to the next toggle. A no-op for
        -- a non-task window name or a window with no companion pane at all.
        -- Best-effort throughout: failures are logged, never propagated.
        --
        -- The `old_task = null` branch (no previously-pinned task) needs no
        -- equivalent fix: `tmux::kill_window` there destroys the whole
        -- window, companion pane included, so nothing is left to desync.
        -- Resolves agent-tree.allium's ToggleVsSplitPaneInteraction open
        -- question for the swap half of the gap.
        --
        -- == IMPLEMENTED: @dispatch_dir rewrite ==
        -- The rename above fixes which task the resync targets, but not where
        -- its companion starts: renaming a window never touches its window
        -- options, so `@dispatch_dir` (see AgentWindowSplitStartsInTaskWorktree
        -- below) still names the *incoming* task's worktree immediately after
        -- the rename. Left alone, `resync_agent_tree_pane`'s read of
        -- `@dispatch_dir` would race that staleness — sometimes observing it,
        -- sometimes not, depending on unrelated timing — rather than being
        -- reliably wrong or reliably right. `swap_task_window_into_pane`
        -- (src/dispatch/split_panes.rs) closes this by rewriting
        -- `@dispatch_dir` to the outgoing task's own worktree — via
        -- `tmux::set_window_dispatch_dir` — immediately after the rename and
        -- before calling `resync_agent_tree_pane`, so the read is never racing
        -- anything: the correct value is written, synchronously, on the same
        -- thread, before it is ever read back. Targeted by the window's *new
        -- name*, not by any pane ID resolved earlier in the swap — see the
        -- companion-pane-resync guidance above for why a pre-swap pane ID
        -- would name the wrong window here. The outgoing task's worktree
        -- path is threaded in from the TUI's own in-memory task list
        -- (`App::handle_swap_split_pane`, src/tui/update/split_pane.rs) rather
        -- than queried fresh — the same `find_task` lookup that already
        -- resolves the outgoing window's name resolves its worktree too, so no
        -- new database access is added to the dispatch/tmux layer. Best-effort
        -- like the resync itself: a failed rewrite is logged, never
        -- propagated, since the swap's pane exchange and rename have already
        -- succeeded by this point.
}

rule DeferSwapWhileSwapInFlight {
    when: SplitPaneSwapRequested(task)
    requires: split_pane.active = true
    requires: task.tmux_window != null
    requires: split_pane.in_flight.kind = SwapInFlight

    -- Held, not queued: the newest request replaces whatever was waiting.
    ensures: split_pane.in_flight.pending_swap = task

    @guidance
        -- Why a swap cannot simply start. A swap is specified against
        -- split_pane.pinned_task and split_pane.pane — which task is leaving,
        -- and which pane it is leaving from — and neither takes its new value
        -- until the swap in flight has finished rearranging tmux (see
        -- SplitPaneSwapSettles below). A second swap started before then reads
        -- both as the PREVIOUS occupant and acts on them:
        --
        --   * It exchanges the wrong pane. The pane recorded as the split
        --     pane is, by then, the pane the earlier swap moved out to a
        --     standalone window, so the board's own pane is left untouched
        --     and two agents end up in each other's windows.
        --   * It renames a window to a name already in use. The outgoing
        --     task's window name is read from the stale pinned_task, so the
        --     rename repeats the name the earlier swap just assigned —
        --     leaving two windows sharing it, which is exactly what
        --     dispatch.allium's TmuxWindowNamesAreUnique forbids and what
        --     TmuxWindowTargetedExactly then refuses to resolve. Every later
        --     name-targeted operation on that task — its @dispatch_dir
        --     rewrite, its companion resync, its notifications, its kill —
        --     fails until a human closes one of the two windows. Observed in
        --     the field: two windows named task-4749, reported as a failed
        --     @dispatch_dir rewrite after a swap.
        --
        -- Why held rather than dropped. Pressing Space on one task and then
        -- another is ordinary browsing, and the second press is not a
        -- refinement of the first — it is the whole instruction, "show me
        -- this task". Dropping it would make a fast press do nothing, with
        -- nothing on screen to say why. Holding it costs one slot and makes
        -- the outcome the one the user asked for last.
        --
        -- Why only one is held. A third press supersedes the second for the
        -- same reason: replaying a chain of intermediate swaps would move
        -- panes the user never wanted to look at, and each would cost its own
        -- tmux round trip. Only the newest pending request survives.
        --
        -- The held request is not validated here beyond having a window. By
        -- the time it runs, the task may have become the pinned one (the swap
        -- in flight was for the same task) or lost its window — both are
        -- re-checked when it is replayed, not now.
}

rule SplitPaneSwapSettles {
    when: SplitPaneSwapSettled(new_task, pane, succeeded)

    requires: split_pane.in_flight.kind = SwapInFlight

    let pending = split_pane.in_flight.pending_swap
    let quitting = split_pane.in_flight.pending_quit
    let toggling = split_pane.in_flight.pending_toggle

    -- Ending the rearrangement discards all three holds with it, which is what
    -- makes "acted on at most once" structural rather than three separate
    -- clearing clauses that a later field could be forgotten from.
    ensures: split_pane.in_flight = null
    ensures:
        if succeeded = true:
            split_pane.active = true
            split_pane.pinned_task = new_task
            split_pane.pane = pane
    ensures:
        if pending != null and quitting = false and toggling = false:
            SplitPaneSwapRequested(task: pending)
    ensures:
        if toggling = true and quitting = false:
            ExitSplitMode()
    ensures:
        if quitting = true:
            ExitSplitMode()
            ApplicationQuits()

    @guidance
        -- The settle point: the single moment at which the split pane starts
        -- describing the new occupant. Both halves of the swap's identity —
        -- pinned_task and pane — move together here, because a swap exchanges
        -- pane objects between windows and so changes which pane the board
        -- holds as well as which task it shows.
        --
        -- A failed swap settles too. succeeded = false leaves pinned_task and
        -- pane naming the previous occupant, which is the truth: a swap that
        -- could not rearrange tmux changed nothing about what the pane shows.
        -- The failure is reported to the user as a status error by whichever
        -- step failed. Settling on failure is load-bearing, not tidiness — a
        -- swap that failed and left itself in flight would leave the board
        -- unable to swap again for the rest of the session.
        --
        -- A pending swap is replayed as an ordinary request, so it is gated by
        -- PinTaskInSplitPane / SwapSplitPane / DeferSwapWhileSwapInFlight
        -- exactly as a fresh press would be. That is what makes the "already
        -- pinned" and "window went away" cases fall out rather than needing
        -- handling here: the replayed request is refused by the same requires
        -- clauses that would refuse the press.
        --
        -- pending_swap is discarded whether or not it is replayed, so a
        -- request held during a swap is acted on at most once. pending_toggle
        -- goes with it, on the same terms and for the same reason: both live on
        -- the rearrangement this rule ends, so ending it is what clears them.
        --
        -- A held toggle is replayed as an EXIT, exactly as on the entry side,
        -- and not as a fresh press. A toggle is relative to what the board was
        -- showing when it was pressed, and a press held during a swap was made
        -- with the pane open: it meant "close this split". Replaying it as a
        -- fresh press would read active afresh and, on the one path where a
        -- pane close has landed mid-swap (SplitPaneClosedResets above), ENTER —
        -- the opposite of what was asked. Replaying it as an exit does the
        -- right thing in all three cases: with a pane open it closes it, and
        -- where the close already took the pane away ExitSplitMode's own
        -- active guard makes it a no-op, which is correct because what the
        -- press asked for has already happened.
        --
        -- This is also why the replay needs no target. A fresh press would have
        -- to name a task to enter on, and pending_toggle is a Boolean that
        -- cannot retain the one the user's press was aimed at; an exit names
        -- nothing.
        --
        -- A held quit exits first and then quits — the same order
        -- QuitExitsSplitMode and SplitPaneEntrySettles use, and for the same
        -- reason: a pinned agent is returned to a standalone window rather than
        -- ending with the board. Only here does the quit reach a point where
        -- the rename is either done or abandoned, so the half-finished window
        -- name HoldQuitWhileRearrangementInFlight exists to prevent cannot
        -- outlive the process.
        --
        -- It quits whether or not the swap succeeded, exactly as the entry side
        -- does. The user asked to leave; a failed rearrangement changes what
        -- there is to tidy up, never whether the application goes away.
        -- ExitSplitMode is emitted either way: it is self-guarded on active, and
        -- after a failed swap the pane still shows the previous occupant, so
        -- there is still a pinned agent to restore. Contrast the held TOGGLE in
        -- SplitPaneEntrySettles, which IS dropped on failure — a toggle is
        -- relative to what the press before it achieved, while a quit is not
        -- relative to anything.
        --
        -- A pending swap held alongside the quit is DROPPED, not replayed.
        -- Replaying it would move a pane into a board the user will never look
        -- at again, and — decisively — the replayed swap is itself a
        -- rearrangement that the quit does not wait for, reintroducing the
        -- exact half-finished-rename race this hold exists to close.
        -- pending_swap is cleared either way, so the at-most-once property
        -- holds on this path too.
        --
        -- A held TOGGLE alongside the quit is dropped as well. The quit's own
        -- ExitSplitMode already takes the pane away, and a toggle and a quit
        -- arriving during one swap must exit once between them, not twice —
        -- the same rule SplitPaneEntrySettles states for its pair.
        --
        -- A held swap alongside a held TOGGLE is dropped too, on the same
        -- reasoning that drops it alongside a quit. The two are contradictory
        -- instructions — "show me this task" and "close this split" — and the
        -- toggle is the one that survives, because a swap into a pane the user
        -- has just asked to close achieves nothing they asked for. Acting on
        -- both is worse than arbitrary: the replayed request starts a fresh
        -- rearrangement and marks swap_in_flight, and the exit then breaks out
        -- the very pane that rearrangement is exchanging — two tmux operations
        -- issued against one pane at once, and the swap's own report would
        -- afterwards set active back to true, re-opening the split the press
        -- asked to close. pending_swap is cleared either way, so the
        -- at-most-once property holds on this path too.
}

-- The entry counterpart of SplitPaneSwapSettles above: the moment split mode
-- starts describing the pane it asked for. Resolved the open question this file
-- used to carry here — whether entry should share the swap's in-flight
-- serialisation, or whether a second [s] during entry should mean "exit again".
-- It is both: the held press is replayed as the toggle it is, and a toggle
-- replayed against a pane that has just opened exits. The two readings only
-- looked like alternatives.

rule SplitPaneEntrySettles {
    when: SplitPaneEntrySettled(pane, task, succeeded)

    requires: split_pane.in_flight.kind = EntryInFlight

    let pending = split_pane.in_flight.pending_toggle
    let quitting = split_pane.in_flight.pending_quit

    -- As in SplitPaneSwapSettles above, ending the rearrangement is what
    -- discards both holds.
    ensures: split_pane.in_flight = null
    ensures:
        if succeeded = true:
            split_pane.active = true
            split_pane.pane = pane
            split_pane.pinned_task = task
            split_pane.focused = true
    ensures:
        if (pending = true or quitting = true) and succeeded = true:
            ExitSplitMode()
    ensures:
        if quitting = true:
            ApplicationQuits()

    @guidance
        -- A failed entry settles too. succeeded = false leaves split mode
        -- inactive, which is the truth: an entry that could not open a pane
        -- changed nothing. The cause is reported to the user by whichever step
        -- failed — a status hint outside tmux, an error otherwise. Settling on
        -- failure is load-bearing, not tidiness: an entry that failed and left
        -- itself in flight would leave [s] doing nothing at all for the rest of
        -- the session, with no way back short of restarting.
        --
        -- A held toggle is replayed only after a successful entry, and is
        -- replayed as an exit rather than as a fresh press. Both differ from
        -- the swap's replay in SplitPaneSwapSettles, and for the same reason:
        -- a swap request names a task and stays meaningful whatever happened
        -- to the swap that held it, while a toggle is relative to what the
        -- press before it achieved. After a success the pane is open, so the
        -- held toggle closes it. After a failure nothing opened, so replaying
        -- would restart the attempt that just failed and repeat its error
        -- rather than undo anything.
        --
        -- pending_toggle is discarded whether or not it is acted on, so a press
        -- held during an entry is acted on at most once.
        --
        -- A held quit exits first and then quits, and unlike a held toggle it
        -- quits whether or not the entry succeeded. The user asked to leave;
        -- a failed entry changes what there is to tidy up, never whether the
        -- application goes away. Exit runs first for the reason it runs on any
        -- quit — a pinned agent is restored to a standalone window rather than
        -- ending with the board — and a held toggle and a held quit arriving
        -- during the same entry exit once between them, not twice.
}

-- == Splits Inside an Agent Window Start in the Task's Worktree ==
--
-- Distinct from the board's own split pane above: this is about any new pane
-- created *inside* an agent's tmux window — by the user pressing a tmux split
-- binding, or by dispatch itself opening the agent-tree companion pane (see
-- agent-tree.allium: SplitAgentTreePaneOnAgentLaunch).
--
-- Whoever caused the split, the new pane must start in that task's worktree.
-- Dispatch's own splits achieve this at creation; a split dispatch did not make
-- is corrected afterwards, and that correction reaches the newly created pane
-- and no other pane. Any other target is a correctness bug, not a cosmetic
-- imprecision: the board TUI and the agent's own Claude session both act on
-- what arrives at them.

rule AgentWindowSplitStartsInTaskWorktree {
    when: TmuxWindowSplit(window, new_pane)

    -- The window being split is a dispatched task's agent window.
    let task = core/Task{tmux_window: window}

    requires: exists task
    requires: task.worktree != null

    ensures: PaneWorkingDirectorySet(
        pane: new_pane,
        directory: task.worktree.path
    )

    @guidance
        -- Why any mechanism is needed. tmux does not give worktree-relative
        -- splits for free, and does not inherit the split pane's directory:
        -- measured on tmux 3.7b with the session, window and client directories
        -- all set to different values, a split-window invoked by an external CLI
        -- client — which is how dispatch, or any script, shells out to tmux —
        -- starts the new pane in the *invoking process's* cwd, while a split the
        -- user triggers from an attached client starts it in the *session's*
        -- cwd. Neither is the worktree. This was issue #231, fixed by commit
        -- 8bf36803.
        --
        -- Mechanism, in two tiers. Each agent window carries its worktree path
        -- in a per-window tmux user option, @dispatch_dir, set when the window
        -- is created. A rename alone never changes it — that is what SwapSplitPane's
        -- "== IMPLEMENTED: @dispatch_dir rewrite ==" guidance above rewrites it
        -- for, so this invariant keeps holding across a swap's rename too.
        --
        --   1. Splits dispatch makes itself (the agent-tree companion pane) pass
        --      `split-window -c <worktree>`, so those panes are correct by
        --      construction. No hook runs and nothing is delivered to them.
        --   2. Splits dispatch did not make — the user pressing a tmux split
        --      binding inside an agent window — are corrected by a single
        --      session-level after-split-window hook. It fires only when the
        --      window has @dispatch_dir *and* the new pane did not already start
        --      there (#{pane_start_path}, which tmux populates before the hook
        --      runs), and it corrects with `respawn-pane -k -c <worktree>`.
        --
        -- The correction is never delivered as keystrokes. An earlier mechanism
        -- typed `cd <worktree>` + Enter at the new pane, which is only correct if
        -- a shell happens to be reading it: the agent-tree companion pane exits
        -- on `q`, so any worktree path containing that letter closed the pane the
        -- moment it opened, and the other letters moved its cursor. Whatever
        -- occupies a pane is the pane's business, so the directory is set through
        -- tmux rather than through the pane's input.
        --
        -- The hook must still name its target explicitly (respawn-pane -t
        -- #{pane_id}): inside run-shell -bC the enclosing command's target
        -- context is lost and tmux falls back to the session's *active* pane,
        -- which during a background split is whatever the user is looking at —
        -- typically the board. That defect (#3781) once typed `cd <worktree>`
        -- into the kanban board, where `c` fired the Copy-Task binding and the
        -- remainder landed in the resulting text field. The lesson outlives the
        -- keystrokes: an untargeted respawn-pane would restart the wrong pane.
        --
        -- @dispatch_dir must be quoted where it is interpolated into the hook's
        -- innermost command. Unquoted, a worktree path containing a space
        -- silently resolves to $HOME instead. Measured, both ways.
        --
        -- Tier 1 does not make tier 2 removable, and vice versa: `-c` cannot
        -- reach a split the user makes, and the hook must stay inert for panes
        -- that are already correct so it never restarts a running companion
        -- pane. Any future refactor that drops either must replace its half of
        -- the guarantee by other means.
        --
        -- Accepted side effect. A user split that launched a command has that
        -- command restarted once, in the right directory, by respawn-pane -k.
        -- Bounded to the pane just created and to panes milliseconds old; this
        -- is knowingly accepted, not overlooked.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- SplitDirectoryTargetsNewPaneOnly: The worktree correction that follows a
-- split inside an agent window applies to the newly created pane and to no
-- other pane — never to the board TUI pane, and never to the agent's own
-- Claude pane. A mistargeted correction would restart a pane that is doing
-- work, not merely tidy a directory.

-- SplitDirectoryIsNeverKeystrokes: The worktree directory is never delivered to
-- a pane as synthesised input. Whatever occupies a pane may interpret arriving
-- characters as commands — the agent-tree companion pane exits on `q`, the
-- board TUI treats `c` as Copy-Task, and the agent's pane feeds them to Claude —
-- so no pane, including the newly created one, may be typed into to place it in
-- its worktree.

-- QuitDoesNotOutrunTheRestoreItIssued: When quitting exits split mode with a
-- task pinned, the application does not finish tearing down while that
-- restore's tmux work is still outstanding -- nor while any other exit's is — it waits for the work to report
-- back, or for config.quit_restore_timeout to elapse, whichever comes first.
-- Ordering the restore is not the same as completing it, and only completion
-- puts the agent in the standalone window its task records. The bound is half
-- the invariant, not a caveat on it: a quit that could wait forever would be a
-- worse failure than the one this prevents.

-- SplitPaneStability: When split mode is active, the pane must never be
-- destroyed and recreated in response to task lifecycle events. Pane content
-- is replaced in-place (respawn) to avoid visual flicker. The only operations
-- that tear down the pane are explicit user actions: toggling split mode off
-- (s key) or manually closing the pane. Even then it is the split-pane UI that
-- is torn down, not the agent: ExitSplitMode breaks a pinned task's pane back
-- out to a standalone tmux window and only kills the pane when nothing was
-- pinned. Lifecycle events (finish, PR creation) respawn the pane content and
-- clear pinned_task, but keep active=true and pane intact.

