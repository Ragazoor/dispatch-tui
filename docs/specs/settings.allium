-- allium: 3
-- settings.allium
--
-- Scope: Saving and clearing this install's own preferences: named settings
--        (core/Setting). The entity lives in core.allium, alongside
--        SavedRepoPath and SavedRepoBranch, which it follows structurally;
--        this file owns the board's requests to change it.
-- Includes: SaveSetting, ClearSetting, SetManagedFeedSettings — the board's
--           requests, each for this install's own Host; SettingWrites, the
--           surface every feature that keeps a preference reaches them
--           through; WHERE settings live (the shared store, per host —
--           SettingsAreStoredPerHost).
-- Excludes: the store's judgement and write of the row (store-split.allium:
--           SaveSettingForHost, ClearSettingForHost,
--           SetManagedFeedSettingsForHost). host_id, host_label, the stored
--           UserIdentity and its credential (see host.allium): none of these
--           is a Setting. host_id and host_label are fields of core/Host
--           itself, and naming either in a Setting row would be a second
--           place to keep the same fact in step. The stored UserIdentity is
--           core/Host.owner for the same reason. Its credential is narrower
--           still: it is what PROVES that identity and never appears in a
--           shared table at all. All four live in the host file (host.allium:
--           IdentityLivesInHostFile), and the board refuses a setting write
--           that names one. Also excluded: which rows a board is sent and how
--           they get there (see sync.allium: SubscribeToThisHostsSettings) —
--           this file says whose a setting is, not how that fact is
--           transported.
--
-- WHY HOST, NOT UserIdentity. A setting describes one machine: a feed command
-- names a script path on that machine's disk, a fold or a filter is one
-- board's view. Keyed by the person, the same person's two machines would
-- share those values and overwrite each other's. Keyed by host id, no two
-- machines share a row, since no two hosts share an id (core.allium:
-- Host.id). Writing still needs the person: the store accepts a setting only
-- from the host's owner (store-split.allium: SaveSettingForHost), so an
-- install that has never connected has no stored settings and runs on the
-- defaults.

use "./core.allium" as core

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- The four managed-feed settings (epics.allium: ManagedFeedConfigViaMcp):
    -- a command and a poll interval for each of the reviews and CVE feeds.
    managed_feed_setting_keys: Set<String> = {"reviews_feed_command", "reviews_feed_interval_secs", "cve_feed_command", "cve_feed_interval_secs"}
    -- The two of them whose value is a whole number of seconds.
    managed_feed_interval_keys: Set<String> = {"reviews_feed_interval_secs", "cve_feed_interval_secs"}
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule SaveSetting {
    when: SaveSetting(key, value)

    ensures: SettingSaved(host: core/local_host(), key: key, value: value)

    @guidance
        -- The board asks the store to set this host's `key` to `value`. The
        -- store judges and writes it (store-split.allium: SaveSettingForHost):
        -- an upsert on (host, key), so a second save of the same key on the
        -- same host replaces the value rather than adding a row, and a save
        -- from a different host is a different row. The board never names
        -- another host: every request here is for core/local_host().
}

rule ClearSetting {
    when: ClearSetting(key)

    ensures: SettingCleared(host: core/local_host(), key: key)

    @guidance
        -- Clearing a key that was never set is a no-op rather than a
        -- refusal: a caller here is typically restoring a default (e.g.
        -- clearing a feed command), and finding the default already in
        -- effect is not a mistake worth reporting. The store judges the
        -- request and deletes the row if there is one (store-split.allium:
        -- ClearSettingForHost).
}

rule SetManagedFeedSettings {
    -- Each write names a key and a value; a null value clears the key.
    when: SetManagedFeedSettings(writes)

    ensures: ManagedFeedSettingsWritten(host: core/local_host(), writes: writes)

    @guidance
        -- The managed-feed settings are written as ONE change, because a
        -- command and its interval are coupled: a failure between two
        -- SaveSetting requests would leave a feed with a command and the
        -- wrong cadence. The store judges every write before any lands
        -- (store-split.allium: SetManagedFeedSettingsForHost). The board
        -- checks the feed-interval floor (epics.allium:
        -- ManagedFeedConfigViaMcp) before it asks.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The board's way into this file. Each feature that keeps a preference emits
-- one of these requests from its own rule, qualified
-- (`settings/SaveSetting(key: …, value: …)`): tasks.allium's section and epic
-- folds, board-layout.allium's repo filter and hide-lists, agent-health.allium's
-- notifications toggle, and epics.allium's managed-feed configuration. This surface does not
-- list them; the feature that owns a preference owns the decision to keep it.
surface SettingWrites {
    facing _: core/BoardProcess

    provides:
        SaveSetting(key, value)
        ClearSetting(key)
        SetManagedFeedSettings(writes)

    @guarantee SettingsAreStoredPerHost
        -- Every setting — the repo filter and its mode, notifications,
        -- collapsed sections and epic folds, the hidden epics and packages,
        -- the managed-feed commands and intervals, learning reflection
        -- (core.allium: config.learning_reflection_enabled, which no surface
        -- sets), and any key added later —
        -- is a core/Setting row in the SHARED STORE, keyed by (this host's
        -- id, key). It is written through the store (the rules above, routed
        -- by sync.allium: BoardWritesThroughTheStore), read back from this
        -- host's settings subscription (sync.allium:
        -- SubscribeToThisHostsSettings), and kept nowhere else: not in the
        -- host file, which holds identity only, and not in any local
        -- database, since dispatch has none (storage.allium: NoSqlite). There
        -- is no local fallback for a store that is down: a setting write then
        -- fails like every other shared write (sync.allium:
        -- AWriteWithNoConnectionIsRefused). A host with no rows in the store
        -- starts from the defaults; a leftover local database is never read
        -- (storage.allium: CodeNeverTouchesLegacyDatabase).
        --
        -- PER HOST, NOT PER STORE. Two machines on one store each see only
        -- their own rows, because the host id is part of the key and the
        -- subscription asks for this host's rows alone. One machine's repo
        -- filter, or a feed command naming a script path on its own disk,
        -- never reaches a colleague's board — nor the same person's other
        -- machine. core/Setting's SettingIsUniquePerHostAndKey is the
        -- expression form of the key; this guarantee is the claim about
        -- where the rows are.
}
