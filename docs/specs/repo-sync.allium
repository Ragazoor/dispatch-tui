-- allium: 3
-- repo-sync.allium
--
-- Scope: Local-first repo sync — keeping a repository's primary checkout in
--        step with origin on its own default branch.
-- Includes: the ahead/behind measurement and when it is refreshed; the sync
--           operation with its typed preconditions and its two outcomes; and
--           the three surfaces that expose them (the status-bar drift segment,
--           the [o] sync action and its confirmation, and the
--           `dispatch repo status` / `dispatch repo sync` CLI).
-- Excludes: worktree provisioning and per-task base-branch resolution (see
--           dispatch.allium); the rebase / fast-forward that moves local base
--           ahead in the first place (see pr-workflow.allium).
--
-- Why this exists: the dominant integration path (wrap_up "rebase") pulls
-- origin, rebases the task branch and fast-forwards the repo's base branch —
-- and never pushes. Local base therefore drifts ahead of origin on every
-- finished task, and behind whenever a PR merges elsewhere. Nothing measured,
-- displayed or closed that gap. This spec makes the drift visible where it
-- cannot be ignored and defines exactly one action that closes it.
--
-- Drift is not a health check. Two properties rule that framing out, and both
-- constrain any future surface that might be tempted by it. Ahead > 0 is the
-- normal state after every rebase wrap-up, not a fault, so drift must never
-- feed a pass/fail exit code — it would be permanently failing. And drift
-- cannot be measured without a fetch, so a surface that does not fetch must
-- not report it at all (see UnmeasuredIsNeverPresentedAsClean below).
-- `dispatch repo status` is the fetch-backed reporting surface; the board
-- indicator is the ambient one.

use "./core.allium" as core

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- AheadBehind is a two-sided commit count between a repository's local base
-- branch and its origin counterpart: `ahead` commits are reachable only from
-- the local branch, `behind` commits only from origin/<base>. The pair is
-- always read together, from the same observation, so it is one value rather
-- than two fields.
value AheadBehind {
    ahead: Integer
    behind: Integer

    -- Any non-zero side is drift worth surfacing.
    has_drift: ahead > 0 or behind > 0

    -- Both sides non-zero: local and origin have each moved independently.
    -- This is the case resolved by merging rather than rebasing.
    is_diverged: ahead > 0 and behind > 0
}

-- The two ways a sync can succeed, and what each moved. Distinguishable to the
-- caller on purpose: already_in_sync means the fetch ran and left nothing to
-- act on — no merge and no push were performed — while synced carries the
-- commit counts the operation actually moved.
value SyncOutcome {
    outcome: SyncOutcomeKind
    pulled: Integer   -- commits merged into local base; zero when already_in_sync
    pushed: Integer   -- commits published to origin; zero when already_in_sync

    invariant AlreadyInSyncMovedNothing {
        outcome = already_in_sync implies (pulled = 0 and pushed = 0)
    }
}

-- A failed sync reports one cause plus exactly the detail that makes that cause
-- actionable. The cause and its detail travel together; neither is useful alone.
value SyncFailureReport {
    failure: SyncFailure
    detail: String   -- the branch found and expected, the dirty or conflicted
                     -- paths, or git's own message — see ReportRepoSyncFailure

    -- Retrying the same action is the fix for a rejected push: origin moved
    -- between the fetch and the push, so the next sync fetches and merges the
    -- new commits first. A push refused for any other reason (credentials,
    -- network, a declined hook, a protected branch) would be refused again, so
    -- it is `other`, not push_rejected. Every other cause needs the operator to
    -- change something first.
    retryable: failure = push_rejected
}

-- What sync_repo hands back: exactly one of two channels, never both and never
-- neither. Keeping them apart is what lets every caller route a success to the
-- status bar and a failure to the error popup without inspecting the other.
value SyncResult {
    outcome: SyncOutcome?          -- present exactly when the sync succeeded
    failure: SyncFailureReport?    -- present exactly when the sync failed

    succeeded: failure = null

    invariant ExactlyOneChannelIsPresent {
        (outcome = null or failure = null)
        and (outcome != null or failure != null)
    }
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- The sync engine is a synchronous, process-runner-driven unit with no TUI or
-- database coupling: the same three operations back the board action and the
-- CLI. Its obligations are stated here because getting them wrong is silent —
-- a mis-measured repo claims to be in sync, and a precondition checked too
-- late corrupts a working tree.
contract RepoSyncEngine {
    -- No counts at all when the repository cannot be measured.
    ahead_behind: (repo_path: String, base_branch: String) -> AheadBehind?

    -- Nothing on success; the failure message otherwise.
    fetch_base: (repo_path: String, base_branch: String) -> String?

    -- One SyncOutcome on success, one SyncFailureReport otherwise — the two
    -- channels of a SyncResult, exactly one of which is ever present.
    sync_repo: (repo_path: String, base_branch: String) -> SyncResult

    @invariant UnmeasurableIsNotInSync
        -- ahead_behind yields no counts at all — never a zero/zero pair — when
        -- origin/<base_branch> does not resolve (no remote, never fetched) or
        -- when the count output cannot be parsed. A repository that cannot be
        -- measured must not be reported as clean.

    @invariant PreconditionsPrecedeEveryWrite
        -- sync_repo checks every precondition before it performs any write, and
        -- reports each failed precondition as its own distinct SyncFailure. A
        -- dirty primary worktree can therefore never masquerade as a merge
        -- conflict, and a missing remote can never masquerade as a rejected
        -- push.
        --
        -- One carve-out, deliberate: a remote probe that cannot be run at all
        -- and one that reports no origin are the same fact for this operation —
        -- there is nothing to sync against — so both report no_remote rather
        -- than splitting the second into `other`. The probe itself does
        -- distinguish them, and other callers act on the difference (see
        -- WrapUpRebase step 3 in pr-workflow.allium); collapsing them is this
        -- operation's own choice, not something the probe decides for it.

    @invariant FetchPrecedesCounting
        -- The fetch runs unconditionally, before the counts that decide whether
        -- to merge or push are read. The counts are only trustworthy against
        -- refs the same operation just refreshed.

    @invariant LocalBaseHistoryIsNeverRewritten
        -- Divergence is closed by merging origin/<base_branch> into the local
        -- branch, never by rebasing or resetting the local branch. Worktrees
        -- already branched off local base stay valid.

    @invariant ConflictFilesCapturedBeforeAbort
        -- On a merge conflict the unmerged paths are read from the repository's
        -- own status before the merge is aborted, because aborting clears them.
        -- The reported file list is the real one, not a guess.

    @invariant BaseBranchIsTheRepositoryDefault
        -- base_branch is the repository's own default branch (its
        -- origin/HEAD symbolic ref, falling back to
        -- core/config.default_branch), so `master` repositories work
        -- unchanged. It is never taken from the per-task base-branch history,
        -- which also records PR-review feature branches.

    @guidance
        -- Implementation: src/repo_sync.rs, structured and tested like
        -- src/dispatch/finish.rs — synchronous, MockProcessRunner-driven,
        -- exact-argv assertions.
        --
        -- ahead_behind reads `rev-list --count --left-right <base>...origin/<base>`
        -- and yields nothing when that ref pair does not resolve or the output
        -- does not parse.
        --
        -- Every subprocess the engine issues is bounded by a timeout — the
        -- fetch and the push because they touch the network, the rev-list
        -- because walking history can block on a repository lock. None of them
        -- may wedge a caller: the same counts back the TUI's drift poll and the
        -- dispatch path. A subprocess that times out is simply one that
        -- answered nothing, which the surrounding logic already handles as
        -- unmeasurable. The same bound covers every other call the engine
        -- issues: the three preflight reads reached through the shared git
        -- helpers in src/git.rs (the origin-remote probe, the current branch
        -- and the working-tree status), the default-branch detection
        -- measure_repo performs, and the whole merge block — the merge itself,
        -- the conflict-path status read and the merge abort. Each of these can
        -- block on a repository lock for the same reason the rev-list can, and
        -- the merge can additionally hang the way the rebase path's conflict
        -- handling can.
        --
        -- fetch_base yields nothing on success and the failure message
        -- otherwise. A failed fetch is non-fatal to a *refresh*: the previously
        -- known counts are kept and only the error is recorded. It is fatal to a
        -- *sync*: inside sync_repo a failed fetch reports `other` and no counts
        -- are read at all, because counting against refs the operation failed to
        -- refresh is exactly what FetchPrecedesCounting forbids.
        --
        -- sync_repo yields a SyncResult: one SyncOutcome on success — the
        -- already_in_sync / synced split, with the commit counts it moved — and
        -- one SyncFailureReport otherwise, which is what ReportRepoSyncFailure
        -- carries.
        --
        -- Porcelain and unmerged-path parsing is shared with the rebase path
        -- (parse_porcelain_files / parse_unmerged_files in src/git.rs, one
        -- implementation, two callers). Conflict *detection* is not shared, by
        -- design: the rebase path reads git's own prose markers
        -- (is_rebase_conflict in src/dispatch/git_output.rs), the sync path
        -- reads whether the unmerged path list is empty.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- Which shape a successful sync took. Kept apart because "nothing to do" and
-- "commits moved" call for different words in every surface that reports them.
enum SyncOutcomeKind {
    already_in_sync   -- the fetch ran and left nothing the operation could act
                      -- on: no merge and no push were performed
    | synced          -- commits were merged into local base, published to
                      -- origin, or both
}

-- Every way a sync can fail, one value per cause. The split is the point: each
-- cause has a different remedy and a different message, so none of them may be
-- collapsed into a generic error.
enum SyncFailure {
    no_remote               -- the repository has no origin remote configured
    | not_on_base_branch    -- the primary checkout is on some other branch;
                            -- both the merge and the push act on whatever is
                            -- checked out, so this must stop the operation
    | dirty_primary_worktree -- the primary checkout has uncommitted changes;
                            -- merging into a dirty tree is how work is lost
    | merge_conflict        -- the merge of origin/<base> failed *and* left
                            -- unmerged paths behind; the merge was aborted and
                            -- those paths reported. Unmerged paths are the
                            -- discriminator: a merge that fails with nothing
                            -- unmerged (unrelated histories, a bad ref) reports
                            -- `other` instead, because an empty conflict list
                            -- would misstate the remedy
    | push_rejected         -- `git push` was refused because origin moved
                            -- between the fetch and the push: git's output
                            -- names a non-fast-forward rejection. Only this
                            -- push failure is retryable. Any other failed push
                            -- (credentials, network, a hook that declined it,
                            -- a protected branch) or a push that cannot be
                            -- *run* at all reports `other`
    | other                 -- any other git failure: a failed fetch, a merge
                            -- that failed with nothing unmerged, a push that
                            -- failed for any reason but origin moving, or a
                            -- git command that could not be run at all
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- RepoSyncState is the current drift measurement for one repository. At most
-- one exists per repo_path. It is a measurement, not a record: every consumer
-- establishes it for itself (the board refreshes it on the events below, the
-- CLI computes it when it runs), so it crosses no process boundary and needs
-- no persistence.
entity RepoSyncState {
    repo_path: String        -- absolute path to the repository's primary checkout; identifies the measurement
    base_branch: String      -- the repository's own default branch, as measured
    counts: AheadBehind?     -- null when origin/<base_branch> could not be measured at all
    last_fetch_error: String? -- message from the most recent failed fetch; null once a fetch succeeds
    sync_in_flight: Boolean  -- a board-confirmed sync of this repository has started and not yet reported back; board-only (see OneSyncInFlightPerRepo)

    -- Whether the repository could be measured. An unmeasured repository is
    -- distinct from a clean one and must not be presented as clean.
    is_measured: counts != null

    -- Drift the user can act on. False both when clean and when unmeasured.
    has_drift: counts != null and counts.has_drift

    invariant UniqueMeasurementPerRepo {
        for a in RepoSyncStates:
            for b in RepoSyncStates:
                a != b implies a.repo_path != b.repo_path
    }

    invariant CountsAreNonNegative {
        counts = null or (counts.ahead >= 0 and counts.behind >= 0)
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Measurement ==
--
-- Measurement is event-driven. Every refresh point below is an occasion on
-- which a git-network operation has either just happened or is genuinely
-- wanted, so there is no poll interval and no new timing constant. Only the
-- startup refresh performs a fetch; the other three ride refs some other
-- operation already refreshed, which makes them local ref reads with no
-- network cost at all.

rule RefreshRepoSyncState {
    when: RefreshRepoSyncState(repo_path, fetch_first)

    -- The repository's own default branch (see the
    -- BaseBranchIsTheRepositoryDefault contract invariant).
    let base = detect_default_branch(repo_path)

    -- Only the fetching refresh points can produce a fetch error.
    let fetch_error = if fetch_first: fetch_base(repo_path, base) else: null

    let state = RepoSyncState{repo_path: repo_path}

    ensures:
        if not exists state:
            RepoSyncState.created(
                repo_path: repo_path,
                base_branch: base,
                counts: if fetch_error = null: ahead_behind(repo_path, base) else: null,
                last_fetch_error: fetch_error
            )
        else if fetch_error != null:
            -- Non-fatal by design: the previously known counts are kept, so a
            -- slow or offline network leaves the drift indicator undisturbed
            -- rather than blanking it. Only the error is recorded, for the CLI
            -- table to report.
            state.last_fetch_error = fetch_error
        else:
            state.base_branch = base
            state.counts = ahead_behind(repo_path, base)
            state.last_fetch_error = null

    @guidance
        -- fetch_first = true only for the startup refresh and for
        -- `dispatch repo status` without --no-fetch. Every other caller passes
        -- false, because the refs were refreshed moments earlier by the
        -- operation that triggered the refresh.
        --
        -- Ordering matters: the counts are read after the fetch, never before
        -- (FetchPrecedesCounting).
        --
        -- The work runs off the event loop — git subprocesses and filesystem
        -- access must not touch the async or render paths — and its result
        -- arrives asynchronously, so a slow network never delays TUI startup or
        -- blocks a frame.
}

rule RefreshRepoSyncStateOnStartup {
    when: AppStarts()

    for repo in core/SavedRepoPaths:
        ensures: RefreshRepoSyncState(repo_path: repo.path, fetch_first: true)

    @guidance
        -- The only genuinely new network traffic this feature introduces: one
        -- fetch per saved repo path at startup. Fire-and-forget — results
        -- arrive as they land, and an offline machine simply keeps unmeasured
        -- repositories, which show no indicator.
}

rule RefreshRepoSyncStateAfterDispatch {
    when: AgentLaunched(task, mode)

    -- standard, research and quick are the three modes that provision a
    -- worktree and fetch origin/<base> before AgentLaunched fires. resume
    -- (ResumeTask / RetryResume) provisions nothing and fetches nothing — the
    -- task's worktree and tmux window already exist — so a refresh there
    -- would re-read exactly the refs the previous measurement already read.
    -- The guard excludes that no-op; it does not narrow which surfaces are
    -- covered.
    requires: mode in {standard, research, quick}

    ensures: RefreshRepoSyncState(repo_path: task.repo_path, fetch_first: false)

    @guidance
        -- No new network cost: provisioning the task's worktree already fetched
        -- origin/<base> for that repository, so this is a local ref read.
        --
        -- This obligation is per-event, not per-surface: every AgentLaunched
        -- emission carrying one of the three provisioning modes must be
        -- followed by a refresh, whichever surface produced the event. The
        -- board's own dispatch (DispatchTask), the MCP dispatch_task tool
        -- (DispatchTaskViaMcp, which ensures DispatchTask) and epic
        -- auto-dispatch chaining (AutoDispatchNextSubtask, which also ensures
        -- DispatchTask) all route through the same DispatchTask rule and the
        -- same AgentLaunched(mode: standard) emission — so from this rule's
        -- point of view they are indistinguishable, and none may be exempted.
}

rule RefreshRepoSyncStateAfterRebase {
    -- The event names the repository whose base branch just moved. It is carried
    -- on the event rather than resolved from the branch here, because a branch
    -- name is not unique across repositories: a branch-keyed worktree lookup
    -- would be ambiguous the moment two repositories carry the same branch
    -- name, and the emitters already hold the task that names the repository.
    when: BranchRebased(_, _, repo_path)

    ensures: RefreshRepoSyncState(repo_path: repo_path, fetch_first: false)

    @guidance
        -- A successful rebase wrap-up pulled origin/<base> and then
        -- fast-forwarded local <base> onto the rebased branch, so local base
        -- provably just moved ahead and the refs are already current. The
        -- refresh fires from the MCP wrap-up path, which is where real wrap-ups
        -- happen, and ahead > 0 is the normal state immediately after every
        -- rebase wrap-up.
        --
        -- The MCP wrap-up is the only path that rebases and fast-forwards a
        -- base branch, so it is the only emitter of BranchRebased. The board
        -- has no finish path of its own: the wrap-up key and the epic merge
        -- queue that once sat behind it are gone.
}

rule RefreshRepoSyncStateAfterSync {
    when: RepoSyncFinished(repo_path)

    let state = RepoSyncState{repo_path: repo_path}

    ensures:
        if exists state:
            state.sync_in_flight = false
    ensures: RefreshRepoSyncState(repo_path: repo_path, fetch_first: false)

    @guidance
        -- Recount after a sync so the indicator clears (or, on a partial
        -- outcome, tells the truth) without waiting for another event.
        --
        -- Unlike RefreshRepoSyncStateAfterDispatch, this obligation is only
        -- observable where a measurement outlives the operation, which means the
        -- board. `dispatch repo sync` (SyncRepoViaCli) is a one-shot process: it
        -- prints the counts the operation itself moved and exits, so there is no
        -- displayed measurement left to go stale and no recount is performed.
        -- The RepoSyncState it would refresh dies with the process. Adding one
        -- would spend a git invocation per target to produce a number nothing
        -- reads.
}

-- == Sync ==
--
-- Decision: sync is an explicit action, never a side effect of wrap-up.
-- Wrap-up already bundles commit, rebase, fast-forward, retro and session exit;
-- adding a write to a shared branch would make its one irreversible step worse,
-- would publish work no one verified, and would only ever help the `ahead`
-- half. One key, one command, one confirmation.

rule SyncRepo {
    when: SyncRepo(repo_path, base_branch)

    -- Preconditions are verified by the engine at execution time, each before
    -- any write and each reported as its own SyncFailure (see the
    -- PreconditionsPrecedeEveryWrite contract invariant):
    --   origin remote configured           -> no_remote
    --   primary checkout on base_branch    -> not_on_base_branch
    --   primary checkout clean             -> dirty_primary_worktree
    -- They are execution-time checks rather than rule preconditions because the
    -- caller must be told which one failed; a silently rejected trigger would
    -- lose exactly the distinction that makes them worth separating.

    -- Counts read after the unconditional fetch. Null when the repository
    -- cannot be measured even against freshly fetched refs.
    let measured = ahead_behind(repo_path, base_branch)

    -- Whenever there is anything to pull, the merge changes what local base is
    -- ahead by — a merge commit of its own when diverged, nothing when it
    -- fast-forwards — so the ahead count is re-read from the merged refs rather
    -- than predicted from the pre-merge count.
    let merged =
        if measured != null and measured.behind > 0: ahead_behind(repo_path, base_branch)
        else: null

    -- A recount that cannot be read pushes nothing: refusing to guess beats
    -- publishing a count the operation cannot justify. The merge that already
    -- happened still counts as pulled.
    let pushed =
        if measured = null: 0
        else if measured.behind > 0: merged?.ahead ?? 0
        else: measured.ahead

    ensures:
        if measured = null or not measured.has_drift:
            -- No merge and no push are performed. When the counts were read,
            -- the fetch preceding them is what makes "nothing to do" a fact
            -- rather than an assumption. When they could not be read at all,
            -- this reports what the operation did — it fetched and found
            -- nothing it could justify acting on — and not that the repository
            -- is level (see UnmeasuredIsNeverPresentedAsClean).
            RepoAlreadyInSync(repo_path: repo_path, base_branch: base_branch)
        else:
            RepoSynced(
                repo_path: repo_path,
                base_branch: base_branch,
                pulled: measured.behind,
                pushed: pushed
            )
    ensures: RepoSyncFinished(repo_path: repo_path)

    @guidance
        -- The operation, in order:
        --   1. fetch origin <base_branch> — always, even when nothing follows.
        --   2. recount ahead/behind from the refreshed refs.
        --   3. behind > 0: merge origin/<base_branch> into the checked-out
        --      branch. One command covers both shapes — it fast-forwards when
        --      ahead = 0 and creates a merge commit when diverged. Local
        --      history is never rewritten, so live worktrees branched off local
        --      base stay valid; the merge commit is the same cost the rebase
        --      wrap-up path already pays.
        --   4. re-read the ahead count from the merged refs and, when it is
        --      non-zero, push origin <base_branch>. The count pushed is
        --      measured after the merge, never predicted from the pre-merge
        --      count plus a merge commit. A recount that cannot be read pushes
        --      nothing and reports pushed = 0, while the merge that already
        --      happened still counts as pulled.
        --   5. report the outcome.
        --
        -- The two outcomes are distinguishable to the caller: RepoAlreadyInSync
        -- when the fetch left nothing to act on — both counts zero, or no counts
        -- readable at all — RepoSynced with the commit counts actually pulled
        -- and pushed otherwise.
        --
        -- Emitted from exactly two places: the board confirmation
        -- (AcceptRepoSyncPrompt) and `dispatch repo sync` (SyncRepoViaCli).
        -- There is deliberately no agent-facing tool and no automatic caller:
        -- publishing to a shared branch is an operator decision (see the
        -- SyncNeverAutomatic invariant).
}

rule ReportRepoSyncFailure {
    when: RepoSyncFailed(repo_path, report)

    let state = RepoSyncState{repo_path: repo_path}

    ensures:
        if exists state:
            state.sync_in_flight = false
    ensures: RepoSyncFailureShown(
        repo_path: repo_path,
        failure: report.failure,
        detail: report.detail,
        retryable: report.retryable
    )

    @guidance
        -- Emitted by the sync worker when sync_repo comes back with a
        -- SyncFailureReport in the failure channel of its SyncResult; `report` is
        -- that SyncFailureReport.
        -- Each failure carries the detail that makes it actionable, and nothing
        -- more:
        --   not_on_base_branch      -> the branch found and the one expected
        --   dirty_primary_worktree  -> the checkout path and its dirty files
        --   merge_conflict          -> the conflicted paths, read before the
        --                              merge was aborted
        --   push_rejected           -> git's own rejection output, verbatim
        --   no_remote               -> the underlying message
        --   other                   -> the underlying message: a failed fetch, a
        --                              merge that failed with nothing unmerged,
        --                              git's verbatim output from a push
        --                              refused for any reason but origin
        --                              moving, or the reason a git command
        --                              could not be run at all
        --
        -- In the TUI a failure goes to the error popup, never the status bar:
        -- the status bar is for outcomes the user does not have to act on, and
        -- every failure here needs a decision. Successful outcomes
        -- (RepoSynced, RepoAlreadyInSync) go to the status bar.
        --
        -- No task or repository state is mutated beyond clearing the in-flight
        -- mark. Every precondition failure, every merge conflict and every merge
        -- that could not run to completion (killed at its timeout) — the merge
        -- is aborted — leaves the repository exactly as the operation found it, so retrying once the cause is
        -- cleared is safe. The one exception is a failed push on a diverged
        -- repository (push_rejected, or `other` from the push step): the merge
        -- has already been committed locally and stays there. That is why
        -- retrying is safe — the merge is never repeated, only the publishing
        -- step is.
        --
        -- No refresh follows a failure. RepoSyncFinished is ensured by a
        -- completed SyncRepo, not by a failed one, so RefreshRepoSyncStateAfterSync
        -- does not fire here. For every failure that leaves the repository as it
        -- found it, that is exactly right: there is nothing new to measure. The
        -- failed-push-on-a-diverged-repo exception is the one case where the
        -- displayed measurement goes stale — the local merge commit has moved
        -- ahead beyond the count the indicator still shows — and it is left
        -- deliberately: the next sync attempt measures it anew, and so
        -- does the next dispatch or rebase in that repository. The indicator
        -- understating ahead is a strictly smaller nag than the truth, never a
        -- claim of cleanliness (UnmeasuredIsNeverPresentedAsClean is untouched:
        -- the counts are real, merely older).
}

-- == Board action ==

rule PromptRepoSync {
    when: OpenRepoSyncPrompt(user, task)

    let state = RepoSyncState{repo_path: task.repo_path}

    requires: exists state
    requires: state.has_drift

    ensures:
        if state.sync_in_flight:
            RepoSyncAlreadyRunning(repo_path: state.repo_path)
        else:
            RepoSyncPrompted(state: state)

    @guidance
        -- [o] for origin. It is the only unbound board-mode key with a clean
        -- mnemonic and no hazardous neighbour: y/n are the accept/reject keys
        -- of every confirmation prompt, so y would both open and accept a push
        -- to a shared branch, and w sits next to W (wrap up), the other
        -- irreversible git action. [O] is left unbound for a future sync-all.
        --
        -- The key acts on the repository of the selected task and on no other.
        -- With no task selected, an unmeasured repository or a clean one, there
        -- is no drift to close and no prompt is shown — the same condition that
        -- hides the indicator.
}

rule AcceptRepoSyncPrompt {
    when: ConfirmRepoSync(user, state)

    requires: state.has_drift

    ensures:
        if state.sync_in_flight:
            RepoSyncAlreadyRunning(repo_path: state.repo_path)
        else:
            state.sync_in_flight = true
            SyncRepo(
                repo_path: state.repo_path,
                base_branch: state.base_branch
            )

    @guidance
        -- OneSyncInFlightPerRepo: a repository with a sync in flight refuses
        -- another. The drift indicator stays lit until the first sync reports
        -- back (the fetch alone can take the whole subprocess timeout), so
        -- without the mark [o], y, [o], y starts a second run on the same
        -- checkout. Its merge then fails on index.lock or MERGE_HEAD, and the
        -- abort that follows aborts the first run's merge. Both the prompt and
        -- the confirmation refuse, because a prompt can outlive the moment it
        -- was opened. The refusal goes to the status bar: nothing needs
        -- deciding, the sync already running will report.
        --
        -- The mark is cleared by the sync's own report, success
        -- (RefreshRepoSyncStateAfterSync) or failure (ReportRepoSyncFailure).
        -- It is board-local and in memory: `dispatch repo sync` from a shell
        -- (SyncRepoViaCli) neither sets nor checks it, and that overlap is
        -- accepted — the operator started both.
}

-- == CLI ==

rule RepoStatusViaCli {
    when: CliRepoStatus(operator, no_fetch)

    for repo in core/SavedRepoPaths:
        ensures: RefreshRepoSyncState(repo_path: repo.path, fetch_first: not no_fetch)

    @guidance
        -- `dispatch repo status [--no-fetch]`. Read-only: it measures every
        -- saved repo path and prints one row each. This is the multi-repo view;
        -- the board deliberately shows only the selected task's repository.
        -- Implementation: a RepoAction variant alongside the existing
        -- set-verify / clear-verify / list forms.
}

rule SyncRepoViaCli {
    when: CliRepoSync(operator, repo_path?)

    -- One named repository, or every saved one when the path is omitted.
    let targets =
        if repo_path != null: core/SavedRepoPaths where path = repo_path
        else: core/SavedRepoPaths

    requires: targets.count > 0

    ensures:
        for repo in targets:
            SyncRepo(
                repo_path: repo.path,
                base_branch: detect_default_branch(repo.path)
            )

    @guidance
        -- `dispatch repo sync [<path>]`. Every target is attempted; one
        -- failure does not abandon the rest. The exit code is non-zero when any
        -- target failed, so the command is usable from a script.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- LocalBaseHistoryPreserved: no path in this spec rewrites the primary
-- checkout's base-branch history. Divergence is closed by merging
-- origin/<base> into local base, never by rebasing or resetting it. This is
-- what makes sync safe to run while agents hold live worktrees branched off
-- local base — a rewrite would silently orphan every one of them. Not
-- expressible as a state assertion: it constrains how state changes, not what
-- any single state looks like.

-- UnmeasuredIsNeverPresentedAsClean: a repository whose counts could not be
-- read is presented as unknown, never as in sync. Every consumer honours this
-- the same way — the status-bar segment hides and the CLI row shows no
-- counts — so no surface can quietly claim a repository is clean on the
-- strength of a failed measurement. This is also what bars a non-fetching
-- surface from reporting drift at all: any measurement it took would run
-- against refs it never refreshed, so reporting on that basis would violate
-- this invariant outright rather than merely risk it. See the header note.
--
-- One carve-out, and it is about vocabulary rather than measurement: a sync
-- whose post-fetch recount cannot be read performs no merge and no push and
-- reports RepoAlreadyInSync (see the SyncRepo rule). That outcome is a statement
-- about what the operation did — it fetched, then found nothing it could justify
-- acting on — not a claim that the repository is level with origin. Surfaces
-- reporting it must word it that way ("nothing to do"), and must never quote
-- counts they did not read. The measurement and display surfaces are not
-- weakened at all: a RepoSyncState with no counts still reads as unknown, never
-- as in sync.

-- OneRepoSetForDriftMeasurement: drift is measured over the saved repo paths
-- (core/SavedRepoPaths) and nothing else, on every surface — the startup
-- refresh, the board indicator, `dispatch repo status`, and `dispatch repo
-- sync` with no path. All four agree on this same set, so no surface can
-- report drift for a repository another surface silently omits. The saved
-- paths are the whole set deliberately: a repo with tasks but no saved path
-- is a degenerate state — task creation saves the path — and drift reporting
-- is not the place to compensate for it. Not expressible as a state
-- assertion: it constrains which repositories every consumer enumerates, not
-- what any single RepoSyncState looks like.

-- SyncNeverAutomatic: a push to a shared branch happens only in response to an
-- explicit operator action — the confirmed [o] prompt or `dispatch repo sync`.
-- No timer, no wrap-up step, no agent-facing tool and no dispatch path may
-- emit SyncRepo. A refresh may happen automatically; a sync may not.

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface RepoDriftIndicator {
    facing user: User

    -- A drift segment in the board's status bar, for the repository owning the
    -- currently selected task. A status bar rather than a popup on purpose:
    -- the point is a nag, and a nag you have to open is a nag you will not see.

    let selected_task = selected_task()
    let state = if selected_task != null: RepoSyncState{repo_path: selected_task.repo_path} else: null

    let base_branch = state?.base_branch
    let ahead = state?.counts?.ahead ?? 0
    let behind = state?.counts?.behind ?? 0

    -- Rendered only when there is a measured repository with real drift.
    let visible = state != null and state.has_drift

    exposes:
        base_branch
        ahead
        behind
        visible

    provides:
        -- [o] opens the sync confirmation for this repository. Offered only
        -- while the segment is lit: with no drift there is nothing to close and
        -- the key does nothing.
        OpenRepoSyncPrompt(user, selected_task)
            when visible

    @guarantee HiddenWithoutASelectedTask
        -- With no selected task there is no repository in scope and no segment.
        -- An epic row is not a task: selecting one shows no segment, because
        -- the segment names the repository of a selected task.

    @guarantee HiddenWhenUnmeasured
        -- A repository whose counts could not be read shows no segment. The
        -- indicator never claims "in sync" about a repository it could not
        -- measure.

    @guarantee HiddenWhenClean
        -- ahead = 0 and behind = 0 shows no segment.

    @guarantee BehindIsAWarning
        -- Any behind > 0 is styled as a warning: that is the direction that
        -- will bite the next rebase.

    @guarantee AheadOnlyIsNeutral
        -- behind = 0 with ahead > 0 is styled neutrally. It is the normal state
        -- immediately after every rebase wrap-up, so the segment is lit much of
        -- the time. That is the design working — it clears when [o] is pressed
        -- — but "hidden when clean" buys less quiet than it sounds.

    @guarantee NoStalenessBeyondTheLastMeasurement
        -- The segment shows the most recent successful measurement. A failed
        -- fetch leaves the previous counts in place rather than blanking the
        -- segment; the failure itself is reported through the CLI, not here.

    @guidance
        -- Rendered as a compact `main ↑3↓1`-style segment beside the existing
        -- status-bar badges. selected_task() is the board's current selection;
        -- it yields nothing when the cursor is not on a task.
        --
        -- A multi-repo repos popup was considered and deferred until the engine
        -- is proven; `dispatch repo status` covers that need in the meantime.
}

surface RepoSyncConfirmation {
    facing user: User

    context state: RepoSyncState

    -- The maximum display width, in characters, allotted to the repository path
    -- inside the prompt.
    let path_display_budget = 40

    exposes:
        state.repo_path
        state.base_branch
        state.counts

    provides:
        ConfirmRepoSync(user, state)
            when state.has_drift
        DismissRepoSync(user)

    @guarantee PromptStatesExactlyWhatWillHappen
        -- The prompt names the operations that will actually run against
        -- origin, with their commit counts, and no others. Diverged: both the
        -- merge and the push. behind = 0: the push alone. ahead = 0: the merge
        -- alone. A half that will not run is not mentioned.

    @guarantee PromptNamesTheRepository
        -- The prompt identifies the repository whose base branch is about to be
        -- written to, not only the branch, so two repositories sitting on the
        -- same branch never produce the same prompt. The path is shown up to
        -- path_display_budget characters; when it does not fit it is shortened
        -- from the left, keeping the distinguishing tail and marking the elided
        -- head with an ellipsis, because the status bar has finite width and a
        -- right-truncated path loses exactly the part that tells two checkouts
        -- apart. A bare basename is explicitly not enough: two checkouts of the
        -- same repository under different parents share it.

    @guarantee NoSyncWithoutConfirmation
        -- Nothing is fetched, merged or pushed until the prompt is confirmed.
        -- Dismissing it leaves the repository untouched.

    @guarantee OutcomeAndFailureRouteDifferently
        -- A successful outcome is reported in the status bar; a failure is
        -- reported in the error popup, because every failure needs an operator
        -- decision.

    @guidance
        -- The prompt is the whole safety mechanism for the only network write
        -- dispatch performs to a shared branch, which is why the wording is a
        -- guarantee and not a styling detail. Confirming emits SyncRepo for
        -- this repository (AcceptRepoSyncPrompt).
}

surface RepoStatusCli {
    facing operator: User

    -- `dispatch repo status [--no-fetch]` — one row per saved repo path.

    let no_fetch = false

    exposes:
        for state in RepoSyncStates:
            state.repo_path
            state.base_branch
            state.is_measured
            state.counts
            state.last_fetch_error

    provides:
        CliRepoStatus(operator, no_fetch)

    @guarantee FetchesUnlessSuppressed
        -- The command fetches before measuring, so its counts are current.
        -- --no-fetch skips the fetch and reports whatever the local refs say,
        -- for use offline or in a tight loop.

    @guarantee UnmeasuredRowsShowNoCounts
        -- A repository that could not be measured shows no ahead/behind figures
        -- and, when the fetch was the cause, its fetch error instead.

    @guarantee ReadOnly
        -- The command never merges or pushes. Measuring is the whole of it.
}

surface RepoSyncCli {
    facing operator: User

    -- `dispatch repo sync [<path>]` — sync one repository or all of them.

    let target_path = null

    exposes:
        for state in RepoSyncStates:
            state.repo_path
            state.base_branch

    provides:
        CliRepoSync(operator, target_path)

    @guarantee EveryTargetAttempted
        -- With the path omitted, every saved repository is attempted. A failure
        -- on one does not abandon the others.

    @guarantee FailureIsVisibleInTheExitCode
        -- The exit code is non-zero when any target failed, and zero only when
        -- all of them succeeded or were already in sync.

    @guidance
        -- The scripted equivalent of the board's [o]. Same engine, same
        -- preconditions, same failure vocabulary — see the RepoSyncEngine
        -- contract.
}
