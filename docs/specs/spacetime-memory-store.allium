-- allium: 3
-- spacetime-memory-store.allium
--
-- Scope: The fidelity contract for MemoryReducerCaller, the native in-process
--        stand-in for a real SpacetimeDB reducer call that the test suite
--        uses in place of a live server: what it means for this stand-in to
--        "behave like the real reducers", and what a test's database handle
--        is built from.
-- Includes: the conformance obligation between MemoryReducerCaller and the
--           real reducers in spacetime/module; the handle
--           Store::open_in_memory() returns, which always has the stand-in
--           attached; and the board reads a test takes over that handle.
-- Excludes: what a reducer call means — task and epic rules live in
--           core.allium, tasks.allium and epics.allium, the request rows in
--           store-split.allium, and the identity and subscription rules a
--           real board follows in host.allium and sync.allium. This file only
--           asserts that MemoryReducerCaller reaches the outcomes those files
--           describe. The seed/restore JSON store
--           (spacetime::snapshot_target::MemoryStore in code) is a separate
--           tool with no domain semantics and is not covered here.

use "./store-split.allium" as split

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The real reducers, published from spacetime/module. What they do is
-- store-split.allium's and the domain specs'; this spec consumes the
-- obligation, it does not define it.
external entity SpacetimeModuleReducers {}

-- The calling code that reaches a reducer or opens a test database handle:
-- any cargo test target, plus this crate's own test-support builders. It has
-- no governing spec; the test suite is its own authority.
external entity TestSuite {}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- The obligation MemoryReducerCaller and the real reducers (published into a
-- throwaway SpacetimeDB instance) both have to satisfy, for every reducer the
-- board's ReducerCaller trait reaches.
contract ReducerConformance {
    apply: (call: Any) -> Any

    @invariant SameEndState
        -- Applying the same reducer call to a throwaway real SpacetimeDB
        -- instance and to MemoryReducerCaller, from the same starting rows,
        -- produces the same resulting row state. This compares two
        -- independent implementations rather than one entity's state at a
        -- point in time, so it is checked by the conformance suite
        -- (ConformanceIsCiGated), not evaluated as a structural property of
        -- this spec. "Same row state" excludes the timestamps each side takes
        -- from its own clock (a real reducer's ctx.timestamp versus
        -- MemoryReducerCaller's injected clock): whether a timestamp was
        -- stamped must agree, its value need not.

    @guidance
        -- Reuse spacetime/module's own pure, ctx-free helpers
        -- (derive_epic_status, apply_task_patch, apply_epic_patch,
        -- apply_learning_patch, stamps_completion, validate_task_ownership,
        -- validate_learning_scope, validate_status, check_task_patch,
        -- check_epic_patch, validate_sub_status, blank_*) rather than
        -- re-deriving their logic natively in MemoryReducerCaller. The
        -- module crate is built with crate-type = ["cdylib", "rlib"]
        -- specifically so these are callable outside a SpacetimeDB instance.
        -- A rule too entangled with row access to be a pure function is
        -- written once, generic over a store trait, and the double supplies
        -- the row operations: feed ingestion (ingest_into over IngestStore)
        -- is one. Everything else per reducer — row storage, lookup, delete
        -- cascades, id generation, orchestration order — has no shared source
        -- and is exactly the risk surface this contract exists to catch drift
        -- in.
        --
        -- MemoryReducerCaller lives at src/sync/memory_caller/, beside the
        -- production adapter (src/sync/sdk_connector/callers.rs) that
        -- implements the same ReducerCaller trait against a real server. It
        -- never runs inside SpacetimeDB and never uses a ReducerContext: it is
        -- an independent reimplementation, not the module code relocated. A
        -- data rule changed in the module is mirrored there in the same change
        -- (CLAUDE.md, "Store Layering").
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- The handle Store::open_in_memory() returns to a test. Whether a shared
-- store is attached is the one fact this spec adds to it; everything else
-- about it belongs to storage.allium.
entity TestDatabaseHandle {
    shared_store_attached: Boolean
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule OpenInMemoryAttachesTheStore {
    -- Every Store::open_in_memory() call site gets a store-backed handle,
    -- with no per-call-site change.
    when: OpenInMemoryRequested(_)

    ensures: TestDatabaseHandle.created(shared_store_attached: true)

    @guidance
        -- There is no unattached handle: a Store always holds its rows, its
        -- reducer caller, an identity, a clock, a host id and a host-file
        -- dir. The handle is built from one fresh SharedRows and one
        -- MemoryReducerCaller over it; its reads query those rows and its
        -- writes call that caller, so both see the same rows. It settles as a
        -- fixed test user and a fixed test host id, and stamps with the
        -- system clock. Each handle gets its own store; two handles never
        -- share rows.
}

rule TestBoardReadsShareTheHandlesRows {
    -- A test that needs the board's read seam uses the handle itself: the
    -- handle implements it.
    when: BoardReadsRequested(_, handle)

    requires: handle.shared_store_attached

    ensures: BoardReadsServed(over: handle)

    @guidance
        -- The seam is the same Store a production board reads through, over
        -- the very rows this handle's writes land in. A reducer call through
        -- the handle pushes its resulting rows into the same
        -- sync::rows::SharedRows a real board's Store reads, the rows a
        -- production board would receive from a subscription after the same
        -- call. So a write is visible to the board reads at once, PollOwner
        -- claims are real rather than always "unclaimed", and every
        -- downstream read and decode runs unchanged (sync.allium says what
        -- those reads mean in production). There is no SQLite-backed
        -- BoardReads.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface StandInFidelity {
    facing real_reducers: SpacetimeModuleReducers

    contracts:
        fulfils ReducerConformance

    @guarantee ConformanceIsCiGated
        -- ReducerConformance is checked in CI by one suite:
        -- tests/memory_caller_conformance.rs, with its scenarios in
        -- tests/memory_caller_conformance/. A new reducer adds its scenarios
        -- there rather than starting a new suite. The suite publishes the
        -- real module into a throwaway instance and compares
        -- MemoryReducerCaller with it through the SDK (SdkReducerCaller).
        --
        -- CI's Test and Coverage jobs install the `spacetime` CLI, pinned to
        -- the version the rest of the repo builds against, so the suite runs
        -- for real rather than taking its "not on PATH" skip — see
        -- .github/workflows/ci.yml. The install is not the only guard: when
        -- CI is set, a missing `spacetime` FAILS the suite instead of skipping
        -- it, the same rule the real-tmux suites follow, so a broken install
        -- step cannot report green with nothing run.
        --
        -- The suite stays on a live instance although the reducer tests run
        -- in-memory (spacetime/module-tests/): that crate cannot link the
        -- board crate, and moving the real side in-memory would drop the SDK
        -- half of the comparison. See docs/testing.md, "What stays live".
}

surface MemoryStoreCallSurface {
    facing caller: TestSuite

    provides:
        OpenInMemoryRequested(caller)
        BoardReadsRequested(caller, handle)
}
