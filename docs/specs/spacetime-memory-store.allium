-- allium: 3
-- spacetime-memory-store.allium
--
-- Scope: The fidelity contract for MemoryReducerCaller, the native in-process
--        stand-in for a real SpacetimeDB reducer call that the test suite
--        uses in place of a live server. What it means for this stand-in to
--        "behave like the real reducers," what happens when a caller reaches
--        a reducer whose domain is not yet covered, and the single, atomic
--        point at which the test suite's default handle actually switches to
--        using it.
-- Includes: the conformance obligation between MemoryReducerCaller and the
--           real reducers in spacetime/module; the per-domain incremental
--           build (a reducer belongs to exactly one domain, and a domain is
--           either fully implemented or not yet started — no partial
--           domains); the panic a caller gets from a not-yet-covered domain;
--           and the rule deciding when Database::open_in_memory() starts
--           attaching this stand-in instead of leaving every test handle
--           unattached, as it does today.
-- Excludes: what a reducer call actually means once its domain is covered —
--           task and epic rules live in core.allium, tasks.allium and
--           epics.allium; the identity and subscription rules a real board
--           follows live in host.allium and sync.allium. This file only
--           asserts that MemoryReducerCaller reaches the outcomes those
--           files already describe. The SQLite LocalStore/JournalMode model
--           (see storage.allium, retiring once every domain here lands) and
--           the seed/restore JSON store (spacetime::store::MemoryStore in
--           code) are unrelated, orthogonal tools with no domain semantics
--           of their own and are untouched by this file.
-- Dependencies: ReducerDomain's members correspond to the shared tables and
--               mutation groups core.allium, epics.allium, host.allium,
--               settings.allium, learnings.allium and task-watchers.allium
--               already define.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The real reducers, governed by spacetime/module's own build and schema —
-- this spec consumes the obligation, it does not define what they do.
external entity SpacetimeModuleReducers {}

-- The calling code that reaches a reducer or opens a test database handle:
-- any cargo test target, plus this crate's own test-support builders.
-- Governed by the test suite, not this spec.
external entity TestSuite {}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- The obligation MemoryReducerCaller and the real reducers (published into a
-- throwaway SpacetimeDB instance) both have to satisfy for a domain to count
-- as covered.
contract ReducerConformance {
    apply: (domain: ReducerDomain, call: Any) -> Any

    @invariant SameEndState
        -- Applying the same reducer call to a throwaway real SpacetimeDB
        -- instance and to MemoryReducerCaller, from the same starting rows,
        -- produces the same resulting row state — for every domain currently
        -- in a store's covered_domains. This compares the behaviour of two
        -- independent implementations rather than one entity's state at a
        -- single point in time, so it is checked by the conformance test
        -- suite this contract's surface names, not evaluated as a structural
        -- property of this spec. "Same row state" excludes the timestamps
        -- each side takes from its own clock (a real reducer's ctx.timestamp
        -- versus MemoryReducerCaller's injected clock): whether a timestamp
        -- was stamped must agree, its value need not.

    @guidance
        -- Reuse spacetime/module's own pure, ctx-free helpers
        -- (derive_epic_status, apply_task_patch, apply_epic_patch,
        -- apply_learning_patch, stamps_completion, validate_task_ownership,
        -- validate_learning_scope, blank_*) rather than
        -- re-deriving their logic natively in MemoryReducerCaller. The
        -- module crate is built with crate-type = ["cdylib", "rlib"]
        -- specifically so these are callable outside a SpacetimeDB instance.
        -- Everything else per reducer — row storage, lookup, delete
        -- cascades, id generation, orchestration order — has no such shared
        -- source and is exactly the risk surface this contract exists to
        -- catch drift in.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- One entry per work package this build is split into. A reducer belongs to
-- exactly one domain; ReducerCaller's methods partition across these.
enum ReducerDomain {
    tasks_and_epics
    repo_config
    subscriptions
    settings
    learnings
    usage
    agent_state
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- The native in-process stand-in for a real SpacetimeDB reducer call. Lives
-- at src/sync/memory_caller.rs, beside the production adapter
-- (src/sync/sdk_connector.rs) that implements the same ReducerCaller trait
-- against a real server. Never runs inside SpacetimeDB and never uses a
-- ReducerContext — it is an independent reimplementation, not the module
-- code relocated.
entity MemoryReducerCaller {
    covered_domains: Set<ReducerDomain>

    -- True once every domain has landed. Compared against
    -- config.total_domains, an explicit count of ReducerDomain's members
    -- (see that config value for why it is a literal). A future domain added
    -- to ReducerDomain must raise total_domains in the same change, or an
    -- already-"complete" store would read as complete without covering the
    -- new one; this spec does not derive that the two stay in step — it is a
    -- review obligation from this file's own point of view. The Rust
    -- implementation happens to go further than this spec requires: its
    -- enum and its ALL/TOTAL_DOMAINS are generated from one macro invocation
    -- (reducer_domains! in src/sync/memory_caller.rs) naming each domain
    -- exactly once, so there is no second, independently-maintained list for
    -- the two to drift apart from — not (as an earlier draft of this
    -- comment claimed) a match that is merely exhaustive over the enum type,
    -- which forces handling a new variant but not listing it anywhere in
    -- particular. That hardening is this file's obligation being met by
    -- construction in one implementation, not a guarantee this spec itself
    -- makes — a different implementation could satisfy this same rule with
    -- a bare literal and a code-review habit.
    is_complete: covered_domains.count = config.total_domains

    @invariant CoverageOnlyGrows
        -- covered_domains gains a domain as each work package lands and
        -- never loses one. This compares this entity's state across time
        -- rather than at a single point, so it is not expressible as a
        -- structural invariant here — it is what each work package's own
        -- review has to check by hand.
}

-- The handle Database::open_in_memory() returns to a test. Whether a shared
-- store is attached is the one fact this spec adds to it; everything else
-- about it belongs to storage.allium.
entity TestDatabaseHandle {
    shared_store_attached: Boolean
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- The number of ReducerDomain members. Kept as an explicit count rather
    -- than an expression over the enum so MemoryReducerCaller.is_complete
    -- reads as a comparison against a known target, not a tautology.
    total_domains: Integer = 7
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

-- The one MemoryReducerCaller this build has. Its covered_domains is the
-- build's current progress: each landed work package extends this list by
-- editing this declaration, rather than the spec describing coverage growth
-- as a rule-driven event nothing outside this file would ever raise.
--
-- Which work package owns each domain (all under epic #325, SpacetimeDB).
-- This is also the owner ReducerCallOnUncoveredDomainPanics names:
--   tasks_and_epics, repo_config, subscriptions  -> task #4975 (this slice)
--   settings     -> task #5002: save_setting, clear_setting (filter presets
--                   are written only by seeding, which is not a
--                   ReducerCaller method, so this domain has no preset
--                   reducer to cover)
--   learnings    -> task #5003 (landed): create_learning, patch_learning,
--                   delete_learning, rescope_epic_learnings,
--                   record_learning_retrieval, apply_learning_verdicts,
--                   archive_stale_learnings, plus reproducing the
--                   task-delete cascade onto learnings and
--                   learning_retrievals natively
--   usage, agent_state -> task #5004 (landed): record_usage_event and its
--                   prune; the subagent lifecycle and the other agent-hook
--                   writes (stop recording, pre-tool-use, notification,
--                   user-prompt-submit, the PR-learnings gate stamp,
--                   batched sub-status); watchers; feed upsert, stale
--                   feed-task deletion and the two feed-managed epic
--                   creates (repo-group sub-epic, managed role epic);
--                   phoenix respawn; poll ownership; host registration;
--                   plus reproducing the task-delete cascade onto watchers
--                   and agent-session state (both delete_task and the
--                   epic-subtree delete), and the feed-retirement cascade
--                   (retire_task_if_feed_backed / retired_feed_items) that
--                   delete_task/delete_epic/batch_delete owe now that this
--                   store models that table.
--
-- MemoryReducerCaller's delete_task and delete_epic now reproduce the
-- learnings half of the module's cascade too (detaching/cascading learnings
-- and learning_retrievals) — #5003 landed it natively, matching
-- detach_learnings_from_task rather than a SQLite ON DELETE clause.
-- Order: #5002 and #5003 each depend only on #4975 and may land in either
-- order. Whichever of #5002/#5003 lands last is what makes the_store.is_complete
-- true, and so what flips OpenInMemoryAttachesStoreOnceComplete and performs
-- the ~342-call-site cutover — #5004 landed first among the three, #5003
-- second, and leaves both of those to whichever of #5002/#5003 lands last,
-- per is_complete's derivation below.
default MemoryReducerCaller the_store = {
    covered_domains: { tasks_and_epics, repo_config, subscriptions, learnings, usage, agent_state }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ReducerCallReachesSharedRows {
    -- A caller invokes a reducer whose domain this store already covers.
    when: ReducerCalled(_, domain)

    requires: domain in the_store.covered_domains

    ensures: SharedRowsUpdated(domain: domain)

    @guidance
        -- The resulting rows are the same ones a production board would
        -- receive from a subscription after the same reducer call, pushed
        -- into the same sync::rows::SharedRows a real board's
        -- SubscriptionBoardReads wraps. This is what lets every downstream
        -- read (SharedReader, SharedLearningReader, SharedUsageReader,
        -- decode) run unchanged against this store — see sync.allium for
        -- what those reads mean in production.
}

rule ReducerCallOnUncoveredDomainPanics {
    -- A caller invokes a reducer whose domain no work package has landed
    -- yet. Deliberate and temporary: true across every work package until
    -- the last one lands, not a defect in any one of them.
    when: ReducerCalled(_, domain)

    requires: domain not in the_store.covered_domains

    ensures: ReducerCallPanicked(domain: domain)

    @guidance
        -- The panic message names the domain and the work package that owns
        -- it, so a test failure during this build points at what to build
        -- next rather than reading as an unexplained crash.
}

rule OpenInMemoryAttachesStoreOnceComplete {
    -- The one, atomic point at which every existing Database::open_in_memory()
    -- call site starts getting a store-backed handle, with no per-call-site
    -- change: this rule's condition, not a rolling default, decides it.
    when: OpenInMemoryRequested(_)

    ensures:
        if the_store.is_complete:
            TestDatabaseHandle.created(shared_store_attached: true)
        else:
            TestDatabaseHandle.created(shared_store_attached: false)

    @guidance
        -- Before the_store is complete, this is exactly today's behaviour:
        -- every handle is unattached and every existing test keeps
        -- exercising SQLite. Nothing before the final work package changes
        -- what this rule produces.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface StandInFidelity {
    facing real_reducers: SpacetimeModuleReducers

    contracts:
        fulfils ReducerConformance

    @guarantee ConformanceIsCiGated
        -- ReducerConformance is checked by an automated suite from the first
        -- work package landed onward, in CI, not deferred until every domain
        -- is covered. Each later work package adds its own scenarios to that
        -- same suite rather than starting a new one, mirroring the shape
        -- tests/spacetime_module.rs and src/spacetime/tests/module_schema.rs
        -- already use to diff the real module against SQLite. CI installs
        -- the `spacetime` CLI (pinned to the version the rest of the repo
        -- builds against) specifically so this suite runs for real rather
        -- than taking its "not on PATH" skip — see .github/workflows/ci.yml's
        -- Test job. Deliberately not installed on the Coverage job's runner:
        -- tarpaulin's instrumentation breaks the `spacetime publish` these
        -- tests shell out to (task #4909), so that job keeps taking the skip.
}

surface MemoryStoreCallSurface {
    facing caller: TestSuite

    provides:
        OpenInMemoryRequested(caller)
        ReducerCalled(caller, domain)
}
