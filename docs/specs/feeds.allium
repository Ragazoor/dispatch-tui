-- allium: 3
-- feeds.allium
--
-- Scope: Programmable feed epics — generic mechanism for surfacing external
--        items (PRs, security alerts, anything emitting JSON) as tasks under
--        an Epic.
--        WHERE it runs: the TUI process runs the feed script and posts the
--        raw parsed items (IngestFeedEmission); the SpacetimeDB module
--        applies every rule below that decides what the items do to the
--        store (store-split.allium, M3).
-- Includes: FeedItem schema, upsert semantics, status preservation, polling
--           cadence, error handling, the verify-feed
--           validator CLI, the role-routed reconcile path that splits a
--           single PR-review emission across My/Team/Bots sub-epics, and the
--           append-only mode for sources that emit events rather than
--           mirroring state (AppendOnlyFeed).
-- Excludes: Specific feed scripts — the shipped reference templates under
--           `scripts/`, what each queries, which config files it reads and
--           which Signals it emits, are specified in feed-scripts.allium.
--           The GENERIC feed runtime (flat upsert + group_by_repo) never
--           embeds upstream-specific knowledge — those scripts are
--           user-owned executables. The legacy Review Board and Security
--           Board UIs remain removed; their behaviour is subsumed by feed
--           epics.
--
-- DELIBERATE EXCEPTION — the role-routed path. The reviews_parent reconcile
-- (RoleRoutedFeedSync below, driven by the RouteSignals contract) is the ONE
-- place where PR-routing policy lives inside the runtime rather than in a
-- user script. This departs, on purpose, from the dumb-runtime principle so
-- the my/team/bot split is centralised, testable and leak-free. The exception
-- is contained: it fires ONLY for an epic whose core/Epic.feed_role =
-- reviews_parent; every other feed epic keeps the upstream-agnostic
-- flat/group_by_repo behaviour untouched. Rationale and the considered-and-
-- rejected minimal alternative are recorded in
-- docs/superpowers/specs/2026-06-15-pr-review-feed-routing-design.md.

use "./core.allium" as core
use "./store-split.allium" as split
use "./cli.allium" as cli
use "./startup.allium" as startup

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A FeedItem is the wire format that a feed_command emits. The runner
-- spawns the command, parses stdout as a JSON array of FeedItem, and
-- upserts each item as a Task under the owning Epic.
--
-- The command is responsible for whatever upstream fetching is needed
-- (e.g. calling `gh api`, scraping a dashboard). The dispatch runtime is
-- only responsible for invocation, parsing, and persistence.

value FeedItem {
    external_id: String       -- stable, unique-per-feed identifier (e.g. "pr:acme/app#42")
    title: String
    description: String
    url: String = ""          -- optional external URL; empty string when absent.
                              -- When the URL points to a known GitHub repo whose
                              -- local clone is registered in the dispatch repo
                              -- list, the runner uses it to resolve a repo_path
                              -- for the inserted Task. See UpsertFeedTasks.
    url_type: core/UrlType?   -- optional explicit type for `url`. When set, the
                              -- inserted Task's url_type is taken verbatim from
                              -- this field; when absent, the type is inferred
                              -- from the URL string (see UpsertFeedTasks).
                              -- Lets a feed declare types inference cannot
                              -- reach — e.g. the security feed declaring
                              -- security_alert for Dependabot alert URLs that
                              -- would otherwise classify as other. Defaults to
                              -- absent when the script omits the field,
                              -- preserving wire compatibility with scripts
                              -- written before this field existed. Ignored
                              -- when url is empty (there is no URL to type).
    status: core/TaskStatus   -- desired column for newly-inserted tasks
    tag: core/TaskTag         -- required: drives DispatchMode for the inserted
                              -- Task. Feed scripts must set this so dispatch
                              -- routes the task to the correct agent (e.g.
                              -- pr_review for Dependabot PRs, fix for
                              -- security alerts). Missing or unknown tag
                              -- causes parse failure in verify-feed and the
                              -- FeedRunner.
                              --
                              -- A REVIEW tag (core/TaskTag.is_review — today
                              -- dependabot, pr_review and release_please)
                              -- additionally
                              -- REQUIRES `url` to name a pull request: see
                              -- the FeedItemParse contract's
                              -- AReviewTaggedFeedItemNamesItsPr. Nothing else
                              -- constrains the pair.
    labels: List<String> = [] -- optional free-form labels copied to Task.labels
                              -- on insert and re-applied on every conflict update.
                              -- Ordered: the JSON array order is preserved through
                              -- to badge rendering order on the card
                              -- (feed-controlled, not user-editable). Defaults
                              -- to the empty list when the script omits the field,
                              -- preserving wire compatibility with scripts
                              -- written before this field existed.
    sort_order: Integer?      -- optional ordering hint copied to Task.sort_order;
                              -- a column sorts lower values first, and a task
                              -- without one by its id. Used by the CVE feed to surface CRITICAL
                              -- alerts above HIGH/MEDIUM/LOW (1=CRITICAL, 2=HIGH,
                              -- 3=MEDIUM, 4=LOW). Optional; omission leaves
                              -- Task.sort_order unchanged.
    wrap_up_mode: core/WrapUpMode? -- optional; sets the inserted Task's
                              -- wrap_up_mode. Applied on INSERT only: on a
                              -- conflict (re-poll of the same external_id) the
                              -- existing Task's wrap_up_mode is preserved, like
                              -- status/sub_status/repo_path, so a user's manual
                              -- change survives feed refreshes — as long as the
                              -- item remains present in every emission (an item
                              -- that drops out and later reappears is deleted
                              -- and reinserted, taking the feed value again;
                              -- same tradeoff as status/repo_path). Absent
                              -- leaves the Task's wrap_up_mode null (decide at
                              -- wrap-up time). Used by the CVE-alert feed
                              -- scripts (fetch-cve.sh, fetch-security.sh) to
                              -- default fix tasks to pr so wrap-up goes
                              -- straight to a PR — a CVE-shaped item defaults
                              -- to pr whichever of the two emits it, except a
                              -- fetch-cve.sh item linked to an existing fix PR,
                              -- which defaults to done — and by fetch-log-warnings.sh
                              -- to default its triage cards to rebase. Why each
                              -- script picks the path it does is in
                              -- feed-scripts.allium, not here.
                              -- Defaults to absent when the
                              -- script omits the field, preserving wire
                              -- compatibility with scripts written before
                              -- this field existed.
    signals: Set<Signal> = {} -- optional routing signals a feed script attaches
                              -- to this item; routed into the right feed bucket
                              -- by the RouteSignals contract. Defaults to the
                              -- empty set when the script omits the field,
                              -- preserving wire compatibility with scripts
                              -- written before this field existed.
                              --
                              -- UNRECOGNISED signal values are DROPPED with a
                              -- warning rather than failing the whole item. This
                              -- is a deliberate, scoped exception to the
                              -- otherwise strict feed-JSON parse-failure rule
                              -- (and to the Storage Boundary Validation rule in
                              -- core.allium): a newer feed script's signal value
                              -- must not break ingest on an older dispatch
                              -- binary. This contrasts with `tag`, where an
                              -- unknown value DOES cause parse failure, because
                              -- tag drives dispatch routing and a silent drop
                              -- there would mis-route the task.
                              --
                              -- BOTH halves of that contrast -- lenient signals
                              -- and strict tag -- are properties of the FeedItem
                              -- decode itself, not of any one caller, so they
                              -- apply UNIFORMLY to all three feed entry points
                              -- (auto-poll, manual "r", verify-feed). No caller
                              -- can opt out of either, and none can drift from
                              -- the others on this. Where the drop WARNING lands
                              -- does differ by entry point: the two runtime paths
                              -- log it to app.log, while verify-feed surfaces it
                              -- on stderr (VerifyFeed).
}

-- One line's worth of what applying the feed_scripts artefact did to one
-- dispatch-owned feed script. Carries the FULL path, not the bare name, because the only outcome
-- a user has to act on (kept) is actionable only if they can find the file.
value ShippedScriptReport {
    name: String                        -- the shipped file name, e.g. "fetch-cve.sh"
    path: String                        -- absolute path under <data_dir>/scripts/
    outcome: ShippedScriptOutcome
    backup_path: String?                -- set iff the overwrite was preceded by a
                                        -- .bak copy, i.e. only on the approved
                                        -- unknown-provenance branch. Named in the
                                        -- report so the user can restore. A
                                        -- single path, not a list: the backup
                                        -- always REPLACES any existing .bak (see
                                        -- InstallShippedFeedScripts branch 4).
    error: String?                      -- set iff outcome = failed, carrying the
                                        -- underlying error text (permission
                                        -- denied, disk full). Non-null exactly
                                        -- when the outcome is failed: every other
                                        -- outcome is a success and has nothing to
                                        -- report, and a failure with no error
                                        -- text is a line the user cannot act on.
}

-- What one run of a feed command left behind (FeedCommandExec). `error` is
-- set when the run failed before any output could be trusted:
-- FeedCommandFailure's buckets 1, 2, 7 and 8. Otherwise the command exited 0
-- and `stdout` is all it wrote. allium check reports it unused: a bare
-- contract return type is not credited (juxt/allium-tools#106).
value FeedCommandRun {
    stdout: String
    stderr: String      -- the significant stderr: notice lines dropped
                        -- (FeedCommandStderrOnSuccess, "THE ONE EXEMPTION"),
                        -- then trimmed and cut to config.feed_stderr_cap
                        -- characters, in that order, so a long run of notices
                        -- cannot push a real error past the cut. "" when the
                        -- command wrote nothing else to stderr
    error: String?      -- spawn error, non-zero exit (naming the status),
                        -- timeout, or output over config.feed_output_cap_bytes
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- RouteSignals is the pure routing function that maps a PR item's signals to
-- the FeedRole sub-epic it belongs in. It is PURE (no async, no DB, no I/O) and
-- TOTAL: every input, including the empty signal set, maps to exactly one of
-- my_reviews, team_reviews or bots. It NEVER returns none, reviews_parent or
-- cve — those roles exist for structural epic placement (see core/FeedRole),
-- not as routing outcomes. The precedence is stated once, in the Precedence
-- invariant below. Two of its choices need a reason:
--
--   - Engagement wins over the bot rule: a bot-authored PR I have reviewed
--     still lands in my reviews. "Engagement" excludes my OWN activity — a
--     comment I made on my own PR (author_me) is not engagement.
--   - org_review (an org-scoped review-requested/reviewed-by/commenter match,
--     outside the repos.conf repo list) counts as a direct review request. It
--     still loses to the bot rule, so an org-scoped bot PR routes to bots
--     unless it is also reviewed or commented.
--
-- Routing never fails; an unmatched item defaults to my_reviews. Logging a
-- warning for the empty or unmatched case is the caller's job, not this
-- function's.

contract RouteSignals {
    route: (signals: Set<Signal>) -> core/FeedRole

    @invariant Total
        -- route is defined for every possible signal set, including the empty
        -- set; there is no input for which it has no result.

    @invariant RangeRestricted
        -- route's result is always one of my_reviews, team_reviews or bots.
        -- It never yields none, reviews_parent or cve.

    @invariant Pure
        -- route depends only on its signals argument. No I/O, no DB access, no
        -- async, no observation of clock or external state. Same input always
        -- yields the same output.

    @invariant Precedence
        -- First match wins in the order: engaged (reviewed or commented, and
        -- not author_me) -> my_reviews; then author_bot -> bots; then
        -- direct_request or org_review -> my_reviews; then team_request ->
        -- team_reviews; then the empty/unmatched fallback -> my_reviews.
        -- Engagement is evaluated before the bot rule, so a reviewed bot PR
        -- routes to my_reviews rather than bots.

    @guidance
        -- Implementation: spacetime/module/src/rules.rs::route_signals, run by
        -- the module's ingest_feed (store-split M3). Coverage: the module's
        -- own tests (spacetime/module/src/tests.rs).
}

-- ExcludeFromReviews is the pure predicate that decides whether a PR item
-- reaches the review subtree AT ALL. It runs BEFORE RouteSignals: an excluded
-- item is never routed, never inserted, and never enters the reconcile's
-- keep-set, so an existing task for it is deleted by the same stale pass that
-- removes a merged PR.
--
-- TWO INDEPENDENT EXCLUSION RULES, either of which is enough on its own:
--
--   1. OWN-AUTHORED — author_me is in signals.
--   2. SETTLED APPROVAL — approved is in signals and neither direct_request
--      nor team_request is.
--
-- == Rule 1: own-authored ==
--
-- A PR the user wrote is not review work for the user. Such PRs did reach
-- my_reviews in practice — the involvement qualifiers are not all
-- self-exclusive (only `commenter:@me -author:@me` spells the exclusion out),
-- and route's fallback sends an otherwise-unmatched item to my_reviews. Which
-- qualifier let a given own-authored PR in does not matter here: the item
-- arrives carrying author_me either way, and that is what this contract acts
-- on.
--
-- The exclusion is UNCONDITIONAL — it is not "drop from my_reviews only". An
-- own-authored PR that also carries team_request or author_bot is dropped too,
-- because the user authoring it is what makes it not review work, regardless
-- of who else was asked. Nothing rescues an author_me item — not a pending
-- review request, and not the approval rescue of rule 2.
--
-- == Rule 2: settled approval ==
--
-- The user has already approved the PR and nobody has asked them to look
-- again. There is no review work left to do, so the card must not appear at
-- all — not in my_reviews, and not in team_reviews or bots either. This
-- mirrors rule 1's shape deliberately: the question "is this review work for
-- me" is answered once, before routing, rather than separately per sub-epic.
--
-- WHAT "APPROVED" MEANS. The approved signal states one fact about the PR as
-- it stands now: the user's LATEST OPINIONATED review on it is an approval.
-- An opinionated review is one that approves or requests changes; a plain
-- comment is not one and does not displace an earlier approval. So a user who
-- approves and then comments is still approved; a user who approves and then
-- requests changes is NOT, and the PR stays visible. A dismissed approval is
-- likewise not an approval.
--
-- NEW COMMITS DO NOT BRING IT BACK. An author pushing after the approval
-- leaves the approval standing, so the item stays excluded. Only an explicit
-- re-request does — which is exactly what rule 2's two rescuing signals
-- carry. This is the decided behaviour, not an accident of the mechanism: the
-- alternative (comparing commit timestamps against review timestamps) was
-- considered and rejected as more machinery for a case the user does not
-- treat as review work.
--
-- WHY THE RESCUE IS THE REQUEST SIGNALS AND NOT A FETCHED REVIEWER LIST.
-- "A review is pending from me" is already a fact the feed produces:
-- direct_request when the request names the user personally, team_request
-- when it names one of the teams the user lists in teams.conf. Between them
-- they cover both shapes a re-request can take, so nothing else is needed.
--
-- REJECTED — a third rescuing signal read from the PR's own pending-reviewer
-- list. Its one genuine use would be an org-wide re-request, and that is
-- served where the signal is produced: the org-scoped pass keeps its
-- personal-request qualifier as its own signal rather than folding it into
-- org_review (feed-scripts.allium: "The org-scoped personal-request qualifier
-- keeps its own signal"). Re-deriving the fact here would buy a second
-- source, a bounded list scan and a truncation failure mode.
--
-- == Limit of the mechanism ==
--
-- Every exclusion here is only as good as its signal, and every signal is
-- derived by the SCRIPT. author_me comes from comparing each PR author login
-- against the authenticated user's; approved comes from the PR's own review
-- state. Both derivations soft-fail rather than failing the feed, so a
-- transient failure emits the signal on no item that cycle and the affected
-- PRs surface until the next successful poll. This is accepted: degrading a
-- signal is strictly better than dropping the whole emission, and each
-- exclusion is self-healing on the following cycle.
--
-- The failure direction is the point. A missing approved signal shows a
-- settled PR again; a missing rescuing signal also shows a PR. Both err toward
-- VISIBLE. No soft failure can hide review work that is genuinely
-- outstanding.
--
-- WHY IN THE RUNTIME AND NOT IN THE SCRIPT. Adding `-author:@me` to the
-- review qualifiers in scripts/fetch-reviews.sh — or filtering approved PRs
-- out there — would exclude the same PRs, and is deliberately NOT the chosen
-- mechanism. Feed scripts are USER-OWNED: the shipped script is a template
-- the user copies to scripts/local/ and edits, so a fix to the template does
-- not reach the copy that actually runs. The runtime is the one place the
-- exclusion holds for every existing deployment and for any other script that
-- emits these signals. Note what this does NOT cover: a signal the script
-- fails to produce cannot be fixed here either, which is why the org-scoped
-- collapse above had to be fixed in the script. This is the same reasoning as the DELIBERATE EXCEPTION
-- in Scope: PR-routing policy for the reviews_parent path lives in the
-- runtime so it is centralised and leak-free. The script's job is to state
-- facts about each PR; deciding what those facts mean is this contract's.
--
-- Consequence for RouteSignals: rule 1's `and not author_me` guard is
-- UNREACHABLE from the role-routed path — no author_me item survives to be
-- routed. The guard is retained rather than removed: route is a total pure
-- function over the whole Signal set (its Total invariant), so it must stay
-- defined and correct for an input this caller happens never to hand it. The
-- same holds for approved, which route ignores entirely.

contract ExcludeFromReviews {
    excluded: (signals: Set<Signal>) -> Boolean

    @invariant Total
        -- excluded is defined for every possible signal set, including the
        -- empty set (which is not excluded).

    @invariant Pure
        -- excluded depends only on its signals argument. No I/O, no DB
        -- access, no async, no observation of clock or external state.

    @invariant OwnAuthoredExcluded
        -- author_me in signals excludes, unconditionally. No combination of
        -- other signals rescues an author_me item.

    @invariant SettledApprovalExcluded
        -- approved in signals excludes exactly when neither direct_request
        -- nor team_request is also in signals. Either of those two rescues
        -- the item; author_bot, reviewed, commented and org_review do not.

    @invariant NoOtherExclusion
        -- These are the only two rules. A signal set containing neither
        -- author_me nor approved is never excluded.

    @invariant PrecedesRouting
        -- excluded is evaluated before route. An excluded item is never
        -- passed to route, so no routing outcome can contradict it.

    @guidance
        -- Implementation: spacetime/module/src/rules.rs::excluded_from_reviews,
        -- applied in spacetime/module/src/feed_ingest.rs::ingest_role_routed
        -- before it routes. Coverage: the module's own tests
        -- (spacetime/module/src/tests.rs) for the predicate,
        -- src/feed/ingest/tests.rs for the reconcile behaviour.
}

-- The JSON decode of a feed command's stdout into FeedItems lives in ONE
-- shared function, called by ALL THREE feed entry points: the shared feed
-- cycle (src/feed/cycle.rs::FeedCycle::run, which serves both the auto-poll
-- job and the manual "r" refresh) and the verify-feed CLI
-- (src/main.rs::cmd_verify_feed). N call sites would be N places a change to
-- the wire format could land in one path and not the others.
--
-- The cross-field rule is checked here rather than in FeedItem's own decode
-- because serde's field attributes cannot see a sibling field: a cross-field
-- rule there would need a shadow struct duplicating every field. The single
-- decode point is just as uniform for everything that arrives over the wire.
--
-- WHAT IT DOES NOT COVER, deliberately: the rule guards the DECODE, not the
-- STORAGE boundary. The module's upsert does not re-validate, so a FeedItem
-- built as a struct literal reaches the store unchecked. No production path
-- does that — the only decoders are FeedCycle::run and cmd_verify_feed, both
-- through this function, and nothing outside tests constructs the struct.
-- A second enforcement point in the module would put a mid-transaction
-- failure on a path with no unguarded producer, so the boundary stays where
-- the wire is. A test fixture that could not have come off the wire is fixed
-- rather than exempted.
--
-- WHY THE RULE EXISTS. Both shipped producers satisfy it by construction:
-- each emits `url` straight from `gh`, which is always a /pull/ URL, and
-- core/UrlType.infer types anything containing /pull/ as pr. So the rule costs
-- nothing and pins what the dependabot runbook is entitled to assume — that a
-- FEED-created review task names a PR the feed's own author filter already
-- passed (dispatch-prompt.allium: AReviewRunbookCarriesOnlyTheBranchThatApplies).
--
-- BLAST RADIUS, ACCEPTED. fetch-reviews.sh emits ONE array for the whole
-- review board, so a single non-conforming item empties the board for that
-- cycle rather than costing one card. That is the trade the strict `tag` rule
-- already makes, for the same reason: a missing card is the failure mode that
-- goes unnoticed.
--
-- The CALLER SETS differ between the shared layers: the parse is shared by all
-- three entry points; the bounded spawn (src/feed/exec.rs::run_feed_command_bounded:
-- `sh -c` in its own process group, the timeout, the output cap) is shared by
-- all three too; the logging wrapper around it
-- (src/feed/exec.rs::exec_feed_command) only by the two runtime ones, because
-- verify-feed has no epic and wants terminal output rather than app.log
-- (FeedCommandStderrOnSuccess).
-- The module's ingest_feed is the single role dispatcher (IngestFeedEmission, under
-- Rules).

contract FeedItemParse {
    parse_feed_items: (stdout: String) -> List<FeedItem>

    @invariant OneDecodeForEveryEntryPoint
        -- The auto-poll job, the manual "r" refresh and verify-feed all decode
        -- through parse_feed_items. None has a decode of its own.

    @invariant DecodeRulesBelongToTheItem
        -- Strict `tag` and `url_type` rejection and lenient `signals` dropping
        -- are properties of FeedItem's decode, not of any caller, so every
        -- caller gets them identically and none can opt out.

    @invariant AReviewTaggedFeedItemNamesItsPr
        -- The one CROSS-FIELD rule, and the one thing parse_feed_items checks
        -- itself. An item whose `tag` satisfies core/TaskTag.is_review must
        -- carry a `url` whose RESOLVED type is pr: its explicit `url_type`
        -- when it declares one, else the type inferred from the URL string. Anything else — an empty url, or one
        -- that types as issue, security_alert or other — REJECTS THE WHOLE
        -- EMISSION, exactly like an unknown `tag`, and for the same reason:
        -- both are producer bugs a silent drop would hide.

    @invariant PresentationIsNotShared
        -- Only the decode is common. The manual path renders a parse failure
        -- as a status-bar string; verify-feed prints the message plus the
        -- first config.verify_feed_preview_chars characters of the stdout.

    @guidance
        -- Implementation: src/feed/parse.rs::parse_feed_items, re-exported
        -- from src/feed/mod.rs. The lenient half of the item decode is
        -- src/models/tasks.rs::deserialize_lenient_signals.
}

-- The host's process runner for a feed command: the operating system runs
-- it under `sh -c` with the board's environment, so it reaches the
-- operator's gh credentials. RunFeedCommand is its one caller inside a
-- cycle; verify-feed (VerifyFeed) calls the same bounded run outside one.
contract FeedCommandExec {
    run_feed_command: (command: String) -> FeedCommandRun

    @invariant BoundedByTheTimeout
        -- A run ends by core/config.feed_command_timeout. At the deadline, or
        -- on stdout or stderr over config.feed_output_cap_bytes, the whole
        -- process group is killed and reaped, so a pipeline such as
        -- `gh | jq` dies with its shell (SerialisedFeedCycle, bounded cost).

    @invariant EndsWhenTheShellExits
        -- The run ends when the shell exits, not when its pipes reach EOF:
        -- what is buffered is read for a short grace, then the group is
        -- killed. A helper started with `&` that inherited stdout cannot turn
        -- a valid emission into a timeout.

    @invariant StderrIsLoggedOnSuccess
        -- A run that exits 0 with stderr logs it at warn level before the
        -- stdout is parsed (FeedCommandStderrOnSuccess).

    @guidance
        -- Implementation: src/feed/exec.rs::run_feed_command_bounded (shared
        -- with verify-feed) and its logging wrapper
        -- src/feed/exec.rs::exec_feed_command, whose FeedOutput carries
        -- stdout and the cut stderr.
}

-- The black boxes InstallShippedFeedScripts and InstallShippedFeedConfigs
-- write through, and the properties they keep. Each invariant quantifies over
-- filesystem state, which this spec has no entity for.

contract ShippedFeedScriptFiles {
    -- One report per entry of config.shipped_scripts, in that order, carrying
    -- the outcome InstallShippedFeedScripts' branches produced for it —
    -- `failed`, with the error text, for any script whose backup or write
    -- raised. It is the branch classification, surfaced for reporting; it
    -- re-derives nothing and decides nothing.
    shipped_script_reports: (data_dir: String) -> List<ShippedScriptReport>

    @invariant OneReportPerScript
        -- Every script yields exactly one report whether it succeeded or not:
        -- the loop never exits early, so a failure mid-list cannot truncate
        -- the reports for the scripts after it.

    @invariant ConfigFilesAreNeverOverwritten
        -- The apply never writes over a file that already exists at a config
        -- path under <data_dir>/scripts/. No prompt and no manifest state
        -- unlocks it: InstallShippedFeedConfigs has exactly one write branch
        -- and it is guarded on absence.

    @invariant UnknownProvenanceIsNeverSilentlyOverwritten
        -- A shipped script whose on-disk content matches NEITHER the shipped
        -- content NOR the recorded digest is overwritten only after an
        -- explicit interactive yes. When nobody can answer it is always kept.
        -- The manifest exists to make this cheap: without it every differing
        -- script would need a prompt, and a prompt the user cannot avoid is a
        -- prompt the user stops reading.

    @invariant EveryDestructiveWriteIsPrecededByABackup
        -- The one branch that can replace content dispatch did not write
        -- copies the existing file to <name><config.script_backup_suffix>
        -- BEFORE writing. The ordering is the invariant: "back up after
        -- writing" is no version of it. The backup is FALLIBLE, and the
        -- invariant survives that: if the copy raises, dispatch abandons that
        -- script — no write is attempted, the on-disk copy is left as the user
        -- had it, and the script is reported `failed`. The backup REPLACES any
        -- file already at the .bak path; that decides how many backups exist
        -- (one per script), not whether one precedes the write.

    @invariant ADeclinedOverwriteIsNotDrift
        -- The drift check (src/setup/plugins.rs::shipped_scripts_are_current)
        -- counts a script as current when its bytes and mode match what
        -- dispatch ships, OR when a recorded refusal still matches both the
        -- content on disk and the content dispatch ships. The apply then
        -- writes nothing for it either, so the two halves of startup.allium's
        -- ConfigDriftEngine keep OneDefinitionOfOutOfDate. The drift check
        -- only reads the record; it never writes it.

    @invariant FailedScriptsClaimNoProvenance
        -- A script whose backup, write or chmod raised has NO digest recorded
        -- in the manifest for that apply. Its on-disk content is unknown to
        -- dispatch, so the next apply must reach branch 4 (unknown provenance)
        -- and ask, rather than branch 3 (proven provenance), which overwrites
        -- silently. Recording a digest dispatch did not successfully write
        -- would convert a failure into future consent.

    @guidance
        -- Implementation: src/setup/plugins.rs::install_shipped_feed_scripts
        -- returns the reports; src/setup/plugins.rs::install_shipped_feed_configs
        -- writes the config files.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- Signal is a routing hint a feed script attaches to a FeedItem. Signals are
-- routed into the right feed bucket (the sub-epic whose core/FeedRole matches)
-- by the RouteSignals contract above. They carry no meaning for ingest itself
-- beyond being stored on the Task and fed to that routing function.
--
-- Two signals are not merely routing hints. author_me EXCLUDES the item from
-- the review subtree entirely, before routing runs at all. approved excludes
-- it too, unless direct_request or team_request rescues it. Both are read by
-- the ExcludeFromReviews contract above, and route ignores approved
-- completely.
--
-- approved means the user's latest OPINIONATED review on the PR (one that
-- approves or requests changes — a plain comment is neither) is an approval.
--
-- direct_request means a review is currently requested from the user
-- PERSONALLY; team_request means one is requested from a team the user
-- lists in teams.conf (feed-scripts.allium, "Team Reviews is the PRs
-- requested from the listed teams"). That distinction is why both rescue an approved PR: a
-- re-request can take either shape.
enum Signal { direct_request | team_request | reviewed | commented | author_bot | author_me | org_review | approved }

-- The outcome of reconciling ONE dispatch-owned feed script against the copy
-- on disk, when the board applies the feed_scripts artefact. Produced by
-- InstallShippedFeedScripts, consumed by ReportShippedFeedScripts. The five
-- values are exhaustive: every shipped script lands on exactly one of them on
-- every apply.
--
--   in_sync   -- the file on disk already matches what dispatch ships. No
--                content write (a wrong mode is repaired to 0755), no report
--                line.
--   installed -- nothing was at the path; the shipped content was written.
--   updated   -- the file differed from the shipped content and was
--                overwritten (silently when provenance was proven, otherwise
--                only after an explicit interactive yes, and then only after
--                a .bak copy).
--   kept      -- the file differed and provenance was unknown, and the
--                operator said no, had said no to this same pair before, or
--                nobody could answer, so dispatch left it alone. The one
--                outcome that reports a path the user may want to act on.
--   failed    -- the backup, the write, the chmod or the mode repair for this
--                script raised an error, or the overwrite question itself
--                could not be answered (stdin closed). The script is reported
--                carrying that error and the apply continues; no digest is
--                recorded. See
--                InstallShippedFeedScripts' PER-SCRIPT FAILURE section.
enum ShippedScriptOutcome { in_sync | installed | updated | kept | failed }

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- DISPATCH-OWNED scripts. Written to <data_dir>/scripts/ whenever the
    -- feed_scripts artefact is applied, executable (0755), and kept up to
    -- date thereafter (InstallShippedFeedScripts).
    --
    -- The list is the whole shipped set, not a curated subset: a user who
    -- installed dispatch from a release binary has no checkout to copy a
    -- script out of.
    shipped_scripts: List<String> = [
        "fetch-dependabot.sh",
        "fetch-reviews.sh",
        "fetch-cve.sh",
        "fetch-security.sh",
        "fetch-log-warnings.sh"
    ]

    -- USER-OWNED config files. Created if absent and never touched again
    -- (InstallShippedFeedConfigs). Not executable.
    shipped_script_configs: List<String> = [
        "repos.conf",
        "bots.conf",
        "org.conf",
        "teams.conf",
        "log-warnings.conf"
    ]

    -- Provenance manifest, written alongside the scripts it describes so a
    -- moved or copied <data_dir> carries its provenance with it.
    script_manifest_name: String = ".install-manifest.json"

    -- Suffix for the pre-overwrite copy taken on the one destructive branch.
    script_backup_suffix: String = ".bak"

    -- The operator's recorded refusals to overwrite an edited shipped script
    -- (InstallShippedFeedScripts, DECLINED), beside the manifest.
    script_declined_name: String = ".declined-overwrites.json"

    -- How often the feed runner wakes (core.allium: BoardClockTicks,
    -- FeedPollTick). Kept apart from core's config.tick_interval so the two
    -- can change independently; each epic still polls at its own resolved
    -- interval (FeedTick).
    feed_poll_interval: Duration = 2.seconds

    -- The most stderr a feed command's run writes to app.log and carries on
    -- its outcome, in characters, after trimming. A verbose script must not
    -- write unbounded output into app.log on every poll
    -- (FeedCommandStderrOnSuccess).
    feed_stderr_cap: Integer = 2000

    -- The most a feed command may write to stdout, and separately to stderr,
    -- before the run fails and its process group is killed
    -- (FeedCommandFailure bucket 8; src/feed/exec.rs::MAX_FEED_STDOUT_BYTES).
    feed_output_cap_bytes: Integer = 33554432

    -- How much of an unparseable stdout verify-feed prints after the parse
    -- error, in characters (FeedItemParse).
    verify_feed_preview_chars: Integer = 500
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Producing FeedItems ==

-- Feed scripts are user-owned executables that write a JSON array of
-- FeedItem objects to stdout, exit 0 on success, and emit any errors on
-- stderr with non-zero exit. The dispatch binary never knows about the
-- specific upstream — every feed source (PRs, security alerts, calendar
-- events, anything else) is a script the user authors or installs.
--
-- The dispatch repo ships reference templates under `scripts/`. What each one
-- queries, which config files it reads and which Signals it emits are
-- specified in feed-scripts.allium — they are user-owned scripts, not part of
-- this runtime.

-- == verify-feed CLI ==

rule VerifyFeed {
    when: cli/VerifyFeedCommand(command)

    -- The verify-feed subcommand spawns <command> via `sh -c`, captures
    -- stdout, and validates that it parses as Vec<FeedItem>. On success
    -- it prints a table of (external_id, title, tag, status) and exits 0.
    -- On failure (non-zero exit, parse failure including missing or
    -- unknown tag, running past feed_command_timeout, or writing more than
    -- config.feed_output_cap_bytes, after either of which the whole process
    -- group is killed) it prints the error to stderr and exits 1.
    --
    -- An emission that PARSES but contains ZERO items is NOT a failure: the
    -- runtime treats a clean empty emission as valid (it reconciles), so
    -- the validator must accept what the runtime accepts. It prints a
    -- warning to stderr that an empty feed may mean a misconfigured command
    -- (e.g. fetch-cve.sh with no repos configured) and exits 0.
    --
    -- An item carrying an UNRECOGNISED `signals` value is NOT a failure:
    -- the signal is dropped per the FeedItem.signals contract, the item
    -- still counts toward the valid-item total, and the exit status stays
    -- 0. The drop IS reported, on stderr. verify-feed is the one feed
    -- entry point with no app.log sink, so without this the lenient-decode
    -- warning would be written to a no-op tracing dispatcher and lost --
    -- a user debugging a typo'd signal would see only "N valid items" and
    -- no indication anything was discarded. Reporting it on stderr rather
    -- than stdout keeps the parsed-item table pipeable.
    --
    -- This is the supported way to debug a feed script before wiring it
    -- onto an epic's feed_command. It performs no DB writes.

    ensures: FeedVerified(command: command)

    @guidance
        -- Implementation: src/main.rs Commands::VerifyFeed match arm.
        -- Coverage: tests/cli.rs verify_feed_*.
        -- Spawns <command> via sh -c, parses stdout as FeedItem array via
        -- the shared src/feed/parse.rs::parse_feed_items (see the
        -- FeedItemParse contract) -- not its own serde_json call.
        -- On success: print_table(items), exit 0.
        -- On failure (non-zero exit or parse error): print_stderr, exit 1;
        -- a parse error also prints the first
        -- config.verify_feed_preview_chars characters of the stdout.
        -- cmd_verify_feed installs a stderr tracing subscriber before
        -- parsing (it is the only feed path that does not call
        -- init_app_log_subscriber), so lenient-decode warnings such as the
        -- dropped-signal warning surface on the terminal instead of being
        -- swallowed.
}

-- == Installing the shipped feed scripts ==

-- The feed_scripts artefact (startup.allium: ConfigArtefact, applied by
-- ApplyStaleConfigOnConsent) writes two CLASSES of file into
-- <data_dir>/scripts/, and they get OPPOSITE rules. The split is not arbitrary — it follows from how
-- the shipped scripts are built.
--
-- Every shipped script ships with EMPTY config placeholders (REPOS=(),
-- ORGS=(), BOT_AUTHORS=(), LOG_FILE=""); the entire edit surface a user is
-- expected to touch is the .conf files those placeholders are overridden
-- from (see feed-scripts.allium). So:
--
--   * a SCRIPT on disk is expected to stay byte-identical to what dispatch
--     shipped, which makes "differs from shipped" a meaningful signal and
--     makes updating it in place safe;
--   * a CONFIG file is expected to diverge from the shipped placeholder
--     immediately — the first thing a user does is fill it in — which makes
--     "differs from shipped" the NORMAL state and updating it pure damage.
--
-- Hence: scripts are kept up to date, configs are create-new-only forever.
--
-- REJECTED — keep everything create-new-only. A bug fixed in a shipped
-- script would then never reach a deployment that already has the script,
-- which is every deployment. The fix
-- would ship, the release notes would claim it, and the file that actually
-- runs would still be the old one. Silent, permanent, and invisible from
-- inside the running system.
--
-- REJECTED — overwrite every script unconditionally. That destroys a local
-- edit with no warning and no copy. Even though scripts are not the intended
-- edit surface, a user debugging a feed absolutely does edit one in place,
-- and dispatch cannot tell that from a stale copy without provenance.
--
-- REJECTED — prompt on every differing script. The common case after a
-- dispatch upgrade is "N untouched scripts have a newer version", and
-- prompting N times for files nobody has touched trains the user to hold
-- down `y`, which is precisely how the one prompt that MATTERS gets
-- approved without being read. The manifest exists so that case is silent.

rule InstallShippedFeedScripts {
    when: startup/ApplyFeedScriptsArtefact(data_dir, operator_can_answer)

    -- Fires from startup.allium's ApplyStaleConfigOnConsent, when the drift
    -- report named the `feed_scripts` artefact and the operator accepted it.
    -- There is no separate setup command (startup.allium:
    -- NoSeparateSetupCommand).
    --
    -- `operator_can_answer` is false when nobody is there to ask — a scripted
    -- launch, a CI job, stdin redirected from nowhere. It is phrased as a
    -- capability rather than as a flag because the decision below turns on
    -- "can I ask?", not on how the command was invoked. It is exactly
    -- `confirmer.is_some()`: the absence of someone to ask IS the input, so
    -- there is no code path that could read a queued "yes" out of silence.
    -- The one emitter passes true, since the operator has just answered the
    -- drift prompt; the false arm is this artefact's own contract, held by
    -- its tests (a None confirmer).
    --
    -- PROVENANCE MANIFEST. The apply maintains
    -- <data_dir>/scripts/<config.script_manifest_name>: a map from script
    -- file name to the digest of the content DISPATCH LAST WROTE to that
    -- path. Only scripts appear in it. Config files never do, because they
    -- are never updated, so their provenance is never consulted — recording
    -- it would create a second thing to keep in step with nothing reading it.
    --
    -- A manifest that is MISSING, UNREADABLE OR MALFORMED is treated as
    -- EMPTY and NEVER fails the apply. The manifest is an optimisation on
    -- consent: it exists to let an untouched copy be updated without asking.
    -- Losing it costs prompts, not correctness — every script simply falls to
    -- the unknown-provenance branch, which is the conservative one. An apply
    -- that refused to run because a JSON file it wrote itself was truncated
    -- would be trading the user's whole install on a cache. A manifest that
    -- cannot be WRITTEN is tolerated on the same terms and for the same
    -- reason: the cost is that the next run re-asks about every differing
    -- script, which is prompts, not correctness.
    --
    -- THE FOUR BRANCHES, in order. Exactly one fires per script:
    --
    --   1. ABSENT -> write, mark executable, record the digest. `installed`.
    --      ABSENT means NOTHING EXISTS AT THE PATH. A file that exists but
    --      cannot be read — wrong permissions, not UTF-8 — is branch 4, never
    --      branch 1: it is unknown provenance, not an empty slot, and reading
    --      "unreadable" as "absent" would overwrite it with no prompt and no
    --      backup, which is the one thing branch 4 exists to prevent.
    --   2. PRESENT AND IDENTICAL -> no content to write, but a wrong mode is
    --      repaired to 0755: right bytes behind a mode the feed runner cannot
    --      execute are not in sync with what dispatch ships, and a chmod that
    --      raised on an earlier apply leaves exactly that. A repair that
    --      raises is `failed` and records nothing. Otherwise the digest is
    --      recorded (idempotently) even though dispatch may not have written this
    --      copy: the file demonstrably IS the shipped content, so claiming
    --      provenance over it asserts nothing that is not already true, and
    --      it means the NEXT release can update it silently instead of
    --      prompting. This is how a deployment that predates the manifest
    --      heals itself on its first apply. `in_sync` — not reported.
    --   3. DIFFERS, AND THE ON-DISK DIGEST MATCHES THE RECORDED ONE ->
    --      dispatch wrote this file and nobody has touched it since; a newer
    --      version now ships. Overwrite, re-record. NO prompt, NO backup —
    --      the content being replaced is byte-for-byte a previous release's
    --      shipped content, which is recoverable from the release, and
    --      backing it up would litter every upgrade with .bak files nobody
    --      asked for. `updated`.
    --   4. DIFFERS, AND THE ON-DISK DIGEST MATCHES NO RECORDED DIGEST ->
    --      provenance is UNKNOWN. This covers both "no manifest entry at
    --      all" (pre-manifest deployment, hand-copied file) and "the user
    --      edited it". Dispatch must not overwrite on its own.
    --        - can ask: prompt, DEFAULTING TO NO, naming the file and
    --          why it is being asked about. On yes: copy to
    --          <name><config.script_backup_suffix> FIRST, then write, then
    --          record. `updated`, with the backup named in the report. On
    --          no: untouched, and the refusal is recorded (DECLINED, below).
    --          `kept`. A prompt that cannot be answered at all (stdin closed)
    --          is `failed` for this script and records nothing.
    --          The backup REPLACES any file already at the .bak path. It is
    --          a safety net for the overwrite the user just approved, not an
    --          archive, so there is only ever one of them per script.
    --          An existing .bak at this moment is reachable only if the user
    --          edited the script AGAIN after a previous approved overwrite:
    --          that overwrite left the file matching its recorded digest, so
    --          the next release takes branch 3, which is silent and takes no
    --          backup. A .bak found here therefore necessarily holds an edit
    --          the user already chose to discard once.
    --          REJECTED — distinct names (.bak.2, .bak.3, timestamps). Never
    --          loses an edit, but accumulates files in <data_dir>/scripts/
    --          that no dispatch command ever removes, in the one directory
    --          the user is meant to be able to read at a glance.
    --          REJECTED — refusing the overwrite while a .bak exists. It
    --          makes the apply stall on a file it created itself, and the remedy
    --          (delete the .bak) is exactly the data loss the refusal claimed
    --          to prevent, just performed by hand.
    --        - nobody to ask: NEVER prompt, NEVER overwrite.
    --          `kept`. Consenting to the drift report means "bring my
    --          installation up to date", not "destroy a file of unknown
    --          provenance while nobody is watching". A scripted launch in CI
    --          must be incapable of eating a local edit. No refusal is
    --          recorded: nobody decided anything.
    --
    -- DECLINED. A no records the pair (digest of the content kept on disk,
    -- digest of the content dispatch ships) for that script in
    -- <data_dir>/scripts/<config.script_declined_name>. While BOTH digests
    -- still match, the operator has already answered this exact question:
    -- branch 4 keeps the file WITHOUT asking, and the drift check does not
    -- count the script as stale, so the launch is clean again. A further edit
    -- to the file, or a release that ships different content, breaks the
    -- match and the question is asked again. Any later successful write or
    -- in-sync pass for the script drops its record. A missing, unreadable or
    -- malformed record file reads as empty, on the same terms as the
    -- provenance manifest: the cost is one more question, never a write.
    --
    -- REJECTED — asking again on every launch. An operator who deliberately
    -- keeps an edited shipped script could then never get a clean start: the
    -- drift prompt and the overwrite question return every time, which
    -- trains them to answer without reading.
    --
    -- Branch 4 is the ONLY branch that can destroy user content, and it
    -- requires BOTH an interactive session AND an explicit yes.
    --
    -- A failure that belongs to the DIRECTORY rather than to one script — the
    -- scripts directory cannot be created at all — yields `failed` for every
    -- entry of config.shipped_scripts, each carrying that one error. Five
    -- lines for one cause reads oddly, but the alternative is a sixth kind of
    -- report line for a case the user fixes exactly the way they fix the
    -- others. The run still continues. The backup
    -- is taken BEFORE the write, not after and not "if the write succeeds",
    -- so a crash mid-write cannot leave the user with neither copy.
    --
    -- PER-SCRIPT FAILURE. A failure while backing up, writing, chmod-ing or
    -- asking about ONE shipped script does NOT fail the artefact. That script is reported
    -- as `failed` carrying the error text, and the apply proceeds to the
    -- remaining scripts and to the config files (InstallShippedFeedConfigs).
    -- Failures are per-script and independent; four scripts landing fine and
    -- one failing is four scripts installed.
    --
    -- A BACKUP failure ABANDONS the script before the write: nothing is
    -- written, the on-disk copy is left exactly as the user had it, and the
    -- outcome is `failed`. This is what keeps ShippedFeedScriptFiles'
    -- EveryDestructiveWriteIsPrecededByABackup true in the presence of a
    -- fallible backup — the fallback on "cannot back up" is to not destroy,
    -- never to destroy without a copy.
    --
    -- A failed script's digest is NOT recorded. Its on-disk state is
    -- whatever the failure left — the original, a truncated write, or a
    -- brand-new partial file — so claiming provenance over it would license
    -- a SILENT overwrite on the next run (branch 3), which is precisely the
    -- consent the manifest exists to track.
    --
    -- Precedent: startup.allium's PartialFailureIsStillProgress already says
    -- this for every other artefact — one that cannot be written is named to
    -- the operator and left for the next launch to retry, because refusing the
    -- whole update over a single unwritable file leaves them with neither the
    -- update nor a way to make progress.
    --
    -- REJECTED — failing the whole artefact. One unwritable script would
    -- hold back the four that could be written, and the user would be left
    -- with neither the update nor a way to make progress without fixing an
    -- unrelated permission first.

    ensures:
        for name in config.shipped_scripts:
            let path = installed_script_path(data_dir, name)
            let shipped = shipped_script_content(name)
            let on_disk = file_content(path)
            let recorded = recorded_script_digest(data_dir, name)
            let declined = declined_overwrite(data_dir, name)

            if not exists_at(path):
                if script_write_succeeds(path, shipped):
                    ScriptFileWritten(path: path, content: shipped, executable: true)
                    ScriptDigestRecorded(name: name, digest: sha256(shipped))
            else if on_disk = shipped:
                if script_mode_repair_succeeds(path):
                    ScriptDigestRecorded(name: name, digest: sha256(shipped))
            else if recorded = sha256(on_disk):
                if script_write_succeeds(path, shipped):
                    ScriptFileWritten(path: path, content: shipped, executable: true)
                    ScriptDigestRecorded(name: name, digest: sha256(shipped))
            else if declined.kept = sha256(on_disk) and declined.shipped = sha256(shipped):
                -- Already answered no for exactly this pair: kept, not asked.
                ScriptOverwriteStillDeclined(name: name)
            else if operator_can_answer and approve_script_overwrite(path):
                if script_backup_succeeds(path, script_backup_path(path)):
                    ScriptFileBackedUp(path: path, backup_path: script_backup_path(path))
                    if script_write_succeeds(path, shipped):
                        ScriptFileWritten(path: path, content: shipped, executable: true)
                        ScriptDigestRecorded(name: name, digest: sha256(shipped))
            else if operator_can_answer and on_disk != null:
                -- An unreadable file has no digest to record, so a no for it
                -- is asked again next time.
                ScriptOverwriteDeclined(
                    name:    name,
                    kept:    sha256(on_disk),
                    shipped: sha256(shipped)
                )

        ShippedFeedScriptsReconciled(
            data_dir: data_dir,
            reports:  shipped_script_reports(data_dir)
        )

    -- `recorded = sha256(on_disk)` is false when `recorded` is null (a
    -- comparison with null is false), so "no manifest entry" falls to
    -- branch 4 by the same expression that catches "entry, but the file
    -- changed". One test, both meanings of unknown provenance.
    --
    -- `approve_script_overwrite` is the second question, reached ONLY on
    -- branch 4 and only when `operator_can_answer` — `and` short-circuits left
    -- to right, so a launch with nobody to ask never asks.
    --
    -- IT IS A SECOND QUESTION, after the one startup.allium's
    -- PromptToUpdateStaleConfig already asked for the whole drift report. That
    -- report's single consent deliberately covers artefacts that destroy
    -- nothing. This branch is the only one in the system that can destroy the
    -- operator's own work, so it asks for itself. It defaults to NO: the
    -- destructive answer is never the one you get by pressing enter.
    --
    -- `script_backup_succeeds` and `script_write_succeeds` ATTEMPT the
    -- filesystem operation and are true iff it (including the chmod, for the
    -- write) raised no error. They are written as guards so the ordering is
    -- part of the expression, not only the prose: a false backup skips the
    -- nested write entirely, so "backup failed" can never reach a write, and
    -- a false write skips ScriptDigestRecorded, so a failure never claims
    -- provenance. Nothing catches the false arm, because there is nothing
    -- further to do to that script this run — the failure leaves the rule
    -- via the report, not via an alternative write path.
    --
    -- `shipped_script_reports(data_dir)` is the ShippedFeedScriptFiles
    -- contract's: one report per script, in config order.

    @guidance
        -- Implementation:
        -- src/setup/plugins.rs::install_shipped_feed_scripts, with the
        -- unknown-provenance branch in
        -- src/setup/plugins.rs::install_unknown_provenance_script and the
        -- manifest in src/setup/plugins.rs::read_script_manifest /
        -- src/setup/plugins.rs::write_script_manifest. The shipped bodies are
        -- include_str!-embedded in the SHIPPED_SCRIPTS table, which pairs
        -- each name with its body so the two cannot drift; the sources are
        -- scripts/fetch-dependabot.sh, scripts/fetch-reviews.sh,
        -- scripts/fetch-cve.sh, scripts/fetch-security.sh,
        -- scripts/fetch-log-warnings.sh.
        -- Hashing uses the hmac-sha256 crate, already in the build tree via
        -- ort-sys and zero-dependency — no new leaf in the dependency graph
        -- for a digest.
        -- The prompt goes through the existing Confirmer seam in
        -- src/setup/mod.rs (src/setup/confirm.rs::Confirmer): confirm_dangerous,
        -- which defaults to No, NOT confirm, which defaults to Yes. Tests
        -- inject a fake confirmer, so both answers are exercisable without
        -- a terminal.
        -- The artefact itself is src/setup/config_update.rs::apply_feed_scripts, the
        -- `feed_scripts` arm of ConfigArtefact::apply; the read-only half the
        -- drift check calls is
        -- src/setup/plugins.rs::shipped_scripts_are_current, which writes
        -- nothing, not even the manifest.
        -- Coverage: src/setup/plugins.rs tests prefixed with
        -- install_shipped_feed_scripts_, one per branch and per failure mode,
        -- plus the artefact-level pair in src/setup/mod.rs
        -- (applying_feed_scripts_keeps_an_edited_script_when_nobody_can_be_asked
        -- and
        -- applying_feed_scripts_asks_dangerously_before_overwriting_an_edited_script).
}

rule InstallShippedFeedConfigs {
    when: startup/ApplyFeedScriptsArtefact(data_dir, _)

    -- The user-owned half. Each config file in config.shipped_script_configs
    -- is created with the shipped placeholder content if and only if nothing
    -- exists at the path. If something does, the apply does not read it, does
    -- not diff it, does not prompt about it, does not back it up and does not
    -- record it in the manifest. There is no branch that writes over a
    -- .conf file — not with a prompt, not ever.
    --
    -- The manifest is deliberately not consulted here. Provenance only buys
    -- the right to overwrite silently, and no overwrite exists on this path,
    -- so an entry would be a fact nothing reads.
    --
    -- Config files are NOT marked executable. They are sourced by the
    -- scripts, never run.
    --
    -- A CONFIG WRITE FAILURE FAILS THE ARTEFACT, not the launch. It is
    -- reported in aggregate rather than per file: unlike a script, a config
    -- file has no per-file state worth distinguishing, and the cause is
    -- nearly always the directory, so the first config that cannot be
    -- written stops the pass and the next launch retries the rest. The
    -- scripts are installed first, so their
    -- section still prints; the board then names `feed scripts` among the
    -- artefacts it could not update and retries it next launch
    -- (startup.allium: ApplyStaleConfigOnConsent, PartialFailureIsStillProgress).
    --
    -- Every config file a shipped script reads is in the list. Installing a
    -- reader without its conf would leave an inert script with no file to
    -- configure it from.

    ensures:
        for name in config.shipped_script_configs:
            let path = installed_script_path(data_dir, name)
            if file_content(path) = null:
                ScriptFileWritten(
                    path:       path,
                    content:    shipped_config_content(name),
                    executable: false
                )

    @guidance
        -- Implementation: src/setup/plugins.rs::install_shipped_feed_configs,
        -- through src/setup/plugins.rs::install_if_absent, which uses
        -- create_new(true), so absence is decided by the filesystem atomically
        -- rather than by a check-then-write race. The bodies come from
        -- scripts/*.conf via include_str!. The failure is raised from
        -- src/setup/config_update.rs::apply_feed_scripts after the scripts'
        -- section is printed.
        -- Coverage: src/setup/plugins.rs tests prefixed with
        -- install_shipped_feed_configs_.
}

rule ReportShippedFeedScripts {
    when: ShippedFeedScriptsReconciled(data_dir, reports)

    -- The apply prints ONE `Feed scripts:` section on stdout. One indented
    -- line per script that was installed, updated, kept or failed; NOTHING
    -- for a script already in sync.
    --
    -- Silence for in_sync is the point. After the first apply the steady
    -- state is five in-sync scripts, and a section that lists all five every
    -- run is noise the user learns to skip — which costs them the one line
    -- that is not noise. A section that only speaks when something changed
    -- is a section that gets read.
    --
    -- When nothing changed and nothing was kept back, the section still
    -- prints ONE line saying it is already up to date, rather than vanishing.
    -- A missing section is ambiguous between "nothing to do" and "this
    -- version of dispatch does not do that yet"; a present one-liner is not.
    --
    -- A `kept` line names the FULL PATH. `kept` is the only outcome that
    -- leaves the deployment running something other than what dispatch
    -- ships, so it is the only one the user may need to act on — and they
    -- cannot act on a bare file name. The line also says why it was kept (it
    -- differs from the version dispatch ships and dispatch did not write it)
    -- and what brings the question back (a further edit or a new release),
    -- because "kept" alone reads like reassurance rather than the open
    -- question it is. It names no flag: there is none.
    --
    -- A `kept` script never has a backup. A backup is taken only on the
    -- approved overwrite, so the backup path appears on an `updated` line,
    -- and on a `failed` line when the write after a successful backup
    -- raised — that is exactly when the user needs to find it.
    --
    -- A `failed` script ALWAYS gets a line, and that line names the full
    -- path and the error text. A failure is never silent and is never folded
    -- into the "already up to date" line: `failed` is reportable, so a run
    -- containing one can never take the nothing-happened branch, even if
    -- every other script was in sync.
    --
    -- FAILED LINES COME FIRST, before the installed/updated/kept lines. The
    -- section is ordered by how much the user has to do about it, and a
    -- failure is the only outcome where the apply did not achieve what it
    -- set out to do. Putting it last risks it scrolling off behind four
    -- successes. Within each group
    -- the order is config.shipped_scripts order, so repeated runs print
    -- stably.

    let reportable = reports where outcome != in_sync
    let failures   = reportable where outcome = failed
    let changes    = reportable where outcome != failed

    ensures:
        if reportable.count = 0:
            SetupSectionLine(section: "Feed scripts", text: "already up to date")
        else:
            for report in failures:
                SetupSectionLine(section: "Feed scripts", text: script_report_line(report))
            for report in changes:
                SetupSectionLine(section: "Feed scripts", text: script_report_line(report))

    @guidance
        -- Implementation: src/setup/config_update.rs::apply_feed_scripts, which prints
        -- the header and then walks
        -- src/setup/plugins.rs::feed_scripts_section_lines. The header line
        -- carries the scripts directory, printed with println! like its
        -- neighbours (this output is a report, not a log — it does not go
        -- through tracing).
        -- The section header prints once, not once per line: with a single
        -- reportable script the output is the header line plus one indented
        -- "  → ..." line.
        -- Ordering within the launch is startup.allium's, not this rule's:
        -- src/setup/config_update.rs::ConfigArtefact::ALL lists
        -- `feed_scripts` last, so the section prints after the other
        -- artefacts' output.
        -- Coverage: src/setup/plugins.rs tests prefixed with
        -- feed_scripts_section_.
}

-- == No feed epic is seeded ==
--
-- Starting the board never creates a feed epic wired to a shipped script. A
-- seeded epic would come back every time the operator deleted it, and the
-- managed reviews tree (My / Team / Bots sub-epics) already surfaces bot PRs,
-- Dependabot's included. The only feed epics that appear on their own are the
-- managed ones provisioned from settings (epics.allium:
-- ProvisionManagedEpics), which the operator controls through those settings.
--
-- fetch-dependabot.sh is still installed (InstallShippedFeedScripts) so an
-- operator can wire an epic to it by hand; installing the file creates no
-- row.

-- == Polling ==

rule FeedTick {
    when: core/FeedPollTick()

    -- The FeedRunner walks every Epic with feed_command != null. For each
    -- such epic, if the elapsed time since its last successful or attempted
    -- run is at least the resolved interval, the command is spawned.
    --
    -- Resolved interval =
    --   epic.feed_interval_secs (when set) else config.default_feed_interval
    --
    -- An epic whose STORED interval is below core/config.min_feed_interval is
    -- not polled at all. It is skipped and a warning naming the epic is
    -- emitted ONCE per epic per stored value, not on every tick (at
    -- config.feed_poll_interval that would be tens of thousands of lines a day
    -- per epic): a different bad value warns
    -- again, and a valid value forgets the warning so a later bad one warns
    -- again. The skip itself holds on every tick. Write-time validation
    -- (epics.allium: CreateEpic, UpdateEpicViaMcp, ManagedFeedConfigViaMcp) is
    -- what normally keeps such a row from existing, so reaching this branch
    -- means the value arrived by a path that bypassed the service -- a
    -- hand-edited database, or a bug -- and the runner must not make it
    -- work anyway. Skipping rather than clamping is deliberate: a clamped
    -- feed would run at a cadence nobody chose while looking healthy.
    --
    -- The floor also covers a negative interval, which takes the same
    -- visible path rather than reading as an effectively infinite one.
    ensures:
        for epic in core/Epics where is_feed:
            if epic.feed_interval_secs != null
               and seconds(epic.feed_interval_secs) < core/config.min_feed_interval:
                FeedIntervalBelowMinimumWarned(epic: epic)
            else:
                let interval =
                    if epic.feed_interval_secs != null:
                        seconds(epic.feed_interval_secs)
                    else:
                        core/config.default_feed_interval
                if elapsed_since_last_run(epic) >= interval:
                    -- Host scoping: Epic carries no `host` field the way a
                    -- dispatched Task does (a feed epic is never
                    -- worktree-backed), so core/PollOwner is the ONLY answer
                    -- to "who runs this epic's feed?" — not a narrower case
                    -- of it, unlike PollPrStatus's host-less tasks. An
                    -- unclaimed epic is claimed here, permanently, by
                    -- whichever host's tick reaches it first; a claimed epic
                    -- is polled only by its owner. See "Host scoping" below.
                    -- FeedCommandRunsOnSettersHost comes first: a host whose
                    -- owner did not set the command neither claims nor runs.
                    let poll_owner = core/PollOwner{scope: epic, scope_id: epic.id}
                    if core/local_host().owner != (epic.feed_command_set_by ?? epic.created_by):
                        -- skipped, last_run bumped as below
                    else if not exists poll_owner:
                        -- CLAIM, THEN RUN. The cycle runs only
                        -- once the claim is answered and the owner read back
                        -- is this host; see "Claim then run" below.
                        core/PollOwner.created(
                            scope: epic,
                            scope_id: epic.id,
                            host: core/local_host(),
                            claimed_at: now
                        )
                        if core/PollOwner{scope: epic, scope_id: epic.id}.host = core/local_host():
                            FeedCycleRequested(epic: epic)
                    else if poll_owner.host = core/local_host():
                        FeedCycleRequested(epic: epic)
                    -- else: another host owns this epic's feed. This tick
                    -- does no exec and emits no FeedCycleRequested for it —
                    -- until a human reassigns ownership
                    -- (OverrideFeedOwner below) — but last_run IS bumped
                    -- regardless of which arm above ran, same as it already
                    -- is for a dropped SerialisedFeedCycle request. Without
                    -- that, a non-owning host would re-read core/PollOwner
                    -- on every feed poll tick instead of only at this
                    -- epic's own feed interval; the ownership answer changes
                    -- rarely enough that the extra latency to notice a
                    -- reassignment costs nothing real.

    -- FEED REQUESTS ARE SERVED ON EVERY TICK. Beside the
    -- interval walk above, each tick picks up the open feed requests on this
    -- host (store-split.allium: FeedRequest) that this process has not
    -- already taken up, whatever the epic's interval and last_run say: a
    -- refresh because a person pressed "r" on another of their hosts and is
    -- waiting, a teardown because a removed task's worktree is still here.
    -- An open row includes a running one a board that died mid-serve left
    -- behind, so the first ticks after a start catch up everything left open
    -- while this board was down. See ServeFeedRefreshRequest and
    -- ServeFeedTeardownRequest.
    ensures:
        for request in split/FeedRequests where
                host = core/local_host() and is_open and not served_by_this_process(this):
            FeedRequestPickedUp(request: request)

    @guidance
        -- Each epic's last_run timestamp is bumped before the spawn so
        -- that a misconfigured command is not retried on every tick. Note the
        -- interaction with SerialisedFeedCycle: last_run is bumped even when
        -- the request is then DROPPED because a cycle for that epic is already
        -- in flight, so a dropped tick waits a full interval rather than
        -- retrying on the next one. That is deliberate — a tick that retried
        -- immediately would spin against a slow in-flight cycle.
        -- Command execution MUST NOT block the event loop. Each eligible
        -- epic's command is spawned as a background tokio::task so that
        -- key events and MCP notifications remain responsive during fetch.
        -- FeedRunner runs in its own loop at config.feed_poll_interval
        -- (src/feed/mod.rs::FEED_POLL_INTERVAL), independent from the TUI's
        -- Tick (core.allium: BoardClockTicks).
        -- Implementation: src/feed/mod.rs::FeedRunner (struct and
        -- src/feed/mod.rs::FeedRunner::tick).
        --
        -- Performance cache + invalidation invariant. The runner caches "does
        -- any epic have a feed_command?" (any_feed_cmds); when it is
        -- Some(false) the tick short-circuits before any DB work. This cache
        -- MUST be invalidated on every surface that can enable the first feed
        -- on a previously feed-less instance, or that feed is stranded
        -- (provisioned but never polled) until an unrelated event or a restart:
        -- MCP is the only way to enable a feed: there is no TUI config surface.
        -- The invariant is enforced on the EVENT, not per calling handler: EVERY
        -- BoardEvent::Refresh and EVERY BoardEvent::EpicChanged invalidates the
        -- cache, whichever handler emitted it. Both arms route through
        -- TuiRuntime::invalidate_feed_cache, which fires the watch sender
        -- FeedRunner.tick checks at the top of each tick to reset any_feed_cmds
        -- to None (re-query).
        --
        -- The obligation on a handler is therefore to EMIT one of those two
        -- events — a handler that emits neither (or only TaskChanged) inherits
        -- nothing. Today's feed-enabling emitters:
        --   1. MCP managed_feed_config (write calls) -> BoardEvent::Refresh
        --   2. MCP epic mutations           -> BoardEvent::EpicChanged
        -- Regression coverage, one test per link in that chain:
        -- src/mcp/handlers/tests/managed_feeds.rs::set_notifies_the_runtime_so_the_feed_cache_is_invalidated
        -- (the handler emits Refresh),
        -- src/runtime/tests/feeds.rs::mcp_refresh_invalidates_feed_runner_cache_after_enabling_a_feed
        -- (Refresh invalidates), and
        -- src/feed/tests.rs::tick_re_queries_after_epic_changed_invalidation.
        --
        -- == Host scoping ==
        --
        -- Exactly one host per epic runs its command: without the claim N
        -- subscribed teammates would make N upstream calls for the one script,
        -- and race each other. ONLY THE POLL OWNER RECONCILES AN EPIC,
        -- whoever asked: a manual "r" on another host becomes a refresh
        -- request the owner serves (ManualFeedTrigger, ServeFeedRefreshRequest),
        -- because two hosts of the setter reconciling one epic could let an
        -- older emission delete what the other just wrote (SerialisedFeedCycle).
        -- Both paths stay held to FeedCommandRunsOnSettersHost, because that
        -- rule is about whose command this is, not about who polls it.
        --
        -- == Claim then run ==
        --
        -- When no PollOwner row exists, the tick spawns ONE background task
        -- for the epic that awaits claim_poll_owner and only then runs the
        -- cycle. If the claim is refused or fails in transport, or the owner
        -- read back afterwards is another host (a second host of the same
        -- person won the claim first), the task stands down: no exec, no
        -- sync, so two hosts that both saw no owner never both run a cycle.
        -- The tick itself
        -- never awaits the claim: the event loop stays responsive, as for the
        -- command (below). A manual "r" on a host with no owner claims first
        -- the same way (ManualFeedTrigger).
        --
        -- The feed SCRIPT still executes locally, on whichever host owns
        -- the claim — nothing here changes where or how the subprocess
        -- runs, only which single host is allowed to be the one running it.
        -- A script needing THIS machine's gh credentials is unaffected by
        -- who else is subscribed to the epic; it is affected by whether
        -- THIS machine is the owner.
}

rule OverrideFeedOwner {
    when: OverrideFeedOwner(epic)

    -- Moves the epic's core/PollOwner row to this host — unconditionally,
    -- even when a different host already holds it. The only way a feed
    -- epic's poll ownership ever moves, since FeedTick's own claim only ever
    -- fills an ABSENT row. The store does the reassignment and its checks
    -- (store-split.allium: OverridePollOwner, which refuses unless this host
    -- is registered to the caller, the caller sees the epic and this host's
    -- owner set the command).
    ensures:
        split/PollOwnerOverridden(scope: epic, scope_id: epic.id, host: core/local_host())

    -- The board reports the answer on the status line: "Feed-poll ownership
    -- for epic #<id> reassigned to this host." when the store accepts, and
    -- the store's refusal as an error otherwise.

    @guidance
        -- Implementation: src/runtime/epics.rs::exec_override_feed_owner.
        -- The one entry is the yes answer to epics.allium's
        -- FeedOwnerTakeoverOffered (FeedBoardKeys), offered by EditEpic when a
        -- human sets or changes feed_command and an existing PollOwner names a
        -- different host. Declining leaves feed_command changed but ownership
        -- untouched. There is no MCP tool for it.
        --
        -- No `requires` on epic.status: every feed epic runs cycles whatever
        -- its status, so there is no status in which ownership is moot.
}

-- == Serialisation ==

rule FeedCommandAuthority {
    when: split/EpicFeedCommandSet(epic, command)

    -- A host runs feed_command as a shell command, so changing it is changing
    -- what a person's machine runs. Only the epic's creator and an admin of
    -- the epic's workspace may change it (a super-admin and the store
    -- operator always may). The
    -- owner of the host that holds the poll claim has NO authority of its
    -- own: a claim is something any host can take, so it cannot stand for
    -- authorship. A patch that leaves feed_command as it is, or sets it to the
    -- value it already has, is not a change and needs no authority.
    --
    -- Both reducers that patch an epic, patch_epic and update_epic, hold a
    -- patch to this rule. At CREATION there is nothing to check: a new epic
    -- that carries a feed_command records its creator as the setter
    -- (feed_command_set_by = created_by), managed epics included.
    requires:
        command = epic.feed_command
        or caller() = epic.created_by
        or epic.workspace.is_admin(caller())
        or is_super_admin(caller())
        or caller_is_store_operator()

    ensures:
        epic.feed_command = command
        -- A real change records who made it, and drops every claim held by a
        -- host whose owner is not that person (FeedCommandRunsOnSettersHost),
        -- so the setter's own host can claim the feed at its next tick.
        if command != old(epic.feed_command):
            epic.feed_command_set_by = caller()
            for claim in core/PollOwners where scope = epic and scope_id = epic.id
                    and host.owner != caller():
                not exists claim

    @guidance
        -- Module: spacetime/module/src/tasks_epics.rs::patch_epic via
        -- spacetime/module/src/tasks_epics.rs::may_change_feed_command; mirrored in
        -- MemoryReducerCaller's apply_patch_epic. The managed root's own
        -- reconcile (epics.allium: ProvisionManagedEpics) writes only a root
        -- its caller created, so it needs no check of its own.
}

rule SerialisedFeedCycle {
    when: FeedCycleRequested(epic)

    -- A FEED CYCLE is the whole sequence a feed request performs for one epic:
    -- exec the feed command, parse its stdout, apply the two degraded-emission
    -- guards, post the emission (IngestFeedEmission), and tear down the worktrees of any task the sync
    -- removed that this host holds. Exactly THREE surfaces request one, all on
    -- the epic's poll owner: FeedTick (per eligible epic, above),
    -- ManualFeedRefresh (the "r" key, when this host is the owner or claims
    -- it) and ServeFeedRefreshRequest (an "r" pressed on another host). The
    -- verify-feed CLI execs a feed command but performs no sync and shares no
    -- process with the TUI, so it is outside this rule.
    --
    -- At most ONE cycle per epic runs at a time. A request arriving while a
    -- cycle for the SAME epic is in flight is DROPPED — not queued, not
    -- delayed: no exec, no parse, no sync, no teardown, no notification. The
    -- claim is symmetric, so whichever surface requested first wins; an
    -- auto-poll tick is dropped by an in-flight manual refresh exactly as the
    -- reverse. Requests for DIFFERENT epics never contend.
    --
    -- == Why the whole cycle, and why dropped ==
    --
    -- RoleRoutedFeedSync's stale-delete keep-set is computed from ONE
    -- emission, and each delete filters on a task's CURRENT epic. The sync is
    -- one module transaction (IngestFeedEmission), so two cycles cannot
    -- interleave inside it. The claim still matters: a cycle reconciling against an emission fetched before the
    -- other cycle's writes landed can see a task the other has moved or
    -- inserted as absent from its own (older) emission, delete it, and —
    -- since the delete feeds TaskTeardown — force remove a live review
    -- agent's worktree. So the claim spans the exec too. It also
    -- halves the upstream API spend of a double refresh.
    --
    -- Dropping rather than queueing: even with the exec bounded at
    -- feed_command_timeout (core.allium config), a queue behind a slow or
    -- hung command grows unboundedly with the number of dropped requests
    -- (N requests deep is N * feed_command_timeout deep). Dropping caps
    -- in-flight work per epic at one cycle regardless of how many requests
    -- arrive while it runs.
    --
    -- == Scope across hosts ==
    --
    -- The claim registry is per PROCESS. Two hosts of the one person who set
    -- the command may both run it, so two hosts could reconcile one epic and
    -- an older emission from one could delete what the other just wrote.
    -- ONLY THE EPIC'S POLL OWNER RECONCILES IT, so the per-process claim is
    -- enough: every cycle for an epic runs in one process.
    --   - FeedTick runs a cycle only on the owner, and claims an unowned epic
    --     BEFORE running it (claim then run, under FeedTick).
    --   - A manual "r" on the owner runs the cycle there. On a host with
    --     no owner it claims first, the same way. On any other host it runs
    --     nothing locally: it writes a refresh request
    --     (store-split.allium: RequestFeedRefresh), and the status line says
    --     the owner will refresh (ManualFeedTrigger).
    --   - The owner serves that request on its next poll tick, through this
    --     same per-process claim (ServeFeedRefreshRequest), so a request
    --     arriving while the owner's own cycle runs is dropped like any
    --     other, and the row is reported done.
    -- FeedCommandRunsOnSettersHost still gates the serving host: being the
    -- poll owner does not let a host run a command its owner did not set.
    -- A removed task held by another host is not left behind: the ingest
    -- writes a teardown request for that host (store-split.allium:
    -- StaleDeleteRequestsTeardownOnTheHoldingHost, ServeFeedTeardownRequest).
    --
    -- == Scope: this closes the feed-vs-feed race ONLY ==
    --
    -- The claim serialises feed cycles against EACH OTHER. It does nothing
    -- about a concurrent NON-feed writer. Any writer that moves a task into the
    -- reconciled subtree mid-cycle — an MCP task update carrying a new epic, an
    -- epic reparent, a flatten, a board move — can place a feed task under a
    -- role sub-epic while it is absent from the in-flight emission, and the
    -- stale delete will then remove it and tear down its worktree. Same
    -- mechanism, same consequence, one leg simply is not a feed cycle. The
    -- invariant below is therefore worded "another cycle", not "another
    -- writer". DegradedNonEmptyEmission does NOT help here: this race needs no
    -- degraded emission, so its additive gate never fires for it. The
    -- alternative that would have covered it — refusing to tear down a task
    -- carrying live agent state — was considered and rejected there, on the
    -- cost it charges to legitimate removals.

    ensures:
        if in_flight_cycle(epic):
            -- Dropped. Nothing runs, and nothing about the epic's tasks
            -- changes. The requesting surface presents this per its own rule
            -- (silently for FeedTick, as a status line for ManualFeedTrigger).
            FeedCycleDropped(epic: epic)
        else:
            -- Claimed for the whole cycle, and released when it ends however it
            -- ends: success, spawn failure, non-zero exit, parse failure,
            -- degraded emission, or a panic partway through. What the claimed
            -- cycle then DOES is specified elsewhere — FeedCommandFailure,
            -- DegradedEmptyEmission and IngestFeedEmission — so this rule
            -- deliberately asserts only the serialisation decision.
            FeedCycleStarted(epic: epic)

    @guidance
        -- Implementation: the claim registry is
        -- src/feed/guard.rs::FeedSyncGuard, a set of claimed epic ids behind a
        -- short-lived mutex; src/feed/guard.rs::FeedClaim is the RAII token and
        -- releases on Drop, which is what makes "released however it ends" hold
        -- across the cycle's many early returns and a panicking task alike.
        -- The cycle itself is src/feed/cycle.rs::FeedCycle::run, which claims
        -- FIRST and then owns every step through teardown. Both request
        -- surfaces — the auto-poll tick in src/feed/mod.rs::FeedRunner::tick and
        -- src/runtime/epics.rs::exec_trigger_epic_feed (manual "r") — delegate
        -- to it and differ ONLY in how they present the outcome, the same
        -- single-shared-function discipline that the module's ingest_feed and
        -- FeedItemParse already follow. A third step added to a feed cycle must
        -- land in FeedCycle::run, never twice in the two callers.
        --
        -- The claim key is the POLLED epic's id — for a reviews_parent that is
        -- the parent, never a role sub-epic. Role sub-epics carry no
        -- feed_command (epics.allium ProvisionManagedEpics), and only the
        -- parent's cycle writes the subtree, so one key covers everything the
        -- cycle reconciles. Two NESTED feed epics whose subtrees overlap would
        -- still contend, since the subtree stale-delete reaches any child epic;
        -- not reachable today, and out of scope.
        --
        -- BOUNDED COST — a hung feed command
        -- starves its epic for at most feed_command_timeout (core.allium
        -- config), not forever.
        -- src/feed/exec.rs::run_feed_command_bounded (shared by
        -- exec_feed_command and the verify-feed CLI) runs the command under
        -- `sh -c` in its OWN PROCESS GROUP and wraps it in
        -- tokio::time::timeout(feed_command_timeout, ...). At the deadline (or
        -- on a stdout over the cap) it SIGKILLs the whole group
        -- (src/feed/exec.rs::kill_process_group) and reaps the shell, so a
        -- pipeline such as `gh | jq` dies with its shell instead of leaving
        -- children behind. The run ends when the SHELL exits, not when the
        -- pipes reach EOF: it reads what is buffered for a short grace, then
        -- kills the group, so a helper started with `&` that inherited stdout
        -- cannot turn a valid emission into a timeout. kill_on_drop(true) stays set as a backstop for a
        -- dropped future, but it reaches only the `sh -c`, never the
        -- pipeline, and is not what bounds the cost.
        -- src/process.rs::run_bounded, the repo's kill-on-timeout primitive,
        -- only covers SYNCHRONOUS ProcessRunner children and so could not be
        -- reused for this async call site directly.
        -- Because the claim spans the exec, the epic's claim IS held for up to
        -- feed_command_timeout — every tick and every manual "r" for that
        -- epic in that window is dropped — but the window is bounded, and the
        -- epic recovers on its own once the deadline fires: no restart
        -- needed. A manual refresh therefore does not work while a poll is
        -- stuck, and that bounded window is deliberate for the same reason the
        -- claim is: letting a manual refresh STEAL an aged claim
        -- would reintroduce exactly the interleave this rule exists to
        -- prevent. A future reader must not "fix" the residual window by
        -- loosening the claim; shrinking feed_command_timeout is the
        -- sanctioned lever if the window proves too wide in practice.
        --
        -- Coverage: src/feed/guard.rs unit tests (exclusivity per epic, release
        -- on drop, independence across epics, release when the holder panics);
        -- src/feed/tests.rs::tick_skips_an_epic_whose_cycle_is_already_in_flight
        -- and
        -- src/runtime/tests/feeds.rs::exec_trigger_epic_feed_reports_already_refreshing_while_a_cycle_is_in_flight
        -- (each request surface drops and writes nothing while a claim is
        -- held); and
        -- src/runtime/tests/feeds.rs::manual_refresh_is_dropped_while_a_real_auto_poll_cycle_is_in_flight
        -- (both surfaces against one epic with a genuine cycle mid-exec, which
        -- is the only test that would catch the two surfaces being wired to
        -- different registries); and
        -- src/feed/cycle/tests.rs::a_hung_command_times_out_and_the_epic_recovers_on_the_next_cycle
        -- (the bounded-cost case: a hung command times out, fails, releases
        -- its claim, and a fresh cycle for the same epic afterward proceeds
        -- and syncs).
}

-- == Running the command ==

rule RunFeedCommand {
    when: FeedCycleStarted(epic)

    -- The claimed cycle's first step. It reads feed_command (and, for the
    -- emission rules, feed_append_only) fresh from the epic rather than from
    -- whoever requested the cycle, runs it, and parses the stdout. It ends in
    -- exactly one of two outcomes:
    --   - FeedCommandCompleted: the command exited 0 and its stdout parsed.
    --     The items and the stderr text travel together, because what an
    --     emission means depends on both (TrustedEmission,
    --     DegradedEmptyEmission, DegradedNonEmptyEmission, AppendOnlyFeed).
    --   - FeedCommandFailed: the epic is gone or has no command (bucket 5,
    --     nothing is spawned), the run failed (buckets 1, 2, 7, 8), or the
    --     stdout did not parse (bucket 3).
    ensures:
        if not exists epic:
            FeedCommandFailed(epic, "epic no longer exists")
        else if epic.feed_command = null:
            FeedCommandFailed(epic, "epic has no feed command")
        else:
            let run = run_feed_command(epic.feed_command)
            if run.error != null:
                FeedCommandFailed(epic, run.error)
            else if feed_parse_error(run.stdout) != null:
                FeedCommandFailed(epic, feed_parse_error(run.stdout))
            else:
                FeedCommandCompleted(epic: epic,
                                     items: parse_feed_items(run.stdout),
                                     stderr: run.stderr)

    @guidance
        -- feed_parse_error is FeedItemParse's failure arm: the error that
        -- parse_feed_items returns instead of a list.
        -- Implementation: src/feed/cycle.rs::FeedCycle::run (the epic re-read,
        -- then src/feed/exec.rs::exec_feed_command, then
        -- src/feed/parse.rs::parse_feed_items).
}

-- == Upsert semantics ==

-- == Where ingestion runs (store-split M3) ==

rule IngestFeedEmission {
    when: FeedEmissionPosted(epic, items, additive, host)

    requires: epic.feed_command != null
    -- host is the ingesting board's own host, which the caller must act for. The stale delete compares each removed task's host with
    -- it to decide who tears the task down
    -- (store-split.allium: StaleDeleteRequestsTeardownOnTheHoldingHost).
    requires: host.owner != null and host.owner = caller()
    -- IngestRefusesAHostThatLostTheClaim: when the epic's poll is claimed, it
    -- is claimed by this host. A cycle that began before its
    -- host's claim was overridden must not reconcile over the new owner's, so
    -- ingest_feed refuses and writes nothing. An epic with no claim row at all
    -- is accepted: the board claims before it runs, but a seed or a CLI import
    -- has nothing to claim. The claim is read on the epic the call names; a
    -- reviews parent's role sub-epics are reconciled through it, under its
    -- claim.
    requires: not exists core/PollOwner{scope: epic, scope_id: epic.id}
        or core/PollOwner{scope: epic, scope_id: epic.id}.host = host

    -- THE SPLIT (store-split.allium S1, S2). The TUI process keeps what needs
    -- the operator's machine: it claims the poll-owner row (FeedTick), runs
    -- the feed script (it needs the operator's gh credentials), parses the
    -- output, classifies the emission as trusted or degraded
    -- (DegradedEmptyEmission, DegradedNonEmptyEmission), resolves each item's
    -- repo_path and base_branch from local clones, and posts the parsed items
    -- with ONE reducer call (ingest_feed). Nothing else about the store is
    -- decided there.
    --
    -- The module decides everything else, in one transaction, from the epic's
    -- own row: which of the three strategies applies (the dispatch precedence
    -- under "Strategy precedence" below), the ExcludeFromReviews filter, RouteSignals, ensuring
    -- the role and repo-group sub-epics, grouping, per-item upsert
    -- (UpsertFeedTasks), the stale-subtree delete, clearing tasks stranded on
    -- the reviews parent, DropClosedRetiredFeedItems, and the epic status
    -- recalculation that follows (EpicStatusRecalculation). The board does
    -- not pass group_by_repo or feed_role: a board that read a stale copy of
    -- either cannot ingest by the wrong strategy.
    --
    -- `additive` is the board's classification of the emission (degraded, or
    -- the epic is append-only). The module does not re-derive it from the
    -- items: the stderr and exit status that degrade an emission exist only
    -- on the host. An additive call inserts and refreshes and moves, and
    -- removes nothing.
    --
    -- An unknown epic is refused. A feed_role of my_reviews, team_reviews or
    -- bots is refused, whether or not the epic carries a feed_command: those
    -- epics are reconciled only through their reviews_parent. Refusal rolls
    -- the whole call back. The module does not itself check feed_command;
    -- the requires clause holds because the board's cycle refuses to run for
    -- an epic without one (FeedCommandFailure bucket 5).
    --
    -- THE TEARDOWN REPORT. A reducer cannot return the rows it deleted. On a
    -- non-additive call the board reads every feed task (external_id set) in
    -- the epic's subtree, the epic included, before the call, and reports to
    -- TaskTeardown those confirmed gone from its own view afterward (see the
    -- shared-store paragraph under UpsertFeedTasks). A task MOVED between
    -- role sub-epics survives and is never reported. An additive call reports
    -- nothing. A removed task another host holds is not torn down here: the
    -- module writes a teardown request for that host in the same transaction
    -- (store-split.allium: StaleDeleteRequestsTeardownOnTheHoldingHost).
    --
    -- NOTIFICATIONS. After a successful sync, whether or not any task
    -- changed, the board sends one BoardEvent::EpicChanged per affected epic
    -- so the TUI reloads only those epics and their tasks, not the whole
    -- board. The affected epics are the feed epic and every epic below it,
    -- because the module does not say which of them it wrote to
    -- (src/store/mod.rs::FeedIngestOutcome). A failed run sends none.
    ensures:
        FeedIngested(epic: epic, items: items, additive: additive)

    @guidance
        -- WHO DECIDES. UpsertFeedTasks, GroupedFeedUpsert, FlatFeedReconcile
        -- and RoleRoutedFeedSync say WHAT happens to the store; where they say
        -- "the runner" or "the runtime" decides it, the module does. Their
        -- obligations are covered through the store handle
        -- (src/feed/ingest/tests.rs),
        -- by the module's own tests (spacetime/module/src/tests.rs) and by
        -- tests/memory_caller_conformance/feeds.rs::memory_caller_ingests_a_feed_like_the_real_module,
        -- which runs one emission sequence against the live module and the
        -- in-memory double (src/sync/memory_caller/feed.rs).
        --
        -- Implementation: spacetime/module/src/feed_ingest.rs::ingest_feed (the
        -- reducer); src/feed/ingest/mod.rs::ingest_emission and
        -- src/store/queries/mod.rs::ingest_feed_inner (the board's one call and
        -- its before-and-after read); src/feed/cycle.rs::FeedCycle::run (the
        -- host work and the additive decision).
}

rule UpsertFeedTasks {
    when: UpsertFeedItems(epic, items, additive)

    -- Items are matched against existing tasks by (epic_id, external_id).
    --
    -- == Repo path resolution ==
    --
    -- Before upserting, the runner resolves a repo_path for each item.
    -- The resolution does NOT consult the parent epic's repo_path —
    -- feed tasks live in whichever local clone matches the item's
    -- upstream URL, which can differ from epic to epic and item to
    -- item.
    --
    -- The resolution is, per item:
    --
    --   1. extract_github_repo(item.url) returns Some("org/repo") for
    --      well-formed GitHub URLs (https://github.com/org/repo/...)
    --      or None for empty, non-GitHub, or malformed URLs.
    --   2. resolve_repo_path("org/repo", known_paths) matches that
    --      pair against the repo paths THIS HOST registered
    --      (db.list_repo_paths_saved_by_this_host) — never another
    --      host's clones, whose paths do not exist here and would block
    --      dispatch. A path matches by directory name, narrowed by the
    --      clone's origin remote: a clone whose remote is positively a
    --      different owner/repo is rejected (orgA/api is not orgB/api), a
    --      remote equal to org/repo wins, and a remote git cannot read
    --      keeps the name match. Returns Some(local_path) on match, None
    --      otherwise.
    --   3. If either step yields None, the item's resolved path is the
    --      empty-string sentinel "". An empty repo_path is a valid
    --      stored state but blocks dispatch (dispatch.allium: ProvisioningNeedsARepoPath).
    --
    -- If db.list_repo_paths_saved_by_this_host fails the runner logs a warning and treats
    -- known_paths as empty, so every item resolves to "".
    --
    -- == Per-item upsert ==
    --
    --   - New (no match): a Task is inserted with the FeedItem's
    --     title, description, tag, labels, sort_order, wrap_up_mode (null
    --     when the item omits it), repo_path =
    --     resolved_path[item] (which may be ""), status = item.status,
    --     sub_status = default_sub_status(item.status), external_id =
    --     item.external_id, base_branch = the resolved default branch
    --     of resolved_path[item] (read from `origin/HEAD`, falling
    --     back to "main" when resolved_path is empty or the ref is
    --     missing), epic = epic, created_by = core/local_host().owner — recording
    --     which host's feed run produced this row, the same field
    --     core/Task.created_by already carries for hand-created tasks (see
    --     core.allium). Stamped on insert only, per created_by's existing
    --     "stamped once, never rewritten" rule; a re-poll's update branch
    --     below never touches it. Null when this install has never connected
    --     to a shared store (core/local_host().owner is then null), exactly like
    --     any other created_by write. Additionally, when item.url is non-empty,
    --     the inserted Task's url is set from item.url with url_type
    --     resolved by precedence: an explicit item.url_type wins; when
    --     absent the type is INFERRED from the URL string — a "/pull/"
    --     segment yields pr, an "/issues/" segment yields issue, and
    --     anything else yields other.
    --     A feed script that supplies a URL is asserting that the item
    --     points to a known artifact (typically a PR), so the card
    --     surfaces it immediately. When item.url is empty, url is null on
    --     insert and any declared url_type is ignored.
    --
    --   - Match: title, description, tag, labels, and sort_order on the
    --     existing Task are updated to the new values; status, sub_status,
    --     repo_path, and wrap_up_mode are NOT touched (wrap_up_mode is
    --     insert-only, so a user's manual wrap-up choice survives — but note
    --     an item that drops out of an emission and later reappears is
    --     deleted and reinserted, taking the feed's wrap_up_mode again, the
    --     same reappear-caveat as status/repo_path). model is not touched
    --     either: a feed never sets it, so the user's choice survives a
    --     re-poll, and a reinserted item starts on the default again.
    --     url (and its url_type) are
    --     backfilled TOGETHER from item.url when the existing Task's url
    --     is null, so a feed task inserted from a script revision that did
    --     not emit a URL gets its url on the next refresh that carries one. The backfilled url_type follows
    --     the same precedence as insert: explicit item.url_type wins,
    --     inference from the URL string otherwise. An existing non-null
    --     url (and its type) is never overwritten — a URL set by an agent
    --     or carried from the original insert wins over feed-supplied
    --     values.
    --     updated_at is
    --     bumped. labels and sort_order are feed-controlled (never
    --     user-editable), so they are always replaced — on a done task too.
    --     The Done column's completion rank is core/Task.completed_at
    --     (tasks.allium, ConfirmDone), which no feed field writes.
    --     This means a user who manually fixes the repo_path on a feed
    --     task (via 'e') keeps that correction across subsequent feed
    --     refreshes, while the feed-owned tag, labels, and sort_order
    --     stay in sync with the script output.
    --
    -- Tasks present locally that are NOT in the latest emission are
    -- removed. The dispatch runtime treats the feed as the source of
    -- truth: any feed-managed task (external_id IS NOT NULL) that does
    -- not appear in the current emission is deleted from the epic.
    -- Non-feed tasks (external_id = null) in the same epic are never
    -- touched by this rule.
    --
    -- That source-of-truth reading holds only for an emission dispatch
    -- trusts, on a feed that mirrors state at all. An ADDITIVE cycle removes
    -- nothing: the per-item upsert above runs unchanged, the deletion below
    -- does not run at all. Two independent causes make a cycle additive —
    -- DegradedNonEmptyEmission (this emission is not trusted) and
    -- AppendOnlyFeed (this epic never mirrors) — and this clause cannot tell
    -- them apart, nor does it need to.

    ensures:
        let known_paths = list_repo_paths_saved_by_this_host() ?? {}
        for item in items:
            let github_repo = extract_github_repo(item.url)
            let resolved =
                if github_repo != null:
                    resolve_repo_path(github_repo, known_paths) ?? ""
                else:
                    ""
            -- Declared type wins over inference; only consulted when
            -- item.url is non-empty.
            let resolved_url_type = item.url_type ?? infer_url_type(item.url)
            let existing = core/Task{epic: epic, external_id: item.external_id}
            -- A retired id is never inserted (see "Retired feed items" below).
            -- It is keyed on the epic whose cycle emits it, which for a
            -- grouped or role-routed sub-epic is the root, not `epic`.
            if not exists existing and not is_retired(epic.nearest_feed_epic, item.external_id):
                core/Task.created(
                    title: item.title,
                    description: item.description,
                    tag: item.tag,
                    labels: item.labels,
                    sort_order: item.sort_order,
                    wrap_up_mode: item.wrap_up_mode,
                    repo_path: resolved,
                    status: item.status,
                    sub_status: default_sub_status(item.status),
                    -- A card that arrives already done has finished, as of
                    -- now. Stamping it here is what puts it at the top of the
                    -- Done column instead of the bottom: the column orders on
                    -- completed_at (board-layout.allium, "Done Column
                    -- Ordering"), and an insert does not pass through the
                    -- status transition that would otherwise stamp it.
                    completed_at: if item.status = done: now else: null,
                    external_id: item.external_id,
                    epic: epic,
                    created_by: core/local_host().owner,
                    base_branch: detect_default_branch(resolved),
                    -- url built from item.url whenever non-empty; null
                    -- otherwise. url_type precedence: explicit
                    -- item.url_type when declared, else inferred from the
                    -- string ("/pull/" -> pr, "/issues/" -> issue, else
                    -- other). See the prose above for rationale.
                    url:
                        if item.url != "":
                            core/TaskUrl{url: item.url, url_type: resolved_url_type}
                        else:
                            null
                )
            else:
                existing.title = item.title
                existing.description = item.description
                existing.tag = item.tag
                existing.labels = item.labels
                -- Applied unconditionally, done tasks included: the Done
                -- column ranks by core/Task.completed_at, which no feed field
                -- can reach.
                existing.sort_order = item.sort_order
                -- url backfilled from item.url when existing.url is null,
                -- with the same explicit-wins url_type precedence as
                -- insert; existing non-null url is preserved.
                if existing.url = null and item.url != "":
                    existing.url = core/TaskUrl{url: item.url, url_type: resolved_url_type}
                -- existing.status, existing.sub_status, existing.repo_path,
                -- existing.wrap_up_mode preserved
                -- (an existing row is refreshed even when its id is retired:
                -- retirement suppresses re-insertion, it does not reach a row
                -- that is still on the board)

        -- Feed-as-source-of-truth deletion. Removing a feed task is not a
        -- bare row drop: the row is deleted and reported, and the reported
        -- row then gets tasks.allium's TaskTeardown — tmux window killed,
        -- git worktree removed, best-effort branch deletion — exactly the
        -- teardown DeleteTask performs. A stale feed task
        -- can carry an in-flight agent's session, and dropping the row
        -- alone orphans that worktree on disk.
        --
        -- SKIPPED ENTIRELY when the cycle is additive, for either reason.
        -- Under DegradedNonEmptyEmission, absence from a tainted emission is
        -- not evidence of anything. Under AppendOnlyFeed, absence from ANY
        -- emission is not evidence of anything, because the source emits
        -- events that are never retracted. Either way this clause is where
        -- that missing evidence would be acted on irreversibly.
        if not additive:
            for task in core/Tasks where task.epic = epic and task.external_id != null:
                if not items.any(i => i.external_id = task.external_id):
                    not exists task
                    TaskTeardown(task)

    @guidance
        -- created_by = core/local_host().owner records which host's feed run
        -- actually produced a task, independent of PollOwner
        -- (core.allium)/FeedTick's ownership claim above — a feed script
        -- still executes locally on whatever host runs it (it needs that
        -- machine's gh credentials), and this is what makes the row say so
        -- afterward. This rule does not touch Epic.created_by.
        --
        -- Status preservation is intentional: once a user starts working
        -- on a feed-derived task (moves it to running, opens a PR, etc.),
        -- subsequent feed refreshes must not yank the card back to its
        -- original column.
        -- repo_path preservation on conflict is for the same reason: a
        -- user-corrected path must survive feed refreshes. Only the
        -- INSERT path writes a repo_path; the UPDATE path leaves it
        -- alone.
        -- The match is keyed on (epic, external_id) with external_id set, so
        -- non-feed tasks (external_id = null) never match.
        -- Implementation: the per-item upsert and the per-epic stale delete are
        -- spacetime/module/src/feed.rs::upsert_feed_tasks_inner, which every
        -- strategy of ingest_feed calls (IngestFeedEmission). The board's
        -- src/store/queries/mod.rs::ingest_feed_inner takes a repo_paths slice,
        -- one entry per item, parallel to items, plus a parallel base_branches
        -- slice, and enforces the parallel-slice contract up front: if items,
        -- repo_paths, and base_branches do not all share the same length the
        -- call errors and writes nothing, rather than letting the index-zip
        -- silently truncate and drop items. This is the ONE place in the feed
        -- pipeline the three collections are still parallel slices — the cycle
        -- above it instead threads a single
        -- Vec<src/feed/ingest/mod.rs::FeedItemWithTarget> of paired
        -- {item, repo_path, base_branch} entries, assembled once via
        -- FeedItemWithTarget::zip in src/feed/cycle.rs::FeedCycle::run (shared
        -- by FeedRunner::tick and exec_trigger_epic_feed), so per-index
        -- alignment is structural up to that call and needs no separate
        -- length check.
        -- Resolution helpers: src/dispatch/mod.rs::extract_github_repo,
        -- src/dispatch/mod.rs::resolve_repo_path. Callers:
        -- src/feed/ingest/mod.rs::ingest_emission (via FeedRunner.tick and exec_trigger_epic_feed).
        -- The TaskTeardown obligation on the stale-delete is met by reporting,
        -- not by tearing down inline: the removed rows reach the board as
        -- src/store/mod.rs::RemovedFeedTask values on
        -- src/store/mod.rs::FeedIngestOutcome, and the feed cycle passes them
        -- to src/feed/mod.rs::cleanup_removed_feed_tasks — see the TaskTeardown
        -- fan-out paragraph under RoleRoutedFeedSync for the whole path.
        -- HOST: a removed row carries the host that dispatched it
        -- (RemovedFeedTask.host = Task.host), because its worktree and window
        -- exist only there. src/feed/mod.rs::split_removed_by_host hands the
        -- cleanup only rows this host owns (or that were never dispatched); a
        -- row another host owns is left for that host, which gets a teardown
        -- request written by the module in the delete's own transaction
        -- (store-split.allium: StaleDeleteRequestsTeardownOnTheHoldingHost) and serves it
        -- whenever its board next runs (ServeFeedTeardownRequest).
        --
        -- HOW THE REPORT IS BUILT. The delete itself is unconditional (every
        -- stale row is removed whether or not it is reported). A reducer
        -- cannot RETURN the rows it deleted, so the Store
        -- (src/store/queries/mod.rs::ingest_feed_inner) predicts candidates
        -- from its own already-subscribed view before calling the reducer,
        -- then reports only the ones CONFIRMED absent from that view
        -- afterward. The candidates are every feed task in the epic's subtree,
        -- so a removed row that owned neither a worktree nor a tmux window is
        -- reported too; its teardown runs no command. A candidate that
        -- survives the call (raced by a concurrent non-feed write; only the
        -- poll owner reconciles an epic, so no other host's cycle races it) is
        -- silently
        -- dropped rather than reported, which can under-report a removal —
        -- an orphaned worktree this cycle misses, caught by whichever later
        -- cycle next sees that same row absent and freshly reportable. It
        -- never OVER-reports: nothing is torn down that the reducer did not
        -- itself remove. Both properties are deliberate: a missed orphan is
        -- caught later, a wrongly torn-down worktree is not recoverable.
}

rule GroupedFeedUpsert {
    when: FeedIngested(epic, items, additive)

    requires: epic.group_by_repo = true
    requires: epic.feed_role != reviews_parent

    -- When group_by_repo is enabled, items are grouped by repo name
    -- (last path segment of extract_github_repo(url)), with "other" as the
    -- fallback for items that lack a resolvable GitHub URL.
    -- A sub-epic is found or created for each group name, then
    -- UpsertFeedTasks is called per sub-epic. Sub-epics that the
    -- current emission no longer names (their repo contributed no item) are
    -- reconciled too: UpsertFeedTasks is called on each with an empty list,
    -- so the feed-as-source-of-truth deletion in UpsertFeedTasks extends
    -- across the whole grouped subtree rather than only the present repos.
    -- Finally UpsertFeedTasks is called on the parent with an empty list,
    -- which the same deletion rule uses to remove all flat feed tasks from
    -- the parent.
    --
    -- MIGRATION BY MOVE. On the first run after the flag is enabled the
    -- parent still holds its flat feed tasks. Before a group is upserted,
    -- each of its items that already has a task elsewhere in the grouped
    -- subtree (on the parent, or in another direct sub-epic) has that task
    -- MOVED into the group's sub-epic: its epic is rewritten in place, and
    -- its status, sub_status, repo_path, worktree, tmux window and agent are
    -- kept. The upsert then refreshes it like any task already there. Only a
    -- task whose item is gone from the emission is deleted. This is the
    -- ON-side twin of FlatFeedReconcile's re-home, and the same move
    -- RoleRoutedFeedSync makes between role sub-epics. Every move lands
    -- before any group is upserted, as RoleRoutedFeedSync routes every item
    -- before it deletes. When the target
    -- sub-epic already holds a task for the item, that task wins and nothing
    -- is moved; the other copy is left to the clearing passes.
    --
    -- Every deletion reached through those UpsertFeedTasks calls — in a present
    -- group, in an absent sub-epic, or in the parent's empty upsert — deletes
    -- the row, reports it, and then performs tasks.allium's TaskTeardown on the
    -- reported row: tmux window killed, git worktree removed, best-effort
    -- branch deletion.
    -- Delete-then-teardown, not teardown-then-delete: the board reports only
    -- rows confirmed gone after the module's transaction committed, so nothing
    -- is torn down that was not deleted (see how the report is built, under
    -- UpsertFeedTasks). The cost is that a crash between the commit and the teardown
    -- orphans the worktree with no DB row left to retry from (see the sequencing
    -- note under RoleRoutedFeedSync).
    --
    -- On an ADDITIVE cycle the present groups are still upserted, and the
    -- migration moves still run (a move removes nothing), but BOTH clearing
    -- passes — absent sub-epics and the parent's flat tasks — are skipped, so
    -- nothing is removed and no TaskTeardown runs.
    -- Only ONE of the two causes of additivity reaches this rule:
    -- DegradedNonEmptyEmission. AppendOnlyFeed cannot — a grouped epic may
    -- not be append-only (AppendOnlyFeed).

    ensures:
        -- A retired item with no task left in the subtree is dropped before
        -- grouping, so no sub-epic is found-or-created just to hold nothing.
        let admitted = items where not retired_without_task(epic, this)
        -- One group per distinct repo_name(url) of the admitted items.
        for name in repo_names(admitted):
            let group_items = admitted where repo_name(url) = name
            if not exists core/Epic{parent: epic, title: name}:
                core/Epic.created(title: name, parent: epic, description: "",
                                  origin: repo_group)
            let target = core/Epic{parent: epic, title: name}
            -- Migration by move: the parent is searched first, then the
            -- sub-epics.
            for item in group_items:
                let existing = (core/Tasks where external_id = item.external_id
                                  and (this.epic = epic or this.epic.parent = epic)).first
                if exists existing and existing.epic != target
                   and not exists core/Task{epic: target, external_id: item.external_id}:
                    existing.epic = target
        -- Every move above lands before any group is upserted: a group's
        -- stale delete would otherwise remove a task still waiting to move
        -- to a later group.
        for name in repo_names(admitted):
            UpsertFeedItems(core/Epic{parent: epic, title: name},
                            admitted where repo_name(url) = name, additive)
        -- Reconcile sub-epics absent from this emission. A sub-epic
        -- whose title no current item maps to has its feed tasks cleared
        -- (manual tasks survive, per UpsertFeedTasks). When items is empty,
        -- every sub-epic is cleared. Skipped entirely when additive.
        if not additive:
            for sub_epic in epic.sub_epics:
                if not admitted.any(item => repo_name(item.url) = sub_epic.title):
                    UpsertFeedItems(sub_epic, {}, additive)
            UpsertFeedItems(epic, {}, additive)

    @guidance
        -- `admitted`'s retired-without-task filter, AS IMPLEMENTED, only
        -- narrows the group whose repo has NO EXISTING sub-epic yet — the
        -- exact case this rule's own `ensures` comment is about ("no sub-epic
        -- is found-or-created just to hold nothing"). A group whose repo
        -- already has a sub-epic passes every item through unfiltered,
        -- including a retired-without-task one: UpsertFeedTasks' own retired
        -- check still refuses the insert ("Retired feed items"), so
        -- nothing reappears; the only observable difference is that an
        -- existing sub-epic whose current batch is entirely retired ids is
        -- reconciled as "present with nothing new" rather than treated as if
        -- the filter had emptied it outright — a distinction with no
        -- behavioral consequence, since the reconcile pass below clears an
        -- absent sub-epic's tasks either way. See
        -- spacetime/module/src/feed_ingest.rs::ingest_grouped's own comment.
        --
        -- repo_name(url) = last path segment of extract_github_repo(url),
        -- or "other" when the URL yields no GitHub repo (empty URL, non-GitHub,
        -- malformed). Implementation: spacetime/module/src/feed_ingest.rs::ingest_grouped,
        -- spacetime/module/src/rules.rs::repo_name_from_url (the module's twin
        -- of src/models/paths.rs::repo_name_from_url).
        -- A sub-epic created here carries origin = repo_group, as
        -- find_or_create_repo_group's do. That is what lets FlatFeedReconcile
        -- (and the manual FlattenEpic) find and flatten it when grouping is
        -- turned off. A sub-epic found by title keeps the origin it has: a
        -- manual one of the same name is reused, not claimed.
        -- Sub-epics are not auto-deleted when their tasks disappear; empty
        -- sub-epics remain for the user to clean up manually. The
        -- reconciliation only clears their feed tasks — it never removes the
        -- sub-epic row itself.
        -- UpsertFeedTasks(epic, []) uses the existing deletion rule to remove
        -- all feed-managed tasks (external_id IS NOT NULL) directly under the
        -- parent epic; the same call on an absent sub-epic clears that
        -- sub-epic's feed tasks while preserving any manual (external_id =
        -- null) tasks the user added there.
        -- Implementation: spacetime/module/src/feed_ingest.rs::ingest_grouped — the
        -- present groups and the absent-sub-epic reconciliation share the same
        -- upsert path, and the whole pass is one transaction. The board reads
        -- the removed src/store/mod.rs::RemovedFeedTask rows from its own view
        -- before and after the call (src/store/queries/mod.rs::ingest_feed_inner)
        -- and hands them to src/feed/mod.rs::cleanup_removed_feed_tasks via
        -- src/store/mod.rs::FeedIngestOutcome.
        -- The migration move is spacetime/module/src/feed_ingest.rs::move_into_group,
        -- run per group before its upsert.
}

-- == Flat reconcile (un-grouped feed epic) ==

rule FlatFeedReconcile {
    when: FeedIngested(epic, items, additive)

    requires: epic.group_by_repo = false
    requires: epic.feed_role != reviews_parent

    -- The OFF-side counterpart to GroupedFeedUpsert's ON-side migration. When
    -- grouping is turned OFF on a feed epic, the flag flip is synchronous
    -- (epics.allium: ToggleGroupByRepo) but does NOT itself move any task.
    -- Reconciliation is deferred to the NEXT feed sync — this rule, the flat
    -- dispatch branch (see "Strategy precedence" below).
    --
    -- Before the flat upsert, every RepoGroup sub-epic of the parent
    -- (origin = repo_group — the same set the manual
    -- FlattenEpic rule acts on, epics.allium) is reconciled: its tasks are
    -- re-homed back to the parent, and a sub-epic that ends up empty (no tasks,
    -- no child epics) is deleted. This mirrors FlattenEpic's semantics; the
    -- implementation calls the store's flatten_epic reducer
    -- (spacetime/module, grouping.rs) rather than duplicating the
    -- re-home/delete-if-empty logic, so the whole step is one store
    -- transaction. Unlike
    -- the FlattenEpic RULE (which gates on feed_command = null and so never
    -- fires for a feed epic), this rule is the feed epic's route to that same
    -- outcome — poll-driven, not keypress-driven.
    --
    -- Manual (origin != repo_group) sub-epics are never touched, exactly as in
    -- FlattenEpic. reviews_parent epics are excluded: their whole subtree is
    -- reconciled by RoleRoutedFeedSync, which owns their sub-epic layout.
    --
    -- After re-homing, UpsertFeedTasks runs on the parent with the current
    -- emission. Re-homed feed tasks (external_id != null) are now direct
    -- children of the parent, so UpsertFeedTasks matches them by
    -- (epic, external_id) and either refreshes them (still emitted) or removes
    -- them as stale (absent from the emission) — the ordinary
    -- feed-as-source-of-truth behaviour. Removing such a stale task deletes and
    -- reports the row and then performs tasks.allium's TaskTeardown on the
    -- reported row — tmux window killed, git worktree removed, best-effort
    -- branch deletion — so a re-homed task that still
    -- carries an in-flight agent is released rather than orphaned. This is what
    -- makes the flat path self-healing on the first poll after the user
    -- un-groups, with no manual cleanup step. Running it when the parent has no RepoGroup sub-epics is a
    -- harmless no-op (empty loop), so it fires on every flat sync, not only the
    -- first after the toggle.
    --
    -- On an ADDITIVE cycle (DegradedNonEmptyEmission or AppendOnlyFeed) the re-home still runs —
    -- it moves tasks and deletes only sub-epics it has just emptied, so it
    -- destroys nothing and does not read the emission — while the removal half
    -- is skipped by UpsertFeedTasks' own additive gate. A re-homed task absent
    -- from a tainted emission therefore lands on the parent and STAYS there
    -- until a trusted emission judges it.

    ensures:
        for sub in epic.sub_epics where sub.origin = repo_group:
            for task in sub.subtasks: task.epic = epic
            -- sub.subtasks.count is the post-move count: true only when the
            -- sub-epic had no nested sub-epics and all its tasks just moved out.
            if sub.subtasks.count = 0 and sub.sub_epics.count = 0: DeleteEpic(sub)
        UpsertFeedItems(epic, items, additive)

    @guidance
        -- Implementation: spacetime/module/src/feed_ingest.rs::ingest_flat
        -- (group_by_repo = false, feed_role != reviews_parent). The re-home +
        -- delete-if-empty step calls the store's flatten_epic reducer
        -- (spacetime/module, grouping.rs), shared with the manual FlattenEpic
        -- path. The reducer does not check feed_command, so it serves a feed
        -- epic as readily as a manual one. Symmetric
        -- with GroupedFeedUpsert's ON-side "doubles as migration" behaviour.
        -- The flat branch reports its removed rows in
        -- the same SHAPE as every other path (see UpsertFeedTasks' guidance),
        -- so a re-homed task deleted as stale is torn down rather than
        -- orphaned. Every path is one transaction: a refusal anywhere rolls
        -- the whole ingest back, so there is no
        -- partial pass to salvage and no per-write log-and-continue.
        -- The re-home MOVES the existing row (writes epic_id in place), never
        -- deletes and recreates it: a feed epic's subtree holds at most one
        -- task per external_id, and a move can never collide with itself.
        -- Coverage: src/feed/ingest/tests.rs (re-home + delete empty RepoGroup
        -- sub-epic on flat sync; no-op when no sub-epics exist; manual sub-epics
        -- preserved; reviews_parent epic unaffected — routed to
        -- RoleRoutedFeedSync instead);
        -- src/feed/ingest/tests/role_routing.rs::flat_sync_reports_removed_task_with_worktree.
}

-- == Role-routed reconcile (PR-review feed) ==

rule RoleRoutedFeedSync {
    when: FeedIngested(epic, items, additive)

    requires: epic.feed_role = reviews_parent

    -- The opinionated path (see the DELIBERATE EXCEPTION in Scope). A
    -- reviews_parent epic carries the reviews feed_command and ONE deduped
    -- emission covering every PR the user is involved with (see
    -- feed-scripts.allium: scripts/fetch-reviews.sh). This rule reconciles the
    -- parent's WHOLE role-sub-epic subtree — my_reviews, team_reviews, bots —
    -- from that single emission, rather than reconciling any epic against its
    -- own emission.
    --
    -- The three role sub-epics are ensured to exist up front (idempotent,
    -- matched by core/Epic.feed_role, never by title). They carry NO
    -- feed_command, so FeedTick never polls them independently (enforced at
    -- provisioning — see epics.allium ProvisionManagedEpics); only the parent
    -- is polled, and only this rule writes into the subtree.
    --
    -- == Non-review PRs are excluded before routing ==
    --
    -- The emission is FILTERED before anything else happens to it: every item
    -- the ExcludeFromReviews contract above excludes is dropped — an item
    -- carrying author_me, and an item carrying approved that neither
    -- direct_request nor team_request rescues.
    -- The kept set is what the routing loop, the insert/update pass and the
    -- stale keep-set all see, so an excluded item is not merely routed
    -- elsewhere — it does not exist for this reconcile.
    --
    -- The consequence for an item that WAS present is deliberate: because it
    -- is absent from the keep-set, the subtree delete removes its task exactly
    -- as it removes a merged PR, TaskTeardown included. So enabling this
    -- exclusion cleans out excluded PRs already sitting in the subtree on
    -- the next poll, rather than leaving them stranded until they merge. A
    -- MANUAL task (external_id = null) is never touched, so a task the user
    -- created for their own PR by hand — or a dispatch task that opened it —
    -- is unaffected.
    --
    -- The filter runs on the additive (DegradedNonEmptyEmission or
    -- AppendOnlyFeed) path too: it
    -- shrinks what gets inserted, and the deletes it would otherwise imply are
    -- skipped along with every other removal on that path.
    --
    -- == Global identity and the move ==
    --
    -- Task identity across the subtree is GLOBAL by external_id (NOT
    -- (epic_id, external_id) as in UpsertFeedTasks): the same PR is one task no
    -- matter which role sub-epic currently holds it. The reconcile SCOPE is the
    -- whole reviews_parent subtree INCLUDING the parent epic itself — a feed
    -- task found sitting directly on the parent is in scope exactly like one in
    -- a role sub-epic. This is deliberate: a reviews_parent epic must hold NO
    -- feed-managed task directly (see NoFlatFeedTasksOnReviewsParent). A flat
    -- feed task can be stranded on the parent by an out-of-band flat upsert;
    -- this rule is what heals it. For each emitted PR,
    -- route(item.signals) (the RouteSignals contract) picks the target role:
    --
    --   - Present in the subtree, SAME role  -> fields updated in place
    --     (title, description, tag, labels, sort_order), as UpsertFeedTasks.
    --   - Present in the subtree, DIFFERENT epic -> a MOVE: the task's epic_id
    --     is reassigned to the target sub-epic, THEN its fields are updated.
    --     "Different epic" INCLUDES a task currently on the parent — it is
    --     moved down into its routed role sub-epic, not duplicate-inserted.
    --     The reassignment touches only epic_id/updated_at, so status,
    --     sub_status, repo_path, worktree, tmux_window and sort_order are
    --     PRESERVED — an in-flight dispatched review agent keeps its session
    --     across a my<->team<->bots reclassification or a parent->role rescue.
    --     This is the core fix: a bucket change is a true move, not
    --     delete+recreate.
    --   - Absent from the subtree -> inserted into the target sub-epic (fresh
    --     task, exactly as UpsertFeedTasks' insert path).
    --
    -- Because a parent-stranded task is MOVED (not re-inserted), it never
    -- collides with itself under the subtree-uniqueness constraint:
    -- the move relocates the single
    -- existing row rather than inserting a second one. Treating the parent as
    -- out of scope — so the router insert-inserts a routed copy while the flat
    -- copy lingers — is precisely the deadlock this scoping avoids.
    --
    -- == Sub-epic-level grouping (a THIRD tree level) ==
    --
    -- The routing above places a PR in its role sub-epic (my/team/bots). When
    -- that ROLE SUB-EPIC itself has group_by_repo enabled (can_auto_group on
    -- the sub-epic — spacetime/module/src/rules.rs::can_auto_group), the PR
    -- is routed ONE LEVEL DEEPER:
    -- into a per-repo REPO-GROUP sub-epic nested UNDER the role sub-epic,
    -- found-or-created and keyed by repo name
    -- (spacetime/module/src/rules.rs::repo_name_from_url of item.url).
    -- Tasks then live at this third level, not
    -- directly on the role sub-epic. When the role sub-epic does NOT have
    -- grouping enabled the target is the role sub-epic directly — today's
    -- documented two-level behaviour is the group_by_repo = false case.
    --
    -- This is the same group_by_repo grouping GroupedFeedUpsert applies at the
    -- top level of a flat feed epic, but here it is applied to an ALREADY
    -- role-routed sub-epic, so it produces a THIRD tree level
    -- (parent -> role sub-epic -> repo-group sub-epic -> tasks) rather than a
    -- second. A per-sync cache keyed by (role_sub_epic_id, repo_name) memoises
    -- the found-or-created repo-group id for the duration of ONE reconcile, so
    -- multiple items sharing a repo do not create duplicate sub-epics. The
    -- find-or-create runs inside the module's ingest transaction and has no
    -- failure arm of its own.
    --
    -- The third level widens every subtree operation below (identity lookup,
    -- stale delete, recalculation) — see each section for the specifics.
    --
    -- == Subtree-scoped delete (the reason this is not UpsertFeedTasks) ==
    --
    -- UpsertFeedTasks' delete pass is PER-EPIC: it removes feed tasks absent
    -- from THAT epic's emission. Run per-role that would delete a task the
    -- moment it moved to another role (it is absent from the losing role's
    -- keep-set). So the stale-delete here is SUBTREE-SCOPED and uses a SINGLE
    -- union keep-set of every emitted external_id: a task that merely moved is
    -- still in the keep-set and survives, while a PR absent from the whole
    -- emission (merged or closed) is removed. Because the delete SQL is one
    -- level deep, that single keep-set is applied with the PARENT as root
    -- (reaching the role sub-epics' tasks) AND once per ROLE SUB-EPIC as root
    -- (reaching that role's repo-group grandchildren — the third level above).
    -- The role-level pass runs ALWAYS, regardless of whether that role
    -- currently has group_by_repo enabled, so repo-group tasks orphaned after
    -- grouping is toggled off are still cleaned up. Manual tasks
    -- (external_id = null) anywhere in the subtree are never touched, as in
    -- UpsertFeedTasks. Roles that contributed no item this cycle are cleared by
    -- the same delete (no per-role empty-upsert needed).
    --
    -- == Parent sweep ==
    --
    -- The subtree delete above is scoped to the parent's CHILDREN, so it never
    -- touches tasks flat on the parent itself. A final parent sweep therefore
    -- removes every feed-managed task (external_id != null) still sitting
    -- directly on the reviews_parent epic. By construction a present
    -- parent-stranded task was already MOVED down by the routing loop, so what
    -- remains is a merged/closed stray or a legacy duplicate whose routed copy
    -- already lives in a role sub-epic — both must go so the parent holds no
    -- flat feed task (NoFlatFeedTasksOnReviewsParent). Manual (external_id =
    -- null) tasks on the parent are preserved. This converges the invariant from
    -- any starting state, including a parent+sub-epic duplicate of one PR.
    --
    -- Steps run as ONE non-interleaved unit per parent tick. Because the whole
    -- emission is reconciled together, "present but different role" = move and
    -- "absent" = remove are unambiguous — the property independent per-epic
    -- feeds could not provide.

    ensures:
        -- Ensure the three role sub-epics exist (idempotent, by feed_role).
        -- role_sub_epic(parent, role) finds-or-creates the single sub-epic of
        -- the parent carrying that feed_role (uniqueness guaranteed by
        -- core/Epic.UniqueFeedRolePerParent).
        let my   = role_sub_epic(epic, my_reviews)
        let team = role_sub_epic(epic, team_reviews)
        let bots = role_sub_epic(epic, bots)

        -- Drop non-review items up front (ExcludeFromReviews). `kept` — not
        -- `items` — is what the rest of this rule reconciles against, INCLUDING
        -- the stale-delete keep-set below, so an excluded item that already had
        -- a task loses it on this cycle.
        let kept = items where not excluded(signals)

        -- Retired items with no task left in the subtree are skipped before
        -- routing, so no repo-group sub-epic is found-or-created for them.
        for item in kept where not retired_without_task(epic, item):
            -- route only ever yields my_reviews / team_reviews / bots. It is
            -- never reached for an excluded item.
            let role = route(item.signals)
            let role_target =
                if role = team_reviews: team
                else if role = bots:    bots
                else:                   my
            -- Third tree level: when the role sub-epic itself has grouping
            -- enabled, route one level deeper into a per-repo sub-epic nested
            -- under it (found-or-created, keyed by repo name, memoised per
            -- sync). Otherwise the target is the role sub-epic directly.
            let target =
                if role_target.group_by_repo and role_target.feed_command = null:
                    repo_group_sub_epic(role_target, repo_name(item.url))
                else:
                    role_target
            -- Scope: the whole reviews_parent subtree, PARENT INCLUDED, across
            -- ALL THREE levels (parent, role sub-epics, repo-group
            -- grandchildren). A task stranded directly on the parent
            -- (existing.epic = epic) is found here too, so it is moved down
            -- rather than duplicate-inserted. Identity is global by
            -- external_id. Scan order is the parent, then repo-group
            -- grandchildren, then role sub-epics, and the LAST copy found
            -- wins, so a role-sub-epic-direct copy wins a tie over a
            -- repo-group copy. A manual child epic of the parent is not
            -- scanned.
            let existing = (core/Tasks where external_id = item.external_id
                              and (this.epic = epic
                                   or this.epic in {my, team, bots}
                                   or this.epic.parent in {my, team, bots})).last
            if exists existing:
                if existing.epic != target:
                    -- MOVE: reassign epic only; state-bearing fields preserved.
                    -- Covers parent->role rescue as well as my<->team<->bots.
                    existing.epic = target
                -- Field refresh (same as UpsertFeedTasks' match path).
                existing.title = item.title
                existing.description = item.description
                existing.tag = item.tag
                existing.labels = item.labels
                existing.sort_order = item.sort_order
                -- existing.status, sub_status, repo_path, worktree,
                -- tmux_window preserved by the move.
            else:
                -- First sight: insert into the routed sub-epic exactly as
                -- UpsertFeedTasks' insert path (repo_path/base_branch/url all
                -- resolved identically, and a retired id refused the same
                -- way — though the filter on this loop has already dropped it).
                -- Insert only: this rule runs its own stale delete below.
                UpsertFeedItems(target, {item}, true)

        -- Subtree-scoped delete with the union of all emitted ids: removes
        -- merged/closed PRs and clears buckets absent from this emission,
        -- without deleting a just-moved task (it is in the keep-set) or any
        -- manual task. The delete SQL is one level deep, so the union keep-set
        -- is applied with the PARENT as root (role sub-epics' tasks) AND once
        -- per ROLE SUB-EPIC as root (repo-group grandchildren). The role-level
        -- pass runs ALWAYS, even for roles with grouping off, so orphaned
        -- repo-group tasks are cleaned up. Both levels are captured here by
        -- matching any feed task whose epic is a child of the parent OR a child
        -- of a role sub-epic. Removal deletes the row, reports it, and then
        -- performs tasks.allium's TaskTeardown on the reported row — this is
        -- the path a merged PR's in-flight review agent travels, so its tmux
        -- window and worktree must be released, not orphaned. Skipped
        -- entirely when the cycle is additive (DegradedNonEmptyEmission or
        -- AppendOnlyFeed): this
        -- is the exact clause that would destroy a live review agent's
        -- worktree on a partially degraded emission.
        if not additive:
            for task in core/Tasks where (task.epic.parent = epic
                                     or task.epic.parent in {my, team, bots})
                                and task.external_id != null:
                if not kept.any(i => i.external_id = task.external_id):
                    not exists task
                    TaskTeardown(task)

        -- Parent sweep: the reviews_parent epic must hold NO feed task directly
        -- (NoFlatFeedTasksOnReviewsParent). Present parent-stranded tasks were
        -- already moved down by the routing loop, so anything left flat on the
        -- parent is a merged/closed stray or a legacy duplicate whose routed
        -- copy already lives in a role sub-epic — both are removed. Manual
        -- (external_id = null) tasks on the parent are preserved. Removal
        -- deletes-then-tears-down the reported row, as above. Skipped when
        -- additive: this sweep deletes on position alone, with no reference to
        -- the emission at all, so on a tainted cycle it is the least
        -- discriminating delete of the three and the first to go.
        if not additive:
            for task in core/Tasks where task.epic = epic and task.external_id != null:
                not exists task
                TaskTeardown(task)

        -- Recalculate bottom-up through all three levels: repo-group sub-epics
        -- first (they roll up into their role sub-epic), then each role
        -- sub-epic (it may have lost tasks to a move or the delete), then the
        -- parent.
        for sub in {my, team, bots}:
            for rg in sub.sub_epics where origin = repo_group:
                RecalculateEpicStatus(rg)
        for sub in {my, team, bots}:
            RecalculateEpicStatus(sub)
        RecalculateEpicStatus(epic)

    @guidance
        -- Implementation: spacetime/module/src/feed_ingest.rs::ingest_role_routed,
        -- selected by spacetime/module/src/feed_ingest.rs::ingest_feed from the
        -- epic's own feed_role when it is ReviewsParent. A MyReviews/
        -- TeamReviews/Bots epic carrying a feed_command is a provisioning bug,
        -- and the reducer refuses it (ROLE_SUB_EPIC_FEED_REFUSED); because that
        -- check sits in the one reducer, the auto-poll and the manual "r"
        -- refresh cannot differ on it.
        -- Third-level (repo-group) routing lives in ingest_role_routed too: per
        -- item, after spacetime/module/src/rules.rs::route_signals gives the
        -- role sub-epic, if that sub-epic groups (group_by_repo and no
        -- feed_command, spacetime/module/src/rules.rs::can_auto_group) the
        -- actual target is a repo-group sub-epic found-or-created by
        -- spacetime/module/src/grouping.rs::find_or_create_repo_group, keyed by
        -- spacetime/module/src/rules.rs::repo_name_from_url and memoised for
        -- the duration of one ingest.
        -- The subtree delete is one level deep, so ingest_role_routed deletes
        -- once with the parent as root (reaches role sub-epics) AND once per
        -- role sub-epic as root (reaches repo-group grandchildren), always,
        -- regardless of that role's grouping flag. The parent itself is cleared
        -- separately by the parent sweep (a delete over the parent's own feed
        -- tasks, keeping nothing).
        --
        -- TaskTeardown fan-out. A reducer cannot return what it deleted, so the
        -- board predicts the removed rows from its own view of the subtree
        -- before the call and reports those confirmed gone afterwards
        -- (src/store/queries/mod.rs::ingest_feed_inner). The shared row type is
        -- src/store/mod.rs::RemovedFeedTask {id, repo_path, worktree,
        -- tmux_window}. The module runs the move before the deletes, which is
        -- load-bearing: each delete filters on the task's CURRENT epic_id, so
        -- the move must land first or a MOVED task would be deleted and have its
        -- live worktree destroyed. A moved task is still in the board's view
        -- afterwards, so it is never reported. The report rides out on
        -- src/store/mod.rs::FeedIngestOutcome, which
        -- src/feed/cycle.rs::FeedCycle::run hands to
        -- src/feed/mod.rs::cleanup_removed_feed_tasks -- once, in the shared
        -- cycle, rather than once per feed path as when teardown was first
        -- added. It groups
        -- by repo_path and tears down sequentially within a repo (git worktree
        -- remove / branch -D contend on the shared checkout's index lock) and
        -- in parallel across repos. Teardown is best-effort and warn-logged;
        -- it never fails the sync. It is also unconditional on task state —
        -- no clause here consults status or sub_status, so any task that
        -- reaches it is force-torn-down even with a live agent in it. That is
        -- deliberate and stays: the protection against tearing down a live
        -- agent lives UPSTREAM, in whether the delete happens at all
        -- (DegradedNonEmptyEmission, or AppendOnlyFeed for an epic that
        -- never removes at all), not in a state check here. See
        -- DegradedNonEmptyEmission's "why not gate the teardown on task state
        -- instead" for the alternative that was rejected.
        --
        -- Sequencing note — the ensures clauses of this rule and of
        -- UpsertFeedTasks / GroupedFeedUpsert write `not exists task` BEFORE
        -- TaskTeardown(task), which is the order the implementation runs in:
        -- the module's ingest transaction commits first and the teardown runs
        -- afterwards in the caller, off FeedIngestOutcome.removed. The report
        -- is the board's prediction narrowed to rows CONFIRMED gone after the
        -- commit, so the set torn down never exceeds the set deleted; a row
        -- raced back in by another writer is under-reported, never torn down
        -- (see how the report is built, under UpsertFeedTasks).
        -- The cost, stated honestly: if the process dies between the commit
        -- and the teardown, the worktree is orphaned on disk with no row left
        -- to retry from. That is accepted — the alternative is holding a write
        -- transaction open across `git worktree remove` — and it is bounded,
        -- since the orphan is an inert directory under .worktrees/, not a
        -- resource leak.
        --
        -- Teardown-vs-notification ordering is NORMATIVE and the same on both
        -- feed paths: the teardown of every removed row THIS HOST HOLDS (its
        -- host is the ingesting host, or it has none) completes BEFORE the
        -- notification for that cycle is sent. So a notification means
        -- reconciled AND cleaned up here, and this board never shows a row
        -- gone while its worktree is still being removed.
        --
        -- A removed row ANOTHER host holds is not waited on.
        -- Its teardown is a request row the module wrote in the ingest's own
        -- transaction (store-split.allium:
        -- StaleDeleteRequestsTeardownOnTheHoldingHost), served by that host's
        -- board whenever it next runs (ServeFeedTeardownRequest), which may be
        -- long after this cycle notifies. Its worktree outlives the row on
        -- that machine until then; nothing on this board shows it.
        --
        -- Both paths share this ordering because both run the one shared
        -- cycle (src/feed/cycle.rs::FeedCycle::run, which owns the teardown
        -- and hands its callers an already-cleaned-up outcome to present).
        --
        -- The cost, stated honestly: the auto-poll path's BoardEvent::EpicChanged
        -- waits on `git worktree remove` for every removed task, so a
        -- mass-merge that removes a dozen tasks at once lags the board by that
        -- fan-out. It is bounded — cleanup_removed_feed_tasks runs repos in
        -- parallel and only serialises within a repo — and it buys a board
        -- that never disagrees with the filesystem.
        --
        -- The existing-task lookup
        -- that decides
        -- move-vs-insert is
        -- spacetime/module/src/feed_ingest.rs::ingest_role_routed (its
        -- `existing` index): it scans the parent FIRST (lowest priority), then each role sub-epic's
        -- children (repo-group grandchildren), then the role sub-epics
        -- themselves LAST — so external_id identity is global across all three
        -- levels and a role-sub-epic-direct copy wins ties over a repo-group
        -- copy. A present parent-stranded task is thus moved (single-row
        -- relocation, no uniqueness-trigger collision, in-flight state
        -- preserved) before the sweep runs. The move rewrites epic_id and
        -- updated_at only, and the per-group upsert then refreshes the
        -- feed-owned fields. role_sub_epic is ensure_role_sub_epic (idempotent,
        -- matched by feed_role). Recalculation runs in the same transaction:
        -- repo-group sub-epics first (bottom-up), then role sub-epics, then the
        -- parent.
        -- Coverage:
        -- src/feed/ingest/tests.rs (move preserves in-flight worktree/status;
        -- moved task not deleted same cycle; insert on first sight; delete on
        -- merge/close; manual-task preservation; multi-role single emission;
        -- two back-to-back zero-interval ticks lose nothing; a feed task
        -- stranded on the parent is moved down to its routed role sub-epic with
        -- state preserved; a parent-stranded task absent from the emission is
        -- deleted as stale; a manual task on the parent is never touched);
        -- src/feed/ingest/tests/role_routing.rs::moved_task_is_never_reported_as_removed
        -- (the ordering invariant above — a task moved between role sub-epics
        -- is never handed to teardown),
        -- src/feed/ingest/tests/role_routing.rs::absent_task_with_worktree_is_reported_as_removed
        -- and src/feed/ingest/tests/role_routing.rs::flat_sync_reports_removed_task_with_worktree
        -- (the report reaches the outcome on both sync paths);
        -- src/feed/ingest/tests/role_routing.rs::route_routed_preserves_manual_task_on_parent
        -- (a manual task survives the stale delete, so it never reaches the
        -- removed-rows report);
        -- src/feed/tests.rs::tick_removed_task_tears_down_its_worktree
        -- and src/runtime/tests/feeds.rs::exec_trigger_epic_feed_removed_task_tears_down_its_worktree
        -- (the teardown is actually wired up, once per feed path); and the
        -- src/feed/mod.rs cleanup_* tests for the helper itself
        -- (cleanup_removes_worktree_and_kills_window,
        -- cleanup_kills_window_only_when_there_is_no_worktree,
        -- cleanup_of_a_stateless_row_runs_no_commands,
        -- cleanup_continues_after_a_failure,
        -- cleanup_serialises_same_repo_removals).
        --
        -- Known limitation — GitHub search lag. GitHub's search API is
        -- eventually consistent: a just-reviewed PR can still match
        -- a review-request qualifier for a poll cycle or two, so a role move may lag
        -- the real-world action briefly. Routing is correct once signals
        -- settle; this is documented, not a bug.
}

-- == New PRs in My Reviews and Team Reviews are signalled ==

rule NewReviewRequestIsSignalled {
    when: FeedIngested(epic, items, additive)

    requires: epic.feed_role = reviews_parent

    -- A PR that RoleRoutedFeedSync INSERTS (the "Absent from the subtree"
    -- branch) and whose route(item.signals) is my_reviews or team_reviews is
    -- created with the new-task signal on. It marks exactly the people
    -- mcp-task-tools.allium: SignalMarksTheTaskForEveryoneWhoSeesIt marks:
    -- every member of the workspace who can see the epic the task lands in,
    -- in the same store transaction as the insert. "The epic it lands in" is
    -- the repo group under the role sub-epic when that sub-epic groups by
    -- repo, else the role sub-epic itself.
    ensures:
        for task in inserted_tasks(epic, items) where route(signals) in {my_reviews, team_reviews}:
            for m in task.epic.workspace.memberships where task.epic.visible_to(user):
                core/UnseenTask.created(subscriber: m.user, task: task)

    @guidance
        -- The signal is the create-time flag create_task already has; the feed
        -- is one caller of it, not a second mechanism. Who is marked, how the
        -- mark is drawn and how it clears are all the signal's own rules
        -- (tasks.allium: SeeTaskByLandingOnIt,
        -- UnseenMarkEndsWithTheTaskLeavingItsEpicOrFinishing).
        --
        -- ONLY AN INSERT IS SIGNALLED. A refresh of a PR already on the board
        -- (new commits, a new title, a changed CI label) writes no mark, and
        -- neither does a MOVE between role sub-epics (Team Reviews into My
        -- Reviews, Bots into Team Reviews): the task is not new, and the
        -- signal says "something new landed here". A retired PR is never
        -- re-inserted ("Retired feed items"), so it is never re-signalled
        -- either.
        --
        -- MY REVIEWS AND TEAM REVIEWS, NOT BOTS. Both hold PRs a person is
        -- asked to review, directly or through a team, and the operator wants
        -- to hear about each new one. Bots, CVE and every flat or grouped feed insert without
        -- the signal: Bots inserts arrive in bulk, so marking them would bury
        -- the marks that matter.
        --
        -- The additive path (DegradedNonEmptyEmission, AppendOnlyFeed) inserts
        -- the same way and signals the same way.
        --
        -- Implementation: spacetime/module/src/feed_ingest.rs::ingest_into
        -- (role-routed branch), through IngestStore's
        -- mark_task_unseen_for_viewers, which the module and the board's
        -- in-memory double both implement.
        -- Tests: src/feed/ingest/tests/role_routing.rs::new_my_reviews_pr_is_signalled_and_a_refresh_is_not,
        -- src/feed/ingest/tests/role_routing.rs::new_team_reviews_pr_is_signalled,
        -- src/feed/ingest/tests/role_routing.rs::new_bots_pr_is_not_signalled,
        -- src/feed/ingest/tests/role_routing.rs::pr_moved_into_my_reviews_is_not_signalled,
        -- src/feed/ingest/tests/role_routing.rs::new_pr_in_a_my_reviews_repo_group_is_signalled,
        -- tests/memory_caller_conformance/feeds.rs::memory_caller_ingests_a_feed_like_the_real_module.
}

-- == Failure handling ==

rule FeedCommandFailure {
    when: FeedCommandFailed(epic, error)

    -- Failures fall into eight buckets, all handled identically from the
    -- user's perspective: the failure is logged at warn level, and the
    -- epic is not retried until its next interval, because FeedTick bumped
    -- the runner's last_run for it before requesting the cycle.
    --
    --   1. Spawn error (binary not found, permission denied, etc.)
    --   2. Non-zero exit status
    --   3. Stdout is not a valid JSON array of FeedItem
    --   4. Zero items emitted while stderr is non-empty
    --      (DegradedEmptyEmission below). Unlike buckets 1-3 this one is
    --      reached only AFTER a successful parse — the stdout was valid,
    --      it just carried nothing while the command complained.
    --   5. The epic no longer exists, or no longer carries a feed_command,
    --      by the time the cycle claims it. These come BEFORE the exec:
    --      nothing is spawned.
    --      They exist because the cycle reads feed_command (and
    --      feed_append_only) from the epic itself rather than accepting them
    --      from its caller (SerialisedFeedCycle), and the module reads
    --      feed_role and group_by_repo from the epic's own row
    --      (IngestFeedEmission), so an epic deleted or reconfigured between
    --      the request and the claim is a failure here rather than a sync
    --      against stale configuration.
    --   6. The epic is a role sub-epic carrying a feed_command at all — a
    --      provisioning bug (see RoleRoutedFeedSync). Reached at the sync:
    --      the module's ingest_feed refuses it and writes nothing.
    --   7. The command exceeded feed_command_timeout (core.allium config)
    --      without exiting. It is killed and reaped rather than left to
    --      finish or orphaned; the exec never produces output for the
    --      degraded-emission guards to see, so this bucket is reached the
    --      same way buckets 1-2 are — before any parse. See
    --      SerialisedFeedCycle's bounded-cost note above.
    --   8. The command wrote more than config.feed_output_cap_bytes to
    --      stdout or to stderr. Its process group is killed at once, as for
    --      bucket 7, and no output is parsed: a runaway command must not be
    --      able to fill the board's memory.
    --
    -- Bucket 5 also covers the epic being deleted WHILE the command runs
    -- (it can run for minutes): the store then refuses the sync with
    -- "epic N not found". The cycle re-reads the epic after a refused sync
    -- and, if it is gone, drops the cycle logging at debug, not warn: the
    -- next tick no longer lists the epic, so there is nothing to recover.
    -- A refusal for an epic that still exists stays a warning, and so does an
    -- epic already missing when the cycle claims it: nothing deleted it under
    -- a running command, so the request named an epic that was not there.
    --
    -- Buckets 5 and 6 are unreachable in a correctly-provisioned, unraced
    -- system; they are specified because the cycle must do something
    -- definite when they happen, and "sync anyway" would be the wrong
    -- something.
    --
    -- The TUI is NOT notified of feed errors. Tasks already in the epic
    -- are unaffected.

    ensures:
        log_warn(epic.id, epic.title, error)

    @guidance
        -- Implementation: src/feed/mod.rs::FeedRunner::tick spawns a
        -- feed cycle per eligible epic, and that job runs
        -- src/feed/cycle.rs::FeedCycle::run, which drives claim -> read config
        -- -> exec -> parse -> sync -> teardown. The command failure arms live
        -- at: spawn, timeout, and non-zero exit in
        -- src/feed/exec.rs::exec_feed_command (a non-zero exit's error always
        -- names the exit status, e.g. "command failed (exit status: 1)", so a
        -- command that wrote nothing to stderr still reports a cause), and the JSON parse in
        -- src/feed/parse.rs::parse_feed_items. Parse is shared
        -- exactly as exec is: the auto-poll path, the manual "r" refresh
        -- (src/runtime/epics.rs::exec_trigger_epic_feed) and the verify-feed
        -- CLI all call parse_feed_items, so the anti-drift argument
        -- FeedCommandStderrOnSuccess makes for the single shared exec holds
        -- here too — a change to parse semantics is made once (FeedItemParse).
        -- Bucket 4 is raised after the parse by the shared predicate in
        -- src/feed/exec.rs (see DegradedEmptyEmission).
        -- Bucket 5 is read from the board's own view of the epic in
        -- src/feed/cycle.rs::FeedCycle::run, which has no read-error arm. The
        -- missing-epic arm is pinned by
        -- src/feed/cycle/tests.rs::a_cycle_whose_epic_is_gone_fails_without_running_the_command
        -- and the mid-cycle deletion by
        -- src/feed/cycle/tests.rs::a_sync_refused_because_the_epic_was_deleted_mid_cycle_is_not_a_warning.
        -- Bucket 7 is exec_feed_command's tokio::time::timeout around the
        -- child (see SerialisedFeedCycle's BOUNDED COST note above for why
        -- src/process.rs::run_bounded couldn't be reused for this call site).
        -- Coverage: src/feed/exec/tests.rs::exec_feed_command_returns_err_when_it_exceeds_the_deadline
        -- (the raw timeout, with a bounded elapsed-time assertion so the test
        -- doesn't merely wait out the hang) and
        -- src/feed/cycle/tests.rs::a_hung_command_times_out_and_the_epic_recovers_on_the_next_cycle
        -- (the whole cycle: a hung command times out, fails, releases its
        -- claim, and a fresh cycle for the same epic afterward proceeds and
        -- syncs — proving recovery, not merely that one call returned).
        -- A future improvement is surfacing repeated failures in the TUI
        -- as an epic-level health badge, but that is out of scope here.
}

rule FeedCommandStderrOnSuccess {
    when: FeedCommandCompleted(epic, items, stderr)

    -- The warning is emitted by the exec layer BEFORE the stdout parse,
    -- so it also precedes a FeedCommandFailed outcome when the stdout is
    -- malformed. The stderr text is not carried on the event: it reaches
    -- callers on FeedOutput (see @guidance).

    -- A feed command that exits 0 while writing to stderr is NOT by
    -- itself a failure: its stdout parsed, and a NON-EMPTY emission is
    -- still synced. But it is the signature of a script that swallowed
    -- an internal error and emitted a degraded (often empty) array
    -- anyway, which FeedCommandFailure never sees. The stderr text is
    -- therefore logged at warn level so the evidence survives the run.
    --
    -- Stderr on a zero-exit run is NEVER merely diagnostic. It TAINTS the
    -- emission, and the two rules below say what a tainted emission is
    -- allowed to do.
    --
    -- THE ONE EXEMPTION, notice lines: a stderr LINE that starts with
    -- "notice:" is informational and does not taint. The runner drops such
    -- lines before it cuts and classifies (src/feed/exec.rs::significant_stderr;
    -- FeedCommandRun.stderr never carries them), so
    -- a script can tell the user something (fetch-reviews.sh: "TEAMS is
    -- empty") without turning every cycle additive. A line that merely
    -- CONTAINS "notice:" still taints. A script must never put a failure
    -- behind the prefix.
    --
    -- Tainted emissions:
    --
    --   - ZERO items + stderr  -> DegradedEmptyEmission. The command is
    --     treated as failed and NO sync runs at all.
    --   - items > 0 + stderr   -> DegradedNonEmptyEmission. The sync runs
    --     ADDITIVELY: what the emission CONTAINS is written, what it
    --     OMITS is not acted on. Nothing is removed, so nothing is torn
    --     down.
    --
    -- The single principle behind both: a tainted emission is evidence of
    -- what exists, never evidence of what does not. Absence from a tainted
    -- emission means nothing, because the reason a script soft-fails is
    -- precisely that it produces FEWER items than the truth.
    --
    -- REJECTED — stderr as diagnostic only, so that an empty emission still
    -- reconciles and removes every task absent from it. The cost is
    -- unbounded data loss: a soft-failing script that exits 0 with an empty
    -- array wipes a whole reviews_parent subtree, worktrees and all, and a
    -- partially failing one removes whatever its failed queries dropped.
    --
    -- ACCEPTED COST of tainting: a feed script that writes to stderr
    -- on EVERY run never removes anything. If it also legitimately emits
    -- an empty array on a day with genuinely zero items it is treated as
    -- failed INDEFINITELY; if it emits items it still syncs them, but
    -- additively, so genuinely merged or closed PRs never disappear from
    -- it. There is no escape hatch short of fixing the script. This is
    -- accepted because the script contract above already requires errors
    -- on stderr to come with a non-zero exit — a script that chatters on
    -- stderr while exiting 0 is already outside contract — and because
    -- the alternative is unbounded data loss. Note the asymmetry of the
    -- two costs: a stale card the user can delete by hand, against a
    -- force-removed worktree and a deleted branch that no one can get
    -- back.
    --
    -- The logged text is trimmed and truncated to config.feed_stderr_cap
    -- characters.

    requires: stderr != ""

    ensures:
        log_warn(epic.id, epic.title, truncate(stderr, config.feed_stderr_cap))
        -- and then, when items.count > 0, the emission syncs ADDITIVELY
        -- (DegradedNonEmptyEmission). When items.count = 0 the sync is
        -- suppressed entirely by DegradedEmptyEmission instead.

    @guidance
        -- Implementation: src/feed/exec.rs::exec_feed_command logs the
        -- warning and returns the trimmed, truncated text on its
        -- FeedOutput so callers can surface it too. It is the SINGLE exec
        -- for both feed paths: they share src/feed/cycle.rs::FeedCycle::run,
        -- which is the single place it is called from, so neither can regress
        -- to a private spawn that drops stderr. The manual path surfaces it in the TUI as a FAILURE
        -- status line when the emission is empty (DegradedEmptyEmission
        -- via ManualFeedTrigger's failure arm); a non-empty emission with
        -- stderr surfaces the ordinary success line WITH the degraded
        -- suffix (DegradedNonEmptyEmission).
        -- The zero-items-vs-non-empty split is not re-decided per caller:
        -- it is TWO sibling predicates in src/feed/exec.rs —
        -- degraded_empty_emission and degraded_partial_emission, both
        -- (item_count, stderr) -> Option<reason> and mutually exclusive by
        -- their item_count arm — applied ONCE after the parse and before the
        -- sync in the shared src/feed/cycle.rs::FeedCycle::run, so the two
        -- feed paths cannot even in principle disagree about them. When BOTH
        -- return None the emission syncs and reconciles as normal, with the
        -- stderr logged and nothing else.
        -- Coverage: src/feed/exec/tests.rs::exec_feed_command_captures_stderr_written_on_zero_exit,
        -- exec_feed_command_truncates_long_stderr,
        -- exec_feed_command_truncates_multi_byte_stderr_without_panicking and
        -- exec_feed_command_reports_stderr_of_exactly_the_cap_complete (the
        -- capture and the config.feed_stderr_cap cap,
        -- src/feed/exec.rs::MAX_FEED_STDERR_CHARS);
        -- src/feed/tests.rs::tick_stderr_on_zero_exit_does_not_suppress_sync
        -- (one item alongside stderr still syncs — additively).
}

rule TrustedEmission {
    when: FeedCommandCompleted(epic, items, stderr)

    -- A run that wrote nothing to stderr, on an epic that mirrors upstream
    -- state, is an emission dispatch trusts: it is posted to the module as a
    -- RECONCILE, so what it omits is removed. An empty emission is trusted
    -- too: it means everything closed.
    --
    -- Exactly one of this rule, DegradedEmptyEmission,
    -- DegradedNonEmptyEmission and AppendOnlyFeed answers a completed run.
    requires: not epic.feed_append_only and stderr = ""

    ensures:
        FeedEmissionPosted(epic: epic, items: items, additive: false,
                           host: core/local_host())

    @guidance
        -- Implementation: src/feed/cycle.rs::FeedCycle::classify_emission picks
        -- SyncMode::Reconcile when neither degraded predicate fires and the
        -- epic is not append-only.
}

rule DegradedEmptyEmission {
    when: FeedCommandCompleted(epic, items, stderr)

    -- The guard. A feed command that exits 0, parses to ZERO items, and
    -- wrote to stderr is treated as a FAILED command, not as an emission
    -- meaning "everything is gone". This is the signature of a script
    -- that soft-failed internally and emitted an empty array anyway — for
    -- example a wrong gh account making every repo-scoped query fail, each
    -- soft-failing to an empty array, which would wipe the reviews_parent
    -- subtree.
    --
    -- Effect: FeedCommandFailed (bucket 4). Logged at warn level,
    -- no retry before the next interval, and NO SYNC RUNS AT ALL — not the upsert, not
    -- the reconcile, not the stale delete. Every task already in the epic
    -- or its subtree is left exactly as it was, including its worktree
    -- and tmux window.
    --
    -- The two neighbouring cases are unchanged, and are the boundary this
    -- rule must not cross:
    --
    --   - ZERO items with EMPTY stderr is a clean empty run. It still
    --     reconciles normally, and it still removes merged/closed PRs and
    --     every other task absent from the emission.
    --   - A NON-EMPTY emission still SYNCS regardless of stderr — one item
    --     alongside stderr is a sync, not a failure — but when the stderr
    --     is non-empty that sync is ADDITIVE, per
    --     DegradedNonEmptyEmission below. This rule owns only the
    --     zero-item arm; it never suppresses a non-empty emission.
    --
    -- The guard is applied AFTER the stdout parse and BEFORE the sync.
    -- Placing it after the parse is deliberate: malformed stdout with
    -- non-empty stderr already fails as a parse error, which is bucket 3
    -- of FeedCommandFailure.
    --
    -- The guard applies to EVERY feed epic uniformly — flat, grouped and
    -- reviews_parent alike — not only to the reviews_parent path where
    -- the incident was observed.
    --
    -- The cost of this guard is recorded on FeedCommandStderrOnSuccess
    -- above: a script that always chatters on stderr and legitimately
    -- emits nothing never reconciles again.
    --
    -- PARTIAL degradation is covered by DegradedNonEmptyEmission below,
    -- not by this rule. This rule fires only at items.count = 0; a
    -- partially degraded emission — e.g. some of scripts/fetch-reviews.sh's
    -- four repo-scoped queries soft-failing to [] while the others succeed
    -- — is non-empty and so falls to that rule instead.

    requires: items.count = 0 and stderr != ""

    ensures:
        FeedCommandFailed(epic, truncate(stderr, config.feed_stderr_cap))
        -- and therefore, by FeedCommandFailure: log_warn. No emission is
        -- posted, so no
        -- UpsertFeedTasks / GroupedFeedUpsert / FlatFeedReconcile /
        -- RoleRoutedFeedSync pass runs and no task is created, updated,
        -- moved or removed.

    @guidance
        -- Implementation: ONE shared predicate,
        -- src/feed/exec.rs::degraded_empty_emission, next to FeedOutput in
        -- src/feed/exec.rs, so the two feed paths cannot drift — the same
        -- rationale that put the role dispatch in the single reducer
        -- spacetime/module/src/feed_ingest.rs::ingest_feed. It is applied once,
        -- after parse and before sync, in src/feed/cycle.rs::FeedCycle::run,
        -- which logs it and returns a failed outcome. The two surfaces then
        -- present that outcome:
        --   - the auto-poll job adds nothing. last_run is already bumped by
        --     src/feed/mod.rs::FeedRunner tick before the job is spawned, so
        --     this lands exactly on FeedCommandFailure's existing contract.
        --   - src/runtime/epics.rs::exec_trigger_epic_feed fails with the
        --     predicate's reason, which CARRIES the stderr rather than being
        --     it: degraded_empty_emission returns "command emitted no items
        --     but wrote to stderr: <stderr>", so the status bar shows
        --     "Feed for '<title>' failed: command emitted no items but wrote
        --     to stderr: <stderr>" (ManualFeedTrigger). The ensures clause's
        --     truncate(stderr, config.feed_stderr_cap) names the stderr the
        --     reason embeds — the cap is applied once, by exec_feed_command,
        --     before the predicate ever sees the text.
        -- Coverage: inline unit tests on the predicate in src/feed/exec.rs —
        -- degraded_when_zero_items_and_stderr_present (fires),
        -- not_degraded_when_zero_items_and_no_stderr and
        -- not_degraded_when_items_present_despite_stderr (both boundaries);
        -- src/runtime/tests/feeds.rs::exec_trigger_epic_feed_fails_on_degraded_empty_emission
        -- (the manual trigger reports a failure) and
        -- exec_trigger_epic_feed_degraded_empty_emission_does_not_delete_existing_tasks
        -- (the manual path ran no sync at all, not merely a quiet one);
        -- src/feed/tests.rs::tick_degraded_empty_emission_does_not_delete_existing_tasks
        -- (auto-poll leaves pre-existing subtree tasks untouched — the direct
        -- regression test for the reported wipe). The false-positive boundary
        -- is pinned by the existing tests that must stay green unmodified:
        -- src/runtime/tests/feeds.rs::exec_trigger_epic_feed_zero_items (a quiet
        -- empty run still reconciles) and
        -- src/feed/tests.rs::tick_stderr_on_zero_exit_does_not_suppress_sync
        -- (one item alongside stderr still syncs — additively, per
        -- DegradedNonEmptyEmission, but it is not suppressed).
}

rule DegradedNonEmptyEmission {
    when: FeedCommandCompleted(epic, items, stderr)

    -- The partial-degradation guard, DegradedEmptyEmission's counterpart for
    -- an emission that is not empty.
    --
    -- A feed command that exits 0, parses to AT LEAST ONE item, and wrote to
    -- stderr is a PARTIALLY degraded emission: some of what it was asked to
    -- fetch came back, and some of it soft-failed. scripts/fetch-reviews.sh
    -- runs eight-plus scoped queries and each failure branch prints to stderr
    -- and substitutes []; a wrong gh account, an expired token or one
    -- rate-limited org therefore produces exactly this signature. It is
    -- DegradedEmptyEmission's mechanism at partial scale, and it is MORE
    -- likely than total failure, not less — total failure needs every query
    -- to fail at once.
    --
    -- Effect: the sync runs, but ADDITIVELY. An additive sync performs every
    -- write that follows from what the emission CONTAINS — insert, field
    -- refresh, and (on the role-routed path) cross-role MOVE — and performs
    -- NO write that follows from what it OMITS. Concretely, every
    -- feed-as-source-of-truth removal clause in UpsertFeedTasks,
    -- GroupedFeedUpsert, FlatFeedReconcile and RoleRoutedFeedSync is SKIPPED
    -- for this cycle: no stale delete, no clearing of absent sub-epics, no
    -- parent sweep. Because nothing is removed, no TaskTeardown runs, and no
    -- worktree, branch or tmux window can be destroyed by a run whose own
    -- script reported an error.
    --
    -- WHY ADDITIVE RATHER THAN SUPPRESSED. DegradedEmptyEmission suppresses
    -- the whole sync because a zero-item emission has nothing to contribute.
    -- A partial emission does: the items it did return are real, and new PRs
    -- must still reach the board. Suppressing it would also make a feed whose
    -- script fails one sub-query on most polls permanently useless, whereas
    -- additive keeps it useful and merely conservative.
    --
    -- WHY NOT GATE THE TEARDOWN ON TASK STATE INSTEAD. The rejected
    -- alternative was to keep deleting, but refuse the TaskTeardown for a
    -- removed task that still carries live agent state (a worktree plus a
    -- non-terminal status), leaving the agent and its branch alive for the
    -- human to reclaim. Rejected because it pays its cost on the LEGITIMATE
    -- case: a PR merged while its review agent is still running is ordinary,
    -- and it is the exact case feed-driven teardown was added for. Under a
    -- state gate every such merge leaves a worktree, a branch and a tmux
    -- window on disk with no card left to find them from, forever. The
    -- failure this rule addresses is better fixed by not performing the
    -- wrong delete than by softening its consequences.
    --
    -- RESIDUAL RISK, stated honestly: this rule keys on stderr, so a feed
    -- script that degrades SILENTLY — soft-failing a sub-query without
    -- printing anything — is not detected, and its omissions still delete and
    -- tear down. The script contract (FeedCommandFailure) requires errors to
    -- be reported, so a silent soft-fail is a script bug; dispatch cannot
    -- distinguish it from a genuine removal. It has no known instance and no
    -- cheaper detector.
    --
    -- The rule applies to EVERY feed epic uniformly — flat, grouped and
    -- reviews_parent alike.

    requires: items.count > 0 and stderr != ""

    ensures:
        -- The sync runs exactly as for a trusted emission (the module picks
        -- the strategy), with removals disabled for this cycle.
        FeedEmissionPosted(epic: epic, items: items, additive: true,
                           host: core/local_host())
        for task in epic.subtree_tasks where task.external_id != null:
            -- Nothing absent from a tainted emission is removed, whatever
            -- its status and whether or not it carries agent state.
            exists task

    @guidance
        -- Implementation: src/feed/exec.rs::degraded_partial_emission, the
        -- sibling of degraded_empty_emission and deliberately the same shape
        -- ((item_count, stderr) -> Option<reason>), applied once after the
        -- parse and before the sync in src/feed/cycle.rs::FeedCycle::run. The
        -- two predicates are mutually exclusive by their item_count arm, so
        -- the order they are applied in does not matter; the cycle applies
        -- the empty one first because it can return early.
        --
        -- The mode is src/feed/ingest/mod.rs::SyncMode {Reconcile, Additive},
        -- decided in FeedCycle::run and posted to the module as the `additive`
        -- flag of ingest_feed. It is an enum on the board so a call site cannot
        -- silently mean the opposite of what it reads.
        -- The module applies the flag in every strategy
        -- (spacetime/module/src/feed_ingest.rs): the per-epic stale delete is
        -- chosen through upsert_feed_tasks_inner's `delete_absent`, and the
        -- phases that exist only to remove (the subtree delete, the parent
        -- sweep, clearing absent sub-epics, dropping closed retired items) are
        -- skipped. A new removal path's obligation is to honour `additive`.
        --
        -- FeedIngestOutcome.removed is therefore empty on every additive path,
        -- so src/feed/mod.rs::cleanup_removed_feed_tasks is a no-op by
        -- construction rather than by a second guard.
        --
        -- KNOWN LIMIT of that choice: the destructive step has no defence of its
        -- own. Nothing at the teardown seam re-checks the mode — it cannot, the
        -- mode does not reach there — so a future path that leaks a row into
        -- `removed` on a degraded cycle destroys a worktree, which is this
        -- rule's whole subject. Empty-by-construction was preferred anyway
        -- because a second guard there would make the invariant ambiguous
        -- (which layer owns it?) while covering only the paths someone
        -- remembered to route through it. A new removal path's obligation is,
        -- again, to honour `additive` inside the module.
        --
        -- SURFACING. An additive cycle is not silent: a run that declines to
        -- remove anything must say so, or the user reads an unchanged board as
        -- a reconciled one. src/feed/cycle.rs::FeedCycleOutcome::Synced
        -- carries a `degraded: Option<String>` (the predicate's reason, which
        -- embeds the stderr) and the manual "r" refresh appends it to the
        -- success line — "Feed for '<title>': N task(s) synced (additive, no
        -- removals: <reason>)" — via FeedMessage::Refreshed. The auto-poll
        -- path logs at warn and adds nothing to the TUI, matching how it
        -- presents every other degraded outcome (FeedCommandFailure).
        --
        -- Coverage: inline unit tests on the predicate in src/feed/exec.rs —
        -- degraded_partial_when_items_present_and_stderr_present (fires),
        -- not_partially_degraded_when_zero_items and
        -- not_partially_degraded_when_no_stderr (both boundaries);
        -- src/feed/ingest/tests.rs, one per removal mechanism:
        -- additive_role_routed_sync_keeps_a_task_absent_from_the_emission,
        -- additive_role_routed_sync_keeps_parent_stranded_tasks,
        -- additive_grouped_sync_keeps_tasks_in_a_dropped_repo_sub_epic and
        -- additive_flat_sync_keeps_a_task_absent_from_the_emission, plus
        -- additive_role_routed_sync_still_moves_and_inserts (additive is "no
        -- removals", not "no writes");
        -- src/tui/tests/epics/feed_trigger.rs::feed_refreshed_degraded_says_it_removed_nothing
        -- (the status line names the withheld removals);
        -- src/feed/tests.rs::tick_partially_degraded_emission_does_not_delete_or_tear_down
        -- (auto-poll end to end, asserting the MockProcessRunner saw no
        -- `git worktree remove`) and the manual counterpart
        -- src/runtime/tests/feeds.rs::exec_trigger_epic_feed_partially_degraded_emission_does_not_delete.
        -- The boundary — a clean non-empty emission still reconciles and still
        -- tears down — is pinned by the pre-existing tests of UpsertFeedTasks
        -- and RoleRoutedFeedSync, which must stay green unmodified.
}

rule AppendOnlyFeed {
    when: FeedCommandCompleted(epic, items, stderr)

    -- An epic's standing declaration that its feed emits EVENTS, not STATE.
    --
    -- Every other feed epic MIRRORS an upstream: an open PR, an open CVE. The
    -- item is emitted for as long as the thing it describes is open, so its
    -- absence from a trusted emission is evidence that the thing closed, and
    -- the feed-as-source-of-truth removal in UpsertFeedTasks acts on that
    -- evidence.
    --
    -- Some sources have no "open" state to mirror. A log warning is the
    -- motivating one: it happened, once, at a point in time, and nothing
    -- upstream ever retracts it. Absence from a later emission is evidence of
    -- nothing at all — only that the scanned window moved on, or the file
    -- rotated. Read as a mirror, such a feed would tear down a task, and with
    -- it a worktree, a branch and a tmux window, on the very next poll after
    -- creating it.
    --
    -- core/Epic.feed_append_only = true is how an epic says which kind it is.
    -- The effect is exactly DegradedNonEmptyEmission's: the sync runs
    -- ADDITIVELY. Every write that follows from what the emission CONTAINS
    -- still happens — insert, field refresh, cross-role move — and every
    -- removal clause in UpsertFeedTasks, GroupedFeedUpsert, FlatFeedReconcile
    -- and RoleRoutedFeedSync is skipped. Because nothing is removed, no
    -- TaskTeardown runs.
    --
    -- WHY THE SAME MECHANISM AND NOT A NEW ONE. "Perform the insert-and-refresh
    -- half of a sync and none of the removal half" is behaviour the runtime
    -- already has; today it is reached only by accident, when a script
    -- soft-fails. An append-only epic wants it deliberately and permanently.
    -- A second mechanism with the same postcondition would be a second thing
    -- to keep correct, and the two would drift. There is exactly one additive
    -- path, and both causes reach it.
    --
    -- HOW SUCH A TASK IS EVER CLOSED. By the user, never by the feed. The user
    -- completes the task and then deletes it (tasks.allium: DeleteTask). The
    -- delete writes a core/RetiredFeedItem keyed on this epic, and ingest
    -- never inserts a task for a retired id (see "Retired feed items" below),
    -- so a later emission carrying the same external_id creates nothing. On an
    -- append-only epic that record is permanent: every cycle here is additive,
    -- and only a trusted mirroring cycle ever drops a record
    -- (DropClosedRetiredFeedItems). Deleting the append-only epic itself is
    -- the one reset — its records go with it.
    --
    -- A task left in done rather than deleted keeps its row, and the match
    -- arm of UpsertFeedTasks finds it on every later poll, so the
    -- status-preservation clause leaves it in done. ACCEPTED CONSEQUENCE:
    -- every later poll re-applies the item's title, description, tag, labels
    -- and sort_order to that done task and bumps updated_at — for as long as
    -- the source keeps emitting the id. This is ordinary UpsertFeedTasks
    -- behaviour rather than anything new; column ordering is by sort_order —
    -- or, in Done, by completed_at — rather than updated_at (core/Task), so
    -- the churn reorders nothing a user sees. Deleting the task ends it.
    --
    -- INTERACTION WITH THE DEGRADED-EMISSION RULES. The causes of additivity
    -- are independent and neither overrides the other; additive is their
    -- union. An append-only epic whose command also writes to stderr is
    -- additive for both reasons, with the same single effect.
    -- DegradedEmptyEmission still suppresses the whole sync, and this rule's
    -- guard defers to it: being append-only is not a reason to trust a
    -- zero-item emission from a command that reported an error. The guard
    -- likewise defers to FeedCommandFailure on a non-zero exit. This rule
    -- fires only where a sync would have run anyway, and changes only whether
    -- that sync removes.
    --
    -- THE FLAG IS NOT RETROACTIVE, IN EITHER DIRECTION. Turning it ON stops
    -- future removals; it does not restore a task an earlier trusted cycle
    -- already removed. Turning it OFF makes the very next cycle a mirroring
    -- one, which removes every accumulated task the current emission does not
    -- name — for a log feed, potentially all of them. That is the honest
    -- consequence of the flag meaning what it says, and it is why the flag
    -- belongs to wiring an epic up rather than to a board keybinding. The epic
    -- header does still SURFACE the flag, read-only and with no key hint
    -- precisely because there is no key (epics.allium: AppendOnlyEpicIndicator).

    -- NOT COMBINABLE WITH GROUPING OR A FEED ROLE. An epic may be append-only
    -- OR grouped/role-routed, never both, and the write path REFUSES the pair
    -- (epics.allium: UpdateEpicViaMcp). This was first imposed as a
    -- conservative guard against a migration deadlock, pending a decision on
    -- whether the combination was wanted at all. THAT DECISION IS NOW MADE and
    -- the answer is no: the restriction is permanent, and the reason is the
    -- grouping KEY, not the sync machinery.
    --
    -- REPO IS A MIRRORING FEED'S KEY. Every mirroring feed's item IS a
    -- repo-scoped thing — a PR, a CVE, a Dependabot alert each belongs to
    -- exactly one repo and carries that repo's URL as its own. group_by_repo
    -- partitions such an emission along an axis its items already have.
    --
    -- AN EVENT FEED'S ITEMS ARE NOT KEYED BY REPO. They are keyed by where in
    -- the code they fired. A log record's identity is its level, its emitting
    -- module and its static message head; the record carries no URL at all.
    -- The url such an item does carry is a single configured repo root, set
    -- for one unrelated purpose: so dispatch can resolve a local clone and the
    -- card can be dispatched into a worktree. Grouping by repo would therefore
    -- partition EVERY item into one sub-epic named after that repo — or, with
    -- no repo configured, into one named "other" (repo_name(url)'s fallback).
    -- Grouping by a constant: a level of nesting and no information.
    --
    -- AND A MULTI-REPO EVENT FEED DOES NOT RESCUE IT. Given one epic scanning
    -- several repos' logs, repo is the least useful of the axes those items
    -- carry. Level and occurrence count are already a label and sort_order;
    -- the module is the locus a fix lands in, and it is what such a board
    -- wants grouped. group_by_repo is the only grouping key the runtime has.
    -- So the want that would justify combining the two is not "group my log
    -- feed by repo" but "group it by module" — a different feature, and one
    -- nothing has asked for.
    --
    -- WHAT TO DO INSTEAD, at no cost in code: ONE FLAT APPEND-ONLY EPIC PER
    -- REPO, all under a common parent. FeedTick schedules off a flat epic
    -- list, so a feed epic nested under a parent is polled exactly like a root
    -- one. That yields the same board shape and the same status rollup as
    -- grouping would, and adds a per-repo cadence and a per-repo off switch
    -- that a single grouped epic could not offer. This is the supported route,
    -- and the refusal message points at it.
    --
    -- THE MIGRATION IS NOT THE REASON. Every path re-homes an existing task
    -- as a MOVE of the row — FlatFeedReconcile's re-home, RoleRoutedFeedSync's
    -- move and GroupedFeedUpsert's migration by move — and a move removes
    -- nothing, so it runs on an additive cycle too. An additive epic would
    -- not be stuck un-migrated; the refusal rests on the argument above alone.
    -- Consequently there is no reason to split SyncMode's single permission in
    -- two ("may I delete because absent" versus "do I trust this emission
    -- enough to migrate"); that proposal is retired.

    -- A degraded emission on an append-only epic is DegradedEmptyEmission's
    -- or DegradedNonEmptyEmission's, never this rule's, so exactly one rule
    -- answers each completed run. The non-empty one posts additively too, so
    -- the result is the same; it also carries the degraded reason to the
    -- status line.
    requires: epic.feed_append_only and stderr = ""

    ensures:
        -- The sync runs exactly as for a trusted emission (the module picks
        -- the strategy), with removals disabled — permanently, for this epic.
        FeedEmissionPosted(epic: epic, items: items, additive: true,
                           host: core/local_host())
        for task in epic.subtree_tasks where task.external_id != null:
            -- Absence from an append-only feed's emission is not evidence of
            -- anything, so nothing is removed, whatever its status and whether
            -- or not it carries agent state.
            exists task

    @guidance
        -- Implementation: the flag is read alongside the two degraded
        -- predicates in src/feed/cycle.rs::FeedCycle::run, which selects
        -- src/feed/ingest/mod.rs::SyncMode::Additive when EITHER a degraded
        -- predicate fires OR the epic is append-only. Everything below that
        -- point — the `additive` flag of the module's ingest_feed
        -- (IngestFeedEmission) and every strategy it runs — is untouched by
        -- this rule: it already implements "no removals" and does not care
        -- why it was asked for.
        --
        -- SURFACING. An append-only cycle is a normal, healthy cycle, so it
        -- is NOT reported the way a degraded one is. DegradedNonEmptyEmission
        -- appends "(additive, no removals: <reason>)" to the manual-refresh
        -- status line because withholding removals there is a symptom; here
        -- it is the configured behaviour, and reporting it every poll would
        -- train the user to ignore the line that matters. A cycle that is
        -- additive for BOTH reasons still reports the degradation.
        --
        -- Coverage: src/feed/cycle.rs for the three mode-selection cases this
        -- rule adds — append-only alone, append-only alongside a degraded
        -- emission, and the clean mirroring boundary that must keep removing.
        -- Degraded-alone is NOT here; it belongs to DegradedNonEmptyEmission
        -- and is covered where that rule's own guidance says it is.
        -- src/feed/ingest/tests.rs covers the reconcile behaviour, reusing the
        -- existing additive_* assertions rather than duplicating them, and
        -- src/store/tests/tasks_feed/insert_and_retired.rs covers the retirement claim above
        -- (upsert_feed_tasks_inserts_no_task_for_a_retired_external_id).
}

-- == Retired feed items ==

-- A core/RetiredFeedItem records an external_id the user deleted from a feed
-- epic's subtree (tasks.allium: DeleteTask, BatchDelete; epics.allium:
-- DeleteEpic). It exists so that delete means "I am done with this item"
-- rather than "show it to me again on the next poll".
--
-- Ingest skips retired items. No sync path ever INSERTS a task for an id
-- retired under the feed epic whose cycle emitted it — flat, grouped and
-- role-routed alike, reconcile and additive alike:
--
--   - is_retired(feed_epic, external_id): a RetiredFeedItem with that
--     (feed_epic, external_id) exists.
--   - retired_without_task(epic, item): is_retired(epic, item.external_id),
--     and no task anywhere in epic's subtree carries item.external_id.
--
--   * UpsertFeedTasks refuses the insert when
--     is_retired(epic.nearest_feed_epic, item.external_id). Every path's
--     insert goes through it, so this is the one clause that makes the
--     guarantee hold everywhere.
--   * GroupedFeedUpsert and RoleRoutedFeedSync additionally drop
--     retired_without_task items BEFORE any sub-epic is found-or-created for
--     them, so a feed whose only new item for some repo is a retired one
--     creates no empty repo sub-epic to hold it.
--
-- Suppression covers insertion only. A task that is still on the board with a
-- retired id — the migration's worktree-holding survivors (epics.allium:
-- ArchivedStatusMigration) are the case that produces one — is matched,
-- refreshed, moved and, on a trusted cycle, removed as stale exactly like any
-- other feed task. Filtering it out of the emission instead would make a
-- mirror cycle read it as absent and tear its worktree down.
--
-- Retirement keys on the FEED EPIC (the nearest epic in the chain with a
-- feed_command), never on the sub-epic the task sat in. A grouped feed's repo
-- sub-epic or a role-routed feed's role sub-epic can be emptied and deleted,
-- or an item can be re-routed to a different role, without the record going
-- stale.
--
-- retired_without_task's subtree walk runs inside the module's ingest_feed,
-- over every row the store holds, not over the poll owner's subscribed view
-- (IngestFeedEmission).

rule DropClosedRetiredFeedItems {
    when: FeedIngested(epic, items, additive)

    -- Only a trusted, mirroring cycle is evidence that an item closed.
    requires: not additive

    ensures:
        for item in core/RetiredFeedItems where item.feed_epic = epic:
            if not items.any(i => i.external_id = item.external_id):
                not exists item

    @guidance
        -- A mirroring feed emits an item for as long as the thing upstream is
        -- open. Once a trusted emission no longer carries a retired id, the
        -- upstream item has closed, and the record has done its job. Dropping
        -- it is what lets a later REOPEN of the same PR or CVE show up on the
        -- board again as a fresh task, rather than staying suppressed forever
        -- because the user once deleted an earlier incarnation.
        --
        -- `items` is the FULL PARSED emission — the one FeedEmissionPosted carries,
        -- before any path-specific filter runs. RoleRoutedFeedSync drops
        -- ExcludeFromReviews items before building its own keep-set; reading
        -- the keep-set here would drop the record of an excluded-but-open PR
        -- and let it back in the moment it stopped being excluded. An item the
        -- source still emits is still open, whatever a later filter makes of
        -- it.
        --
        -- ADDITIVE CYCLES NEVER DROP, for either cause. Under AppendOnlyFeed
        -- absence is evidence of nothing, so an append-only epic keeps its
        -- records forever; under DegradedNonEmptyEmission this particular
        -- absence is not trusted. DegradedEmptyEmission and FeedCommandFailure
        -- post no emission at all, so they cannot reach this rule. The
        -- same asymmetry governs task removal, for the same reason: a dropped
        -- record, like a removed task, costs the user something they chose.
        --
        -- The drop is per feed epic: only records keyed on the epic this
        -- cycle ran for are candidates.
}

-- Strategy precedence: the single dispatch point for feed upsert. Every dispatch
-- carries the cycle's MODE alongside the emission: reconcile (the default —
-- write what the emission contains, remove what it omits) or additive (write
-- what it contains, remove nothing). The mode is decided once per cycle by
-- TrustedEmission, DegradedNonEmptyEmission and AppendOnlyFeed, on the board,
-- and is orthogonal to the routing below, which the module does: all three
-- paths honour it, and none of them re-decides it. Each strategy rule listens
-- for FeedIngested and its requires clauses make the three exclusive.
-- Routing precedence by core/Epic.feed_role:
--   1. feed_role = reviews_parent -> RoleRoutedFeedSync (subtree reconcile).
--   2. otherwise epic.group_by_repo = true -> GroupedFeedUpsert.
--   3. otherwise -> FlatFeedReconcile: first re-home any tasks stranded in the
--      epic's RepoGroup sub-epics back to the parent and delete the
--      now-empty sub-epics, THEN UpsertFeedTasks on the parent. The re-home
--      step is the OFF-side counterpart to GroupedFeedUpsert's ON-side
--      migration; it heals a feed epic whose grouping was just toggled off
--      (epics.allium ToggleGroupByRepo), which flips the flag but moves no task
--      synchronously. When the epic has no RepoGroup sub-epics this reduces to
--      a plain UpsertFeedTasks.
-- The reviews_parent path lives in its own function (ingest_role_routed),
-- separate from ingest_flat and ingest_grouped, because it orchestrates a
-- whole subtree rather than an epic's own emission. The WHOLE feed_role
-- dispatch — including the reviews_parent -> ingest_role_routed branch, not just the
-- flat/group_by_repo branches — lives in ONE shared dispatcher function,
-- spacetime/module/src/feed_ingest.rs::ingest_feed, which BOTH FeedRunner.tick
-- (auto-poll) and exec_trigger_epic_feed (manual "r") delegate to. Because the
-- switch is centralised in that single function rather than duplicated per
-- caller, the two paths are structurally identical — not merely behaviourally
-- equivalent by convention — for every feed_role. A manual refresh therefore
-- cannot fall back to a flat upsert for an epic whose feed_role selects a
-- different path; doing so would strand feed tasks in the wrong epic (the
-- reviews_parent parent-flat bug).
--
-- Implementation: spacetime/module/src/feed_ingest.rs::ingest_feed is the
-- shared role->path dispatcher; it reads feed_role and group_by_repo from the
-- epic's own row and runs ingest_flat, ingest_grouped or ingest_role_routed.
-- Both runtime paths reach it through src/feed/ingest/mod.rs::ingest_emission
-- and the single shared
-- src/feed/cycle.rs::FeedCycle::run, which passes neither feed_role nor
-- group_by_repo; neither surface performs its own feed_role switch, and
-- neither can pass a stale one down.

-- == Manual trigger ==

rule ManualFeedTrigger {
    when: ManualFeedRefresh(epic)

    -- A feed epic is any Epic where feed_command != null. The "r" key is
    -- only active when such an epic is selected (card highlighted on the
    -- kanban board, or focused inside the Epic view). Pressing "r" on a
    -- non-feed epic has no effect.
    --
    -- The command runs immediately — it does not wait for the next
    -- FeedTick interval. The FeedRunner's last_run timestamp for this
    -- epic is NOT updated by the manual trigger; the next automatic poll
    -- fires at its normal scheduled time.
    --
    -- What the operator sees for each outcome is FeedRefreshStatusLine's.
    --
    -- WHERE IT RUNS. Only the epic's poll owner reconciles it
    -- (SerialisedFeedCycle, scope across hosts):
    --   - this host is the poll owner: the cycle runs here, as below;
    --   - no poll owner yet: this host claims first and runs the cycle only
    --     once the claim is answered and the owner read back is this host,
    --     as FeedTick's claim then run does;
    --   - another host is (or won the claim and became) the owner: nothing
    --     runs here. The board asks the owner instead
    --     (store-split.allium: RequestFeedRefresh), which serves the request
    --     on its next poll tick (ServeFeedRefreshRequest). An accepted ask
    --     shows the poll-owner line; a refused one (for example the owner is
    --     another person's host) shows the failure line with the module's
    --     reason.
    requires: epic.feed_command != null

    -- FeedCommandRunsOnSettersHost: a host whose owner did not set the
    -- command runs nothing, and neither claims nor asks: the setter is checked
    -- before the poll owner is consulted.
    let setter = epic.feed_command_set_by ?? epic.created_by

    ensures:
        if core/local_host().owner = setter:
            if not exists core/PollOwner{scope: epic, scope_id: epic.id}:
                core/PollOwner.created(
                    scope: epic,
                    scope_id: epic.id,
                    host: core/local_host(),
                    claimed_at: now
                )
            if core/PollOwner{scope: epic, scope_id: epic.id}.host = core/local_host():
                FeedCycleRequested(epic: epic)
            else:
                split/FeedRefreshRequested(epic: epic, host: core/local_host())

    @guidance
        -- Implementation: src/runtime/epics.rs::exec_trigger_epic_feed, which is
        -- presentation only — it builds a src/feed/cycle.rs::FeedCycle, awaits
        -- it, and maps the outcome onto the status lines above. The
        -- dropped arm is a distinct FeedMessage variant (AlreadyRefreshing),
        -- not a Failed with a special string, so the status bar cannot blame the
        -- user's feed command for a serialisation decision. The poll-owner arm
        -- is likewise its own variant (OwnerWillRefresh), not a
        -- Refreshed with a zero count.
        -- Keybinding: src/tui/input/normal.rs::run_normal, action refresh_feed.
        -- The keypress gate ("is this a feed epic at all?") is still answered
        -- from the TUI's loaded board in
        -- src/tui/update/feeds.rs::App::handle_trigger_epic_feed — that is this
        -- rule's requires clause and cached data is fine for it. But the values
        -- the cycle ACTS on are never passed down from that snapshot:
        -- feed_command and feed_append_only are read fresh from the epic inside
        -- FeedCycle::run, and feed_role and group_by_repo are read by the
        -- module's ingest_feed from the epic's own row, so a manual refresh
        -- cannot run a command or a grouping mode the user has since changed.
        -- The module picks the strategy by epic.feed_role IDENTICALLY to the
        -- auto-poll path (see "Strategy precedence" above): feed_role =
        -- reviews_parent -> ingest_role_routed; otherwise
        -- group_by_repo=true -> ingest_grouped / false -> ingest_flat, all
        -- inside the one reducer. A manual "r" refresh on a reviews_parent
        -- epic therefore routes into the My/Team/Bots subtree and never
        -- flat-upserts into the parent. Coverage:
        -- src/runtime/tests/feeds.rs (manual trigger on a reviews_parent epic routes
        -- like auto-poll and strands no feed task on the parent);
        -- src/runtime/tests/feeds.rs::exec_trigger_epic_feed_fails_on_degraded_empty_emission
        -- and exec_trigger_epic_feed_degraded_empty_emission_does_not_delete_existing_tasks
        -- (the failure line, and that no sync ran behind it);
        -- src/runtime/tests/feeds.rs::exec_trigger_epic_feed_removed_task_tears_down_its_worktree
        -- (the manual path also hands its FeedIngestOutcome.removed to
        -- src/feed/mod.rs::cleanup_removed_feed_tasks).
        -- FeedCommandFailure (auto-poll failures) remains silent — only
        -- manual trigger failures surface in the status bar.
}

-- == Serving feed requests ==

rule ServeFeedRefreshRequest {
    when: FeedRequestPickedUp(request)

    requires: request.kind = refresh
    requires: request.host = core/local_host()
    -- A board serves only rows its own owner asked for. A row another
    -- identity wrote is logged and left alone (the module's D11 check on the
    -- write is the first line, this the second).
    requires: request.requested_by = core/local_host().owner

    let epic = request.epic
    let setter = epic.feed_command_set_by ?? epic.created_by

    ensures:
        -- Claimed first; nothing runs unless the claim is accepted.
        split/FeedRequestDelivered(request: request, host: core/local_host())
        if not exists epic:
            split/FeedRequestFailed(request: request, reporter: core/local_host(),
                                    reason: "epic no longer exists")
        else if core/local_host().owner != setter:
            split/FeedRequestFailed(request: request, reporter: core/local_host(),
                                    reason: "this host's owner did not set the command")
        else if poll_owner(epic) != core/local_host():
            split/FeedRequestFailed(request: request, reporter: core/local_host(),
                                    reason: "this host no longer owns the poll")
        else:
            -- ONE cycle, through the same per-process claim as every other
            -- cycle for the epic (SerialisedFeedCycle). An epic whose
            -- feed_command was cleared reaches the cycle and fails there
            -- (FeedCommandFailure bucket 5), which fails the row.
            FeedCycleRequested(epic: epic)

    @guidance
        -- Driven by FeedTick, which picks the row up on the owner's next poll
        -- tick whatever the epic's interval. FeedCommandRunsOnSettersHost is
        -- RE-CHECKED here, against the epic as it is now: the command may
        -- have been re-set by someone else since the request was written.
        -- So is the poll ownership: a request written for a host that has
        -- since lost the poll (OverrideFeedOwner, a loss of sight) is failed,
        -- not run, so two hosts never reconcile one epic.
        -- As for ManualFeedTrigger, the epic's last_run is NOT updated: the
        -- next automatic poll fires at its normal time.
        -- Implementation: src/feed/mod.rs::FeedRunner::spawn_refresh_request.
        --
        -- THE OUTCOME, reported by reducer call once the cycle ends
        -- (store-split.allium: HostReportsFeedRequestDone,
        -- HostReportsFeedRequestFailed):
        --   - the cycle synced (trusted or additive): done;
        --   - the cycle was DROPPED because one for the epic was already in
        --     flight: done, since that cycle reconciles the epic just as
        --     well, and the asker wanted the epic refreshed, not a second
        --     exec;
        --   - the cycle failed (FeedCommandFailure, DegradedEmptyEmission):
        --     failed, with the cycle's error as the reason.
        -- The serving board shows no status line: the asking board already
        -- showed its own, and the owner's cycle presents like an auto-poll
        -- (silent on failure, FeedCommandFailure). The cycle's own
        -- notification refreshes every board that sees the epic.
        --
        -- The cycle tears down the removed tasks this host holds before it
        -- notifies, and leaves teardown requests for the rest
        -- (RoleRoutedFeedSync's teardown fan-out), exactly as an auto-poll
        -- cycle does.
}

rule ServeFeedTeardownRequest {
    when: FeedRequestPickedUp(request)

    requires: request.kind = teardown
    requires: request.host = core/local_host()
    requires: request.requested_by = core/local_host().owner

    ensures:
        split/FeedRequestDelivered(request: request, host: core/local_host())
        FeedTaskReleased(
            repo_path: request.repo_path,
            worktree: request.worktree,
            tmux_window: request.tmux_window
        )

    @guidance
        -- The same teardown the ingesting host performs for its own removed
        -- tasks in the cycle (tasks.allium: TaskTeardown, via
        -- src/feed/mod.rs::cleanup_removed_feed_tasks): the tmux window
        -- killed, the git worktree removed, the branch (derived from the
        -- worktree) deleted, best effort and warn-logged. Rows of one repo
        -- are torn down one after another, since git worktree remove and
        -- branch -D contend on the shared checkout's index lock; different
        -- repos run in parallel. Read from the row's snapshots, because the
        -- task row is gone.
        --
        -- THE OUTCOME: done when the teardown finishes, failed with its error
        -- otherwise (store-split.allium: HostReportsFeedRequestDone,
        -- HostReportsFeedRequestFailed). A worktree or window already gone
        -- counts as torn down, so serving a row again after a crash is safe.
        --
        -- No deadline: a host offline for days serves the row when its board
        -- next starts, and the row is never pruned while open.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- One feed cycle at a time per epic (prose invariant, enforced by
-- SerialisedFeedCycle): at most one feed cycle per epic is in flight at any
-- moment. Stated as prose because a cycle is an in-process activity, not entity
-- state — there is nothing to quantify over.
--
-- This is what makes RoleRoutedFeedSync's keep-set sound. Its steps run in one
-- module transaction, so two cycles cannot interleave INSIDE the sync; but each
-- cycle's keep-set comes from the emission it fetched, and the argument that "a
-- task in the subtree but absent from this emission is stale" holds only if no
-- other cycle for the same epic wrote between this cycle's exec and its sync.
-- Because the stale-delete feeds TaskTeardown, breaking it destroys a live
-- agent's worktree rather than merely losing a row.
--
-- Deliberately scoped to "another CYCLE", not "another writer": a concurrent
-- non-feed writer moving a task into the reconciled subtree can still produce
-- the same outcome. See SerialisedFeedCycle's scope paragraph.

-- A reviews_parent epic is a pure router: it holds NO feed-managed task
-- directly. Every feed task (external_id != null) in its subtree lives in one
-- of the role sub-epics (my_reviews / team_reviews / bots) or their children,
-- never flat on the parent. RoleRoutedFeedSync maintains this by moving any
-- parent-stranded feed task down to its routed role sub-epic and by deleting
-- stale parent-stranded feed tasks. A violation means an emission bypassed the
-- role router with a flat upsert.
-- Manual (external_id = null) tasks on the parent are permitted and unaffected.
invariant NoFlatFeedTasksOnReviewsParent {
    for epic in core/Epics where feed_role = reviews_parent:
        not epic.subtasks.any(t => t.external_id != null)
}

-- The floor binds the RESOLVED cadence, not merely the stored one, so the
-- fallback an unset epic inherits must itself clear the floor. Were
-- default_feed_interval to sink below min_feed_interval, leaving the field
-- blank would poll faster than the fastest value a user is permitted to
-- enter, and the floor would be advice rather than a bound. The two are equal
-- today; raising the default is safe, lowering it past the floor is not.
invariant DefaultFeedIntervalClearsTheFloor {
    core/config.default_feed_interval >= core/config.min_feed_interval
}

-- FEED COMMANDS RUN ON THE SETTER'S HOST. A host runs an epic's
-- feed_command, whether for FeedTick's auto-poll or for the "r" refresh, only
-- when the host's OWNER is the person who last set it. Seeing an epic,
-- following it, or holding its claim does not let a person's host run a
-- command somebody else wrote. A shared feed is therefore polled by its
-- setter's host alone, and pauses while that host is offline. A null
-- feed_command_set_by (a command that predates the column) counts as set by
-- created_by.
--
-- There is no one gate rule: each surface that requests a cycle checks the
-- setter itself, because each refuses in its own way. Four enforcement
-- points, so no single one is the only guard:
--   1. Module: claim_poll_owner and override_poll_owner refuse a claim on a
--      feed epic by a host whose owner is not the setter
--      (store-split.allium: ClaimPollOwner), and FeedCommandAuthority drops
--      every other host's claim when the command changes hands. That is the
--      invariant below.
--   2. FeedTick: src/models/poll_action.rs::decide_feed_poll_action skips an
--      epic this host's owner did not set, claimed or not.
--   3. ManualFeedTrigger: the "r" key refuses, and says so on the status
--      line (FeedRefreshStatusLine).
--   4. ServeFeedRefreshRequest: the poll owner re-checks the setter before
--      running a refresh another host asked for, and fails the row when it no
--      longer holds (the command was re-set by someone else after the
--      request).
--
-- CLAIMS FROM BEFORE THE RULE (a one-time sweep). Only a NEW claim is gated,
-- so a claim a non-setter's host took before the rule would stall the feed
-- for good: that host may no longer run the command and skips, and the
-- setter's host sees the claim and skips too. When a store moves onto rules
-- version 37, its first connection releases every epic-scoped claim on a
-- feed epic held by a host whose owner is not the setter (or by a host no
-- longer registered), once. It is not a standing rule: from then on
-- enforcement point 1 refuses such a claim.
-- Module: spacetime/module/src/config.rs::release_claims_of_non_setter_hosts,
-- called by stamp_rules_version_on_connect. The in-memory store starts empty
-- on every connection and has no stored claims to sweep.
invariant FeedCommandRunsOnSettersHost {
    for claim in core/PollOwners:
        for e in core/Epics:
            (claim.scope = epic and claim.scope_id = e.id and e.is_feed)
                implies claim.host.owner = (e.feed_command_set_by ?? e.created_by)
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The board keys this spec owns. The "r" key reaches ManualFeedTrigger and
-- the yes answer to epics.allium's feed-ownership take-over prompt reaches
-- OverrideFeedOwner; neither listens to keybindings.allium's KeyActionRun.
surface FeedBoardKeys {
    facing _: core/Operator

    provides:
        -- [r] (keybinding action refresh_feed) on a selected feed epic: its
        -- card highlighted on the board, or focused inside the Epic view. On
        -- a non-feed epic the key has no effect.
        ManualFeedRefresh(epic)
        -- [y] or [Y] on epics.allium's FeedOwnerTakeoverOffered prompt ("This
        -- feed is currently owned by host <host> — take over polling? [y/N]").
        -- Any other answer emits nothing.
        OverrideFeedOwner(epic)
}

-- The status line the "r" key answers with: ManualFeedTrigger's outcome as
-- the operator reads it. An auto-poll cycle shows nothing
-- (FeedCommandFailure is silent); only the "r" key reports.
surface FeedRefreshStatusLine {
    facing _: core/Operator

    context epic: core/Epic

    exposes:
        manual_refresh_status_line(epic)

    @guarantee OneLinePerOutcome
        --   - On start: "Fetching feed for '<title>'…"
        --   - On success: "Feed for '<title>': N task(s) synced"
        --   - On a DEGRADED additive success (DegradedNonEmptyEmission): the
        --     same line with a suffix naming why nothing was removed — "Feed
        --     for '<title>': N task(s) synced (additive, no removals:
        --     <reason>)". A cycle that declined to reconcile must not present
        --     as one that reconciled and found nothing to do. An append-only
        --     epic's cycle is additive by configuration and shows the plain
        --     success line (AppendOnlyFeed, SURFACING).
        --   - On failure, DegradedEmptyEmission included (its <error> is the
        --     stderr text): "Feed for '<title>' failed: <error>"
        --   - When SerialisedFeedCycle DROPS the request: "Feed for '<title>'
        --     is already refreshing…"
        --   - When ANOTHER HOST owns the poll and accepted the ask: "Feed for
        --     '<title>': the poll owner (<host>) will refresh it". A refused
        --     ask (for example the owner is another person's host) shows the
        --     failure line with the module's reason.
        --   - When this host's owner did not set the command
        --     (FeedCommandRunsOnSettersHost): "Feed for '<title>' runs only
        --     on its author's host"
        --   - When the epic was deleted between the keypress and the setter
        --     check: the failure line, "Feed for '<title>' failed: epic no
        --     longer exists", as for the cycle's own bucket 5. It is not
        --     blamed on the host.

    @guarantee OwnerLineIsNeitherSuccessNorFailure
        -- Nothing ran here, and the line promises only that the owner has
        -- been asked. If the owner is offline the refresh waits for it, and a
        -- request it has not picked up within store-split.allium's
        -- config.stale_refresh_request_window is pruned.

    @guarantee DroppedLineIsNeitherSuccessNorFailure
        -- A cycle for this epic was already in flight, so this request ran
        -- nothing at all. It is surfaced rather than swallowed because the
        -- alternative is a keypress that looks like a no-op. It means "a
        -- cycle is running", not "fresh data is arriving imminently": if that
        -- cycle is stuck on a hung command, every later "r" reports this for
        -- up to feed_command_timeout (core.allium config) before the feed
        -- recovers on its own (SerialisedFeedCycle, bounded cost).

    @guarantee NoZeroItemStderrHint
        -- The success line has no zero-item stderr hint: zero items with
        -- stderr is DegradedEmptyEmission, which shows the failure line. The
        -- additive suffix fires on the OPPOSITE arm (N > 0 with stderr), and
        -- it reports a decision dispatch took — removals were withheld —
        -- rather than merely pointing at the log.

    @guidance
        -- Implementation: src/runtime/epics.rs::exec_trigger_epic_feed maps the
        -- src/feed/cycle.rs::FeedCycle outcome onto these lines. The dropped
        -- arm is its own FeedMessage variant (AlreadyRefreshing) and the
        -- poll-owner arm another (OwnerWillRefresh), so neither can be shown
        -- as a failure or as a zero-count success.
}
