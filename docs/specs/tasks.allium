-- allium: 3
-- tasks.allium
--
-- Scope: Task lifecycle — creation, status movement, reorder, delete, copy, editor,
--        and the board-wide multi-selection the batch rules consume.
-- Excludes: Agent health and hooks (see agent-health.allium);
--           dispatch and retry (see dispatch.allium);
--           PR/wrap-up (see pr-workflow.allium);
--           split pane (see split-pane.allium);
--           MCP task tools (see mcp-task-tools.allium);
--           epic lifecycle (see epics.allium);
--           domain model (see core.allium).

use "./core.allium" as core
use "./board-layout.allium" as board_layout
use "./settings.allium" as settings
use "./store-split.allium" as split

-- The one board-wide multi-selection every batch rule in this file
-- consumes. See "Multi-Selection".
given {
    selection: BoardSelection

    -- The one set of folded sub-status sections, consumed by
    -- ToggleSectionCollapse. See board-layout.allium: "Collapsed Sections".
    collapsed_sections: board_layout/CollapsedSections

    -- The one set of folded epic groups, consumed by ToggleEpicFold. See
    -- board-layout.allium: "Epic Folding".
    folded_epics: board_layout/FoldedEpics
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- BoardSelection is a runtime-only UI concept (not persisted): the set of
-- tasks and epics the user has multi-selected. The batch rules in this file
-- consume it.
--
-- There is exactly one BoardSelection. It is board-wide, not per-column:
-- selecting items in one column and then another leaves both sets
-- selected, and the selection outlives moving the cursor between columns.
--
-- The action that fills it, and the two independent things called
-- "select all", are specified in "Multi-Selection" below.
entity BoardSelection {
    selected_tasks: Set<core/Task>
    selected_epics: Set<core/Epic>

    is_empty: selected_tasks.count = 0 and selected_epics.count = 0

    @guidance
        -- Session-scoped and never persisted: it does not survive an app
        -- restart, and nothing in the database records it.
        -- A card in either set renders with a leading `*` and a bold title
        -- (board-visuals.allium: "Selection").
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Task Creation ==

rule CreateTask {
    when: CreateTask(title, description, repo_path, plan?, epic?, tag?, sort_order?, base_branch?, wrap_up_mode?, model?, auto_run_plan?, phoenix?)

    ensures: core/Task.created(
        title: title,
        description: description,
        repo_path: repo_path,
        status: backlog,
        sub_status: default_sub_status(backlog),
        plan_path: plan,
        epic: epic,
        tag: tag,
        sort_order: sort_order,
        base_branch: base_branch ?? detect_default_branch(repo_path),
        wrap_up_mode: wrap_up_mode,
        model: model,
        auto_run_plan: auto_run_plan ?? false,
        phoenix: phoenix ?? false,
        created_at: now,
        updated_at: now
    )

    @guidance
        -- tag is chosen in the TUI creation form's tag-picker step, a
        -- single-keypress picker. The accepted keys are: b -> Bug,
        -- f -> Feature, c -> Chore, v -> PrReview, r -> Research,
        -- x -> Fix, and p -> arm the phoenix flag (see PhoenixArming
        -- below). Enter means "no explicit pick"; Esc cancels creation. Any
        -- other key is silently ignored and the picker stays open.
        -- Dependabot and ReleasePlease have no key: both are set by feed
        -- scripts from a PR's author (feed-scripts.allium), and a hand-made
        -- task reaches either only through the MCP tools' tag parameter
        -- (create_task, update_tasks), whose enum is every core/TaskTag.
        --
        -- EveryKeyInItsName. Each key is a letter of the label it selects, so
        -- the hint reads b -> "[b]ug", v -> "pr-re[v]iew", x -> "fi[x]". The
        -- key is never a mnemonic sitting outside the word. This is why
        -- PrReview is v and not p: p belongs to "[p]hoenix", and moving
        -- PrReview to "pr-re[v]iew" keeps both keys inside their own labels.
        --
        -- EnterKeepsTheDraft. Enter does not clear tag — it leaves whatever
        -- the draft already holds. For the manual creation form the draft
        -- holds null, so Enter still means "no tag". For CopyTask (below),
        -- which seeds the draft from the source task, Enter keeps the copied
        -- tag rather than silently dropping it. This is the same rule
        -- SetWrapUpMode's picker step already follows, and for the same
        -- reason.
        --
        -- That accepted set is advertised by THREE separate hint surfaces,
        -- one per place the picker step is visible:
        --   1. the transient status message set when the step is entered;
        --   2. the input-panel form hint (the active line of the "New Task"
        --      wizard panel);
        --   3. the status-bar hint rendered while InputTag is the mode.
        -- All three must advertise exactly the handler's accepted set, and no
        -- key outside it. The set has two variants (see PhoenixArming), so all
        -- three surfaces derive their text from ONE prompt value per variant
        -- rather than each carrying its own literal.
        --
        -- PhoenixArming. Pressing p at the tag picker does not pick a tag: it
        -- arms phoenix on the draft and re-opens the SAME picker step with p
        -- removed from the accepted set, so the operator then picks the
        -- task's actual tag. Phoenix is orthogonal to tag (see WhyNotATag
        -- below), so it cannot be one of the tag values — but it is answered
        -- at the same keypress, which is why it lives here rather than in a
        -- step of its own. The re-opened picker is the same step, not a new
        -- one: Esc still cancels the whole form (it does not step back and
        -- disarm phoenix), Enter still means "no explicit pick", and a second
        -- p is now among the silently-ignored keys. The prompt is the
        -- first-pass prompt minus "[p]hoenix" — the panel shows the armed
        -- flag as a settled "Phoenix: yes" line above the active picker line
        -- rather than restating it in the prompt.
        --
        -- Once phoenix is armed, every later step of the form shows it inside
        -- the settled tag line — "Tag: bug (phoenix)", or "Tag: none
        -- (phoenix)" when no tag was picked — so the decision stays visible
        -- through to creation without any step growing an extra line.
        --
        -- There is NO separate phoenix step. The form's steps are, in order:
        -- InputTitle -> InputTag -> InputDescription -> InputRepoPath ->
        -- InputBaseBranch -> InputWrapUpMode -> InputModel -> created. phoenix is decided at
        -- InputTag, before the fields that follow it, and the ordinary
        -- non-phoenix task costs no keypress at all for the flag: not pressing
        -- p IS declining it.
        --
        -- SettledLinesStayOneRow. Every settled line the form restates above
        -- the active field (Title, Tag, Description, Repo path, Base branch,
        -- Wrap-up)
        -- occupies exactly ONE terminal row. A value wider than the row is
        -- clipped with a trailing "…" so the label stays visible and the
        -- active field and the repo / branch picker beneath it keep their
        -- rows. The description is already reduced to its first line; the
        -- clip applies on top of that, which matters for dictated text that
        -- arrives as one very long line. Clipping is display only — the
        -- draft keeps the full text.
        --
        -- base_branch is set from user input during TUI task creation
        -- (InputBaseBranch step). That step renders the BaseBranchPicker
        -- surface (see dispatch.allium): a fuzzy picker over the branches
        -- previously used for the selected repo, prefilled with that repo's
        -- most-recently-used branch and falling back to
        -- detect_default_branch(selected_repo) when the repo has no history
        -- yet. Finishing the manual form
        -- records the chosen branch into the repo's history by emitting
        -- BaseBranchUsed(repo_path, base_branch) (see dispatch.allium:
        -- RecordBaseBranch). Only this manual form records history —
        -- quick-dispatch (CreateQuickTask) and the MCP create_task tool do not.
        --
        -- When base_branch is omitted, it is NOT assumed to be
        -- config.default_branch. It is resolved from the repository named by
        -- repo_path, by detect_default_branch (see
        -- dispatch.allium: DefaultBaseBranchIsDetectedNotAssumed). The literal
        -- "main" is that helper's own last resort, reached only when the repo
        -- names no default of its own — never a first guess. A guessed "main"
        -- on a repo whose default is "master" names a branch the repo does
        -- not have, and `git worktree add` rejects it at dispatch.
        -- wrap_up_mode is set during the TUI creation form (InputWrapUpMode
        -- step, after InputBaseBranch) or via the MCP create_task tool. When
        -- null, the wrap-up path is decided at wrap-up time. Answering it
        -- moves the form on to InputModel.
        --
        -- ModelPicker. model is set at the InputModel step, the form's last
        -- step, or via the MCP create_task tool. InputModel is a
        -- single-keypress picker like InputTag: h -> haiku, s -> sonnet,
        -- o -> opus, f -> fable (EveryKeyInItsName: each key is the first
        -- letter of the alias it picks). Enter means "no explicit pick" and
        -- keeps the draft (EnterKeepsTheDraft), so for the manual form,
        -- whose draft holds null, Enter leaves model null — which launches on
        -- sonnet (core/TaskModel). Esc cancels creation. Any other key is
        -- silently ignored. Answering it finishes the form and creates the
        -- task.
        --
        -- The prompt says what Enter means — "[Enter] sonnet" — because a null
        -- model is not "undecided" the way a null wrap_up_mode is: it is a
        -- concrete model the agent will run on. Like InputTag's, the prompt
        -- is ONE value that the transient status message, the form hint and
        -- the status-bar hint all derive their text from. A draft seeded by
        -- CopyTask with a model shows that model as Enter's meaning instead.
        --
        -- phoenix is set at the InputTag step as described above, or via the
        -- MCP create_task tool. It defaults to false.
        -- Quick-dispatch (CreateQuickTask) does not offer it — a quick task is
        -- a one-off by construction, and the agent can set the flag through
        -- update_tasks once it knows what the work is. Quick-dispatch offers no
        -- tag picker either, so there is nowhere for the p key to live.
        -- What the flag then does is PhoenixRespawn, below; setting it at
        -- creation has no effect until the task first reaches done.
        --
        -- auto_run_plan defaults to false. When true, a dispatched agent
        -- with a plan skips the "summarize and ask permission" step (see
        -- dispatch.allium). Set by decompose-review's create_task calls,
        -- since those plans already went through the work-package
        -- confirmation step; not exposed in the TUI creation form.
        -- When invoked from the epic view, epic is set to the
        -- current epic, auto-linking the new task as a subtask.
        -- When epic is a grouped root (group_by_repo = true), the task is
        -- routed to the matching per-repo sub-epic via route_target, using
        -- task.repo_path as the routing key.
}

rule SetModel {
    when: SetModel(task, model?)

    ensures: task.model = model
    ensures: task.updated_at = now

    @guidance
        -- Sets or clears the model an existing task's agent launches on.
        -- Raised by the task editor's MODEL section (EditTask) and by MCP
        -- update_tasks(model: "haiku"|"sonnet"|"opus"|"fable"|null). model = null clears it, and the
        -- task launches on sonnet again (core/TaskModel).
        -- No status precondition, like SetWrapUpMode. The change reaches the
        -- agent at its next launch: a running agent keeps the model it was
        -- launched on, and a resume (dispatch.allium: ResumeTask) or a
        -- re-dispatch picks up the new one.
}

rule SetWrapUpMode {
    when: SetWrapUpMode(task, mode?)

    ensures: task.wrap_up_mode = mode
    ensures: task.updated_at = now

    @guidance
        -- Sets or clears the preferred wrap-up path on an existing task.
        -- Raised by the task editor's WRAP_UP_MODE section (EditTask) and by
        -- MCP update_tasks(wrap_up_mode: "rebase"|"pr"|"done"|null).
        -- mode = null clears the preference; the next wrap-up will prompt
        -- the user to choose.
        -- This rule deliberately has no status precondition — the preference
        -- can be updated at any point in the task lifecycle.
}

-- Quick dispatch is gated on repo trust before anything is created. The
-- gate exists for the same reason DispatchTask's does (see dispatch.allium,
-- rule DispatchTask): a fresh worktree launched into a repo Claude Code does
-- not trust stalls on Claude Code's own interactive trust prompt, which
-- silently defeats quick dispatch's unattended, immediate contract.

rule QuickDispatchTrustGate {
    when: QuickDispatch(repo_path, epic_id?)

    ensures:
        if is_repo_trusted(repo_path):
            QuickDispatchTrusted(repo_path: repo_path, epic_id: epic_id)
        else:
            ConfirmTrustRepoQuickDispatch(repo_path: repo_path, epic_id: epic_id)

    @guidance
        -- is_repo_trusted(repo_path) is the same black-box trust check
        -- DispatchTask uses; it reads Claude Code's own per-project trust
        -- record, keyed on the REPO path (not the worktree path). Trust on
        -- the repo path is what makes the worktree under
        -- <repo_path>/.worktrees/... launchable, the same granularity the
        -- DispatchTask gate relies on.
        -- The check runs before any Task is created: on the untrusted
        -- branch nothing is persisted, only a confirmation prompt is
        -- raised ("Repo '<path>' not trusted by Claude Code — trust
        -- it? [y/N]"). The pending creation parameters are held in the
        -- prompt itself (there is no task id to key on yet), which is the
        -- one structural difference from DispatchTask's gate.
        -- Declining (any key other than y/Y) dismisses the prompt and
        -- creates nothing — same cancel semantics as DispatchTask's trust
        -- prompt.
        -- If the trust check itself errors (unreadable trust record), the
        -- error is surfaced through the status bar and neither branch is
        -- taken: no prompt, no task.
}

rule TrustRepoForQuickDispatch {
    when: TrustAndQuickDispatch(repo_path, epic_id?)

    ensures: RepoTrustGranted(repo_path: repo_path)
    ensures: QuickDispatchTrusted(repo_path: repo_path, epic_id: epic_id)

    @guidance
        -- Accepting the ConfirmTrustRepoQuickDispatch prompt (y/Y).
        -- Trust is granted on repo_path, after which the held creation
        -- parameters proceed exactly as the trusted branch of
        -- QuickDispatchTrustGate would have.
        -- RepoTrustGranted makes is_repo_trusted(repo_path) true for
        -- every later dispatch into that repo, quick or standard — the
        -- two entry points share one trust record.
        -- If granting trust fails (the trust record cannot be written),
        -- the failure is surfaced as an error and no task is created.
}

rule CreateQuickTask {
    when: QuickDispatchTrusted(repo_path, epic_id?)

    ensures:
        let task = core/Task.created(
            title: "Quick task",
            description: "",
            repo_path: repo_path,
            status: backlog,
            sub_status: default_sub_status(backlog),
            epic: if epic_id != null: core/Epic{id: epic_id} else: null,
            base_branch: detect_default_branch(repo_path),
            created_at: now,
            updated_at: now
        )
        -- Quick dispatch is a request like every other
        -- launch path (store-split.allium: RequestDispatch). It names the
        -- quick mode, which the module never derives on its own, so the
        -- host's provisioning launches the quick-dispatch agent
        -- (dispatch.allium: ProvisionDispatch).
        split/DispatchRequested(task: task, requester: core/local_host(), origin: quick, mode: quick)

    @guidance
        -- Reached only through QuickDispatchTrustGate, i.e. once the repo
        -- is trusted — either it already was, or the user just granted
        -- trust via TrustRepoForQuickDispatch. Nothing is created on the
        -- untrusted path.
        -- The originating stimulus is the Shift+D (capital D) TUI key,
        -- which emits QuickDispatch. When exactly
        -- one saved repo path exists, it is used directly. Otherwise
        -- (zero or multiple saved paths), a picker
        -- (InputMode::QuickDispatch) is shown, which renders the shared
        -- RepoPathPicker surface (see below). With zero saved paths the
        -- picker opens to an empty list; the user types a new path and
        -- presses Enter to submit it as a NewPath entry.
        -- Per the picker's NoPrintableShortcut guarantee, j/k and
        -- digits filter; they do not navigate or select.
        -- When invoked from the epic view, epic_id is set to the
        -- current epic, linking the quick task as a subtask.
        -- The task title defaults to "Quick task"; the agent is expected
        -- to rename the task via update_tasks once the user describes the
        -- goal. The quick-dispatch agent uses a dedicated prompt
        -- (build_quick_dispatch_prompt) that opens by asking the user what
        -- they want to achieve, and then names the same design step every
        -- other no-plan prompt names — see dispatch-prompt.allium:
        -- ComposeAgentPrompt and NameTheDesignStep. It does NOT ask for a
        -- docs/plans/ document: writing one is the agent's judgement call on
        -- both no-plan paths, not an instruction.
        -- base_branch is resolved from `git symbolic-ref
        -- refs/remotes/origin/HEAD` against repo_path, falling back to
        -- "main" when origin/HEAD is unavailable. This prevents
        -- dispatch failures on repos whose default branch is not main.
        -- The request follows the creation: the module claims the new task
        -- (Backlog -> Running) and writes the request row, and this board
        -- then provisions the worktree and tmux window and launches the
        -- agent, exactly as for DispatchTask — and, since
        -- QuickDispatchTrustGate, behind the same repo-trust gate. It is
        -- still NOT the DispatchTask rule: quick dispatch has no backlog/tag
        -- preconditions of its own (the task it just created is trivially
        -- backlog and untagged), no base-branch history recording (see
        -- CreateTask guidance), and its own prompt variant
        -- (build_quick_dispatch_prompt, mode: quick). Trust and the request
        -- are what the two entry points share. A request that fails leaves
        -- the created task in backlog, like any failed dispatch.
}

-- == Status Movement ==

rule MoveTaskForward {
    when: MoveTask(task, forward)

    requires: task.status != done

    let next = next_status(task.status)
    let was_running = task.status = running

    -- Moving to Done requires explicit confirmation via ConfirmDone
    requires: next != done

    ensures: task.status = next
    ensures: task.sub_status = default_sub_status(next)
    ensures: task.updated_at = now
    ensures:
        if was_running:
            current_agent(task).stop_pending = false

    @guidance
        -- Manual movement (forward or backward) clears the task's agent
        -- notification/poll tracking flags: the review-notified and
        -- needs-input-notified markers, the last PR-poll timestamp, and the
        -- card message flash. Nothing else is cleared — there is no
        -- separate tmux-output or crash-detection state.
        -- A move out of running also voids any deferred Stop
        -- (current_agent(task).stop_pending), because the bit belongs to the turn the task
        -- was running under. was_running reads the pre-move status; an
        -- ensures-block `if` would read the post-move one. See
        -- core/Task's PendingStopOnlyWhileRunning invariant for why every
        -- leaving-running write must do this.
        -- sub_status is always reset to the default for the new status.
        -- Any manual-move transition into Running (not just Review ->
        -- Running) also stamps last_pre_tool_use_at = now, so
        -- ClassifyAgentActivity does not immediately report the task Stale
        -- (see agent-health.allium). This includes Backlog -> Running, which
        -- provisions no worktree; the seed is harmless there because both
        -- the classifier and crash detection only consider tasks with a
        -- tmux_window.
        -- Supports batch operation on multi-selected tasks. Batch forward
        -- splits when the selection includes Review tasks: non-Review
        -- tasks move immediately, Review tasks are collected for a single
        -- batch ConfirmDone prompt.
}

rule MoveTaskBackward {
    when: MoveTask(task, backward)

    requires: task.status != backlog

    let prev = prev_status(task.status)
    let was_running = task.status = running

    -- Kill tmux window when moving backward, but preserve worktree for resume
    ensures: task.status = prev
    ensures: task.sub_status = default_sub_status(prev)
    ensures: current_agent(task).tmux_window = null
    ensures: task.updated_at = now
    ensures:
        if was_running:
            current_agent(task).stop_pending = false

    @guidance
        -- Manual movement (forward or backward) clears the task's agent
        -- notification/poll tracking flags: the review-notified and
        -- needs-input-notified markers, the last PR-poll timestamp, and the
        -- card message flash. Nothing else is cleared — there is no
        -- separate tmux-output or crash-detection state.
        -- A move out of running also voids any deferred Stop — see
        -- MoveTaskForward's guidance and core/Task's
        -- PendingStopOnlyWhileRunning invariant.
        -- sub_status is always reset to the default for the new status.
        -- The worktree is preserved so the task can be resumed later
        -- via ResumeTask. Its host is preserved with it, and must be: a
        -- backlog task that kept its worktree kept a directory on one
        -- specific machine's disk, and core/Task's HostTracksWorktree
        -- invariant pairs the two fields in both directions. This rule is the
        -- reason "backlog tasks are unowned" is false — see that invariant's
        -- comment, which states the point at length because the wrong reading
        -- is the intuitive one.
        -- A move back to backlog while the task's dispatch is still in flight
        -- gives up that launch: the task holds no window yet, so this rule
        -- kills none, and the store cancels the request instead — at once if
        -- its host has not claimed it, else by refusing the host's report so
        -- the host tears down what it made (store-split.allium:
        -- GivingUpTheLaunchCancelsTheDispatch). ConfirmDone's write into done
        -- does the same.
        -- Supports batch operation on multi-selected tasks.
        -- Leaving done clears nothing. task.sort_order is untouched by every
        -- status write (it is manual/feed ordering and nothing else), and
        -- task.completed_at is deliberately KEPT: it records the last time the
        -- task finished, not whether it is finished now. Re-entering done
        -- overwrites it. See core/Task.completed_at and ConfirmDone below.
}

rule ConfirmDone {
    when: ConfirmDone(task)

    requires: task.status != done

    let was_running = task.status = running

    ensures: task.status = done
    ensures: task.sub_status = default_sub_status(done)
    ensures: current_agent(task).tmux_window = null
    ensures: task.updated_at = now
    ensures: task.completed_at = now
    ensures:
        if was_running:
            current_agent(task).stop_pending = false

    @guidance
        -- Confirmation prompt for the transition into Done. Used by
        -- single-task forward moves, BatchMoveForward, and the 'x' key.
        -- Each task is individually guarded before transitioning: tasks
        -- already in Done are skipped rather than re-moved.
        -- The tmux window is killed but the worktree is preserved —
        -- unlike DeleteTask, which removes it along with the row. Only its
        -- build output goes (ClearBuildOutputOfDoneTask). As with MoveTaskForward,
        -- the task's agent notification/poll tracking flags are cleared,
        -- and a deferred Stop is voided when the task was running.
        --
        -- Reached from forward movement only when the next status is Done
        -- (i.e. from Review). The 'x' key reaches it from *any* non-Done
        -- status, moving the task straight to Done rather than one step
        -- forward — see DeleteKeyRouting on the Board surface.
        --
        -- A task sent to Done while its dispatch is still in flight gives up
        -- that launch, as a move back to backlog does: it holds no window yet,
        -- so this rule kills none, and the store cancels the request instead
        -- (store-split.allium: GivingUpTheLaunchCancelsTheDispatch).
        --
        -- task.completed_at = now is the Done column's ordering key
        -- (board-layout.allium, "Done Column Ordering"): Done reads newest
        -- first, so it sorts on this field DESCENDING. It is a real wallclock
        -- timestamp in milliseconds, not a rank — there is no negation trick
        -- and no sign to interpret. It is separate from task.sort_order, so
        -- the column can tell a feed's manual ordering from a completion.
        --
        -- The stamp is not a per-rule opt-in. ANY status write that brings a
        -- task INTO done sets task.completed_at = now, computed once from
        -- (prior, next) by the store's module as part of the write — the
        -- patch_task reducer every board status write goes through — so it
        -- fires without each rule naming it. The board
        -- stamps nothing itself (store-split.allium, X2); a board that needs
        -- the stamp re-reads the task. The other routes
        -- in: PrMerged and ExitSession's non-pr branch (both in
        -- pr-workflow.allium; ExitSession stamps it from the store clock in
        -- the module), update_tasks' status="done" path
        -- (mcp-task-tools.allium: MarkTaskDoneViaMcp, through the module's
        -- close_task; store-split.allium: RequestCloseTask), and a
        -- feed upsert whose item arrives with status
        -- done (feeds.allium). PrClosed (pr-workflow.allium) is NOT one of
        -- these — a closed PR no longer transitions the task into done.
        --
        -- There is no matching clear. A write that takes a task OUT of done
        -- leaves task.completed_at exactly as it was, because the field
        -- answers "when did this last finish", which a move back to backlog
        -- does not unmake. A done -> done write leaves it alone too: the task
        -- did not finish again. Only a genuine transition into done overwrites
        -- it.
        --
        -- task.sort_order is not touched here, in either direction. It carries
        -- manual and feed ordering only, and it survives a round trip through
        -- done unchanged.
}

-- == Phoenix ==

-- A phoenix task is a recurring task. Entering done creates a fresh backlog
-- copy of it, and the flag MOVES to that copy. Without a schedule nothing runs
-- the copy: it waits in backlog until a human dispatches it — the recurrence
-- is in the queueing, not in the running. With a schedule (schedules.allium,
-- S3) the copy carries it and a running board dispatches it when it is due.
--
-- WhyNotATag. phoenix is its own Boolean on core/Task rather than a TaskTag
-- variant, because a tag already answers a different question: it selects the
-- dispatch prompt (DispatchMode::for_task) and marks review work
-- (TaskTag::is_review), and phoenix has nothing to say about either. Making it
-- a tag would also make it exclusive with bug/chore/feature, and a recurring
-- chore is the ordinary case, not an edge one.
--
-- SharesTheTagKeypressAnyway. Orthogonal in the model does not mean answered
-- somewhere else in the UI. The TUI arms phoenix from the tag picker's p key,
-- which then re-opens the picker for the real tag (CreateTask:
-- PhoenixArming). That is one keypress in a step the operator is already in,
-- and it is the reason phoenix has no step of its own — not a hint that the
-- flag is a tag after all. The two answers stay separate fields, and the
-- second pass exists precisely so a phoenix task still gets its own tag.
--
-- TheFlagIsTheReceipt. There is no second field recording "this one already
-- respawned". PhoenixRespawn clears the flag exactly when the successor was
-- created, so the flag's own presence carries that fact:
--
--   * cleared -> the successor exists; re-entering done does nothing.
--   * still set, in done -> the successor does NOT exist. This is
--     core/Task.respawn_failed, rendered as a red ⚠ card indicator (see
--     board-visuals.allium: "Phoenix marker"), and re-entering done retries.
--
-- The store enforces the receipt on its standalone respawn too: a respawn
-- whose predecessor does not carry the flag is refused, writing nothing
-- (RespawnPhoenixSuccessorNeedsTheFlag).
--
-- Two properties fall out of this and neither should be re-derived some other
-- way. A done -> review -> done round-trip cannot spawn a duplicate, because
-- the first pass cleared the flag. And a failed respawn is never silent,
-- because the thing that would have recorded the failure is the thing that was
-- not cleared.
--
-- DoneOutranksTheRespawn. The done transition is what the operator asked for;
-- the respawn is a follow-on. A failed respawn therefore does NOT roll the
-- transition back — the task is done, the flag stays, and the card says so.
-- Rolling back would mean a transient database error could block completing a
-- task, which is strictly worse than a recurrence the operator can see is
-- missing and retry with two keypresses.

rule PhoenixRespawn {
    when: task: core/Task.status transitions_to done

    requires: task.phoenix
    -- Feed-owned rows are exempt: see FeedTasksAreExempt below.
    requires: task.external_id = null

    -- Whether the successor row was actually created. The flag clear is owed
    -- on success and withheld on failure, when the flag stays as it was.
    let respawned = successor_created(task)

    ensures:
        if respawned:
            core/Task.created(
                title: task.title,
                description: task.description,
                repo_path: task.repo_path,
                status: backlog,
                sub_status: default_sub_status(backlog),
                plan_path: task.plan_path,
                auto_run_plan: task.auto_run_plan,
                epic: task.epic,
                tag: task.tag,
                labels: task.labels,
                base_branch: task.base_branch,
                wrap_up_mode: task.wrap_up_mode,
                model: task.model,
                phoenix: true,
                -- schedules.allium (S3-S5): the schedule repeats with the
                -- flag, due next at its first match after this respawn.
                schedule: task.schedule,
                next_due: if task.schedule != null: next_match(task.schedule, after: now) else: null,
                schedule_error: null,
                created_at: now,
                updated_at: now
            )
            task.phoenix = false

    @guidance
        -- EveryRouteIntoDone. The trigger is the status transition itself, not
        -- any one operator action, so all five routes respawn: ConfirmDone (the
        -- 'x' key and a forward move out of review), the STATUS section of
        -- EditTask, update_tasks' status="done" path (mcp-task-tools.allium:
        -- MarkTaskDoneViaMcp), ExitSession's rebase and done branches, and
        -- PrMerged (both in pr-workflow.allium). transitions_to fires only on an actual change
        -- of value, so a no-op patch that rewrites done over done never
        -- re-fires.
        --
        -- Where it hooks. Every route in runs the
        -- respawn IN THE MODULE, in the SAME transaction as the Done write,
        -- so the successor and the predecessor's flag clear land
        -- with the status write (TheFlagIsTheReceipt holds trivially there):
        -- the patch_task reducer, which the TUI's status writes (ConfirmDone,
        -- EditTask) go through, when a patch moves a task into Done from
        -- another status (store-split.allium, X2); the close_task reducer of
        -- update_tasks' status="done" path (store-split.allium:
        -- RequestCloseTask, X1); exit_session's close (pr-workflow.allium:
        -- ExitSession, inside store-split.allium's RequestExitSession); and
        -- PrMerged's write (pr-workflow.allium: ReportPrStatus). The board
        -- respawns nothing itself. Inside the transaction the
        -- module inserts the successor before it writes the closed task (so
        -- the predecessor's flag clear rides on that one write); the order is
        -- not observable from outside. What DoneOutranksTheRespawn requires
        -- still holds: a successor insert that fails is swallowed, and the
        -- Done write lands with the flag kept. The successor copies the
        -- predecessor's stored repo_path and plan as they are; the board's path
        -- normalisation ran when those were written.
        --
        -- FeedTasksAreExempt. A task carrying an external_id is owned by a feed
        -- epic, which recreates and reconciles its own rows on every poll (see
        -- feeds.allium). A phoenix copy would either duplicate the row the feed
        -- is about to re-ingest, or be deleted as stale by the same
        -- reconciliation — so the flag is ignored on those rows rather than
        -- fighting the feed. This costs nothing in practice: a feed writes
        -- status inside the module's ingest_feed (feeds.allium), not through
        -- patch_task or a close, so a feed-driven auto-completion would not
        -- reach this rule even without the precondition. The precondition is what
        -- makes the exemption a decision instead of an accident, and it also
        -- covers a feed row completed by hand from the TUI, which DOES reach
        -- here.
        --
        -- WhatTheSuccessorInherits. Everything the operator configured, and
        -- nothing the previous run produced. Carried across: title (verbatim,
        -- with no "Copy of:" prefix and no run counter — the predecessor sits in
        -- done and the successor in backlog, so the columns disambiguate them),
        -- description, repo_path, tag, labels, base_branch, wrap_up_mode,
        -- model, epic, plan_path and auto_run_plan.
        --
        -- Deliberately NOT carried: worktree, tmux_window and url, which belong
        -- to the run that just finished; external_id, which the precondition
        -- already rules out; sort_order, left null so the copy sorts by its own
        -- id and lands at the bottom of backlog rather than inheriting a
        -- position from a task that is no longer in that column; completed_at,
        -- left null because the successor has never finished — the run that
        -- did is the predecessor, which keeps its own; and every
        -- agent-health field, which defaults for a task no agent has touched.
        --
        -- plan_path is carried even though CopyTask deliberately drops it. The
        -- cases differ: CopyTask makes a new piece of work that happens to
        -- resemble an old one, while a phoenix successor IS the same work coming
        -- round again, and a recurring task's checklist is the reason to make it
        -- recurring. The cost is a stale pointer when the plan lived only inside
        -- the predecessor's worktree and that worktree is later deleted away; a
        -- plan committed into the repo, which is where this repo keeps them, is
        -- unaffected.
        --
        -- EpicMembershipIsInherited, and it has a visible consequence: a backlog
        -- subtask appearing under an epic that had just gone done pulls that
        -- epic back out of done, per EpicStatusRecalculation (epics.allium).
        -- That is correct — the epic genuinely has open work again — and it is
        -- the mechanism by which a recurring subtask keeps its epic alive.
        --
        -- Like CreateTask (above), when the inherited epic is a grouped root
        -- (group_by_repo = true) the successor is routed to the matching
        -- per-repo sub-epic via route_target, using repo_path as the routing
        -- key, rather than landing in that root verbatim. repo_path and
        -- plan_path are NOT re-resolved: since the respawn moved into the
        -- module they are copied as stored, already normalised when they were
        -- written (see "Where it hooks" above).
        --
        -- The successor is never auto-dispatched. AutoDispatchNextSubtask
        -- (epics.allium) skips phoenix subtasks outright, so a phoenix task
        -- inside an auto_dispatch epic cannot chain into itself forever. See
        -- that rule for why the guard lives there rather than here.
}

-- == Build Output Cleanup ==
--
-- A Done task keeps its worktree (code, branch, commits) until it is deleted
-- (TaskTeardown, below). Its build output is a different matter: a fresh Rust
-- build is ~8.5G and a long-lived worktree grows to 25-40G, because cargo
-- never removes stale artifacts. So the host that holds a Done task's
-- worktree removes the worktree's build output, and disk use is bounded by
-- open tasks.

rule ClearBuildOutputOfDoneTask {
    when: task: core/Task.status becomes done

    requires: task.worktree != null
    -- HostTracksWorktree (core.allium): the worktree is on task.host's disk,
    -- so only that host can see it.
    requires: task.host = core/local_host()
    -- No other task can be working in this worktree (TaskTeardown:
    -- WorktreeIsNeverShared), so nothing else is checked.

    ensures: BuildOutputCleared(task: task, dirs: build_output_dirs(task.worktree))

    @guidance
        -- == What counts as build output ==
        -- build_output_dirs(worktree) is every directory AT ANY DEPTH of the
        -- worktree that holds a CACHEDIR.TAG file whose content starts with
        -- the standard signature line
        -- "Signature: 8a477f597d28d172789f06886806bc55"
        -- (https://bford.info/cachedir/). Cargo writes one into target/; uv
        -- writes one into .venv/. The rule is repo-agnostic: it names no
        -- directory. A file called CACHEDIR.TAG without the signature does
        -- not count. A symlink is never followed and never removed, so the
        -- cleanup cannot reach outside the worktree.
        --
        -- The search walks the whole tree, because a nested crate builds into
        -- its own target/ (a nested crate's own target/), and a
        -- top-level-only search leaves that behind in every Done worktree.
        -- The walk does not descend into a tagged directory (it is removed
        -- whole, so a tag below it is not listed separately) or into any
        -- directory holding its own .git entry (file or directory): that is
        -- another repository or worktree, not this one's output. So it never
        -- reaches a .git directory either.
        -- There is no depth limit. An unreadable directory is skipped.
        --
        -- Only a LINKED git worktree is touched: its .git
        -- must be a regular file. A stored worktree path that is a home
        -- directory, or a repository's own checkout (.git is a directory), is
        -- refused and logged, because ~/.cache carries a CACHEDIR.TAG too.
        -- Each such directory is removed whole; the rest
        -- of the worktree, its .git file and its branch are untouched.
        --
        -- == Every route into Done ==
        -- The trigger is the state, not an operator action, so all routes
        -- reach it: ConfirmDone, EditTask's STATUS section, update_tasks'
        -- status="done" path, ExitSession's rebase and done branches, PrMerged
        -- (so a pr wrap-up's worktree is cleared when its PR merges, not when
        -- it enters review), and a feed upsert. The host does NOT hook any of
        -- those writes. It watches its own board: on each tick it looks for
        -- tasks that are Done, hold a worktree and are held by this host, and
        -- clears each one ONCE PER BOARD RUN. `becomes` (not transitions_to)
        -- is deliberate: a task that was already Done when this board started
        -- is first seen Done here, and is cleared then.
        --
        -- A task that leaves Done and comes back is cleared again. A Done
        -- task cleared once is not looked at again in the same board run, so
        -- the steady-state cost is one set lookup per Done task per tick.
        --
        -- == Best effort ==
        -- The cleanup runs off the board's thread and never blocks or reverts
        -- the Done transition. A directory that cannot be removed (for
        -- example root-owned files a Docker bind mount left) is logged at
        -- warn and left; the task still counts as cleared for this board run,
        -- so a failure is logged once per run, not on every tick. A worktree
        -- directory that no longer exists is nothing to clear. What was
        -- removed is logged at info with the task id.
        --
        -- A task re-dispatched from Done in the moment the cleanup runs may
        -- see a target/ disappear under a starting build. That costs a
        -- rebuild, nothing more, and is accepted.
}

-- == Multi-Selection ==

-- Two different things are called "select all", and conflating them is the
-- trap this subsection exists to close.
--
--   1. The select-all *cursor position* (board-layout.allium's on_select_all): the
--      cursor is parked on a column's header rather than on a card. Row
--      navigation sets it — moving up off the first row lands there — and
--      moving back down leaves it. It is a place the cursor can be, not a
--      selection, and moving off it changes no selection at all.
--   2. The select-all *action* (SelectAllColumn below): it mutates the
--      selection and does not touch the cursor position. It can be invoked
--      while the cursor is on the header or on any card in the column.
--
-- They are independent. Only ClearSelection touches both.

rule SelectAllColumn {
    -- tasks and epics are the column's currently *visible* selectable
    -- items, in the sense fixed by the guidance below.
    when: SelectAllColumn(tasks, epics)

    -- Every navigation column is a task-status column, so every column can
    -- select-all. This is the behavioural counterpart of the rendering rule
    -- that shows the checkbox on the focused column (board-visuals.allium:
    -- ColumnChrome.shows_select_all_checkbox) — the two must move together, so
    -- neither should be changed alone. The Archive edge column, which could
    -- do neither, went with the archived status.

    -- An empty column is a no-op.
    requires: tasks.count > 0 or epics.count > 0

    ensures:
        if tasks.all(t => t in selection.selected_tasks)
            and epics.all(e => e in selection.selected_epics):
            for t in tasks:
                selection.selected_tasks.remove(t)
            for e in epics:
                selection.selected_epics.remove(e)
        else:
            for t in tasks:
                selection.selected_tasks.add(t)
            for e in epics:
                selection.selected_epics.add(e)

    @guidance
        -- Bound to `a` in any task-status column, and to Enter while the
        -- cursor is on that column's header. Enter on the header toggles
        -- exactly as `a` does — it is not a clear.
        --
        -- What gets selected is what is *visible*. The column's items are
        -- the ones the board is currently showing there, so the active epic
        -- scope, the repo filter and the search query all apply (see
        -- core.allium: tasks_for_current_view and the board search filter).
        -- A task that shares the column's status but is filtered out is not
        -- reachable by this action. This is the safety-relevant part: batch
        -- operations consume the resulting selection, so "select all" means
        -- all of what you can see, never all of what has this status.
        --
        -- Scope is one column, the focused one, never the whole board. The
        -- selection it feeds is board-wide though, so selecting all in
        -- Backlog and then all in Running leaves both columns' items
        -- selected. Per-column action, board-wide result.
        --
        -- Covers tasks and epics together. The decorative items in a column
        -- — epic header rules, sub-status labels, the orphan separator —
        -- are not selectable and are skipped.
        --
        -- The toggle is deliberately asymmetric, and this is the part worth
        -- knowing: it completes to full rather than inverting. From a
        -- partial selection it selects everything; only when every task and
        -- epic in the column is already selected does it deselect. So two
        -- presses from a partial state leave the column empty, not back at
        -- the partial set the user started from — the intermediate state is
        -- not recoverable by pressing again.
        --
        -- An empty column is a no-op: nothing is selected, deselected, or
        -- otherwise changed.
        --
        -- Ordering of batch operations over the resulting selection is not
        -- specified here — see the Batch Status Movement and BatchDelete
        -- rules for what consumes it.
}

rule ClearSelection {
    when: ClearSelection()

    ensures:
        selection.selected_tasks = {}
        selection.selected_epics = {}

    @guidance
        -- The only operation that touches both meanings of "select all":
        -- it empties the selection sets *and* releases the select-all cursor
        -- position (board-layout.allium's on_select_all, which no entity in these
        -- specs carries as a field — it is board view state, described in
        -- core.allium under Cursor Selection Preservation). Every other path
        -- affects one or the other, never both.
}

-- == Section Collapse ==

-- Folding and unfolding one sub-status section of one column. What a folded
-- section looks like, what the cursor can do inside it, and where the folded
-- set lives are all in board-layout.allium ("Collapsed Sections").

rule ToggleSectionCollapse {
    -- ref names the column and the section within it. has_section is whether
    -- the cursor is somewhere that identifies a section at all: on a card in a
    -- sectioned column, or on a folded section's header.
    when: ToggleSectionCollapse(ref, has_section)

    -- Nowhere else is a section to fold. A column without sections
    -- (board-layout.allium: ColumnSectionLayout.sectioned_statuses), an empty
    -- column, and the select-all cursor position all leave
    -- the key doing nothing rather than guessing at a neighbouring section.
    requires: has_section

    ensures:
        if collapsed_sections.is_collapsed(ref):
            collapsed_sections.collapsed.remove(ref)
        else:
            collapsed_sections.collapsed.add(ref)
        settings/SaveSetting(key: "collapsed_sections",
            value: serialised(with_toggled(collapsed_sections.collapsed, ref)))

    @guidance
        -- Bound to `z` on a card, which folds the section that card is in;
        -- and to `z`, Space or Enter on a folded section's header, which
        -- unfolds it. Space and Enter reach it only there — on a card they
        -- keep their own meanings (activate, and toggle the detail panel).
        --
        -- Folding the section the cursor is in leaves the cursor on that
        -- section's own header, which becomes selectable in the same moment.
        -- The cursor never lands on a card that is no longer rendered, and
        -- never jumps to an unrelated section.
        --
        -- It writes the recorded set, not what is on screen. A section held
        -- open by a live search query (core.allium: the search override) is
        -- recorded as folded, so `z` on it records "unfolded" and the change
        -- shows the moment the query is cleared. One rule, no special case
        -- for the overridden state.
        --
        -- Selection is untouched: a selected card stays selected while its
        -- section is folded, and batch operations still act on it. Folding
        -- decides what is drawn, never what is selected — see SelectAllColumn
        -- for the other half, which reaches only the cards a column renders.
        --
        -- Persisted, so it survives a restart: every toggle saves the whole
        -- folded set as this host's "collapsed_sections" setting, read back
        -- at startup. The epic folds, the repo filter and the hide-lists
        -- persist too (ToggleEpicFold; board-layout.allium:
        -- SaveBoardFilterOnClose); the flat view and the lens do not.
        --
        -- == Black boxes ==
        -- with_toggled(set, ref) is `set` with `ref` removed if it is in it,
        -- else added: the set this toggle leaves. serialised(set) is that set
        -- as the setting's stored text.
}

-- == Epic Fold ==

-- Folding and unfolding one epic's flattened group in one column. What a
-- folded epic group looks like, what the cursor can do inside it, and where
-- the folded set lives are all in board-layout.allium ("Epic Folding").

rule ToggleEpicFold {
    -- ref names the column and the epic within it. has_epic_group is
    -- whether the cursor is somewhere that identifies a flattened epic
    -- group at all: on a card belonging to that epic in a flattened column,
    -- or on that epic's already-folded header. The open epic-header row
    -- itself never holds the cursor — it is decoration, exactly as an open
    -- SubstatusLabel is (board-layout.allium: "Epic Folding").
    when: ToggleEpicFold(ref, has_epic_group)

    -- Nowhere else is an epic group to fold. A card with no epic, an
    -- unflattened column (board-layout.allium: FlattenedView.flattens), a
    -- flattened column with no header for the group at all
    -- (board-layout.allium, "Epic Folding": today, Done), and the select-all
    -- cursor position all leave the key doing nothing rather than guessing
    -- at a neighbouring group.
    requires: has_epic_group

    ensures:
        if folded_epics.is_folded(ref):
            folded_epics.folded.remove(ref)
        else:
            folded_epics.folded.add(ref)
        settings/SaveSetting(key: "collapsed_epics",
            value: serialised(with_toggled(folded_epics.folded, ref)))

    @guidance
        -- Bound to `Z` (shift-z) on a card, which folds the epic group that
        -- card belongs to; and to `Z`, Space or Enter on a folded epic
        -- header, which unfolds it. Space and Enter reach it only there —
        -- on a card they keep their own meanings. Mirrors `z` for
        -- ToggleSectionCollapse, on a different key because a card can
        -- carry both a section and an epic group at once and needs two
        -- distinct bindings to fold either.
        --
        -- Folding the group the cursor is in leaves the cursor on that
        -- group's own header, which becomes selectable in the same moment.
        -- The cursor never lands on a card that is no longer rendered, and
        -- never jumps to a neighbouring group.
        --
        -- It writes the recorded set, not what is on screen. A group held
        -- open by a live search query (board-layout.allium, "Epic Folding":
        -- the search override) is recorded as folded, so `Z` on it records
        -- "unfolded" and the change shows the moment the query is cleared.
        -- One rule, no special case for the overridden state.
        --
        -- Selection is untouched: a selected card stays selected while its
        -- epic group is folded, and batch operations still act on it.
        -- Folding decides what is drawn, never what is selected.
        --
        -- Independent of ToggleSectionCollapse: folding an epic group and
        -- folding the section it sits in are two separate toggles over two
        -- separate recorded sets, and neither rule consults the other.
        --
        -- Persisted, so it survives a restart: every toggle saves the whole
        -- folded set as this host's "collapsed_epics" setting, as
        -- ToggleSectionCollapse does for sections.
}

-- A fold whose epic the compact tree stops drawing moves down to the epics
-- that now head what it hid (board-layout.allium, "Epic Folding"). `skipped` is a recorded fold whose epic is drawn in no section of
-- its column. `takers` are the drawn epics nearest below that epic, one per
-- section where it is skipped and some task below it remains: each is the
-- epic the compact tree draws in its place there (board-layout.allium:
-- EpicGroupTree.drawn_parent). Both are judged on the column unfiltered:
-- every task it holds on the main board, with no search, lens narrowing,
-- hidden epic, hidden work package or repo filter applied
-- (board-layout.allium, "Epic Folding"). The trigger fires whenever the
-- board's tasks or epics change.
rule FoldMovesToDrawnDescendant {
    when: UnfilteredColumnLaidOut(skipped, takers)

    requires: folded_epics.is_folded(skipped)
    requires: takers.count > 0

    ensures:
        folded_epics.folded.remove(skipped)
        for taker in takers:
            folded_epics.folded.add(board_layout/EpicFoldRef(column: skipped.column, epic: taker))
        settings/SaveSetting(key: "collapsed_epics",
            value: serialised(moved_down(folded_epics.folded, skipped, takers)))

    @guidance
        -- The user folded the epic to hide what sits under it. When that
        -- epic stops drawing a header, the epics now heading those tasks
        -- inherit the fold, so the tasks stay hidden under a header that
        -- names them. The old fold is cleared, not kept: when the skipped
        -- epic draws again later, it draws open, and its descendants keep
        -- the folds they inherited.
        --
        -- It moves only when the epic is drawn in no section of the
        -- column. While one section still draws it, the fold stays, and in
        -- the sections that skip it the fold hides nothing.
        --
        -- With no taker — no task left below the epic in the column — the
        -- fold stays recorded and inert, as any fold naming no group is.
        --
        -- == Black boxes ==
        -- moved_down(set, skipped, takers) is `set` without `skipped` and
        -- with a fold for each taker in skipped's column: the set this rule
        -- leaves.
}

-- == Batch Status Movement ==

rule BatchMoveForward {
    when: BatchMoveTasks(tasks, forward)

    -- Split: non-Review tasks move immediately (MoveTaskForward).
    -- Review tasks are collected and confirmed together under one prompt,
    -- then each goes through ConfirmDone.
    let non_review = tasks where status != review
    let review_tasks = tasks where status = review

    ensures:
        for task in non_review:
            MoveTask(task, forward)
    ensures:
        for task in review_tasks:
            ConfirmDone(task)

    @guidance
        -- When all selected tasks are non-Review, they move forward
        -- without any confirmation prompt. When some are in Review,
        -- the non-Review tasks still move immediately while the Review
        -- tasks are held for a single batch confirmation. This avoids
        -- individual prompts per Review task.
}

rule BatchMoveBackward {
    when: BatchMoveTasks(tasks, backward)

    ensures:
        for task in tasks:
            MoveTask(task, backward)
}

-- == Reorder ==

rule ReorderItem {
    when: ReorderItem(item, direction)
    -- item: Task or Epic in the current navigation column
    -- direction: +1 (down) or -1 (up)

    let items = column_items(item)
    let current_index = index_of(items, item)
    let target_index = current_index + direction

    requires: target_index >= 0
    requires: target_index < items.count

    let target = element_at(items, target_index)
    let in_done = column_status(item) = done

    -- Outside Done a card is ordered by sort_order ?? id, ascending. In Done
    -- it is ordered by its completion key, descending — for a task its own
    -- completed_at, for an epic card its own completed_at falling back to the
    -- freshest completed_at among the done tasks that placed it in the column
    -- (board-layout.allium, EpicCardPlacement.done_sort_key). The two columns
    -- therefore write different fields.
    let item_eff = item.sort_order ?? item.id
    let target_eff = target.sort_order ?? target.id
    let item_done_eff = done_sort_key(item)
    let target_done_eff = done_sort_key(target)

    -- Nothing to swap when either card has no completion key at all. Refusing
    -- is the honest answer: the write would persist a value and the card would
    -- not move.
    requires: if in_done: item_done_eff != null and target_done_eff != null

    ensures:
        if in_done:
            if item_done_eff = target_done_eff:
                -- Equal keys: offset the moved card by one millisecond. Done
                -- sorts DESCENDING, so moving down (direction = +1) means a
                -- smaller timestamp.
                item.completed_at = item_done_eff - direction * 1.millisecond
                target.completed_at = target_done_eff
            else:
                item.completed_at = target_done_eff
                target.completed_at = item_done_eff
        else:
            if item_eff = target_eff:
                -- Equal effective values: offset the moved item by 1
                item.sort_order = item_eff + direction
                target.sort_order = target_eff
            else:
                -- Swap effective sort_order values
                item.sort_order = target_eff
                target.sort_order = item_eff

    @guidance
        -- Operates on both tasks and epics within the same visual
        -- column. Outside Done the effective sort_order is sort_order ?? id
        -- (falling back to the item's database id when unset), and both
        -- updated sort_order values are persisted to the database.
        -- No-op when the item is already at the boundary of its column.
        --
        -- In Done the swap writes completed_at instead, on both cards, and it
        -- writes it on EPIC cards too. That is the user overriding the
        -- column's recorded order, and the cost is admitted plainly: the swap
        -- rewrites a factual timestamp, so after it the field no longer says
        -- when the work actually finished. The alternative — refusing — was
        -- what an epic card got before this field existed, because its key was
        -- derived from its subtasks and it owned no field the column read.
        -- Now it owns one (core/Epic.completed_at), and an override written
        -- there beats the derived subtask key, so the card moves and stays
        -- moved. See "Manual reorder in Done" in board-layout.allium.
        --
        -- An epic override is not permanent. EpicStatusRecalculation
        -- (epics.allium) rewrites epic.completed_at when the epic itself
        -- transitions into done, which discards an override made earlier.
        --
        -- Package cards are not part of this rule's key space: a work
        -- package card reorders among package cards only
        -- (work-packages.allium: ReorderPackage), and this rule refuses a
        -- swap that would cross between a package card and a task or epic
        -- card.
}

-- == Move To Epic ==

rule MoveTaskToEpic {
    when: MoveTaskToEpic(task, new_epic?)

    -- When a target epic is chosen it must exist. A null new_epic
    -- detaches the task into a standalone (board-level) task on the
    -- caller's board, which the store allows only to the task's creator, an
    -- admin of its workspace or a super-admin (workspaces.allium:
    -- TaskMovesStayInTheWorkspace); anyone else is refused.
    requires:
        if new_epic != null: exists new_epic

    let target = route_target(new_epic, task.repo_path)
    -- The epic before the move; an ensures-block `if` reads the post-move one.
    let prior_epic = task.epic

    ensures: task.epic = target
    ensures: task.updated_at = now
    ensures:
        if target != prior_epic: TaskRelinked(task: task)

    @guidance
        -- Triggered from the kanban board or an epic view by pressing `m`
        -- on a task card (when `m` is pressed on an epic card it runs the
        -- epic ReparentEpic flow instead — see epics.allium). Operates on
        -- the single selected task. The epic-existence precondition is
        -- enforced by the handler, so the MCP relink path (update_tasks with
        -- an epic_id, mcp-task-tools.allium) is held to it too. So are the
        -- store's checks on who may move what (workspaces.allium:
        -- TaskEntersAnEpicTheCallerCanSee, ReParentingKeepsTheHolder,
        -- TaskMovesStayInTheWorkspace).
        --
        -- A collapsible tree overlay lists only epics that are relevant
        -- targets: it excludes epics in Done status and epics hidden by
        -- the repo filter (include/exclude) or by the lens's only-active
        -- filter. Epics on the board filter's hide-list stay listed: moving
        -- work into one is an explicit choice (board-layout.allium, "Hidden
        -- Epics and Work Packages"). The board search query is deliberately NOT
        -- applied here — this picker has its own input buffer. See
        -- board_search_filter in board-layout.allium. Unlike epic reparenting there is
        -- no cycle
        -- concern, so no descendant exclusion applies; every visible,
        -- active epic is a valid target. When status filtering removes a
        -- parent but keeps an eligible child, the child is re-rooted to the
        -- top level so it stays selectable. The first item is always
        -- "— no parent —", which sets epic to null.
        -- Tree navigation: j/k = up/down, l/→ = expand,
        -- h/← = collapse, Space/Enter = select. Space does not expand:
        -- it chooses, so it never reads as a fold key.
        -- The cursor opens on the task's current epic (its ancestors are
        -- expanded so the row is visible); with none, or when that epic is
        -- not offered, it opens on "— no parent —".
        -- A [y/n] confirmation prompt is shown before committing the
        -- change. Pressing n returns to the picker; Esc/q cancels entirely.
        -- The confirmation is UI sugar — the normative outcome is the
        -- move itself, after the user has confirmed.
        --
        -- route_target(epic, repo_path): when new_epic.group_by_repo = true,
        -- route_target redirects the task to the matching per-repo sub-epic
        -- (creating it if needed). When new_epic is a specific sub-epic (not
        -- a grouped root), or when new_epic.group_by_repo = false, the task
        -- is assigned directly to new_epic. When new_epic is null,
        -- route_target returns null (no redirection; the task becomes
        -- standalone).
        --
        -- repo_path-change reroute: when a task's repo_path is changed and
        -- it belongs to a grouped root, the service also calls
        -- reroute_on_repo_change to move it to the correct sub-epic for
        -- its new repo_path. This happens transparently on any update that
        -- changes repo_path when the task is under a grouped parent.
        --
        -- Moving a task changes which epic(s) own it: the previous epic
        -- (if any) and the new epic (if any) both have their status
        -- recalculated per the EpicStatusRecalculation invariant in
        -- epics.allium. updated_at is refreshed by the store's write
        -- itself; the assertion above documents the intent.
        --
        -- Feed-sourced tasks (external_id set) may be re-ingested under
        -- their original feed epic on the next poll; moving such a task is
        -- permitted but not durable against the feed. Moving one out of its
        -- feed detaches it: retirement is keyed by the task's epic chain at
        -- delete time (see DeleteTask), so deleting a detached task later
        -- records nothing for the original feed, and deleting one moved
        -- under another feed records under that feed.
}

-- == New-task signal ==
--
-- A task created with the signal on (mcp-task-tools.allium:
-- CreateTaskViaMcp's `signal`, or a new My Reviews or Team Reviews PR —
-- feeds.allium: NewReviewRequestIsSignalled) is marked unseen for everyone
-- who can see its epic (core/UnseenTask). The mark drives the board's "new" glyph and stripe
-- (board-visuals.allium, "New-task signal"). These rules end it.

rule SeeTaskByLandingOnIt {
    when: OperatorKeyHandled(viewer, task)   -- task: the card under the cursor once the key is handled

    -- Only the task under the cursor is seen. Other tasks in the same epic
    -- stay unseen, and so does every epic whose subtree still holds one, so
    -- the trail of marks leads the operator down to each new card in turn.
    ensures: not exists core/UnseenTask{subscriber: viewer, task: task}

    @guidance
        -- The trigger is a key the operator pressed on the board, never a data
        -- change. After each key is handled, the task card left under the
        -- cursor is seen, however it got there: the arrow and first/last keys,
        -- the first card a newly entered epic or package puts the cursor on,
        -- the card the cursor returns to when a view is left. A key that does
        -- not move the cursor counts too: the operator is at the board, so the
        -- card under their cursor is in front of them. The board checks after
        -- every key, so one check covers all of them. Only a key handled on the
        -- plain board counts: a key in an overlay, a prompt, the detail view
        -- or another screen (help, admin, a picker) sees nothing, because the
        -- board's cards may not be on screen then.
        --
        -- A REFRESH SEES NOTHING. A card that a pull, a fold or a filter
        -- change slides under a cursor that did not move keeps its mark until
        -- the operator's next key. The board runs in a tmux window the
        -- operator may not be looking at, so a cursor resting on a row is not
        -- their attention: only a key they press is.
        --
        -- An EPIC card under the cursor clears nothing. An epic's mark is
        -- derived from the tasks below it (core/UnseenTask); it clears once
        -- the last of them is seen, never by selecting the epic. Entering an
        -- epic clears nothing either.
        --
        -- Entering an epic does not clear its tasks at once: entering is the
        -- only way to see those cards, so the ◆ on each stays until the
        -- cursor reaches that card.
        --
        -- Opening the task detail is not needed: the key that brought the
        -- cursor to the card already cleared it.
        --
        -- The row is removed for the viewing person only. Anyone else's mark
        -- stays until their own cursor lands on the card. The same person on
        -- a second machine sees it clear, because the row is keyed by person.
        --
        -- There is no MCP tool for this. It is an operator act.
}

rule UnseenMarkEndsWithTheTaskFinishing {
    -- "Done" means the status, not a column position.
    when: task: core/Task.status transitions_to done

    -- Reaching Done ends every person's mark on the task. A task that moves
    -- back out of done is not re-marked.
    ensures:
        for u in core/UnseenTasks where u.task = task:
            not exists u

    @guidance
        -- Every write into done ends the marks, whichever writer made it: a
        -- patch, a close, a session close, a merged PR, a feed.
        --
        -- Deleting the task removes its rows with it: an UnseenTask cannot
        -- outlive the task it names. Deletion is gated on done (DeleteTask),
        -- so this holds before the delete as well.
}

rule UnseenMarkEndsWithTheTaskLeavingItsEpic {
    -- task.epic changed: to another epic or to none.
    when: TaskRelinked(task)

    -- Moving the task ends every person's mark on it.
    ensures:
        for u in core/UnseenTasks where u.task = task:
            not exists u

    @guidance
        -- A mark does not follow a task to its new epic. The signal means
        -- "something new landed here"; a move is a different event, and the
        -- people who see the new epic were never told about this task.
        --
        -- MoveTaskToEpic and update_tasks (UpdateTaskIsOneTransaction) raise
        -- TaskRelinked here. Every other path that changes task.epic ends the
        -- marks the same way, in the same write as the move: a feed routing
        -- move (feeds.allium), and the store's repo-group relinks (RegroupEpic
        -- into a per-repo sub-epic, FlattenEpic back to the parent, and the
        -- reroute after a repo_path change).
}

-- == Bookmark ==
--
-- A person bookmarks a task to come back to it (core/Bookmark).
-- The bookmark is drawn on the card and, derived, on every epic above it
-- (board-visuals.allium, "Bookmark"), so the trail leads back to the task.
-- These rules set and end it. The MCP twin is UpdateTasksViaMcp's
-- `bookmarked` (mcp-task-tools.allium); both write through the store's
-- set_bookmark, so the rules below hold for either.

rule ToggleBookmarkFromBoard {
    when: ToggleBookmarkKeyPressed(viewer, task)

    -- `b` on a task card (keybindings: board.normal toggle_bookmark, "on a
    -- task card"). On an epic or work package card the row does not apply,
    -- so the key does nothing (keybindings: KeyWithoutARowCannotAct).
    ensures: BookmarkSet(viewer: viewer, task: task,
                         bookmarked: not exists core/Bookmark{subscriber: viewer, task: task})

    @guidance
        -- The status bar confirms which way it went: "Bookmarked <name>" or
        -- "Bookmark removed from <name>", <name> the task's display name (its
        -- title when it has none yet). A refusal (SetBookmark) shows its
        -- message in the status bar instead.
        --
        -- Applies to the card under the cursor only, never to a multi-card
        -- selection: a bookmark is "this one", and a toggle over a mixed
        -- selection would have no single meaning.
}

rule SetBookmark {
    when: BookmarkSet(subscriber, task, bookmarked)

    -- Only the person themselves writes their own bookmark: the subscriber is
    -- the person the bookmark belongs to, the caller is the identity making
    -- the call, and the operator (the store itself, a scheduled reducer
    -- firing) is a caller like any other here. It may not set or clear a
    -- person's bookmark: a bookmark is personal, and nothing it could repair
    -- is worth reading another person's trail.
    requires: subscriber = caller()
    -- A task the caller cannot see is refused as a missing one
    -- (workspaces.allium: UnseenIsAsMissing).
    requires: task.visible_to(caller())
    -- A Done task cannot be bookmarked (core/Bookmark:
    -- BookmarkedTaskIsNotDone). Removing a bookmark is never refused on
    -- status: there is nothing to remove from a Done task, so it is a no-op.
    requires: bookmarked = false or task.status != done

    ensures:
        if bookmarked:
            if not exists core/Bookmark{subscriber: subscriber, task: task}:
                core/Bookmark.created(subscriber: subscriber, task: task)
        else:
            not exists core/Bookmark{subscriber: subscriber, task: task}

    @guidance
        -- Idempotent both ways: setting a set bookmark or clearing a clear one
        -- changes nothing and is not an error, so an agent can state the
        -- wanted end state without reading first.
        --
        -- The Done refusal reads "<name> is done and cannot be bookmarked".
        --
        -- Nobody else's bookmark is touched. A second person bookmarking the
        -- same task gets a row of their own.
}

rule BookmarkEndsWithTheTaskFinishing {
    -- "Done" means the status, not a column position.
    when: task: core/Task.status transitions_to done

    -- Reaching Done ends every person's bookmark on it. A task that moves
    -- back out of done is not re-bookmarked.
    ensures:
        for b in core/Bookmarks where b.task = task:
            not exists b

    @guidance
        -- Deleting the task removes its rows with it: a Bookmark cannot
        -- outlive the task it names.
        --
        -- Unlike UnseenMarkEndsWithTheTaskLeavingItsEpic, a move
        -- to another epic does NOT end a bookmark. The person asked to come
        -- back to this task, wherever it now sits; the trail simply follows
        -- it to its new epic. So no relink path (MoveTaskToEpic, update_tasks'
        -- epic_id, a feed routing move, RegroupEpic, FlattenEpic, a
        -- repo_path reroute) touches a Bookmark for a person who still sees
        -- the task. A move that takes the task out of a person's sight ends
        -- their bookmark (workspaces.allium: ClaimsFollowSight).
}

-- == Delete ==

-- TaskRowDeleted(task): the task row is gone, whichever route removed it.
-- Raised by every rule that deletes a task row, in the same transaction:
-- DeleteTask and BatchDelete below, an epic delete's subtree (epics.allium:
-- DeleteEpic, which a super-admin's delete of an unseen epic also runs,
-- workspaces.allium: SuperAdminDeletesUnseenItem) and the feed stale delete
-- (feeds.allium: UpsertFeedTasks, RoleRoutedFeedSync). What the store owes a
-- removed row beyond the row itself listens for it (store-split.allium:
-- DeletingATaskFailsItsOpenRequest, DeletingATaskFailsItsOpenSessionRequest,
-- DeletingATaskDeletesItsRequestRows). The module runs that list from one
-- function every such reducer calls.

-- TaskTeardown releases a task's live resources on the host that holds them.
-- DeleteTask and BatchDelete below perform it, and so do DeleteEpic
-- (epics.allium) and the feed removal clauses in feeds.allium
-- (RoleRoutedFeedSync, GroupedFeedUpsert, FlatFeedReconcile,
-- UpsertFeedTasks), where removing a stale feed task performs this same
-- teardown rather than dropping the row and orphaning the worktree of an
-- in-flight agent. Those rules state their own postconditions; this contract
-- states what the teardown itself promises.
--
-- Done is not teardown. A Done task keeps its worktree and branch; only the
-- worktree's build output is cleared (ClearBuildOutputOfDoneTask, above).
contract TaskTeardown {
    -- In order: 1. kill the task's tmux window if it has one; 2. remove the
    -- task's worktree if it has one; 3. delete the task's branch, best
    -- effort. Answers the worktree path still on disk when step 2 failed or
    -- did not run because step 1 failed, and null when there was none to
    -- release or it was released.
    teardown: (worktree: String?, tmux_window: String?) -> String?

    @invariant TeardownIsOwedWheneverThereIsSomethingToRelease
        -- The teardown runs when the task owns a worktree OR a tmux window;
        -- a task owning NEITHER runs no commands at all. The two are
        -- independent, so all four combinations are reachable, and each step
        -- is owed on its own condition (a failed step 1 stops the rest; see
        -- below):
        --   * worktree and window -> steps 1, 2, 3.
        --   * window, no worktree -> step 1 only.
        --   * worktree, no window -> steps 2 and 3.
        --   * neither -> nothing.
        -- Step 1 is NOT contingent on step 2 having something to remove.
        -- A FAILED step 1 on a task that owns a worktree stops the teardown
        -- before step 2: an agent may still be live in that window, so its
        -- worktree is not removed from under it. The worktree is reported
        -- left, so WorktreeReleaseIsGated applies and the operator can retry.
        -- A failed step 1 on a window-only task is warn-logged (see
        -- WorktreeReleaseIsGated).
        -- Step 3 is: a task that never had a worktree never had a branch.
        -- Branch deletion lives inside the worktree arm, which is the only
        -- thing that deletes a branch. One primitive performs all three
        -- steps for every caller; the callers differ only in what they do
        -- with a failure, and none of them branches on the worktree itself.

    @invariant CallerIdentityConfigGoesWithTheWorktree
        -- Step 2 also releases the per-task MCP configuration each launch
        -- writes (dispatch.allium: AgentCarriesItsOwnCallerIdentity). It lives
        -- inside the worktree's own git administrative directory, which
        -- `git worktree remove` deletes with the worktree, so the teardown has
        -- no fourth step and no separate failure mode. A teardown that leaves
        -- the worktree in place leaves the configuration with it, which is
        -- correct: the same worktree re-dispatched is the same task, and the
        -- file still names it.

    @invariant WorktreeReleaseIsGated
        -- Step 2 either releases the worktree or it does not, and the
        -- difference is observable. A FAILED removal:
        --   a. is reported to the operator, and
        --   b. is recorded in the application log at ERROR, naming the task
        --      and the worktree path, and
        --   c. does NOT let the requesting operation forget the path.
        --      DeleteTask does not remove the row at all.
        -- (c) is what makes the failure recoverable: the task still names the
        -- directory and the branch still on disk, so the operator retries by
        -- deleting the done task again. Without it a transient git failure
        -- strands a worktree nothing in the system references.
        --
        -- Three paths are exempt from (c), and all still owe (a) and (b):
        -- RetryFresh (its own postcondition clears the pointer, and the
        -- immediate re-dispatch derives the same worktree path), DeleteEpic
        -- (epics.allium; it removes the subtask rows in one operation, leaving
        -- nothing to hold a pointer), and BatchDelete, for the same reason over
        -- every item it deletes. The feed path owes none of (a), (b) or (c):
        -- the stale delete has already removed the row, and its failures are
        -- warn-logged only (FeedTeardownsAreSerialPerRepo).
        --
        -- The gate is keyed on step 2 ONLY. A task with no worktree has
        -- nothing to release, so the requesting operation's follow-up (the
        -- row delete) applies even if step 1 failed. Such a failure is
        -- warn-logged and not surfaced: withholding the follow-up would gate a
        -- row delete on a tmux call and strand the row instead of a resource.
        --
        -- The outcome of step 2 is reported by the teardown (the path still on
        -- disk), never inferred by the caller from the arguments it passed.
        -- The teardown runs off the board's thread because it shells out to
        -- git, so the follow-up travels with it and is applied on its
        -- completion, not beside it.

    @invariant WorktreeDirectoryMustNotSurviveTeardown
        -- Step 2 releases a DIRECTORY, not a git registration, and the two
        -- come apart. A task whose worktree or window was removed out of band
        -- tears down cleanly, and for the worktree "removed" means the
        -- directory is gone. Step 2 succeeds
        -- only once nothing remains at the worktree path. `git worktree remove
        -- --force <path>` has three outcomes:
        --   * registration and directory both valid -> git deletes the whole
        --     directory, gitignored content included.
        --   * the worktree's `.git` pointer file is gone -> git fails and
        --     removes NOTHING.
        --   * the repo's admin record under `.git/worktrees/<name>` is gone ->
        --     git fails with "is not a working tree" and removes NOTHING,
        --     while `git worktree list` reports the entry prunable.
        -- So step 2 is, in order:
        --   2a. `git worktree remove --force <path>`.
        --   2b. If anything still exists at the worktree path, delete it.
        --       Absent is the success condition, so a path that was never
        --       there is already satisfied.

    @invariant GitsExitCodeDoesNotDecideStepTwo
        -- 2b runs after EVERY outcome of 2a, including 2a producing no exit
        -- code at all (git missing from PATH, a spawn failure). Whether step 2
        -- succeeded is decided by what is left on disk: the outcomes where
        -- git fails are exactly the ones where it removes nothing. A 2a
        -- failure whose directory 2b then removes is a released worktree; that
        -- recovery is info-logged, and step 3 still runs.

    @invariant PruneTheRecordGitKeptWhenItRemovedNothing
        -- A 2a that removed nothing also kept its admin record, and with that
        -- record in place the next `git worktree add` for the same task fails
        -- ("'<branch>' is already used by worktree at ...") and the step-3
        -- branch delete fails too. So a 2a failure whose 2b succeeded prunes,
        -- best effort, BEFORE step 3. `git worktree prune` drops only records
        -- whose directory is missing, which 2b has just made true, so it
        -- cannot reach a live worktree. A successful 2a does not prune.
        -- Provisioning also prunes before every fresh `git worktree add`
        -- (dispatch.allium: StaleAdminRecordIsPrunedBeforeWorktreeAdd); this
        -- prune stays because step 3 depends on it.

    @invariant OneRefusalIsObeyed
        -- A LOCKED worktree (`git worktree lock`) is the single exception.
        -- Git refuses it even under `--force`; dispatch does not take the
        -- `remove -f -f` override and does not delete the directory either.
        -- A lock is the operator protecting the directory on purpose. A
        -- failed 2b and a lock both fail step 2 with the path still on disk,
        -- so WorktreeReleaseIsGated applies and the operator can retry.

    @invariant DeletionIsBoundedToTheWorktreesDirectory
        -- 2b deletes recursively, so the path must lie inside
        -- `<repo>/.worktrees/` and be neither that directory itself nor the
        -- repo. A path failing that test is NOT deleted; it fails step 2 and
        -- is reported like a failed deletion. The test is LEXICAL: `~`
        -- expanded, `.`/`..` resolved as text, both sides made absolute the
        -- same way, with no filesystem resolution. Resolving symlinks would
        -- judge a worktree's target rather than the worktree.

    @invariant AbsentMeansNotFound
        -- 2b's "does anything still exist here" is a stat with three answers.
        -- Only NOT FOUND is absence. A path that cannot be inspected (a parent
        -- without execute permission, an I/O error, an unmounted mount point)
        -- may well be there, so it fails step 2. Anything present is removed
        -- by type: a link is unlinked, a directory removed recursively, and
        -- anything else (a regular file, a socket, a device) fails step 2.
        -- Dispatch asks the same question about the same path through the
        -- same primitive when it decides fresh vs reused (dispatch.allium:
        -- WorktreeExistenceIsOneQuestion).

    @invariant SymlinksAreUnlinkedNeverFollowed
        -- 2b removes links, never what they point at. A symlink inside the
        -- worktree is unlinked; a worktree path that is itself a symlink is
        -- unlinked, and the recursive delete never descends through it.

    @invariant WorktreeIsNeverShared
        -- No two tasks name the same worktree, so step 2 is unconditional and
        -- no path asks whether another task also holds the worktree. A
        -- worktree path embeds the task id (`<repo>/.worktrees/<task-id>-<slug>`),
        -- and a reused directory is only ever that same id-scoped path. The id
        -- prefix, not the slug, guarantees it: a rename never recomputes the
        -- stored path. Every value that sets task.worktree comes from
        -- provisioning, and the board writes back only the value it read.
        -- CopyTask, the MCP update_tasks schema, the feed upsert and the CLI
        -- never set it. A store client that patches task.worktree by hand
        -- (patch_task accepts it, PatchTaskNeverAimsAnotherHostsTeardown)
        -- could fabricate two rows on one path; that is not a supported
        -- input. Do NOT add a shared-worktree check on any path.

    @invariant FeedTeardownsAreSerialPerRepo
        -- The feed path tears down the tasks a stale delete removed. A repo's
        -- removals run one after another, because they shell git against one
        -- shared checkout and would contend on its index lock; distinct repos
        -- run in parallel. Failures are warn-logged, never surfaced: feed
        -- reconciliation is background work.
}

-- Removing the task row removes every agent the task has had, current and
-- ended; their names stay in the ledger (agents.allium: AgentsGoWithTheirTask,
-- since A1). BatchDelete removes them the same way.
rule DeleteTask {
    when: DeleteTask(task)

    requires: task.status = done

    let had_worktree = task.worktree != null
    -- `released` is kept as a distinct name because WorktreeReleaseIsGated is
    -- stated in terms of release, and this binding is the single place recording
    -- that release and removal now COINCIDE: per WorktreeIsNeverShared a worktree
    -- is never shared, so it is never merely detached, and step 2 releases a
    -- worktree from this task exactly when the path is gone from disk — vacuously
    -- true when the task had no worktree.
    let removed = worktree_removed(task)
    let released = removed
    -- The feed that would otherwise re-insert this task, read from the task's
    -- epic chain as it stands at delete time (see core/Epic.nearest_feed_epic).
    let feed_epic = if task.epic != null: task.epic.nearest_feed_epic else: null
    let retires = task.external_id != null and feed_epic != null

    ensures:
        if had_worktree and removed:
            not exists task.worktree
    -- When the worktree is not released the row stays as it is: done, with
    -- its worktree, host and tmux window (WorktreeReleaseIsGated).
    ensures:
        if released:
            not exists task
            TaskRowDeleted(task: task)
            if retires and not exists core/RetiredFeedItem{feed_epic: feed_epic, external_id: task.external_id}:
                core/RetiredFeedItem.created(
                    feed_epic:   feed_epic,
                    external_id: task.external_id,
                    retired_at:  now
                )

    @guidance
        -- Permanent removal: the only way a task leaves the board. There is no
        -- soft state to fall back to and no undo. That is why the TUI puts a
        -- y/n confirmation in front of it (ConfirmDeleteTask) and why no MCP
        -- tool reaches it — deleting is a human decision taken at the board.
        --
        -- The done-status precondition is what keeps 'x' a two-step gesture
        -- on live work: a task is completed first (ConfirmDone), then deleted.
        --
        -- ENFORCED THREE TIMES. The board checks it first, over its own
        -- subscription view (DeleteKeyRouting on the Board surface), so the
        -- gesture responds at once and says why. That view can be stale: a
        -- task reopened on one board can still read as done on another. So
        -- before ANY side effect, the delete flow re-reads the task's TRUE
        -- status from the store and proceeds only if it is done; a failed
        -- pre-check refuses the delete (DeleteTaskRefused) and touches
        -- NOTHING: no teardown, no row removal, no retirement. Because the
        -- board dropped the card optimistically, a refusal also refreshes the
        -- board from the store, so the card is back on screen. Finally the
        -- delete_task reducer checks the stored row again and refuses
        -- (deletes nothing, retires nothing) when the task is not done.
        --
        -- The reducer is the final authority, and the residual it covers is
        -- narrow: the pre-check read and the reducer call are two trips to
        -- the store, so a task reopened on another board BETWEEN them passes
        -- the pre-check and is refused by the reducer after its teardown has
        -- run. There the reducer still keeps the row and its RetiredFeedItem.
        -- Outside that race, "no side effects on refusal" holds in full.
        -- DeleteEpic (epics.allium) and BatchDelete take the same pre-check
        -- over their whole scope and carry the same residual.
        --
        -- The delete is GATED on the teardown (TaskTeardown:
        -- WorktreeReleaseIsGated): if the worktree could not be removed, the
        -- row is NOT deleted. The task stays in done and keeps its worktree,
        -- host and tmux pointers (core/Task: HostTracksWorktree — the
        -- directory is still on this machine's disk), the failure is surfaced
        -- and logged at ERROR, and pressing delete again retries. A task with
        -- no worktree has nothing to release, so it is deleted whatever the
        -- teardown reports; a window-only row still gets its window killed
        -- first. A row owning neither is deleted at once, with no teardown.
        -- The teardown runs in the background (it shells out to git), so the
        -- row delete is issued by the teardown's completion path.
        --
        -- Retirement. A feed task mirrors an upstream item that is usually
        -- still open, so deleting only the row would hand it straight back on
        -- the next cycle. The RetiredFeedItem is written in the SAME write as
        -- the row delete, on the released arm only: a gated delete retires
        -- nothing, because the task is still on the board and the feed still
        -- upserts it in place. A task whose chain holds no feed epic — a
        -- hand-made task, or a feed task moved out of its feed (see
        -- MoveTaskToEpic) — records nothing. An id already retired under the
        -- same feed epic is not written twice
        -- (core/RetiredFeedItem: UniqueRetiredFeedItemPerFeed).
}

rule DeleteTaskRefused {
    when: DeleteTask(task)

    -- Evaluated over the store's TRUE row (DeleteTask's pre-check), before
    -- any teardown begins.
    requires: task.status != done

    -- The row, its worktree, host and tmux window are left as they are.
    ensures: UserInformed(about: delete_refused, task: task)

    @guidance
        -- The refusal arm of DeleteTask's pre-check: the row, its worktree,
        -- tmux window and branch are all left as they are, and the board is refreshed from the store to restore the card
        -- it dropped optimistically. See DeleteTask's guidance for the one
        -- narrow race (a reopen between the pre-check and the reducer call)
        -- in which a refusal can still follow a teardown.
}

rule BatchDelete {
    when: BatchDelete(tasks, epics)

    -- Deletes the selected tasks and epics in one operation, or nothing at
    -- all. Every item must pass its own check: a task must be done, and an
    -- epic must have every task anywhere in its subtree done (an empty subtree
    -- qualifies). One failing item refuses the whole batch. `all_pass` is
    -- evaluated over the TRUE state of every task and epic together, inside
    -- ONE atomic reducer call (batch_delete), which validates everything
    -- before deleting anything. A handle with no shared store attached
    -- refuses it (storage.allium).
    --
    -- A task is written out below with DeleteTask's released-arm effects
    -- unconditionally: a batch has no unreleased arm (see the guidance). An
    -- epic goes through DeleteEpic, whose teardown is not gated either.
    -- subtree_depth(e) is epics.allium DeleteEpic's black box: an epic
    -- subtree nested deeper than the recursive delete reaches is refused,
    -- by the batch_delete reducer only (the pre-check does not measure it).
    -- The reducer also refuses an epic whose subtree holds an epic the caller
    -- cannot see (workspaces.allium: UnseenIsAsMissing's named exception).
    let all_pass =
        tasks.all(t => t.status = done)
        and epics.all(e => e.subtree_tasks.all(t => t.status = done))
        and epics.all(e => subtree_depth(e) <= core/config.max_epic_depth)

    ensures:
        if all_pass:
            for epic in epics:
                DeleteEpic(epic)
            -- A task inside a selected epic's subtree went with that epic.
            for task in tasks where not epics.any(e => task in e.subtree_tasks):
                not exists task
                TaskRowDeleted(task: task)
                if task.external_id != null
                   and task.epic != null
                   and task.epic.nearest_feed_epic != null
                   and not exists core/RetiredFeedItem{feed_epic: task.epic.nearest_feed_epic, external_id: task.external_id}:
                    core/RetiredFeedItem.created(
                        feed_epic:   task.epic.nearest_feed_epic,
                        external_id: task.external_id,
                        retired_at:  now
                    )
        else:
            UserInformed(about: batch_delete_refused, tasks: tasks, epics: epics)

    @guidance
        -- Raised by [x] when the selection holds an epic, or when it is tasks
        -- that are all in Done (DeleteKeyRouting on the Board surface). Shows
        -- a count-based y/n confirmation first.
        --
        -- No partial batches. Delete is permanent, so a batch that deleted
        -- "the ones that qualified" would leave the user to work out which
        -- rows are gone. batch_delete validates EVERY selected item against
        -- the true state first, mutates nothing until all pass, then deletes
        -- everything in the same transaction, so a refusal means nothing at
        -- all was deleted. The status bar names what failed (a task not in
        -- Done, or an epic with unfinished work in its subtree); the user
        -- narrows the selection and presses 'x' again.
        --
        -- Teardown is best effort for the whole batch, not gated on it. One
        -- atomic call leaves no surviving row per item to hold
        -- WorktreeReleaseIsGated's retry pointer, so every item in a batch is
        -- exempt from that gate, as DeleteEpic's subtasks are. Every item's
        -- teardown fires without waiting, and the atomic delete follows. A
        -- task whose worktree removal then fails is still deleted with the
        -- rest of the batch: that is the price of the atomicity above.
        --
        -- Pre-check before any teardown, all or nothing. As for DeleteTask
        -- and DeleteEpic, `all_pass` is first evaluated over the TRUE state
        -- re-read from the store — every selected task, and every task in
        -- every selected epic's subtree — before ANY item's teardown starts.
        -- One failing item refuses the whole batch and touches nothing for
        -- any item; the board is refreshed from the store to restore the
        -- cards it dropped optimistically. The batch_delete reducer stays the
        -- final authority, with DeleteTask's narrow race applying batch-wide.
        --
        -- The count prompt comes first and the per-item check runs when the
        -- user answers y: a refused batch is reported after confirmation. A
        -- refusal leaves the selection in place so it can be narrowed; a
        -- batch that proceeds clears it.
        --
        -- Epics go first. A selected task inside a selected epic's subtree is
        -- deleted once, as part of that epic's subtree, and gets DeleteEpic's
        -- semantics: its teardown is not gated, and it is retired only when
        -- its feed epic survives the delete.
}

-- == Copy Task ==

rule CopyTask {
    when: CopyTask(source)

    ensures: core/Task.created(
        title: "Copy of: " + source.title,
        description: source.description,
        repo_path: confirmed_repo_path,  -- user confirms or edits before creation
        status: backlog,
        sub_status: default_sub_status(backlog),
        tag: confirmed_tag,              -- source.tag seeds it; user re-confirms
        phoenix: armed_phoenix,          -- false unless armed at InputTag
        wrap_up_mode: source.wrap_up_mode,
        model: confirmed_model,          -- source.model seeds it; user re-confirms
        created_at: now,
        updated_at: now
    )

    @guidance
        -- Copies a subset of fields from the source task, including the tag and
        -- the wrap_up_mode preference and the model. Fields that are NOT
        -- copied: plan,
        -- worktree, tmux_window, url, epic, sort_order, base_branch, phoenix.
        -- auto_run_plan is NOT copied — like plan_path, it's tied to a
        -- specific (unshared) plan file, and this field is set by skills
        -- (decompose-review) rather than being a human TUI preference.
        -- phoenix is NOT copied, and it is the one omission that is a policy
        -- rather than a technicality: `c` is a single keypress, and silently
        -- starting a SECOND recurring chain from it — one that then outlives
        -- every task either chain produces — is not a thing a copy key should
        -- be able to do by accident. Contrast PhoenixRespawn's successor, which
        -- DOES carry the flag: there the recurrence is the operation.
        -- The copy flow runs InputTag like the creation form does (see below),
        -- so opting the copy in is still one keypress — it is just a keypress
        -- the operator has to make. The draft's phoenix value entering that
        -- step is false whatever the source held, unlike its tag and
        -- wrap_up_mode, which the source seeds.
        -- The new task is a clean backlog item with no agent history.
        --
        -- The copy flow runs the manual creation form's steps from InputTag on,
        -- skipping only InputTitle and InputDescription (both copied outright):
        -- InputTag -> InputRepoPath -> InputBaseBranch -> InputWrapUpMode ->
        -- InputModel. It
        -- runs InputTag rather than accepting the copied tag silently because
        -- that step is where phoenix is armed (CreateTask: PhoenixArming), and
        -- a copy that could never become a phoenix would be the only flow with
        -- no way to arm it. The copied tag is not lost to the extra step:
        -- InputTag's Enter keeps whatever the draft holds (CreateTask:
        -- EnterKeepsTheDraft), so copying a bug and pressing Enter still yields
        -- a bug. The user is
        -- prompted to confirm or edit the repo_path before the task is
        -- created (the source's repo_path is pre-filled as default).
        -- base_branch is NOT copied from the source task and is NOT taken
        -- from config.default_branch either: the flow re-prompts through the
        -- same BaseBranchPicker surface as task creation (see
        -- dispatch.allium), prefilled with the most-recently-used branch
        -- for the confirmed repo_path and falling back to
        -- detect_default_branch(repo_path) when that repo has no history
        -- yet, exactly as CreateTask's InputBaseBranch step does.
        -- The source's wrap_up_mode seeds the draft, and the InputWrapUpMode
        -- prompt that follows keeps it: Enter there means "no explicit pick",
        -- not "no preference", so only an explicit r/p/d replaces the copied
        -- value (CreateTask: EnterKeepsTheDraft — the tag step follows the
        -- same rule, for the same reason). The source's model seeds the draft
        -- the same way, and InputModel's Enter keeps it.
}

-- == Editor ==

rule EditTask {
    when: EditTask(task)

    -- Opens the user's editor — resolved by the shared rule stated with
    -- core/config.editor_fallback (VISUAL, else EDITOR, else that fallback;
    -- absent/empty/whitespace counts as unset; the value is split into argv and
    -- run with no shell, so `EDITOR="vim -p"` works) — with a
    -- structured file containing the task's
    -- title, description, repo_path, status, plan, tag, base_branch,
    -- wrap_up_mode, model, phoenix, url and url_type.
    -- The sections are delimited by `--- SECTION ---` markers
    -- (TITLE, DESCRIPTION, REPO_PATH, STATUS, PLAN, TAG, BASE_BRANCH,
    -- WRAP_UP_MODE, MODEL, PHOENIX, URL, URL_TYPE).
    -- The user edits the file; on save, fields are parsed back.
    -- Header-shaped text is escaped, so a value never ends its own section:
    -- a line of a written value that is a known header of this file (once any
    -- leading backslashes are stripped and the rest trimmed) gets one backslash
    -- prepended, and a line read back that starts with a backslash and is
    -- otherwise such a header loses one. Write then read returns every
    -- value unchanged, including a description line like `--- STATUS ---`.
    -- The same rule applies to the epic editor and the description editor,
    -- each against its own header set; lines that are not known headers are
    -- never touched.
    -- Empty title/description/repo_path retain their previous values.
    -- Empty plan or tag clears the field. Empty base_branch retains the
    -- previous value. Empty wrap_up_mode clears the preference. Empty model
    -- clears it, so the task launches on sonnet again.
    -- PHOENIX joins the enum-ish sections under the same one parse rule: it
    -- accepts a boolean spelled any of true/false, yes/no, on/off or 1/0,
    -- case-insensitively, and an empty or unparseable section yields no value —
    -- which for this field means false, the same "clear it" the TAG and
    -- WRAP_UP_MODE sections mean. The wide spelling set is the mitigation for
    -- that: it makes an unparseable PHOENIX section, and so an accidentally
    -- cleared recurrence, something a human has to work at. As with the other
    -- enum-ish sections, unparseable input additionally records a parse error
    -- and the edit still applies.
    -- The enum-ish sections (STATUS, TAG, WRAP_UP_MODE, MODEL, URL_TYPE) all share
    -- one parse rule: an empty section and an unparseable section are
    -- treated identically — the section yields no value. Unparseable input
    -- additionally records a parse error, and all accumulated errors are
    -- surfaced together as a status message ("Edit accepted with parse
    -- errors — ..."); the edit is still applied. What "no value" means is
    -- per-field: STATUS retains the previous status, TAG, WRAP_UP_MODE and
    -- MODEL clear the field, and URL_TYPE falls back as described below.
    --
    -- url is computed from the URL and URL_TYPE sections, then diffed
    -- against the task's prior url; the field is only touched when it
    -- changes (an unchanged edit is a no-op for url):
    --   - URL empty -> the url is cleared (set to none).
    --   - URL non-empty with a valid URL_TYPE -> url set to
    --     {url, that type}.
    --   - URL non-empty with empty URL_TYPE -> if the url string is
    --     unchanged from the prior value, the prior url_type is
    --     preserved (so e.g. a security_alert is not silently
    --     downgraded); otherwise the type is inferred from the url
    --     string (".../pull/..." -> pr, ".../issues/..." -> issue,
    --     else other).
    --   - URL non-empty with an unparseable URL_TYPE -> a parse error
    --     is recorded (surfaced as a status message) and the same
    --     empty-URL_TYPE fallback applies (preserve prior type if the
    --     url string is unchanged, else infer from the string).

    -- Only fields the user changed are written. The save compares each
    -- parsed field with the snapshot the editor opened with and sends the
    -- differences; an untouched field is left to whatever the store holds now,
    -- so a status an agent moved, or a model set, while the editor was open is
    -- not reverted by a description-only save. A refused write (the store
    -- answers an error) is reported and nothing else happens: the board does
    -- not show the edit and the repo path is not saved. The epic editor
    -- follows the same rule for title, description, feed command, interval and
    -- visibility.

    let prior = task.status
    -- The task as the editor opened it. The change guards below compare with
    -- it, not with the row as it stands at save time.
    let opened = editor_snapshot(task)

    ensures:
        let edited = EditorSession(task)
        if edited.title != "": task.title = edited.title
        if edited.description != "": task.description = edited.description
        if edited.repo_path != "": task.repo_path = edited.repo_path
        -- A STATUS section that repeats the opened status is no change, so
        -- the sub_status is kept.
        if edited.status != null and edited.status != opened.status:
            task.status = edited.status
            task.sub_status = default_sub_status(edited.status)
            -- Entering done via the STATUS field carries the same
            -- completion stamp as ConfirmDone, and UpdateEpicViaMcp's mirror
            -- of it on the epic side (epics.allium): the editor is a freeform
            -- status setter, but it still writes through the module's
            -- patch_task, which does not special-case "how" the status
            -- changed. Leaving done
            -- writes nothing — see ConfirmDone's guidance for why there is no
            -- matching clear.
            if edited.status = done and prior != done:
                task.completed_at = now
            -- And the same leaving-running clear, for the same reason: the
            -- editor writes through patch_task, which applies every rule a transition derives from the prior status
            -- (store-split.allium, X2). See core/Task's
            -- PendingStopOnlyWhileRunning invariant.
            if prior = running and edited.status != running:
                current_agent(task).stop_pending = false
        if edited.plan != "": task.plan_path = edited.plan
        else: task.plan_path = null
        if edited.tag != "": task.tag = edited.tag
        else: task.tag = null
        if edited.base_branch != "": task.base_branch = edited.base_branch
        -- The two preference writes are SetWrapUpMode and SetModel, raised
        -- only for a section the user changed (see "Only fields the user
        -- changed are written" above).
        if edited.wrap_up_mode != opened.wrap_up_mode:
            SetWrapUpMode(task: task, mode: edited.wrap_up_mode)
        if edited.model != opened.model:
            SetModel(task: task, model: edited.model)
        task.phoenix = edited.phoenix ?? false
        -- url updated from the URL/URL_TYPE sections per the semantics
        -- in the comment above; left untouched when unchanged.
        let desired_url =
            if edited.url = "": null
            else if edited.url_type != null: core/TaskUrl{url: edited.url, url_type: edited.url_type}
            else if task.url != null and task.url.url = edited.url:
                core/TaskUrl{url: edited.url, url_type: task.url.url_type}
            else: core/TaskUrl{url: edited.url, url_type: infer_url_type(edited.url)}
        if desired_url != task.url: task.url = desired_url
        task.updated_at = now

    @guidance
        -- Status changes via the editor bypass normal transition
        -- preconditions. The user can set any valid TaskStatus
        -- regardless of the current status or the transitions
        -- declared on Task. This is intentional: the editor is a
        -- power-user escape hatch for manual corrections, and
        -- core.allium's Task.status graph records it as exempt.
        -- Sub_status is auto-reset to the default for the new status
        -- when status changes, per the SubStatusAutoreset invariant.
        -- The editor opens in a separate tmux window; tmux focus
        -- switches to that window while the TUI keeps running in
        -- its original window. On editor exit the window closes and
        -- focus returns to the TUI window. At most one editor
        -- session is live at a time — a second EditTask while an
        -- editor is already open is a no-op with a status message.
        -- A confirmation prompt (ConfirmEditTask) is shown before
        -- the editor is invoked.
        -- Setting STATUS to done on a phoenix task respawns it, exactly as
        -- the 'x' key would: PhoenixRespawn triggers on the transition, not
        -- on the operator action, and the editor writes through patch_task,
        -- which runs the respawn in the module (store-split.allium, X2). The
        -- PHOENIX value the same save writes is
        -- the one the respawn reads, so turning the flag ON and completing
        -- the task in a single edit does spawn the successor.
        --
        -- Turning PHOENIX on WITHOUT moving the task is the one way to reach
        -- core/Task.respawn_failed without anything having failed: the task
        -- sits in done carrying a flag no respawn ever consumed, so its card
        -- shows the red ⚠ indicator. Left as-is deliberately. The indicator's
        -- claim — this task still owes a respawn — is true, and the recovery
        -- is the same one a genuine failure needs: move it out of done and
        -- back in. Suppressing it would mean tracking WHY the flag is set,
        -- which is the bookkeeping field TheFlagIsTheReceipt exists to avoid.
        --
        -- The completed_at side effect mirrors ConfirmDone's entering-done
        -- stamp (this file) and UpdateEpicViaMcp's entering-done clause in
        -- epics.allium. It is computed once from (prior, next) by the
        -- module's patch_task, the reducer every board status write passes
        -- through, so the editor gets it without asking.
}

------------------------------------------------------------
-- Board surfaces
------------------------------------------------------------

-- What the operator does to tasks at the board. Each key's binding is in
-- keybindings.allium; the rule each action reaches says what it does.
surface Board {
    facing _: core/Operator

    contracts:
        fulfils TaskTeardown

    exposes:
        selection.selected_tasks
        selection.selected_epics

    provides:
        -- The new-task form, finished (CreateTask).
        CreateTask(title, description, repo_path, plan?, epic?, tag?, sort_order?, base_branch?, wrap_up_mode?, model?, auto_run_plan?, phoenix?)
        -- [c] on a task card, the copy form finished (CopyTask).
        CopyTask(source)
        -- [e] on a task card, confirmed (EditTask).
        EditTask(task)
        -- [D] (QuickDispatchTrustGate), and its trust prompt answered y
        -- (TrustRepoForQuickDispatch).
        QuickDispatch(repo_path, epic_id?)
        TrustAndQuickDispatch(repo_path, epic_id?)
        -- Move keys on one card (MoveTaskForward, MoveTaskBackward), or on a
        -- multi-selection (BatchMoveForward, BatchMoveBackward).
        MoveTask(task, direction)
        BatchMoveTasks(tasks, direction) when not selection.is_empty
        -- Reorder keys on a task or epic card (ReorderItem).
        ReorderItem(item, direction)
        -- [m] on a task card, the target confirmed (MoveTaskToEpic).
        MoveTaskToEpic(task, new_epic?)
        -- [a], or Enter on a column header (SelectAllColumn); Esc
        -- (ClearSelection).
        SelectAllColumn(tasks, epics)
        ClearSelection()
        -- [z] and [Z] (ToggleSectionCollapse, ToggleEpicFold).
        ToggleSectionCollapse(ref, has_section)
        ToggleEpicFold(ref, has_epic_group)
        -- [b] on a task card (ToggleBookmarkFromBoard).
        ToggleBookmarkKeyPressed(viewer, task)
        -- Any key handled on the plain board, with the task card left under
        -- the cursor (SeeTaskByLandingOnIt).
        OperatorKeyHandled(viewer, task)

        -- DeleteKeyRouting. [x] completes or deletes, by what is selected,
        -- so a live task is never deleted in one step. The guards read the
        -- board's view; DeleteTask, DeleteTaskRefused and BatchDelete
        -- re-read the store's true rows before anything is torn down.
        --   * one task not in Done -> ConfirmDone (also a forward move out
        --     of review);
        --   * one task in Done -> ConfirmDeleteTask, answered y -> DeleteTask;
        --   * a tasks-only selection with a task not in Done -> ConfirmDone
        --     over the tasks not in Done, the Done ones left untouched;
        --   * a tasks-only selection all in Done, or any selection holding an
        --     epic -> BatchDelete, after a count prompt;
        --   * one epic -> ConfirmDeleteEpic (epics.allium);
        --   * one work package -> DeletePackageFromBoard's prompt
        --     (work-packages.allium).
        ConfirmDone(task) when task.status != done
        DeleteTask(task) when task.status = done
        BatchDelete(tasks, epics)
            when epics.count > 0 or tasks.all(t => t.status = done)

    @guarantee ABoardWriteLeavesThePointersAlone
        -- A board write (a reorder, a detach, an epic move, a lifecycle move,
        -- a window that went away) writes task.worktree, task.host and
        -- current_agent(task).tmux_window only when the operation means to.
        -- The board's copy of a task can be stale: a reorder pressed before
        -- the provisioned report reached this board sees no worktree, and
        -- sending that copy as a clear would wipe the store's pointer and
        -- end the task's agent (agents.allium: EndAgentWhenWorktreeGoes). So
        -- an absent value on the board's copy means "do not touch", never
        -- "clear". The operations that do mean to clear say so: RetryFresh
        -- releases the worktree (its host and window with it), and a
        -- detach, a window-gone or a crash clears the window only.
}

-- The board lays its columns out again whenever its tasks or epics change,
-- judged on each column unfiltered (FoldMovesToDrawnDescendant).
surface BoardLayoutPass {
    facing _: core/BoardProcess

    provides:
        -- skipped: a recorded fold whose epic is drawn in no section of its
        -- column; takers: the drawn epics now heading what it hid.
        UnfilteredColumnLaidOut(skipped, takers)
}

------------------------------------------------------------
-- Module write rules for tasks
------------------------------------------------------------

-- The module enforces these at its task writes, so every client gets them
-- (store-split.allium S1).

-- sub_status_valid_for(sub_status, status) is the black box mcp-task-tools.allium
-- (UpdateTaskViaMcp) names: the store's legality table, core.allium's
-- Task.SubStatusFitsStatus.

-- The module's task-write reducers, which any store client may call. Each is
-- named in its rule's guidance; TaskWriteRequested is the write every one of
-- them reaches.
surface TaskWriteReducers {
    facing _: core/StoreClient

    provides:
        TaskWriteRequested(task, written)
        SubStatusBatchPatched(updates)
        TaskPatchRequested(task, patch)
        TaskCreateRequested(row)
        TaskInsertRequested(written)
        TaskUpdateRequested(task, epic?, patch, host)
        PhoenixSuccessorRequested(predecessor, successor)
}

rule SubStatusMovesMustBeLegal {
    when: TaskWriteRequested(task, written)

    -- task is the row as the store holds it, written the row the write would
    -- leave. ONLY A MOVE IS JUDGED: a write that leaves sub_status as it was
    -- passes, because the stored pair already fits (SubStatusAutoreset).
    requires:
        written.sub_status = task.sub_status
        or sub_status_valid_for(written.sub_status, written.status)

    ensures: TaskRowWritten(task: task, written: written)

    @guidance
        -- THE ONE SEAM. Every module reducer that writes an existing task row
        -- reaches the same write, and the check sits there, so no writer can
        -- move a sub_status the status does not allow: patch_task, the
        -- batch sub_status patch (BatchSubStatusPatchSkipsIllegalEntries
        -- below), and the hook reducers record_pre_tool_use and
        -- record_notification (agent-health.allium) among them. A refusal
        -- reads "sub_status 'x' is not valid for status 'y'" and is decided
        -- before anything is written.
        --
        -- patch_task ALSO judges an explicit sub_status that does not move
        -- (mcp-task-tools.allium: UpdateTaskViaMcp checks the named
        -- sub_status against the status the row will hold). This rule holds
        -- every other writer to the table.
        --
        -- An insert has no prior row to move from, so it is judged on its pair
        -- alone (InsertedTaskSubStatusMustFit below).
        --
        -- The same write refuses an unknown status, insert or not
        -- (spacetime-seed.allium: StoreRefusesUnknownStatus).
}

rule InsertedTaskSubStatusMustFit {
    -- Every insert of a task row: a creating reducer, a seed, a restore.
    when: TaskInsertRequested(written)

    requires: sub_status_valid_for(written.sub_status, written.status)

    ensures: TaskRowWritten(task: written, written: written)

    @guidance
        -- Refused, not repaired: an insert whose pair does not fit writes
        -- nothing and reads "sub_status 'x' is not valid for status 'y'",
        -- the same words as SubStatusMovesMustBeLegal. Every creating rule
        -- writes default_sub_status of its status, so only a seed or a
        -- restore carrying an old row can meet this; that restore fails
        -- loudly rather than landing a row SubStatusAutoreset forbids.
}

rule BatchSubStatusPatchSkipsIllegalEntries {
    when: SubStatusBatchPatched(updates)

    ensures:
        for update in updates:
            if exists update.task
               and (update.sub_status = update.task.sub_status
                    or sub_status_valid_for(update.sub_status, update.task.status)):
                update.task.sub_status = update.sub_status
                update.task.updated_at = now

    @guidance
        -- batch_patch_sub_status. Each entry goes through the write seam
        -- (SubStatusMovesMustBeLegal), but an entry it refuses is SKIPPED, not
        -- fatal: the call succeeds and the other entries land. The batch is
        -- built from a board snapshot that may be a poll behind, and one stale
        -- entry must not undo its neighbours. A skipped entry leaves no trace,
        -- and an entry naming a task that is gone is skipped. No
        -- epic rollup: sub_status is not an input of the epic status.
}

rule PatchTaskNeverMovesAnEpic {
    when: TaskPatchRequested(task, patch)

    -- The epic move owns the owner, the repo-group routing and the
    -- epic-exists check (epics.allium's routing note; set_task_epic), so a
    -- patch that could change epic_id would skip all three.
    requires: patch.epic_id = null

    ensures: TaskPatchAccepted(task: task, patch: patch)

    @guidance
        -- patch_task refuses a patch that names epic_id at all, even one that
        -- clears it (a detach), with "epic_id cannot
        -- be changed by patch_task; use set_task_epic", and writes nothing.
        -- set_task_epic and update_task (UpdateTaskIsOneTransaction) are the ONLY
        -- ways a task changes epic; the move routes into a
        -- repo-group sub-epic, sets the owner and rolls up both the old and
        -- the new epic. No host patch names epic_id: update_tasks sends an
        -- explicit epic_id through update_task
        -- (mcp-task-tools.allium: UpdateTaskViaMcp).
        --
        -- With the epic fixed, patch_task rolls up the task's epic only when
        -- the status moved, and still re-routes inside a grouped subtree when
        -- repo_path changes.
        --
        -- set_task_epic holds the epic-exists check: a non-zero epic_id that
        -- names no epic is refused with "task <id>: epic <n> does not exist"
        -- and writes nothing, so no task is written with a dangling epic.
        --
        -- Tightening a refusal inside a rule the module already owns (this
        -- check, the epic_id refusal, the sub-status check, close_task) does
        -- not bump the rules version: the version records who enforces a
        -- rule, and the board enforces none of these.
        --
        -- The repo-group sweep deletes a sub-epic only when it holds no task and
        -- no child, so validate_epic_deletable has nothing to refuse there.
}

rule PatchTaskNeverAimsAnotherHostsTeardown {
    when: TaskPatchRequested(task, patch)

    -- A feed teardown asks the host named in the task row to remove the
    -- worktree named in it, in the repo named in it
    -- (store-split.allium: StaleDeleteRequestsTeardownOnTheHoldingHost). A patch that could set
    -- those three would let anyone who sees the task aim another person's host
    -- at a live worktree: patch a feed task in somebody's epic to
    -- host = their-laptop, worktree = a worktree they are working in, and wait
    -- for the item to leave the feed.
    -- A host nobody registered has no owner and is never the target of a
    -- teardown row, so it is not judged.
    requires: patch.host = null or patch.host = task.host
        or ((task.host = null or task.host.owner = null or task.host.owner = caller())
            and (patch.host = "" or patch.host.owner = null
                 or patch.host.owner = caller()))
    requires: ((patch.repo_path = null or patch.repo_path = task.repo_path)
               and (patch.worktree = null or patch.worktree = task.worktree))
        or task.host = null or task.host.owner = null or task.host.owner = caller()

    ensures: TaskPatchAccepted(task: task, patch: patch)

    @guidance
        -- patch_task refuses, naming why, and writes nothing. Only a CHANGE is
        -- judged: a patch that repeats the stored value is no change. A task
        -- no host holds keeps its repo editable by anyone who sees it, and may
        -- be handed to a host the caller owns or to one nobody registered.
        -- Writes the module makes itself (the dispatch reports, the close, the
        -- stale delete) do not go through this check, so provisioning and
        -- teardown are unaffected.
}

rule CreateTaskNeverAimsAnotherHostsTeardown {
    when: TaskCreateRequested(row)

    -- The create twin of PatchTaskNeverAimsAnotherHostsTeardown. A new row
    -- that names another person's host would be torn down by that host when
    -- the item leaves its feed, against a worktree the creator chose.
    requires: row.host = "" or row.host.owner = null or row.host.owner = caller()

    ensures: TaskCreated(row: row)

    @guidance
        -- create_task and create_task_signalled refuse, naming why, and write
        -- nothing. A host nobody registered has no owner and is not judged.
}

rule UpdateTaskIsOneTransaction {
    -- host is the calling board's own host; store-split.allium's
    -- UpdateTaskDoneWritesACloseRow reads it from the same call.
    when: TaskUpdateRequested(task, epic?, patch, host)

    -- The board's update of a task (relink and field patch) is ONE reducer,
    -- update_task, so it cannot half-apply and does not depend on the board's
    -- cached rows. A refusal of either half (the epic does not exist, a
    -- sub_status illegal for the status the row will hold, a schedule the
    -- module refuses) leaves the task, its epic and its repo as they were.
    requires: task.exists

    -- The epic before the call; an ensures-block `if` reads the post-call one.
    let prior_epic = task.epic

    ensures: TaskPatchAccepted(task: task, patch: patch)
    ensures:
        if epic != null:
            let target = route_target(epic, task.repo_path)
            task.epic = target
            if target != prior_epic: TaskRelinked(task: task)

    @guidance
        -- epic is absent to leave the epic alone, 0 to detach onto a user
        -- board (the call carries the owner), n to move into epic n. The move
        -- is set_task_epic's (routing, owner, epic-exists check, rollups of
        -- both epics); the patch is patch_task's, and patch_task still refuses
        -- epic_id. A missing task is an error here ("task <id> not found"),
        -- unlike patch_task's silent no-op: the board does not pre-read a
        -- possibly stale view to decide that. A missing epic is refused with
        -- "task <id>: epic <n> does not exist", which the board maps to the
        -- same NotFound the create and move paths answer.
        --
        -- ORDER INSIDE THE CALL. A call that also changes repo_path relinks
        -- first, then patches, so the repo change re-routes inside the subtree
        -- the relink named and the task ends where routing by the NEW repo
        -- puts it. Otherwise it patches first, then relinks. The order does not
        -- matter for atomicity: both halves share one transaction.
        --
        -- COMPLETION STAMP. Entering Done stamps completed_at from the store
        -- clock whatever the patch names, in update_task: a board that
        -- forwarded a stale row's value cannot misorder the Done column, and
        -- the board does not read its cache to strip the value first. A patch that
        -- names a completion on a task already done (a manual reorder of the
        -- Done column) is kept. In patch_task and patch_epic a completion they are given explicitly (a seed, a feed, an epic's
        -- manual reorder) wins over the module's own stamp.
}

rule HandStatusWriteReachesTheSchedule {
    -- Every accepted patch_task and update_task patch, in the same
    -- transaction: these are the hand status writes (the TUI's moves and
    -- editor, update_tasks' status). The dispatch claim and the close are the
    -- module's own writes and do not pass through here.
    when: TaskPatchAccepted(task, patch)

    let from = task.status

    ensures:
        if patch.status != null and patch.status != from:
            TaskStatusWrittenByHand(task: task, from: from, to: patch.status)
    -- A write into done is a close, from any prior status.
    ensures:
        if patch.status = done:
            split/TaskClosed(task: task)

    @guidance
        -- schedules.allium consumes both: LeavingBacklogCancelsThePendingRun,
        -- EnteringBacklogRearmsAPhoenixTask, LeavingRunningCancelsThePendingRun
        -- and ClosingCancelsThePendingRun.
}

rule RespawnPhoenixSuccessorNeedsTheFlag {
    when: PhoenixSuccessorRequested(predecessor, successor)

    -- TheFlagIsTheReceipt, enforced: a predecessor without the
    -- flag is not a phoenix task, or has already respawned.
    requires: predecessor.phoenix

    ensures: PhoenixSuccessorAccepted(predecessor: predecessor, successor: successor)

    @guidance
        -- The standalone respawn_phoenix_successor reducer. A refusal reads
        -- "predecessor task <id> is not a phoenix task, or already respawned"
        -- and writes nothing, so a repeated call cannot insert a second
        -- successor. The in-transaction respawns (patch_task, close_task,
        -- exit_session's close, a merged PR; PhoenixRespawn) are gated on the
        -- flag too.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- DoneRequiresHumanConfirmation. A task enters Done only by an explicit act:
-- the operator at the board (ConfirmDone, EditTask's STATUS section), an
-- explicit session close over MCP, or a merged PR, whose review is the human
-- confirmation. A dispatched agent never self-completes its own task as a side
-- effect of an ordinary field update. Over MCP, Done is reachable through
-- exactly two calls, neither of them UpdateTaskViaMcp's generic write (which
-- refuses status=done):
--   - wrap_up + exit_session (pr-workflow.allium: ExitSessionViaMcp), the
--     agent's own session close, gated on an exit token.
--   - update_tasks' dedicated status="done" call (mcp-task-tools.allium:
--     MarkTaskDoneViaMcp): a session caller, or a dispatched agent acting on
--     a task other than its own. It closes through the module's close_task
--     (store-split.allium: RequestCloseTask) without exit_session's epic
--     chaining (epics.allium: AutoDispatchNextSubtask).
-- Deletion is never reachable over MCP: there is no MCP delete tool, so
-- removing a task stays a human act at the board (DeleteTask, BatchDelete).

-- SubStatusAutoreset. Every stored task's sub_status fits its status
-- (core/Task.SubStatusFitsStatus). The store's task writes keep it so:
--   * a write that changes status and names no sub_status resets it to
--     default_sub_status(the new status); a write that repeats the current
--     status keeps it. A rule that changes status without naming sub_status
--     gets the reset for free; the sub_status lines in the rules above
--     document the resulting state. A write that sets a specific sub_status
--     overrides the default (HookNotification keeps running and sets
--     needs_input; FinishTaskConflict keeps the status and sets conflict).
--   * an explicit pair that does not fit is refused before anything is
--     written (mcp-task-tools.allium: UpdateTaskViaMcp), every other writer
--     that moves a sub_status is held to the table at the one task write
--     (SubStatusMovesMustBeLegal, BatchSubStatusPatchSkipsIllegalEntries),
--     and an insert whose pair does not fit is refused
--     (InsertedTaskSubStatusMustFit).
--   * a row stored before these checks existed with a pair that does not
--     fit is reset once to default_sub_status(its status), when the module
--     that enforces this is first published to a store.
invariant SubStatusAutoreset {
    for t in core/Tasks:
        sub_status_valid_for(t.sub_status, t.status)
}
