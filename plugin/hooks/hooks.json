{
  "modules": ["./register.tsx"],
  "hooks": {
    "PreToolUse": [{
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-status-hook\""
        },
        {
          "type": "command",
          "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pr-learnings-hook\""
        }
      ]
    }],
    "PostToolUse": [{
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-status-hook\""
        }
      ]
    }],
    "Stop": [{
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-status-hook\""
        }
      ]
    }],
    "Notification": [{
      "hooks": [{
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-status-hook\""
      }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-status-hook\""
      }]
    }],
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-status-hook\""
      }]
    }],
    "SubagentStop": [{
      "hooks": [{
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-status-hook\""
      }]
    }],
    "SessionStart": [{
      "matcher": "startup|resume|clear",
      "hooks": [{
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/task-status-hook\""
      }]
    }]
  }
}
