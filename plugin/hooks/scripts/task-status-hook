#!/usr/bin/env bash
# task-status-hook — Bridge between Claude Code hooks and dispatch.
#
# Installed alongside dispatch (or symlinked into PATH).
# Called by Claude Code PreToolUse, Stop, and Notification hooks with JSON on stdin.
# Extracts the task ID from the worktree directory name and forwards the event
# to `dispatch hook <id> <event>` which records the timestamp and applies the
# appropriate side effects.

set -euo pipefail

INPUT=$(cat)
CWD=$(echo "$INPUT" | jq -r '.cwd // empty')
EVENT=$(echo "$INPUT" | jq -r '.hook_event_name // empty')

# Extract task ID from the git branch name ({id}-{slug}). Branch lookup is
# more reliable than basename($CWD) because agents commonly cd into
# subdirectories of the worktree, which makes basename return something
# like "models" instead of "567-foo" and silently skips every hook.
ID=$(git -C "${CWD:-.}" branch --show-current 2>/dev/null | grep -oP '^\d+' || true)
if [ -z "$ID" ]; then
    # Fallback: walk up the cwd looking for a path segment that starts
    # with "<digits>-" (the standard dispatch worktree directory naming).
    path="${CWD:-}"
    while [ -n "$path" ] && [ "$path" != "/" ]; do
        name=$(basename "$path")
        if [[ "$name" =~ ^[0-9]+- ]]; then
            ID="${name%%-*}"
            break
        fi
        path=$(dirname "$path")
    done
fi
[ -z "$ID" ] && exit 0

case "$EVENT" in
    PreToolUse|PostToolUse)
        TOOL=$(echo "$INPUT" | jq -r '.tool_name // empty')
        # Skip dispatch MCP calls — management operations, not implementation work.
        # Without this, the wrap-up skill's get_task and wrap_up calls clobber review status.
        [[ "$TOOL" == mcp__dispatch__* ]] && exit 0
        dispatch hook "$ID" pre_tool_use

        # An agent that opens the AskUserQuestion dialog is blocked on a human,
        # but Claude Code fires no Notification hook for it — so the activity
        # stamp above would be the only signal, and the task would read as
        # Active for as long as the question went unanswered. Synthesise the
        # notification Claude Code doesn't send, so the block is visible as
        # needs_input (task #4505). It must come *after* the stamp above, or the
        # tick classifier sees a newer last_pre_tool_use_at and clears the raise.
        # PostToolUse deliberately does not raise: that is the answer arriving,
        # and its activity stamp is what clears the block.
        if [[ "$EVENT" == "PreToolUse" && "$TOOL" == "AskUserQuestion" ]]; then
            dispatch hook "$ID" notification --kind elicitation_dialog
        fi

        # Additive: PostToolUse-only observers. None of these gates, reorders or
        # replaces the activity signal above.
        if [[ "$EVENT" == "PostToolUse" ]]; then
            # Additive: observe native cross-session SendMessage calls so the
            # TUI can flash both the sender's and the resolved target's card
            # (task #4098). Dispatch never performs this delivery itself —
            # agents call SendMessage directly — this only records that it
            # happened.
            if [[ "$TOOL" == "SendMessage" ]]; then
                MSG_TO=$(echo "$INPUT" | jq -r '.tool_input.to // empty')
                MSG_BODY=$(echo "$INPUT" | jq -r '.tool_input.message // empty')
                if [[ -n "$MSG_TO" ]]; then
                    dispatch hook-peer-message "$ID" --target "$MSG_TO" --body "$MSG_BODY"
                fi
            fi
        fi
        ;;
    Stop)               dispatch hook "$ID" stop ;;
    Notification)
        # Forward the payload's notification_type as --kind and classify
        # nothing here: the Rust side decides which kinds are a real block
        # (permission_prompt/elicitation_dialog), which are noise
        # (auth_success), which resolve one (elicitation_complete/
        # elicitation_response), and which depend on the task's own live
        # background work (idle_prompt — see HookNotification in
        # docs/specs/agent-health.allium). Absent on older Claude Code —
        # omitted, which the Rust side treats as needs_input.
        NOTIFICATION_TYPE=$(echo "$INPUT" | jq -r '.notification_type // empty')
        if [ -n "$NOTIFICATION_TYPE" ]; then
            dispatch hook "$ID" notification --kind "$NOTIFICATION_TYPE"
        else
            dispatch hook "$ID" notification
        fi
        ;;
    UserPromptSubmit)   dispatch hook "$ID" user_prompt_submit ;;
    SubagentStart|SubagentStop)
        # Subagent lifecycle. Deliberately does NOT fire `dispatch hook
        # pre_tool_use` — these are not tool calls, and stamping activity from
        # them would mask a genuinely idle agent. The subagent's own tool calls
        # already fire PreToolUse/PostToolUse against this same worktree.
        AGENT_ID=$(echo "$INPUT" | jq -r '.agent_id // empty')
        SESSION_ID=$(echo "$INPUT" | jq -r '.session_id // empty')
        [ -z "$AGENT_ID" ] && exit 0
        if [ "$EVENT" = "SubagentStart" ]; then VERB=start; else VERB=stop; fi
        dispatch hook-subagent "$ID" "$VERB" \
            --agent-id "$AGENT_ID" --session-id "$SESSION_ID"
        ;;
    SessionStart)
        # A fresh session provably has zero live subagents, so drop any
        # entries a dead session left behind. Registered with matcher
        # "startup|resume|clear" (hooks.json) — never on compact (which fires
        # mid-run on *auto* compaction and would wipe a genuine live count) or
        # fork (a different session entirely).
        #
        # Non-draining: any Stop deferred by the previous turn is stale here, so
        # `clear` voids it rather than applying it. Resume in particular keeps
        # the task Running on purpose.
        dispatch hook-subagent "$ID" clear
        ;;
    *)                  exit 0 ;;
esac
